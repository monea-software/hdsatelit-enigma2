# Descarcarea subtitrarilor de pe internet ("Descărcare subtitrări"): din 0.3.2 face parte din imagine (pachetul
# enigma2-hdsatelit), nu mai e plugin separat (ce se poate pune direct in imagine nu sta
# in lista de pluginuri). Ecranele in ecrane.py, pagina web in HdsWebControl/descarcare_subtitrari_web.py.
installdir = $(pkglibdir)/python/Components/HdsSubtitrariInternet

SUBDIRS = surse

install_PYTHON = \
	__init__.py \
	conturi.py \
	ecrane.py \
	film.py \
	identificare.py \
	limbi.py \
	lucru.py \
	retea.py \
	salvare.py \
	tv.py
