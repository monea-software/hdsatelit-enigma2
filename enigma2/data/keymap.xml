	<!-- HDSatelit (tastele Viper): tastele care nu aveau nicio actiune in bara, cu sensul lor obisnuit in enigma2.
	     Contextul e folosit numai de bara (Screens/InfoBar.py), deci alte ecrane nu scriu "unknown action" in jurnal.
	     INFO tinut a trecut aici din InfobarEPGActions: playerele (inregistrari, media) folosesc acel context fara
	     showEventInfoPlugin. KEY_CONTEXT_MENU (438, a treia tasta cu desen de ecran) ramane nelegata: de obicei e
	     intrarea HDMI, pe care Viper nu o are. -->
	<map context="HdsInfobarActions">
		<key id="KEY_INFO" mapto="ghidProgram" flags="l" />
		<key id="KEY_EPG" mapto="ghidProgram" flags="m" />
		<key id="KEY_LIST" mapto="mediaPlayer" flags="m" />
		<key id="KEY_TIME" mapto="listaTimere" flags="m" />
		<key id="KEY_WWW" mapto="extensii" flags="m" />
		<!-- HDSatelit: FAV scurt deschide lista pe Favorite, ca pana acum, dar la eliberare
		     (favorite); FAV tinut apasat pune canalul de acum in Favorite sau il scoate (favoriteLung, Screens/InfoBar.py).
		     La apasare (favoriteApasat) nu se stie inca daca va fi lunga: flagLong vine dupa 4 repetari (main/enigma.cpp). -->
		<key id="KEY_FAVORITES" mapto="favoriteApasat" flags="m" />
		<key id="KEY_FAVORITES" mapto="favoriteLung" flags="l" />
		<key id="KEY_FAVORITES" mapto="favorite" flags="b" />
		<!-- tasta din mijloc (227) are desenul cu benzi laterale, deci formatul imaginii
		     (KEY_VMODE = toggleAspectRatio, legatura obisnuita); tasta din stanga (373) deschide setarile A/V -->
		<key id="KEY_MODE" mapto="setariVideo" flags="m" />
		<key id="KEY_SWITCHVIDEOMODE" mapto="formatImagine" flags="m" />
		<!-- TTX: fara vizualizator de teletext in imagine, un mesaj; cu vizualizator, InfobarTeletextActions (prioritate 0)
		     prinde tasta inaintea acestei harti (prioritate 2) -->
		<key id="KEY_TEXT" mapto="teletext" flags="m" />
		<!-- HDSatelit (HbbTV): ROSU porneste aplicatia HbbTV a canalului (Components/HdsHbbtvPornire);
		     pe un canal fara aplicatie actiunea intoarce 0 si tasta ramane cum era (pe Viper nelegata in bara) -->
		<key id="KEY_RED" mapto="hbbtvRosu" flags="m" />
	</map>

	<!-- HDSatelit: apasarea lunga a butoanelor colorate in bara (Screens/InfoBar.py, prioritatea -2, inaintea ecranului
	     radio si a hartilor barei), cu actiunea aleasa in Butoane colorate si taste rapide (config.hds_buttons, web
	     /taste-rapide). Ca la POWER, AUDIO si FAV: apasarea ("m") numai sterge semnul si lasa tasta mai departe, deci
	     apasarea scurta face ce facea; cea lunga ("l", dupa 4 repetari) face actiunea aleasa; eliberarea ("b") e oprita
	     numai dupa o apasare lunga facuta. Pentru orice telecomanda. -->
	<map context="HdsTasteColorateActions">
		<key id="KEY_RED" mapto="rosuApasat" flags="m" />
		<key id="KEY_RED" mapto="rosuLung" flags="l" />
		<key id="KEY_RED" mapto="rosuEliberat" flags="b" />
		<key id="KEY_GREEN" mapto="verdeApasat" flags="m" />
		<key id="KEY_GREEN" mapto="verdeLung" flags="l" />
		<key id="KEY_GREEN" mapto="verdeEliberat" flags="b" />
		<key id="KEY_YELLOW" mapto="galbenApasat" flags="m" />
		<key id="KEY_YELLOW" mapto="galbenLung" flags="l" />
		<key id="KEY_YELLOW" mapto="galbenEliberat" flags="b" />
		<key id="KEY_BLUE" mapto="albastruApasat" flags="m" />
		<key id="KEY_BLUE" mapto="albastruLung" flags="l" />
		<key id="KEY_BLUE" mapto="albastruEliberat" flags="b" />
	</map>

