			<key id="KEY_CHANNELDOWN" mapto="openServiceList" flags="m" />
		</device>
		<!-- HDSatelit: orice alt dispozitiv (panoul din fata, care declara
		     CH+/- pe receptor, o telecomanda USB, pagina web) deschide lista, ca inainte. keymapparser.py leaga intai
		     blocurile <device>, iar eActionMap::keyPressed se opreste la prima actiune tratata, deci pe Viper
		     ramane zapDown/zapUp de mai sus -->
		<key id="KEY_CHANNELUP" mapto="openServiceList" flags="m" />
		<key id="KEY_CHANNELDOWN" mapto="openServiceList" flags="m" />
		<key id="BTN_0" mapto="zapUp" flags="mr" />
