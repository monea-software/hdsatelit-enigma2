	<!-- HDSatelit: CH/PAGE + si - dau pagina in liste (meniu,
	     setari, alegeri), cu pageUp si pageDown. Contextul e al lui eListbox, legat cu
	     prioritatea 1 (lib/gui/elistbox.h), adica dupa hartile Python: in lista de canale, in ghid si in playerul
	     media CH+/- raman Buchet+/- (ChannelSelectBaseActions, EPGSelectActions, MediaPlayerActions). -->
	<map context="ListboxFallbackActions">
		<!-- numai m. Cu mr, repetarea ajungea la lista acolo unde hartile
		     Python leaga CH+/- numai m (lista de canale, ghid, playerul media): Buchet+/- si o pagina la aceeasi apasare. -->
		<key id="KEY_CHANNELUP" mapto="fallbackPageUp" flags="m" />
		<key id="KEY_CHANNELDOWN" mapto="fallbackPageDown" flags="m" />
	</map>

	<!-- HDSatelit: PAGE+ si PAGE-, HOME si END pentru ecranele care dau pagina din
	     Python (Informatii, Informatii HDMI: toate coloanele, textul brut si "pagina X din Y"). ListboxActions e un
	     context nativ (lib/actions/action.cpp: tastele lui ajung numai la eListbox din C++), deci hartile Python nu
	     il pot asculta; acesta e al lor. Nefolosit de un ecran, tastele merg mai departe la liste, ca inainte. -->
	<map context="HdsPaginiActions">
		<key id="KEY_PAGEUP" mapto="pageUp" flags="mr" />
		<key id="KEY_PAGEDOWN" mapto="pageDown" flags="mr" />
		<key id="KEY_HOME" mapto="moveTop" flags="mr" />
		<key id="KEY_END" mapto="moveEnd" flags="mr" />
	</map>
	
