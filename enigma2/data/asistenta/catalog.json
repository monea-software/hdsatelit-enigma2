{
  "fel": "hds-asistenta-catalog",
  "v": 1,
  "operatii": [
    {
      "op": "info",
      "grup": "Informații",
      "fel": "citire",
      "text": "starea receptorului (model, versiune, nucleu, memorie, disc, temperaturi)",
      "args": []
    },
    {
      "op": "placa",
      "grup": "Informații",
      "fel": "citire",
      "text": "placa: procesorul, linia de comandă a nucleului, partițiile, modulele încărcate",
      "args": []
    },
    {
      "op": "pachete",
      "grup": "Informații",
      "fel": "citire",
      "text": "lista pachetelor instalate",
      "args": []
    },
    {
      "op": "retea",
      "grup": "Informații",
      "fel": "citire",
      "text": "rețeaua: cablu sau Wi-Fi, legat sau nu, ruta implicită, DNS (fără numele rețelei, MAC mascat)",
      "args": []
    },
    {
      "op": "tunere",
      "grup": "Semnal",
      "fel": "citire",
      "text": "tunerele și blocarea semnalului",
      "args": []
    },
    {
      "op": "decodor",
      "grup": "Semnal",
      "fel": "citire",
      "text": "starea decodorului (video, sunet, sincronizare)",
      "args": []
    },
    {
      "op": "memorie",
      "grup": "Semnal",
      "fel": "citire",
      "text": "memoria liberă și memoria decodorului",
      "args": []
    },
    {
      "op": "jurnale",
      "grup": "Jurnale",
      "fel": "citire",
      "text": "lista jurnalelor receptorului, cu mărimile",
      "args": []
    },
    {
      "op": "jurnal",
      "grup": "Jurnale",
      "fel": "citire",
      "text": "ultimele rânduri dintr-un jurnal",
      "args": [
        {"nume": "nume", "tipar": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "cerut": true},
        {"nume": "randuri", "tipar": "^[1-9][0-9]{0,3}$", "cerut": false}
      ]
    },
    {
      "op": "dmesg",
      "grup": "Jurnale",
      "fel": "citire",
      "text": "jurnalul nucleului",
      "args": [
        {"nume": "randuri", "tipar": "^[1-9][0-9]{0,3}$", "cerut": false}
      ]
    },
    {
      "op": "procese",
      "grup": "Jurnale",
      "fel": "citire",
      "text": "lista proceselor (numele, fără argumente)",
      "args": []
    },
    {
      "op": "setari",
      "grup": "Setări",
      "fel": "citire",
      "text": "copie filtrată a setărilor (audio, video, interfață, rețea; fără parole și chei)",
      "args": []
    },
    {
      "op": "captura",
      "grup": "Probe",
      "fel": "proba",
      "text": "o captură a ecranului (numai meniurile, fără imaginea canalului)",
      "args": []
    },
    {
      "op": "mesaj",
      "grup": "Probe",
      "fel": "proba",
      "text": "un mesaj scris pe ecranul televizorului",
      "args": [
        {"nume": "text", "tipar": "^.{1,200}$", "cerut": true}
      ]
    },
    {
      "op": "concluzii",
      "grup": "Probe",
      "fel": "proba",
      "text": "concluziile echipei (ce am găsit și ce am făcut), arătate pe receptor până apeși OK",
      "args": [
        {"nume": "text", "tipar": "(?s)^.{1,2000}$", "cerut": true, "max_semne": 2000}
      ]
    },
    {
      "op": "ecran",
      "grup": "Ecran",
      "fel": "citire",
      "text": "textul ecranului deschis pe receptor (meniul, rândul ales, setările), fără ecranele private",
      "args": []
    },
    {
      "op": "taste",
      "grup": "Control",
      "fel": "control",
      "text": "tastele telecomenzii, ca și cum echipa ar ține telecomanda (numai cu Control complet)",
      "args": [
        {"nume": "taste", "tipar": "^[a-z0-9+:-]{1,16}( [a-z0-9+:-]{1,16}){0,19}$", "cerut": true}
      ]
    },
    {
      "op": "text",
      "grup": "Control",
      "fel": "control",
      "text": "un text scris în câmpul deschis pe ecran (numai cu Control complet, niciodată în parole)",
      "args": [
        {"nume": "text", "tipar": "^[^\\x00-\\x1f\\x7f]{1,200}$", "cerut": true}
      ]
    },
    {
      "op": "canal",
      "grup": "Semnal",
      "fel": "citire",
      "text": "canalul deschis: serviciul, transponderul, tunerul și semnalul (fără nimic de la modulele de acces)",
      "args": []
    },
    {
      "op": "transpondere",
      "grup": "Semnal",
      "fel": "citire",
      "text": "transponderele din lista de canale (fără canale și fără nimic personal)",
      "args": [
        {"nume": "namespace", "tipar": "^[0-9a-fA-F]{1,8}$", "cerut": false}
      ]
    },
    {
      "op": "zap",
      "grup": "Control",
      "fel": "control",
      "text": "pornește un canal din lista ta (numai cu Control complet)",
      "args": [
        {"nume": "referinta", "tipar": "^1:0:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,8}:0:0:0:$", "cerut": true}
      ]
    },
    {
      "op": "setare-scrie",
      "grup": "Control",
      "fel": "control",
      "text": "schimbă o setare (imagine, sunet, interfață, tunere, ora, ghid, rețea; niciodată parole, chei sau date personale; numai cu Control complet)",
      "args": [
        {"nume": "cheie", "tipar": "^config(\\.[A-Za-z0-9_]{1,40}){1,8}$", "cerut": true},
        {"nume": "valoare", "tipar": "^[^\\x00-\\x1f\\x7f]{0,128}$", "cerut": false}
      ]
    },
    {
      "op": "instaleaza",
      "grup": "Control",
      "fel": "control",
      "text": "instalează un plugin sau un modul din feedul oficial HD Satelit (fără configurarea și cheile lui; numai cu Control complet)",
      "args": [
        {"nume": "pachet", "tipar": "^enigma2-plugin-[a-z0-9][a-z0-9.+-]{0,62}$", "cerut": true}
      ]
    },
    {
      "op": "dezinstaleaza",
      "grup": "Control",
      "fel": "control",
      "text": "dezinstalează un plugin sau un modul (numai cu Control complet)",
      "args": [
        {"nume": "pachet", "tipar": "^enigma2-plugin-[a-z0-9][a-z0-9.+-]{0,62}$", "cerut": true}
      ]
    },
    {
      "op": "reporneste",
      "grup": "Control",
      "fel": "control",
      "text": "repornește interfața sau receptorul, cu anunț pe ecran; asistența continuă după repornire (numai cu Control complet)",
      "args": [
        {"nume": "ce", "tipar": "^(interfata|receptor)$", "cerut": true}
      ]
    }
  ]
}
