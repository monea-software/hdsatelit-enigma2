{
  "fel": "hds-asistenta-catalog",
  "v": 1,
  "operatii": [
    {
      "op": "tsmux",
      "grup": "Semnal",
      "fel": "citire",
      "text": "legăturile tunerelor, valorile și alegerile driverului, numai citire",
      "args": []
    },
    {
      "op": "info",
      "grup": "Informații",
      "fel": "citire",
      "text": "starea receptorului (model, versiune, nucleu, memorie, disc, temperaturi)",
      "args": []
    },
    {
      "op": "placa",
      "grup": "Informații",
      "fel": "citire",
      "text": "placa: procesorul, linia de comandă a nucleului, partițiile, modulele încărcate",
      "args": []
    },
    {
      "op": "citeste",
      "grup": "Informații",
      "fel": "citire",
      "text": "un fișier sau un dosar al receptorului, integral",
      "args": [
        {"nume": "cale", "tipar": "^/[^\\x00]*\\Z", "cerut": true, "max_semne": 16384},
        {"nume": "de_la", "tipar": "^[0-9]{1,12}$", "cerut": false}
      ]
    },
    {
      "op": "pachete",
      "grup": "Informații",
      "fel": "citire",
      "text": "lista pachetelor instalate",
      "args": []
    },
    {
      "op": "retea",
      "grup": "Informații",
      "fel": "citire",
      "text": "rețeaua, inclusiv numele Wi-Fi și adresa MAC",
      "args": []
    },
    {
      "op": "tunere",
      "grup": "Semnal",
      "fel": "citire",
      "text": "tunerele și blocarea semnalului",
      "args": []
    },
    {
      "op": "decodor",
      "grup": "Semnal",
      "fel": "citire",
      "text": "starea decodorului (video, sunet, sincronizare)",
      "args": []
    },
    {
      "op": "memorie",
      "grup": "Semnal",
      "fel": "citire",
      "text": "memoria liberă și memoria decodorului",
      "args": []
    },
    {
      "op": "jurnale",
      "grup": "Jurnale",
      "fel": "citire",
      "text": "lista jurnalelor receptorului, cu mărimile",
      "args": []
    },
    {
      "op": "jurnal",
      "grup": "Jurnale",
      "fel": "citire",
      "text": "ultimele rânduri dintr-un jurnal",
      "args": [
        {"nume": "nume", "tipar": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "cerut": true},
        {"nume": "randuri", "tipar": "^[1-9][0-9]{0,6}\\Z", "cerut": false},
        {"nume": "de_la", "tipar": "^[0-9]{1,12}$", "cerut": false}
      ]
    },
    {
      "op": "dmesg",
      "grup": "Jurnale",
      "fel": "citire",
      "text": "jurnalul nucleului",
      "args": [
        {"nume": "randuri", "tipar": "^[1-9][0-9]{0,6}\\Z", "cerut": false}
      ]
    },
    {
      "op": "procese",
      "grup": "Jurnale",
      "fel": "citire",
      "text": "lista proceselor (numele, fără argumente)",
      "args": []
    },
    {
      "op": "setari",
      "grup": "Setări",
      "fel": "citire",
      "text": "setările receptorului",
      "args": []
    },
    {
      "op": "captura",
      "grup": "Probe",
      "fel": "proba",
      "text": "captură cu meniurile și imaginea canalului, ca pe televizor",
      "args": []
    },
    {
      "op": "mesaj",
      "grup": "Probe",
      "fel": "proba",
      "text": "un mesaj scris pe ecranul televizorului",
      "args": [
        {"nume": "text", "tipar": "^.{1,200}$", "cerut": true}
      ]
    },
    {
      "op": "intrebare",
      "grup": "Probe",
      "fel": "proba",
      "text": "o întrebare pe ecranul televizorului; răspunsul tău (Da, Nu sau o variantă) ajunge la echipă",
      "args": [
        {"nume": "text", "tipar": "^.{1,200}$", "cerut": true},
        {"nume": "variante", "tipar": "^(?:\\*|[^|\\x00-\\x1f]{1,40}(?:\\|[^|\\x00-\\x1f]{1,40}){1,3})$", "cerut": false},
        {"nume": "secunde", "tipar": "^[1-9][0-9]{1,2}$", "cerut": false}
      ]
    },
    {
      "op": "concluzii",
      "grup": "Probe",
      "fel": "proba",
      "text": "concluziile echipei (ce am găsit și ce am făcut), arătate pe receptor până apeși OK",
      "args": [
        {"nume": "text", "tipar": "(?s)^.{1,2000}$", "cerut": true, "max_semne": 2000}
      ]
    },
    {
      "op": "ecran",
      "grup": "Ecran",
      "fel": "citire",
      "text": "textul integral al ecranului",
      "args": []
    },
    {
      "op": "taste",
      "grup": "Control",
      "fel": "control",
      "text": "tastele telecomenzii, ca și cum echipa ar ține telecomanda",
      "args": [
        {"nume": "taste", "tipar": "^[a-z0-9_+:-]{1,24}( [a-z0-9_+:-]{1,24})*$", "cerut": true, "max_semne": 16384}
      ]
    },
    {
      "op": "text",
      "grup": "Control",
      "fel": "control",
      "text": "un text scris în câmpul deschis pe ecran",
      "args": [
        {"nume": "text", "tipar": "^[^\\x00-\\x1f\\x7f]+\\Z", "cerut": true, "max_semne": 16384}
      ]
    },
    {
      "op": "canal",
      "grup": "Semnal",
      "fel": "citire",
      "text": "canalul deschis: serviciul, transponderul, tunerul, semnalul și modulul de acces",
      "args": []
    },
    {
      "op": "flux",
      "grup": "Semnal",
      "fel": "citire",
      "text": "fluxul prins acum de tunerul canalului deschis sau, cu un transponder dat, de un tuner liber, fără să schimbe canalul: TSID, ONID, rețeaua și poziția satelitului din tabelele primite, numai citire",
      "args": [
        {"nume": "pozitie", "tipar": "^[0-9]{1,3}([.,][0-9])?[EeWw]$", "cerut": false},
        {"nume": "frecventa", "tipar": "^[0-9]{4,5}$", "cerut": false},
        {"nume": "pol", "tipar": "^[HVLRhvlr]$", "cerut": false},
        {"nume": "rata", "tipar": "^[0-9]{3,6}$", "cerut": false}
      ]
    },
    {
      "op": "transpondere",
      "grup": "Semnal",
      "fel": "citire",
      "text": "transponderele din lista ta, cu numele canalelor",
      "args": [
        {"nume": "namespace", "tipar": "^[0-9a-fA-F]{1,8}$", "cerut": false}
      ]
    },
    {
      "op": "zap",
      "grup": "Control",
      "fel": "control",
      "text": "pornește un canal din lista ta",
      "args": [
        {"nume": "referinta", "tipar": "^[0-9]+:[^\\x00-\\x1f]*\\Z", "cerut": true, "max_semne": 4096}
      ]
    },
    {
      "op": "setare-scrie",
      "grup": "Control",
      "fel": "control",
      "text": "schimbă o setare a receptorului, inclusiv conturi",
      "args": [
        {"nume": "cheie", "tipar": "^config(\\.[^.\\x00-\\x20=]+)+\\Z", "cerut": true, "max_semne": 1024},
        {"nume": "valoare", "tipar": "^[^\\x00\\r\\n]*\\Z", "cerut": false, "max_semne": 16384}
      ]
    },
    {
      "op": "instaleaza",
      "grup": "Control",
      "fel": "control",
      "text": "instalează un pachet din sursele configurate ale receptorului",
      "args": [
        {"nume": "pachet", "tipar": "^[^\\x00-\\x20\\x7f]+\\Z", "cerut": true, "max_semne": 1024}
      ]
    },
    {
      "op": "dezinstaleaza",
      "grup": "Control",
      "fel": "control",
      "text": "dezinstalează un pachet al receptorului",
      "args": [
        {"nume": "pachet", "tipar": "^[^\\x00-\\x20\\x7f]+\\Z", "cerut": true, "max_semne": 1024}
      ]
    },
    {
      "op": "reporneste",
      "grup": "Control",
      "fel": "control",
      "text": "repornește interfața sau receptorul, cu anunț pe ecran; asistența continuă după repornire",
      "args": [
        {"nume": "ce", "tipar": "^(interfata|receptor)$", "cerut": true}
      ]
    },
    {
      "op": "repara-actualizarea",
      "grup": "Control",
      "fel": "control",
      "text": "termină o actualizare rămasă la jumătate: caută în feedul HD Satelit, pune din nou pachetele imaginii rămase neterminate și repornește interfața",
      "args": []
    },
    {
      "op": "repara-buchetele",
      "grup": "Control",
      "fel": "control",
      "text": "pune la loc buchetele care lipsesc din listă și curăță descrierile orfane, cu copie de siguranță",
      "args": []
    },
    {
      "op": "comanda",
      "grup": "Control",
      "fel": "control",
      "text": "rulează o comandă pe receptor, cu termenul cerut și ieșirea întreagă (fără scrierea imaginii în memorie și a pornirii)",
      "args": [
        {"nume": "comanda", "tipar": "(?s)^.{1,16384}$", "cerut": true, "max_semne": 16384},
        {"nume": "termen", "tipar": "^[1-9][0-9]{0,5}$", "cerut": false}
      ]
    },
    {
      "op": "scrie",
      "grup": "Control",
      "fel": "control",
      "text": "scrie un fișier mic pe receptor (cel mult 12 KB, dintr-o dată), cu o copie a celui de dinainte; nu în /boot",
      "args": [
        {"nume": "cale", "tipar": "^/[^\\x00]*[^/\\x00]\\Z", "cerut": true, "max_semne": 4096},
        {"nume": "continut", "tipar": "^[A-Za-z0-9+/]*={0,2}\\Z", "cerut": false, "max_semne": 16384},
        {"nume": "drept", "tipar": "^[0-7]{3,4}$", "cerut": false}
      ]
    }
  ]
}
