		<item text="Return to Flash" entryID="return_to_flash" pictograma="memoria-interna" web="/alimentare?f=flash" weight="50" requires="HdsMultiboot">
			<code><![CDATA[
from Screens.Standby import TryQuitMainloop
self.session.open(TryQuitMainloop, 0)
]]></code>
		</item>
		<item text="Deep Standby (Power Off)" entryID="deep_standby" pictograma="oprire" web="/alimentare?f=oprire" weight="60">
			<screen module="Standby" screen="TryQuitMainloop">1</screen>
		</item>
	</menu>

	<!-- 6. Media (din 0.2.6): playerul de fișiere (video, muzică) și pozele, de pe stick,
