msgid ""
"Parola a fost schimbată pe altă cale (de exemplu cu passwd), deci nu se mai "
"vede aici. Alege „Schimbă parola” ca s-o vezi din nou."
msgstr ""
"Lösenordet har ändrats på annat sätt (till exempel med passwd), så det visas "
"inte längre här. Välj ”Ändra lösenord” för att se det igen."

msgid ""
"Parola acestui loc nu este salvată pe receptor. Scrie-o din nou la Editează."
msgstr ""
"Lösenordet för den här platsen är inte sparat på mottagaren. Ange det igen "
"under Redigera."

msgid "Parola are prea multe semne: cel mult %d."
msgstr "Lösenordet har för många tecken: högst %d."

msgid "Parola are prea puține semne: cel puțin %d."
msgstr "Lösenordet har för få tecken: minst %d."

msgid "Parola contului VPN (după salvare nu se mai arată)"
msgstr "Lösenordet för VPN-kontot (visas inte längre efter att det sparats)"

msgid "Parola de administrator (root)"
msgstr "Administratörslösenord (root)"

msgid "Parola lui root, aceeași pentru FTP, SSH și SFTP"
msgstr "Lösenordet för root, samma för FTP, SSH och SFTP"

msgid "Parola lui root, aceeași pentru SSH și SFTP"
msgstr "Lösenordet för root, samma för SSH och SFTP"

msgid "Parola nouă"
msgstr "Nytt lösenord"

msgid ""
"Parola nouă e pusă. Merge pentru FTP, SSH și SFTP; cea veche nu mai merge."
msgstr ""
"Det nya lösenordet är inställt. Det fungerar för FTP, SSH och SFTP; det "
"gamla fungerar inte längre."

msgid "Parola nouă nu s-a putut face. Parola de dinainte rămâne."
msgstr ""
"Det nya lösenordet kunde inte skapas. Det tidigare lösenordet finns kvar."

msgid ""
"Parola nouă pentru aplicații e făcută. O vezi cu butonul Arată; scrie-o în "
"aplicațiile pe care le folosești din afara casei."
msgstr ""
"Det nya lösenordet för appar är skapat. Du ser det med knappen Visa; skriv "
"in det i apparna du använder utanför hemmet."

#, python-format
msgid ""
"Parola nouă pentru aplicații: %s. Scrie-o în aplicațiile pe care le "
"folosești din afara casei."
msgstr ""
"Nytt lösenord för appar: %s. Ange det i apparna du använder utanför hemmet."

msgid "Parola nouă: 4-64 de semne, fără spații și fără diacritice"
msgstr ""
"Nytt lösenord: 4-64 tecken, utan mellanslag och utan diakritiska tecken"

#, python-format
msgid "Parola nu este bună (cel mult %d semne, pe un singur rând)."
msgstr "Lösenordet är inte giltigt (högst %d tecken, på en rad)."

msgid ""
"Parola nu s-a putut face. Alege „Fă o parolă”. Până atunci se intră numai cu "
"o cheie."
msgstr ""
"Lösenordet kunde inte skapas. Välj ”Skapa ett lösenord”. Tills dess sker "
"inloggning bara med en nyckel."

msgid "Parola nu s-a putut pune. Parola de dinainte rămâne."
msgstr "Lösenordet kunde inte ställas in. Det tidigare lösenordet finns kvar."

msgid ""
"Parola nu se arată: o scrii doar când vrei s-o schimbi. Un câmp de parolă "
"gol o lasă cum e."
msgstr ""
"Lösenordet visas inte: du skriver det bara när du vill ändra det. Ett tomt "
"lösenordsfält lämnar det som det är."

msgid "Parola nu se mai arată. Dacă ai uitat-o, fă una nouă."
msgstr "Lösenordet visas inte längre. Om du har glömt det, skapa ett nytt."

msgid ""
"Parola nu se vede aici. Alege „Schimbă parola” și pune una nouă: de atunci "
"se vede oricând."
msgstr ""
"Lösenordet visas inte här. Välj ”Ändra lösenord” och ställ in ett nytt: "
"därefter visas det när som helst."

msgid "Parola pentru aplicații e greșită."
msgstr "Lösenordet för appar är fel."

msgid ""
"Parola poate avea numai litere fără diacritice, cifre și semne, fără spații."
msgstr ""
"Lösenordet får endast innehålla bokstäver utan diakritiska tecken, siffror "
"och symboler, utan mellanslag."

msgid "Parola receptorului"
msgstr "Mottagarens lösenord"

msgid "Parola rețelei"
msgstr "Nätverkslösenord"

msgid ""
"Parola rămâne pusă, dar nu se mai arată aici și nici în interfața web. Dacă "
"o uiți, faci una nouă."
msgstr ""
"Lösenordet förblir inställt, men visas inte längre här eller i "
"webbgränssnittet. Om du glömmer det, skapa ett nytt."

msgid "Parola salvată: da."
msgstr "Sparat lösenord: ja."

msgid "Parola salvată: nu."
msgstr "Sparat lösenord: nej."

msgid ""
"Parola se vede numai dintr-un browser conectat cu codul de pe televizor."
msgstr ""
"Lösenordet visas endast från en webbläsare ansluten med koden från tv:n."

msgid "Parola și cheia se văd numai dintr-un browser."
msgstr "Lösenordet och nyckeln kan bara ses från en webbläsare."

msgid ""
"Parola și cheile se văd și se schimbă numai dintr-un browser conectat cu "
"codul de pe televizor."
msgstr ""
"Lösenordet och nycklarna visas och ändras endast från en webbläsare ansluten "
"med koden från tv:n."

msgid ""
"Parola și cheile se văd și se schimbă numai dintr-un browser conectat cu "
"codul de pe televizor. Așa, cine e doar în rețeaua ta de acasă nu le poate "
"afla."
msgstr ""
"Lösenordet och nycklarna visas och ändras endast från en webbläsare ansluten "
"med koden från tv:n. På så sätt kan den som bara finns i ditt hemnätverk "
"inte få reda på dem."

msgid ""
"Parolele și cheile numai se scriu sau se șterg aici; nu se mai arată. Un "
"câmp lăsat gol nu schimbă nimic. Folosește pentru OpenSubtitles o parolă pe "
"care nu o mai folosești în altă parte. Numele de utilizator, nu adresa de e-"
"mail."
msgstr ""
"Lösenord och nycklar skrivs eller raderas bara här; de visas inte igen. Ett "
"fält som lämnas tomt ändrar ingenting. Använd för OpenSubtitles ett lösenord "
"som du inte använder någon annanstans. Användarnamnet, inte e-postadressen."

#, python-format
msgid ""
"Parolă greșită de %d ori de la %s (%s): am oprit cererile ei pentru %d "
