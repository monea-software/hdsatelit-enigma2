"foarte_gros&gt;&amp;culoare_contur=&lt;%23rrggbb&gt;&amp;umbra=0|1&amp;"
"culoare_umbra=&lt;%23rrggbb&gt;&amp;directie_umbra=&lt;sus|sus_dreapta|"
"dreapta|jos_dreapta|jos|jos_stanga|stanga|sus_stanga&gt;&amp;"
"distanta_umbra=&lt;50|100|150|200|300&gt;&amp;umbra_moale=&lt;tare|moale|"
"foarte_moale&gt;&amp;fundal=&lt;niciunul|rand|cutie&gt;&amp;"
"culoare_fundal=&lt;%23rrggbb&gt;&amp;opacitate_fundal=&lt;10..100&gt;&amp;"
"jos=&lt;2..25&gt;&amp;spatiere=&lt;80|90|100|110|125|150&gt;&amp;"
