msgid "Pe acest canal emite MUX1 în: %s."
msgstr "MUX1 sänder på denna kanal i: %s."

msgid "Pe acest loc nu se poate scrie: este numai pentru citire."
msgstr "Den här platsen kan inte skrivas till: den är skrivskyddad."

msgid ""
"Pe acest receptor (antenă cu motor sau un singur tuner de satelit) "
"transmisia merge numai cu canalele de pe frecvența televizorului: altfel "
"tunerul s-ar reacorda și antena s-ar putea mișca. Schimbă întâi canalul pe "
"televizor."
msgstr ""
"På den här mottagaren (motorantenn eller bara en satellittuner) fungerar "
"strömning bara med kanaler på tv:ns frekvens: annars skulle tunern ställa om "
"sig och antennen kunde röra sig. Byt först kanal på tv:n."

msgid "Pe acest receptor frecvența procesorului nu se poate citi sau schimba."
msgstr "På denna mottagare kan processorns frekvens inte läsas eller ändras."

msgid "Pe acest receptor nu e încă niciun beta tester. Vrei să fii primul?"
msgstr ""
"Det finns ännu ingen betatestare på denna mottagare. Vill du bli den första?"

msgid ""
"Pe acest tuner nu se poate acorda și nici căuta canale. Alege alt tuner din "
"rândul „Tuner”."
msgstr ""
"På denna tuner går det varken att ställa in eller söka kanaler. Välj en "
"annan tuner på raden ”Tuner”."

msgid "Pe antena ta"
msgstr "På din parabol"

msgid "Pe calculator descarcă un model, de exemplu: ollama pull gemma3:4b."
msgstr "På datorn ladda ner en modell, till exempel: ollama pull gemma3:4b."

msgid ""
"Pe calculator: săgețile aleg rândul, Shift + săgeți alege mai multe, Ctrl + "
"săgeți mută, Spațiu bifează, Delete șterge, Ctrl+C / Ctrl+X / Ctrl+V "
"copiază, taie și lipește, Ctrl+Z / Ctrl+Y anulează și reface, Ctrl+A alege "
"tot, Ctrl+S salvează, F2 redenumește."
msgstr ""
"På datorn: piltangenterna väljer raden, Skift + pilar väljer flera, Ctrl + "
"pilar flyttar, Mellanslag markerar, Delete tar bort, Ctrl+C / Ctrl+X / "
"Ctrl+V kopierar, klipper ut och klistrar in, Ctrl+Z / Ctrl+Y ångrar och gör "
"om, Ctrl+A väljer allt, Ctrl+S sparar, F2 byter namn."

msgid ""
"Pe calculatorul din casă: fără limită, gratuit; viteza depinde de calculator "
"(pentru cele 7 limbi din comandă, cam 2 GB de memorie liberă). Pe "
"libretranslate.com: Pro, traduceri nelimitate, cu rafale de până la 80 de "
"cereri pe minut; Business, până la 200 pe minut. Varianta de pe internet nu "
"e gratuită."
msgstr ""
"På datorn hemma: ingen gräns, gratis; hastigheten beror på datorn (för de 7 "
"språken i kommandot, ungefär 2 GB fritt minne). På libretranslate.com: Pro, "
"obegränsade översättningar, i skurar på upp till 80 förfrågningar per minut; "
"Business, upp till 200 per minut. Internetversionen är inte gratis."

msgid "Pe canal:"
msgstr "På kanalen:"

msgid ""
"Pe canalele cu aplicație HbbTV, bara de informații arată semnul HbbTV pe "
"roșu. Apasă ROȘU ca să pornești aplicația."
msgstr ""
"På kanaler med en HbbTV-applikation visar informationsfältet HbbTV-tecknet i "
"rött. Tryck RÖD för att starta applikationen."

#, python-format
msgid "Pe canalul %d și pe cele de lângă el nu e nicio altă rețea."
msgstr "Inget annat nätverk hörs på kanal %d eller kanalerna bredvid."

#, python-format
msgid ""
"Pe canalul %d și pe cele de lângă el sunt %d rețele, dar cu semnal slab."
msgstr "På kanal %d och kanalerna bredvid hörs %d nätverk, men svagt."

#, python-format
msgid ""
"Pe canalul %d și pe cele de lângă el sunt %d rețele: e cel mai puțin "
"aglomerat, dar tot nu e liber."
msgstr ""
"På kanal %d och kanalerna bredvid hörs %d nätverk: den är minst upptagen, "
"men ändå inte fri."

msgid "Pe canalul acesta nu era nimic de uitat."
msgstr "På denna kanal fanns inget att glömma."

msgid "Pe canalul acesta nu se poate programa o înregistrare."
msgstr "Det går inte att planera en inspelning på denna kanal."

msgid "Pe canalul acesta nu se ține minte nimic, merg alegerile de mai sus."
msgstr "På denna kanal kommer inget ihåg, valen ovan gäller."

#, python-format
msgid "Pe canalul acesta se ține minte: %s."
msgstr "På denna kanal kommer ihåg: %s."

msgid ""
"Pe care o încearcă întâi. Rețelele Wi-Fi salvate se încearcă în ordinea în "
"care au fost salvate."
msgstr ""
"Vilket som provas först. Sparade Wi-Fi-nätverk provas i den ordning de "
"sparades."

msgid "Pe ce merge acum nu se țin minte alegeri (nu e un canal)."
msgstr "För det som spelas nu kommer inga val ihåg (det är inte en kanal)."

#, python-format
msgid ""
"Pe disc există deja %s și nu e un fișier obișnuit. Swap-ul nu se pornește."
msgstr ""
"På disken finns redan %s och det är inte en vanlig fil. Swap startas inte."

#, python-format
msgid "Pe disc nu e destul loc: trebuie %s, sunt liberi %s."
msgstr "Inte tillräckligt med utrymme på disken: %s behövs, %s är ledigt."

msgid ""
"Pe disc nu e niciun sistem de fișiere pe care receptorul îl poate verifica "
"(ext2, ext3, ext4 sau FAT)."
msgstr ""
"Det finns inget filsystem på disken som mottagaren kan kontrollera (ext2, "
"ext3, ext4 eller FAT)."

msgid "Pe discurile conectate nu se poate înregistra."
msgstr "På de anslutna diskarna kan man inte spela in."

msgid "Pe ecran până la repornire"
msgstr "På skärmen tills omstart"

msgid "Pe ecran, cu săgețile. EXIT te întoarce aici."
msgstr "På skärmen, med piltangenterna. EXIT tar dig tillbaka hit."

msgid ""
"Pe ecran: atinge = alege, atinge rândul ales = OK, glisează = derulează, "
"ține apăsat = Meniu."
msgstr ""
"På skärmen: tryck = välj, tryck på vald rad = OK, svep = bläddra, tryck och "
"håll = Meny."

msgid ""
"Pe ecran: atinge = alege, atinge rândul ales = OK, glisează spre dreapta sau "
"Înapoi = Ieșire, ține apăsat = Meniu; după o atingere în casetă, glisarea în "
"sus și în jos derulează lista."
msgstr ""
"På skärmen: tryck = välj, tryck på vald rad = OK, svep åt höger eller Bakåt "
"= Avsluta, håll nedtryckt = Meny; efter ett tryck i rutan bläddrar svep upp "
"och ner genom listan."

msgid "Pe fiecare rând"
msgstr "På varje rad"

msgid "Pe furnizori"
msgstr "Per leverantör"

msgid ""
"Pe internet, Groq are un plan gratuit: adresa https://api.groq.com/openai/"
"v1, un model din planul gratuit (de exemplu openai/gpt-oss-20b) și cheia din "
"console.groq.com."
msgstr ""
"På internet har Groq en gratisplan: adressen https://api.groq.com/openai/v1, "
"en modell från gratisplanen (till exempel openai/gpt-oss-20b) och nyckeln "
"från console.groq.com."

msgid ""
"Pe internet, cu cheie: orice serviciu compatibil OpenAI merge; scrii adresa, "
"modelul și cheia lui. Groq și Cloudflare Workers au locul lor în lista "
"serviciilor, cu pașii lor: alege-le acolo."
msgstr ""
"På internet, med nyckel: alla OpenAI-kompatibla tjänster fungerar; du "
"skriver dess adress, modell och nyckel. Groq och Cloudflare Workers har sin "
"egen plats i listan över tjänster, med sina egna steg: välj dem där."

msgid ""
"Pe internet, cu plată: intră pe portal.libretranslate.com și apasă „Get API "
"Key”. Alege planul (Pro: 29 de dolari pe lună; Business: 58 de dolari pe "
"lună), apasă „BUY” și plătește. Nu există probă gratuită și nici cheie "
"gratuită; ai 7 zile să ceri banii înapoi."
msgstr ""
"På internet, betald: gå till portal.libretranslate.com och tryck på ”Get API "
"Key”. Välj planen (Pro: 29 dollar i månaden; Business: 58 dollar i månaden), "
"tryck på ”BUY” och betala. Det finns ingen gratis provperiod och ingen "
"gratis nyckel; du har 7 dagar på dig att be om pengarna tillbaka."

msgid ""
"Pe lângă expresiile de la evenimente. OK alege valoarea; se aplică după "
"salvare."
msgstr ""
"Utöver uttrycken vid händelser. OK väljer värdet; det tillämpas efter att du "
"sparat."

#, python-format
msgid "Pe mediul ales nu e destul loc (trebuie cam %d MB)."
msgstr "För lite plats på valt medium (behövs ca %d MB)."

msgid ""
"Pe pagina deschisă alege proiectul tău (cu facturarea pornită) și pornește "
"„Cloud Translation API”, dacă nu e pornit."
msgstr ""
"På den öppnade sidan väljer du ditt projekt (med fakturering på) och slår på "
"”Cloud Translation API”, om det inte är på."

msgid ""
"Pe pagina deschisă intră cu contul tău Google; prima dată accepți termenii."
msgstr ""
"På den öppnade sidan loggar du in med ditt Google-konto; första gången "
"accepterar du villkoren."

msgid "Pe pagina deschisă intră cu emailul sau cu contul tău Google."
msgstr ""
"På den öppnade sidan loggar du in med din e-post eller ditt Google-konto."

msgid ""
"Pe pagina deschisă intră în contul Cloudflare (sau fă unul gratuit): se "
"deschide pagina „Workers AI”. Apasă „Use REST API”."
msgstr ""
"På den öppnade sidan loggar du in på Cloudflare-kontot (eller skapar ett "
"gratis): sidan ”Workers AI” öppnas. Tryck på ”Use REST API”."

msgid ""
"Pe pagina deschisă intră în contul DeepL API. Dacă nu ai unul, fă-l gratuit, "
"cu planul „Developer” (1.000.000 de caractere, o singură dată)."
msgstr ""
"På den öppnade sidan loggar du in på DeepL API-kontot. Om du inte har något, "
"skapa det gratis med planen ”Developer” (1 000 000 tecken, bara en gång)."

msgid ""
"Pe pagina deschisă intră în contul DeepL API. Dacă nu ai unul, fă-l gratuit: "
"planul gratuit nu cere card."
msgstr ""
"På den öppnade sidan loggar du in på ditt DeepL API-konto. Om du inte har "
"något, skapa ett gratis: gratisplanen kräver inget kort."

msgid ""
"Pe pagina deschisă: „Resource group”, „Create new”; „Region” Global; un "
"nume; „Pricing tier” Free F0; apoi „Review + create” și „Create”."
msgstr ""
"På den öppnade sidan: ”Resource group”, ”Create new”; ”Region” Global; ett "
"namn; ”Pricing tier” Free F0; sedan ”Review + create” och ”Create”."

