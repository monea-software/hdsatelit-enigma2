msgstr ""
"<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code>: steg, rörelse "
"utan stopp, sparade positioner, gå till satellit, gränser, stopp"

msgid ""
"<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /"
"api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-"
"inchide</code>: navigatorul pe televizor"
msgstr ""
"<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /"
"api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-"
"inchide</code>: webbläsaren på tv:n"

msgid ""
"<code>POST /api/navigator-text</code>: text trimis în câmpul ales pe "
"televizor; numai din browserul asociat, cu textul în corpul cererii (cu "
"<code>?token=</code> se refuză)"
msgstr ""
"<code>POST /api/navigator-text</code>: text som skickas till det valda "
"fältet på tv:n; endast från den parade webbläsaren, med texten i begärans "
"brödtext (med <code>?token=</code> avvisas den)"

msgid ""
"<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: descarcă "
"modelul unei limbi (pe stick sau disc; în memoria internă numai cu intern=1)"
msgstr ""
"<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: laddar "
"ner modellen för ett språk (på USB-minne eller disk; i internminnet endast "
"med intern=1)"

msgid ""
"<code>POST /api/ocr-limbi-intreaba</code>: receptorul întreabă din nou "
"pentru limbile cu \"Nu mai întreba\""
msgstr ""
"<code>POST /api/ocr-limbi-intreaba</code>: mottagaren frågar igen för "
"språken med ”Fråga inte igen”"

msgid "<code>POST /api/ocr-limbi-opreste?model=slk</code>: oprește descărcarea"
msgstr ""
"<code>POST /api/ocr-limbi-opreste?model=slk</code>: stoppar nedladdningen"

msgid ""
"<code>POST /api/ocr-limbi-sterge?model=slk</code>: șterge un model descărcat "
"(sau îl scoate din listă când stickul lui nu e pus)"
msgstr ""
"<code>POST /api/ocr-limbi-sterge?model=slk</code>: tar bort en nedladdad "
"modell (eller tar bort den från listan när dess USB-minne inte är isatt)"

msgid ""
"<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</"
