msgid ""
"Cheia RSA are %d de biți. Receptorul primește numai chei RSA de cel puțin %d "
"de biți."
msgstr ""
"RSA-nyckeln har %d bitar. Mottagaren tar bara emot RSA-nycklar på minst %d "
"bitar."

msgid "Cheia SubDL merge."
msgstr "SubDL-nyckeln fungerar."

msgid "Cheia a fost ștearsă."
msgstr "Nyckeln har tagits bort."

msgid ""
"Cheia a fost ștearsă. Calculatorul cu această cheie intră de acum numai cu "
"parola."
msgstr ""
"Nyckeln raderades. Datorn med denna nyckel loggar nu bara in med lösenord."

msgid ""
"Cheia apare în portal; o poți verifica la „Test your API Key”. Aici scrie "
"adresa https://libretranslate.com și lipește cheia."
msgstr ""
"Nyckeln visas i portalen; du kan kontrollera den under ”Test your API Key”. "
"Här skriver du adressen https://libretranslate.com och klistrar in nyckeln."

msgid ""
"Cheia aplicației HD Satelit la OpenSubtitles. O dă HD Satelit; nu e cheia "
"contului tău."
msgstr ""
"Applikationsnyckeln för HD Satelit hos OpenSubtitles. HD Satelit "
"tillhandahåller den; det är inte nyckeln för ditt konto."

msgid "Cheia aplicației OpenSubtitles lipsește; o pune HD Satelit."
msgstr ""
"Applikationsnyckeln för OpenSubtitles saknas; HD Satelit tillhandahåller den."

