msgstr "Namnet används redan. Välj ett annat."

msgid ""
"Numele e gol sau are numai semne (punct, liniuță, spații). Unele pot fi "
"fluxuri care pornesc numai uneori: uită-te la frecvență și la imagine / "
"sunet."
msgstr ""
"Namnet är tomt eller har bara tecken (punkt, bindestreck, mellanslag). Vissa "
"kan vara feeds som bara sänder ibland: titta på frekvensen och på bild / "
"ljud."

msgid "Numele e salvat."
msgstr "Namnet är sparat."

msgid "Numele e titlul paginii lui."
msgstr "Namnet är titeln på dess sida."

msgid "Numele filmului"
msgstr "Filmens namn"

msgid ""
"Numele fișierului nu e bun sau playerul nu cunoaște acest fel de fișier."
msgstr ""
"Filnamnet är inte giltigt eller så känner inte spelaren till den här "
"filtypen."

msgid "Numele fișierului nu se poate citi"
msgstr "Filnamnet kan inte läsas"

msgid ""
"Numele fișierului nu se poate citi pe receptor. Redenumește-l fără "
"diacritice."
msgstr ""
"Filnamnet kan inte läsas på mottagaren. Byt namn på det utan diakritiska "
"tecken."

msgid "Numele fluxului"
msgstr "Strömmens namn"

msgid "Numele fontului"
msgstr "Typsnittets namn"

msgid "Numele fontului, de exemplu Roboto"
msgstr "Typsnittets namn, till exempel Roboto"

msgid "Numele marcajului"
msgstr "Markörens namn"

msgid "Numele modelului de pe server, de exemplu gemma3:4b sau qwen2.5:7b."
msgstr "Modellens namn på servern, till exempel gemma3:4b eller qwen2.5:7b."

msgid ""
"Numele modelului e prea lung sau are caractere nepermise. Nu s-a pornit "
"nimic."
msgstr ""
"Modellens namn är för långt eller innehåller otillåtna tecken. Inget "
"startades."

msgid "Numele modelului nu e bun."
msgstr "Modellnamnet är inte rätt."

msgid "Numele modulelor: %s"
msgstr "Modulnamn: %s"

msgid "Numele nou"
msgstr "Nytt namn"

#, python-format
msgid "Numele nu este bun (cel mult %d semne, pe un singur rând)."
msgstr "Namnet är inte giltigt (högst %d tecken, på en rad)."

msgid "Numele nu poate fi gol."
msgstr "Namnet får inte vara tomt."

msgid "Numele nu se poate schimba încă de aici."
msgstr "Namnet kan inte ändras härifrån än."

msgid "Numele pachetului nu este valid. Nu se instalează."
msgstr "Paketnamnet är ogiltigt. Installeras inte."

msgid "Numele pachetului nu este valid. Nu se șterge."
msgstr "Paketnamnet är ogiltigt. Tas inte bort."

msgid "Numele paginii (dacă vrei)"
msgstr "Sidans namn (valfritt)"

#, python-format
msgid "Numele pe televizor: %s, cerut de televizor la %s."
msgstr "Namn på tv:n: %s, begärt av tv:n kl. %s."

#, python-format
msgid "Numele pe televizor: %s."
msgstr "Namn på tv:n: %s."

msgid "Numele plăcii de sunet are numai litere, cifre și : , _ - ."
msgstr "Ljudenhetens namn har bara bokstäver, siffror och : , _ - ."

msgid ""
"Numele poate avea doar litere mici, cifre și semnele - _ . (cel mult 32)."
msgstr ""
"Namnet får bara innehålla små bokstäver, siffror och tecknen - _ . (högst "
"32)."

msgid "Numele postului de radio"
msgstr "Radiostationens namn"

msgid "Numele public"
msgstr "Offentligt namn"

msgid "Numele public are 2-40 de semne: litere, cifre, spațiu, punct, liniuță."
msgstr ""
"Det offentliga namnet har 2-40 tecken: bokstäver, siffror, mellanslag, "
"punkt, bindestreck."

msgid "Numele public e deja folosit de alt tester. Alege altul."
msgstr ""
"Det offentliga namnet används redan av en annan testare. Välj ett annat."

msgid "Numele receptorului"
msgstr "Mottagarens namn"

msgid "Numele receptorului pe televizor"
msgstr "Mottagarens namn på tv:n"

msgid "Numele rețelei ascunse"
msgstr "Det dolda nätverkets namn"

msgid "Numele satelitului"
msgstr "Satellitens namn"

msgid "Numele satelitului are un caracter care nu se poate scrie în listă."
msgstr "Satellitnamnet innehåller ett tecken som inte kan skrivas till listan."

msgid "Numele satelitului e prea lung: cel mult %d de caractere."
msgstr "Satellitnamnet är för långt: högst %d tecken."

msgid "Numele sau parola nu sunt bune. VPN-ul nu mai încearcă singur."
msgstr "Namnet eller lösenordet är fel. VPN försöker inte längre själv."

msgid "Numele serverului NTP nu este valid."
msgstr "NTP-serverns namn är ogiltigt."

msgid ""
"Numele serverului nu se găsește în rețea. Scrie adresa lui, de pildă "
"192.168.1.20."
msgstr ""
"Servernamnet kan inte hittas i nätverket. Ange dess adress, till exempel "
"192.168.1.20."

msgid "Numele setării, cu tastele 0-9"
msgstr "Inställningens namn, med knapparna 0-9"

msgid ""
"Numele spune HD sau 4K, dar emițătorul îl anunță ca SD: filtrul „HD și 4K” "
"nu-l prinde. Filtrul „HD în nume, tip SD” din „Adaugă canale” le arată pe "
"toate, cu bife."
msgstr ""
"Namnet säger HD eller 4K, men sändaren anger kanalen som SD: filtret ”HD och "
"4K” fångar den inte. Filtret ”HD i namnet, SD-typ” i ”Lägg till kanaler” "
"visar alla, med markeringar."

msgid "Numele sursei (litere mici, cifre și -)"
msgstr "Källans namn (små bokstäver, siffror och -)"

msgid "Numele sursei nu poate fi gol."
msgstr "Källans namn får inte vara tomt."

msgid "Numele sursei: litere mici, cifre și -"
msgstr "Källans namn: små bokstäver, siffror och -"

msgid "Numele telecomenzii"
msgstr "Fjärrkontrollens namn"

msgid "Numele telecomenzii nu poate fi gol."
msgstr "Fjärrkontrollens namn får inte vara tomt."

msgid "Numele tău pe forum"
msgstr "Ditt namn på forumet"

msgid "Numele tău pe forum e acum „%s”."
msgstr "Ditt namn på forumet är nu ”%s”."

msgid "Numele și parola au fost șterse de pe receptor."
msgstr "Namnet och lösenordet har tagits bort från mottagaren."

msgid "Numele și parola contului"
msgstr "Kontots namn och lösenord"

msgid ""
"Numele și parola contului HMA. După salvare nu se mai arată nicăieri. Se "
"scriu mai ușor din telefon, în interfața web."
msgstr ""
"Namnet och lösenordet för ditt HMA-konto. Efter att de sparats visas de "
"aldrig igen. De är lättare att skriva från telefonen, i webbgränssnittet."

msgid "Numele și parola de serviciu"
msgstr "Tjänstenamn och -lösenord"

msgid "Numele și parola din fișier nu se folosesc: se scriu pe receptor."
msgstr ""
"Namnet och lösenordet i filen används inte: de skrivs in på mottagaren."

msgid "Numele și parola sunt salvate. Nu se mai arată nicăieri."
msgstr "Namnet och lösenordet är sparade. De visas inte längre någonstans."

msgid "Numele, cu tastatura de pe ecran"
msgstr "Namnet, med skärmtangentbordet"

msgid "Numele, cu tastele 0-9"
msgstr "Namnet, med knapparna 0-9"

msgid ""
"Numerele DVB ale fluxului (pentru siglă): SID, TSID, ONID, namespace (hex)"
msgstr "Strömmens DVB-nummer (för logotypen): SID, TSID, ONID, namespace (hex)"

msgid "Număr de fișiere"
msgstr "Antal filer"

msgid "Numărate de la ora"
msgstr "Räknade från"

msgid "Numărul canalului"
msgstr "Kanalnummer"

msgid "Numărul canalului din lista de canale."
msgstr "Kanalnumret från kanallistan."

#, python-format
msgid "Numărul copiilor păstrate trebuie să fie între 1 și %d."
msgstr "Antalet sparade kopior måste vara mellan 1 och %d."

msgid "Numărul de bare"
msgstr "Antal staplar"

msgid "Numărul de secunde nu este bun."
msgstr "Antalet sekunder är ogiltigt."

msgid "Numărul din lista de canale, cel la care duc cifrele telecomenzii."
msgstr "Numret från kanallistan, dit siffrorna på fjärrkontrollen leder."

msgid ""
"Numărul mare nu înseamnă procesor ocupat: include firele driverelor care "
"așteaptă."
msgstr ""
"Ett högt tal betyder inte att processorn är upptagen: det inkluderar "
"drivrutinstrådar som väntar."

msgid "Numărul operatorului"
msgstr "Operatörens nummer"

msgid "Numărul poziției (1-255)"
msgstr "Positionsnummer (1-255)"

#, python-format
msgid "Numărul procesului (PID): %s"
msgstr "Processnummer (PID): %s"

msgid "Numărul rețelei (ONID)"
msgstr "Nätverksnummer (ONID)"

msgid "Numărul transponderului (TSID)"
msgstr "Transpondernummer (TSID)"

msgid "Numărul și numele"
msgstr "Nummer och namn"

msgid "Numărătoarea opririlor"
msgstr "Stoppräknare"

msgid ""
"O adresă http:// merge numai pentru un server din rețeaua de acasă (de "
"exemplu 192.168.1.50); pentru un server de pe internet scrie https://."
msgstr ""
"En http://-adress fungerar bara för en server i hemnätverket (till exempel "
"192.168.1.50); för en server på internet skriv https://."

msgid ""
"O altă placă e deja configurată. Pe televizor, aceeași întrebare apare la OK."
msgstr ""
"Ett annat kort är redan konfigurerat. På tv:n visas samma fråga vid OK."

msgid "O altă schimbare a rețelei încă lucrează. Așteaptă să se termine."
msgstr "En annan nätverksändring pågår fortfarande. Vänta tills den är klar."

msgid "O altă schimbare de LNB așteaptă confirmarea."
msgstr "En annan LNB-ändring väntar på bekräftelse."

msgid "O altă valoare a receptorului nu se potrivește."
msgstr "Ett annat värde hos mottagaren stämmer inte."

msgid "O captură aleasă nu mai există. Alege din nou."
msgstr "En vald skärmdump finns inte längre. Välj igen."

msgid ""
"O cheie pleacă numai pe https:// sau spre un server din rețeaua de acasă. "
"Scrie adresa cu https://. Cheia nu a plecat nicăieri."
msgstr ""
"En nyckel skickas endast via https:// eller till en server i hemnätverket. "
"Skriv adressen med https://. Nyckeln skickades ingenstans."

msgid "O conectare Wi-Fi încă lucrează. Așteaptă să se termine sau oprește-o."
msgstr ""
"En Wi-Fi-anslutning pågår fortfarande. Vänta tills den är klar eller stoppa "
"den."

msgid "O copie așteaptă să fie pusă la loc la repornirea interfeței."
msgstr "En kopia väntar på att återställas när gränssnittet startar om."

msgid "O copie se face deja. Așteaptă să se termine."
msgstr "En kopia görs redan. Vänta tills den är klar."

msgid ""
"O copie se face singură înainte de fiecare salvare, aici și în interfața "
"web. Întoarcerea pune întâi lista de acum într-o copie nouă."
msgstr ""
"En kopia görs automatiskt före varje sparande, här och i webbgränssnittet. "
"Återställningen lägger först den nuvarande listan i en ny kopia."

msgid "O cutie pentru toate rândurile"
msgstr "En ruta för alla rader"

msgid ""
"O căutare e deja în curs pe receptor. Așteaptă să se termine sau oprește-o."
msgstr ""
"En sökning pågår redan på mottagaren. Vänta tills den är klar eller stoppa "
"den."

msgid "O căutare e deja în curs."
msgstr "En sökning pågår redan."

msgid "O căutare sau o descărcare merge deja; așteaptă să se termine."
msgstr "En sökning eller nedladdning pågår redan; vänta tills den är klar."

msgid ""
"O data pe zi, in fundal, receptorul ia de pe stb.hdsatelit.com frecventele "
"si numele posturilor. Butonul Actualizeaza lista merge oricand."
msgstr ""
"En gång per dag, i bakgrunden, hämtar mottagaren frekvenserna och "
"stationernas namn från stb.hdsatelit.com. Knappen Uppdatera listan fungerar "
"när som helst."

msgid "O dată pe minut"
msgstr "En gång per minut"

msgid "O dată pe săptămână"
msgstr "En gång i veckan"

msgid ""
"O dată pe zi, noaptea, numai felurile bifate, și imediat după o oprire "
"neașteptată a interfeței sau o actualizare care nu a reușit. Fără bifă "
"pleacă numai ce trimiți tu cu „Trimite acum”."
msgstr ""
"En gång per dag, på natten, bara de markerade slagen, och direkt efter ett "
"oväntat stopp av gränssnittet eller en misslyckad uppdatering. Utan "
"markering skickas bara det du själv skickar med ”Skicka nu”."

msgid ""
"O dată pe zi, în fundal, receptorul ia de pe stb.hdsatelit.com frecvențele "
"și numele posturilor. Butonul „Actualizează lista” merge oricând. <span "
"id=\"ultimaZilnica\"></span>"
msgstr ""
"En gång per dag, i bakgrunden, hämtar mottagaren frekvenserna och namnen på "
"stationerna från stb.hdsatelit.com. Knappen ”Uppdatera listan” fungerar när "
"som helst. <span id=\"ultimaZilnica\"></span>"

msgid "O eroare pe receptor."
msgstr "Ett fel på mottagaren."

msgid "O greșeală, o idee sau o întrebare, direct echipei."
msgstr "Ett fel, en idé eller en fråga, direkt till teamet."

msgid "O lipești, iar receptorul recunoaște singur serviciul."
msgstr "Du klistrar in den, och mottagaren känner igen tjänsten själv."

msgid ""
"O listă de redare de pe disc nu se poate șterge din player, nici pe "
"televizor."
msgstr ""
"En spellista på disken kan inte raderas från spelaren, inte ens på tv:n."

msgid "O margine e între 0 și 5 la sută din latura ei."
msgstr "En marginal är mellan 0 och 5 procent av sin sida."

msgid "O notă despre emisiune. OK deschide tastatura."
msgstr "En anteckning om programmet. OK öppnar tangentbordet."

msgid "O pagină mai jos"
msgstr "En sida ner"

msgid "O pagină mai sus"
msgstr "En sida upp"

msgid "O pagină în jos"
msgstr "En sida nedåt"

msgid "O pagină în sus"
msgstr "En sida uppåt"

msgid ""
"O poză nu a putut fi urcată: trebuie să fie JPG sau PNG, de cel mult 4 MB."
msgstr ""
"En bild kunde inte laddas upp: den måste vara JPG eller PNG, högst 4 MB."

msgid "O poți instala din nou oricând, din aceeași sursă."
msgstr "Du kan installera om den när som helst, från samma källa."

msgid "O probă DiSEqC e deja deschisă pe televizor. Închide-o întâi."
msgstr "En DiSEqC-test är redan öppen på tv:n. Stäng den först."

msgid "O reîmprospătare e deja în lucru."
msgstr "En uppdatering pågår redan."

msgid "O reîncărcare e deja în curs."
msgstr "En omladdning pågår redan."

msgid ""
"O scanare DAB+ sau DVB-T2 e deschisă pe televizor. Așteaptă să se termine "
"sau oprește-o."
msgstr ""
"En DAB+- eller DVB-T2-sökning är öppen på tv:n. Vänta tills den är klar "
"eller stoppa den."

msgid "O singură dată"
msgstr "En gång"

msgid ""
"O singură dată sau repetat: în fiecare zi, o dată pe săptămână, de luni până "
"vineri sau în zilele alese."
msgstr ""
"En gång eller upprepad: varje dag, en gång i veckan, måndag till fredag "
"eller på valda dagar."

msgid "O singură limbă: forumul traduce singur."
msgstr "Ett enda språk: forumet översätter själv."

msgid ""
"O telecomandă USB (sau o tastatură) se bagă în receptor înainte; se vede "
"imediat."
msgstr ""
"Anslut en USB-fjärrkontroll (eller ett tangentbord) till mottagaren först; "
"den känns igen direkt."

msgid ""
"O telecomandă cu infraroșu, alta decât a receptorului, nu se poate asocia "
"încă."
msgstr ""
"En infraröd fjärrkontroll, annan än mottagarens, kan inte parkopplas ännu."

msgid "O valoare a transponderului nu e bună: %s."
msgstr "Ett värde på transpondern är inte giltigt: %s."

msgid "O înregistrare e în curs."
msgstr "En inspelning pågår."

msgid "O înregistrare e în curs: se oprește la revenire."
msgstr "En inspelning pågår: den stoppas vid återställningen."

msgid ""
"O înregistrare folosește acum antena. Comenzile pornesc după ce se termină."
msgstr ""
"En inspelning använder parabolen nu. Kommandona startar när den är klar."

msgid ""
"O înregistrare folosește acum tunerul. Locul se schimbă după ce se termină."
msgstr "En inspelning använder tunern nu. Platsen ändras när den är klar."

msgid "O înregistrare programată nu poate porni: nu am unde să înregistrez."
msgstr ""
"En planerad inspelning kan inte starta: det finns ingen plats att spela in "
"på."

#, python-format
msgid "O înregistrare scrie acum pe acest disc: %s."
msgstr "En inspelning skriver nu till den här disken: %s."

msgid "O înregistrare începe în curând. Pornește scanarea detaliată după ea."
msgstr ""
"En inspelning börjar snart. Starta den detaljerade sökningen efter den."

#, python-format
msgid "O înregistrare începe în mai puțin de %d minute."
msgstr "En inspelning börjar om mindre än %d minuter."

msgid "O înregistrare începe în mai puțin de 6 minute."
msgstr "En inspelning börjar om mindre än 6 minuter."

msgid "OK"
msgstr "OK"

msgid "OK = da, EXIT = nu"
msgstr "OK = ja, EXIT = nej"

msgid "OK actualizează · Roșu șterge"
msgstr "OK uppdaterar · Röd tar bort"

msgid "OK adaugă"
msgstr "OK lägger till"

msgid ""
"OK adaugă canalul în buchetul din dreapta · cifrele scriu numele · HELP "
"ajutor"
msgstr ""
"OK lägger till kanalen i buketten till höger · siffror skriver namnet · HELP "
"hjälp"

msgid "OK add to playlist, MENU options, CH+ / CH- switch list"
msgstr "OK lägg till i spellistan, MENU alternativ, CH+ / CH- byt lista"

msgid "OK alege"
msgstr "OK väljer"

msgid "OK alege capturile, Verde le pune în mesaj."
msgstr "OK väljer skärmdumparna, Grön lägger dem i meddelandet."

msgid "OK alege feedul pachetelor arătate."
msgstr "OK väljer feeden för visade paket."

msgid "OK alege feedul sau felul pachetelor arătate."
msgstr "OK väljer feeden eller typen av visade paket."

msgid ""
"OK alege latura: toate, sus, dreapta, jos sau stânga. Săgeata spre margine "
"duce latura aleasă spre marginea ecranului, săgeata opusă o aduce spre "
"mijloc. La toate laturile, Sus și Dreapta măresc cadrul, Jos și Stânga îl "
"micșorează. Potrivește cadrul până se vede întreg pe televizor."
msgstr ""
"OK väljer sida: alla, upp, höger, ner eller vänster. Pilen mot kanten "
"flyttar vald sida mot skärmens kant, motsatt pil flyttar den mot mitten. Vid "
"alla sidor gör UPP och HÖGER ramen större, NER och VÄNSTER gör den mindre. "
"Justera ramen tills du ser hela på tv:n."

msgid ""
"OK alege orașul. Ora lui apare când „Ora din alt oraș” e în lista de rotire."
msgstr ""
"OK väljer staden. Dess tid visas när ”Tid i en annan stad” finns i "
"rotationslistan."

msgid "OK alege valoarea."
msgstr "OK väljer värdet."

msgid "OK alege valoarea. Luminozitatea se aplică după salvare."
msgstr "OK väljer värdet. Ljusstyrkan gäller efter sparandet."

msgid "OK alege valoarea. Se aplică după salvare."
msgstr "OK väljer värdet. Det tillämpas efter att du sparat."

msgid "OK alege · Roșu arată tot"
msgstr "OK väljer · Röd visar allt"

msgid ""
"OK alegi canalele ale căror piste se citesc acum · Stânga înapoi la nume"
msgstr "OK väljer kanalerna vars spår läses nu · Vänster tillbaka till namnet"

msgid "OK arată canalele"
msgstr "OK visar kanalerna"

msgid "OK arată de ce"
msgstr "OK visar varför"

msgid "OK arată de ce · Verde instalează înlocuitorul"
msgstr "OK visar varför · Grön installerar ersättaren"

msgid ""
"OK arată fișierele de setări ale serverelor SSH și FTP, așa cum sunt pe "
"receptor."
msgstr ""
"OK visar inställningsfilerna för SSH- och FTP-servrarna, så som de finns på "
"mottagaren."

msgid ""
"OK arată fișierele de setări ale serverului SSH, așa cum sunt pe receptor."
msgstr "OK visar SSH-serverns inställningsfiler så som de finns på mottagaren."

msgid "OK ascunde canalele"
msgstr "OK döljer kanalerna"

msgid "OK bifează sau debifează"
msgstr "OK markerar eller avmarkerar"

msgid "OK bifează sau debifează · pe titlul grupei: toată grupa"
msgstr "OK markerar eller avmarkerar · på gruppens rubrik: hela gruppen"

msgid ""
"OK bifează și trece mai jos · tastele colorate lucrează pe rândurile bifate"
msgstr ""
"OK markerar och går nedåt · färgknapparna arbetar på de markerade raderna"

msgid "OK caută"
msgstr "OK söker"

msgid ""
"OK caută singur serverul din casă (LibreTranslate sau Ollama) și îl "
"probează. Adresa se poate scrie și de mână, mai jos."
msgstr ""
"OK söker själv efter servern hemma (LibreTranslate eller Ollama) och testar "
"den. Adressen kan också skrivas för hand nedan."

msgid "OK caută în rețea"
msgstr "OK söker i nätverket"

msgid "OK deschide"
msgstr "OK öppnar"

msgid ""
"OK deschide adresele puse de mână, listele predefinite și pornirea DVB-I."
msgstr ""
"OK öppnar de manuellt tillagda adresserna, de förinställda listorna och DVB-"
"I-omkopplaren."

msgid ""
"OK deschide buchetul · Stânga / Dreapta: coloana · < anulează · > refă · "
"HELP ajutor"
msgstr ""
"OK öppnar buketten · Vänster / Höger: kolumn · < ångra · > gör om · HELP "
"hjälp"

msgid ""
"OK deschide lista limbilor: cele din imagine, cele descărcate și cele care "
"se pot descărca, cu mărimea fiecăreia."
msgstr ""
"OK öppnar språklistan: de i imagen, de nedladdade och de som kan laddas ner, "
"med storleken på var och en."

msgid "OK deschide meniul, cu „Locul înregistrărilor”."
msgstr "OK öppnar menyn, med ”Inspelningsplats”."

msgid ""
"OK deschide pașii pentru serviciul ales: contul, cheia gratuită, cota și ce "
"se întâmplă la depășire."
msgstr ""
