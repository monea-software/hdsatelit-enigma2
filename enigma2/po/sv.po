msgstr ""
"<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=.."
"&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</"
"code>: inställningarna för radioskärmen"

msgid ""
"<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: vizualizarea "
