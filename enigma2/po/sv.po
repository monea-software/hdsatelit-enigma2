msgstr ""
"<code>POST /api/scanare-fluxuri</code>: valet i slutet av DAB+ / DVB-T2-"
"sökningen på tv:n (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</"
"code>, <code>din_nou</code>, <code>porneste</code>)"

msgid ""
"<code>POST /api/scanare-opreste</code>: oprește căutarea sau închide "
"rezultatul rămas pe televizor"
msgstr ""
"<code>POST /api/scanare-opreste</code>: stoppar sökningen eller stänger "
"resultatet som är kvar på tv:n"

msgid ""
"<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;"
"&amp;...</code>: pornește căutarea pe televizor (cu <code>confirmat=1</code> "
"după o întrebare)"
msgstr ""
"<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;"
"&amp;...</code>: startar sökningen på tv:n (med <code>confirmat=1</code> "
"efter en fråga)"

msgid ""
"<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: deschide pe "
"televizor ecranul unei intrări din cele două secțiuni"
msgstr ""
"<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: öppnar på tv:n "
