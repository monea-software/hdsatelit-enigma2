msgid "„%s” se alege cu 1 (da) sau 0 (nu)."
msgstr "”%s” väljs med 1 (ja) eller 0 (nej)."

msgid "„%s”, liber %s din %s"
msgstr "”%s”, ledigt %s av %s"

msgid "„%s”: aici se salvează acum"
msgstr "”%s”: här sparas nu"

msgid "„%s”: aici se vor salva"
msgstr "”%s”: inspelningar sparas här"

msgid ""
"„Adresă proprie” (alt serviciu, cu adresa lui) și toate celelalte setări "
"sunt pe pagina cu toate setările:"
msgstr ""
"”Egen adress” (en annan tjänst, med sin adress) och alla andra inställningar "
"finns på sidan med alla inställningar:"

msgid ""
"„Adresă proprie” e pentru un server de traducere ales de tine, de exemplu un "
"LibreTranslate pornit pe un calculator din casă. Receptorul trimite fiecare "
"rând de subtitrare într-o cerere separată."
msgstr ""
"”Egen adress” är för en översättningsserver du väljer, till exempel en "
"LibreTranslate som körs på en dator hemma. Mottagaren skickar varje "
"undertextrad i en separat förfrågan."

msgid "„Ca la calculator” revine la următoarea pornire a receptorului."
msgstr "”Som på dator” återkommer vid nästa start av mottagaren."

msgid ""
"„Ca la calculator” revine numai după o repornire. Repornești receptorul acum?"
msgstr ""
"”Som på dator” återkommer först efter en omstart. Startar du om mottagaren "
"nu?"

msgid ""
"„Ca la calculator” se aplică la următoarea pornire; pe unele televizoare "
"imaginea iese spălăcită pe 60 Hz."
msgstr ""
"”Som på dator” tillämpas vid nästa start; på vissa tv-apparater blir bilden "
"urblekt vid 60 Hz."

msgid ""
"„Ca la calculator” se aplică numai după o repornire. Repornești receptorul "
"acum?"
msgstr ""
"”Som på dator” tillämpas först efter en omstart. Startar du om mottagaren nu?"

msgid ""
"„Enigma” și „Dreambox” sunt mărci ale Dream Property GmbH; celelalte nume de "
"produse aparțin deținătorilor lor."
msgstr ""
"”Enigma” och ”Dreambox” är varumärken tillhörande Dream Property GmbH; "
"övriga produktnamn tillhör sina ägare."

msgid ""
"„Folosește pentru înregistrări” face pe disc dosarul movie, dacă lipsește. "
"Nu se șterge și nu se formatează nimic."
msgstr ""
"”Använd för inspelningar” skapar mappen movie på disken om den saknas. "
"Ingenting tas bort eller formateras."

msgid "„Fără subtitrări niciodată” se alege cu 1 (da) sau 0 (nu)."
msgstr "”Aldrig visa undertexter” väljs med 1 (ja) eller 0 (nej)."

msgid ""
"„Redenumește” schimbă numele numai în acest buchet. „Redenumește peste tot” "
"îl schimbă în lista receptorului."
msgstr ""
"”Byt namn” ändrar namnet bara i den här buketten. ”Byt namn överallt” ändrar "
"det i mottagarens lista."

msgid "„Standby” pornește automat fără nicio înregistrare activă."
msgstr "”Standby” startar automatiskt när ingen inspelning är aktiv."

msgid "„pornit” se alege cu 1 (da) sau 0 (nu)."
msgstr "”pornit” väljs med 1 (ja) eller 0 (nej)."

msgid "−1 min"
msgstr "−1 min"

