#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Intră pe azure.microsoft.com și apasă „Try Azure for free”. Te înscrii cu un "
"cont Microsoft; Microsoft cere un număr de telefon și un card, numai pentru "
"verificare."
msgstr "Intră pe azure.microsoft.com și apasă „Try Azure for free”. Te înscrii cu un cont Microsoft; Microsoft cere un număr de telefon și un card, numai pentru verificare."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Intră pe portal.azure.com, caută „Translator” în bara de sus și începe o "
"resursă nouă („Create”)."
msgstr "Intră pe portal.azure.com, caută „Translator” în bara de sus și începe o resursă nouă („Create”)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"La „Resource group” apasă „Create new” și scrie orice nume. La „Region” "
"alege „Global”, la „Name” scrie un nume al tău, iar la „Pricing tier” alege "
"„Free F0”."
msgstr "La „Resource group” apasă „Create new” și scrie orice nume. La „Region” alege „Global”, la „Name” scrie un nume al tău, iar la „Pricing tier” alege „Free F0”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Apasă „Review + create”, apoi „Create”. Când e gata, apasă „Go to resource”."
msgstr "Apasă „Review + create”, apoi „Create”. Când e gata, apasă „Go to resource”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În stânga alege „Keys and Endpoint” și copiază „KEY 1”. Dacă nu ai ales "
"„Global”, notează și regiunea (de exemplu westeurope)."
msgstr "În stânga alege „Keys and Endpoint” și copiază „KEY 1”. Dacă nu ai ales „Global”, notează și regiunea (de exemplu westeurope)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pune cheia aici (și regiunea, dacă resursa nu e „Global”)."
msgstr "Pune cheia aici (și regiunea, dacă resursa nu e „Global”)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În primele 30 de zile trece abonamentul pe „Pay as you go”, altfel Microsoft "
"oprește contul gratuit. Resursa „Free F0” rămâne gratuită."
msgstr "În primele 30 de zile trece abonamentul pe „Pay as you go”, altfel Microsoft oprește contul gratuit. Resursa „Free F0” rămâne gratuită."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "2.000.000 de caractere pe lună, gratuit."
msgstr "2.000.000 de caractere pe lună, gratuit."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Traducerea se oprește (eroarea 403) până luna următoare. Pe „Free F0” nu se "
"plătește nimic."
msgstr "Traducerea se oprește (eroarea 403) până luna următoare. Pe „Free F0” nu se plătește nimic."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Intră pe console.cloud.google.com cu contul tău Google și fă un proiect nou."
msgstr "Intră pe console.cloud.google.com cu contul tău Google și fă un proiect nou."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Activează facturarea: Google cere un card la înscriere (90 de zile de probă)."
msgstr "Activează facturarea: Google cere un card la înscriere (90 de zile de probă)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Caută „Cloud Translation API” în bara de sus și apasă „Enable”."
msgstr "Caută „Cloud Translation API” în bara de sus și apasă „Enable”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Mergi la „APIs & Services”, „Credentials”, „Create credentials”, „API key” "
"și copiază cheia."
msgstr "Mergi la „APIs & Services”, „Credentials”, „Create credentials”, „API key” și copiază cheia."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Apasă pe cheie, la „API restrictions” alege „Restrict key”, bifează „Cloud "
"Translation API” și apasă „Save”."
msgstr "Apasă pe cheie, la „API restrictions” alege „Restrict key”, bifează „Cloud Translation API” și apasă „Save”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Ca să nu plătești: „APIs & Services”, „Cloud Translation API”, fila "
"„Quotas”, cota de caractere pe zi, „Edit quotas”, scrie 15000. O alertă de "
"buget NU oprește plata."
msgstr "Ca să nu plătești: „APIs & Services”, „Cloud Translation API”, fila „Quotas”, cota de caractere pe zi, „Edit quotas”, scrie 15000. O alertă de buget NU oprește plata."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pune cheia aici."
msgstr "Pune cheia aici."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Primele 500.000 de caractere pe lună sunt gratuite."
msgstr "Primele 500.000 de caractere pe lună sunt gratuite."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Peste cotă se plătește automat (20 de dolari pe milion de caractere), dacă "
"nu ai coborât cota pe zi. Cu cota coborâtă, traducerea se oprește până a "
"doua zi."
msgstr "Peste cotă se plătește automat (20 de dolari pe milion de caractere), dacă nu ai coborât cota pe zi. Cu cota coborâtă, traducerea se oprește până a doua zi."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Intră pe deepl.com/en/developers și apasă „Get a free API key”. DeepL nu "
"cere card."
msgstr "Intră pe deepl.com/en/developers și apasă „Get a free API key”. DeepL nu cere card."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Dacă ai deja cont la traducătorul DeepL, ieși din el și fă un cont nou, "
"separat, pentru API."
msgstr "Dacă ai deja cont la traducătorul DeepL, ieși din el și fă un cont nou, separat, pentru API."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Alege planul gratuit „DeepL API Developer” și termină înscrierea."
msgstr "Alege planul gratuit „DeepL API Developer” și termină înscrierea."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În cont mergi la „API Keys” („API Keys & Limits”). Dacă nu ai nicio cheie, "
"apasă „Create key”, scrie un nume și apasă din nou „Create key”."
msgstr "În cont mergi la „API Keys” („API Keys & Limits”). Dacă nu ai nicio cheie, apasă „Create key”, scrie un nume și apasă din nou „Create key”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Copiază cheia cu iconița de lângă ea și pune-o aici."
msgstr "Copiază cheia cu iconița de lângă ea și pune-o aici."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Cont nou: 1.000.000 de caractere în total, o singură dată, nu în fiecare "
"lună. O cheie veche „DeepL API Free” (se termină cu :fx) are 500.000 de "
"caractere pe lună."
msgstr "Cont nou: 1.000.000 de caractere în total, o singură dată, nu în fiecare lună. O cheie veche „DeepL API Free” (se termină cu :fx) are 500.000 de caractere pe lună."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Traducerea se oprește (eroarea 456). Nu se plătește nimic singur; pentru mai "
"mult trebuie un plan plătit."
msgstr "Traducerea se oprește (eroarea 456). Nu se plătește nimic singur; pentru mai mult trebuie un plan plătit."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Pe un calculator din casă instalează Docker Desktop (docs.docker.com) și "
"pornește-l."
msgstr "Pe un calculator din casă instalează Docker Desktop (docs.docker.com) și pornește-l."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În PowerShell scrie o singură comandă: docker run -d --restart "
"unless-stopped --name libretranslate -p 5000:5000 -v "
"lt-local:/home/libretranslate/.local libretranslate/libretranslate "
"--load-only en,ro,de,fr,it,es,hu"
msgstr "În PowerShell scrie o singură comandă: docker run -d --restart unless-stopped --name libretranslate -p 5000:5000 -v lt-local:/home/libretranslate/.local libretranslate/libretranslate --load-only en,ro,de,fr,it,es,hu"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"La prima pornire așteaptă câteva minute (descarcă limbile). Deschide "
