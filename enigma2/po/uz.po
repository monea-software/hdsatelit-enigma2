msgstr "Eslab qolingan jildlar"

msgid "Dosarul"
msgstr "Jild"

msgid "Dosarul are foarte multe fișiere: se arată numai o parte."
msgstr "Jildda juda ko‘p fayllar bor: faqat bir qismi ko‘rsatilmoqda."

msgid "Dosarul deschis mai sus"
msgstr "Yuqorida ochilgan jild"

msgid "Dosarul jurnalelor"
msgstr "Jurnallar jildi"

msgid "Dosarul nu are filme."
msgstr "Jildda filmlar yo‘q."

