msgstr "EPGni tarjima qilish"

msgid "Ce s-a tradus din EPG"
msgstr "EPGdan tarjima qilinganlar"

#, python-format
msgid "%d texte, %d semne"
msgstr "%d matn, %d belgi"

#, python-format
msgid ""
"Ghidul: texte traduse %d (%d semne trimise, din cota serviciului), cereri %d,"
" deja în limba ta %d, sărite %d."
msgstr ""
"EPG: tarjima qilingan matnlar %d (%d belgilar yuborildi, xizmat kvotasidan), "
"so‘rovlar %d, allaqachon sizning tilingizda %d, o‘tkazib yuborilgan %d."

#, python-format
msgid "Traduceri ținute minte: %d (%s)."
msgstr "Eslab qolingan tarjimalar: %d (%s)."

msgid "și pe stick sau disc"
msgstr "shuningdek, USB fleshka yoki diskda"

msgid "numai până la repornire; cu un stick sau un disc se păstrează"
msgstr "faqat qayta ishga tushirguncha; USB fleshka yoki diskda saqlanadi"

msgid ""
"Traduce automat titlurile și descrierile emisiunilor care sunt pe ecran (bara"
" de jos, a doua bară, ghidul, detaliile emisiunii) în limba traducerii, cu "
"aceleași servicii și chei. Consumă din cota serviciului, de aceea din fabrică"
" e oprită. Textul deja în limba ta nu se trimite, iar o traducere ținută "
"minte nu se mai cere. În detaliile emisiunii, INFO arată textul original."
msgstr ""
"Ekrandagi ko‘rsatuvlarning sarlavhalari va tavsiflarini (pastki panel, "
"ikkinchi panel, teledastur, ko‘rsatuv tafsilotlari) xuddi shu xizmatlar va "
"kalitlar yordamida tarjima tiliga avtomatik tarzda tarjima qiladi. Bu xizmat "
"kvotasini sarflaydi, shuning uchun zavod sozlamalarida o‘chirilgan. "
"Allaqachon sizning tilingizda bo‘lgan matn yuborilmaydi va eslab qolingan "
"tarjima qayta so‘ralmaydi. Ko‘rsatuv tafsilotlarida INFO tugmasi asl matnni "
"ko‘rsatadi."

msgid ""
"Cu „Tradu EPG” pornită pleacă la același serviciu și titlurile și descrierile"
" emisiunilor de pe ecran."
msgstr ""
"«EPGni tarjima qilish» yoqilgan bo‘lsa, ekrandagi ko‘rsatuvlarning "
"sarlavhalari va tavsiflari ham xuddi shu xizmatga yuboriladi."

msgid "Tradus automat. INFO: textul original."
msgstr "Avtomatik tarjima qilindi. INFO: asl matn."

msgid "Textul original, netradus. INFO: închide."
msgstr "Asl matn, tarjima qilinmagan. INFO: yopish."

msgid "Tradu automat din orice subtitrare disponibilă"
msgstr "Mavjud har qanday subtitrlardan avtomatik tarjima qilish"

msgid ""
"Cu traducerea subtitrărilor pornită, „Tradu automat din orice subtitrare "
"disponibilă” alege singură și o subtitrare în altă limbă, ca să fie tradusă."
msgstr ""
"Subtitrlarni tarjima qilish yoqilgan bo‘lsa, «Mavjud har qanday subtitrlardan"
" avtomatik tarjima qilish» funksiyasi tarjima qilinishi uchun boshqa tildagi "
"subtitrni o‘zi tanlaydi."

msgid ""
"Traducerea subtitrărilor e pornită (în %s): dacă nu există subtitrare în "
"limba aceasta, se alege singură una în altă limbă, întâi teletextul, apoi DVB"
" citită ca text, și se traduce."
msgstr ""
"Subtitrlarni tarjima qilish yoqilgan (maqsad tili: %s): agar ushbu tilda "
"subtitr bo‘lmasa, boshqa tildagi subtitr avtomatik tanlanadi (avval "
"teletekst, keyin matn ko‘rinishidagi DVB) va tarjima qilinadi."

msgid ""
"Traducerea subtitrărilor e pornită (în %s): se alege numai o subtitrare în "
"limba aceasta, apoi preferințele de mai sus."
msgstr ""
"Subtitrlarni tarjima qilish yoqilgan (maqsad tili: %s): faqat ushbu tildagi "
"subtitr tanlanadi, so‘ngra yuqoridagi afzalliklar hisobga olinadi."

msgid "în limba traducerii"
msgstr "tarjima tilida"

msgid "teletext tradus automat"
msgstr "avtomatik tarjima qilingan teletekst"

msgid "DVB citită ca text și tradusă automat"
msgstr "matn ko‘rinishida o‘qilgan va avtomatik tarjima qilingan DVB"

msgid "Canalul nu a pornit: tunerul e inca ocupat. Alege-l din nou."
msgstr "Kanal ishga tushmadi: tyuner hali band. Uni qaytadan tanlang."

#, python-format
msgid "Pornesc din nou canalul de dinainte (%s)..."
msgstr "Oldingi kanal (%s) qayta ishga tushirilmoqda..."

#, python-format
msgid "Canalul de dinainte (%s) a pornit din nou."
msgstr "Oldingi kanal (%s) qayta ishga tushdi."

#, python-format
msgid "Canalul de dinainte (%s) a pornit, dar nu da imagine."
msgstr "Oldingi kanal (%s) ishga tushdi, lekin tasvir yo‘q."

#, python-format
msgid ""
"Canalul de dinainte (%s) nu a pornit: tunerul e inca ocupat. Alege-l din nou."
msgstr ""
"Oldingi kanal (%s) ishga tushmadi: tyuner hali band. Uni qaytadan tanlang."

msgid "Tunerul e ocupat (inregistrare sau alt canal). Alege mai tarziu."
msgstr "Tyuner band (yozib olish yoki boshqa kanal). Keyinroq tanlang."

#, python-format
msgid "Nu au venit date de la %s. Tunerul a fost eliberat."
msgstr "%s dan ma’lumot kelmadi. Tyuner bo‘shatildi."

msgid ""
"Scanarea s-a oprit inainte de sfarsit si nu a salvat nimic. Incearca din nou."
msgstr ""
"Qidiruv yakunlanmasdan to‘xtadi va hech narsa saqlanmadi. Qaytadan urinib "
"ko‘ring."

#, python-format
msgid ""
"Detectorul s-a oprit cu codul %s, fara un raspuns care sa se poata citi."
msgstr "Detektor o‘qiladigan javobsiz %s kodi bilan to‘xtadi."

msgid "Raspunsul detectorului nu s-a putut prelucra (detalii in jurnal)."
msgstr "Detektorning javobini qayta ishlab bo‘lmadi (tafsilotlar jurnalda)."

msgid ""
"În lucru: scanarea salvează posturile DAB+ în lista de canale, dar ascultarea"
" lor nu merge încă pe acest receptor."
msgstr ""
"Ishlanmoqda: qidiruv DAB+ stansiyalarini kanallar ro‘yxatiga saqlaydi, ammo "
"ularni tinglash ushbu resiverda hali ishlamaydi."

msgid "Detectorul nu a dat niciun răspuns."
msgstr "Detektor javob bermadi."

msgid "Ultimele rânduri de eroare ale detectorului:"
msgstr "Detektorning so‘nggi xato satrlari:"

msgid "Începutul ieșirii care nu s-a putut citi:"
msgstr "O‘qib bo‘lmagan natijaning boshlanishi:"

msgid "Ascultarea lor nu merge încă pe acest receptor (în lucru)."
msgstr "Ularni tinglash ushbu resiverda hali ishlamaydi (ishlanmoqda)."

msgid ""
"Adresa %s e pe internet, iar receptorul trimite pe http:// (necriptat) numai "
"în rețeaua de acasă. Scrie adresa cu https://."
msgstr ""
"%s manzili internetda, resiver esa faqat uy tarmog‘ida http:// "
"(shifrlanmagan) orqali yuboradi. Manzilni https:// bilan yozing."

msgid ""
"Adresa %s duce chiar la receptor. Receptorul nu are server de traducere: "
"scrie adresa calculatorului din casă sau a serverului din internet "
"(127.0.0.1, localhost, 0.0.0.0, 169.254.x și IP-ul receptorului nu merg)."
msgstr ""
"%s manzili bevosita resiverga olib boradi. Resiverda tarjima serveri yo‘q: "
"uydagi kompyuter yoki internetdagi server manzilini yozing (127.0.0.1, "
"localhost, 0.0.0.0, 169.254.x va resiverning IP manzili ishlamaydi)."

msgid ""
"adresa altui aparat, nu a receptorului (127.0.0.1, localhost, 0.0.0.0, "
"169.254.x și IP-ul receptorului nu merg)"
msgstr ""
"resiverning emas, boshqa qurilmaning manzili (127.0.0.1, localhost, 0.0.0.0, "
"169.254.x va resiverning IP manzili ishlamaydi)"

msgid ""
"Cheia pleacă numai spre adresa serverului de acum: scrie întâi adresa, apoi "
"pune cheia."
msgstr ""
"Kalit faqat hozirgi server manziliga yuboriladi: avval manzilni yozing, so‘ng"
" kalitni kiriting."

msgid ""
"Cheia salvată a fost pusă pentru alt server (%s), deci nu pleacă spre adresa "
"de acum. Dacă serverul cere cheie, pune-o din nou."
msgstr ""
"Saqlangan kalit boshqa server (%s) uchun kiritilgan, shuning uchun u hozirgi "
"manzilga yuborilmaydi. Agar server kalit so‘rasa, uni qaytadan kiriting."

msgid ""
"Cheia salvată nu e legată de adresa de acum, deci nu pleacă nicăieri. Dacă "
"serverul cere cheie, pune-o din nou."
msgstr ""
"Saqlangan kalit hozirgi manzilga bog‘lanmagan, shuning uchun u hech qayerga "
"yuborilmaydi. Agar server kalit so‘rasa, uni qaytadan kiriting."

msgid "Cheia nu pleacă pe http:// spre internet. Scrie adresa cu https://."
msgstr ""
"Kalit internetga http:// orqali yuborilmaydi. Manzilni https:// bilan yozing."

msgid ""
"Atenție: cheia pleacă necriptată (http://) spre serverul din casă. Pune o "
"cheie numai dacă serverul o cere."
msgstr ""
"Diqqat: kalit uydagi serverga shifrlanmagan holda (http://) yuboriladi. "
"Kalitni faqat server so‘ragandagina kiriting."

msgid ""
"Scrie adresa calculatorului din casă (de exemplu http://192.168.1.50:11434) "
"sau a serverului din internet, cu https://."
msgstr ""
"Uydagi kompyuter manzilini (masalan, http://192.168.1.50:11434) yoki "
"internetdagi server manzilini https:// bilan yozing."

msgid ""
"O cheie pleacă numai pe https:// sau spre un server din rețeaua de acasă. "
"Scrie adresa cu https://. Cheia nu a plecat nicăieri."
msgstr ""
"Kalit faqat https:// orqali yoki uy tarmog‘idagi serverga yuboriladi. "
"Manzilni https:// bilan yozing. Kalit hech qayerga yuborilmadi."

msgid "pusă pentru alt server (OK o pune din nou)"
msgstr "boshqa server uchun o‘rnatilgan (OK tugmasi uni qayta kiritadi)"

msgid ""
"Cheile de traducere trebuie puse din nou: cele salvate înainte nu se mai pot "
"citi pe acest receptor."
msgstr ""
"Tarjima kalitlarini qayta kiritish kerak: avval saqlanganlarini ushbu "
"resiverda o‘qib bo‘lmaydi."

msgid ""
"Cheile de traducere trebuie puse din nou: cele salvate înainte nu se mai pot "
"citi pe acest receptor. Le pui în Meniu › Setări › Sunet și subtitrări › "
"Traducerea subtitrărilor sau de pe telefon, cu codul QR de acolo."
msgstr ""
"Tarjima kalitlarini qayta kiritish kerak: avval saqlanganlarini ushbu "
"resiverda o‘qib bo‘lmaydi. Ularni Menyu › Sozlamalar › Ovoz va audio "
"yo‘laklar › Subtitrlarni tarjima qilish bo‘limida yoki u yerdagi QR kod "
"orqali telefoningizdan kiriting."

msgid "trebuie pusă din nou (OK o scrie)"
msgstr "qayta kiritilishi kerak (yozish uchun OK bosing)"

msgid "Tradu bara de jos"
msgstr "Pastki panelni tarjima qilish"

msgid ""
"Traduce titlurile emisiunii de acum și ale celei următoare de pe bara de jos,"
" cu aceleași servicii și chei. Merge când traducerea subtitrărilor e pornită "
"și folosește foarte puțin din cotă: fiecare titlu se cere o singură dată. "
"INFO de pe bară arată textul original. Cu „Tradu EPG” pornită, bara se "
"traduce oricum."
msgstr ""
"Pastki paneldagi hozirgi va keyingi ko‘rsatuv sarlavhalarini xuddi shu "
"xizmatlar va kalitlar yordamida tarjima qiladi. Bu subtitrlar tarjimasi "
"yoqilganda ishlaydi va kvotadan juda kam foydalanadi: har bir sarlavha faqat "
"bir marta so‘raladi. Paneldagi INFO tugmasi asl matnni ko‘rsatadi. «EPGni "
"tarjima qilish» yoqilgan bo‘lsa, panel baribir tarjima qilinadi."

msgid ""
"Cu „Tradu bara de jos” pornită pleacă la același serviciu și titlurile "
"emisiunilor de pe bara de jos."
msgstr ""
"«Pastki panelni tarjima qilish» yoqilgan bo‘lsa, pastki paneldagi ko‘rsatuv "
"sarlavhalari ham xuddi shu xizmatga yuboriladi."

msgid "Textul original. Pe bara de jos, titlul e tradus automat."
msgstr "Asl matn. Pastki paneldagi sarlavha avtomatik tarzda tarjima qilinadi."

msgid "Ai schimbat setările traducerii. Le salvezi?"
msgstr "Tarjima sozlamalarini o‘zgartirdingiz. Saqlashni xohlaysizmi?"

msgid "OK probează"
msgstr "OK tekshiradi"

msgid "OK le deschide"
msgstr "OK ularni ochadi"

msgid ""
"OK trimite o frază de probă serviciului ales. Răspunsul apare aici, iar "
"originalul și traducerea se văd jos, ca subtitrările."
msgstr ""
"OK tanlangan xizmatga sinov jumlasi yuboradi. Javob shu yerda paydo bo‘ladi, "
"asl matn va tarjima esa pastda, subtitrlar kabi ko‘rinadi."

msgid ""
"OK deschide pașii pentru serviciul ales: contul, cheia gratuită, cota și ce "
"se întâmplă la depășire."
msgstr ""
"OK tanlangan xizmat uchun bosqichlarni ochadi: hisob, bepul kalit, kvota va "
"kvota tugagandagi holat."

msgid "lipsește (OK îl scrie)"
msgstr "mavjud emas (yozish uchun OK bosing)"

msgid "fără cheie"
msgstr "kalitsiz"

msgid "fără adresă"
msgstr "manzilsiz"

msgid "fără model"
msgstr "modelsiz"

msgid "de completat"
msgstr "to‘ldirilishi kerak"

msgid "Dacă foloseai o cheie pentru acest server, pune-o din nou."
msgstr ""
"Agar ushbu server uchun kalitdan foydalangan bo‘lsangiz, uni qayta kiriting."

msgid "Cheie pusă"
msgstr "Kalit o‘rnatildi"

msgid "Fără cheie"
msgstr "Kalit yo‘q"

msgid ""
"Cheie pusă pentru alt server (%s): nu pleacă spre adresa de acum. Pune-o din "
"nou."
msgstr ""
"Kalit boshqa server (%s) uchun o‘rnatilgan: u hozirgi manzilga yuborilmaydi. "
"Uni qayta kiriting."

msgid ""
"Cheie pusă, dar nelegată de adresa de acum: nu pleacă nicăieri. Pune-o din "
"nou."
msgstr ""
"Kalit o‘rnatilgan, lekin hozirgi manzilga bog‘lanmagan: u hech qayerga "
"yuborilmaydi. Uni qayta kiriting."

msgid ""
"Cheie pusă, dar nu pleacă pe http:// spre internet. Scrie adresa cu https://."
msgstr ""
"Kalit o‘rnatilgan, lekin internetga http:// orqali yuborilmaydi. Manzilni "
"https:// bilan yozing."

msgid "se traduce prin „Tradu EPG”"
msgstr "«EPGni tarjima qilish» orqali tarjima qilinadi"

msgid "pornită, dar traducerea automată e oprită"
msgstr "yoqilgan, lekin avtomatik tarjima o‘chirilgan"

msgid "pornită, dar serviciul nu e completat"
msgstr "yoqilgan, lekin xizmat ma’lumotlari to‘ldirilmagan"

msgid "Serviciul principal"
msgstr "Asosiy xizmat"

msgid "Fă-l principal"
msgstr "Asosiy xizmatga aylantirish"

msgid "Alte servicii gata de folosit, care nu sunt în lista rezervelor:"
msgstr "Zaxira ro‘yxatida bo‘lmagan, foydalanishga tayyor boshqa xizmatlar:"

msgid "Valoare greșită pentru: %s."
msgstr "%s uchun noto‘g‘ri qiymat."

msgid "Nu s-a trimis nicio alegere."
msgstr "Hech qanday tanlov yuborilmadi."

msgid "Adresa începe cu http:// sau https://, fără nume și parolă în ea."
msgstr ""
"Manzil http:// yoki https:// bilan boshlanishi kerak, unda foydalanuvchi nomi"
" va parol bo‘lmasligi lozim."

msgid "Nu s-a schimbat nimic."
msgstr "Hech narsa o‘zgarmadi."

msgid "Lista rezervelor are un serviciu necunoscut."
msgstr "Zaxira ro‘yxatida noma’lum xizmat mavjud."

msgid "Un serviciu apare de două ori în lista rezervelor."
msgstr "Zaxira ro‘yxatida bir xizmat ikki marta ko‘rsatilgan."

msgid "Serviciul ales nu intră și în lista rezervelor."
msgstr "Tanlangan xizmat zaxira ro‘yxatiga kirmaydi."

msgid ""
"Adresa-șablon începe cu https:// (sau http:// pentru un server din rețeaua de"
" acasă), fără spații, fără nume și parolă și fără locuri în numele "
"serverului."
msgstr ""
"Manzil shabloni https:// (yoki uy tarmog‘idagi server uchun http://) bilan "
"boshlanishi, bo‘shliqlarsiz, foydalanuvchi nomi va parolsiz hamda server "
"nomida o‘zgaruvchisiz bo‘lishi kerak."

msgid ""
"O adresă http:// merge numai pentru un server din rețeaua de acasă (de "
"exemplu 192.168.1.50); pentru un server de pe internet scrie https://."
msgstr ""
"http:// manzili faqat uy tarmog‘idagi serverlar uchun ishlaydi (masalan, "
"192.168.1.50); internetdagi server uchun https:// deb yozing."

msgid ""
"Numele antetului are numai litere, cifre și - _ . (de exemplu Authorization);"
" Host, Content-Type și Content-Length nu se pot alege."
msgstr ""
"Sarlavha nomi faqat harflar, raqamlar va - _ . belgilaridan iborat bo‘lishi "
"kerak (masalan, Authorization); Host, Content-Type va Content-Length "
"tanlanishi mumkin emas."

msgid ""
"Calea are chei și numere despărțite prin punct, fără spații (de exemplu "
"data.translations.0.translatedText)."
msgstr ""
"Yo‘l nuqtalar bilan ajratilgan kalitlar va raqamlardan iborat bo‘lib, "
"bo‘shliqlarsiz yoziladi (masalan, data.translations.0.translatedText)."

msgid "Corpul are cel mult %d de semne, fără caractere de control."
msgstr ""
"Matn ko‘pi bilan %d ta belgidan iborat bo‘lishi kerak, boshqaruv "
"belgilarisiz."

msgid "cheie refuzată"
msgstr "kalit rad etildi"

msgid "cota terminată"
msgstr "kvota tugadi"

msgid "fără rețea"
msgstr "tarmoq yo‘q"

msgid "prea lent"
msgstr "juda sekin"

msgid "răspuns neașteptat"
msgstr "kutilmagan javob"

msgid "limbă netradusă"
msgstr "til tarjima qilinmagan"

msgid "lipsă date"
msgstr "ma’lumotlar yo‘q"

msgid "adresă refuzată"
msgstr "manzil rad etildi"

