#, python-format
msgid ""
"Scrierea este oprită: numele stickului are spații (%s). Nu s-a scris nimic."
msgstr ""
"Yozish to‘xtatildi: fleshka nomida bo‘sh joylar bor (%s). Hech narsa "
"yozilmadi."

#, python-format
msgid ""
"Scrierea este oprită: numele stickului are semne neacceptate (%s). Nu s-a "
"scris nimic."
msgstr ""
"Yozish to‘xtatildi: fleshka nomida qo‘llab-quvvatlanmaydigan belgilar bor "
"(%s). Hech narsa yozilmadi."

msgid ""
"Cu acest nume, scrierea ar șterge sistemul receptorului înainte să citească "
"imaginea."
msgstr ""
"Bunday nom bilan yozish, proshivkani o‘qishdan oldin resiver tizimini "
"o‘chirib tashlashi mumkin."

msgid ""
"Pune stickul în calculator, schimbă-i numele într-unul fără spații și fără "
"semne (de exemplu HDSATELIT), apoi introdu-l din nou în receptor."
msgstr ""
"Fleshkani kompyuterga ulang, uning nomini bo‘sh joylar va belgilarsiz "
"o‘zgartiring (masalan, HDSATELIT), so‘ng uni resiverga qayta ulang."

msgid "Fără semnal: verifică cablul antenei"
msgstr "Signal yo‘q: antenna kabelini tekshiring"

#, python-format
msgid "  Pune imaginea pe stick în: %s"
msgstr "  Proshivkani fleshkaning quyidagi manziliga joylang: %s"

#, python-format
msgid "Pentru recuperare, pune imaginea pe stick în dosarele %s și %s."
msgstr "Tiklash uchun proshivkani fleshkadagi %s va %s jildlariga joylang."

