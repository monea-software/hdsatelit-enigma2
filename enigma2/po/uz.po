"kutish vaqti"

msgid ""
"<code>POST /api/procesor-"
"seteaza?mod=automat|racoros|normal|performanta</code>: salvează modul și îl "
"aplică pe loc"
msgstr ""
"<code>POST /api/procesor-"
"seteaza?mod=automat|racoros|normal|performanta</code>: rejimni saqlaydi va "
"darhol tatbiq etadi"

msgid ""
"<code>POST /api/radio-"
"seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=..&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</code>:"
" setările ecranului radio"
msgstr ""
"<code>POST /api/radio-"
"seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=..&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</code>:"
" radio ekrani sozlamalari"

msgid ""
"<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: vizualizarea "
