msgstr "Bepul miqdori:"

msgid "Cât timp nu mai cere PIN-ul după ce ai renunțat să-l scrii pe un canal."
msgstr ""
"Kanalda PIN-kodni kiritishdan voz kechganingizdan so‘ng, u qancha vaqt qayta "
"so‘ralmaydi."

msgid "Cât timp nu mai cere PIN-ul după ce l-ai scris bine pe un canal."
msgstr ""
"Kanalda PIN-kodni to‘g‘ri kiritganingizdan so‘ng, u qancha vaqt qayta "
"so‘ralmaydi."

