msgstr ""
"<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: keyingi "
"vizualizator yoki ranglar (radio ekranidagi sariq va ko‘k tugmalar kabi)"

msgid ""
"<code>POST /api/scanare-fluxuri</code>: alegerea de la sfârșitul scanării "
"DAB+ / DVB-T2 de pe televizor (<code>actiune=asculta&amp;post=N</code>, "
"<code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"
msgstr ""
"<code>POST /api/scanare-fluxuri</code>: TVda DAB+ / DVB-T2 qidiruvi "
"yakunidagi tanlov (<code>actiune=asculta&amp;post=N</code>, "
"<code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"

msgid ""
"<code>POST /api/scanare-opreste</code>: oprește căutarea sau închide "
"rezultatul rămas pe televizor"
msgstr ""
"<code>POST /api/scanare-opreste</code>: qidiruvni to‘xtatadi yoki TVda qolgan"
" natijani yopadi"

msgid ""
"<code>POST /api/scanare-"
"porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;&amp;...</code>: pornește "
"căutarea pe televizor (cu <code>confirmat=1</code> după o întrebare)"
msgstr ""
"<code>POST /api/scanare-"
"porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;&amp;...</code>: TVda "
"qidiruvni boshlaydi (savoldan so‘ng <code>confirmat=1</code> bilan)"

msgid ""
"<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: deschide pe "
