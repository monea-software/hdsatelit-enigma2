msgstr ""
"Siz yopiq kalitni kiritdingiz. Ochiq kalitni (.pub fayli) kiriting. Yopiq "
"kalit faqat sizda qolishi kerak."

msgid "Cheia nu mai era pe receptor."
msgstr "Kalit resiverda topilmadi."

msgid ""
"Pe stick nu am găsit dosarul hdsatelit/ssh cu chei. Pune în el fișierul "
"authorized_keys sau cheile tale .pub."
msgstr ""
"USB fleshkada kalitlar joylashgan hdsatelit/ssh jildi topilmadi. Unga "
"authorized_keys faylini yoki .pub kalitlaringizni joylang."

msgid ""
"Pe stick e o cheie privată. Lasă pe stick numai cheile publice (.pub). Cheia "
"privată rămâne numai la tine."
msgstr ""
"USB fleshkada yopiq kalit mavjud. Unda faqat ochiq kalitlarni (.pub) "
"qoldiring. Yopiq kalit faqat sizda qolishi kerak."

msgid "Lipsește programul care face parola (hds-ssh-parola)."
msgstr "Parol yaratuvchi dastur (hds-ssh-parola) topilmadi."

msgid "Am făcut o parolă nouă. Cea veche nu mai merge."
msgstr "Yangi parol yaratildi. Eskisi endi ishlamaydi."

msgid "Parola nouă nu s-a putut face. Parola de dinainte rămâne."
msgstr "Yangi parol yaratilmadi. Oldingi parol saqlanib qoladi."

msgid "Nu am putut ascunde parola."
msgstr "Parolni yashirib bo‘lmadi."

msgid "Setarea nu s-a putut salva."
msgstr "Sozlamani saqlab bo‘lmadi."

msgid "Pornit: din rețeaua ta de acasă se intră pe receptor fără parolă."
msgstr "Yoqilgan: uy tarmog‘ingizdan resiverga parolsiz kirish mumkin."

msgid ""
"Notează parola, apoi alege „Am notat parola”: după aceea nu se mai arată."
msgstr ""
"Parolni yozib oling, so‘ng «Parol yozib oldim» tugmasini tanlang: shundan "
"so‘ng u ko‘rsatilmaydi."

msgid "Pornirea serverului SSH"
msgstr "SSH serverini ishga tushirish"

msgid "Verificarea parolei (PAM)"
msgstr "Parolni tekshirish (PAM)"

msgid "Regula „Fără parolă în rețeaua locală”"
msgstr "«Mahalliy tarmoqda parolsiz» qoidasi"

msgid "Cheile SSH"
msgstr "SSH kalitlari"

msgid "Jurnalul parolei"
msgstr "Parol jurnali"

msgid "(fișierul nu există)"
msgstr "(fayl mavjud emas)"

msgid "Tipul scris în fața cheii nu se potrivește cu cheia."
msgstr "Kalit oldidagi tur kalitga mos kelmaydi."

msgid "Cheile DSA nu mai sunt primite: sunt prea slabe. Fă o cheie Ed25519."
msgstr ""
"DSA kalitlari endi qabul qilinmaydi: ular juda zaif. Ed25519 kalitini "
