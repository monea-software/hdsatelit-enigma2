msgstr "Kalit to‘g‘ri va saqlandi, %s orqali, lekin kvota tugadi."

#, python-format
msgid "Salvat fără probă: traducerea subtitrărilor e pornită, cu %s."
msgstr "Tekshiruvsiz saqlandi: subtitrlarni tarjima qilish yoqildi, %s orqali."

#, python-format
msgid "Cheia pentru %s e salvată ca rezervă; traducerea rămâne pe %s."
msgstr "%s uchun kalit zaxira nusxa sifatida saqlandi; tarjima %sda qoladi."

#, python-format
msgid "Am găsit regiunea: %s (%s). %s"
msgstr "Mintaqa topildi: %s (%s). %s"

msgid "Caută deja. Așteaptă să se termine."
msgstr "Qidiruv ketyapti. Iltimos, tugashini kuting."

msgid "Receptorul nu are rețea."
msgstr "Resiverda tarmoq ulanishi yo‘q."

msgid "Receptorul nu e într-o rețea de acasă (adresă privată); nu caut."
msgstr ""
"Resiver uy tarmog‘ida emas (shaxsiy manzil); qidiruv amalga oshirilmaydi."

msgid "Caut servere în rețeaua de acasă..."
msgstr "Uy tarmog‘idan serverlar qidirilmoqda..."

msgid "Am pornit căutarea."
msgstr "Qidiruv boshlandi."

msgid "Am găsit un server."
msgstr "Bitta server topildi."

#, python-format
