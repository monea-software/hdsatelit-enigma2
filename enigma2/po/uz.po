#, python-format
msgid "Limita de est: pusă de acest receptor, %s."
msgstr "Sharqiy chegara: ushbu resiver tomonidan belgilangan, %s."

msgid "Limita de vest: nepusă de acest receptor."
msgstr "G‘arbiy chegara: ushbu resiver tomonidan belgilanmagan."

#, python-format
