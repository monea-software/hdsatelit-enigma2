msgstr ""
"Asosiy xizmat: %s. OK tugmasi orqali uni foydalanishga tayyor boshqa xizmatga"
" almashtirishingiz mumkin («Asosiy qilish»)."

msgid ""
"Serviciile de rezervă: când serviciul principal nu răspunde, receptorul trece"
" singur la următorul din listă."
msgstr ""
"Zaxira xizmatlari: asosiy xizmat javob bermaganda, resiver avtomatik ravishda"
" ro‘yxatdagi keyingisiga o‘tadi."

msgid "Căutarea nu e în această imagine."
msgstr "Qidiruv ushbu proshivkada mavjud emas."

msgid "Se caută în rețeaua de acasă..."
msgstr "Uy tarmog‘ida qidirilmoqda..."

msgid "Nu am găsit niciun server în rețeaua de acasă."
msgstr "Uy tarmog‘ida hech qanday server topilmadi."

#, python-format
