msgstr "o‘rnatib bo‘lmaydi: fleshka nomida bo‘sh joylar bor"

msgid "nu se poate instala: numele stickului are semne neacceptate"
msgstr ""
"o‘rnatib bo‘lmaydi: fleshka nomida qo‘llab-quvvatlanmaydigan belgilar bor"

msgid "nu se poate instala: poate fi pentru alt tip de receptor"
msgstr "o‘rnatib bo‘lmaydi: u boshqa turdagi resiver uchun bo‘lishi mumkin"

msgid "nu se poate instala: este pentru alt tip de receptor"
msgstr "o‘rnatib bo‘lmaydi: u boshqa turdagi resiver uchun"

msgid "nu se poate instala: fișierele sunt stricate"
msgstr "o‘rnatib bo‘lmaydi: fayllar shikastlangan"

