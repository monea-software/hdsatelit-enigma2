msgid "Programul parolei nu a terminat la timp."
msgstr "Parol dasturi vaqtida yakunlanmadi."

msgid "Se face o parolă nouă..."
msgstr "Yangi parol yaratilmoqda..."

msgid "Se ascunde parola..."
msgstr "Parol yashirilmoqda..."

msgid "Se adaugă cheile..."
msgstr "Kalitlar qo‘shilmoqda..."

msgid "Se citesc cheile de pe stick..."
msgstr "Kalitlar USB fleshkadan o‘qilmoqda..."

msgid "Se șterge cheia..."
msgstr "Kalit o‘chirilmoqda..."

msgid "Se salvează setarea..."
msgstr "Sozlama saqlanmoqda..."

#, python-format
msgid "De pe stick, fișiere citite: %d."
msgstr "USB fleshkadan o‘qilgan fayllar: %d."

msgid "Blocul cheii SSH2 nu e întreg."
msgstr "SSH2 kalit bloki to‘liq emas."

#, python-format
msgid "Receptorul are deja %d de chei, cât primește cel mult."
msgstr "Resiverda allaqachon %d ta kalit bor, bu maksimal miqdor."

msgid "Chei SSH pe receptor: niciuna."
msgstr "Resiverdagi SSH kalitlari: yo‘q."

msgid "Adaugă cheile de pe stick"
msgstr "USB fleshkadan kalitlarni qo‘shish"

msgid ""
"Pune pe stick dosarul hdsatelit/ssh cu fișierul authorized_keys sau cu cheile"
" tale .pub, apoi apasă OK."
msgstr ""
"USB fleshkaga authorized_keys fayli yoki .pub kalitlaringiz joylashgan "
"hdsatelit/ssh jildini joylang, so‘ng OK tugmasini bosing."

#, python-format
msgid ""
"Chei SSH pe receptor: %d. Calculatoarele cu aceste chei intră fără parolă."
msgstr ""
"Resiverdagi SSH kalitlari: %d. Ushbu kalitlarga ega kompyuterlar parolsiz "
"kiradi."

msgid "Am notat parola, ascunde-o"
msgstr "Parolni yozib oldim, uni yashiring"

msgid ""
"Parola rămâne pusă, dar nu se mai arată aici și nici în interfața web. Dacă o"
" uiți, faci una nouă."
msgstr ""
"Parol o‘rnatilgan holda qoladi, lekin u bu yerda va veb-interfeysda "
"ko‘rsatilmaydi. Agar uni unutsangiz, yangisini yarating."

msgid "Fă o parolă nouă"
msgstr "Yangi parol yaratish"

msgid ""
"Receptorul face o parolă la întâmplare și o arată aici. Cea veche nu mai "
"merge."
msgstr ""
"Resiver tasodifiy parol yaratadi va uni shu yerda ko‘rsatadi. Eskisi endi "
"ishlamaydi."

msgid "Fă o parolă"
msgstr "Parol yaratish"

msgid "Receptorul face o parolă la întâmplare și o arată aici."
msgstr "Resiver tasodifiy parol yaratadi va uni shu yerda ko‘rsatadi."

msgid "Fără parolă în rețeaua locală: pornit"
msgstr "Lokal tarmoqda parolsiz: yoqilgan"

msgid ""
"OK oprește. Oricine din rețeaua ta de acasă intră acum pe receptor fără "
"parolă."
msgstr ""
"OK tugmasi uni o‘chiradi. Endi uy tarmog‘ingizdagi har qanday foydalanuvchi "
"resiverga parolsiz kira oladi."

msgid "Fără parolă în rețeaua locală: oprit"
msgstr "Lokal tarmoqda parolsiz: o‘chirilgan"

msgid ""
"Rămâne oprit dacă nu ai un motiv anume. Pornit, oricine din rețeaua ta de "
"acasă intră pe receptor fără parolă."
msgstr ""
"Maxsus sabab bo‘lmasa, uni o‘chirilgan holda qoldiring. Yoqilganda, uy "
"tarmog‘ingizdagi har qanday foydalanuvchi resiverga parolsiz kira oladi."

msgid "Așteaptă să se termine ce ai pornit înainte."
msgstr "Avval boshlagan ishlar yakunlanishini kuting."

#, python-format
msgid "Șterge cheia: %s"
msgstr "Kalitni o‘chirish: %s"

msgid ""
"OK șterge cheia. Calculatorul cu această cheie intră apoi numai cu parola."
msgstr ""
"OK tugmasi kalitni o‘chiradi. Ushbu kalitga ega kompyuter keyin faqat parol "
"bilan kiradi."

msgid "Faci o parolă nouă? Cea de acum nu mai merge."
msgstr "Yangi parol yaratasizmi? Hozirgi parol endi ishlamaydi."

msgid "Așteaptă să se termine ce ai pornit înainte (pe televizor sau aici)."
msgstr "Avval boshlagan ishlar yakunlanishini kuting (TVda yoki shu yerda)."

msgid "Confirmă parola nouă: cea de acum nu mai merge după aceea."
msgstr "Yangi parolni tasdiqlang: shundan so‘ng hozirgi parol ishlamaydi."

msgid "Lipsește amprenta cheii."
msgstr "Kalitning barmoq izi mavjud emas."

msgid "Confirmă ștergerea cheii."
msgstr "Kalitni o‘chirishni tasdiqlang."

msgid "Alege pornit sau oprit."
msgstr "Yoqilgan yoki o‘chirilgan holatni tanlang."

msgid ""
"Confirmă: oricine din rețeaua ta de acasă va intra pe receptor fără parolă."
msgstr ""
"Tasdiqlang: uy tarmog‘ingizdagi har qanday foydalanuvchi resiverga parolsiz "
"kira oladi."

msgid "Parola nu se mai arată. Dacă ai uitat-o, fă una nouă."
msgstr ""
"Parol endi ko‘rsatilmaydi. Agar uni unutgan bo‘lsangiz, yangisini yarating."

msgid ""
"Parola și cheile se văd și se schimbă numai dintr-un browser conectat cu "
"codul de pe televizor."
msgstr ""
"Parol va kalitlarni faqat TVdagi kod orqali ulangan brauzerda ko‘rish va "
"o‘zgartirish mumkin."

msgid "(cu opțiuni)"
msgstr "(opsiyalar bilan)"

#, python-format
msgid "Aceleași lucruri sunt pe televizor, în %s."
msgstr "Xuddi shu narsalar TVda, %s bo‘limida mavjud."

msgid "Adaugă cheia"
msgstr "Kalitni qo‘shish"

msgid "Adresa receptorului în rețea nu e cunoscută."
msgstr "Resiverning tarmoq manzili noma’lum."

msgid ""
"Ai lipit o cheie privată. Nu a plecat din pagină. Pune cheia publică "
"(fișierul .pub); cheia privată rămâne numai la tine."
msgstr ""
"Siz maxfiy kalitni joylashtirdingiz. U sahifadan tashqariga chiqmadi. Ochiq "
"kalitni (.pub fayli) joylashtiring; maxfiy kalit faqat sizda qoladi."

msgid ""
"Ai notat parola? După aceea nu se mai arată nici aici, nici pe televizor."
msgstr ""
"Parolni yozib oldingizmi? Shundan so‘ng u na bu yerda, na TVda ko‘rsatiladi."

msgid ""
"Ai notat parola? După aceea nu se mai arată nici aici, nici în interfața web."
msgstr ""
"Parolni yozib oldingizmi? Shundan so‘ng u na bu yerda, na veb-interfeysda "
"ko‘rsatiladi."

msgid "Arată codul pe televizor"
msgstr "Kodni TVda ko‘rsatish"

msgid "Atenție: root nu are parolă și oricine din rețea intră pe receptor."
msgstr ""
"Ogohlantirish: root foydalanuvchisida parol yo‘q va tarmoqdagi har qanday "
"shaxs resiverga kira oladi."

msgid "Atenție: serverul SSH e pornit cu -B și primește conturi fără parolă."
msgstr ""
"Ogohlantirish: SSH serveri -B parametri bilan ishlayapti va parolsiz "
"akkauntlarni qabul qiladi."

msgid ""
"Atenție: „Fără parolă în rețeaua locală” e pornit. Oricine din rețeaua ta de "
"acasă intră pe receptor."
msgstr ""
"Ogohlantirish: «Lokal tarmoqda parolsiz» rejimi yoqilgan. Uy tarmog‘ingizdagi"
" har qanday foydalanuvchi resiverga kira oladi."

#, python-format
msgid ""
"Cheia RSA are %d de biți. Receptorul primește numai chei RSA de cel puțin %d "
"de biți."
msgstr ""
"RSA kaliti %d bitdan iborat. Resiver faqat kamida %d bitli RSA kalitlarini "
"qabul qiladi."

msgid "Codul are 6 cifre."
msgstr "Kod 6 ta raqamdan iborat."

msgid "Codul de pe televizor"
msgstr "TVdagi kod"

msgid "Codul e pe televizor."
msgstr "Kod TVda ko‘rsatilgan."

msgid "Codul nu a mers."
msgstr "Kod ishlamadi."

msgid "Codul nu s-a putut cere."
msgstr "Kodni so‘rashning imkoni bo‘lmadi."

msgid "Conectat."
msgstr "Ulangan."

msgid "Conectează"
msgstr "Ulanish"

msgid "Conectează browserul cu codul"
msgstr "Brauzerni kod orqali ulang"

msgid ""
"Contul root nu are parolă, deci nu se intră cu parolă, numai cu o cheie. "
"Alege „Fă o parolă”."
msgstr ""
"Root hisobida parol yo‘q, shuning uchun kirish faqat kalit orqali amalga "
"oshiriladi. «Parol yaratish»ni tanlang."

msgid "Contul root nu are parolă. Alege „Fă o parolă”."
msgstr "Root hisobida parol yo‘q. «Parol yaratish»ni tanlang."

msgid ""
"Contul root nu are parolă: se intră numai cu o cheie. Dacă vrei și parolă, "
"alege „Fă o parolă”."
msgstr ""
"Root hisobida parol yo‘q: kirish faqat kalit orqali amalga oshiriladi. Agar "
"parol ham kerak bo‘lsa, «Parol yaratish»ni tanlang."

msgid ""
"Cu cheia pentru scripturi pagina arată numai starea. Parola și cheile se văd "
"și se schimbă numai dintr-un browser conectat cu codul de pe televizor."
msgstr ""
"Skriptlar uchun kalit bilan sahifa faqat holatni ko‘rsatadi. Parol va "
"kalitlarni faqat televizordagi kod orqali ulangan brauzerda ko‘rish va "
"o‘zgartirish mumkin."

msgid ""
"Cu o cheie SSH pusă mai jos, calculatorul intră fără parolă. Fișierele se "
"copiază cu SFTP (de exemplu WinSCP sau FileZilla), cu aceleași date."
msgstr ""
"Quyida qo‘shilgan SSH kaliti bilan kompyuter parolsiz kiradi. Fayllar xuddi "
"shu ma’lumotlar bilan SFTP (masalan, WinSCP yoki FileZilla) orqali "
"nusxalanadi."

msgid "Cum te conectezi"
msgstr "Qanday ulanish kerak"

msgid ""
"Cât ecranul „Acces SSH” e deschis pe televizor, telecomanda și captura de "
"ecran merg numai dintr-un browser conectat cu codul de pe televizor."
msgstr ""
"Televizorda «SSH ulanishi» ekrani ochiq bo‘lgan vaqtda, masofadan boshqarish "
"pulti va ekran skrinshoti faqat televizordagi kod orqali ulangan brauzerdan "
"ishlaydi."

msgid "Dacă ai uitat parola, alege „Fă o parolă nouă”."
msgstr "Agar parolni unutgan bo‘lsangiz, «Yangi parol yaratish»ni tanlang."

msgid "De pe calculator, în terminal:"
msgstr "Kompyuterdan, terminalda:"

msgid ""
"De pe stick: pune dosarul hdsatelit/ssh cu fișierul authorized_keys sau cu "
"cheile .pub, bagă stickul în receptor, apoi apasă butonul. Nu pune niciodată "
"cheia privată (fișierul fără .pub)."
msgstr ""
"USB fleshkadan: hdsatelit/ssh jildini authorized_keys fayli yoki .pub "
"kalitlari bilan joylang, fleshkani resiverga ulang va tugmani bosing. Hech "
"qachon maxfiy kalitni (.pub bo‘lmagan faylni) joylamang."

msgid "Fișierul"
msgstr "Fayl"

msgid ""
"Fișierul cheilor de pe receptor e prea mare (peste 1 MB). Scoate prin SSH "
"cheile vechi din el."
msgstr ""
"Resiverdagi kalitlar fayli juda katta (1 MB dan ortiq). SSH orqali undagi "
"eski kalitlarni o‘chirib tashlang."

msgid "Fără parolă în rețeaua locală"
msgstr "Lokal tarmoqda parolsiz"

msgid ""
"Lipește cheia publică (conținutul fișierului .pub, de exemplu "
"id_ed25519.pub):"
msgstr "Ochiq kalitni (.pub fayli tarkibi, masalan id_ed25519.pub) joylang:"

msgid "Lipește întâi cheia publică."
msgstr "Avval ochiq kalitni joylang."

msgid "Nu s-a putut face"
msgstr "Yaratib bo‘lmadi"

msgid "Numai starea"
msgstr "Faqat holat"

msgid ""
"OK arată fișierele de setări ale serverului SSH, așa cum sunt pe receptor."
msgstr ""
"OK tugmasi SSH serverining sozlama fayllarini resiverdagi holatida "
"ko‘rsatadi."

msgid "Parola de administrator (root)"
msgstr "Administrator paroli (root)"

msgid ""
"Parola nu s-a putut face. Alege „Fă o parolă”. Până atunci se intră numai cu "
"o cheie."
msgstr ""
"Parol yaratib bo‘lmadi. «Parol yaratish»ni tanlang. Ungacha kirish faqat "
"kalit orqali amalga oshiriladi."

msgid ""
"Parola se vede numai dintr-un browser conectat cu codul de pe televizor."
msgstr "Parol faqat televizordagi kod orqali ulangan brauzerda ko‘rinadi."

msgid ""
"Parola și cheile se văd și se schimbă numai dintr-un browser conectat cu "
"codul de pe televizor. Așa, cine e doar în rețeaua ta de acasă nu le poate "
"afla."
msgstr ""
"Parol va kalitlarni faqat televizordagi kod orqali ulangan brauzerda ko‘rish "
"va o‘zgartirish mumkin. Shunday qilib, faqat uy tarmog‘ingizda bo‘lgan shaxs "
"ularni bila olmaydi."

msgid ""
"Pornești intrarea fără parolă? Oricine din rețeaua ta de acasă va intra pe "
"receptor."
msgstr ""
"Parolsiz kirishni yoqasizmi? Uy tarmog‘ingizdagi har qanday shaxs resiverga "
"kira oladi."

msgid "Scrie codul aici, apoi apasă Conectează."
msgstr "Kodni bu yerga yozing, so‘ngra Ulanish tugmasini bosing."

msgid "Se cere codul..."
msgstr "Kod so‘ralmoqda..."

msgid "Se trimite..."
msgstr "Yuborilmoqda..."

msgid "Stânga/Dreapta: alt fișier · Sus/Jos: derulare · OK sau EXIT: înapoi"
msgstr ""
"Chap/O‘ng: boshqa fayl · Yuqori/Past: aylantirish · OK yoki EXIT: orqaga"

msgid "Text brut (fișierele serverului SSH)"
msgstr "Xom matn (SSH server fayllari)"

msgid "Textul parolei a fost șters de pe receptor."
msgstr "Parol matni resiverdan o‘chirildi."

