#: data/menu.xml:18
msgid "Cauți și adaugi canale de satelit, de cablu sau de antenă terestră."
msgstr "Sun’iy yo‘ldosh, kabel yoki efir kanallarini qidirasiz va qo‘shasiz."

#: data/menu.xml:24
msgid "Alegi cum cauți canalele recepționate cu antena de satelit."
msgstr "Sun’iy yo‘ldosh antennasi orqali qabul qilinadigan kanallarni qanday qidirishni tanlaysiz."

#: data/menu.xml:26
msgid "Cauți canalele de pe o singură frecvență de satelit."
msgstr "Sun’iy yo‘ldoshning bitta chastotasidagi kanallarni qidirasiz."

#: data/menu.xml:29
msgid "Cauți canalele disponibile pe un satelit ales de tine."
msgstr "Tanlagan sun’iy yo‘ldoshdagi mavjud kanallarni qidirasiz."

#: data/menu.xml:32
msgid "Bifezi sateliții pe care vrei să cauți canale."
msgstr "Kanal qidirmoqchi bo‘lgan sun’iy yo‘ldoshlarni belgilaysiz."

#: data/menu.xml:35
msgid "Cauți frecvențe și canale fără o listă de frecvențe cunoscute."
msgstr "Ma’lum chastotalar ro‘yxatisiz chastotalar va kanallarni qidirasiz."

#: data/menu.xml:38
msgid "Cauți canalele furnizorului de televiziune prin satelit ales."
msgstr "Tanlangan sun’iy yo‘ldosh TV operatorining kanallarini qidirasiz."

#: data/menu.xml:41
msgid "Introduci datele de recepție pentru a căuta canale prin satelit."
msgstr "Sun’iy yo‘ldosh kanallarini qidirish uchun qabul parametrlarini kiritasiz."

#: data/menu.xml:44
msgid "Cauți canalele terestre retransmise prin satelit."
msgstr "Sun’iy yo‘ldosh orqali qayta uzatiladigan efir kanallarini qidirasiz."

#: data/menu.xml:47
msgid "Cauți posturile de radio digital retransmise prin satelit."
msgstr "Sun’iy yo‘ldosh orqali qayta uzatiladigan raqamli radiostansiyalarni qidirasiz."

#: data/menu.xml:52
msgid "Alegi cum cauți canalele primite prin cablul de televiziune."
msgstr "Kabel orqali qabul qilinadigan kanallarni qanday qidirishni tanlaysiz."

#: data/menu.xml:54
msgid "Cauți canalele de cablu pe o frecvență aleasă de tine."
msgstr "Kabel kanallarini o‘zingiz tanlagan chastotada qidirasiz."

#: data/menu.xml:57
msgid "Cauți canale pe întregul interval de frecvențe al televiziunii prin cablu."
msgstr "Kabel TV chastotalarining butun diapazonida kanallarni qidirasiz."

#: data/menu.xml:60
msgid "Cauți canalele furnizorului tău de televiziune prin cablu."
msgstr "Kabel TV operatoringizning kanallarini qidirasiz."

#: data/menu.xml:63
msgid "Introduci datele de recepție pentru a căuta canale pe cablu."
msgstr "Kabel kanallarini qidirish uchun qabul parametrlarini kiritasiz."

#: data/menu.xml:66
msgid "Pornești căutarea automată a canalelor de televiziune prin cablu."
msgstr "Kabel TV kanallarini avtomatik qidirishni boshlaysiz."

#: data/menu.xml:71
msgid "Alegi cum cauți canalele primite cu o antenă terestră."
msgstr "Efir antennasi orqali qabul qilinadigan kanallarni qanday qidirishni tanlaysiz."

#: data/menu.xml:73
msgid "Cauți posturile TV de pe un singur canal de emisie terestră."
msgstr "Bitta efir chastotasida uzatiladigan TV kanallarini qidirasiz."

#: data/menu.xml:76
msgid "Cauți posturi TV pe toate frecvențele de emisie terestră."
msgstr "Barcha efir uzatish chastotalarida TV kanallarini qidirasiz."

#: data/menu.xml:79
msgid "Cauți posturile TV terestre pentru zona sau furnizorul ales."
msgstr "Tanlangan mintaqa yoki operator uchun efir TV kanallarini qidirasiz."

#: data/menu.xml:82
msgid "Introduci datele de recepție pentru a căuta posturi TV terestre."
msgstr "Efir TV kanallarini qidirish uchun qabul parametrlarini kiritasiz."

#: data/menu.xml:85
msgid "Pornești căutarea automată a posturilor TV prin antena terestră."
msgstr "Efir antennasi orqali TV kanallarini avtomatik qidirishni boshlaysiz."

#: data/menu.xml:95
msgid "Asculți radio digital DAB+ cu un stick USB de recepție radio."
msgstr "USB radio qabul qilgich bilan raqamli DAB+ radiosini tinglaysiz."

#: data/menu.xml:101
msgid "Receptorul trece singur prin canale și notează imaginea, sunetul și codarea fiecăruia."
msgstr "Resiver kanallarni o‘zi birma-bir tekshirib, tasvir, ovoz va shifrlanish holatini qayd etadi."

#: data/menu.xml:107
msgid "Aranjezi canalele și grupurile lor cu telecomanda sau tastatura."
msgstr "Kanallar va ularning guruhlarini masofadan boshqarish pulti yoki klaviatura bilan tartiblaysiz."

#: data/menu.xml:114
msgid "Aduci canalele și setările salvate pe un stick sau din alt receptor."
msgstr "Saqlangan kanallar va sozlamalarni USB fleshka yoki boshqa resiverdan import qilasiz."

#: data/menu.xml:120
msgid "Găsești liste gata făcute, dacă există, sau mergi la căutare și import."
msgstr "Tayyor ro‘yxatlar bo‘lsa, ularni topasiz yoki kanallarni qidirish va import qilishga o‘tasiz."

#: data/menu.xml:132
msgid "Reglezi recepția și direcția antenei pentru a obține semnal."
msgstr "Signal olish uchun qabulni va antenna yo‘nalishini sozlaysiz."

#: data/menu.xml:134
msgid "Alegi cum sunt conectate și folosite intrările de semnal ale receptorului."
msgstr "Resiverning signal kirishlari qanday ulanishi va ishlatilishini tanlaysiz."

#: data/menu.xml:137
msgid "Alegi tipul convertorului de pe brațul antenei și frecvențele lui."
msgstr "Antennaning tutqichidagi LNB turini va uning chastotalarini tanlaysiz."

#: data/menu.xml:140
msgid "Miști antena cu motor spre satelitul pe care vrei să îl recepționezi."
msgstr "Qabul qilmoqchi bo‘lgan sun’iy yo‘ldosh tomon antennani motor bilan burasiz."

#: data/menu.xml:143
msgid "Introduci poziția geografică a locului unde este instalată antena."
msgstr "Antenna o‘rnatilgan joyning geografik koordinatalarini kiritasiz."

#: data/menu.xml:146
msgid "Afli unghiurile necesare pentru a îndrepta antena spre satelitul ales."
msgstr "Antennani tanlangan sun’iy yo‘ldoshga yo‘naltirish uchun kerakli burchaklarni bilib olasiz."

#: data/menu.xml:149
msgid "Urmărești nivelul și calitatea recepției în timp ce reglezi antena."
msgstr "Antennani sozlash paytida signal darajasi va sifatini kuzatasiz."

#: data/menu.xml:154
msgid "Verifici comutarea între sursele de semnal ale instalației de satelit."
msgstr "Sun’iy yo‘ldosh tizimidagi signal manbalari orasida almashishni tekshirasiz."

#: data/menu.xml:163
msgid "Programezi înregistrarea emisiunilor și verifici programările existente."
msgstr "Ko‘rsatuvlarni yozib olishni rejalashtirasiz va mavjud yozuv rejalarini tekshirasiz."

#: data/menu.xml:168
msgid "Vezi date despre receptor, recepție, memorie, discuri și rețea."
msgstr "Resiver, signal qabuli, xotira, disklar va tarmoq ma’lumotlarini ko‘rasiz."

#: data/menu.xml:173
msgid "Vezi de ce interfața a pornit în modul sigur, după opriri neașteptate repetate."
msgstr "Kutilmagan o‘chishlar takrorlangach, interfeys nega xavfsiz rejimda ishga tushganini ko‘rasiz."

#: data/menu.xml:176
msgid "Vezi versiunea și detaliile imaginii instalate pe receptor."
msgstr "Resiverga o‘rnatilgan proshivka versiyasi va tafsilotlarini ko‘rasiz."

#: data/menu.xml:181
msgid "Citești condițiile de folosire ale programelor și afli unde este codul sursă."
msgstr "Dasturlardan foydalanish shartlarini o‘qiysiz va manba kodi qayerdaligini bilib olasiz."

#: data/menu.xml:187
msgid "Citești noutățile și schimbările aduse de fiecare versiune a imaginii."
msgstr "Proshivkaning har bir versiyasidagi yangiliklar va o‘zgarishlarni o‘qiysiz."

#: data/menu.xml:190
msgid "Vezi modelul receptorului și date despre componentele sale."
msgstr "Resiver modeli va uning qismlari haqidagi ma’lumotlarni ko‘rasiz."

#: data/menu.xml:193
msgid "Vezi ce componente de recepție are receptorul și detaliile lor."
msgstr "Resiverda qaysi tyunerlar borligini va ularning tafsilotlarini ko‘rasiz."

#: data/menu.xml:196
msgid "Vezi câtă memorie este folosită și câtă mai este disponibilă."
msgstr "Qancha xotira bandligini va qanchasi bo‘shligini ko‘rasiz."

#: data/menu.xml:199
msgid "Vezi discurile conectate și spațiul disponibil pentru fișiere."
msgstr "Ulangan disklar va fayllar uchun bo‘sh joyni ko‘rasiz."

#: data/menu.xml:202
msgid "Vezi starea conexiunilor receptorului și adresele din rețea."
msgstr "Resiver ulanishlarining holati va tarmoq manzillarini ko‘rasiz."

#: data/menu.xml:207
msgid "Vezi starea legăturii video și ce formate acceptă televizorul conectat."
msgstr "Video ulanish holatini va ulangan televizor qo‘llab-quvvatlaydigan formatlarni ko‘rasiz."

#: data/menu.xml:210
msgid "Vezi datele de recepție, imagine și sunet ale canalului urmărit."
msgstr "Ko‘rayotgan kanalning qabul, tasvir va ovoz ma’lumotlarini ko‘rasiz."

#: data/menu.xml:217
msgid "Citești și cauți instrucțiuni de folosire chiar și fără internet."
msgstr "Foydalanish yo‘riqnomalarini internetsiz ham o‘qiysiz va qidirasiz."

#: data/menu.xml:225
msgid "Vezi verificările de la pornire și codurile problemelor găsite."
msgstr "Ishga tushirishdagi tekshiruvlar va topilgan muammolar kodlarini ko‘rasiz."

#: data/menu.xml:231
msgid "Găsești programele suplimentare disponibile pe receptor."
msgstr "Resiverda mavjud qo‘shimcha dasturlarni topasiz."

#: data/menu.xml:236
msgid "Toate setările receptorului, grupate pe teme."
msgstr "Resiverning mavzular bo‘yicha guruhlangan barcha sozlamalari."

#: data/menu.xml:244
msgid "Cauți o opțiune după cuvinte și deschizi direct ecranul găsit."
msgstr "So‘zlar bo‘yicha kerakli bandni qidirasiz va topilgan oynani bevosita ochasiz."

#: data/menu.xml:256
msgid "Reglezi accesul la televiziune, radio și alte servicii prin internet."
msgstr "Internet orqali TV, radio va boshqa xizmatlarga kirishni sozlaysiz."

#: data/menu.xml:258
msgid "Găsești și asculți posturi de radio transmise prin internet."
msgstr "Internet orqali uzatiladigan radiostansiyalarni topasiz va tinglaysiz."

#: data/menu.xml:261
msgid "Configurezi sursele de canale TV prin internet în format DVB-I."
msgstr "DVB-I formatidagi internet TV kanallari manbalarini sozlaysiz."

#: data/menu.xml:264
msgid "Reîncarci acum lista de canale TV din sursele DVB-I configurate."
msgstr "Sozlangan DVB-I manbalaridan TV kanallari ro‘yxatini hozir yangilaysiz."

#: data/menu.xml:269
msgid "Reglezi recepția TV prin fluxuri trimise simultan mai multor aparate."
msgstr "Bir necha qurilmaga bir vaqtda uzatiladigan oqimlar orqali TV qabulini sozlaysiz."

#: data/menu.xml:272
msgid "Adaugi liste sau conturi pentru a primi canale TV prin internet."
msgstr "Internet orqali TV kanallarini qabul qilish uchun ro‘yxatlar yoki hisob qaydnomalari qo‘shasiz."

#: data/menu.xml:277
msgid "Pornești sau oprești funcțiile pentru canalele primite prin internet."
msgstr "Internet orqali qabul qilinadigan kanallar uchun imkoniyatlarni yoqasiz yoki o‘chirasiz."

#: data/menu.xml:280
msgid "Verifici ce canale prin internet transmit cu adevărat la rezoluție 4K."
msgstr "Qaysi internet kanallari haqiqatan ham 4K ruxsatda uzatilishini tekshirasiz."

#: data/menu.xml:285
msgid "Alegi ce vrei să urmărești din catalogul contului tău de televiziune prin internet."
msgstr "Internet televideniyesi hisobingizdagi katalogdan nimani tomosha qilishni tanlaysiz."

#: data/menu.xml:288
msgid "Reglezi interfața web, prin care comanzi receptorul din browser."
msgstr "Resiverni brauzer orqali boshqarish uchun veb-interfeysni sozlaysiz."

#: data/menu.xml:294
msgid "Alegi pagina de pornire, mărimea textului și preferințele de navigare."
msgstr "Bosh sahifani, shrift o‘lchamini va sahifalarni ko‘rish sozlamalarini tanlaysiz."

#: data/menu.xml:302
msgid "Găsești reglajele pentru imaginea trimisă de receptor la televizor."
msgstr "Resiver televizorga uzatadigan tasvir sozlamalarini topasiz."

#: data/menu.xml:305
msgid "Alegi rezoluția, frecvența și culorile imaginii trimise la televizor."
msgstr "Televizorga uzatiladigan tasvirning ruxsati, yangilanish chastotasi va ranglarini tanlaysiz."

#: data/menu.xml:309
msgid "Reglezi proporțiile și claritatea imaginii afișate pe televizor."
msgstr "Televizordagi tasvirning tomonlar nisbati va tiniqligini sozlaysiz."

#: data/menu.xml:316
msgid "Alegi profilurile de prelucrare a imaginii și redarea cu luminozitate extinsă."
msgstr "Tasvirga ishlov berish profillarini va HDR rejimida ijro etishni tanlaysiz."

#: data/menu.xml:325
msgid "Găsești reglajele de sunet și preferințele pentru limbi și subtitrări."
msgstr "Ovoz sozlamalari hamda til va subtitrlar sozlamalarini topasiz."

#: data/menu.xml:328
msgid "Alegi cum ajunge sunetul la televizor sau la sistemul audio."
msgstr "Ovoz televizor yoki audio tizimga qanday uzatilishini tanlaysiz."

#: data/menu.xml:334
msgid "Reglezi nivelul sonor și sincronizarea sunetului cu imaginea."
msgstr "Ovoz balandligi va uning tasvir bilan sinxronligini sozlaysiz."

#: data/menu.xml:339
msgid "Reglezi tonurile sunetului pe 10 benzi, cu presetări și modul de noapte."
msgstr "Ovozni 10 diapazonda, tayyor sozlamalar va tungi rejim bilan sozlaysiz."

#: data/menu.xml:344
msgid "Alegi limbile preferate pentru ce auzi și pentru textul de pe ecran."
msgstr "Ovoz va subtitrlar uchun afzal ko‘rgan tillaringizni tanlaysiz."

#: data/menu.xml:349
msgid "Schimbi mărimea, culorile și poziția textului afișat peste imagine."
msgstr "Tasvir ustidagi matnning o‘lchami, ranglari va joylashuvini o‘zgartirasiz."

#: data/menu.xml:354
msgid "Alegi serviciul care traduce automat textul subtitrărilor."
msgstr "Subtitrlar matnini avtomatik tarjima qiladigan xizmatni tanlaysiz."

#: data/menu.xml:360
msgid "Alegi cum sunt citite și preferate fișierele cu text de lângă film."
msgstr "Film yonidagi subtitr fayllarining kodlanishi va ustuvorligini tanlaysiz."

#: data/menu.xml:369
msgid "Cauți pe internet fișiere cu textul dialogurilor și configurezi accesul."
msgstr "Internetda subtitr fayllarini qidirasiz va kirishni sozlaysiz."

#: data/menu.xml:374
msgid "Alegi ce apare pe televizor când asculți un post de radio."
msgstr "Radio tinglayotganda televizorda nima ko‘rsatilishini tanlaysiz."

#: data/menu.xml:380
msgid "Găsești reglajele pentru salvarea emisiunilor și folosirea discurilor."
msgstr "Ko‘rsatuvlarni yozib olish va disklardan foydalanish sozlamalarini topasiz."

#: data/menu.xml:384
msgid "Alegi discul pe care salvezi emisiunile și verifici spațiul liber."
msgstr "Ko‘rsatuvlar saqlanadigan diskni tanlaysiz va bo‘sh joyni tekshirasiz."

#: data/menu.xml:387
msgid "Alegi dosarele folosite pentru salvarea emisiunilor înregistrate."
msgstr "Yozib olingan ko‘rsatuvlarni saqlash uchun jildlarni tanlaysiz."

#: data/menu.xml:392
msgid "Alegi numele fiecărui disc în /media și îl demontezi ca să-l scoți în siguranță."
msgstr "Har bir diskning /media ichidagi nomini tanlaysiz va uni xavfsiz chiqarish uchun tizimdan ajratasiz."

#: data/menu.xml:395
msgid "Pregătești discul pentru folosire, ștergând toate datele de pe el."
msgstr "Diskdagi barcha ma’lumotlarni o‘chirib, uni foydalanishga tayyorlaysiz."

#: data/menu.xml:398
msgid "Verifici discul pentru a găsi eventuale probleme de stocare."
msgstr "Saqlashdagi ehtimoliy muammolarni aniqlash uchun diskni tekshirasiz."

#: data/menu.xml:401
msgid "Alegi după cât timp se oprește singur discul când nu e folosit."
msgstr "Disk ishlatilmaganda qancha vaqtdan so‘ng avtomatik o‘chishini tanlaysiz."

#: data/menu.xml:404
msgid "Configurezi un fișier pe disc folosit ca memorie suplimentară."
msgstr "Diskda qo‘shimcha xotira sifatida ishlatiladigan faylni sozlaysiz."

#: data/menu.xml:410
msgid "Schimbi felul în care arată meniurile și textele de pe ecran."
msgstr "Ekrandagi menyular va matnlarning ko‘rinishini o‘zgartirasiz."

#: data/menu.xml:414
msgid "Alegi o temă completă pentru meniurile și ferestrele receptorului."
msgstr "Resiver menyulari va oynalari uchun to‘liq mavzuni tanlaysiz."

#: data/menu.xml:420
msgid "Alegi varianta Clasic sau Pro pentru meniurile de pe televizor."
msgstr "Televizordagi menyular uchun Klassik yoki Pro variantini tanlaysiz."

#: data/menu.xml:426
msgid "Alegi imaginea din spatele meniurilor când folosești varianta Pro."
msgstr "Pro variantidan foydalanganda menyular ortidagi fon tasvirini tanlaysiz."

#: data/menu.xml:431
msgid "Adaugi siglele canalelor de pe un stick sau de pe internet."
msgstr "USB fleshkadan yoki internetdan kanal logotiplarini qo‘shasiz."

#: data/menu.xml:436
msgid "Alegi cât de detaliat sunt desenate meniurile pe televizor."
msgstr "Televizorda menyular qanchalik batafsil ko‘rsatilishini tanlaysiz."

#: data/menu.xml:444
msgid "Alegi paleta de culori a meniurilor și pagina tehnică a temei."
msgstr "Menyularning ranglar palitrasi va mavzuning texnik sahifasini tanlaysiz."

#: data/menu.xml:447
msgid "Alegi limba în care apar meniurile și mesajele receptorului."
msgstr "Resiver menyulari va xabarlari qaysi tilda ko‘rsatilishini tanlaysiz."

#: data/menu.xml:450
msgid "Reglezi felul în care sunt afișate informațiile și meniurile pe televizor."
msgstr "Televizorda ma’lumotlar va menyular qanday ko‘rsatilishini sozlaysiz."

#: data/menu.xml:455
msgid "Schimbi felul în care sunt afișate posturile în lista de selecție."
msgstr "Kanallar ro‘yxatida ularning qanday ko‘rsatilishini o‘zgartirasiz."

#: data/menu.xml:458
msgid "Alegi ce apare pe micul ecran de pe panoul frontal al receptorului."
msgstr "Resiverning old panelidagi kichik ekranda nima ko‘rsatilishini tanlaysiz."

#: data/menu.xml:463
msgid "Alegi ce apare pe ecranul color de pe panoul frontal al receptorului."
msgstr "Resiverning old panelidagi rangli ekranda nima ko‘rsatilishini tanlaysiz."

#: data/menu.xml:466
msgid "Reglezi ecranul frontal și luminile de semnalizare ale receptorului."
msgstr "Resiverning old panelidagi ekran va indikator chiroqlarini sozlaysiz."

#: data/menu.xml:474
msgid "Mărești sau micșorezi literele afișate în meniurile receptorului."
msgstr "Resiver menyularidagi harflarni kattalashtirasiz yoki kichraytirasiz."

#: data/menu.xml:478
msgid "Alegi forma literelor din meniuri dintre variantele deja instalate."
msgstr "Menyular shriftini o‘rnatilgan variantlar orasidan tanlaysiz."

#: data/menu.xml:481
msgid "Potrivești marginile meniurilor astfel încât să încapă pe televizor."
msgstr "Menyular televizor ekraniga sig‘ishi uchun ularning chekkalarini moslaysiz."

#: data/menu.xml:489
msgid "Alegi alte forme de litere pentru textele afișate pe ecran."
msgstr "Ekrandagi matnlar uchun boshqa shriftlarni tanlaysiz."

#: data/menu.xml:492
msgid "Alegi imaginea afișată când pornește receptorul, inclusiv o fotografie proprie."
msgstr "Resiver yoqilganda ko‘rsatiladigan tasvirni, jumladan o‘z fotosuratingizni tanlaysiz."

#: data/menu.xml:497
msgid "Alegi și probezi imaginea de odihnă a ecranului."
msgstr "Ekran saqlovchi tasvirini tanlaysiz va sinab ko‘rasiz."

#: data/menu.xml:506
msgid "Găsești reglajele de recepție, căutarea canalelor și orientarea antenei."
msgstr "Signal qabul qilish, kanallarni qidirish va antennani yo‘naltirish sozlamalarini topasiz."

#: data/menu.xml:518
msgid "Găsești reglajele și starea modulelor care deschid canalele codate."
msgstr "Shifrlangan kanallarni ochadigan modullarning sozlamalari va holatini topasiz."

#: data/menu.xml:520
msgid "Pornești, oprești și configurezi programele care deschid canalele codate."
msgstr "Shifrlangan kanallarni ochadigan dasturlarni ishga tushirasiz, to‘xtatasiz va sozlaysiz."

#: data/menu.xml:523
msgid "Vezi detalii despre deschiderea canalelor codate."
msgstr "Shifrlangan kanallarni ochish tafsilotlarini ko‘rasiz."

#: data/menu.xml:529
msgid "Reglezi releul prin care trec canalele alese din lista de canale."
msgstr "Kanallar ro‘yxatidan tanlangan kanallar o‘tadigan Stream Relay’ni sozlaysiz."

#: data/menu.xml:534
msgid "Vezi și reglezi modulele CI puse în sloturile receptorului."
msgstr "Resiver slotlariga o‘rnatilgan CI modullarini ko‘rasiz va sozlaysiz."

#: data/menu.xml:540
msgid "Limitezi printr-un cod accesul la canale și la opțiunile receptorului."
msgstr "Kanallar va resiver sozlamalariga kirishni PIN-kod bilan cheklaysiz."

#: data/menu.xml:546
msgid "Găsești actualizările și copiile de siguranță ale imaginii și setărilor."
msgstr "Proshivka va sozlamalar yangilanishlari hamda zaxira nusxalarini topasiz."

#: data/menu.xml:554
msgid "Cauți versiuni noi ale programelor, vezi schimbările și alegi instalarea."
msgstr "Dasturlarning yangi versiyalarini qidirasiz, o‘zgarishlarni ko‘rasiz va o‘rnatishni tanlaysiz."

#: data/menu.xml:557
msgid "Instalezi imaginea receptorului dintr-un fișier de pe stick."
msgstr "Resiver proshivkasini USB fleshkadagi fayldan o‘rnatasiz."

#: data/menu.xml:562
msgid "Descarci pe stick o imagine completă de pe internet, gata de instalat."
msgstr "Internetdan o‘rnatishga tayyor to‘liq proshivkani USB fleshkaga yuklab olasiz."

#: data/menu.xml:568
msgid "Salvezi setările pe stick sau pe disc și le poți pune la loc."
msgstr "Sozlamalarni USB fleshka yoki diskka saqlaysiz va qayta tiklay olasiz."

#: data/menu.xml:574
msgid "Salvezi toată imaginea pe stick sau pe disc, ca s-o poți pune din nou."
msgstr "Butun proshivkani qayta tiklash uchun USB fleshka yoki diskka saqlaysiz."

#: data/menu.xml:580
msgid "Găsești opțiunile de conectare, partajare și acces la receptor prin rețea."
msgstr "Tarmoqqa ulanish, resurslarni ulashish va resiverga kirish sozlamalarini topasiz."

#: data/menu.xml:582
msgid "Conectezi receptorul la rețeaua de acasă prin cablu sau fără fir."
msgstr "Resiverni uy tarmog‘iga kabel orqali yoki simsiz ulaysiz."

#: data/menu.xml:588
msgid "Alegi cât de des verifică receptorul legătura la internet."
msgstr "Resiver internet aloqasini qanchalik tez-tez tekshirishini tanlaysiz."

#: data/menu.xml:594
msgid "Alegi trecerea automată la altă conexiune când cea folosită nu mai merge."
msgstr "Ulanish ishlamay qolganda boshqasiga avtomatik o‘tishni tanlaysiz."

#: data/menu.xml:597
msgid "Vezi ce frecvențe sunt folosite de rețelele fără fir din apropiere."
msgstr "Yaqin atrofdagi simsiz tarmoqlar qaysi chastotalardan foydalanishini ko‘rasiz."

#: data/menu.xml:600
msgid "Vezi dispozitivele găsite în aceeași rețea cu receptorul."
msgstr "Resiver bilan bir tarmoqda topilgan qurilmalarni ko‘rasiz."

#: data/menu.xml:606
msgid "Activezi sau oprești folosirea adreselor de rețea în format nou."
msgstr "Yangi formatdagi tarmoq manzillaridan foydalanishni yoqasiz yoki o‘chirasiz."

#: data/menu.xml:612
msgid "Alegi dosarul receptorului pe care îl faci accesibil altor aparate din rețea."
msgstr "Tarmoqdagi boshqa qurilmalarga ulashadigan resiver jildini tanlaysiz."

#: data/menu.xml:615
msgid "Alegi serverele care transformă numele paginilor de internet în adrese."
msgstr "Internet sahifalari nomlarini manzillarga aylantiradigan serverlarni tanlaysiz."

#: data/menu.xml:621
msgid "Pui o parolă pentru accesul din rețea și alegi unde este cerută."
msgstr "Tarmoq orqali kirish uchun parol qo‘yasiz va qayerda so‘ralishini tanlaysiz."

#: data/menu.xml:628
msgid "Configurezi o conexiune privată și alegi ce trafic trece prin ea."
msgstr "Xususiy ulanishni sozlaysiz va u orqali qaysi trafik o‘tishini tanlaysiz."

#: data/menu.xml:633
msgid "Vezi și oprești redările canalelor în interfața web și reglezi transmisia."
msgstr "Veb-interfeysda kanal oqimlarini ko‘rasiz, to‘xtatasiz va translyatsiyani sozlaysiz."

#: data/menu.xml:639
msgid "Găsești reglajele receptorului, ale comenzilor și ale dispozitivelor conectate."
msgstr "Resiver, boshqaruv vositalari va ulangan qurilmalar sozlamalarini topasiz."

#: data/menu.xml:641
msgid "Pui pe un stick limbile și completările care nu încap în memoria receptorului."
msgstr "Resiver xotirasiga sig‘maydigan tillar va qo‘shimchalarni USB fleshkaga joylaysiz."

#: data/menu.xml:646
msgid "Potrivești ceasul receptorului și alegi de unde se actualizează."
msgstr "Resiver soatini sozlaysiz va qaysi manbadan yangilanishini tanlaysiz."

#: data/menu.xml:649
msgid "Vezi și reglezi paza care repornește receptorul când se blochează."
msgstr "Qotib qolgan resiverni qayta ishga tushiradigan resiver nazoratini (watchdog) ko‘rasiz va sozlaysiz."

#: data/menu.xml:654
msgid "Alegi modul de lucru și protecția împotriva încălzirii excesive."
msgstr "Ishlash rejimini va qizib ketishdan himoyani tanlaysiz."

#: data/menu.xml:660
msgid "Alegi datele și mesajele care se succed pe cele patru cifre ale receptorului."
msgstr "Resiverning to‘rt xonali displeyida almashib turadigan ma’lumot va xabarlarni tanlaysiz."

#: data/menu.xml:668
msgid "Reglezi felul în care receptorul răspunde la apăsarea tastelor telecomenzii."
msgstr "Masofadan boshqarish pulti tugmalari bosilganda resiver qanday javob berishini sozlaysiz."

#: data/menu.xml:671
msgid "Alegi codul prin care receptorul recunoaște comenzile de la telecomandă."
msgstr "Resiver masofadan boshqarish pulti buyruqlarini taniydigan kodni tanlaysiz."

#: data/menu.xml:681
msgid "Probezi tastele, citești codurile și asociezi alt dispozitiv de comandă."
msgstr "Tugmalarni sinaysiz, kodlarini o‘qiysiz va boshqa boshqaruv qurilmasini juftlaysiz."

#: data/menu.xml:684
msgid "Alegi aranjarea tastelor pentru tastatura conectată la receptor."
msgstr "Resiverga ulangan klaviaturada tugmalar joylashuvini tanlaysiz."

#: data/menu.xml:688
msgid "Alegi acțiunile pornite de tastele pentru acces rapid."
msgstr "Tezkor tugmalar bilan bajariladigan amallarni tanlaysiz."

#: data/menu.xml:694
msgid "Alegi ce face televizorul când receptorul trece în standby."
msgstr "Resiver kutish rejimiga o‘tganda televizor nima qilishini tanlaysiz."

#: data/menu.xml:697
msgid "Citești mesajele despre funcționarea receptorului pentru a găsi probleme."
msgstr "Muammolarni topish uchun resiverning ishlashi haqidagi xabarlarni o‘qiysiz."

#: data/menu.xml:703
msgid "Cureți datele care nu mai sunt necesare și alegi opțiunile de resetare."
msgstr "Keraksiz ma’lumotlarni tozalaysiz va dastlabki holatga qaytarish parametrlarini tanlaysiz."

#: data/menu.xml:706
msgid "Citești rapoartele salvate după opriri neașteptate ale programelor."
msgstr "Dasturlar kutilmaganda to‘xtagach saqlangan hisobotlarni o‘qiysiz."

#: data/menu.xml:712
msgid "Vezi rapoartele din celelalte imagini instalate și le salvezi sau le trimiți."
msgstr "O‘rnatilgan boshqa proshivkalarning hisobotlarini ko‘rasiz, saqlaysiz yoki yuborasiz."

#: data/menu.xml:718
msgid "Readuci preferințele receptorului la valorile inițiale."
msgstr "Resiver sozlamalarini dastlabki qiymatlariga qaytarasiz."

#: data/menu.xml:734
msgid "Te înscrii ca tester al versiunilor noi și deschizi meniul testerului."
msgstr "Yangi versiyalar testeri sifatida ro‘yxatdan o‘tasiz va tester menyusini ochasiz."

#: data/menu.xml:741
msgid "Pornești pentru scurt timp ajutorul echipei de la distanță și îl oprești oricând."
msgstr "Jamoaning masofaviy yordamini qisqa vaqtga yoqasiz va istalgan payt o‘chirasiz."

#: data/menu.xml:751
msgid "Alegi standby, oprirea completă sau repornirea receptorului."
msgstr "Kutish rejimini, to‘liq o‘chirishni yoki resiverni qayta ishga tushirishni tanlaysiz."

#: data/menu.xml:753
msgid "Alegi după cât timp receptorul trece singur în standby sau se oprește."
msgstr "Resiver qancha vaqtdan keyin o‘zi kutish rejimiga o‘tishi yoki o‘chishini tanlaysiz."

#: data/menu.xml:756
msgid "Treci receptorul în standby până când îl folosești din nou."
msgstr "Resiverni yana ishlatguningizcha kutish rejimiga o‘tkazasiz."

#: data/menu.xml:759
msgid "Repornești numai interfața, fără să repornești receptorul."
msgstr "Resiverni qayta ishga tushirmasdan faqat interfeysni qayta ishga tushirasiz."

#: data/menu.xml:762
msgid "Repornești receptorul de tot, nu numai interfața."
msgstr "Faqat interfeysni emas, butun resiverni qayta ishga tushirasiz."

#: data/menu.xml:768
msgid "Alegi altă imagine deja instalată și pornești receptorul cu ea."
msgstr "Avval o‘rnatilgan boshqa proshivkani tanlaysiz va resiverni u bilan ishga tushirasiz."

#: data/menu.xml:772
msgid "Instalezi pornirea multiplă, ca să poți ține mai multe imagini pe receptor."
msgstr "Resiverda bir nechta proshivka saqlash uchun ko‘p yuklanishni o‘rnatasiz."

#: data/menu.xml:775
msgid "Oprești receptorul complet până la următoarea pornire."
msgstr "Resiverni keyingi yoqishgacha to‘liq o‘chirasiz."

#: data/menu.xml:786
msgid "Găsești redarea filmelor și muzicii, fotografiile și fișierele din rețea."
msgstr "Film va musiqa ijrosi, fotosuratlar hamda tarmoqdagi fayllar bo‘limlarini topasiz."

#: data/menu.xml:788
msgid "Redai filme și muzică de pe stick, de pe disc sau din rețea."
msgstr "USB fleshka, disk yoki tarmoqdagi film va musiqalarni ijro etasiz."

#: data/menu.xml:791
msgid "Privești pe televizor fotografiile din fișierele tale."
msgstr "Fayllaringizdagi fotosuratlarni televizorda ko‘rasiz."

#: data/menu.xml:799
msgid "Deschizi pagini de internet pe televizor folosind telecomanda."
msgstr "Masofadan boshqarish pulti bilan televizorda internet sahifalarini ochasiz."

#: data/menu.xml:806
msgid "Răsfoiești fișiere de pe calculatoare și alte surse din rețea."
msgstr "Tarmoqdagi kompyuterlar va boshqa manbalardagi fayllarni ko‘rib chiqasiz."

#: data/menu.xml:811
msgid "Vezi meciurile și cursele de astăzi din ghid și canalele care le transmit."
msgstr "Teledasturda (EPG) bugungi uchrashuvlar, poygalar va ularni uzatadigan kanallarni ko‘rasiz."

#: data/menu.xml:816
msgid "Aduci programul emisiunilor din surse de internet pentru țara aleasă."
msgstr "Tanlangan mamlakat uchun teledasturni (EPG) internet manbalaridan olasiz."

#: data/menu.xml:825
msgid "Deschizi servicii de internet dintr-o grilă de pictograme pe televizor."
msgstr "Televizordagi kataklarga joylangan belgilar orqali internet xizmatlarini ochasiz."

#: lib/python/Components/VideoOutput.py:413
msgid "Dacă noul canal nu dă imagine, după câteva secunde ecranul se face negru."
msgstr "Yangi kanalda tasvir bo‘lmasa, bir necha soniyadan keyin ekran qorayadi."

#: lib/python/Components/HdsMultumiri.py:426
msgid "Contributori"
msgstr "Hissa qo‘shganlar"

#: lib/python/Components/NimManager.py:1666
#, python-format
msgid "Sateliți care nu mai sunt în lista sateliților, scoși de la tunere: %s."
msgstr "Ro‘yxatda endi yo‘q sun’iy yo‘ldoshlar tyuner sozlamalaridan olib tashlandi: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:4344
msgid "Lista sateliților e mai scurtă decât cea a imaginii. Sateliții lipsă se adaugă din lista imaginii; ce ai în listă rămâne."
msgstr "Sun’iy yo‘ldoshlar ro‘yxati proshivkadagidan qisqaroq. Yetishmayotgan sun’iy yo‘ldoshlar proshivka ro‘yxatidan qo‘shiladi; ro‘yxatda borlari saqlanib qoladi."

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:4345
#, python-format
msgid "Ștergi %s din lista sateliților? Nu mai revine singur."
msgstr "%s sun’iy yo‘ldoshini ro‘yxatdan o‘chirasizmi? U endi avtomatik qayta qo‘shilmaydi."

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:4346
#, python-format
msgid "Se scoate și de la tunere: %s."
msgstr "Tyuner sozlamalaridan ham olib tashlanadi: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:4347
msgid "Interfața repornește după ștergere."
msgstr "O‘chirishdan keyin interfeys qayta ishga tushadi."

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:4348
msgid "Se vede peste tot după repornirea interfeței."
msgstr "Interfeys qayta ishga tushirilgach, o‘zgarish hamma joyda ko‘rinadi."

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:4349
msgid "Satelitul e șters din lista sateliților."
msgstr "Sun’iy yo‘ldosh ro‘yxatdan o‘chirildi."

#: lib/python/Screens/HdsEditorCanale.py:2215
msgid "Șterge un satelit din listă…"
msgstr "Sun’iy yo‘ldoshni ro‘yxatdan o‘chirish…"

#: lib/python/Screens/HdsEditorCanale.py:3021
#, python-format
msgid "Șterge din lista sateliților: %s"
msgstr "Sun’iy yo‘ldoshlar ro‘yxatidan o‘chirish: %s"

#: data/menu.xml:514
msgid "Tuner de rezervă din rețea"
msgstr "Tarmoqdagi zaxira tyuner"

#: data/menu.xml:514
msgid "Alegi receptorul din casă de la care vin canalele când tunerele sunt ocupate."
msgstr "Tyunerlar band bo‘lganda kanallar uydagi qaysi resiverdan olinishini tanlaysiz."

#: data/setup.xml:48
msgid "Receptorul apropie singur volumul: canalele și reclamele tari se aud mai încet, cele încete mai tare. Alege pe unde asculți: HDMI, optic sau analogic. Nu lucrează când sunetul pleacă neschimbat spre televizor."
msgstr "Resiver ovoz balandligini o‘zi tenglashtiradi: ovozi baland kanallar va reklamalar pastroq, ovozi pastlari esa balandroq eshitiladi. Ovozni qaysi chiqishdan eshitishingizni tanlang: HDMI, optik yoki analog. Ovoz televizorga o‘zgartirilmay uzatilganda ishlamaydi."

#: data/setup.xml:155
msgid "Calitatea semnalului în bara canalului"
msgstr "Kanal axborot panelida signal sifati"

#: data/setup.xml:155
msgid "dB: în bara canalului, la calitate, se vede semnalul în dB (raportul semnal-zgomot), pe tunerele care dau o valoare adevărată; pe celelalte rămân procentele. Procente (%): numai procentele, ca înainte. La fel și pe pagina de start din interfața web."
msgstr "dB: haqiqiy qiymatni beradigan tyunerlarda kanal axborot panelidagi signal sifati dBda (signal-shovqin nisbati) ko‘rsatiladi; boshqalarida foizda qoladi. Foiz (%): avvalgidek faqat foizda ko‘rsatiladi. Veb-interfeys bosh sahifasida ham shunday."

#: data/setup.xml:341
msgid "Când tunerele acestui receptor sunt ocupate (de pildă cu înregistrări) sau nu pot lua canalul (alt fel de tuner, satelit nelegat), canalul vine prin rețea de la alt receptor din casă, cu tunerele lui. Receptoarele din casă se găsesc singure; alegi unul din listă. Canalul trebuie să fie și în lista acestui receptor. Oprit: canalul nu pornește, ca până acum."
msgstr "Bu resiverning tyunerlari band bo‘lsa (masalan, yozib olayotgan bo‘lsa) yoki kanalni qabul qila olmasa (tyuner turi boshqa yoki sun’iy yo‘ldosh ulanmagan), kanal tarmoq orqali uydagi boshqa resiverdan, uning tyunerlari yordamida olinadi. Uydagi resiverlar avtomatik topiladi; ro‘yxatdan birini tanlaysiz. Kanal bu resiverning ro‘yxatida ham bo‘lishi kerak. O‘chirilgan: kanal avvalgidek ochilmaydi."

#: data/setup.xml:342
msgid "Adresa receptorului"
msgstr "Resiver manzili"

#: data/setup.xml:342
msgid "Adresa receptorului din casă care dă canalele, de pildă 192.168.1.20 sau numele lui .local. Portul 8001 se pune singur; alt port îl scrii după două puncte (192.168.1.20:8001)."
msgstr "Kanallarni uzatadigan uydagi resiverning manzili, masalan, 192.168.1.20 yoki uning .local nomi. 8001 porti avtomatik qo‘shiladi; boshqa portni ikki nuqtadan keyin yozing (192.168.1.20:8001)."

#: lib/python/Components/HdsHdmiDate.py:55
msgid "Starea driverului HDMI"
msgstr "HDMI drayveri holati"

#: lib/python/Components/HdsHdmiDate.py:56
msgid "Imaginea trimisă"
msgstr "Uzatilayotgan tasvir"

#: lib/python/Components/HdsHdmiDate.py:57
msgid "Sunetul trimis"
msgstr "Uzatilayotgan ovoz"

#: lib/python/Components/HdsHdmiDate.py:58
msgid "Televizorul (EDID)"
msgstr "Televizor (EDID)"

#: lib/python/Components/HdsHdmiDate.py:59
msgid "Afișajul 1"
msgstr "Tasvir chiqishi 1"

#: lib/python/Components/HdsHdmiDate.py:60
msgid "Afișajul 0"
msgstr "Tasvir chiqishi 0"

#: lib/python/Components/HdsHdmiDate.py:61
msgid "Setările video Enigma2"
msgstr "Enigma2 video sozlamalari"

#: lib/python/Components/HdsHdmiDate.py:62
msgid "Decodorul video"
