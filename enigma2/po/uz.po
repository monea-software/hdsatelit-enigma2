msgid "Culoarea chenarului"
msgstr "Ramka rangi"

msgid "Forma chenarului"
msgstr "Ramka shakli"

msgid "Grosimea chenarului"
msgstr "Ramka qalinligi"

msgid "Chenarul pulsează"
msgstr "Ramka pulsatsiyasi"

msgid "Viteza pulsului"
msgstr "Pulsatsiya tezligi"

msgid "Contrast automat"
msgstr "Avtomatik kontrast"

msgid "Dreptunghi"
msgstr "To‘rtburchak"

msgid "Colțuri rotunjite"
msgstr "Yumaloq burchaklar"

msgid "Subliniere"
msgstr "Tagiga chizish"

msgid "Fundal colorat"
msgstr "Rangli fon"

