msgid ""
"<code>POST /api/telecomenzi-"
"asociere?pas=inapoi|sari|gata|continua|anuleaza|proba|inchide&amp;pastreaza=0|1</code>:"
" pașii asocierii unei telecomenzi noi"
msgstr ""
"<code>POST /api/telecomenzi-"
"asociere?pas=inapoi|sari|gata|continua|anuleaza|proba|inchide&amp;pastreaza=0|1</code>:"
" yangi pultni bog‘lash bosqichlari"

msgid ""
"<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-"
