msgstr "%d ta server topildi."

#, python-format
msgid ""
"Nu am găsit niciun server Ollama sau LibreTranslate în rețeaua %s. Ollama "
"ascultă din fabrică numai pe calculatorul lui, așa că receptorul nu-l vede "
"până nu-l pornești pentru rețea."
msgstr ""
"%s tarmog‘ida Ollama yoki LibreTranslate serveri topilmadi. Ollama standart "
"holatda faqat o‘z kompyuterida ishlaydi, shuning uchun uni tarmoq uchun "
"yoqmaguningizcha resiver uni ko‘rmaydi."

msgid ""
"Nu am găsit niciun server Ollama sau LibreTranslate. Ollama ascultă din "
"fabrică numai pe calculatorul lui, așa că receptorul nu-l vede până nu-l "
"pornești pentru rețea."
msgstr ""
"Ollama yoki LibreTranslate serveri topilmadi. Ollama standart holatda faqat "
"o‘z kompyuterida ishlaydi, shuning uchun uni tarmoq uchun yoqmaguningizcha "
"resiver uni ko‘rmaydi."

#, python-format
msgid "Căutarea s-a oprit după %d secunde."
msgstr "Qidiruv %d soniyadan so‘ng to‘xtadi."

#, python-format
