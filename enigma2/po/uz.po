msgstr "bu vaqt ichida fayl o‘zgardi"

msgid "fișierul nu se poate scrie"
msgstr "faylni yozib bo‘lmaydi"

msgid "nu mai e niciun port liber"
msgstr "bo‘sh port qolmadi"

msgid "Nu mai e niciun conflict de porturi."
msgstr "Endi port konflikti yo‘q."

