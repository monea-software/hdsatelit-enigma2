msgstr "Shrift hozir yuklanmagan."

msgid "Acces SSH"
msgstr "SSH kirish"

msgid "Cheia e stricată (textul de după tip nu e o cheie întreagă)."
msgstr "Kalit buzilgan (turdan keyingi matn to‘liq kalit emas)."

msgid "Numai cu cheie"
msgstr "Faqat kalit bilan"

msgid "Fără parolă în rețeaua locală: oprit."
msgstr "Mahalliy tarmoqda parolsiz: o‘chirilgan."

#, python-format
msgid "Chei adăugate: %d. Erau deja: %d. Refuzate: %d."
msgstr "Qo‘shilgan kalitlar: %d. Avval mavjud bo‘lgan: %d. Rad etilgan: %d."

msgid ""
"Cheia a fost ștearsă. Calculatorul cu această cheie intră de acum numai cu "
"parola."
msgstr ""
"Kalit o‘chirildi. Ushbu kalitga ega kompyuter endi faqat parol bilan kiradi."

msgid "Oprit: pe receptor se intră numai cu parola sau cu o cheie."
msgstr "O‘chirilgan: resiverga faqat parol yoki kalit bilan kirish mumkin."

msgid "Se lucrează..."
msgstr "Bajarilmoqda..."

msgid "Nu am putut citi parola lui root."
msgstr "Root parolini o‘qib bo‘lmadi."

msgid ""
"Lipsește programul care face parola (hds-ssh-parola). Se intră numai cu o "
"cheie."
msgstr ""
"Parol yaratuvchi dastur (hds-ssh-parola) mavjud emas. Kirish faqat kalit "
"bilan ishlaydi."

msgid ""
"Receptorul face parola, durează câteva secunde. Până atunci se intră numai cu"
" o cheie."
msgstr ""
"Resiver parol yaratmoqda, bu bir necha soniya vaqt oladi. Ungacha kirish "
"faqat kalit bilan ishlaydi."

msgid "Pusă, nu se mai arată"
msgstr "O‘rnatilgan, endi ko‘rsatilmaydi"

msgid "Fără parolă"
msgstr "Parolsiz"

msgid "Necunoscută"
msgstr "Noma’lum"

msgid "Se face..."
msgstr "Yaratilmoqda..."

#, python-format
msgid "Te conectezi de pe calculator cu: ssh root@%s"
msgstr "Kompyuterdan quyidagi buyruq bilan ulaning: ssh root@%s"

msgid ""
"Fără parolă în rețeaua locală: pornit. Oricine din rețeaua ta de acasă intră "
"pe receptor fără parolă."
msgstr ""
"Mahalliy tarmoqda parolsiz kirish: yoqilgan. Uy tarmog‘ingizdagi har qanday "
"foydalanuvchi resiverga parolsiz kira oladi."

msgid "Rândul e prea lung pentru o cheie publică."
msgstr "Satr ochiq kalit uchun juda uzun."

msgid "Rândul e gol."
msgstr "Satr bo‘sh."

msgid ""
"Nu e o cheie publică SSH. Cheia începe cu ssh-ed25519, ssh-rsa sau ecdsa-"
