msgid ""
"<code>GET /api/accel</code>: accelerarea 2D pe placa video: dacă receptorul o"
" are (<code>disponibila</code>), setarea pentru următoarea pornire (implicit "
"pornită) și ce s-a hotărât la pornirea de acum"
msgstr ""
"<code>GET /api/accel</code>: videokartada 2D tezlashtirish: resiverda "
"mavjudligi (<code>disponibila</code>), keyingi ishga tushirish uchun sozlama "
"(standart holatda yoqilgan) va joriy ishga tushirishda qabul qilingan qaror"

msgid ""
"<code>GET /api/acces-canal</code>: accesul canalului care rulează (criptat "
"sau liber), sistemele, CAID-urile și ce decriptează modulul acum"
msgstr ""
"<code>GET /api/acces-canal</code>: ishlayotgan kanalning kirishi (shifrlangan"
" yoki ochiq), tizimlar, CAIDlar va modul hozirda nimani shifrdan yechayotgani"

msgid ""
"<code>GET /api/acces-conditionat</code>: modulele de acces condiționat pe "
"feluri (câmpul <code>fel</code>: numele felului, așa cum îl are receptorul; "
"întâi modulele obișnuite, apoi serverele de carduri), cel ales la pornirea "
"receptorului, cele care rulează, procesul care lucrează și memoria lui, "
"comanda în curs sau ultimul rezultat, dacă receptorul decriptează acum"
msgstr ""
"<code>GET /api/acces-conditionat</code>: shartli kirish modullari turlari "
"bo‘yicha (<code>fel</code> maydoni: tur nomi, resiverda qanday bo‘lsa; avval "
"oddiy modullar, so‘ng karta serverlari), resiver ishga tushganda tanlangan "
"modul, ishlayotgan modullar, ishlayotgan jarayon va uning xotirasi, "
"bajarilayotgan buyruq yoki oxirgi natija, resiver hozirda shifrdan "
"yechayotganligi"

msgid ""
"<code>GET /api/acces-ssh</code>: intrarea pe receptor prin SSH: felul parolei"
" de administrator (fără parola însăși), cheile SSH (tipul, amprenta, "
"comentariul), „Fără parolă în rețeaua locală”, stările periculoase "
"(<code>alarme</code>), lucrarea în curs și rezultatul ultimei comenzi"
msgstr ""
"<code>GET /api/acces-ssh</code>: resiverga SSH orqali kirish: administrator "
"paroli turi (parolning o‘zi kirmagan holda), SSH kalitlari (turi, izi, izoh),"
" «Lokal tarmoqda parolsiz», xavfli holatlar (<code>alarme</code>), "
"bajarilayotgan ish va oxirgi buyruq natijasi"

msgid ""
"<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, "
"<code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, "
"<code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST "
"/api/actualizari-reporneste</code>: actualizările prin pachete de pe "
"stb.hdsatelit.com (starea, căutarea, instalarea, verificarea zilnică, "
"repornirea interfeței după instalare)"
msgstr ""
"<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, "
"<code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, "
"<code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST "
"/api/actualizari-reporneste</code>: stb.hdsatelit.com saytidagi paketlar "
"orqali yangilanishlar (holat, qidiruv, o‘rnatish, kunlik tekshiruv, "
"o‘rnatilgandan so‘ng interfeysni qayta ishga tushirish)"

msgid ""
"<code>GET "
"/api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;orase=1]</code>: "
"afișajul din față: ce arată acum (măștile celor 4 cifre și textul), lista de "
"rotire, mesajele scurte, așteptarea, setările, minutarul și cronometrul; cu "
"<code>grupa</code> alegerile grupei cu desenul valorii de acum, cu "
"<code>catalog=1</code> toate alegerile (căutarea), cu <code>orase=1</code> "
"fusurile pentru ora din alt oraș"
msgstr ""
"<code>GET "
"/api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;orase=1]</code>: "
"old panel displeyi: hozirda nima ko‘rsatilayotgani (4 ta raqam maskasi va "
"matn), rotatsiya ro‘yxati, qisqa xabarlar, kutish, sozlamalar, taymer va "
"xronometr; <code>grupa</code> bilan joriy qiymat tasviri bo‘lgan guruh "
"tanlovlari, <code>catalog=1</code> bilan barcha tanlovlar (qidiruv), "
"<code>orase=1</code> bilan boshqa shaharlar uchun vaqt mintaqalari"

msgid ""
"<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: "
"tunerele, LNB-ul, semnalul canalului curent și unghiurile antenei spre "
"fiecare satelit (numai citire)"
msgstr ""
"<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: "
"tyunerlar, LNB, joriy kanalning signali va har bir sun’iy yo‘ldoshga nisbatan"
" antenna burchaklari (faqat o‘qish)"

