msgid ""
"Lipește cheia oricărui serviciu: Gemini, DeepL, Azure, Google Cloud, Groq, "
"OpenRouter sau OpenAI. Receptorul recunoaște singur serviciul și o probează."
msgstr ""
"Istalgan xizmat kalitini joylashtiring: Gemini, DeepL, Azure, Google Cloud, "
"Groq, OpenRouter yoki OpenAI. Resiver xizmatni mustaqil taniydi va uni "
"tekshiradi."

msgid "Lipește din nou cheia"
msgstr "Kalitni qayta joylashtiring"

msgid "Lipește întâi cheia."
msgstr "Avval kalitni joylashtiring."

msgid ""
"Lipsește câmpul „cheie” (gol înseamnă ștergerea cheii). Nu s-a schimbat "
"nimic."
msgstr ""
"«cheie» maydoni mavjud emas (bo‘sh qolishi kalitni o‘chirishni anglatadi). "
"Hech narsa o‘zgarmadi."

msgid "Lista"
msgstr "Ro‘yxat"

msgid ""
"Lista albă: bifat înseamnă că cere PIN. Debifat pune canalul sau buchetul în "
"lista albă."
msgstr ""
"Oq ro‘yxat: belgilangan bo‘lsa, PIN so‘raladi. Belgisiz bo‘lsa, kanal yoki "
"buket oq ro‘yxatga qo‘shiladi."

msgid "Lista aleasă nu are ce filtra."
msgstr "Tanlangan ro‘yxatda filtrlash uchun hech narsa yo‘q."

msgid ""
"Lista așa cum e aleasă și filtrată acum, pentru VLC, Kodi sau alt player din "
"casă"
msgstr ""
"Hozirgi tanlangan va filtrlangan ro‘yxat, VLC, Kodi yoki uydagi boshqa pleer "
"uchun"

msgid "Lista de canale nu s-a putut citi."
msgstr "Kanallar ro‘yxatini o‘qib bo‘lmadi."

msgid "Lista de canale: alege și pornește un canal"
msgstr "Kanallar ro‘yxati: kanalni tanlang va ishga tushiring"

msgid "Lista de redare"
msgstr "Pleylist"

msgid "Lista de redare ("
msgstr "Ijro ro‘yxati ("

msgid "Lista de redare este goală"
msgstr "Ijro ro‘yxati bo‘sh"

