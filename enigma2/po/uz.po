msgstr ""
"Yuqoriga, Pastga, CH+ va CH-: boshqa sahifa (%s). Ko‘k: xom matn, so‘ngra "
"jadvalga qaytish."

msgid "Albastru: textul brut, apoi înapoi la tabel."
msgstr "Ko‘k: xom matn, so‘ngra jadvalga qaytish."

msgid "Adresa nu e bună."
msgstr "Manzil noto‘g‘ri."

msgid "Adresa nu e bună sau a fost revocată."
msgstr "Manzil noto‘g‘ri yoki bekor qilingan."

msgid ""
"Adresa a expirat. Descarcă din nou playlistul din interfața web a "
"receptorului."
msgstr ""
"Manzilning amal qilish muddati tugagan. Pleylistni resiverning veb-"
"interfeysidan qayta yuklab oling."

msgid "Canalul nu e în acest playlist."
msgstr "Kanal ushbu pleylistda mavjud emas."

#, python-format
msgid "Nu se știe cât mai durează, cel mult încă %s"
msgstr "Yana qancha vaqt ketishi noma’lum, ko‘pi bilan yana %s"

msgid "Nu se știe cât mai durează, se așteaptă semnalul"
msgstr "Yana qancha vaqt ketishi noma’lum, signal kutilmoqda"

#, python-format
