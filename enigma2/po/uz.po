msgstr "Tyuner %s: tekshirilmoqda..."

#, python-format
msgid "Pornește un canal de satelit pe tunerul %s, apoi încearcă din nou."
msgstr ""
"%s tyunerida sun’iy yo‘ldosh kanalini ishga tushiring, so‘ng qayta urinib "
"ko‘ring."

msgid "Se înregistrează sau urmează o înregistrare. Proba se face după aceea."
msgstr ""
"Yozib olish jarayoni ketmoqda yoki yaqin orada boshlanadi. Tekshiruv undan "
"keyin amalga oshiriladi."

msgid "Un canal se trimite acum în rețea. Proba se face după aceea."
msgstr ""
"Kanal hozirda tarmoqqa uzatilmoqda. Tekshiruv undan keyin amalga oshiriladi."

msgid "Închide imaginea în imagine, apoi încearcă din nou."
msgstr ""
"PiP (tasvir ichida tasvir) rejimini yoping, so‘ng qayta urinib ko‘ring."

msgid "Ecranul tunerului e deschis."
msgstr "Tyuner ekrani ochiq."

