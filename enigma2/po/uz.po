msgstr "YASHIL"

msgid "Vizualizatorul următor"
msgstr "Keyingi vizualizator"

msgid "În destinație există deja un fișier cu același nume."
msgstr "Manzilda shu nomli fayl allaqachon mavjud."

msgid "Înapoi la lista de filme"
msgstr "Filmlar ro‘yxatiga qaytish"

msgid "Înapoi, cu verificarea modificărilor"
msgstr "Orqaga, o‘zgarishlarni tekshirish bilan"

msgid "Șterge, cu confirmare"
msgstr "O‘chirish, tasdiqlash bilan"

