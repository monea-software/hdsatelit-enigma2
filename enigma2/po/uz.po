msgstr ""
"<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: til "
"modelini yuklab oladi (USB fleshka yoki diskka; ichki xotiraga faqat intern=1"
" bilan)"

msgid ""
"<code>POST /api/ocr-limbi-intreaba</code>: receptorul întreabă din nou pentru"
" limbile cu \"Nu mai întreba\""
msgstr ""
"<code>POST /api/ocr-limbi-intreaba</code>: resiver «Boshqa so‘ramang» deb "
"belgilangan tillar bo‘yicha qayta so‘raydi"

msgid "<code>POST /api/ocr-limbi-opreste?model=slk</code>: oprește descărcarea"
msgstr ""
"<code>POST /api/ocr-limbi-opreste?model=slk</code>: yuklab olishni to‘xtatadi"

msgid ""
"<code>POST /api/ocr-limbi-sterge?model=slk</code>: șterge un model descărcat "
"(sau îl scoate din listă când stickul lui nu e pus)"
msgstr ""
"<code>POST /api/ocr-limbi-sterge?model=slk</code>: yuklab olingan modelni "
"o‘chiradi (yoki USB fleshka ulanmagan bo‘lsa, uni ro‘yxatdan olib tashlaydi)"

msgid ""
"<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</code>:"
