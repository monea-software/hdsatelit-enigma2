msgstr ""
"<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: TVda ikki "
"bo‘limdan biridagi bandning ekranini ochadi"

msgid ""
"<code>POST /api/setari-din-copie-reporneste</code>: repornește interfața, ca "
"setările importate să se unească"
msgstr ""
"<code>POST /api/setari-din-copie-reporneste</code>: import qilingan "
"sozlamalar birlashishi uchun interfeysni qayta ishga tushiradi"

msgid ""
"<code>POST /api/setari-"
"seteaza?id=&lt;cheie&gt;&amp;r&lt;N&gt;=&lt;valoare&gt;</code>: schimbă și "
"salvează rândurile trimise (o valoare greșită nu schimbă nimic; la o alegere "
"multiplă, ca vitezele de derulare, alegerile despărțite prin virgulă, de "
"pildă <code>r20=2,8,16</code>; gol = nicio alegere)"
msgstr ""
"<code>POST /api/setari-"
"seteaza?id=&lt;cheie&gt;&amp;r&lt;N&gt;=&lt;valoare&gt;</code>: yuborilgan "
"qatorlarni o‘zgartiradi va saqlaydi (noto‘g‘ri qiymat hech narsani "
"o‘zgartirmaydi; ko‘p tanlovli holatlarda, masalan, oldinga o‘tkazish "
"tezliklari uchun, tanlovlar vergul bilan ajratiladi, masalan "
"<code>r20=2,8,16</code>; bo‘sh = tanlov yo‘q)"

msgid ""
"<code>POST /api/stocare-foloseste?punct=/media/usb</code>: folosește discul "
"pentru înregistrări (face dosarul movie, fără formatare)"
msgstr ""
"<code>POST /api/stocare-foloseste?punct=/media/usb</code>: diskdan yozib "
"olishlar uchun foydalanadi (movie jildini yaratadi, formatlashsiz)"

msgid ""
"<code>POST /api/subtitrari-aspect-implicite</code>: toate înapoi la valorile "
