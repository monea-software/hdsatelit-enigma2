msgstr ""
"Kanalens reference har ingen DVB-numre: logoet ville vises på flere kanaler."

msgid "Referință serviciu"
msgstr "Servicereference"

msgid "Refresh rate by channel"
msgstr "Opdateringshastighed pr. kanal"

