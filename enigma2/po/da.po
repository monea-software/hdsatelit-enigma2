msgstr "Kopien er opdateret"

msgid "Copia era de pe alt receptor, deci numai canalele."
msgstr "Kopien var fra en anden modtager, så kun kanalerne."

#, python-format
msgid ""
"Copia merge pe %s: canalele, buchetele, listele DAB+ și DVB-T2, setările, "
"rețeaua și Wi-Fi, cheile SSH și modulele de acces condiționat."
msgstr ""
"Kopien gemmes på %s: kanalerne, buketterne, DAB+- og DVB-T2-listerne, "
"indstillingerne, netværket og Wi-Fi, SSH-nøglerne og modulerne med betinget "
"adgang."

#, python-format
msgid "Copia modulelor de acces condiționat nu e bună (%s); nu s-a pus la loc."
msgstr ""
"Kopien af modulerne med betinget adgang er ikke gyldig (%s); den blev ikke "
"sat tilbage."

msgid "Copia nu are o descriere bună; nu s-a pus nimic la loc."
msgstr "Kopien har ingen gyldig beskrivelse; intet blev sat tilbage."

msgid "Copia nu are setări de rețea pe care să le pot folosi."
msgstr "Sikkerhedskopien har ingen netværksindstillinger, som jeg kan bruge."

#, python-format
msgid "Copia nu e întreagă (%s); nu s-a pus nimic la loc."
msgstr "Kopien er ikke komplet (%s); intet blev sat tilbage."

msgid "Copia nu mai este pe mediu."
msgstr "Kopien er ikke længere på mediet."

msgid "Copia nu mai este pe stick sau pe disc."
msgstr "Kopien er ikke længere på USB-stikket eller disken."

msgid "Copia nu mai există."
msgstr "Kopien findes ikke længere."

msgid ""
"Copia nu s-a putut pregăti pe receptor (memoria plină sau copia stricată); "
"nu s-a pus nimic la loc."
msgstr ""
"Kopien kunne ikke klargøres på modtageren (hukommelsen fuld eller kopien "
"beskadiget); intet blev sat tilbage."

msgid "Copia nu s-a putut reîmprospăta."
msgstr "Kopien kunne ikke opdateres."

msgid "Copia nu s-a putut salva."
msgstr "Kopien kunne ikke gemmes."

#, python-format
msgid ""
"Copia nu s-a putut scrie pe mediu (%s). Pe receptor nu s-a schimbat nimic."
msgstr ""
"Kopien kunne ikke skrives til mediet (%s). Intet er ændret på modtageren."

#, python-format
msgid "Copia nu s-a putut șterge (%s)."
msgstr "Kopien kunne ikke slettes (%s)."

msgid "Copia nu s-a reîmprospătat: receptorul nu a putut trece pe canal."
msgstr "Kopien blev ikke opdateret: modtageren kunne ikke skifte til kanalen."

#, python-format
msgid ""
"Copia nu s-a reîmprospătat: în %(minute)d minute teletextul canalului nu s-a "
"strâns tot. Pagini strânse: %(pagini)d."
msgstr ""
"Kopien blev ikke opdateret: på %(minute)d minutter blev kanalens tekst-tv "
"ikke samlet fuldstændigt. Samlede sider: %(pagini)d."

#, python-format
msgid ""
"Copia nu s-a reîmprospătat: în %(secunde)d de secunde canalul nu a trimis "
"nicio pagină de teletext (fără semnal sau fără teletext)."
msgstr ""
"Kopien blev ikke opdateret: på %(secunde)d sekunder sendte kanalen ingen "
"tekst-tv-side (intet signal eller intet tekst-tv)."

msgid "Copia nu se mai pune la loc."
msgstr "Kopien sættes ikke længere tilbage."

msgid "Copia nu se poate citi."
msgstr "Kopien kan ikke læses."

#, python-format
msgid "Copia s-a oprit: %s."
msgstr "Kopien stoppede: %s."

#, python-format
msgid "Copia s-a salvat: %d de pagini"
msgstr "Kopien er gemt: %d sider"

msgid "Copia s-a șters."
msgstr "Kopien er slettet."

msgid "Copia se pune la loc la repornirea interfeței."
msgstr "Kopien sættes tilbage, når grænsefladen genstarter."

msgid "Copia setărilor"
msgstr "Kopi af indstillinger"

