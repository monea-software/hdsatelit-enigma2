msgstr "Storbritannien"

msgid ""
"Registrele DVB-I nu au pentru această țară decât liste de probă. Poți bifa "
"una mai jos, ca s-o încerci."
msgstr ""
"DVB-I-registrene har kun testlister for dette land. Du kan markere en "
"nedenfor for at prøve den."

msgid "Registrele se întreabă deja."
msgstr "Registrene forespørges allerede."

msgid "Regiunea"
msgstr "Regionen"

msgid "Regiunea (numai dacă resursa nu e Global)"
msgstr "Region (kun hvis ressourcen ikke er Global)"

msgid "Regiunea aleasă nu e în listele țării."
msgstr "Den valgte region er ikke i landets lister."

msgid ""
"Regiunea e greșită: litere, cifre și liniuțe, de exemplu westeurope. Nu s-a "
"pornit nimic."
msgstr ""
"Regionen er forkert: bogstaver, tal og bindestreger, for eksempel "
"westeurope. Der blev ikke startet noget."

msgid ""
"Regiunea nu e bună: scrie-o exact ca în portalul Azure, de exemplu "
"westeurope."
msgstr ""
"Regionen er ikke korrekt: skriv den præcis som i Azure-portalen, for "
"eksempel westeurope."

msgid ""
"Regiunea o găsești în portal, la resursa Translator: Overview › Location."
msgstr ""
"Regionen finder du i portalen, under Translator-ressourcen: Overview › "
"Location."

msgid ""
"Regiunea o găsești în portal, la resursa Translator: Overview › Location. "
"Dacă nu știi, lasă „Automat”."
msgstr ""
"Regionen finder du i portalen, under Translator-ressourcen: Overview › "
"Location. Hvis du ikke kender den, så lad »Automat« stå."

msgid "Regiunea resursei"
msgstr "Ressourcens region"

msgid "Regiunea resursei Azure"
msgstr "Azure-ressourcens region"

msgid ""
"Regiunea resursei Azure: o găsești în portal, la resursa Translator, "
"Overview › Location."
msgstr ""
"Region for Azure-ressourcen: du finder den i portalen under Translator-"
"ressourcen, Overview › Location."

msgid ""
"Regiunea resursei Translator, ca în portal (Overview › Location), de exemplu "
"Germany West Central (germanywestcentral). Global dacă resursa e „Global”; "
"altfel de exemplu westeurope. Dacă nu o știi, apasă „Probează traducerea”: "
"receptorul o caută singur."
msgstr ""
"Regionen for Translator-ressourcen, som i portalen (Overview › Location), "
"for eksempel Germany West Central (germanywestcentral). Global hvis "
"ressourcen er »Global«; ellers for eksempel westeurope. Hvis du ikke kender "
"den, så tryk på »Test oversættelsen«: modtageren finder den selv."

msgid "Regiunea sau operatorul"
msgstr "Region eller udbyder"

msgid ""
"Regiunea, adresa, modelul și celelalte câmpuri se salvează când ieși din "
"câmp (sau apeși Enter)."
msgstr ""
"Regionen, adressen, modellen og de øvrige felter gemmes, når du forlader "
"feltet (eller trykker på Enter)."

msgid "Regiunea:"
msgstr "Region:"

msgid "Reglaje"
msgstr "Indstillinger"

