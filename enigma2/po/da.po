msgid "Recunoașterea textului (OCR)"
msgstr "Tekstgenkendelse (OCR)"

msgid ""
"Recunoașterea textului lucrează și acum: o cere traducerea subtitrărilor."
msgstr ""
"Tekstgenkendelse kører også nu: undertekstoversættelse har brug for den."

msgid ""
"Recunoașterea textului nu e aleasă acum în Aspectul subtitrărilor: modelele "
"se folosesc după ce o alegi."
msgstr ""
"Tekstgenkendelse er ikke valgt nu under Underteksters udseende: modellerne "
"bruges, når du vælger den."

msgid "Recunoașterea textului nu e pe receptor."
msgstr "Tekstgenkendelse er ikke på modtageren."

msgid "Recunosc cheia..."
msgstr "Genkender nøglen..."

