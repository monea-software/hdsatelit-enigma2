msgid "Numele e cel din scriptul lui de pornire."
msgstr "Navnet er det fra dens opstartscript."

msgid "Numele e cel trimis de serverul lui."
msgstr "Navnet er det som dens server sender."

msgid "Numele e deja folosit. Alege altul."
msgstr "Navnet er allerede i brug. Vælg et andet."

msgid ""
"Numele e gol sau are numai semne (punct, liniuță, spații). Unele pot fi "
"fluxuri care pornesc numai uneori: uită-te la frecvență și la imagine / "
"sunet."
msgstr ""
"Navnet er tomt eller indeholder kun tegn (punktum, bindestreg, mellemrum). "
"Nogle kan være feeds, der kun sender af og til: kig på frekvensen og på "
"billede / lyd."

msgid "Numele e salvat."
msgstr "Navnet er gemt."

msgid "Numele e titlul paginii lui."
msgstr "Navnet er titlen på dens side."

msgid "Numele filmului"
msgstr "Filmens navn"

msgid ""
"Numele fișierului nu e bun sau playerul nu cunoaște acest fel de fișier."
msgstr "Filnavnet er ugyldigt, eller afspilleren kender ikke denne filtype."

msgid "Numele fișierului nu se poate citi"
msgstr "Filnavnet kan ikke læses"

msgid ""
"Numele fișierului nu se poate citi pe receptor. Redenumește-l fără "
"diacritice."
msgstr ""
"Filnavnet kan ikke læses på modtageren. Omdøb det uden diakritiske tegn."

msgid "Numele fluxului"
msgstr "Streamens navn"

msgid "Numele fontului"
msgstr "Skrifttypens navn"

msgid "Numele fontului, de exemplu Roboto"
msgstr "Skrifttypenavnet, for eksempel Roboto"

msgid "Numele marcajului"
msgstr "Navnet på markeringen"

msgid "Numele modelului de pe server, de exemplu gemma3:4b sau qwen2.5:7b."
msgstr "Modelnavnet på serveren, for eksempel gemma3:4b eller qwen2.5:7b."

msgid ""
"Numele modelului e prea lung sau are caractere nepermise. Nu s-a pornit "
"nimic."
msgstr ""
"Modelnavnet er for langt eller indeholder tegn der ikke er tilladt. Intet "
"blev startet."

msgid "Numele modelului nu e bun."
msgstr "Modelnavnet er ikke korrekt."

msgid "Numele modulelor: %s"
msgstr "Modulnavne: %s"

msgid "Numele nou"
msgstr "Nyt navn"

#, python-format
msgid "Numele nu este bun (cel mult %d semne, pe un singur rând)."
msgstr "Navnet er ikke gyldigt (højst %d tegn, på én linje)."

msgid "Numele nu poate fi gol."
msgstr "Navnet kan ikke være tomt."

msgid "Numele nu se poate schimba încă de aici."
msgstr "Navnet kan endnu ikke ændres herfra."

msgid "Numele pachetului nu este valid. Nu se instalează."
msgstr "Pakkenavnet er ikke gyldigt. Den installeres ikke."

msgid "Numele pachetului nu este valid. Nu se șterge."
msgstr "Pakkenavnet er ikke gyldigt. Den slettes ikke."

msgid "Numele paginii (dacă vrei)"
msgstr "Sidens navn (valgfrit)"

#, python-format
msgid "Numele pe televizor: %s, cerut de televizor la %s."
msgstr "Navn på tv'et: %s, anmodet af tv'et kl. %s."

#, python-format
msgid "Numele pe televizor: %s."
msgstr "Navn på tv'et: %s."

msgid "Numele plăcii de sunet are numai litere, cifre și : , _ - ."
msgstr "Lydenhedens navn må kun indeholde bogstaver, cifre og : , _ - ."

msgid ""
"Numele poate avea doar litere mici, cifre și semnele - _ . (cel mult 32)."
msgstr ""
"Navnet må kun indeholde små bogstaver, cifre og tegnene - _ . (højst 32)."

msgid "Numele postului de radio"
msgstr "Radiostationens navn"

msgid "Numele public"
msgstr "Offentligt navn"

msgid "Numele public are 2-40 de semne: litere, cifre, spațiu, punct, liniuță."
msgstr ""
"Det offentlige navn har 2-40 tegn: bogstaver, cifre, mellemrum, punktum, "
"bindestreg."

msgid "Numele public e deja folosit de alt tester. Alege altul."
msgstr "Det offentlige navn bruges allerede af en anden tester. Vælg et andet."

msgid "Numele receptorului"
msgstr "Modtagerens navn"

msgid "Numele receptorului pe televizor"
msgstr "Modtagerens navn på tv'et"

msgid "Numele rețelei ascunse"
msgstr "Navnet på det skjulte netværk"

msgid "Numele satelitului"
msgstr "Satellitnavn"

msgid "Numele satelitului are un caracter care nu se poate scrie în listă."
msgstr "Satellittens navn indeholder et tegn, der ikke kan skrives i listen."

msgid "Numele satelitului e prea lung: cel mult %d de caractere."
msgstr "Satellittens navn er for langt: højst %d tegn."

msgid "Numele sau parola nu sunt bune. VPN-ul nu mai încearcă singur."
msgstr "Navnet eller adgangskoden er forkert. VPN'et prøver ikke længere selv."

msgid "Numele serverului NTP nu este valid."
msgstr "Navnet på NTP-serveren er ugyldigt."

msgid ""
"Numele serverului nu se găsește în rețea. Scrie adresa lui, de pildă "
"192.168.1.20."
msgstr ""
"Servernavnet kan ikke findes på netværket. Indtast dens adresse, for "
"eksempel 192.168.1.20."

msgid "Numele setării, cu tastele 0-9"
msgstr "Navnet på indstillingen, med tasterne 0-9"

msgid ""
"Numele spune HD sau 4K, dar emițătorul îl anunță ca SD: filtrul „HD și 4K” "
"nu-l prinde. Filtrul „HD în nume, tip SD” din „Adaugă canale” le arată pe "
"toate, cu bife."
msgstr ""
"Navnet siger HD eller 4K, men udbyderen annoncerer kanalen som SD: filteret "
"»HD og 4K« fanger den ikke. Filteret »HD i navnet, type SD« under »Tilføj "
"kanaler« viser dem alle med markeringer."

msgid "Numele sursei (litere mici, cifre și -)"
msgstr "Kildenavnet (små bogstaver, cifre og -)"

msgid "Numele sursei nu poate fi gol."
msgstr "Kildens navn kan ikke være tomt."

msgid "Numele sursei: litere mici, cifre și -"
msgstr "Kildens navn: små bogstaver, cifre og -"

msgid "Numele telecomenzii"
msgstr "Fjernbetjeningens navn"

msgid "Numele telecomenzii nu poate fi gol."
msgstr "Navnet på fjernbetjeningen må ikke være tomt."

msgid "Numele tău pe forum"
msgstr "Dit navn på forummet"

msgid "Numele tău pe forum e acum „%s”."
msgstr "Dit navn på forummet er nu »%s«."

msgid "Numele și parola au fost șterse de pe receptor."
msgstr "Navnet og adgangskoden blev slettet fra modtageren."

msgid "Numele și parola contului"
msgstr "Kontoens navn og adgangskode"

msgid ""
"Numele și parola contului HMA. După salvare nu se mai arată nicăieri. Se "
"scriu mai ușor din telefon, în interfața web."
msgstr ""
"Navnet og adgangskoden til din HMA-konto. Når de er gemt, vises de aldrig "
"igen. De er nemmere at skrive på din telefon i webgrænsefladen."

msgid "Numele și parola de serviciu"
msgstr "Servicenavn og -adgangskode"

msgid "Numele și parola din fișier nu se folosesc: se scriu pe receptor."
msgstr ""
"Navnet og adgangskoden i filen bruges ikke: de indtastes på modtageren."

msgid "Numele și parola sunt salvate. Nu se mai arată nicăieri."
msgstr "Navnet og adgangskoden er gemt. De vises ikke længere nogen steder."

msgid "Numele, cu tastatura de pe ecran"
msgstr "Navnet med skærmtastaturet"

msgid "Numele, cu tastele 0-9"
msgstr "Navnet med tasterne 0-9"

msgid ""
"Numerele DVB ale fluxului (pentru siglă): SID, TSID, ONID, namespace (hex)"
msgstr "Streamens DVB-numre (til logoet): SID, TSID, ONID, namespace (hex)"

msgid "Număr de fișiere"
msgstr "Antal filer"

msgid "Numărate de la ora"
msgstr "Talt siden"

msgid "Numărul canalului"
msgstr "Kanalnummer"

msgid "Numărul canalului din lista de canale."
msgstr "Kanalnummeret fra kanallisten."

#, python-format
msgid "Numărul copiilor păstrate trebuie să fie între 1 și %d."
msgstr "Antallet af bevarede kopier skal være mellem 1 og %d."

msgid "Numărul de bare"
msgstr "Antal bjælker"

msgid "Numărul de secunde nu este bun."
msgstr "Antallet af sekunder er ugyldigt."

msgid "Numărul din lista de canale, cel la care duc cifrele telecomenzii."
msgstr "Nummeret fra kanallisten, som fjernbetjeningens cifre fører til."

msgid ""
"Numărul mare nu înseamnă procesor ocupat: include firele driverelor care "
"așteaptă."
msgstr ""
"Et højt tal betyder ikke en travl processor: det inkluderer drivertråde, der "
"venter."

msgid "Numărul operatorului"
msgstr "Operatørens nummer"

msgid "Numărul poziției (1-255)"
msgstr "Positionens nummer (1-255)"

#, python-format
msgid "Numărul procesului (PID): %s"
msgstr "Procesnummer (PID): %s"

msgid "Numărul rețelei (ONID)"
msgstr "Netværksnummer (ONID)"

msgid "Numărul transponderului (TSID)"
msgstr "Transpondernummer (TSID)"

msgid "Numărul și numele"
msgstr "Nummer og navn"

msgid "Numărătoarea opririlor"
msgstr "Stoptæller"

msgid ""
"O adresă http:// merge numai pentru un server din rețeaua de acasă (de "
"exemplu 192.168.1.50); pentru un server de pe internet scrie https://."
msgstr ""
"En http://-adresse virker kun for en server på hjemmenetværket (for eksempel "
"192.168.1.50); for en server på internettet skal du skrive https://."

msgid ""
"O altă placă e deja configurată. Pe televizor, aceeași întrebare apare la OK."
msgstr ""
"Et andet kort er allerede konfigureret. På tv'et vises samme spørgsmål ved "
"OK."

msgid "O altă schimbare a rețelei încă lucrează. Așteaptă să se termine."
msgstr "En anden netværksændring kører stadig. Vent til den er færdig."

msgid "O altă schimbare de LNB așteaptă confirmarea."
msgstr "En anden LNB-ændring venter på bekræftelse."

msgid "O altă valoare a receptorului nu se potrivește."
msgstr "En anden værdi fra modtageren stemmer ikke."

msgid "O captură aleasă nu mai există. Alege din nou."
msgstr "Et valgt skærmbillede findes ikke længere. Vælg igen."

msgid ""
"O cheie pleacă numai pe https:// sau spre un server din rețeaua de acasă. "
"Scrie adresa cu https://. Cheia nu a plecat nicăieri."
msgstr ""
"En nøgle sendes kun over https:// eller til en server på hjemmenetværket. "
"Skriv adressen med https://. Nøglen er ikke sendt nogen steder."

msgid "O conectare Wi-Fi încă lucrează. Așteaptă să se termine sau oprește-o."
msgstr ""
"En Wi-Fi-forbindelse er stadig i gang. Vent til den er færdig, eller stop "
"den."

msgid "O copie așteaptă să fie pusă la loc la repornirea interfeței."
msgstr "En kopi venter på at blive sat tilbage, når grænsefladen genstarter."

msgid "O copie se face deja. Așteaptă să se termine."
msgstr "Kopiering er i gang. Vent til færdig."

msgid ""
"O copie se face singură înainte de fiecare salvare, aici și în interfața "
"web. Întoarcerea pune întâi lista de acum într-o copie nouă."
msgstr ""
"Der oprettes automatisk en kopi før hver lagring, her og i webgrænsefladen. "
"Tilbageføringen lægger først den nuværende liste i en ny kopi."

msgid "O cutie pentru toate rândurile"
msgstr "Én boks til alle linjer"

msgid ""
"O căutare e deja în curs pe receptor. Așteaptă să se termine sau oprește-o."
msgstr ""
"En søgning er allerede i gang på modtageren. Vent til den er færdig eller "
"stop den."

msgid "O căutare e deja în curs."
msgstr "En søgning er allerede i gang."

msgid "O căutare sau o descărcare merge deja; așteaptă să se termine."
msgstr "En søgning eller en download kører allerede; vent til den er færdig."

msgid ""
"O data pe zi, in fundal, receptorul ia de pe stb.hdsatelit.com frecventele "
"si numele posturilor. Butonul Actualizeaza lista merge oricand."
msgstr ""
"Én gang om dagen henter modtageren i baggrunden frekvenserne og stationernes "
"navne fra stb.hdsatelit.com. Knappen Opdater listen virker altid."

msgid "O dată pe minut"
msgstr "Én gang i minuttet"

msgid "O dată pe săptămână"
msgstr "En gang om ugen"

msgid ""
"O dată pe zi, noaptea, numai felurile bifate, și imediat după o oprire "
"neașteptată a interfeței sau o actualizare care nu a reușit. Fără bifă "
"pleacă numai ce trimiți tu cu „Trimite acum”."
msgstr ""
"Én gang om dagen, om natten, kun de afkrydsede typer, og straks efter et "
"uventet stop af grænsefladen eller en mislykket opdatering. Uden afkrydsning "
"sendes kun det, du sender med »Send nu«."

msgid ""
"O dată pe zi, în fundal, receptorul ia de pe stb.hdsatelit.com frecvențele "
"și numele posturilor. Butonul „Actualizează lista” merge oricând. <span "
"id=\"ultimaZilnica\"></span>"
msgstr ""
"Én gang om dagen, i baggrunden, henter modtageren frekvenserne og "
"stationernes navne fra stb.hdsatelit.com. Knappen »Opdater listen« virker "
"når som helst. <span id=\"ultimaZilnica\"></span>"

msgid "O eroare pe receptor."
msgstr "En fejl på modtageren."

msgid "O greșeală, o idee sau o întrebare, direct echipei."
msgstr "En fejl, en idé eller et spørgsmål, direkte til teamet."

msgid "O lipești, iar receptorul recunoaște singur serviciul."
msgstr "Du indsætter den, og modtageren genkender selv tjenesten."

msgid ""
"O listă de redare de pe disc nu se poate șterge din player, nici pe "
"televizor."
msgstr ""
"En afspilningsliste på disken kan ikke slettes fra afspilleren, heller ikke "
"på tv'et."

msgid "O margine e între 0 și 5 la sută din latura ei."
msgstr "En margen er mellem 0 og 5 procent af dens side."

msgid "O notă despre emisiune. OK deschide tastatura."
msgstr "En note om programmet. OK åbner tastaturet."

msgid "O pagină mai jos"
msgstr "En side ned"

msgid "O pagină mai sus"
msgstr "En side op"

msgid "O pagină în jos"
msgstr "En side ned"

msgid "O pagină în sus"
msgstr "En side op"

msgid ""
"O poză nu a putut fi urcată: trebuie să fie JPG sau PNG, de cel mult 4 MB."
msgstr ""
"Et billede kunne ikke uploades: det skal være JPG eller PNG og højst 4 MB."

msgid "O poți instala din nou oricând, din aceeași sursă."
msgstr "Du kan installere den igen når som helst fra samme kilde."

msgid "O probă DiSEqC e deja deschisă pe televizor. Închide-o întâi."
msgstr "En DiSEqC-test er allerede åben på tv'et. Luk den først."

msgid "O reîmprospătare e deja în lucru."
msgstr "En opdatering er allerede i gang."

msgid "O reîncărcare e deja în curs."
msgstr "En genindlæsning er allerede i gang."

msgid ""
"O scanare DAB+ sau DVB-T2 e deschisă pe televizor. Așteaptă să se termine "
"sau oprește-o."
msgstr ""
"En DAB+- eller DVB-T2-søgning er åben på tv'et. Vent til den er færdig eller "
"stop den."

msgid "O singură dată"
msgstr "En gang"

msgid ""
"O singură dată sau repetat: în fiecare zi, o dată pe săptămână, de luni până "
"vineri sau în zilele alese."
msgstr ""
"En gang eller gentaget: hver dag, en gang om ugen, mandag til fredag eller "
"på valgte dage."

msgid "O singură limbă: forumul traduce singur."
msgstr "Ét sprog: forummet oversætter selv."

msgid ""
"O telecomandă USB (sau o tastatură) se bagă în receptor înainte; se vede "
"imediat."
msgstr ""
"Sæt en USB-fjernbetjening (eller et tastatur) i modtageren først; den "
"registreres med det samme."

msgid ""
"O telecomandă cu infraroșu, alta decât a receptorului, nu se poate asocia "
"încă."
msgstr ""
"En infrarød fjernbetjening, som ikke er modtagerens, kan endnu ikke parres."

msgid "O valoare a transponderului nu e bună: %s."
msgstr "En transponderværdi er ikke gyldig: %s."

msgid "O înregistrare e în curs."
msgstr "En optagelse er i gang."

msgid "O înregistrare e în curs: se oprește la revenire."
msgstr "En optagelse er i gang: den stopper ved nulstillingen."

msgid ""
"O înregistrare folosește acum antena. Comenzile pornesc după ce se termină."
msgstr ""
"En optagelse bruger parabolen nu. Kommandoerne starter, når den er slut."

msgid ""
"O înregistrare folosește acum tunerul. Locul se schimbă după ce se termină."
msgstr "En optagelse bruger nu tuneren. Placeringen ændres, når den er færdig."

msgid "O înregistrare programată nu poate porni: nu am unde să înregistrez."
msgstr "En planlagt optagelse kan ikke starte: der er ingen steder at optage."

#, python-format
msgid "O înregistrare scrie acum pe acest disc: %s."
msgstr "En optagelse skriver nu til denne disk: %s."

msgid "O înregistrare începe în curând. Pornește scanarea detaliată după ea."
msgstr "En optagelse starter snart. Start den detaljerede søgning bagefter."

#, python-format
msgid "O înregistrare începe în mai puțin de %d minute."
msgstr "En optagelse starter om mindre end %d minutter."

msgid "O înregistrare începe în mai puțin de 6 minute."
msgstr "En optagelse starter om mindre end 6 minutter."

msgid "OK"
msgstr "OK"

msgid "OK = da, EXIT = nu"
msgstr "OK = ja, EXIT = nej"

msgid "OK actualizează · Roșu șterge"
msgstr "OK opdaterer · Rød sletter"

msgid "OK adaugă"
msgstr "OK tilføjer"

msgid ""
"OK adaugă canalul în buchetul din dreapta · cifrele scriu numele · HELP "
"ajutor"
msgstr ""
"OK tilføjer kanalen til buketten til højre · cifrene skriver navnet · HELP "
"hjælp"

msgid "OK add to playlist, MENU options, CH+ / CH- switch list"
msgstr ""
"OK føj til afspilningsliste   ·   MENU indstillinger   ·   CH+ / CH− skift "
"liste"

msgid "OK alege"
msgstr "OK vælger"

msgid "OK alege capturile, Verde le pune în mesaj."
msgstr "OK vælger skærmbillederne, Grøn sætter dem i beskeden."

msgid "OK alege feedul pachetelor arătate."
msgstr "OK vælger feedet for de viste pakker."

msgid "OK alege feedul sau felul pachetelor arătate."
msgstr "OK vælger feedet eller typen af viste pakker."

msgid ""
"OK alege latura: toate, sus, dreapta, jos sau stânga. Săgeata spre margine "
"duce latura aleasă spre marginea ecranului, săgeata opusă o aduce spre "
"mijloc. La toate laturile, Sus și Dreapta măresc cadrul, Jos și Stânga îl "
"micșorează. Potrivește cadrul până se vede întreg pe televizor."
msgstr ""
"OK vælger side: alle, top, højre, bund eller venstre. Pilen mod kanten "
"flytter den valgte side mod skærmens kant, den modsatte pil bringer den mod "
"midten. Ved alle sider forstørrer Op og Højre rammen, Ned og Venstre gør den "
"mindre. Tilpas rammen, indtil du ser hele den på tv'et."

msgid ""
"OK alege orașul. Ora lui apare când „Ora din alt oraș” e în lista de rotire."
msgstr ""
"OK vælger byen. Dens tid vises, når »Tid i en anden by« er i rotationslisten."

msgid "OK alege valoarea."
msgstr "OK vælger værdien."

msgid "OK alege valoarea. Luminozitatea se aplică după salvare."
msgstr "OK vælger værdien. Lysstyrken anvendes efter gem."

msgid "OK alege valoarea. Se aplică după salvare."
msgstr "OK vælger værdien. Gælder efter gem."

msgid "OK alege · Roșu arată tot"
msgstr "OK vælger · Rød viser alt"

msgid ""
"OK alegi canalele ale căror piste se citesc acum · Stânga înapoi la nume"
msgstr "OK vælger kanalerne, hvis spor læses nu · Venstre tilbage til navnet"

msgid "OK arată canalele"
msgstr "OK viser kanalerne"

msgid "OK arată de ce"
msgstr "OK viser hvorfor"

msgid "OK arată de ce · Verde instalează înlocuitorul"
msgstr "OK viser hvorfor · Grøn installerer erstatningen"

msgid ""
"OK arată fișierele de setări ale serverelor SSH și FTP, așa cum sunt pe "
"receptor."
msgstr ""
"OK viser indstillingsfilerne for SSH- og FTP-serverne, som de ligger på "
"modtageren."

msgid ""
"OK arată fișierele de setări ale serverului SSH, așa cum sunt pe receptor."
msgstr "OK viser SSH-serverens indstillingsfiler, som de er på modtageren."

msgid "OK ascunde canalele"
msgstr "OK skjuler kanalerne"

msgid "OK bifează sau debifează"
msgstr "OK markerer eller fjerner markeringen"

msgid "OK bifează sau debifează · pe titlul grupei: toată grupa"
msgstr ""
"OK markerer eller fjerner markeringen · på gruppens titel: hele gruppen"

msgid ""
"OK bifează și trece mai jos · tastele colorate lucrează pe rândurile bifate"
msgstr ""
"OK sætter kryds og går ned · farvetasterne virker på de markerede rækker"

msgid "OK caută"
msgstr "OK søger"

msgid ""
"OK caută singur serverul din casă (LibreTranslate sau Ollama) și îl "
"probează. Adresa se poate scrie și de mână, mai jos."
msgstr ""
"OK finder selv serveren i dit hjem (LibreTranslate eller Ollama) og tester "
"den. Adressen kan også skrives i hånden nedenfor."

msgid "OK caută în rețea"
msgstr "OK søger på netværket"

msgid "OK deschide"
msgstr "OK åbner"

msgid ""
"OK deschide adresele puse de mână, listele predefinite și pornirea DVB-I."
msgstr ""
"OK åbner de manuelt tilføjede adresser, de foruddefinerede lister og start "
"af DVB-I."

msgid ""
"OK deschide buchetul · Stânga / Dreapta: coloana · < anulează · > refă · "
"HELP ajutor"
msgstr ""
"OK åbner buketten · Venstre / Højre: kolonne · < fortryd · > gentag · HELP "
"hjælp"

msgid ""
"OK deschide lista limbilor: cele din imagine, cele descărcate și cele care "
"se pot descărca, cu mărimea fiecăreia."
msgstr ""
"OK åbner sproglisten: dem i imaget, de downloadede og dem, der kan "
"downloades, hver med sin størrelse."

msgid "OK deschide meniul, cu „Locul înregistrărilor”."
msgstr "OK åbner menuen med »Optagelsernes placering«."

msgid ""
"OK deschide pașii pentru serviciul ales: contul, cheia gratuită, cota și ce "
"se întâmplă la depășire."
msgstr ""
"OK åbner trinnene for den valgte tjeneste: kontoen, den gratis nøgle, kvoten "
"og hvad der sker ved overskridelse."

msgid "OK deschide sau închide toți sateliții"
