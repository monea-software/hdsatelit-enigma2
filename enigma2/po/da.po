msgid ""
"„Adresă proprie” (alt serviciu, cu adresa lui) și toate celelalte setări "
"sunt pe pagina cu toate setările:"
msgstr ""
"»Egen adresse« (en anden tjeneste, med dens adresse) og alle de andre "
"indstillinger er på siden med alle indstillinger:"

msgid ""
"„Adresă proprie” e pentru un server de traducere ales de tine, de exemplu un "
"LibreTranslate pornit pe un calculator din casă. Receptorul trimite fiecare "
"rând de subtitrare într-o cerere separată."
msgstr ""
"»Egen adresse« er til en oversættelsesserver, du selv vælger, for eksempel "
"en LibreTranslate, der kører på en computer derhjemme. Modtageren sender "
"hver undertekstlinje i en separat forespørgsel."

msgid "„Ca la calculator” revine la următoarea pornire a receptorului."
msgstr "»Som på computer« vender tilbage ved næste start af modtageren."

msgid ""
"„Ca la calculator” revine numai după o repornire. Repornești receptorul acum?"
msgstr ""
"»Som på computer« vender kun tilbage efter en genstart. Genstarter du "
"modtageren nu?"

msgid ""
"„Ca la calculator” se aplică la următoarea pornire; pe unele televizoare "
"imaginea iese spălăcită pe 60 Hz."
msgstr ""
"»Som på computer« anvendes ved næste start; på nogle tv er billedet udvasket "
"ved 60 Hz."

msgid ""
"„Ca la calculator” se aplică numai după o repornire. Repornești receptorul "
"acum?"
msgstr ""
"»Som på computer« anvendes kun efter en genstart. Genstarter du modtageren "
"nu?"

msgid ""
"„Enigma” și „Dreambox” sunt mărci ale Dream Property GmbH; celelalte nume de "
"produse aparțin deținătorilor lor."
msgstr ""
"»Enigma« og »Dreambox« er varemærker tilhørende Dream Property GmbH; andre "
"produktnavne tilhører deres ejere."

msgid ""
"„Folosește pentru înregistrări” face pe disc dosarul movie, dacă lipsește. "
"Nu se șterge și nu se formatează nimic."
msgstr ""
"»Brug til optagelser« opretter mappen movie på disken, hvis den mangler. "
"Intet slettes og intet formateres."

msgid "„Fără subtitrări niciodată” se alege cu 1 (da) sau 0 (nu)."
msgstr "»Aldrig undertekster« vælges med 1 (ja) eller 0 (nej)."

msgid ""
"„Redenumește” schimbă numele numai în acest buchet. „Redenumește peste tot” "
"îl schimbă în lista receptorului."
msgstr ""
"»Omdøb« ændrer navnet kun i denne buket. »Omdøb overalt« ændrer det i "
"modtagerens liste."

msgid "„Standby” pornește automat fără nicio înregistrare activă."
msgstr "»Standby« starter automatisk, når der ikke er nogen aktiv optagelse."

msgid "„pornit” se alege cu 1 (da) sau 0 (nu)."
msgstr "»pornit« vælges med 1 (ja) eller 0 (nej)."

msgid "−1 min"
msgstr "−1 min"

