msgid ""
"Aplicația HbbTV a acestui canal e folosită numai pentru măsurarea audienței "
"și nu are nimic de arătat pe ecran."
msgstr ""
"Denne kanals HbbTV-applikation bruges kun til seermåling og har intet at "
"vise på skærmen."

msgid ""
"Aplicația HbbTV a acestui canal e o pagină goală: postul nu a pus nimic în "
"ea."
msgstr ""
"Denne kanals HbbTV-applikation er en tom side: tv-stationen har ikke lagt "
"noget i den."

msgid ""
"Aplicația HbbTV a acestui canal e prea mare pentru memoria receptorului."
msgstr "Dette kanals HbbTV-applikation er for stor til modtagerens hukommelse."

msgid "Aplicația HbbTV a acestui canal nu are o adresă pe internet."
msgstr "HbbTV-applikationen på denne kanal har ingen internetadresse."

msgid ""
"Aplicația HbbTV a acestui canal nu mai este la adresa anunțată de post: "
"pagina a fost mutată sau ștearsă."
msgstr ""
"Denne kanals HbbTV-applikation er ikke længere på den adresse, som tv-"
"stationen oplyste: siden er flyttet eller slettet."

msgid ""
"Aplicația HbbTV a acestui canal nu s-a încărcat întreagă din satelit: "
"semnalul e prea slab."
msgstr ""
"Dette kanals HbbTV-applikation blev ikke indlæst fuldstændigt fra "
"satellitten: signalet er for svagt."

msgid ""
"Aplicația HbbTV a acestui canal nu vine din satelit: pista ei e criptată sau "
"semnalul lipsește."
msgstr ""
"Dette kanals HbbTV-applikation kommer ikke fra satellitten: dens spor er "
"krypteret, eller der mangler signal."

msgid ""
"Aplicația HbbTV a acestui canal pornește cu tasta ALBASTRU. Apasă ALBASTRU."
msgstr "Denne kanals HbbTV-applikation startes med tasten BLÅ. Tryk på BLÅ."

msgid ""
"Aplicația HbbTV a acestui canal se deschide numai pe anumite televizoare și "
"nu a primit receptorul."
msgstr ""
"Denne kanals HbbTV-applikation åbner kun på bestemte tv'er og accepterede "
"ikke modtageren."

msgid ""
"Aplicația HbbTV a acestui canal vine din semnalul altui canal și receptorul "
"nu o poate încărca de aici."
msgstr ""
"Dette kanals HbbTV-applikation kommer i en anden kanals signal, og "
"modtageren kan ikke indlæse den herfra."

msgid ""
"Aplicația HbbTV a acestui canal începe cu o întrebare de consimțământ care "
"nu se vede pe ecran. De obicei trece singură în jumătate de minut."
msgstr ""
"Denne kanals HbbTV-applikation starter med et samtykkespørgsmål, som ikke "
"vises på skærmen. Normalt fortsætter den af sig selv inden for et halvt "
"minut."

msgid "Aplicația HbbTV a canalului (butonul roșu)"
msgstr "Kanalens HbbTV-app (rød knap)"

msgid "Aplicația HbbTV a canalului nu s-a arătat pe ecran."
msgstr "Kanalens HbbTV-applikation viste sig ikke på skærmen."

msgid ""
"Aplicația HbbTV a canalului nu s-a arătat pe ecran. Unele aplicații lucrează "
"numai în fundal, fără nimic de arătat."
msgstr ""
"Kanalens HbbTV-applikation viste sig ikke på skærmen. Nogle applikationer "
"arbejder kun i baggrunden uden noget at vise."

msgid "Aplicația HbbTV a canalului nu s-a arătat încă. Apasă din nou ROȘU."
msgstr "Kanalens HbbTV-applikation er endnu ikke vist. Tryk på RØD igen."

msgid "Aplicația HbbTV a canalului s-a închis singură, înainte să se arate."
msgstr "Kanalens HbbTV-applikation lukkede af sig selv, før den viste sig."

msgid "Aplicația HbbTV din satelit nu are pagina de pornire anunțată de canal."
msgstr ""
"HbbTV-applikationen fra satellitten har ikke den startside, som kanalen har "
"annonceret."

msgid ""
"Aplicația HbbTV din satelit nu se poate citi acum din semnalul canalului."
msgstr ""
"HbbTV-applikationen fra satellitten kan ikke læses fra kanalens signal lige "
"nu."

msgid "Aplicația HbbTV nu a pornit."
msgstr "HbbTV-applikationen startede ikke."

msgid "Aplicația HbbTV s-a închis."
msgstr "HbbTV-applikationen blev lukket."

