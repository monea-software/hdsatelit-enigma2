msgstr "Indstillingskopien blev ikke sat tilbage."

msgid "Copia setărilor pe stick, pusă singură la loc după o actualizare."
msgstr ""
"Kopi af indstillinger på USB-stik, sættes automatisk tilbage efter en "
"opdatering."

#, python-format
msgid "Copia: %s, %s"
msgstr "Kopi: %s, %s"

#, no-python-format
msgid "Copiat %d rând"
msgid_plural "Copiate %d rânduri"
msgstr[0] "Kopieret %d række"
msgstr[1] "Kopieret %d rækker"

msgid "Copiat."
msgstr "Kopieret."

msgid "Copiate. Alege locul și apasă Ctrl+V."
msgstr "Kopieret. Vælg stedet og tryk Ctrl+V."

msgid ""
"Copiaz-o întreagă din pagina cheii (console.cloud.google.com/apis/"
"credentials), fără spații. În proiectul cheii pornește „Cloud Translation "
"API” și verifică să nu fie cheia restrânsă la alt API."
msgstr ""
"Kopier den helt fra nøglesiden (console.cloud.google.com/apis/credentials) "
"uden mellemrum. I nøglens projekt skal du slå »Cloud Translation API« til og "
"kontrollere, at nøglen ikke er begrænset til et andet API."

msgid "Copiaz-o întreagă din pagina cheii, fără spații, și încearcă din nou."
msgstr "Kopier den helt fra nøglesiden uden mellemrum, og prøv igen."

msgid ""
"Copiaz-o întreagă din pagina cheii, fără spații. Cheia pentru Gemini se face "
"pe aistudio.google.com/apikey."
msgstr ""
"Kopier den helt fra nøglesiden uden mellemrum. Nøglen til Gemini oprettes på "
"aistudio.google.com/apikey."

#, python-format
msgid "Copiaz-o întreagă din pagina cheilor (%s), fără spații."
msgstr "Kopier den helt fra nøglesiden (%s) uden mellemrum."

msgid ""
"Copiaz-o întreagă din pagina cheilor DeepL (www.deepl.com/your-account/"
"keys), fără spații. Trebuie o cheie de la DeepL API, nu de la traducătorul "
"obișnuit."
