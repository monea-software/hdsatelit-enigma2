msgid "Gata: traducerea subtitrărilor e pornită, cu %s."
msgstr "Kész: a feliratfordítás be van kapcsolva, ezzel: %s."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Cheia e bună și e salvată, cu %s, dar cota s-a terminat."
msgstr "A kulcs jó és el van mentve, ezzel: %s, de a keret elfogyott."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Salvat fără probă: traducerea subtitrărilor e pornită, cu %s."
msgstr "Mentve próba nélkül: a feliratfordítás be van kapcsolva, ezzel: %s."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Am găsit regiunea: %s (%s). %s"
msgstr "Megtaláltam a régiót: %s (%s). %s"

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Caută deja. Așteaptă să se termine."
msgstr "A keresés már folyik. Várd meg, amíg véget ér."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Receptorul nu are rețea."
msgstr "A vevőnek nincs hálózata."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Receptorul nu e într-o rețea de acasă (adresă privată); nu caut."
msgstr "A vevő nincs otthoni hálózaton (magáncím); nem keresek."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Caut servere în rețeaua de acasă..."
msgstr "Szerverek keresése az otthoni hálózaton..."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Am pornit căutarea."
msgstr "Elindítottam a keresést."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Am găsit un server."
msgstr "Egy szervert találtam."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Am găsit %d servere."
msgstr "%d szervert találtam."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Nu am găsit niciun server Ollama sau LibreTranslate în rețeaua %s. Ollama "
"ascultă din fabrică numai pe calculatorul lui, așa că receptorul nu-l vede "
"până nu-l pornești pentru rețea."
msgstr "Nem találtam Ollama vagy LibreTranslate szervert a(z) %s hálózaton. Az Ollama gyárilag csak a saját számítógépén figyel, ezért a vevő nem látja, amíg meg nem nyitod a hálózat felé."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Nu am găsit niciun server Ollama sau LibreTranslate. Ollama ascultă din "
"fabrică numai pe calculatorul lui, așa că receptorul nu-l vede până nu-l "
"pornești pentru rețea."
msgstr "Nem találtam Ollama vagy LibreTranslate szervert. Az Ollama gyárilag csak a saját számítógépén figyel, ezért a vevő nem látja, amíg meg nem nyitod a hálózat felé."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Căutarea s-a oprit după %d secunde."
msgstr "A keresés %d másodperc után leállt."

#
#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Tradu EPG"
msgstr "EPG fordítása"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Ce s-a tradus din EPG"
msgstr "Mi lett lefordítva az EPG-ből"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "%d texte, %d semne"
msgstr "%d szöveg, %d karakter"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Ghidul: texte traduse %d (%d semne trimise, din cota serviciului), cereri %d, deja în limba ta %d, sărite %d."
msgstr "EPG: lefordított szövegek %d (%d elküldött karakter, a szolgáltatás keretéből), kérések %d, már a nyelveden %d, kihagyva %d."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Traduceri ținute minte: %d (%s)."
msgstr "Megjegyzett fordítások: %d (%s)."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "și pe stick sau disc"
msgstr "a pendrive-on vagy a lemezen is"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "numai până la repornire; cu un stick sau un disc se păstrează"
msgstr "csak újraindításig; pendrive-val vagy lemezzel megmaradnak"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Traduce automat titlurile și descrierile emisiunilor care sunt pe ecran (bara de jos, a doua bară, ghidul, detaliile emisiunii) în limba traducerii, cu aceleași servicii și chei. Consumă din cota serviciului, de aceea din fabrică e oprită. Textul deja în limba ta nu se trimite, iar o traducere ținută minte nu se mai cere. În detaliile emisiunii, INFO arată textul original."
msgstr "Automatikusan lefordítja a képernyőn lévő műsorok címét és leírását (alsó sáv, második sáv, műsorújság, a műsor részletei) a fordítás nyelvére, ugyanazokkal a szolgáltatásokkal és kulcsokkal. A szolgáltatás keretéből fogyaszt, ezért gyárilag ki van kapcsolva. A már a nyelveden lévő szöveget nem küldi el, és a megjegyzett fordítást nem kéri újra. A műsor részleteinél az INFO az eredeti szöveget mutatja."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cu „Tradu EPG” pornită pleacă la același serviciu și titlurile și descrierile emisiunilor de pe ecran."
msgstr "Bekapcsolt „EPG fordítása” mellett a képernyőn lévő műsorok címe és leírása is ugyanahhoz a szolgáltatáshoz kerül."

#: lib/python/Screens/EventView.py lib/python/Screens/SecondInfoBar.py
msgid "Tradus automat. INFO: textul original."
msgstr "Automatikusan fordítva. INFO: az eredeti szöveg."

#: lib/python/Screens/EventView.py lib/python/Screens/SecondInfoBar.py
msgid "Textul original, netradus. INFO: închide."
msgstr "Eredeti szöveg, fordítás nélkül. INFO: bezárás."

msgid "Tradu automat din orice subtitrare disponibilă"
msgstr "Automatikus fordítás bármelyik elérhető feliratból"

msgid "Cu traducerea subtitrărilor pornită, „Tradu automat din orice subtitrare disponibilă” alege singură și o subtitrare în altă limbă, ca să fie tradusă."
msgstr "Bekapcsolt feliratfordításnál az „Automatikus fordítás bármelyik elérhető feliratból” magától egy másik nyelvű feliratot is kiválaszt, hogy le legyen fordítva."

msgid "Traducerea subtitrărilor e pornită (în %s): dacă nu există subtitrare în limba aceasta, se alege singură una în altă limbă, întâi teletextul, apoi DVB citită ca text, și se traduce."
msgstr "A feliratfordítás be van kapcsolva (célnyelv: %s): ha nincs felirat ezen a nyelven, automatikusan kiválaszt egy másik nyelvűt, előbb a teletextet, aztán a szövegként olvasott DVB-t, és lefordítja."

msgid "Traducerea subtitrărilor e pornită (în %s): se alege numai o subtitrare în limba aceasta, apoi preferințele de mai sus."
msgstr "A feliratfordítás be van kapcsolva (célnyelv: %s): csak ezen a nyelven választ feliratot, utána a fenti beállításaid szerint."

msgid "în limba traducerii"
msgstr "a fordítás nyelvén"

msgid "teletext tradus automat"
msgstr "teletext, automatikusan fordítva"

msgid "DVB citită ca text și tradusă automat"
msgstr "szövegként olvasott DVB, automatikusan fordítva"

#: lib/python/Hds/DabT2/pornire.py
msgid "Canalul nu a pornit: tunerul e inca ocupat. Alege-l din nou."
msgstr "A csatorna nem indult el: a tuner még foglalt. Válaszd ki újra."

#: lib/python/Hds/DabT2/pornire.py
#, python-format
msgid "Pornesc din nou canalul de dinainte (%s)..."
msgstr "Az előző csatorna (%s) újraindítása..."

#: lib/python/Hds/DabT2/pornire.py
#, python-format
msgid "Canalul de dinainte (%s) a pornit din nou."
msgstr "Az előző csatorna (%s) újra elindult."

#: lib/python/Hds/DabT2/pornire.py
#, python-format
msgid "Canalul de dinainte (%s) a pornit, dar nu da imagine."
msgstr "Az előző csatorna (%s) elindult, de nincs kép."

#: lib/python/Hds/DabT2/pornire.py
#, python-format
msgid "Canalul de dinainte (%s) nu a pornit: tunerul e inca ocupat. Alege-l din nou."
msgstr "Az előző csatorna (%s) nem indult el: a tuner még foglalt. Válaszd ki újra."

#: lib/python/Hds/DabT2/pornire.py
msgid "Tunerul e ocupat (inregistrare sau alt canal). Alege mai tarziu."
msgstr "A tuner foglalt (felvétel vagy másik csatorna). Válaszd később."

#: lib/python/Hds/DabT2/pornire.py
#, python-format
msgid "Nu au venit date de la %s. Tunerul a fost eliberat."
msgstr "Nem érkezett adat innen: %s. A tuner felszabadult."

#: lib/python/Hds/DabT2/scanare.py
msgid "Scanarea s-a oprit inainte de sfarsit si nu a salvat nimic. Incearca din nou."
msgstr "A keresés a vége előtt leállt, és semmit sem mentett. Próbáld újra."

#: lib/python/Hds/DabT2/scanare.py
#, python-format
msgid "Detectorul s-a oprit cu codul %s, fara un raspuns care sa se poata citi."
msgstr "Az érzékelő %s kóddal leállt, olvasható válasz nélkül."

#: lib/python/Hds/DabT2/scanare.py
msgid "Raspunsul detectorului nu s-a putut prelucra (detalii in jurnal)."
msgstr "Az érzékelő válaszát nem sikerült feldolgozni (részletek a naplóban)."

#: lib/python/Screens/ScanerSatelit.py
msgid "În lucru: scanarea salvează posturile DAB+ în lista de canale, dar ascultarea lor nu merge încă pe acest receptor."
msgstr "Fejlesztés alatt: a keresés elmenti a DAB+ adókat a csatornalistába, de a hallgatásuk ezen a vevőn még nem működik."

#: lib/python/Screens/ScanerSatelit.py
msgid "Detectorul nu a dat niciun răspuns."
msgstr "Az érzékelő nem válaszolt."

#: lib/python/Screens/ScanerSatelit.py
msgid "Ultimele rânduri de eroare ale detectorului:"
msgstr "Az érzékelő utolsó hibasorai:"

#: lib/python/Screens/ScanerSatelit.py
msgid "Începutul ieșirii care nu s-a putut citi:"
msgstr "A nem olvasható kimenet eleje:"

#: lib/python/Screens/HdsScanareFluxuri.py
msgid "Ascultarea lor nu merge încă pe acest receptor (în lucru)."
msgstr "A hallgatásuk ezen a vevőn még nem működik (fejlesztés alatt)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Adresa %s e pe internet, iar receptorul trimite pe http:// (necriptat) numai în rețeaua de acasă. Scrie adresa cu https://."
msgstr "A(z) %s cím az interneten van, a vevő pedig http:// (titkosítatlan) kapcsolaton csak az otthoni hálózatban küld. Írd a címet https:// kezdettel."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Adresa %s duce chiar la receptor. Receptorul nu are server de traducere: scrie adresa calculatorului din casă sau a serverului din internet (127.0.0.1, localhost, 0.0.0.0, 169.254.x și IP-ul receptorului nu merg)."
msgstr "A(z) %s cím magához a vevőhöz vezet. A vevőn nincs fordítószerver: írd be az otthoni számítógép vagy az internetes szerver címét (a 127.0.0.1, localhost, 0.0.0.0, 169.254.x és a vevő IP-címe nem jó)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "adresa altui aparat, nu a receptorului (127.0.0.1, localhost, 0.0.0.0, 169.254.x și IP-ul receptorului nu merg)"
msgstr "egy másik eszköz címe, nem a vevőé (a 127.0.0.1, localhost, 0.0.0.0, 169.254.x és a vevő IP-címe nem jó)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheia pleacă numai spre adresa serverului de acum: scrie întâi adresa, apoi pune cheia."
msgstr "A kulcs csak a szerver mostani címére megy: előbb írd be a címet, aztán add meg a kulcsot."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheia salvată a fost pusă pentru alt server (%s), deci nu pleacă spre adresa de acum. Dacă serverul cere cheie, pune-o din nou."
msgstr "A mentett kulcsot egy másik szerverhez (%s) adták meg, ezért nem megy a mostani címre. Ha a szerver kulcsot kér, add meg újra."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheia salvată nu e legată de adresa de acum, deci nu pleacă nicăieri. Dacă serverul cere cheie, pune-o din nou."
msgstr "A mentett kulcs nincs a mostani címhez kötve, ezért sehová nem megy. Ha a szerver kulcsot kér, add meg újra."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheia nu pleacă pe http:// spre internet. Scrie adresa cu https://."
msgstr "A kulcs nem megy http:// kapcsolaton az internetre. Írd a címet https:// kezdettel."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Atenție: cheia pleacă necriptată (http://) spre serverul din casă. Pune o cheie numai dacă serverul o cere."
msgstr "Figyelem: a kulcs titkosítatlanul (http://) megy az otthoni szerverre. Csak akkor adj meg kulcsot, ha a szerver kéri."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Scrie adresa calculatorului din casă (de exemplu http://192.168.1.50:11434) sau a serverului din internet, cu https://."
msgstr "Írd be az otthoni számítógép címét (például http://192.168.1.50:11434) vagy az internetes szerverét, https:// kezdettel."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "O cheie pleacă numai pe https:// sau spre un server din rețeaua de acasă. Scrie adresa cu https://. Cheia nu a plecat nicăieri."
msgstr "Kulcs csak https:// kapcsolaton vagy az otthoni hálózat szerverére megy. Írd a címet https:// kezdettel. A kulcs sehová nem ment el."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "pusă pentru alt server (OK o pune din nou)"
msgstr "másik szerverhez megadva (OK: újra megadás)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheile de traducere trebuie puse din nou: cele salvate înainte nu se mai pot citi pe acest receptor."
msgstr "A fordítási kulcsokat újra meg kell adni: a korábban mentetteket ez a vevő már nem tudja olvasni."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheile de traducere trebuie puse din nou: cele salvate înainte nu se mai pot citi pe acest receptor. Le pui în Meniu › Setări › Sunet și subtitrări › Traducerea subtitrărilor sau de pe telefon, cu codul QR de acolo."
msgstr "A fordítási kulcsokat újra meg kell adni: a korábban mentetteket ez a vevő már nem tudja olvasni. Itt adod meg őket: Menü › Beállítások › Hang és hangsávok › Feliratfordítás, vagy telefonról, az ott látható QR-kóddal."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "trebuie pusă din nou (OK o scrie)"
msgstr "újra meg kell adni (OK: beírás)"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Tradu bara de jos"
msgstr "Alsó sáv fordítása"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Traduce titlurile emisiunii de acum și ale celei următoare de pe bara de jos, cu aceleași servicii și chei. Merge când traducerea subtitrărilor e pornită și folosește foarte puțin din cotă: fiecare titlu se cere o singură dată. INFO de pe bară arată textul original. Cu „Tradu EPG” pornită, bara se traduce oricum."
msgstr "Lefordítja az alsó sávon a mostani és a következő műsor címét, ugyanazokkal a szolgáltatásokkal és kulcsokkal. Bekapcsolt feliratfordítás mellett működik, és nagyon keveset fogyaszt a keretből: minden címet csak egyszer kér. A sávon az INFO az eredeti szöveget mutatja. Bekapcsolt „EPG fordítása” mellett a sáv így is le van fordítva."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cu „Tradu bara de jos” pornită pleacă la același serviciu și titlurile emisiunilor de pe bara de jos."
msgstr "Bekapcsolt „Alsó sáv fordítása” mellett az alsó sávon lévő műsorok címe is ugyanahhoz a szolgáltatáshoz kerül."

#: lib/python/Screens/EventView.py
msgid "Textul original. Pe bara de jos, titlul e tradus automat."
msgstr "Eredeti szöveg. Az alsó sávon a cím automatikusan le van fordítva."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Ai schimbat setările traducerii. Le salvezi?"
msgstr "Megváltoztattad a fordítás beállításait. Mented?"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK probează"
msgstr "OK: próba"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK le deschide"
msgstr "OK: megnyitás"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK trimite o frază de probă serviciului ales. Răspunsul apare aici, iar originalul și traducerea se văd jos, ca subtitrările."
msgstr "Az OK egy próbamondatot küld a választott szolgáltatásnak. A válasz itt jelenik meg, az eredeti és a fordítás lent látszik, mint a felirat."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK deschide pașii pentru serviciul ales: contul, cheia gratuită, cota și ce se întâmplă la depășire."
msgstr "Az OK megnyitja a választott szolgáltatás lépéseit: a fiók, az ingyenes kulcs, a keret és mi történik, ha túlléped."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "lipsește (OK îl scrie)"
msgstr "hiányzik (OK: beírás)"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "fără cheie"
msgstr "kulcs nélkül"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "fără adresă"
msgstr "cím nélkül"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "fără model"
msgstr "modell nélkül"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "de completat"
msgstr "kitöltendő"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Dacă foloseai o cheie pentru acest server, pune-o din nou."
msgstr "Ha használtál kulcsot ehhez a szerverhez, add meg újra."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheie pusă"
msgstr "Kulcs megadva"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Fără cheie"
msgstr "Nincs kulcs"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheie pusă pentru alt server (%s): nu pleacă spre adresa de acum. Pune-o din nou."
msgstr "A kulcs egy másik szerverhez van megadva (%s): nem megy a mostani címre. Add meg újra."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheie pusă, dar nelegată de adresa de acum: nu pleacă nicăieri. Pune-o din nou."
msgstr "A kulcs meg van adva, de nincs a mostani címhez kötve: sehova sem megy. Add meg újra."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheie pusă, dar nu pleacă pe http:// spre internet. Scrie adresa cu https://."
msgstr "A kulcs meg van adva, de nem megy http:// kapcsolaton az internetre. Írd a címet https:// kezdettel."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "se traduce prin „Tradu EPG”"
msgstr "az „EPG fordítása” fordítja"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "pornită, dar traducerea automată e oprită"
msgstr "bekapcsolva, de az automatikus fordítás ki van kapcsolva"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "pornită, dar serviciul nu e completat"
msgstr "bekapcsolva, de a szolgáltatás nincs kitöltve"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Valoare greșită pentru: %s."
msgstr "Hibás érték: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Nu s-a trimis nicio alegere."
msgstr "Nem érkezett választás."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Adresa începe cu http:// sau https://, fără nume și parolă în ea."
msgstr "A cím http:// vagy https:// kezdetű, név és jelszó nélkül."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Nu s-a schimbat nimic."
msgstr "Semmi sem változott."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Lista rezervelor are un serviciu necunoscut."
msgstr "A tartaléklistában ismeretlen szolgáltatás van."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Un serviciu apare de două ori în lista rezervelor."
msgstr "Egy szolgáltatás kétszer szerepel a tartaléklistában."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Serviciul ales nu intră și în lista rezervelor."
msgstr "A választott szolgáltatás nem kerülhet a tartaléklistába is."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Adresa-șablon începe cu https:// (sau http:// pentru un server din rețeaua de acasă), fără spații, fără nume și parolă și fără locuri în numele serverului."
msgstr "A címsablon https:// kezdetű (vagy http:// egy otthoni hálózati szervernél), szóközök, név és jelszó, valamint a szerver nevében helyőrzők nélkül."

