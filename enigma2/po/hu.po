msgstr "A tévé bekapcsolása ébredéskor (CEC)"

#: data/setup.xml
msgid "Da: când scoți receptorul din standby (din telecomandă sau din web), se aprinde și televizorul și trece pe intrarea receptorului. Nu și când îl trezește un temporizator. Televizorul trebuie să aibă CEC pornit."
msgstr "Igen: amikor felébreszted a vevőt a készenlétből (távirányítóval vagy a webről), a tévé is bekapcsol, és a vevő bemenetére vált. Nem, ha időzítő ébreszti fel. A tévén be kell kapcsolni a CEC-et."

#: lib/python/Plugins/Extensions/HdsWebControl/standby_tv_web.py
msgid "oprită (televizorul vede „Fără semnal”)"
msgstr "kikapcsolva (a tévé „Nincs jel” üzenetet mutat)"

#: lib/python/Plugins/Extensions/HdsWebControl/standby_tv_web.py
msgid "pornită"
msgstr "bekapcsolva"

#: lib/python/Plugins/Extensions/HdsWebControl/standby_tv_web.py
msgid "pornită: în standby trimite imagine neagră (setarea e Nu)"
msgstr "bekapcsolva: készenlétben fekete képet küld (a beállítás Nem)"

#: lib/python/Plugins/Extensions/HdsWebControl/standby_tv_web.py
msgid "oprită, deși receptorul nu e în standby"
msgstr "kikapcsolva, pedig a vevő nincs készenlétben"

#: lib/python/Plugins/Extensions/HdsWebControl/standby_tv_web.py
#, python-format
msgid "Ultima oprire după aprinderea televizorului: %s."
msgstr "Utolsó kikapcsolás a tévé bekapcsolása után: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/standby_tv_web.py
msgid "oprit din setări"
msgstr "kikapcsolva a beállításokban"

#: lib/python/Plugins/Extensions/HdsWebControl/standby_tv_web.py
msgid "pornit, niciun mesaj trimis încă"
msgstr "bekapcsolva, még nem ment üzenet"

#: lib/python/Plugins/Extensions/HdsWebControl/standby_tv_web.py
#, python-format
msgid "ultimul mesaj, la %s: %s"
msgstr "utolsó üzenet, %s: %s"

#: lib/python/Plugins/Extensions/HdsWebControl/standby_tv_web.py
msgid "Televizorul nu răspunde la CEC. Pornește SIMPLINK (sau CEC) din setările televizorului."
msgstr "A tévé nem válaszol a CEC-re. Kapcsold be a SIMPLINK-et (vagy a CEC-et) a tévé beállításaiban."

#: lib/python/Plugins/Extensions/HdsWebControl/standby_tv_web.py
msgid "stinge televizorul"
msgstr "tévé kikapcsolása"

#: lib/python/Plugins/Extensions/HdsWebControl/standby_tv_web.py
msgid "receptorul nu mai e pe ecran"
msgstr "a vevő már nincs a képernyőn"

#: lib/python/Plugins/Extensions/HdsWebControl/standby_tv_web.py
msgid "aprinde televizorul"
msgstr "tévé bekapcsolása"

#: lib/python/Plugins/Extensions/HdsWebControl/standby_tv_web.py
msgid "trece pe intrarea receptorului"
msgstr "váltás a vevő bemenetére"

#: lib/python/Plugins/Extensions/HdsWebControl/standby_tv_web.py
msgid "anunță receptorul"
msgstr "a vevő bejelentése"

