#: lib/python/Screens/HdsLocul.py
msgid "Află locul după internet"
msgstr "Hely meghatározása az internet alapján"

#: lib/python/Screens/HdsLocul.py
msgid "Caut locul după adresa de internet a receptorului..."
msgstr "A hely keresése a vevő internetcíme alapján..."

#: lib/python/Screens/HdsLocul.py
msgid "Receptorul nu are internet acum, deci locul nu se poate afla singur. Alege țara și orașul din listă."
msgstr "A vevőnek most nincs internetje, így a hely nem határozható meg magától. Válassz országot és várost a listából."

#: lib/python/Screens/HdsLocul.py
msgid "Serverul HD Satelit nu a răspuns sau nu poate da locul acum. Alege țara și orașul din listă."
msgstr "A HD Satelit szervere nem válaszolt, vagy most nem tudja megadni a helyet. Válassz országot és várost a listából."

#: lib/python/Screens/HdsLocul.py
msgid "Răspunsul serverului HD Satelit nu se poate folosi. Alege țara și orașul din listă."
msgstr "A HD Satelit szerverének válasza nem használható. Válassz országot és várost a listából."

#: lib/python/Screens/HdsLocul.py
msgid "După adresa de internet a receptorului nu se știe orașul. Alege țara și orașul din listă."
msgstr "A vevő internetcíme alapján nem ismert a város. Válassz országot és várost a listából."

#: lib/python/Screens/HdsLocul.py
msgid "Locul s-a cerut de prea multe ori de la această adresă de internet. Încearcă peste un minut sau alege țara și orașul din listă."
msgstr "Erről az internetcímről túl sokszor kérték le a helyet. Próbáld újra egy perc múlva, vagy válassz országot és várost a listából."

#: lib/python/Screens/HdsLocul.py
msgid "Locul găsit nu mai este cel arătat. Caută din nou sau alege țara și orașul din listă."
msgstr "A talált hely már nem az, amelyik látszott. Keress újra, vagy válassz országot és várost a listából."

#: lib/python/Screens/HdsLocul.py
#, python-format
msgid ""
"Locul găsit după adresa de internet a receptorului:\n"
"\n"
"%(loc)s\n"
"%(coordonate)s\n"
"Sursa: %(sursa)s\n"
"\n"
"De obicei este orașul tău, dar uneori este orașul furnizorului de internet. Folosești acest loc? (Nu: alegi țara și orașul din listă.)"
msgstr ""
"A vevő internetcíme alapján talált hely:\n"
"\n"
"%(loc)s\n"
"%(coordonate)s\n"
"Forrás: %(sursa)s\n"
"\n"
"Általában ez a te városod, de néha az internetszolgáltató városa. Ezt a helyet használod? (Nem: országot és várost választasz a listából.)"

#: lib/python/Screens/HdsLocul.py
#, python-format
msgid "Coordonatele orașelor din listă: %s. Receptorul întreabă serverul HD Satelit numai când alegi „Află locul după internet”, iar serverul nu păstrează adresa de internet."
msgstr "A listában szereplő városok koordinátái: %s. A vevő csak akkor kérdezi a HD Satelit szerverét, ha a „Hely meghatározása az internet alapján” lehetőséget választod, és a szerver nem tárolja az internetcímet."

#: lib/python/Screens/HdsLocul.py
