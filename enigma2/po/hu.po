#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Actualizează rapid"
msgstr "Gyors frissítés"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Un singur clic caută actualizarea, o instalează dacă există și repornește interfața."
msgstr "Egyetlen kattintás megkeresi a frissítést, telepíti, ha van, és újraindítja a felületet."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Pornești actualizarea rapidă? Dacă există o actualizare, se instalează, apoi interfața se repornește singură."
msgstr "Elindítod a gyors frissítést? Ha van frissítés, települ, majd a felület magától újraindul."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Caut actualizarea"
msgstr "A frissítés keresése"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
#, python-format
msgid "Instalez versiunea %s"
msgstr "A(z) %s verzió telepítése"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Instalez actualizarea"
msgstr "A frissítés telepítése"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Repornesc interfața"
msgstr "A felület újraindítása"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Interfața repornește. Aștept să revină..."
msgstr "A felület újraindul. Várakozás a visszatérésére..."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
#, python-format
msgid "Actualizat la %s."
msgstr "Frissítve erre: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
#, python-format
msgid "Interfața a repornit cu versiunea %s, nu cu %s."
msgstr "A felület a(z) %s verzióval indult újra, nem a(z) %s verzióval."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Interfața nu a revenit în 4 minute. Verifică receptorul."
msgstr "A felület 4 percen belül nem tért vissza. Ellenőrizd a vevőt."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Interfața nu s-a repornit. Apasă Repornește interfața."
msgstr "A felület nem indult újra. Nyomd meg a Felület újraindítása gombot."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea rapidă este deja în lucru."
msgstr "A gyors frissítés már folyamatban van."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Interfața se repornește acum."
msgstr "A frissítés települt. A felület most újraindul."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Interfața se repornește singură după înregistrare."
msgstr "A frissítés települt. A felület a felvétel után magától újraindul."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Interfața se repornește singură după ce se termină lucrarea din fundal."
msgstr "A frissítés települt. A felület magától újraindul, amikor a háttérben futó feladat befejeződik."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Pe televizor se așteaptă un răspuns la întrebarea de repornire."
msgstr "A frissítés települt. A tévén választ vár az újraindításról szóló kérdés."

#: lib/python/Components/HdsActualizari.py
msgid "Repornirea a fost refuzată pe televizor. Actualizarea se folosește după ce repornești interfața."
msgstr "Az újraindítást elutasították a tévén. A frissítés a felület újraindítása után lép életbe."


#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Tradu teletextul"
msgstr "Teletext fordítása"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Teletextul tradus"
msgstr "Lefordított teletext"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Tradu HbbTV"
msgstr "HbbTV fordítása"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Ce s-a tradus din teletext și HbbTV"
msgstr "Amit a teletextből és a HbbTV-ből lefordított"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "%s: texte traduse %d (%d semne trimise, din cota serviciului), cereri %d, deja în limba ta %d, sărite %d."
msgstr "%s: lefordított szövegek %d (%d elküldött karakter, a szolgáltatás keretéből), kérések %d, már a nyelveden %d, kihagyva %d."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Traduce paginile de teletext pe care le deschizi (tasta TEXT) în limba traducerii, cu aceleași servicii și chei. Pagina apare întâi în original, apoi tradusă. În teletext, AUDIO arată originalul paginii, iar MENU are aceleași alegeri. Consumă din cota serviciului, de aceea din fabrică e oprită; un text tradus o dată nu se mai cere."
msgstr "Lefordítja a megnyitott teletext oldalakat (TEXT gomb) a fordítás nyelvére, ugyanazokkal a szolgáltatásokkal és kulcsokkal. Az oldal először eredetiben jelenik meg, aztán lefordítva. A teletextben az AUDIO az oldal eredetijét mutatja, a MENU-ben ugyanezek a választások vannak. A szolgáltatás keretéből fogyaszt, ezért gyárilag ki van kapcsolva; egy egyszer lefordított szöveget nem kér újra."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "În pagină: rândurile traduse iau locul celor originale, în cele 40 de coloane ale paginii, cu aceleași culori; ce nu încape se taie cu „…”. Într-un panou: pagina originală, mai mică, în stânga, și traducerea întreagă în dreapta."
msgstr "Az oldalon: a lefordított sorok az eredetiek helyére kerülnek, az oldal 40 oszlopában, ugyanazokkal a színekkel; ami nem fér el, „…” jellel levágódik. Egy panelen: az eredeti oldal kisebben balra, a teljes fordítás jobbra."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Traduce textele văzute din aplicațiile HbbTV (tasta ROȘIE), ca „Traduce pagina” din browsere: numai textele de pe ecran, nu adresele, codul sau câmpurile de scris. Pagina apare întâi în original. Consumă din cota serviciului, de aceea din fabrică e oprită. Aplicațiile deschise pe https rămân deocamdată în original."
msgstr "Lefordítja a HbbTV alkalmazások látható szövegeit (PIROS gomb), mint a böngészők „Oldal fordítása” funkciója: csak a képernyőn lévő szövegeket, nem a címeket, a kódot vagy a beviteli mezőket. Az oldal először eredetiben jelenik meg. A szolgáltatás keretéből fogyaszt, ezért gyárilag ki van kapcsolva. A https-en megnyitott alkalmazások egyelőre eredetiben maradnak."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "În pagină"
msgstr "Az oldalon"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Într-un panou"
msgstr "Egy panelen"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cu „Tradu teletextul” pornită pleacă la același serviciu și textul paginilor de teletext pe care le deschizi."
msgstr "Bekapcsolt „Teletext fordítása” mellett ugyanahhoz a szolgáltatáshoz kerül a megnyitott teletext oldalak szövege is."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cu „Tradu HbbTV” pornită pleacă la același serviciu și textele văzute ale aplicațiilor HbbTV pe care le deschizi."
msgstr "Bekapcsolt „HbbTV fordítása” mellett ugyanahhoz a szolgáltatáshoz kerülnek a megnyitott HbbTV alkalmazások látható szövegei is."

#: lib/python/Screens/HdsTeletext.py
msgid "AUDIO: traducerea"
msgstr "AUDIO: fordítás"

#: lib/python/Screens/HdsTeletext.py
msgid "AUDIO: originalul"
msgstr "AUDIO: eredeti"

#: lib/python/Screens/HdsTeletext.py
msgid "Pagina în original"
msgstr "Az oldal eredetiben"

#: lib/python/Screens/HdsTeletext.py
msgid "Se traduce pagina…"
