msgstr "Ekkor a 2D grafika működött, de a leállást nem neki tulajdonítjuk."

#: lib/python/Components/HdsTeletextCopie.py
#, python-format
msgid "Copia nu s-a reîmprospătat: în %(minute)d minute teletextul canalului nu s-a strâns tot. Pagini strânse: %(pagini)d."
msgstr "A másolat nem frissült: %(minute)d perc alatt a csatorna teletextje nem gyűlt össze teljesen. Összegyűjtött oldalak: %(pagini)d."

#: lib/python/Components/HdsTeletextCopie.py
#, python-format
msgid "Copia nu s-a reîmprospătat: în %(secunde)d de secunde canalul nu a trimis nicio pagină de teletext (fără semnal sau fără teletext)."
msgstr "A másolat nem frissült: %(secunde)d másodperc alatt a csatorna egyetlen teletextoldalt sem küldött (nincs jel vagy nincs teletext)."

#: lib/python/Components/HdsTeletextCopie.py
msgid "Copia nu s-a reîmprospătat: receptorul nu a putut trece pe canal."
