#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Limba meniului"
msgstr "A menü nyelve"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "În locul originalului"
msgstr "Az eredeti helyett"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Sub original"
