#: lib/python/Screens/HdsCalitateImagine.py
msgid "Alegi profilul pe care îl reglezi. SD, HD și 4K sunt rezoluția canalului; SDR, HDR10 și HLG sunt felul imaginii trimise la televizor."
msgstr "Kiválasztod a profilt, amelyet beállítasz. Az SD, HD és 4K a csatorna felbontása; az SDR, HDR10 és HLG a tévére küldött kép fajtája."

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Comparație"
msgstr "Összehasonlítás"

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Profilul acesta nu e al canalului de acum: îl vezi când pornești un canal %s."
msgstr "Ez a profil nem a mostani csatornáé: akkor látod, amikor elindítasz egy %s csatornát."

#: lib/python/Screens/HdsCalitateImagine.py
#, python-format
msgid "Comparația e pornită: în dreapta imaginea are reglajul „%s”, în stânga nu. Albastru o oprește."
msgstr "Az összehasonlítás be van kapcsolva: jobbra a kép „%s” beállítással látszik, balra nélküle. A kék kikapcsolja."

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Toate profilurile"
msgstr "Minden profil"

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Pui înapoi valorile din fabrică?"
msgstr "Visszaállítod a gyári értékeket?"

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Profilul"
msgstr "Profil"

#: lib/python/Screens/HdsCalitateImagine.py
#, python-format
msgid "Numai profilul %s"
msgstr "Csak a(z) %s profil"

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Automat: canalele HDR ies în HDR, celelalte în SDR. Mereu HDR10 sau HLG: și meniurile și canalele SDR ies în HDR, fără clipire la schimbarea canalului. Se aplică la tasta verde, cu o întrebare pe televizor."
msgstr "Automatikus: a HDR-csatornák HDR-ben mennek ki, a többiek SDR-ben. Mindig HDR10 vagy HLG: a menük és az SDR-csatornák is HDR-ben mennek, csatornaváltáskor villogás nélkül. A zöld gombbal lép életbe, egy kérdéssel a tévén."

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "(acum)"
msgstr "(most)"

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Din fabrică: %s."
msgstr "Gyári: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Aceleași reglaje sunt pe televizor, în %s. Luminozitatea, contrastul, saturația și nuanța schimbă și meniurile. Ce se vede cu adevărat se judecă pe televizor: capturile de ecran nu arată prelucrarea plăcii."
msgstr "Ugyanezek a beállítások a tévén vannak, itt: %s. A fényerő, a kontraszt, a telítettség és az árnyalat a menüket is megváltoztatja. Amit valóban látni, azt a tévén ítéld meg: a képernyőképek nem mutatják a lap feldolgozását."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Se citesc reglajele..."
msgstr "A beállítások olvasása..."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Reglaje"
msgstr "Beállítások"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Fără bifă, imaginea rămâne ca din fabrică."
msgstr "Pipa nélkül a kép gyári marad."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Toate profilurile la implicite"
msgstr "Minden profil alapértékre"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Automat: canalele HDR ies în HDR, celelalte în SDR. Mereu HDR10 sau HLG: și meniurile și canalele SDR ies în HDR, fără clipire la schimbarea canalului. Canalul pornește din nou și pe televizor apare o întrebare: fără răspuns în 20 de secunde revine ieșirea de dinainte."
msgstr "Automatikus: a HDR-csatornák HDR-ben mennek ki, a többiek SDR-ben. Mindig HDR10 vagy HLG: a menük és az SDR-csatornák is HDR-ben mennek, csatornaváltáskor villogás nélkül. A csatorna újraindul, és a tévén megjelenik egy kérdés: ha 20 másodpercen belül nem válaszolsz, visszaáll az előző kimenet."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Încearcă pe televizor"
msgstr "Kipróbálás a tévén"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Ce arată acum blocul de calitate al plăcii (/proc/msp/pq)."
msgstr "Amit a lap minőségi blokkja most mutat (/proc/msp/pq)."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Receptorul nu a putut citi reglajele."
msgstr "A vevő nem tudta beolvasni a beállításokat."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Receptorul acesta nu are blocul de calitate a imaginii."
msgstr "Ennek a vevőnek nincs képminőségi blokkja."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Ce schimbi se vede pe loc pe televizor."
msgstr "Amit változtatsz, azonnal látszik a tévén."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Ieșire HDR acum: %s."
msgstr "HDR-kimenet most: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Pe televizor: %s. Mai sunt %s s până revine ieșirea de dinainte."
msgstr "A tévén: %s. Még %s mp, és visszaáll az előző kimenet."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Ai schimbări nepăstrate: rămân numai după „Păstrează”."
msgstr "Vannak nem mentett változtatásaid: csak a „Megtartás” után maradnak meg."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Alege întâi o ieșire."
msgstr "Előbb válassz egy kimenetet."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Pui înapoi valorile din fabrică pentru profilul %s?"
msgstr "Visszaállítod a gyári értékeket a(z) %s profilnál?"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Pui înapoi valorile din fabrică pentru toate profilurile?"
msgstr "Visszaállítod a gyári értékeket minden profilnál?"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Păstrat. Se vede și pe televizor."
msgstr "Megtartva. A tévén is látszik."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Toate profilurile au acum valorile din fabrică."
msgstr "Most minden profil a gyári értékeken áll."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Pe televizor e deschis ecranul Calitatea imaginii. Închide-l, apoi încearcă din nou."
msgstr "A tévén nyitva van a Képminőség képernyő. Zárd be, aztán próbáld újra."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Spune și profilul (profil=hd_sdr, de exemplu)."
msgstr "Add meg a profilt is (például profil=hd_sdr)."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Se vede acum pe televizor. Apasă „Păstrează” ca să rămână."
msgstr "Most a tévén látszik. Nyomd meg a „Megtartás” gombot, hogy megmaradjon."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Alege un profil sau „toate”."
msgstr "Válassz egy profilt vagy a „toate” értéket."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Profilul %s are acum valorile din fabrică."
msgstr "A(z) %s profil most a gyári értékeken áll."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "„pornit” se alege cu 1 (da) sau 0 (nu)."
msgstr "A „pornit” értéke 1 (igen) vagy 0 (nem)."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Comparația e oprită."
msgstr "Az összehasonlítás ki van kapcsolva."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Reglajul acesta nu are comparație pe canalul de acum."
msgstr "Ennek a beállításnak nincs összehasonlítása a mostani csatornán."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Pe televizor: în dreapta cu reglajul, în stânga fără. Se oprește singură după %d de secunde."
msgstr "A tévén: jobbra a beállítással, balra nélküle. %d másodperc után magától leáll."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Profilul „%s” nu există."
msgstr "A(z) „%s” profil nem létezik."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Interfața web nu are încă legătura cu ecranul receptorului."
msgstr "A webes felület még nem kapcsolódik a vevő képernyőjéhez."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Valorile se dau ca numere între 0 și 100."
msgstr "Az értékeket 0 és 100 közötti számként add meg."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Reglajul „%s” nu e al acestui profil."
msgstr "A(z) „%s” beállítás nem ehhez a profilhoz tartozik."

