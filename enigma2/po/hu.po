#: lib/python/Plugins/Extensions/HdsWebControl/scanare_import_web.py
msgid "<a href=\"/setari-din-copie\">Setările importate</a>: starea lor și repornirea interfeței."
msgstr "<a href=\"/setari-din-copie\">Az importált beállítások</a>: állapotuk és a felület újraindítása."

#: lib/python/Plugins/Extensions/HdsWebControl/subtitrari_film_web.py
msgid "<a id=\"spreInternet\" href=\"/descarcare-subtitrari\">Caută subtitrări pe internet</a> pentru filmul acesta."
msgstr "<a id=\"spreInternet\" href=\"/descarcare-subtitrari\">Feliratok keresése az interneten</a> ehhez a filmhez."

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/accel</code>: accelerarea 2D pe placa video: dacă receptorul o are (<code>disponibila</code>), setarea pentru următoarea pornire (implicit pornită) și ce s-a hotărât la pornirea de acum"
msgstr "<code>GET /api/accel</code>: a videokártya 2D gyorsítása: megvan-e a vevőn (<code>disponibila</code>), a következő indításra szóló beállítás (alapértelmezés szerint bekapcsolva) és mi dőlt el a mostani indításkor"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-canal</code>: accesul canalului care rulează (criptat sau liber), sistemele, CAID-urile și ce decriptează modulul acum"
msgstr "<code>GET /api/acces-canal</code>: a most játszott csatorna hozzáférése (kódolt vagy szabad), a rendszerek, a CAID-ek és amit a modul éppen visszafejt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-conditionat</code>: modulele de acces condiționat pe feluri (câmpul <code>fel</code>: numele felului, așa cum îl are receptorul; întâi modulele obișnuite, apoi serverele de carduri), cel ales la pornirea receptorului, cele care rulează, procesul care lucrează și memoria lui, comanda în curs sau ultimul rezultat, dacă receptorul decriptează acum"
msgstr "<code>GET /api/acces-conditionat</code>: a feltételes hozzáférési modulok fajták szerint (a <code>fel</code> mező: a fajta neve, ahogy a vevő ismeri; először a szokásos modulok, utána a kártyaszerverek), a vevő indításakor választott, a futók, a dolgozó folyamat és a memóriája, a folyamatban lévő parancs vagy az utolsó eredmény, visszafejt-e most a vevő"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-ssh</code>: intrarea pe receptor prin SSH: felul parolei de administrator (fără parola însăși), cheile SSH (tipul, amprenta, comentariul), „Fără parolă în rețeaua locală”, stările periculoase (<code>alarme</code>), lucrarea în curs și rezultatul ultimei comenzi"
msgstr "<code>GET /api/acces-ssh</code>: belépés a vevőre SSH-n át: az adminisztrátori jelszó fajtája (magát a jelszót nem), az SSH-kulcsok (típus, ujjlenyomat, megjegyzés), „Jelszó nélkül a helyi hálózaton”, a veszélyes állapotok (<code>alarme</code>), a folyamatban lévő munka és az utolsó parancs eredménye"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, <code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, <code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/actualizari-reporneste</code>: actualizările prin pachete de pe stb.hdsatelit.com (starea, căutarea, instalarea, verificarea zilnică, repornirea interfeței după instalare)"
msgstr "<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, <code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, <code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/actualizari-reporneste</code>: a stb.hdsatelit.com csomagjain keresztüli frissítések (állapot, keresés, telepítés, napi ellenőrzés, a felület újraindítása telepítés után)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;orase=1]</code>: afișajul din față: ce arată acum (măștile celor 4 cifre și textul), lista de rotire, mesajele scurte, așteptarea, setările, minutarul și cronometrul; cu <code>grupa</code> alegerile grupei cu desenul valorii de acum, cu <code>catalog=1</code> toate alegerile (căutarea), cu <code>orase=1</code> fusurile pentru ora din alt oraș"
msgstr "<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;orase=1]</code>: az előlapi kijelző: mit mutat most (a 4 számjegy maszkjai és a szöveg), a forgatási lista, a rövid üzenetek, a várakozás, a beállítások, a visszaszámláló és a stopper; a <code>grupa</code> esetén a csoport választásai a mostani érték rajzával, <code>catalog=1</code> esetén az összes választás (a keresés), <code>orase=1</code> esetén az időzónák egy másik város idejéhez"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: tunerele, LNB-ul, semnalul canalului curent și unghiurile antenei spre fiecare satelit (numai citire)"
msgstr "<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: a tunerek, az LNB, a mostani csatorna jele és az antenna szögei az egyes műholdak felé (csak olvasás)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/calitate-imagine</code>: calitatea imaginii: „Reglajele după canal”, profilul canalului de acum, cele 9 profiluri (SD, HD, 4K x SDR, HDR10, HLG) cu reglajele lor, ieșirea HDR (alegerile primite de televizor, ce e scris acum, întrebarea în curs) și textul brut al blocului de calitate"
msgstr "<code>GET /api/calitate-imagine</code>: a képminőség: „Beállítások csatorna szerint”, a mostani csatorna profilja, a 9 profil (SD, HD, 4K x SDR, HDR10, HLG) a beállításaikkal, a HDR-kimenet (a tévé által kapott választások, ami most ki van írva, a folyamatban lévő kérdés) és a minőségblokk nyers szövege"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-acum</code>: canalul de pe televizor"
msgstr "<code>GET /api/canale-acum</code>: a tévén lévő csatorna"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-buchete?fila=tv|radio</code>: listele de ales și lista pe care stă televizorul"
msgstr "<code>GET /api/canale-buchete?fila=tv|radio</code>: a választható listák és az a lista, amelyen a tévé áll"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-epg?refs=r1,r2</code>: emisiunea de acum și cea următoare, cel mult 50 de canale"
msgstr "<code>GET /api/canale-epg?refs=r1,r2</code>: a mostani és a következő műsor, legfeljebb 50 csatornához"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,v2&amp;de_la=&amp;cate=</code>: rândurile, pe pagini de cel mult 200, cu grupele de filtre și numerele lor"
msgstr "<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,v2&amp;de_la=&amp;cate=</code>: a sorok, oldalanként legfeljebb 200, a szűrőcsoportokkal és azok számával"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: sigla canalului; la listele de canale, 503 când receptorul are prea multe cereri în lucru și 504 când nu termină în 10 s"
msgstr "<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: a csatorna logója; a csatornalistáknál 503, ha a vevőnek túl sok kérése van folyamatban, és 504, ha 10 mp alatt nem végez"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Caută setări”: meniurile și setările care au textul în nume (fără diacritice), cu drumul din meniu, valoarea de acum și pagina web"
msgstr "<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Beállítások keresése”: azok a menük és beállítások, amelyek nevében szerepel a szöveg (ékezetek nélkül), a menüútvonallal, a mostani értékkel és a weboldallal"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cautare-actualizeaza-stare</code>: cât a citit (transponderul, canalele) sau rezultatul"
msgstr "<code>GET /api/cautare-actualizeaza-stare</code>: mennyit olvasott be (a transzponder, a csatornák) vagy az eredmény"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code>: căutarea de canale, cu aceleași rânduri de filtre ca pe televizor și pistele știute ale fiecărui canal"
msgstr "<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code>: csatornakeresés, ugyanazokkal a szűrősorokkal, mint a tévén, és minden csatorna ismert sávjaival"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ceas</code>: ora receptorului, fusul orar, sursa orei (<code>auto</code>: Internet, apoi transponder; <code>ntp</code>; <code>dvb</code>), serverul NTP, alegerile lor și ultima sincronizare"
msgstr "<code>GET /api/ceas</code>: a vevő ideje, az időzóna, az idő forrása (<code>auto</code>: internet, majd transzponder; <code>ntp</code>; <code>dvb</code>), az NTP-szerver, ezek választható értékei és az utolsó szinkronizálás"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/copie-setari[?cauta=1]</code>: copia setărilor: stickurile și discurile (<code>implicit</code> = stickul de actualizare), copiile găsite (data, versiunea imaginii, acest receptor sau altul), copia automată, ultimul rezultat; niciodată conținutul copiei"
msgstr "<code>GET /api/copie-setari[?cauta=1]</code>: a beállítások másolata: a pendrive-ok és a lemezek (<code>implicit</code> = a frissítő pendrive), a talált másolatok (dátum, az image verziója, ez a vevő vagy másik), az automatikus másolat, az utolsó eredmény; soha nem a másolat tartalma"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/dabt2?fel=dab|t2</code>: fereastra „Fluxuri și setări” a DAB+ / DVB-T2 din satelit: fluxurile cu poziția, numele, numărul de posturi și starea, setările, Despre, lucrul în curs și <code>repunere</code> (canalul de dinainte, pornit din nou după „Învață posturile”: starea și mesajul)"
msgstr "<code>GET /api/dabt2?fel=dab|t2</code>: a műholdas DAB+ / DVB-T2 „Adatfolyamok és beállítások” ablaka: az adatfolyamok a pozícióval, a névvel, az adók számával és az állapottal, a beállítások, a Névjegy, a folyamatban lévő munka és a <code>repunere</code> (az előző csatorna, az „Adók megtanulása” után újra elindítva: az állapot és az üzenet)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/descarcare-subtitrari</code> și <code>POST /api/descarcare-subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, <code>-verifica</code>, <code>-conturi</code>: descărcarea subtitrărilor (numele, parolele și cheile numai în corpul cererii); pe un canal TV sau la o înregistrare și <code>-film</code> (<code>fapta=identifica|alege|titlu|local</code>: filmul din ghid, identificat în Wikidata) și <code>-potrivire</code> (<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|opreste</code>: potrivirea subtitrării pe canal)"
msgstr "<code>GET /api/descarcare-subtitrari</code> és <code>POST /api/descarcare-subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, <code>-verifica</code>, <code>-conturi</code>: feliratok letöltése (a nevek, a jelszavak és a kulcsok csak a kérés törzsében); tévécsatornán vagy felvételnél, valamint <code>-film</code> (<code>fapta=identifica|alege|titlu|local</code>: a műsorújságban szereplő film, a Wikidatában azonosítva) és <code>-potrivire</code> (<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|opreste</code>: a felirat illesztése a csatornán)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: mesajul de pe ecranul negru (de ce nu se vede imaginea) și analiza fluxului canalului"
msgstr "<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: a fekete képernyő üzenete (miért nem látszik a kép) és a csatorna adatfolyamának elemzése"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/egalizator</code>: egalizatorul posturilor de radio: pornit sau oprit, benzile, presetarea, modul de noapte, reglajele postului de acum și dacă merge la acest post; <code>POST /api/egalizator-seteaza</code>: schimbă și aplică pe loc"
msgstr "<code>GET /api/egalizator</code>: a rádióadók hangszínszabályzója: be- vagy kikapcsolva, a sávok, az előbeállítás, az éjszakai mód, a mostani adó beállításai és hogy működik-e ennél az adónál; <code>POST /api/egalizator-seteaza</code>: módosítja és azonnal alkalmazza"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/filme</code>: filmul care merge (poziția, lungimea, starea, locul ținut minte, mesajul de refuz) și setările filmelor; <code>GET /api/filme-lista</code>: filmele din dosarul listei de filme, cu locul rămas"
msgstr "<code>GET /api/filme</code>: a lejátszott film (pozíció, hossz, állapot, megjegyzett hely, az elutasítás üzenete) és a filmek beállításai; <code>GET /api/filme-lista</code>: a filmlista mappájában lévő filmek, a folytatási pozícióval"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: familiile libere de pe Google Fonts și fonturile deja descărcate"
msgstr "<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: a Google Fonts szabad betűcsaládjai és a már letöltött betűtípusok"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal-stare</code>: nivelul, calitatea, BER-ul și verdictul măsurării"
msgstr "<code>GET /api/gasire-semnal-stare</code>: a szint, a minőség, a BER és a mérés ítélete"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: transponderele unui satelit"
msgstr "<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: egy műhold transzponderei"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal</code>: tunerele, sateliții, transponderul de la care pornește măsurarea și starea ei"
msgstr "<code>GET /api/gasire-semnal</code>: a tunerek, a műholdak, a transzponder, amelyről a mérés indul, és a mérés állapota"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-emisiune?ref=&amp;id=</code>: ghidul unui canal (fără <code>ref</code>, canalul de pe televizor) și o emisiune cu descrierile"
msgstr "<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-emisiune?ref=&amp;id=</code>: egy csatorna műsorújsága (<code>ref</code> nélkül a tévén lévő csatornáé) és egy műsor a leírásokkal"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/import-surse?cauta=1</code>: copiile de canale și setări găsite pe stick-uri și pe receptor, starea căutării și a importului"
msgstr "<code>GET /api/import-surse?cauta=1</code>: a pendrive-okon és a vevőn talált csatorna- és beállításmásolatok, a keresés és az importálás állapota"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|retea|hdmi</code>: ecranele „System Information”, cu aceleași texte ca pe televizor"
msgstr "<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|retea|hdmi</code>: a „System Information” képernyők, ugyanazokkal a szövegekkel, mint a tévén"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/interfete-cam?reincarca=1</code>: modulele de acces condiționat instalate și interfețele lor web, cu numele date de fiecare modul (fără <code>reincarca</code> poate veni o căutare făcută cu câteva secunde înainte)"
msgstr "<code>GET /api/interfete-cam?reincarca=1</code>: a telepített feltételes hozzáférési modulok és a webes felületeik, az egyes modulok által megadott nevekkel (a <code>reincarca</code> nélkül néhány másodperccel korábbi keresés eredménye is jöhet)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/jurnal</code>: jurnalul de versiuni (ce s-a schimbat la fiecare actualizare)"
msgstr "<code>GET /api/jurnal</code>: a verziónapló (mi változott az egyes frissítéseknél)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: programele din imagine cu licența fiecăruia și textul unei licențe"
msgstr "<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: az image programjai az egyes licencekkel, és egy licenc szövege"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/limba-interfata</code>: limba meniurilor de acum și lista limbilor, cu numele de pe televizor"
msgstr "<code>GET /api/limba-interfata</code>: a menük mostani nyelve és a nyelvek listája, a tévén látható nevekkel"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/limbi</code>: limba sunetului și a subtitrărilor: cele 7 setări cu alegerile lor, ce se ține minte pe canalul de acum și canalele cu alegeri de mână"
msgstr "<code>GET /api/limbi</code>: a hang és a feliratok nyelve: a 7 beállítás a választható értékeivel, ami a mostani csatornán meg van jegyezve, és a kézzel választott csatornák"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/liste-implicite</code>: listele de canale gata făcute și drumurile spre scanare și import"
msgstr "<code>GET /api/liste-implicite</code>: az elkészített csatornalisták és az útvonalak a csatornakereséshez és az importáláshoz"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/lnb-stare</code>: verificarea semnalului, întrebarea și secundele rămase"
msgstr "<code>GET /api/lnb-stare</code>: a jel ellenőrzése, a kérdés és a hátralévő másodpercek"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/lnb?slot=N</code>: LNB-urile tunerului, cu valorile, alegerile și „Probă de calcul” (numai citire)"
msgstr "<code>GET /api/lnb?slot=N</code>: a tuner LNB-i az értékekkel, a választható értékekkel és a „Próbaszámítás” (csak olvasás)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/locul[?tara=RO]</code>: locul antenei pentru motorul USALS, țările și orașele unei țări (tabelul din imagine)"
msgstr "<code>GET /api/locul[?tara=RO]</code>: az antenna helye az USALS motorhoz, az országok és egy ország városai (az image táblázata)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/meniu</code>: tot meniul receptorului (tasta MENU), cu aceleași intrări ca pe televizor pentru nivelul ales"
msgstr "<code>GET /api/meniu</code>: a vevő teljes menüje (MENU gomb), ugyanazokkal a tételekkel, mint a tévén a kiválasztott szinthez"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, <code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: modul sigur (opririle interfeței, alegerile de după ele) și fișierele lui ca text"
msgstr "<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, <code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: a csökkentett mód (a felület leállásai, az utánuk következő választások) és a fájljai szövegként"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor-comenzi</code>: tunerele cu motor, sateliții și starea comenzilor"
msgstr "<code>GET /api/motor-comenzi</code>: a motoros tunerek, a műholdak és a parancsok állapota"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor-comenzi?urma=N</code>: urma comenzilor trimise motorului (ultimele N, implicit 100, cel mult 500, cele mai noi întâi): ora, comanda, unghiul, cine a cerut-o (televizorul, ecranul sau pagina motorului, Găsire semnal, reacordarea), poziția crezută de receptor; numai citire, din <code>/home/root/logs/hds-motor.log</code>"
msgstr "<code>GET /api/motor-comenzi?urma=N</code>: a motornak küldött parancsok nyoma (az utolsó N, alapértelmezés szerint 100, legfeljebb 500, a legújabbak elöl): idő, parancs, szög, ki kérte (a tévé, a motor képernyője vagy oldala, Jelkereső, újrahangolás), a vevő által feltételezett pozíció; csak olvasás, innen: <code>/home/root/logs/hds-motor.log</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor</code>: starea rotirii antenei (de unde, pana unde, poziția estimată, cât mai are de mers)"
msgstr "<code>GET /api/motor</code>: az antenna forgásának állapota (honnan, meddig, becsült pozíció, mennyi van még hátra)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;xp=&amp;yp=</code>: mouse-ul pe ecranul televizorului, ca în emulator: <code>xp</code>, <code>yp</code> = locul în procente din ecran (sau <code>x</code>, <code>y</code> în pixelii ecranului, 1920x1080); <code>clic</code> alege rândul de sub mouse, iar pe rândul ales sau cu <code>clicuri=2</code> dă OK; un buton colorat = tasta lui; <code>drag</code> (cu <code>x0p</code>, <code>y0p</code> = locul apăsării, <code>nou=1</code> la prima mișcare) și <code>dragend</code> = trasul pe bara de derulare; <code>rotita&amp;pasi=-12..12</code> = sus/jos (3 pași sau mai mulți = o pagină); <code>dreapta</code> = Meniu, <code>mijloc</code> = Ieșire. Răspunsul spune ce s-a făcut (<code>facut</code>: selectie, ok, buton, bara, derulare, tasta, nimic). Din browser, cu POST și antetul <code>X-HDS-CSRF</code>, ca <code>remotecontrol</code>"
msgstr "<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;xp=&amp;yp=</code>: az egér a tévé képernyőjén, mint az emulátorban: <code>xp</code>, <code>yp</code> = a hely a képernyő százalékában (vagy <code>x</code>, <code>y</code> a képernyő pixeleiben, 1920x1080); a <code>clic</code> kiválasztja az egér alatti sort, a már kiválasztott soron vagy a <code>clicuri=2</code> esetén pedig OK-t ad; egy színes gomb = a gombja; a <code>drag</code> (az <code>x0p</code>, <code>y0p</code> = a lenyomás helye, <code>nou=1</code> az első mozdulatnál) és a <code>dragend</code> = húzás a görgetősávon; <code>rotita&amp;pasi=-12..12</code> = fel/le (3 vagy több lépés = egy oldal); a <code>dreapta</code> = Menü, a <code>mijloc</code> = Kilépés. A válasz megmondja, mi történt (<code>facut</code>: selectie, ok, buton, bara, derulare, tasta, nimic). Böngészőből, POST-tal és az <code>X-HDS-CSRF</code> fejléccel, mint a <code>remotecontrol</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/navigator</code>: navigatorul web de pe televizor (deschis sau nu, modul, desenul, felul câmpului ales, mărirea; fără adrese), setările lui și favoritele"
msgstr "<code>GET /api/navigator</code>: a tévén lévő webböngésző (nyitva van-e, a mód, a rajz, a kiválasztott mező fajtája, a nagyítás; címek nélkül), a beállításai és a kedvencek"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ocr-limbi</code>: limbile recunoașterii textului (în imagine, descărcate, de descărcat, cu mărimea și starea fiecăreia) și locul pentru modelele noi"
msgstr "<code>GET /api/ocr-limbi</code>: a szövegfelismerés nyelvei (az image-ben, letöltve, letöltendő, mindegyik méretével és állapotával) és az új modellek helye"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/pasi-decriptare</code>: pașii decriptării canalului de pe televizor (cererea către modulul de acces, răspunsurile și timpul lor, imaginea decriptată, mesajele modulului CI), numai cu setarea Arată pașii decriptării pornită"
msgstr "<code>GET /api/pasi-decriptare</code>: a tévén lévő csatorna visszafejtésének lépései (a hozzáférési modulnak szóló kérés, a válaszok és az idejük, a visszafejtett kép, a CI-modul üzenetei), csak bekapcsolt „A dekódolás lépéseinek megjelenítése” beállításnál"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/paza-model</code>: paza de model (receptorul pentru care e făcută imaginea și amprenta acestuia); <code>GET /api/actualizare-pachete</code>: pachetele de actualizare găsite și verdictul pazei pentru fiecare"
msgstr "<code>GET /api/paza-model</code>: a modellőr (az a vevő, amelyhez az image készült, és annak ujjlenyomata); <code>GET /api/actualizare-pachete</code>: a talált frissítőcsomagok és az őr ítélete mindegyikről"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/paznic</code>: paznicul receptorului: starea, setările (<code>interfata</code>, <code>asteptare</code> în secunde), alegerile și ultimele rânduri din jurnalul lui"
msgstr "<code>GET /api/paznic</code>: a vevő őrszeme: az állapot, a beállítások (<code>interfata</code>, <code>asteptare</code> másodpercben), a választható értékek és a naplójának utolsó sorai"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/portal</code>: starea HbbTV a canalului care rulează (da, nu are, încă nu se știe), cu mesajul arătat pe televizor la tasta PORTAL"
msgstr "<code>GET /api/portal</code>: a futó csatorna HbbTV-állapota (igen, nincs, még nem tudni), a tévén a PORTAL gombnál mutatott üzenettel"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/procesor</code>: procesorul: modul de lucru, modurile care există pe receptor, frecvența setată și cea de acum, temperatura, tensiunea, procentul folosit și timpul pe fiecare treaptă"
msgstr "<code>GET /api/procesor</code>: a processzor: az üzemmód, a vevőn létező módok, a beállított és a mostani frekvencia, a hőmérséklet, a feszültség, a használt százalék és az egyes fokozatokon töltött idő"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: postul de radio care merge, cu textele ecranului radio; barele și nivelul sunetului"
msgstr "<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: a játszott rádióadó a rádióképernyő szövegeivel; az oszlopok és a hangszint"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: apasă o tastă ca de pe telecomanda receptorului (coduri de tastă Linux, de exemplu 352 pentru OK); cu <code>lung=1</code>, apăsare lungă"
msgstr "<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: megnyom egy gombot, mintha a vevő távirányítójáról lenne (Linux billentyűkódok, például 352 az OK-hoz); <code>lung=1</code> esetén hosszú nyomás"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare-stare</code>: starea căutării (procent, canale găsite, transpondere, timp rămas, rezultat)"
msgstr "<code>GET /api/scanare-stare</code>: a keresés állapota (százalék, talált csatornák, transzponderek, hátralévő idő, eredmény)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare-ultima</code>: rezultatul ultimei scanări de canale, ținut până la scanarea următoare: <code>inceput</code>, <code>sfarsit</code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, <code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, <code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, <code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, iar când se știu <code>tsid</code>, <code>onid</code>, <code>nid</code> și, la cablu, <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, <code>caid</code>, iar când operatorul trimite numerele canalelor <code>lcn</code> și <code>lcn_vizibil</code>): toate serviciile citite din SDT, vechi și noi, și <code>retele</code> (<code>nid</code>, <code>nume</code>, <code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, <code>privati</code>): rețelele din tabela NIT; câmpurile din tabela NIT (<code>nid</code>, <code>lcn</code>, <code>retele</code>) apar la căutarea în rețea și la scanarea pe cablu pe o singură frecvență; numai citire, lista de canale nu se schimbă; fără nicio scanare de la pornire, <code>result</code> false"
msgstr "<code>GET /api/scanare-ultima</code>: az utolsó csatornakeresés eredménye, a következő keresésig megőrizve: <code>inceput</code>, <code>sfarsit</code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, <code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, <code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, <code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, valamint ha ismertek, <code>tsid</code>, <code>onid</code>, <code>nid</code> és kábelen <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, <code>caid</code>, valamint ha a szolgáltató küldi a csatornaszámokat, <code>lcn</code> és <code>lcn_vizibil</code>): az SDT-ből beolvasott összes szolgáltatás, régiek és újak, továbbá <code>retele</code> (<code>nid</code>, <code>nume</code>, <code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, <code>privati</code>): a NIT táblából olvasott hálózatok; a NIT tábla mezői (<code>nid</code>, <code>lcn</code>, <code>retele</code>) hálózati keresésnél és egyetlen frekvencián végzett kábeles keresésnél jelennek meg; csak olvasás, a csatornalista nem változik; ha indítás óta nem volt keresés, a <code>result</code> false"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare</code>: secțiunile „Scanare” și „Orientarea și setarea antenei”, cu felurile de scanare, în ordinea din meniul receptorului; cu <code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</code>, câmpurile felului și ce s-ar căuta"
msgstr "<code>GET /api/scanare</code>: a „Csatornakeresés” és az „Antenna irányzása és beállítása” szakasz a keresés fajtáival, a vevő menüjének sorrendjében; a <code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</code> esetén a fajta mezői és hogy mit keresne"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;mode=all|video|osd&amp;download=1</code>: imaginea de pe ecran; <code>mode</code>: <code>all</code> cu afișajul OSD (implicit), <code>video</code> numai imaginea canalului, <code>osd</code> numai afișajul OSD; <code>download=1</code>: descărcare ca fișier, cu data și ora receptorului în nume"
msgstr "<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;mode=all|video|osd&amp;download=1</code>: a képernyő képe; <code>mode</code>: <code>all</code> az OSD-vel (alapértelmezés), <code>video</code> csak a csatorna képe, <code>osd</code> csak az OSD; <code>download=1</code>: letöltés fájlként, a vevő dátumával és idejével a névben"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/setari-din-copie</code>: setările importate: câte așteaptă repornirea interfeței (<code>asteapta</code>), proba lor (<code>garda</code>), scoase după opriri neașteptate (<code>cazut</code>), textele stării"
msgstr "<code>GET /api/setari-din-copie</code>: az importált beállítások: hány vár a felület újraindítására (<code>asteapta</code>), a próbájuk (<code>garda</code>), váratlan leállások után kivéve (<code>cazut</code>), az állapot szövegei"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/setari</code>: ecranele de setări din meniu; cu <code>id=&lt;cheie&gt;</code>, rândurile lor (aceleași ca pe televizor, cu alegerile)"
msgstr "<code>GET /api/setari</code>: a menü beállításképernyői; <code>id=&lt;cheie&gt;</code> esetén a soraik (ugyanazok, mint a tévén, a választható értékekkel)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/standby-tv</code>: ieșirea HDMI în standby (oprită sau pornită, oprirea din nou după aprinderea televizorului) și starea CEC"
msgstr "<code>GET /api/standby-tv</code>: a HDMI-kimenet készenlétben (kikapcsolva vagy bekapcsolva, újbóli kikapcsolás a tévé bekapcsolása után) és a CEC állapota"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/stare-retea</code>: legătura cu routerul și internetul (cablu sau Wi-Fi, treptele semnalului Wi-Fi, internetul merge, routerul nu are internet sau receptorul nu e conectat la router), cu desenul pictogramei și textul ei, ca pictograma din bara de pe televizor"
msgstr "<code>GET /api/stare-retea</code>: a kapcsolat a routerrel és az internettel (kábel vagy Wi-Fi, a Wi-Fi jel fokozatai, az internet működik, a routernek nincs internete, vagy a vevő nincs csatlakoztatva a routerhez), az ikon rajzával és szövegével, mint a tévén a sávban lévő ikon"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/statusinfo</code>: canalul curent, volumul, standby"
msgstr "<code>GET /api/statusinfo</code>: a mostani csatorna, a hangerő, készenlét"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/stocare</code>: locul înregistrărilor, spațiul liber și discurile conectate"
msgstr "<code>GET /api/stocare</code>: a felvételek helye, a szabad hely és a csatlakoztatott lemezek"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-aspect</code>: aspectul subtitrărilor text (fontul, grosimea, mărimea și culoarea literelor, conturul, umbra, fundalul, înălțimea, distanța dintre rânduri) și mărirea subtitrărilor DVB, cu alegerile posibile (<code>alegeri</code>), stilurile gata făcute și valorile de la început"
msgstr "<code>GET /api/subtitrari-aspect</code>: a szöveges feliratok megjelenése (a betűtípus, a betűk vastagsága, mérete és színe, a körvonal, az árnyék, a háttér, a magasság, a sortávolság) és a DVB-feliratok nagyítása, a lehetséges választásokkal (<code>alegeri</code>), az elkészített stílusokkal és a kezdeti értékekkel"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-film</code>: filmul care merge, subtitrările lui, întârzierea, codarea și cadrele pe secundă"
msgstr "<code>GET /api/subtitrari-film</code>: a lejátszott film, a feliratai, a késleltetés, a kódolás és a képkockasebesség"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-ocr</code>: contorul recunoașterii textului din subtitrările DVB (pagini citite ca text, rămase imagine și de ce, timpul mediu, ultimele pagini, viteza serviciului)"
msgstr "<code>GET /api/subtitrari-ocr</code>: a DVB-feliratok szövegfelismerésének számlálója (szövegként beolvasott oldalak, képként maradtak és miért, az átlagos idő, az utolsó oldalak, a szolgáltatás sebessége)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/sunet</code>: ieșirea sunetului (Automat / Manual), AC3 și DTS downmix, pista AC3, ce primește televizorul (EDID), ce se trimite acum și de ce, ce arată driverul pe HDMI și optic"
msgstr "<code>GET /api/sunet</code>: a hangkimenet (Automatikus / Kézi), AC3 és DTS downmix, az AC3-sáv, amit a tévé kap (EDID), ami most megy és miért, amit az illesztőprogram mutat HDMI-n és optikain"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/telecomenzi-export?format=json|csv</code>: codurile telecomenzii receptorului și ale celor asociate, pentru aplicații"
msgstr "<code>GET /api/telecomenzi-export?format=json|csv</code>: a vevő távirányítójának és a hozzárendelteknek a kódjai, alkalmazásokhoz"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/telecomenzi</code>: telecomenzile asociate, tastele lor și captura paginii (cititorul, proba, asocierea)"
msgstr "<code>GET /api/telecomenzi</code>: a hozzárendelt távirányítók, a gombjaik és az oldal rögzítése (az olvasó, a próba, a hozzárendelés)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext-copii</code> (cu <code>?canale=1</code> și canalele care au teletext): copiile de teletext salvate (canalul, data, paginile, mărimea), dosarul, spațiul folosit și cel ales, urmăritorul (caruselul canalului de acum, reîmprospătarea în lucru) și setările"
msgstr "<code>GET /api/teletext-copii</code> (a <code>?canale=1</code> esetén a teletextes csatornák is): az elmentett teletext-másolatok (a csatorna, a dátum, az oldalak, a méret), a mappa, a felhasznált és a választott hely, a követő (a mostani csatorna teletext-körforgása, a folyamatban lévő frissítés) és a beállítások"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> (fără <code>ref</code>: canalul de acum): <code>date</code> = fișierul copiei (.ttx, comprimat), <code>html</code> = o singură pagină HTML cu toate paginile, care se citește fără receptor"
msgstr "<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> (<code>ref</code> nélkül: a mostani csatorna): <code>date</code> = a másolat fájlja (.ttx, tömörítve), <code>html</code> = egyetlen HTML-oldal az összes oldallal, amely vevő nélkül is olvasható"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;ref&gt;</code>: o pagină de teletext, ca pe televizor la tasta TEXT: cele 25 de rânduri a câte 40 de celule (litera, culoarea, fundalul, mozaicul, atributele), textul paginii, subpaginile, paginile tastelor colorate, paginile vecine și pagina de pe televizor; fără <code>pagina</code>, pagina de pe televizor sau cea de pornire; <code>sub=-1</code> = cea mai nouă; <code>ascuns=1</code> arată ce e ascuns; cu <code>copie</code>, paginile din copia salvată a canalului, fără tuner (<code>sursa</code>: <code>direct</code> sau <code>copie</code>); <code>hd</code> = setarea Teletext neted, <code>optiuni</code> = conturul literelor, umbra literelor și formele în relief (<code>contur</code>, <code>umbra</code>, <code>relief</code>, ca pe televizor). Pagina lipsă: <code>gasita</code> fals și mesajul că se caută"
msgstr "<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;ref&gt;</code>: egy teletext-oldal, mint a tévén a TEXT gombnál: a 25 sor soronként 40 cellával (betű, szín, háttér, mozaik, attribútumok), az oldal szövege, az aloldalak, a színes gombok oldalai, a szomszédos oldalak és a tévén lévő oldal; a <code>pagina</code> nélkül a tévén lévő vagy a kezdőoldal; <code>sub=-1</code> = a legújabb; az <code>ascuns=1</code> megmutatja, ami el van rejtve; a <code>copie</code> esetén a csatorna elmentett másolatának oldalai, tuner nélkül (<code>sursa</code>: <code>direct</code> vagy <code>copie</code>); <code>hd</code> = a Sima teletext beállítás, <code>optiuni</code> = a betűk körvonala, a betűk árnyéka és a domború formák (<code>contur</code>, <code>umbra</code>, <code>relief</code>, mint a tévén). Hiányzó oldal: <code>gasita</code> hamis, és az üzenet, hogy keresi"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: jurnalul unei înregistrări, pe înțelesul oricui, cu mesajul tehnic; golirea lui"
msgstr "<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: egy felvétel naplója, mindenki számára érthetően, a technikai üzenettel; a napló kiürítése"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/temporizatoare</code>: înregistrările programate (aceeași ordine, stare și detalii ca pe televizor), locul înregistrărilor și spațiul liber"
msgstr "<code>GET /api/temporizatoare</code>: az ütemezett felvételek (ugyanaz a sorrend, állapot és részletek, mint a tévén), a felvételek helye és a szabad hely"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/traducere-configurare</code>: configurarea pas cu pas a traducerii: ce e pus acum (<code>acum</code>: serviciul, dacă are cheie, pornită sau nu, ultima probă, <code>chei_din_nou</code>), lucrarea configurării (<code>configurare</code>: starea, pasul, proba, modelul și modelele, mesajul și ce să faci), căutarea serverelor din casă (<code>cautare</code>: progresul și serverele găsite), instrucțiunile și pagina cheii fiecărui serviciu, regiunile Azure; niciodată o cheie"
msgstr "<code>GET /api/traducere-configurare</code>: a fordítás lépésenkénti beállítása: ami most be van állítva (<code>acum</code>: a szolgáltatás, van-e kulcsa, be van-e kapcsolva, az utolsó próba, <code>chei_din_nou</code>), a beállítás munkafolyamata (<code>configurare</code>: az állapot, a lépés, a próba, a modell és a modellek, az üzenet és mit kell tenned), az otthoni szerverek keresése (<code>cautare</code>: az előrehaladás és a talált szerverek), az utasítások és az egyes szolgáltatások kulcsának oldala, az Azure-régiók; soha nem kulcs"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/traducere-subtitrari</code>: traducerea automată a subtitrărilor text: valorile (<code>pornit</code>, <code>serviciu</code>, <code>limba</code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</code>, <code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</code>, <code>adresa_libre</code>, <code>adresa_openai</code>, <code>model_gemini</code>, <code>model_openai</code>, <code>model_groq</code>, <code>model_cloudflare</code>, <code>cont_cloudflare</code> și, pentru adresa proprie, <code>propriu_adresa</code>, <code>propriu_metoda</code>, <code>propriu_corp</code>, <code>propriu_tip_corp</code>, <code>propriu_antet</code>, <code>propriu_raspuns</code>, <code>propriu_cale</code>), alegerile posibile (<code>alegeri</code>), ce cere fiecare serviciu (<code>cere</code>), care serviciu are cheie (<code>chei</code>, niciodată cheia), dacă cheile trebuie puse din nou (<code>chei_din_nou</code>, textul notei, gol când nu e cazul), starea cheii serviciului ales, ca pe televizor (<code>cheie_fel</code> și <code>cheie_text</code>: pusă, pusă pentru alt server, lipsă), textele paginii în limba receptorului (<code>texte</code>), ce lipsește, confidențialitatea, instrucțiunile pas cu pas (cu <code>pagina_cheie</code>, adresa oficială pentru codul QR) și starea (contorul, proba, pauza după erori)"
msgstr "<code>GET /api/traducere-subtitrari</code>: a szöveges feliratok automatikus fordítása: az értékek (<code>pornit</code>, <code>serviciu</code>, <code>limba</code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</code>, <code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</code>, <code>adresa_libre</code>, <code>adresa_openai</code>, <code>model_gemini</code>, <code>model_openai</code>, <code>model_groq</code>, <code>model_cloudflare</code>, <code>cont_cloudflare</code> és a saját címhez a <code>propriu_adresa</code>, <code>propriu_metoda</code>, <code>propriu_corp</code>, <code>propriu_tip_corp</code>, <code>propriu_antet</code>, <code>propriu_raspuns</code>, <code>propriu_cale</code>), a lehetséges választások (<code>alegeri</code>), amit az egyes szolgáltatások kérnek (<code>cere</code>), melyik szolgáltatásnak van kulcsa (<code>chei</code>, soha nem a kulcs), hogy újra meg kell-e adni a kulcsokat (<code>chei_din_nou</code>, a megjegyzés szövege, üres, ha nem kell), a kiválasztott szolgáltatás kulcsának állapota, mint a tévén (<code>cheie_fel</code> és <code>cheie_text</code>: megadva, másik szerverhez megadva, hiányzik), az oldal szövegei a vevő nyelvén (<code>texte</code>), ami hiányzik, az adatvédelem, a lépésenkénti utasítások (a <code>pagina_cheie</code> esetén a QR-kód hivatalos címe) és az állapot (a számláló, a próba, a hibák utáni szünet)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: canalele de pe frecvența televizorului și din lista lui, fiecare cu merge acum sau motivul, codecul imaginii și felul sunetului; cu <code>wasm=1</code> (browserul are playerul MPEG-2) merg și canalele cu imagine MPEG-2; <code>ac3=1</code>: pagina redă sunetul AC-3, cu decodorul browserului sau cu decodorul wasm al paginii"
msgstr "<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: a tévé frekvenciáján és a tévé listájában lévő csatornák, mindegyik azzal, hogy most megy-e, vagy az okával, a kép kodekjével és a hang fajtájával; <code>wasm=1</code> esetén (a böngészőben van MPEG-2 lejátszó) az MPEG-2 képű csatornák is mennek; <code>ac3=1</code>: az oldal lejátssza az AC-3 hangot, a böngésző dekóderével vagy az oldal wasm dekóderével"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/tv-stare</code>: TV în browser: transmisiile de acum (canal, browser, de când, octeți), setările, memoria driverului video (câte canale noi se mai pot deschide până la repornire), transmisia acestui browser și motivul ultimei opriri"
msgstr "<code>GET /api/tv-stare</code>: TV a böngészőben: a mostani adások (csatorna, böngésző, mióta, bájt), a beállítások, a videóillesztőprogram memóriája (hány új csatorna nyitható még meg az újraindításig), ennek a böngészőnek az adása és az utolsó leállás oka"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/video</code>: setările video ca în Setări &gt; Video: rezoluțiile, frecvențele fiecărei rezoluții (cu <code>auto</code> = automat după canal), culorile HDMI, <code>zapmode</code> (ce se vede la schimbarea canalului) și încercarea în curs"
msgstr "<code>GET /api/video</code>: a videobeállítások, mint a Beállítások &gt; Videó alatt: a felbontások, az egyes felbontások frekvenciái (az <code>auto</code> = automatikus csatornánként), a HDMI-színek, <code>zapmode</code> (mi látszik csatornaváltáskor) és a folyamatban lévő próba"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: schimbă canalul"
msgstr "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: csatornát vált"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/accel-reporneste</code>: repornește interfața (enigma2)"
msgstr "<code>POST /api/accel-reporneste</code>: újraindítja a felületet (enigma2)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/accel-seteaza?pornita=0|1</code>: pornește sau oprește accelerarea de la următoarea pornire a interfeței (refuzat pe un receptor fără accelerarea 2D)"
msgstr "<code>POST /api/accel-seteaza?pornita=0|1</code>: bekapcsolja vagy kikapcsolja a gyorsítást a felület következő indításától (elutasítva az olyan vevőn, amelyen nincs 2D gyorsítás)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</code> ca în <code>GET /api/acces-conditionat</code>): pornește comanda prin scriptul modulului, pe rând, una singură deodată (și cu televizorul); rezultatul vine prin <code>GET /api/acces-conditionat</code>"
msgstr "<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (a <code>fel</code> ugyanaz, mint a <code>GET /api/acces-conditionat</code> esetén): elindítja a parancsot a modul szkriptjén át, sorban, egyszerre csak egyet (a tévével együtt is); az eredmény a <code>GET /api/acces-conditionat</code> útján érkezik"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-adauga</code> (corp: <code>cheie=</code>), <code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?amprenta=SHA256:..&amp;confirmat=1</code>: cheile publice lipite, cele din dosarul hdsatelit/ssh de pe stick, ștergerea unei chei"
msgstr "<code>POST /api/acces-ssh-adauga</code> (törzs: <code>cheie=</code>), <code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?amprenta=SHA256:..&amp;confirmat=1</code>: a beillesztett nyilvános kulcsok, a pendrive hdsatelit/ssh mappájában lévők, egy kulcs törlése"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</code> cere și <code>confirmat=1</code>): „Fără parolă în rețeaua locală”. Parola, textul brut și toate schimbările merg numai dintr-un browser conectat cu codul de pe televizor (altfel 403 cu <code>trebuie_cod</code>), niciodată cu <code>?token=</code>; cât ecranul „Acces SSH” e deschis pe televizor, la fel <code>/api/remotecontrol</code> și <code>/api/screenshot</code>"
msgstr "<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (a <code>pornit=1</code> a <code>confirmat=1</code> értéket is kéri): „Jelszó nélkül a helyi hálózaton”. A jelszó, a nyers szöveg és minden módosítás csak a tévén látható kóddal csatlakoztatott böngészőből megy (különben 403 a <code>trebuie_cod</code> mezővel), soha nem <code>?token=</code> használatával; amíg az „SSH-hozzáférés” képernyő nyitva van a tévén, ugyanígy a <code>/api/remotecontrol</code> és a <code>/api/screenshot</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/acces-ssh-ascunde</code>: o parolă nouă; „Am notat parola” (textul parolei se șterge de pe receptor, parola rămâne)"
msgstr "<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/acces-ssh-ascunde</code>: új jelszó; „Felírtam a jelszót” (a jelszó szövege törlődik a vevőről, a jelszó megmarad)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-parola</code>: textul parolei, cât timp nu a fost ascunsă; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: fișierele serverului SSH ca text (fără /etc/shadow)"
msgstr "<code>POST /api/acces-ssh-parola</code>: a jelszó szövege, amíg el nem lett rejtve; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: az SSH-szerver fájljai szövegként (az /etc/shadow nélkül)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: salvează și aplică pe loc (oricare dintre ele); <code>previzualizare=1&amp;lista=...</code> arată lista pe afișaj fără salvare (cel mult 2 minute fără o cerere nouă), <code>previzualizare=0</code> revine; <code>minutar=0|1..120</code> și <code>cronometru=porneste|opreste|zero</code> pornesc ceasurile afișajului pe loc; <code>functionare=ora|canal|stins</code> merge ca înainte"
msgstr "<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: elmenti és azonnal alkalmazza (bármelyiket); az <code>previzualizare=1&amp;lista=...</code> mentés nélkül megmutatja a listát a kijelzőn (új kérés nélkül legfeljebb 2 percig), a <code>previzualizare=0</code> visszaáll; a <code>minutar=0|1..120</code> és a <code>cronometru=porneste|opreste|zero</code> azonnal elindítja a kijelző óráit; a <code>functionare=ora|canal|stins</code> a régi módon működik"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</code>: salvează reglajele unui profil (multipli de 5); cu <code>incearca=1</code> se văd pe loc fără să se salveze, <code>renunta=1</code> pune înapoi ce e salvat; <code>POST /api/calitate-imagine-implicite?profil=&lt;profil&gt;|toate</code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|hdr10|hlg|none</code> (canalul pornește din nou, întrebarea apare pe televizor); <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;&amp;pornit=0|1</code> (jumătate de ecran, 60 s)"
msgstr "<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</code>: elmenti egy profil beállításait (5 többszörösei); az <code>incearca=1</code> esetén azonnal látszanak mentés nélkül, a <code>renunta=1</code> visszaállítja a mentettet; <code>POST /api/calitate-imagine-implicite?profil=&lt;profil&gt;|toate</code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|hdr10|hlg|none</code> (a csatorna újraindul, a kérdés a tévén jelenik meg); <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;&amp;pornit=0|1</code> (fél képernyő, 60 mp)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: pornește canalul prin lista de pe televizor"
msgstr "<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: elindítja a csatornát a tévén lévő listán keresztül"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: deschide pe televizor un rezultat al căutării, cu rândul găsit ales"
msgstr "<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: megnyitja a tévén a keresés egy találatát, a megtalált sor kiválasztva"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza-opreste</code>: oprește citirea și revine la canalul de dinainte"
msgstr "<code>POST /api/cautare-actualizeaza-opreste</code>: leállítja a beolvasást és visszatér az előző csatornára"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza-sari</code>: sare peste satelitul pe care e antena acum și trece la următorul (tasta GALBEN de pe televizor)"
msgstr "<code>POST /api/cautare-actualizeaza-sari</code>: átugorja azt a műholdat, amelyen az antenna most áll, és a következőre lép (a SÁRGA gomb a tévén)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: întrebarea (durata, motorul); cu <code>confirmat=1</code> pornește pe televizor citirea pistelor, transponder cu transponder"
msgstr "<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: a kérdés (az időtartam, a motor); a <code>confirmat=1</code> esetén elindítja a tévén a sávok beolvasását, transzponderenként"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: citirea pistelor în timpul vizionării (oprită, numai canalul privit, tot transponderul), aceeași setare ca pe televizor"
msgstr "<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: a sávok beolvasása nézés közben (kikapcsolva, csak a nézett csatorna, a teljes transzponder), ugyanaz a beállítás, mint a tévén"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;&amp;fus=&lt;fus orar&gt;</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>/api/ceas</code>)"
msgstr "<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;&amp;fus=&lt;fus orar&gt;</code>: módosítja és elmenti bármelyiket (a pontos értékek a <code>/api/ceas</code> alatt vannak)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ceas-sincronizeaza</code>: o sincronizare a orei prin Internet, acum"
msgstr "<code>POST /api/ceas-sincronizeaza</code>: egy időszinkronizálás az interneten át, most"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/copie-setari-pune?copie=&lt;id&gt;</code> (repornește interfața; copia se pune la loc înainte să pornească), <code>POST /api/copie-setari-sterge?copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"
msgstr "<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/copie-setari-pune?copie=&lt;id&gt;</code> (újraindítja a felületet; a másolat az indulás előtt visszakerül a helyére), <code>POST /api/copie-setari-sterge?copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|invata|sterge&amp;flux=..</code>: actualizează lista, reface buchetele, învață posturile unui flux, șterge un flux adăugat de mână"
msgstr "<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|invata|sterge&amp;flux=..</code>: frissíti a listát, újraépíti a csomagokat, megtanulja egy adatfolyam adóit, töröl egy kézzel hozzáadott adatfolyamot"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;emisfera=E|V&amp;frecventa=..&amp;...</code>: un flux adăugat de mână, cu aceleași câmpuri și limite ca „Adaugă manual”"
msgstr "<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;emisfera=E|V&amp;frecventa=..&amp;...</code>: egy kézzel hozzáadott adatfolyam, ugyanazokkal a mezőkkel és korlátokkal, mint a „Hozzáadás kézzel”"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-seteaza?cheie=tasta|dosar|latime|nedecodabile&amp;valoare=..</code>: setările ferestrei, aceleași ca pe televizor"
msgstr "<code>POST /api/dabt2-seteaza?cheie=tasta|dosar|latime|nedecodabile&amp;valoare=..</code>: az ablak beállításai, ugyanazok, mint a tévén"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-televizor?fel=dab|t2</code>: deschide fereastra pe televizor"
msgstr "<code>POST /api/dabt2-televizor?fel=dab|t2</code>: megnyitja az ablakot a tévén"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ecran-negru-fapta?fapta=&lt;id&gt;|ascunde</code>: fapta mesajului de acum, pe televizor, sau ascunderea lui"
msgstr "<code>POST /api/ecran-negru-fapta?fapta=&lt;id&gt;|ascunde</code>: a mostani üzenethez tartozó teendő a tévén, vagy az üzenet elrejtése"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ecran-sterge?sursa=galerie|propriu&amp;id=..</code>, <code>POST /api/ecran-la-loc</code>: șterge un ecran de pornire din galerie (nu cel din fabrică și nici cel pus) sau pune la loc ecranele șterse"
msgstr "<code>POST /api/ecran-sterge?sursa=galerie|propriu&amp;id=..</code>, <code>POST /api/ecran-la-loc</code>: töröl egy indítóképernyőt a galériából (nem a gyárit és nem a beállítottat), vagy visszateszi a törölt képernyőket"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/filme-comanda?fa=pauza|redare|inainte|inapoi</code>, <code>?fa=salt&amp;secunde=-60</code>, <code>?fa=la&amp;secunde=N</code>, <code>POST /api/filme-seteaza?pornire=&amp;oprire=&amp;sfarsit=</code>, <code>POST /api/filme-porneste?cale=..&amp;de_la=loc|inceput</code>: aceleași comenzi ca pe telecomandă în player și în lista de filme"
msgstr "<code>POST /api/filme-comanda?fa=pauza|redare|inainte|inapoi</code>, <code>?fa=salt&amp;secunde=-60</code>, <code>?fa=la&amp;secunde=N</code>, <code>POST /api/filme-seteaza?pornire=&amp;oprire=&amp;sfarsit=</code>, <code>POST /api/filme-porneste?cale=..&amp;de_la=loc|inceput</code>: ugyanazok a parancsok, mint a távirányítón a lejátszóban és a filmlistában"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/fonturi-descarca?familie=&lt;Familia&gt;&amp;mare=1</code>: descarcă, verifică și înregistrează un font"
msgstr "<code>POST /api/fonturi-descarca?familie=&lt;Familia&gt;&amp;mare=1</code>: letölt, ellenőriz és regisztrál egy betűtípust"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/fonturi-sterge?alias=&lt;NumeInSkin&gt;</code>: șterge un font descărcat"
msgstr "<code>POST /api/fonturi-sterge?alias=&lt;NumeInSkin&gt;</code>: töröl egy letöltött betűtípust"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/gasire-semnal-porneste</code>, <code>-reacordeaza</code>, <code>-opreste</code>: pornește, acordează din nou sau oprește măsurarea"
msgstr "<code>POST /api/gasire-semnal-porneste</code>, <code>-reacordeaza</code>, <code>-opreste</code>: elindítja, újrahangolja vagy leállítja a mérést"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ghid-temporizator?ref=&amp;id=&amp;fel=inregistrare|comutare|scoate</code>: pune sau scoate înregistrarea unei emisiuni (409 la suprapunere)"
msgstr "<code>POST /api/ghid-temporizator?ref=&amp;id=&amp;fel=inregistrare|comutare|scoate</code>: beállítja vagy eltávolítja egy műsor felvételét (409 átfedés esetén)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/import-alta-imagine?raspuns=da|nu|ascunde</code>: răspunsul la întrebarea de la prima pornire (canalele și setările din altă imagine, găsite pe stick sau disc); starea în <code>/api/import-surse</code> (<code>alta_imagine</code>)"
msgstr "<code>POST /api/import-alta-imagine?raspuns=da|nu|ascunde</code>: a válasz az első indításkori kérdésre (egy másik image csatornái és beállításai, pendrive-on vagy lemezen találva); az állapot a <code>/api/import-surse</code> alatt (<code>alta_imagine</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;temporizatoare=0&amp;generale=0</code>: pornește importul (întâi copia de siguranță)"
msgstr "<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;temporizatoare=0&amp;generale=0</code>: elindítja az importálást (először a biztonsági másolat)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: schimbă limba meniurilor și o salvează, ca OK în ecranul limbii de pe televizor"
msgstr "<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: módosítja a menük nyelvét és elmenti, mint az OK a tévén a nyelv képernyőjén"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>/api/limbi</code>; <code>tradu_orice</code> = „Tradu automat din orice subtitrare disponibilă”, contează cu traducerea subtitrărilor pornită) și le aplică pe canalul de acum"
msgstr "<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</code>: módosítja és elmenti bármelyiket (a pontos értékek a <code>/api/limbi</code> alatt vannak; <code>tradu_orice</code> = „Automatikus fordítás bármelyik elérhető feliratból”, bekapcsolt feliratfordításnál számít), és alkalmazza őket a mostani csatornán"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /api/limbi-uita-toate?confirmat=1</code>: uită alegerile de mână ale unui canal sau ale tuturor"
msgstr "<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /api/limbi-uita-toate?confirmat=1</code>: törli egy csatorna vagy az összes csatorna kézi választásait"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-aplica</code>: aplică planul văzut (<code>semn=</code>), verifică semnalul și așteaptă răspunsul 60 de secunde"
msgstr "<code>POST /api/lnb-aplica</code>: alkalmazza a látott tervet (<code>semn=</code>), ellenőrzi a jelet, és 60 másodpercig várja a választ"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-plan</code>: ce s-ar schimba pentru câmpurile trimise (<code>l_&lt;lnb&gt;_&lt;câmp&gt;</code>), sau pentru „Ce era înainte” cu <code>fel=inainte</code>; nu scrie nimic"
msgstr "<code>POST /api/lnb-plan</code>: mi változna az elküldött mezőknél (<code>l_&lt;lnb&gt;_&lt;câmp&gt;</code>), vagy az „Ami korábban volt” esetén a <code>fel=inainte</code> mellett; nem ír semmit"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code>: răspunsul la „Păstrezi noile setări?”"
msgstr "<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code>: a válasz a „Megtartod az új beállításokat?” kérdésre"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</code>: locul antenei aflat după adresa de internet a receptorului, de serverul HD Satelit, numai la cerere și numai din browserul conectat; se scrie abia după confirmare, cu <code>POST /api/locul-seteaza</code> și <code>internet=&lt;semn&gt;</code>"
msgstr "<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</code>: az antenna helye, amelyet a HD Satelit szerver a vevő internetes címe alapján állapít meg, csak kérésre és csak a csatlakoztatott böngészőből; csak megerősítés után íródik, a <code>POST /api/locul-seteaza</code> és az <code>internet=&lt;semn&gt;</code> használatával"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/locul-seteaza</code>: locul antenei din tabel (<code>tara</code>, <code>oras</code>) sau scris (<code>lat</code>, <code>lon</code>, grade, nord și est pozitive)"
msgstr "<code>POST /api/locul-seteaza</code>: az antenna helye a táblázatból (<code>tara</code>, <code>oras</code>) vagy beírva (<code>lat</code>, <code>lon</code>, fok, észak és kelet pozitív)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: deschide pe televizor ecranul unei intrări (nu oprirea sau repornirea)"
msgstr "<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: megnyitja a tévén egy tétel képernyőjét (a kikapcsolást és az újraindítást nem)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code>: pas, mișcare fără oprire, poziții memorate, mergi la satelit, limite, oprire"
msgstr "<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code>: lépés, megállás nélküli mozgás, tárolt pozíciók, menj a műholdhoz, határok, leállítás"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-inchide</code>: navigatorul pe televizor"
msgstr "<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-inchide</code>: a böngésző a tévén"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/navigator-text</code>: text trimis în câmpul ales pe televizor; numai din browserul asociat, cu textul în corpul cererii (cu <code>?token=</code> se refuză)"
msgstr "<code>POST /api/navigator-text</code>: a tévén kiválasztott mezőbe küldött szöveg; csak a hozzárendelt böngészőből, a szöveggel a kérés törzsében (a <code>?token=</code> használata esetén elutasítja)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: descarcă modelul unei limbi (pe stick sau disc; în memoria internă numai cu intern=1)"
msgstr "<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: letölti egy nyelv modelljét (pendrive-ra vagy lemezre; a belső memóriába csak intern=1 mellett)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-intreaba</code>: receptorul întreabă din nou pentru limbile cu \"Nu mai întreba\""
msgstr "<code>POST /api/ocr-limbi-intreaba</code>: a vevő újra rákérdez azoknál a nyelveknél, amelyeknél „Ennél a nyelvnél ne kérdezz többet” van beállítva"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-opreste?model=slk</code>: oprește descărcarea"
msgstr "<code>POST /api/ocr-limbi-opreste?model=slk</code>: leállítja a letöltést"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-sterge?model=slk</code>: șterge un model descărcat (sau îl scoate din listă când stickul lui nu e pus)"
msgstr "<code>POST /api/ocr-limbi-sterge?model=slk</code>: töröl egy letöltött modellt (vagy kiveszi a listából, ha a pendrive-ja nincs betéve)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</code>: repornirea interfeței când nu mai răspunde și așteptarea dinaintea ei"
msgstr "<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</code>: a felület újraindítása, ha nem válaszol, és az előtte lévő várakozás"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/procesor-seteaza?mod=automat|racoros|normal|performanta</code>: salvează modul și îl aplică pe loc"
msgstr "<code>POST /api/procesor-seteaza?mod=automat|racoros|normal|performanta</code>: elmenti a módot és azonnal alkalmazza"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=..&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</code>: setările ecranului radio"
msgstr "<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=..&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</code>: a rádióképernyő beállításai"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: vizualizarea sau culorile următoare (ca tastele galbenă și albastră pe ecranul radio)"
msgstr "<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: a következő megjelenítés vagy színek (mint a sárga és a kék gomb a rádióképernyőn)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-fluxuri</code>: alegerea de la sfârșitul scanării DAB+ / DVB-T2 de pe televizor (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"
msgstr "<code>POST /api/scanare-fluxuri</code>: a tévén a DAB+ / DVB-T2 keresés végén lévő választás (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-opreste</code>: oprește căutarea sau închide rezultatul rămas pe televizor"
msgstr "<code>POST /api/scanare-opreste</code>: leállítja a keresést, vagy bezárja a tévén maradt eredményt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;&amp;...</code>: pornește căutarea pe televizor (cu <code>confirmat=1</code> după o întrebare)"
msgstr "<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;&amp;...</code>: elindítja a keresést a tévén (a <code>confirmat=1</code> egy kérdés után)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: deschide pe televizor ecranul unei intrări din cele două secțiuni"
msgstr "<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: megnyitja a tévén egy tétel képernyőjét a két szakaszból"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/setari-din-copie-reporneste</code>: repornește interfața, ca setările importate să se unească"
msgstr "<code>POST /api/setari-din-copie-reporneste</code>: újraindítja a felületet, hogy az importált beállítások egyesüljenek"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/setari-seteaza?id=&lt;cheie&gt;&amp;r&lt;N&gt;=&lt;valoare&gt;</code>: schimbă și salvează rândurile trimise (o valoare greșită nu schimbă nimic; la o alegere multiplă, ca vitezele de derulare, alegerile despărțite prin virgulă, de pildă <code>r20=2,8,16</code>; gol = nicio alegere)"
msgstr "<code>POST /api/setari-seteaza?id=&lt;cheie&gt;&amp;r&lt;N&gt;=&lt;valoare&gt;</code>: módosítja és elmenti az elküldött sorokat (egy hibás érték semmit sem módosít; többszörös választásnál, mint a görgetési sebességek, a választások vesszővel elválasztva, például <code>r20=2,8,16</code>; üres = nincs választás)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/stocare-foloseste?punct=/media/usb</code>: folosește discul pentru înregistrări (face dosarul movie, fără formatare)"
msgstr "<code>POST /api/stocare-foloseste?punct=/media/usb</code>: a lemezt használja felvételekhez (létrehozza a movie mappát, formázás nélkül)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-aspect-implicite</code>: toate înapoi la valorile de la început"
msgstr "<code>POST /api/subtitrari-aspect-implicite</code>: minden vissza a kezdeti értékekre"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-aspect-seteaza?stil_font=&lt;skin|ingust|tiresias_info|tiresias_pc|google:Alias&gt;&amp;grosime=&lt;automata|normala|ingrosata|foarte_ingrosata&gt;&amp;marime=&lt;60..200&gt;&amp;culoare=&lt;emisiune|%23rrggbb&gt;&amp;contur=&lt;fara|subtire|normal|gros|foarte_gros&gt;&amp;culoare_contur=&lt;%23rrggbb&gt;&amp;umbra=0|1&amp;culoare_umbra=&lt;%23rrggbb&gt;&amp;directie_umbra=&lt;sus|sus_dreapta|dreapta|jos_dreapta|jos|jos_stanga|stanga|sus_stanga&gt;&amp;distanta_umbra=&lt;50|100|150|200|300&gt;&amp;umbra_moale=&lt;tare|moale|foarte_moale&gt;&amp;fundal=&lt;niciunul|rand|cutie&gt;&amp;culoare_fundal=&lt;%23rrggbb&gt;&amp;opacitate_fundal=&lt;10..100&gt;&amp;jos=&lt;2..25&gt;&amp;spatiere=&lt;80|90|100|110|125|150&gt;&amp;marire_dvb=&lt;clara|ocr&gt;</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>alegeri</code>; o valoare greșită nu schimbă nimic); sau <code>stil=&lt;cheie&gt;</code>, un stil gata făcut"
msgstr "<code>POST /api/subtitrari-aspect-seteaza?stil_font=&lt;skin|ingust|tiresias_info|tiresias_pc|google:Alias&gt;&amp;grosime=&lt;automata|normala|ingrosata|foarte_ingrosata&gt;&amp;marime=&lt;60..200&gt;&amp;culoare=&lt;emisiune|%23rrggbb&gt;&amp;contur=&lt;fara|subtire|normal|gros|foarte_gros&gt;&amp;culoare_contur=&lt;%23rrggbb&gt;&amp;umbra=0|1&amp;culoare_umbra=&lt;%23rrggbb&gt;&amp;directie_umbra=&lt;sus|sus_dreapta|dreapta|jos_dreapta|jos|jos_stanga|stanga|sus_stanga&gt;&amp;distanta_umbra=&lt;50|100|150|200|300&gt;&amp;umbra_moale=&lt;tare|moale|foarte_moale&gt;&amp;fundal=&lt;niciunul|rand|cutie&gt;&amp;culoare_fundal=&lt;%23rrggbb&gt;&amp;opacitate_fundal=&lt;10..100&gt;&amp;jos=&lt;2..25&gt;&amp;spatiere=&lt;80|90|100|110|125|150&gt;&amp;marire_dvb=&lt;clara|ocr&gt;</code>: módosítja és elmenti bármelyiket (a pontos értékek az <code>alegeri</code> alatt vannak; egy hibás érték semmit sem módosít); vagy <code>stil=&lt;cheie&gt;</code>, egy elkészített stílus"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-film-alege?id=&lt;id&gt;|oprit</code>, <code>POST /api/subtitrari-film-intarziere?ms=N</code> (sau <code>pas=</code>), <code>POST /api/subtitrari-film-codare?cod=..</code>, <code>POST /api/subtitrari-film-fps?fps=..</code>: aceleași alegeri ca tasta SUB la un film din fișier"
msgstr "<code>POST /api/subtitrari-film-alege?id=&lt;id&gt;|oprit</code>, <code>POST /api/subtitrari-film-intarziere?ms=N</code> (vagy <code>pas=</code>), <code>POST /api/subtitrari-film-codare?cod=..</code>, <code>POST /api/subtitrari-film-fps?fps=..</code>: ugyanazok a választások, mint a SUB gomb egy fájlból lejátszott filmnél"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-ocr-zero</code>: contorul recunoașterii textului pus la zero"
msgstr "<code>POST /api/subtitrari-ocr-zero</code>: a szövegfelismerés számlálója nullázva"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/sunet-seteaza?iesire=&lt;auto|manual&gt;&amp;ac3=&lt;da|nu&gt;&amp;dts=&lt;da|nu&gt;&amp;pista=&lt;da|nu&gt;</code>: oricare dintre ele, salvate; ac3 / dts sunt setările pentru Manual"
msgstr "<code>POST /api/sunet-seteaza?iesire=&lt;auto|manual&gt;&amp;ac3=&lt;da|nu&gt;&amp;dts=&lt;da|nu&gt;&amp;pista=&lt;da|nu&gt;</code>: bármelyik, elmentve; az ac3 / dts a Kézi módhoz tartozó beállítások"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-asociere?pas=inapoi|sari|gata|continua|anuleaza|proba|inchide&amp;pastreaza=0|1</code>: pașii asocierii unei telecomenzi noi"
msgstr "<code>POST /api/telecomenzi-asociere?pas=inapoi|sari|gata|continua|anuleaza|proba|inchide&amp;pastreaza=0|1</code>: egy új távirányító hozzárendelésének lépései"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|oprit</code>: pornește sau oprește captura paginii (cititorul și proba numai ascultă, cel mult 2 minute)"
msgstr "<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|oprit</code>: elindítja vagy leállítja az oldal rögzítését (az olvasó és a próba csak figyel, legfeljebb 2 percig)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-schimba?actiune=activa|neasociate|redenumeste|sterge-tasta|sterge|sterge-tot&amp;id=..&amp;cod=..&amp;nume=..&amp;confirmat=1</code>: aceleași schimbări ca în lista de pe televizor"
msgstr "<code>POST /api/telecomenzi-schimba?actiune=activa|neasociate|redenumeste|sterge-tasta|sterge|sterge-tot&amp;id=..&amp;cod=..&amp;nume=..&amp;confirmat=1</code>: ugyanazok a módosítások, mint a tévén lévő listában"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/teletext-salveaza</code>, <code>POST /api/teletext-sterge?ref=</code>, <code>POST /api/teletext-reimprospateaza?ref=</code> (receptorul trece pe canal, așteaptă o trecere completă a teletextului, face copia și se întoarce la canalul de dinainte; răspunde pe loc), <code>POST /api/teletext-setari?hd=0|1&amp;contur=0|1&amp;umbra=0|1&amp;relief=0|1&amp;copie_automata=0|1&amp;spatiu=5|10|20|50|100</code> (<code>hd</code> = Teletext neted): aceleași alegeri ca meniul teletextului de pe televizor"
msgstr "<code>POST /api/teletext-salveaza</code>, <code>POST /api/teletext-sterge?ref=</code>, <code>POST /api/teletext-reimprospateaza?ref=</code> (a vevő átkapcsol a csatornára, megvár egy teljes teletext-kört, elkészíti a másolatot, és visszatér az előző csatornára; azonnal válaszol), <code>POST /api/teletext-setari?hd=0|1&amp;contur=0|1&amp;umbra=0|1&amp;relief=0|1&amp;copie_automata=0|1&amp;spatiu=5|10|20|50|100</code> (<code>hd</code> = Sima teletext): ugyanazok a választások, mint a tévén a teletext menüjében"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-adauga?ref=&lt;canal&gt;&amp;zi=AAAA-LL-ZZ&amp;inceput=HH:MM&amp;sfarsit=HH:MM&amp;nume=..&amp;doar_comuta=0|1</code>: pune o înregistrare (sau doar schimbarea canalului); la suprapunere nu pune nimic și spune cu ce se suprapune"
msgstr "<code>POST /api/temporizatoare-adauga?ref=&lt;canal&gt;&amp;zi=AAAA-LL-ZZ&amp;inceput=HH:MM&amp;sfarsit=HH:MM&amp;nume=..&amp;doar_comuta=0|1</code>: beállít egy felvételt (vagy csak a csatornaváltást); átfedés esetén nem állít be semmit, és megmondja, mivel ütközik"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-modifica?id=..&amp;zi=..&amp;inceput=..&amp;sfarsit=..&amp;repetare=o_data|zilnic|luni_vineri|zile&amp;zile=0,1,..&amp;dupa=nimic|asteptare|oprire|automat&amp;loc=..</code>: aceleași câmpuri ca fereastra de pe televizor, cu aceeași verificare a suprapunerii; <code>POST /api/temporizatoare-opreste?id=..&amp;alegere=stoponlycurrent|stopall|stoponlycoming</code>: una repetată care merge acum"
msgstr "<code>POST /api/temporizatoare-modifica?id=..&amp;zi=..&amp;inceput=..&amp;sfarsit=..&amp;repetare=o_data|zilnic|luni_vineri|zile&amp;zile=0,1,..&amp;dupa=nimic|asteptare|oprire|automat&amp;loc=..</code>: ugyanazok a mezők, mint a tévén lévő ablakban, ugyanazzal az átfedés-ellenőrzéssel; <code>POST /api/temporizatoare-opreste?id=..&amp;alegere=stoponlycurrent|stopall|stoponlycoming</code>: egy most futó ismétlődő felvétel"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, <code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, <code>POST /api/temporizatoare-curata?confirmat=1</code>: șterge una, o oprește sau o pornește din nou, șterge cele terminate"
msgstr "<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, <code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, <code>POST /api/temporizatoare-curata?confirmat=1</code>: töröl egyet, leállítja vagy újra elindítja, törli a befejezetteket"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-cauta</code>: caută în rețeaua de acasă serverele Ollama (11434) și LibreTranslate (5000); rezultatul vine în <code>cautare</code>"
msgstr "<code>POST /api/traducere-configurare-cauta</code>: az otthoni hálózatban keresi az Ollama (11434) és a LibreTranslate (5000) szervereket; az eredmény a <code>cautare</code> mezőben érkezik"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-cheie</code>, corpul <code>cheie=&lt;cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: probează cheia pe loc și, dacă merge, o salvează și pornește traducerea; numai în corpul cererii, niciodată în adresă; rezultatul vine în <code>configurare</code> din <code>GET /api/traducere-configurare</code>"
msgstr "<code>POST /api/traducere-configurare-cheie</code>, a törzs: <code>cheie=&lt;cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: azonnal kipróbálja a kulcsot, és ha működik, elmenti és elindítja a fordítást; csak a kérés törzsében, soha nem a címben; az eredmény a <code>configurare</code> mezőben érkezik (<code>GET /api/traducere-configurare</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-model?model=..</code>: alt model pentru serviciul ales acum, cu probă"
msgstr "<code>POST /api/traducere-configurare-model?model=..</code>: másik modell a most kiválasztott szolgáltatáshoz, próbával"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;&amp;adresa=..&amp;model=..</code>: folosește serverul din casă (adresa completată de receptor, modelul ales singur dacă lipsește) și îl probează"
msgstr "<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;&amp;adresa=..&amp;model=..</code>: az otthoni szervert használja (a címet a vevő tölti ki, a modellt magától választja, ha hiányzik), és kipróbálja"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-cheie</code>, corpul <code>serviciu=&lt;cod&gt;&amp;cheie=&lt;cheia&gt;</code>: pune cheia unui serviciu (goală = o șterge); la <code>serviciu=propriu</code> cheia este valoarea antetului adresei proprii (de exemplu <code>Bearer</code> și cheia); numai în corpul cererii, niciodată în adresă; răspunsul spune doar care serviciu are cheie"
msgstr "<code>POST /api/traducere-subtitrari-cheie</code>, a törzs: <code>serviciu=&lt;cod&gt;&amp;cheie=&lt;cheia&gt;</code>: megadja egy szolgáltatás kulcsát (üres = törli); a <code>serviciu=propriu</code> esetén a kulcs a saját cím fejlécének értéke (például <code>Bearer</code> és a kulcs); csak a kérés törzsében, soha nem a címben; a válasz csak azt mondja meg, melyik szolgáltatásnak van kulcsa"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-proba</code>: probează traducerea cu serviciul ales; rezultatul vine în <code>stare.proba</code> din <code>GET /api/traducere-subtitrari</code>"
msgstr "<code>POST /api/traducere-subtitrari-proba</code>: kipróbálja a fordítást a kiválasztott szolgáltatással; az eredmény a <code>stare.proba</code> mezőben érkezik (<code>GET /api/traducere-subtitrari</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=..&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;propriu_cale=..</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>alegeri</code>); o valoare greșită refuză tot. Adresa proprie: adresa e un șablon cu <code>{text}</code>, <code>{sursa}</code>, <code>{tinta}</code> (http:// numai pentru un server din rețeaua de acasă); adresa receptorului însuși (127.0.0.1, localhost, IP-ul lui) e refuzată, și la <code>adresa_libre</code> și <code>adresa_openai</code>; calea în JSON are chei și numere despărțite prin punct, <code>*</code> = toate elementele"
msgstr "<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=..&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;propriu_cale=..</code>: módosítja és elmenti bármelyiket (a pontos értékek az <code>alegeri</code> alatt vannak); egy hibás érték mindent elutasít. Saját cím: a cím egy sablon a <code>{text}</code>, <code>{sursa}</code>, <code>{tinta}</code> helyőrzőkkel (http:// csak az otthoni hálózatban lévő szerverhez); magának a vevőnek a címe (127.0.0.1, localhost, az IP-je) el lesz utasítva, az <code>adresa_libre</code> és az <code>adresa_openai</code> esetén is; a JSON-beli útvonalban kulcsok és számok vannak ponttal elválasztva, a <code>*</code> = az összes elem"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-zero</code>: contorul traducerii pus la zero"
msgstr "<code>POST /api/traducere-subtitrari-zero</code>: a fordítás számlálója nullázva"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: fluxul TS al transmisiei acestui browser. Pornirea și fluxul merg numai din browserul conectat, cu antetul <code>X-HDS-CSRF</code>, niciodată cu <code>?token=</code>"
msgstr "<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: ennek a böngészőnek az adásának TS-adatfolyama. Az indítás és az adatfolyam csak a csatlakoztatott böngészőből megy, az <code>X-HDS-CSRF</code> fejléccel, soha nem <code>?token=</code> használatával"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-confirma</code> și <code>POST /api/video-revino</code>: păstrează modul încercat sau revine la cel de dinainte"
msgstr "<code>POST /api/video-confirma</code> és <code>POST /api/video-revino</code>: megtartja a kipróbált módot, vagy visszatér az előzőre"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-reporneste</code>: repornește receptorul (culorile „Ca la calculator” se aplică numai după o repornire); cu o înregistrare în curs, întrebarea apare pe televizor"
msgstr "<code>POST /api/video-reporneste</code>: újraindítja a vevőt (a „Mint a számítógépen” színek csak újraindítás után lépnek érvénybe); felvétel közben a kérdés a tévén jelenik meg"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=..&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;ycbcr|rgb&gt;</code>: un mod nou se încearcă (aceeași întrebare pe televizor, 20 s, fără răspuns revine); zapmode se salvează direct; culori_hdmi=ycbcr se încearcă la fel (aceeași întrebare), rgb se salvează și se aplică după o repornire"
msgstr "<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=..&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;ycbcr|rgb&gt;</code>: az új módot kipróbálja (ugyanaz a kérdés a tévén, 20 mp, válasz nélkül visszaáll); a zapmode közvetlenül mentődik; a culori_hdmi=ycbcr ugyanígy kipróbálódik (ugyanaz a kérdés), az rgb mentődik, és újraindítás után lép érvénybe"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<p class=\"gol\">Niciun font descărcat încă.</p>"
msgstr "<p class=\"gol\">Még nincs letöltött betűtípus.</p>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<p class=\"gol\">Nimic găsit.</p>"
msgstr "<p class=\"gol\">Nincs találat.</p>"

