msgstr "Az antenna megérkezett ide: %s, de még nincs jel."

msgid "Comanda nu a putut fi trimisă din cauza unei erori în receptor. Am trimis oprirea."
msgstr "A parancsot a vevő egy hibája miatt nem sikerült elküldeni. Elküldtem a leállítást."

#, python-format
msgid "Poziția %d a fost memorată în motor. Limitele sunt pornite."
msgstr "A(z) %d. pozíció eltárolva a motorban. A határok be vannak kapcsolva."

msgid "Limita de est a fost pusă aici. Limitele sunt pornite."
msgstr "A keleti határ ide került. A határok be vannak kapcsolva."

msgid "Limita de vest a fost pusă aici. Limitele sunt pornite."
msgstr "A nyugati határ ide került. A határok be vannak kapcsolva."

msgid "satelitul programului"
msgstr "a csatorna műholdja"

msgid "Limitele nu au fost oprite: receptorul nu a putut ține minte asta pe disc."
msgstr "A határok nem lettek kikapcsolva: a vevő nem tudta ezt a lemezen megjegyezni."

msgid "Pornește o înregistrare. Motorul s-a oprit și programul a revenit."
msgstr "Felvétel indul. A motor megállt, a csatorna visszajött."

#, python-format
msgid "Tunerul nu a acceptat comanda (cod %d). Am trimis oprirea."
msgstr "A tuner nem fogadta el a parancsot (kód: %d). Elküldtem a leállítást."

#, python-format
msgid "În setările tunerului, poziția %d e folosită pentru %s."
msgstr "A tuner beállításaiban a(z) %d. pozíció ehhez tartozik: %s."

msgid "Un alt tuner legat de antenă a început să lucreze. Motorul s-a oprit."
msgstr "Az antennára kötött másik tuner munkába állt. A motor megállt."

msgid "Receptorul nu are niciun tuner de satelit, deci motorul nu se poate comanda de aici."
msgstr "A vevőben nincs műholdas tuner, így a motor innen nem vezérelhető."

msgid "Niciun tuner nu e setat cu motor. Motorul se alege în Setări tuner (DiSEqC 1.2 sau USALS)."
msgstr "Egyik tuner sincs motorral beállítva. A motort a Tuner beállításokban lehet kiválasztani (DiSEqC 1.2 vagy USALS)."

