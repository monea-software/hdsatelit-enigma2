msgid "LibreTranslate la %s"
msgstr "LibreTranslate itt: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Am găsit %d. Alege serverul."
msgstr "Találat: %d. Válaszd ki a szervert."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Se probează serverul..."
msgstr "A szerver kipróbálása..."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Se caută în rețeaua de acasă... %d din %d"
msgstr "Keresés az otthoni hálózaton... %d / %d"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Fără limită, mai lent pe calculatoarele obișnuite"
msgstr "Korlát nélkül, átlagos számítógépen lassabb"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Recomandat pentru subtitrări zilnice"
msgstr "Ajánlott a mindennapi feliratokhoz"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cel mai simplu de pornit, fără card; se poate opri dacă te uiți mult"
msgstr "A legegyszerűbb elindítani, kártya nélkül; leállhat, ha sokat nézel"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Formular"
msgstr "Űrlap"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Text simplu"
msgstr "Egyszerű szöveg"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Lista serviciilor de rezervă nu e bună (un serviciu necunoscut, unul de două "
"ori sau chiar cel principal). Nu s-a schimbat nimic."
msgstr "A tartalék szolgáltatások listája nem jó (egy ismeretlen szolgáltatás, egy kétszer szerepel, vagy épp a fő szolgáltatás). Semmi sem változott."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Adresă proprie"
msgstr "Saját cím"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid "locul {text} în adresă (sau, la POST, în corp)"
msgstr "a {text} helyőrző a címben (vagy POST esetén a törzsben)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"o adresă https:// (http:// merge numai pentru un server din rețeaua de acasă)"
msgstr "egy https:// cím (a http:// csak az otthoni hálózaton lévő szervernél működik)"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"un corp JSON bun (pune locurile între ghilimele, de exemplu \"q\": "
"\"{text}\")"
msgstr "érvényes JSON-törzs (tedd idézőjelek közé a helyőrzőket, például \"q\": \"{text}\")"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "un nume de antet bun (litere, cifre și - _ ., de exemplu Authorization)"
msgstr "érvényes fejlécnév (betűk, számjegyek és - _ ., például Authorization)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"calea traducerii în răspunsul JSON (chei și numere despărțite prin punct, de "
"exemplu translatedText)"
msgstr "a fordítás útvonala a JSON-válaszban (ponttal elválasztott kulcsok és számok, például translatedText)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Lipsește regiunea resursei Azure: o găsești în portal, la resursa "
"Translator, Overview › Location (de exemplu Germany West Central = "
"germanywestcentral)."
msgstr "Hiányzik az Azure-erőforrás régiója: a portálon találod, a Translator erőforrásnál, Overview › Location (például Germany West Central = germanywestcentral)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Cheia sau regiunea nu se potrivesc: verifică amândouă în portal (Keys and "
"Endpoint)."
msgstr "A kulcs és a régió nem illik össze: ellenőrizd mindkettőt a portálon (Keys and Endpoint)."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Serverul de la adresa ta a răspuns cu eroarea HTTP %d. Începutul "
"răspunsului: „%s”"
msgstr "A címeden lévő szerver HTTP %d hibával válaszolt. A válasz eleje: „%s”"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Răspunsul serverului nu e JSON (dacă serverul dă numai traducerea, alege "
"„Text simplu” la răspuns). Începutul răspunsului: „%s”"
msgstr "A szerver válasza nem JSON (ha a szerver csak a fordítást adja, a válasznál válaszd az „Egyszerű szöveg” lehetőséget). A válasz eleje: „%s”"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Calea „%s” nu găsește nicio traducere în răspunsul serverului. Începutul "
"răspunsului: „%s”"
msgstr "A(z) „%s” útvonal nem talál fordítást a szerver válaszában. A válasz eleje: „%s”"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Serverul nu a dat nicio traducere. Începutul răspunsului: „%s”"
msgstr "A szerver nem adott fordítást. A válasz eleje: „%s”"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Traducerea subtitrărilor vine prea târziu: serverul răspunde în %s, în "
"medie. Alege un serviciu din internet (Gemini, gratuit, fără card) sau un "
"model mai mic."
msgstr "A feliratfordítás túl későn jön: a szerver átlagosan %s alatt válaszol. Válassz internetes szolgáltatást (Gemini, ingyenes, kártya nélkül) vagy kisebb modellt."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "%s a ajuns la limita gratuită pe zi (sau pe lună)."
msgstr "A(z) %s elérte a napi (vagy havi) ingyenes keretet."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Traducerea s-a oprit până se reînnoiește limita. Ca să meargă și atunci, "
"pune servicii de rezervă în Meniu › Setări › Sunet și subtitrări › "
"Traducerea subtitrărilor."
msgstr "A fordítás leállt, amíg a keret meg nem újul. Hogy akkor is működjön, állíts be tartalék szolgáltatásokat itt: Menü › Beállítások › Hang és hangsávok › Feliratfordítás."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"De exemplu Azure Translator: Free F0, 2.000.000 de caractere pe lună, "
"gratuit."
msgstr "Például Azure Translator: Free F0, havi 2 000 000 karakter, ingyen."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Traducerea subtitrărilor s-a oprit până schimbi setările: %s"
msgstr "A feliratfordítás leállt, amíg meg nem változtatod a beállításokat: %s"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Am găsit regiunea: %s (%s)."
msgstr "Megtaláltam a régiót: %s (%s)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Cel mai simplu: pornește serverul pe calculator (pașii de mai jos), apoi "
"apasă „Caută în rețeaua de acasă”, pe televizor sau pe telefon. Receptorul "
"găsește singur serverul; nu mai trebuie să scrii adresa."
msgstr "A legegyszerűbb: indítsd el a szervert a számítógépen (lásd a lenti lépéseket), majd nyomd meg a „Keresés az otthoni hálózaton” gombot a tévén vagy a telefonon. A vevő magától megtalálja a szervert; a címet már nem kell beírnod."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Prima dată, Windows poate întreba dacă lași programul să primească conexiuni "
"din rețea: apasă „Allow access”. Dacă receptorul tot nu găsește serverul: "
"Windows Security, Firewall & network protection, „Allow an app through "
"firewall”, „Change settings” și bifează programul (Ollama, LM Studio sau "
"Docker) la „Private”. Rețeaua de acasă trebuie să fie „Private network” "
"(Settings, Network & internet, rețeaua ta, „Network profile type”)."
msgstr "Első alkalommal a Windows megkérdezheti, engeded-e, hogy a program kapcsolatokat fogadjon a hálózatról: nyomd meg az „Allow access” gombot. Ha a vevő még mindig nem találja a szervert: Windows Security, Firewall & network protection, „Allow an app through firewall”, „Change settings”, és pipáld be a programot (Ollama, LM Studio vagy Docker) a „Private” oszlopban. Az otthoni hálózatnak „Private network” típusúnak kell lennie (Settings, Network & internet, a hálózatod, „Network profile type”)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"2.000.000 de caractere pe lună, gratuit (Free F0). E alegerea recomandată "
"pentru subtitrări multe (filme întregi, în fiecare zi), ca serviciu "
"principal sau de rezervă. Cardul se cere la înscriere numai pentru "
"verificare; pe Free F0 nu se plătește nimic. După 30 de zile contul trebuie "
"trecut pe „Pay as you go”, tot fără cost cât resursa rămâne Free F0."
msgstr "Havi 2 000 000 karakter, ingyen (Free F0). Ez az ajánlott választás sok felirathoz (teljes filmek, minden nap), fő vagy tartalék szolgáltatásként. Kártyát a regisztrációkor csak ellenőrzésre kérnek; a Free F0 csomagért semmit sem fizetsz. 30 nap után a fiókot át kell állítani „Pay as you go” módra, továbbra is költség nélkül, amíg az erőforrás Free F0 marad."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Pentru subtitrări multe (filme întregi, în fiecare zi) pune în setări și "
"servicii de rezervă, de exemplu Azure Translator: când Gemini dă eroarea "
"429, receptorul trece singur la următorul. Lista se face din servicii "
"diferite: limita Gemini e pe proiect, iar mai multe conturi făcute ca să "
"aduni limitele gratuite înseamnă ocolirea limitelor, pe care termenii Google "
"o interzic."
msgstr "Sok felirathoz (teljes filmek, minden nap) állíts be tartalék szolgáltatásokat is, például Azure Translator szolgáltatást: amikor a Gemini 429-es hibát ad, a vevő magától átvált a következőre. A lista különböző szolgáltatásokból áll: a Gemini korlátja projektenként érvényes, és több fiók létrehozása az ingyenes keretek összeadására a korlátok megkerülése, amit a Google feltételei tiltanak."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Gratuit pentru folosire ocazională, cu un număr limitat de cereri pe minut "
"și pe zi; Google arată cifrele numai în contul tău. La subtitrări fără pauză "
"poate da eroarea 429 după câteva minute, iar limita pe zi se poate termina."
msgstr "Ingyenes alkalmi használatra, percenként és naponta korlátozott számú kéréssel; a Google a számokat csak a fiókodban mutatja. Szünet nélküli feliratoknál néhány perc után 429-es hibát adhat, és a napi keret elfogyhat."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Peste limita pe minut, cererile primesc eroarea 429 câteva secunde: "
"receptorul așteaptă cât spune Google și trece între timp la serviciul de "
"rezervă, dacă ai pus unul. Peste limita pe zi, până a doua zi (în jurul orei "
"10, ora României). Fără card nu se plătește nimic."
msgstr "A percenkénti korlát felett a kérések néhány másodpercig 429-es hibát kapnak: a vevő annyit vár, amennyit a Google mond, és közben átvált a tartalék szolgáltatásra, ha beállítottál ilyet. A napi korlát felett másnapig (romániai idő szerint 10 óra körül). Kártya nélkül semmit sem fizetsz."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În casă: instalează Ollama de pe ollama.com pe un calculator și pornește-l."
msgstr "Otthon: telepítsd az Ollama programot az ollama.com oldalról egy számítógépre, és indítsd el."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În PowerShell scrie: ollama pull gemma3:4b (3,3 GB). gemma3:12b traduce mai "
"bine, dar e mai lent (8,1 GB); pentru un calculator slab, gemma3:1b (815 "
"MB). Modelele qwen2.5 traduc slab în română."
msgstr "A PowerShell programban írd be: ollama pull gemma3:4b (3,3 GB). A gemma3:12b jobban fordít, de lassabb (8,1 GB); gyenge számítógéphez gemma3:1b (815 MB). A qwen2.5 modellek gyengén fordítanak románra."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Ca să-l vadă receptorul: deschide Ollama, intră în Settings și pornește "
"„Expose Ollama to the network” (Ollama 0.9.5 sau mai nou; numele poate fi "
"puțin altul). Dacă nu găsești setarea: închide Ollama de lângă ceas "
"(„Quit”), caută în Start „environment variables” („variabile de mediu”), "
"adaugă la contul tău OLLAMA_HOST cu valoarea 0.0.0.0:11434, apasă OK și "
"pornește din nou Ollama."
msgstr "Hogy a vevő lássa: nyisd meg az Ollama programot, menj a Settings menübe, és kapcsold be az „Expose Ollama to the network” beállítást (Ollama 0.9.5 vagy újabb; a neve kicsit más is lehet). Ha nem találod a beállítást: zárd be az Ollama programot az óra mellett („Quit”), keress rá a Start menüben erre: „environment variables” („környezeti változók”), add hozzá a fiókodhoz az OLLAMA_HOST változót 0.0.0.0:11434 értékkel, nyomd meg az OK gombot, és indítsd el újra az Ollama programot."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Fără căutare: scrie aici adresa http://IP-UL-CALCULATORULUI:11434 și modelul "
"gemma3:4b. Cheie nu trebuie."
msgstr "Keresés nélkül: írd be ide a http://SZÁMÍTÓGÉP-IP:11434 címet és a gemma3:4b modellt. Kulcs nem kell."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"LM Studio merge la fel: fila „Developer”, „Start server”, apoi în setările "
"serverului „Serve on Local Network”, cu „Require Authentication” oprit; "
"adresa http://IP-UL-CALCULATORULUI:1234 și numele modelului din LM Studio."
msgstr "Az LM Studio ugyanígy működik: „Developer” fül, „Start server”, majd a szerver beállításaiban „Serve on Local Network”, kikapcsolt „Require Authentication” mellett; a cím http://SZÁMÍTÓGÉP-IP:1234, és a modell neve az LM Studio programból."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"„Adresă proprie” e pentru un server de traducere ales de tine, de exemplu un "
"LibreTranslate pornit pe un calculator din casă. Receptorul trimite fiecare "
"rând de subtitrare într-o cerere separată."
msgstr "A „Saját cím” egy általad választott fordítószerverhez való, például egy otthoni számítógépen futó LibreTranslate-hez. A vevő minden feliratsort külön kérésben küld el."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Adresa e un șablon: scrii adresa serverului și pui în ea locurile {text} "
"(textul de tradus), {sursa} (limba subtitrării, sau auto când nu se știe) și "
"{tinta} (limba traducerii, de exemplu ro). Receptorul le înlocuiește la "
"fiecare cerere."
msgstr "A cím egy sablon: beírod a szerver címét, és beleteszed a helyőrzőket: {text} (a fordítandó szöveg), {sursa} (a felirat nyelve, vagy auto, ha nem ismert) és {tinta} (a fordítás nyelve, például ro). A vevő minden kérésnél kicseréli őket."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Adresa începe cu https://. O adresă http:// merge numai pentru un server din "
"rețeaua de acasă (de exemplu 192.168.1.50). Nume și parolă nu se scriu în "
"adresă."
msgstr "A cím https:// előtaggal kezdődik. A http:// cím csak az otthoni hálózaton lévő szervernél működik (például 192.168.1.50). Felhasználónevet és jelszót ne írj a címbe."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Metoda GET trimite totul în adresă, deci {text} trebuie să fie în adresă. "
"Metoda POST trimite și un corp, cu aceleași locuri: JSON (pune locurile "
"între ghilimele, de exemplu \"q\": \"{text}\") sau formular (de exemplu "
"q={text}&target={tinta})."
msgstr "A GET metódus mindent a címben küld, ezért a {text} helyőrzőnek a címben kell lennie. A POST metódus törzset is küld, ugyanezekkel a helyőrzőkkel: JSON (tedd idézőjelek közé a helyőrzőket, például \"q\": \"{text}\") vagy űrlap (például q={text}&target={tinta})."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Antetul e opțional: dacă serverul cere o cheie, scrie numele antetului (de "
"exemplu Authorization) și, la valoare, ce cere serverul (de exemplu Bearer, "
"un spațiu și cheia). Valoarea se păstrează criptată pe receptor și nu se mai "
"arată."
msgstr "A fejléc nem kötelező: ha a szerver kulcsot kér, írd be a fejléc nevét (például Authorization), értéknek pedig azt, amit a szerver kér (például Bearer, egy szóköz és a kulcs). Az érték titkosítva marad a vevőn, és többé nem jelenik meg."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Răspunsul: alege „Text simplu” dacă serverul dă numai traducerea. Pentru "
"JSON scrie calea până la traducere: numele cheilor și numerele pozițiilor "
"(de la 0), despărțite prin punct, de exemplu translatedText sau "
"data.translations.0.translatedText. Cu * iei toate elementele, lipite în "
"ordine, de exemplu 0.*.0."
msgstr "A válasz: válaszd az „Egyszerű szöveg” lehetőséget, ha a szerver csak a fordítást adja. JSON esetén írd be a fordításhoz vezető útvonalat: a kulcsok nevét és a pozíciók számát (0-tól), ponttal elválasztva, például translatedText vagy data.translations.0.translatedText. A * minden elemet vesz, sorrendben összefűzve, például 0.*.0."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Exemplu, un LibreTranslate al tău din casă: adresa "
"http://192.168.1.50:5000/translate, metoda POST, corpul JSON {\"q\": "
"\"{text}\", \"source\": \"{sursa}\", \"target\": \"{tinta}\", \"format\": "
"\"text\"}, răspunsul JSON, calea translatedText."
msgstr "Példa, a saját otthoni LibreTranslate szervered: a cím http://192.168.1.50:5000/translate, a metódus POST, a JSON-törzs {\"q\": \"{text}\", \"source\": \"{sursa}\", \"target\": \"{tinta}\", \"format\": \"text\"}, a válasz JSON, az útvonal translatedText."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Exemplu cu GET: adresa "
"https://example.com/translate?q={text}&from={sursa}&to={tinta} și răspunsul "
"„Text simplu” (example.com ține locul serverului tău)."
msgstr "Példa GET metódussal: a cím https://example.com/translate?q={text}&from={sursa}&to={tinta}, a válasz „Egyszerű szöveg” (az example.com a te szervered helyén áll)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Apasă „Probează traducerea”. Dacă nu merge, mesajul arată începutul "
"răspunsului serverului, ca să vezi unde e traducerea și ce cale să scrii."
msgstr "Nyomd meg a „Fordítás kipróbálása” gombot. Ha nem működik, az üzenet megmutatja a szerver válaszának elejét, hogy lásd, hol van a fordítás, és milyen útvonalat írj be."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Depinde de server. Un server al tău din casă nu are cotă."
msgstr "A szervertől függ. Egy saját otthoni szervernek nincs kerete."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Depinde de server."
msgstr "A szervertől függ."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cum folosești o adresă proprie"
msgstr "Saját cím használata"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor, prin internet, spre serverul de la adresa scrisă de tine (%s), "
"care îl traduce."
msgstr "A feliratok szövege (csak a szöveg, kép és hang nélkül) a vevőről az interneten át arra a szerverre megy, amelynek a címét beírtad (%s), és az lefordítja."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Ollama ascultă din fabrică numai pe calculatorul lui. În Ollama 0.9.5 sau "
"mai nou: Settings, pornește „Expose Ollama to the network”."
msgstr "Gyárilag az Ollama csak a saját számítógépén figyel. Ollama 0.9.5 vagy újabb esetén: Settings, kapcsold be az „Expose Ollama to the network” beállítást."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Sau: închide Ollama de lângă ceas, pune variabila de mediu OLLAMA_HOST cu "
"valoarea 0.0.0.0:11434 și pornește din nou Ollama."
msgstr "Vagy: zárd be az Ollama programot az óra mellett, állítsd az OLLAMA_HOST környezeti változót 0.0.0.0:11434 értékre, és indítsd el újra az Ollama programot."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"LM Studio: fila „Developer”, „Start server” și „Serve on Local Network”. "
"Căutarea nu-l găsește: scrie adresa de mână (portul 1234), ca server "
"compatibil OpenAI."
msgstr "LM Studio: „Developer” fül, „Start server” és „Serve on Local Network”. A keresés nem találja meg: írd be a címet kézzel (1234-es port), OpenAI-kompatibilis szerverként."

#: lib/python/Components/HdsConfigurareTraducere.py
