msgid "Codul are 6 cifre."
msgstr "A kód 6 számjegyből áll."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Codul de pe televizor"
msgstr "A tévén látható kód"

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Codul e pe televizor."
msgstr "A kód a tévén van."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Codul nu a mers."
msgstr "A kód nem működött."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Codul nu s-a putut cere."
msgstr "A kódot nem sikerült lekérni."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Conectat."
msgstr "Csatlakoztatva."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Conectează"
msgstr "Csatlakozás"

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Conectează browserul cu codul"
msgstr "Böngésző csatlakoztatása a kóddal"

#: lib/python/Components/HdsAccesSsh.py
msgid "Contul root nu are parolă, deci nu se intră cu parolă, numai cu o cheie. Alege „Fă o parolă”."
msgstr "A root fióknak nincs jelszava, így csak kulccsal lehet belépni. Válaszd a „Jelszó létrehozása” lehetőséget."

#: lib/python/Components/HdsAccesSsh.py
msgid "Contul root nu are parolă. Alege „Fă o parolă”."
msgstr "A root fióknak nincs jelszava. Válaszd a „Jelszó létrehozása” lehetőséget."

#: lib/python/Components/HdsAccesSsh.py
msgid "Contul root nu are parolă: se intră numai cu o cheie. Dacă vrei și parolă, alege „Fă o parolă”."
msgstr "A root fióknak nincs jelszava: csak kulccsal lehet belépni. Ha jelszót is szeretnél, válaszd a „Jelszó létrehozása” lehetőséget."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Cu cheia pentru scripturi pagina arată numai starea. Parola și cheile se văd și se schimbă numai dintr-un browser conectat cu codul de pe televizor."
