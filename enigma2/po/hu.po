msgstr "Váltás balra, jobbra vagy OK gombbal."

#: lib/python/Screens/HdsCopieSetari.py
msgid "Numai acest loc e găsit."
msgstr "Csak ez a hely található."

#: lib/python/Screens/HdsCopieSetari.py
msgid "Pune la loc"
msgstr "Visszatétel"

#: lib/python/Screens/HdsCopieSetari.py
msgid "Bagă un stick sau un disc și alege „Caută din nou”."
msgstr "Dugj be egy pendrive-ot vagy lemezt, és válaszd a „Keresés újra” lehetőséget."

#: lib/python/Screens/HdsCopieSetari.py
msgid "niciun stick sau disc"
