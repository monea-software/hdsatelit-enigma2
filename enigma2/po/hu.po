msgstr "Ez a csatorna nem rögzíthető."

#: lib/python/Components/HdsInregistrariProgramate.py
msgid "Înregistrarea programelor DVB-T2 din satelit nu e încă posibilă."
msgstr "A műholdról jövő DVB-T2 műsorok rögzítése még nem lehetséges."

#: lib/python/Components/HdsInregistrariProgramate.py
msgid "Înregistrarea posturilor DAB+ din satelit nu e încă posibilă."
msgstr "A műholdról jövő DAB+ adók rögzítése még nem lehetséges."

#: lib/python/Screens/TimerEntry.py
msgid "Alege alt canal din listă."
msgstr "Válassz másik csatornát a listából."

#: lib/python/Components/HdsActualizari.py
msgid "Trebuie pusă imaginea nouă de la zero, din „Imagine nouă de pe stick”. Instalată din meniu peste imaginea de acum, actualizarea poate face receptorul instabil, de aceea aici nu se instalează."
msgstr "Az új image-et az alapoktól kell telepíteni, az „Új image pendrive-ról” menüpontból. A menüből a mostani image-re telepítve a frissítés instabillá teheti a vevőt, ezért itt nem települ."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizările nu au fost căutate încă."
msgstr "Még nem történt frissítéskeresés."

#: lib/python/Components/HdsActualizari.py
msgid "Software-ul este la zi."
msgstr "A szoftver naprakész."

#: lib/python/Components/HdsActualizari.py
msgid "Este disponibilă o actualizare."
msgstr "Elérhető egy frissítés."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea nu se poate instala din meniu."
msgstr "A frissítés nem telepíthető a menüből."

#: lib/python/Components/HdsActualizari.py
msgid "Receptorul nu este conectat la internet acum, deci actualizările nu se pot căuta."
msgstr "A vevő most nem csatlakozik az internetre, ezért nem lehet frissítést keresni."

#: lib/python/Components/HdsActualizari.py
msgid "Serverul de actualizări (stb.hdsatelit.com) nu a răspuns."
msgstr "A frissítési szerver (stb.hdsatelit.com) nem válaszolt."

#: lib/python/Components/HdsActualizari.py
msgid "Imaginea de pe receptor nu are sursa actualizărilor."
msgstr "A vevőn lévő image-ben nincs frissítési forrás."

#: lib/python/Components/HdsActualizari.py
msgid "Canalul de probă cere parola receptorului, care lipsește sau nu mai este bună."
msgstr "A tesztcsatorna a vevő jelszavát kéri, amely hiányzik vagy már nem érvényes."

#: lib/python/Components/HdsActualizari.py
msgid "Căutarea actualizărilor nu a reușit."
msgstr "A frissítések keresése nem sikerült."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizările de pe server sunt pentru altă imagine decât cea de pe receptor."
msgstr "A szerveren lévő frissítések más image-hez valók, mint ami a vevőn van."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea cere o imagine mai nouă decât cea de pe receptor."
msgstr "A frissítéshez újabb image kell, mint ami a vevőn van."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea schimbă nucleul Linux."
msgstr "A frissítés lecseréli a Linux-kernelt."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea schimbă driverele receptorului."
msgstr "A frissítés lecseréli a vevő illesztőprogramjait."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea cere biblioteci de bază pe care imaginea de acum nu le are."
msgstr "A frissítéshez olyan alapkönyvtárak kellenek, amelyek a mostani image-ben nincsenek."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea are prea multe pachete pentru o instalare din meniu."
msgstr "A frissítésben túl sok csomag van a menüből való telepítéshez."

#: lib/python/Components/HdsActualizari.py
msgid "Pentru această actualizare trebuie pusă imaginea nouă."
msgstr "Ehhez a frissítéshez az új image-et kell telepíteni."

#: lib/python/Components/HdsActualizari.py
msgid "Nu mai este loc în memoria receptorului."
msgstr "A vevő memóriájában nincs több hely."

#: lib/python/Components/HdsActualizari.py
msgid "Alt program instalează pachete acum."
msgstr "Egy másik program éppen csomagokat telepít."

#: lib/python/Components/HdsActualizari.py
msgid "Un pachet nu se mai află pe server."
msgstr "Egy csomag már nincs a szerveren."

#: lib/python/Components/HdsActualizari.py
msgid "Un pachet nu este făcut pentru acest receptor."
msgstr "Egy csomag nem ehhez a vevőhöz készült."

#: lib/python/Components/HdsActualizari.py
msgid "Un fișier descărcat nu se potrivește cu suma din lista serverului."
msgstr "Egy letöltött fájl nem egyezik a szerver listájában lévő ellenőrzőösszeggel."

#: lib/python/Components/HdsActualizari.py
msgid "Un fișier nu s-a putut descărca de pe server."
msgstr "Egy fájlt nem sikerült letölteni a szerverről."

#: lib/python/Components/HdsActualizari.py
msgid "Un pachet ar scrie peste fișierele altui pachet."
msgstr "Egy csomag felülírná egy másik csomag fájljait."

#: lib/python/Components/HdsActualizari.py
msgid "Un fișier descărcat nu se poate citi."
msgstr "Egy letöltött fájl nem olvasható."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Repornește interfața înainte de altceva."
msgstr "A frissítés települt. Mielőtt bármi mást csinálnál, indítsd újra a felületet."

#: lib/python/Components/HdsActualizari.py
msgid "Așteaptă să se termine operația de acum."
msgstr "Várd meg, amíg a mostani művelet befejeződik."

#: lib/python/Components/HdsActualizari.py
msgid "Alt program instalează sau descarcă pachete acum. Încearcă după ce termină."
msgstr "Egy másik program éppen csomagokat telepít vagy tölt le. Próbáld újra, ha végzett."

#: lib/python/Components/HdsActualizari.py
msgid "Instalarea pachetelor nu este disponibilă în această imagine."
msgstr "Ebben az image-ben a csomagtelepítés nem érhető el."

#: lib/python/Components/HdsActualizari.py
msgid "Se citește starea actualizărilor de pe server..."
msgstr "A frissítések állapotának olvasása a szerverről..."

#: lib/python/Components/HdsActualizari.py
msgid "Se descarcă lista pachetelor (opkg update)..."
msgstr "A csomaglista letöltése (opkg update)..."

#: lib/python/Components/HdsActualizari.py
msgid "Se compară pachetele..."
msgstr "A csomagok összehasonlítása..."

#: lib/python/Components/HdsActualizari.py
msgid "Nu este nimic de instalat sau actualizarea nu se poate instala din meniu."
msgstr "Nincs mit telepíteni, vagy a frissítés nem telepíthető a menüből."

#: lib/python/Components/HdsActualizari.py
msgid "Starea s-a schimbat între timp. Caută din nou."
msgstr "Az állapot közben megváltozott. Keress újra."

#: lib/python/Components/HdsActualizari.py
msgid "Un nume de pachet nu este valid. Nu se instalează."
msgstr "Egy csomagnév nem érvényes. Nem települ semmi."

#: lib/python/Components/HdsActualizari.py
msgid "Se pregătește instalarea..."
msgstr "A telepítés előkészítése..."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizare software: pentru noutățile HD Satelit trebuie pusă imaginea nouă de la zero. Detalii în Actualizare software."
msgstr "Szoftverfrissítés: a HD Satelit újdonságaihoz az új image-et az alapoktól kell telepíteni. Részletek a Szoftverfrissítés menüpontban."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Interfața trebuie repornită ca să o folosească."
