msgstr "A szerver (%s) kulcsot kér. Írd be a szerver kulcsát, vagy indítsd el a szervert kulcs nélkül."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "adresa scrisă"
msgstr "a megadott cím"

#: lib/python/Components/HdsConfigurareTraducere.py
