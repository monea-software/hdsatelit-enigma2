msgid "Câte copii automate rămân pe stick; cele făcute de mână nu se șterg singure."
msgstr "Hány automatikus másolat marad a pendrive-on; a kézzel készültek nem törlődnek maguktól."

#: lib/python/Screens/HdsCopieSetari.py
msgid "OK: ce faci cu copia. GALBEN: pune la loc. ALBASTRU: șterge."
msgstr "OK: mit teszel a másolattal. SÁRGA: visszatétel. KÉK: törlés."

#: lib/python/Screens/HdsCopieSetari.py
msgid "OK: copia nu se mai pune la loc."
msgstr "OK: a másolat már nem kerül vissza."

#: lib/python/Screens/HdsCopieSetari.py
msgid "Fă copia acum"
msgstr "Másolat készítése most"

#: lib/python/Screens/HdsCopieSetari.py
msgid "Locul copiei"
msgstr "A másolat helye"

#: lib/python/Screens/HdsCopieSetari.py
msgid "Copie automată"
msgstr "Automatikus másolat"

#: lib/python/Screens/HdsCopieSetari.py
