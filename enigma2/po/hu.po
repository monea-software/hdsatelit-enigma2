#: lib/python/Components/HdsConfigurareTraducere.py
msgid "%s nu dă modelul ales (nu există sau cere planul plătit). Alege alt model din listă; cel din fabrică e %s."
msgstr "A(z) %s nem adja a választott modellt (nem létezik, vagy fizetős csomagot kér). Válassz másik modellt a listából; a gyári: %s."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "%s spune că nu mai e credit în cont (HTTP 402)."
msgstr "A(z) %s szerint nincs több egyenleg a fiókban (HTTP 402)."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "32 de litere și cifre, din panoul Cloudflare, la Account ID."
msgstr "32 betű és számjegy, a Cloudflare irányítópultjáról, az Account ID résznél."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Apasă „Create API Key”, scrie un nume și copiază cheia (începe cu gsk_); Groq o arată o singură dată."
msgstr "Nyomd meg a „Create API Key” gombot, írj be egy nevet, és másold ki a kulcsot (gsk_ kezdetű); a Groq csak egyszer mutatja."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Apasă „Create a Workers AI API Token”, apoi „Create API Token” și „Copy API Token”. Păstrează jetonul."
msgstr "Nyomd meg a „Create a Workers AI API Token” gombot, aztán a „Create API Token” és a „Copy API Token” gombot. Őrizd meg a tokent."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Apasă „Create a Workers AI API Token”, apoi „Create API Token” și „Copy API Token”; copiază și „Account ID”, de la „Get Account ID”."
msgstr "Nyomd meg a „Create a Workers AI API Token”, aztán a „Create API Token” és a „Copy API Token” gombot; másold ki az „Account ID” értéket is a „Get Account ID” résznél."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Calculatorul trebuie să fie pornit când vrei traducere. Calitatea e mai slabă decât la serviciile de pe internet, dar nu costă nimic și nimic nu iese din casă."
msgstr "A számítógépnek bekapcsolva kell lennie, amikor fordítást szeretnél. A minőség gyengébb, mint az interneten lévő szolgáltatásoknál, de semmibe sem kerül, és semmi sem hagyja el a házat."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheia apare în portal; o poți verifica la „Test your API Key”. Aici scrie adresa https://libretranslate.com și lipește cheia."
msgstr "A kulcs megjelenik a portálon; a „Test your API Key” résznél ellenőrizheted. Ide írd be a https://libretranslate.com címet, és illeszd be a kulcsot."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Cheia o faci cu emailul sau cu contul tău Google. Pune și o rezervă pentru zilele cu multe subtitrări."
msgstr "A kulcsot e-maillel vagy a Google-fiókoddal készíted. Állíts be tartalékot is a sok feliratos napokra."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cloudflare Workers"
msgstr "Cloudflare Workers"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cloudflare Workers nu dă modelul ales din acest cont (HTTP %d): modelul cere planul plătit sau nu există. Alege alt model, de exemplu %s."
msgstr "A Cloudflare Workers ebben a fiókban nem adja a választott modellt (HTTP %d): a modell fizetős csomagot kér, vagy nem létezik. Válassz másik modellt, például ezt: %s."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cont nou (planul „Developer”): 1.000.000 de caractere în total, o singură dată, nu în fiecare lună. Cheile vechi (se termină cu :fx) merg în continuare."
msgstr "Új fiók („Developer” csomag): összesen 1 000 000 karakter, csak egyszer, nem havonta. A régi kulcsok (:fx a végük) továbbra is működnek."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cum folosești LibreTranslate"
msgstr "Így használod a LibreTranslate-et"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Când s-au terminat, Cloudflare răspunde cu eroarea 429 până a doua zi: receptorul trece la serviciul de rezervă, dacă ai pus unul. Pe planul gratuit nu se plătește nimic."
msgstr "Ha elfogytak, a Cloudflare másnapig 429-es hibával válaszol: a vevő átvált a tartalék szolgáltatásra, ha beállítottál ilyet. Az ingyenes csomagban semmit sem fizetsz."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Din panoul Cloudflare iei un jeton și ID-ul contului."
msgstr "A Cloudflare irányítópultjáról veszel egy tokent és a fiókazonosítót."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Gratuit și rapid; limită pe zi, ajunge pentru câteva filme"
msgstr "Ingyenes és gyors; napi korlát, néhány filmre elég"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Gratuit: 10.000 de unități („neuroni”) pe zi, care ajung pentru câteva filme pe zi. Se reînnoiesc în fiecare zi la 00:00 UTC (ora 3 vara și ora 2 iarna, ora României)."
msgstr "Ingyenes: napi 10 000 egység („neuron”), ami naponta néhány filmre elég. Minden nap 00:00 UTC-kor újulnak meg (romániai idő szerint nyáron 3, télen 2 órakor)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Gratuit: 30 de cereri pe minut, 1.000 pe zi și 200.000 de bucăți de text („tokeni”) pe zi; ajung pentru circa două filme pe zi. Cifrele le poate schimba Groq: le vezi în contul tău, la „Limits”."
msgstr "Ingyenes: percenként 30 kérés, naponta 1000, és naponta 200 000 szövegdarab („token”); ez naponta körülbelül két filmre elég. A számokat a Groq megváltoztathatja: a fiókodban látod őket, a „Limits” résznél."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Gratuit; ajunge pentru câteva filme pe zi"
msgstr "Ingyenes; naponta néhány filmre elég"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Groq"
msgstr "Groq"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "ID-ul contului Cloudflare"
msgstr "Cloudflare-fiókazonosító"

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "ID-ul contului Cloudflare are 32 de litere și cifre (de la „Account ID”). Cheia nu a plecat nicăieri."
msgstr "A Cloudflare-fiókazonosító 32 betűből és számjegyből áll (az „Account ID” résznél). A kulcs nem ment el sehová."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Intră pe console.groq.com și înscrie-te cu emailul sau cu contul tău Google."
msgstr "Lépj a console.groq.com oldalra, és regisztrálj e-maillel vagy a Google-fiókoddal."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Intră pe dash.cloudflare.com și fă un cont gratuit (email și parolă)."
msgstr "Lépj a dash.cloudflare.com oldalra, és készíts ingyenes fiókot (e-mail és jelszó)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Intră pe www.deepl.com/en/pro#api (prețurile DeepL) și alege fila „API”, nu „Translator”."
msgstr "Lépj a www.deepl.com/en/pro#api oldalra (a DeepL árai), és válaszd az „API” fület, ne a „Translator” fület."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "La planul gratuit „Developer” apasă „Sign up for free”."
msgstr "Az ingyenes „Developer” csomagnál nyomd meg a „Sign up for free” gombot."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Mistral: adresa https://api.mistral.ai/v1, modelul mistral-small-2603 și cheia din contul tău Mistral, la „API keys”; limitele planului gratuit le vezi în cont."
msgstr "Mistral: a cím https://api.mistral.ai/v1, a modell mistral-small-2603, a kulcs pedig a Mistral-fiókodból, az „API keys” résznél; az ingyenes csomag korlátait a fiókban látod."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Modelul Cloudflare Workers"
msgstr "Cloudflare Workers-modell"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Modelul Groq"
msgstr "Groq-modell"

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Modelul se schimbă numai la Gemini, Groq, Cloudflare Workers și la serverele compatibile OpenAI."
msgstr "A modell csak a Gemini, a Groq, a Cloudflare Workers és az OpenAI-kompatibilis szerverek esetén változtatható."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Nu adăuga card la cont, ca să rămâi pe planul gratuit."
msgstr "Ne adj kártyát a fiókhoz, hogy az ingyenes csomagon maradj."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Nu scrie niciodată o parolă sau o cheie în adresă: pune-o la antet. Cheia LibreTranslate de pe internet pleacă în corpul cererii, deci pentru ea alege serviciul LibreTranslate, nu adresa proprie."
msgstr "Soha ne írj jelszót vagy kulcsot a címbe: tedd a fejlécbe. Az interneten lévő LibreTranslate kulcsa a kérés törzsében megy, ezért ahhoz a LibreTranslate szolgáltatást válaszd, ne a „Saját cím” lehetőséget."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Nu trece contul pe planul plătit („Workers Paid”), ca să rămâi pe gratuit."
msgstr "Ne állítsd át a fiókot a fizetős csomagra („Workers Paid”), hogy ingyenes maradj."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK deschide tastatura. ID-ul contului are 32 de litere și cifre: în panoul Cloudflare, la „Account ID”."
msgstr "Az OK megnyitja a billentyűzetet. A fiókazonosító 32 betűből és számjegyből áll: a Cloudflare irányítópultján, az „Account ID” résznél."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK: alegi modelul din listă (sau îl scrii). Cel din fabrică: %s."
msgstr "OK: a modellt a listából választod (vagy beírod). A gyári: %s."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "OpenRouter: adresa https://openrouter.ai/api/v1, un model cu :free la sfârșit (de exemplu google/gemma-4-31b-it:free) și cheia din contul tău OpenRouter. Gratuit sunt numai 50 de cereri pe zi, prea puțin pentru un film."
msgstr "OpenRouter: a cím https://openrouter.ai/api/v1, egy :free végű modell (például google/gemma-4-31b-it:free), és a kulcs az OpenRouter-fiókodból. Ingyen csak napi 50 kérés jár, ez egy filmhez is kevés."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pe aceeași pagină, la „Get Account ID”, copiază „Account ID” (ID-ul contului, 32 de litere și cifre)."
msgstr "Ugyanezen az oldalon, a „Get Account ID” résznél másold ki az „Account ID” értéket (a fiókazonosító, 32 betű és számjegy)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pe calculatorul din casă: fără limită, gratuit; viteza depinde de calculator (pentru cele 7 limbi din comandă, cam 2 GB de memorie liberă). Pe libretranslate.com: Pro, traduceri nelimitate, cu rafale de până la 80 de cereri pe minut; Business, până la 200 pe minut. Varianta de pe internet nu e gratuită."
msgstr "Az otthoni számítógépen: korlát nélkül, ingyen; a sebesség a számítógéptől függ (a parancsban lévő 7 nyelvhez kb. 2 GB szabad memória kell). A libretranslate.com oldalon: Pro, korlátlan fordítás, rohamokban percenként legfeljebb 80 kéréssel; Business, percenként legfeljebb 200. Az internetes változat nem ingyenes."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pe internet, cu cheie: orice serviciu compatibil OpenAI merge; scrii adresa, modelul și cheia lui. Groq și Cloudflare Workers au locul lor în lista serviciilor, cu pașii lor: alege-le acolo."
msgstr "Az interneten, kulccsal: bármely OpenAI-kompatibilis szolgáltatás működik; beírod a címét, a modellt és a kulcsát. A Groq és a Cloudflare Workers saját helyet kapott a szolgáltatások listájában, saját lépésekkel: ott válaszd ki őket."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pe internet, cu plată: intră pe portal.libretranslate.com și apasă „Get API Key”. Alege planul (Pro: 29 de dolari pe lună; Business: 58 de dolari pe lună), apasă „BUY” și plătește. Nu există probă gratuită și nici cheie gratuită; ai 7 zile să ceri banii înapoi."
msgstr "Az interneten, fizetősen: lépj a portal.libretranslate.com oldalra, és nyomd meg a „Get API Key” gombot. Válaszd ki a csomagot (Pro: havi 29 dollár; Business: havi 58 dollár), nyomd meg a „BUY” gombot, és fizess. Ingyenes próba és ingyenes kulcs nincs; 7 napod van visszakérni a pénzt."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Pe pagina deschisă intră cu emailul sau cu contul tău Google."
msgstr "A megnyitott oldalon lépj be e-maillel vagy a Google-fiókoddal."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Pe pagina deschisă intră în contul Cloudflare (sau fă unul gratuit): se deschide pagina „Workers AI”. Apasă „Use REST API”."
msgstr "A megnyitott oldalon lépj be a Cloudflare-fiókba (vagy készíts egy ingyeneset): megnyílik a „Workers AI” oldal. Nyomd meg a „Use REST API” gombot."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Pe pagina deschisă intră în contul DeepL API. Dacă nu ai unul, fă-l gratuit, cu planul „Developer” (1.000.000 de caractere, o singură dată)."
msgstr "A megnyitott oldalon lépj be a DeepL API-fiókba. Ha nincs ilyened, készítsd el ingyen, a „Developer” csomaggal (1 000 000 karakter, csak egyszer)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Pentru Cloudflare Workers scrie și ID-ul contului (32 de litere și cifre, de la „Account ID”). Cheia nu a plecat nicăieri."
msgstr "A Cloudflare Workers esetén írd be a fiókazonosítót is (32 betű és számjegy, az „Account ID” résznél). A kulcs nem ment el sehová."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pentru subtitrări multe pune în setări și servicii de rezervă, de exemplu Azure Translator: când Groq dă eroarea 429, receptorul trece singur la următorul."
msgstr "Sok felirathoz állíts be tartalék szolgáltatásokat is a beállításokban, például az Azure Translatort: amikor a Groq 429-es hibát ad, a vevő magától átvált a következőre."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Peste limită Groq răspunde cu eroarea 429: receptorul așteaptă cât spune Groq și trece între timp la serviciul de rezervă, dacă ai pus unul. Fără card nu se plătește nimic."
msgstr "A korlát felett a Groq 429-es hibával válaszol: a vevő annyit vár, amennyit a Groq mond, és közben átvált a tartalék szolgáltatásra, ha beállítottál ilyet. Kártya nélkül semmit sem fizetsz."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Plan gratuit Developer: 1.000.000 de caractere, o singură dată."
msgstr "Ingyenes Developer csomag: 1 000 000 karakter, csak egyszer."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pune aici jetonul (la cheie) și ID-ul contului. Modelul e @cf/google/gemma-4-26b-a4b-it; e scris deja."
msgstr "Ide írd be a tokent (kulcsként) és a fiókazonosítót. A modell @cf/google/gemma-4-26b-a4b-it; már be van írva."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pune cheia aici. Modelul recomandat e openai/gpt-oss-20b (rapid); e scris deja. openai/gpt-oss-120b e mai mare și mai lent."
msgstr "Ide írd be a kulcsot. Az ajánlott modell az openai/gpt-oss-20b (gyors); már be van írva. Az openai/gpt-oss-120b nagyobb és lassabb."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Rezervele, în ordine: %s."
msgstr "A tartalékok sorrendben: %s."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Scrie alt model"
msgstr "Másik modell beírása"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Serviciile de pe internet pot avea limită pe zi: pune și un serviciu de rezervă (de exemplu Azure Translator). Cheia o scrii o singură dată; receptorul o ține criptată și o trimite numai la adresa pentru care ai pus-o."
msgstr "Az internetes szolgáltatásoknak lehet napi korlátjuk: állíts be tartalék szolgáltatást is (például az Azure Translatort). A kulcsot csak egyszer írod be; a vevő titkosítva tárolja, és csak arra a címre küldi, amelyhez beállítottad."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Termină înscrierea (email și parolă). Planul „Developer” e gratuit și nu trece singur pe plată."
msgstr "Fejezd be a regisztrációt (e-mail és jelszó). A „Developer” csomag ingyenes, és magától nem vált fizetősre."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Verifică jetonul și ID-ul contului: copiază din nou jetonul (în panoul Cloudflare, pagina „Workers AI”, „Use REST API”) și ID-ul contului (la „Account ID”), fără spații."
msgstr "Ellenőrizd a tokent és a fiókazonosítót: másold ki újra a tokent (a Cloudflare irányítópultján, „Workers AI” oldal, „Use REST API”) és a fiókazonosítót (az „Account ID” résznél), szóközök nélkül."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "un ID de cont Cloudflare bun (32 de litere și cifre, de la Account ID)"
msgstr "érvényes Cloudflare-fiókazonosító (32 betű és számjegy, az Account ID résznél)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "În casă nu are cotă: e gratuit, fără limită, și nimic nu iese din casă. Pe internet depinde de serviciu (vezi pașii)."
msgstr "Otthon nincs keret: ingyenes, korlát nélküli, és semmi sem hagyja el a házat. Az interneten a szolgáltatástól függ (lásd a lépéseket)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "În casă nu e cazul. Pe internet, peste limită vine eroarea 429, iar fără credit eroarea 402: receptorul trece singur la serviciul de rezervă, dacă ai pus unul."
msgstr "Otthon ez nem fordul elő. Az interneten a korlát felett 429-es hiba jön, egyenleg nélkül pedig 402-es: a vevő magától átvált a tartalék szolgáltatásra, ha beállítottál ilyet."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "În casă nu e cazul. Pe libretranslate.com, peste limita pe minut vine eroarea 429 câteva secunde: receptorul trece la serviciul de rezervă, dacă ai pus unul. LibreTranslate pe internet costă bani în fiecare lună; pentru subtitrări gratuite folosește mai bine Azure sau Gemini."
msgstr "Otthon ez nem fordul elő. A libretranslate.com oldalon a percenkénti korlát felett néhány másodpercig 429-es hiba jön: a vevő átvált a tartalék szolgáltatásra, ha beállítottál ilyet. Az interneten lévő LibreTranslate minden hónapban pénzbe kerül; ingyenes feliratokhoz inkább az Azure-t vagy a Geminit használd."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "În meniu alege „API Keys”, apasă „Create API Key”, scrie un nume și copiază cheia (începe cu gsk_). Groq o arată o singură dată: copiaz-o imediat."
msgstr "A menüben válaszd az „API Keys” pontot, nyomd meg a „Create API Key” gombot, írj be egy nevet, és másold ki a kulcsot (gsk_ kezdetű). A Groq csak egyszer mutatja: másold ki azonnal."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "În panou deschide pagina „Workers AI” și apasă „Use REST API”."
msgstr "Az irányítópulton nyisd meg a „Workers AI” oldalt, és nyomd meg a „Use REST API” gombot."

# HD Satelit: Locuri din retea (Components/HdsStocareRetea.py, Screens/HdsLocuriRetea.py, locuri_retea_web.py)
#: lib/python/Components/HdsStocareRetea.py
msgid "Calculator cu Windows sau NAS (SMB)"
msgstr "Windows-os számítógép vagy NAS (SMB)"

#: lib/python/Components/HdsStocareRetea.py
msgid "NAS sau Linux (NFS)"
msgstr "NAS vagy Linux (NFS)"

#: lib/python/Components/HdsStocareRetea.py
msgid "Server FTP"
msgstr "FTP-szerver"

#: lib/python/Components/HdsStocareRetea.py
msgid "Server FTP securizat (FTPS)"
msgstr "Biztonságos FTP-szerver (FTPS)"

#: lib/python/Components/HdsReteaProtocoale.py
msgid "WebDAV"
msgstr "WebDAV"

#: lib/python/Components/HdsStocareRetea.py
msgid "WebDAV securizat (HTTPS)"
msgstr "Biztonságos WebDAV (HTTPS)"

#: lib/python/Components/HdsStocareRetea.py
msgid "Server media din casă (DLNA)"
msgstr "Otthoni médiaszerver (DLNA)"

#: lib/python/Components/HdsStocareRetea.py
msgid "Numele de utilizator sau parola nu sunt bune, ori utilizatorul nu are voie în acest dosar."
msgstr "A felhasználónév vagy a jelszó nem jó, vagy a felhasználónak nincs hozzáférése ehhez a mappához."

#: lib/python/Components/HdsStocareRetea.py
msgid "Serverul nu răspunde. Verifică dacă este pornit și în aceeași rețea cu receptorul."
msgstr "A szerver nem válaszol. Ellenőrizd, hogy be van-e kapcsolva, és ugyanazon a hálózaton van-e, mint a vevőegység."

#: lib/python/Components/HdsStocareRetea.py
msgid "Numele serverului nu se găsește în rețea. Scrie adresa lui, de pildă 192.168.1.20."
msgstr "A szerver neve nem található a hálózaton. Írd be a címét, például 192.168.1.20."

#: lib/python/Components/HdsStocareRetea.py
msgid "Dosarul nu există pe server. Verifică numele lui."
msgstr "A mappa nem létezik a szerveren. Ellenőrizd a nevét."

#: lib/python/Components/HdsStocareRetea.py
msgid "Acest fel de loc nu se poate monta pe receptor."
msgstr "Ez a fajta hely nem csatlakoztatható a vevőegységhez."

#: lib/python/Components/HdsStocareRetea.py
msgid "Serverul nu folosește nicio versiune pe care o cunoaște receptorul. La SMB, pornește pe server SMB 2 sau SMB 3."
msgstr "A szerver egyetlen olyan verziót sem használ, amelyet a vevőegység ismer. SMB esetén kapcsold be a szerveren az SMB 2-t vagy az SMB 3-at."

#: lib/python/Components/HdsStocareRetea.py
msgid "Locul este deja montat."
msgstr "A hely már csatlakoztatva van."

#: lib/python/Components/HdsStocareRetea.py
msgid "Pe server nu mai este loc."
msgstr "A szerveren nincs több szabad hely."

#: lib/python/Components/HdsStocareRetea.py
msgid "Pe acest loc nu se poate scrie: este numai pentru citire."
msgstr "Erre a helyre nem lehet írni: csak olvasható."

#: lib/python/Components/HdsStocareRetea.py
msgid "Receptorul nu poate face dosarul în care se montează locul."
msgstr "A vevőegység nem tudja létrehozni a mappát, ahová a helyet csatlakoztatná."

#: lib/python/Components/HdsStocareRetea.py
msgid "Serverul nu a răspuns la timp. Încearcă încă o dată."
msgstr "A szerver nem válaszolt időben. Próbáld újra."

#: lib/python/Components/HdsStocareRetea.py
msgid "Parola acestui loc nu este salvată pe receptor. Scrie-o din nou la Editează."
msgstr "Ennek a helynek a jelszava nincs elmentve a vevőegységen. Írd be újra itt: Szerkesztés."

#: lib/python/Components/HdsStocareRetea.py
msgid "Legătura securizată cu serverul nu s-a putut face (certificatul nu este bun)."
msgstr "A biztonságos kapcsolat a szerverrel nem jött létre (a tanúsítvány nem jó)."

#: lib/python/Components/HdsStocareRetea.py
msgid "Receptorul nu este legat la rețea."
msgstr "A vevőegység nem kapcsolódik a hálózathoz."

#: lib/python/Components/HdsStocareRetea.py
msgid "Locul este prea lent pentru înregistrări."
msgstr "A hely túl lassú a felvételekhez."

#: lib/python/Components/HdsStocareRetea.py
msgid "Cererea nu este bună."
msgstr "A kérés nem jó."

#: lib/python/Components/HdsStocareRetea.py
msgid "Locul nu mai există. Poate a fost șters între timp."
msgstr "A hely már nem létezik. Lehet, hogy közben törölték."

#: lib/python/Components/HdsStocareRetea.py
msgid "Locul nu s-a putut deschide. Încearcă încă o dată."
msgstr "A helyet nem sikerült megnyitni. Próbáld újra."

#: lib/python/Components/HdsStocareRetea.py
msgid "Gata de răsfoit"
msgstr "Böngészésre kész"

#: lib/python/Components/HdsStocareRetea.py
msgid "Montat"
msgstr "Csatlakoztatva"

#: lib/python/Components/HdsStocareRetea.py
msgid "Nemontat"
msgstr "Nincs csatlakoztatva"

#: lib/python/Components/HdsStocareRetea.py
#, python-format
msgid "Locul scrie cu %s MB/s: ajunge pentru înregistrări, și pentru canale 4K."
msgstr "A hely %s MB/s sebességgel ír: elég a felvételekhez, a 4K csatornákhoz is."

#: lib/python/Components/HdsStocareRetea.py
msgid "Alege felul locului."
msgstr "Válaszd ki a hely fajtáját."

#: lib/python/Components/HdsStocareRetea.py
msgid "Portul trebuie să fie un număr între 1 și 65535 (0 pentru cel obișnuit)."
msgstr "A port 1 és 65535 közötti szám legyen (0 a szokásos porthoz)."

#: lib/python/Components/HdsStocareRetea.py
msgid "Scrie numele dosarului partajat de pe server, de pildă Filme."
msgstr "Írd be a szerveren lévő megosztott mappa nevét, például Filme."

#: lib/python/Components/HdsStocareRetea.py
msgid "Scrie dosarul exportat de server, de pildă volume1/filme."
msgstr "Írd be a szerver által exportált mappát, például volume1/filme."

#: lib/python/Components/HdsStocareRetea.py
msgid "Dosarul nu poate conține '..'."
msgstr "A mappa nem tartalmazhat '..' részt."

#: lib/python/Components/HdsStocareRetea.py
msgid "Numele de utilizator nu poate conține virgule sau rânduri noi."
msgstr "A felhasználónév nem tartalmazhat vesszőt vagy sortörést."

#: lib/python/Components/HdsStocareRetea.py
msgid "Nu s-a deschis"
msgstr "Nem nyílt meg"

#: lib/python/Components/HdsStocareRetea.py
msgid "Montat, folosit și pentru înregistrări"
msgstr "Csatlakoztatva, felvételekhez is használva"

#: lib/python/Components/HdsStocareRetea.py
#, python-format
msgid "Locul scrie cu %s MB/s: prea încet pentru înregistrări (trebuie cel puțin %s MB/s). Încearcă un cablu de rețea în locul Wi-Fi-ului sau alt server."
msgstr "A hely %s MB/s sebességgel ír: ez túl lassú a felvételekhez (legalább %s MB/s kell). Próbálj hálózati kábelt Wi-Fi helyett, vagy egy másik szervert."

#: lib/python/Components/HdsStocareRetea.py
#, python-format
msgid "Locul scrie cu %s MB/s: ajunge pentru o înregistrare HD odată. Pentru canale 4K sau două înregistrări deodată e mai sigur un disc legat la receptor."
msgstr "A hely %s MB/s sebességgel ír: egyszerre egy HD felvételhez elég. 4K csatornákhoz vagy két egyidejű felvételhez biztonságosabb egy vevőegységre kötött lemez."

#: lib/python/Components/HdsStocareRetea.py
msgid "Receptorul nu este pregătit. Încearcă peste câteva secunde."
msgstr "A vevőegység nem áll készen. Próbáld újra néhány másodperc múlva."

#: lib/python/Components/HdsStocareRetea.py
msgid "Adresa serverului media nu este bună. Folosește Caută în casă."
msgstr "A médiaszerver címe nem jó. Használd ezt: Keresés otthon."

#: lib/python/Components/HdsStocareRetea.py
msgid "Scrie numele sau adresa serverului, de pildă 192.168.1.20 sau NAS."
msgstr "Írd be a szerver nevét vagy címét, például 192.168.1.20 vagy NAS."

#: lib/python/Components/HdsStocareRetea.py
msgid "Server media"
msgstr "Médiaszerver"

#: lib/python/Components/HdsStocareRetea.py
msgid "Filmul nu a pornit pe televizor."
msgstr "A film nem indult el a tévén."

#: lib/python/Components/HdsStocareRetea.py
msgid "Demontează întâi locul, apoi schimbă-l."
msgstr "Előbb válaszd le a helyet, majd módosítsd."

#: lib/python/Components/HdsStocareRetea.py
msgid "Sunt prea multe locuri. Șterge unul pe care nu îl mai folosești."
msgstr "Túl sok hely van. Törölj egyet, amelyet már nem használsz."

#: lib/python/Components/HdsStocareRetea.py
msgid "Locul nu s-a putut salva pe receptor."
msgstr "A helyet nem sikerült menteni a vevőegységre."

#: lib/python/Components/HdsStocareRetea.py
msgid "Locul s-a salvat, dar parola nu se poate păstra pe acest receptor."
msgstr "A hely mentve, de a jelszót nem lehet megőrizni ezen a vevőegységen."

#: lib/python/Components/HdsStocareRetea.py
msgid "Se montează..."
msgstr "Csatlakoztatás..."

#: lib/python/Components/HdsStocareRetea.py
msgid "Se demontează..."
msgstr "Leválasztás..."

#: lib/python/Components/HdsStocareRetea.py
msgid "Se verifică scrierea și viteza..."
msgstr "Az írás és a sebesség ellenőrzése..."

#: lib/python/Components/HdsStocareRetea.py
msgid "Înregistrările merg numai pe locurile SMB și NFS montate."
msgstr "Felvételek csak a csatlakoztatott SMB és NFS helyekre készülhetnek."

#: lib/python/Components/HdsStocareRetea.py
msgid "Montează întâi locul."
msgstr "Előbb csatlakoztasd a helyet."

#: lib/python/Components/HdsStocareRetea.py
msgid "Pe televizor e deschis alt ecran. Închide-l, apoi pornește din nou filmul."
msgstr "A tévén egy másik képernyő van nyitva. Zárd be, majd indítsd el újra a filmet."

#: lib/python/Components/HdsStocareRetea.py
msgid "Locul nu mai este montat."
msgstr "A hely már nincs csatlakoztatva."

#: lib/python/Components/HdsStocareRetea.py
#, python-format
msgid "Serverul locului %s nu mai răspunde, așa că locul a fost demontat. Îl poți monta din nou din Locuri din rețea."
msgstr "A(z) %s hely szervere nem válaszol, ezért a hely le lett választva. Újra csatlakoztathatod itt: Hálózati helyek."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Se verifică scrierea și viteza (până la un minut)..."
msgstr "Az írás és a sebesség ellenőrzése (legfeljebb egy perc)..."

#: lib/python/Components/HdsStocareRetea.py
msgid "Locuri din rețea"
msgstr "Hálózati helyek"

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Cum merge"
msgstr "Hogyan működik"

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Locurile SMB și NFS se montează: apar și în Player media, ca un disc, și pot ține înregistrări. FTP, WebDAV și DLNA se răsfoiesc de aici.\nNimic nu se montează singur. Parolele stau criptate pe receptor."
msgstr "Az SMB és NFS helyek csatlakoztathatók: a Médialejátszóben is megjelennek, mint egy lemez, és felvételeket is tárolhatnak. Az FTP, WebDAV és DLNA helyek innen böngészhetők.\nSemmi sem csatlakozik magától. A jelszavak titkosítva vannak a vevőegységen."

#: lib/python/Components/HdsStocareRetea.py
msgid "Caută în casă"
msgstr "Keresés otthon"

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Niciun loc încă. VERDE: adaugă un loc; ALBASTRU: caută serverele din casă."
msgstr "Még nincs hely. ZÖLD: adj hozzá egy helyet; KÉK: keresd meg az otthoni szervereket."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Caută serverele din casă"
msgstr "Otthoni szerverek keresése"

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Cum se caută"
msgstr "Hogyan működik a keresés"

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Receptorul întreabă scurt aparatele din rețeaua ta: servere media, calculatoare cu Windows, NAS-uri. Nimic nu pleacă în afara rețelei.\nUn calculator care nu apare se adaugă de mână, cu adresa lui."
msgstr "A vevőegység röviden lekérdezi a hálózatod eszközeit: médiaszervereket, Windows-os számítógépeket, NAS-okat. Semmi sem kerül ki a hálózatból.\nA meg nem jelenő számítógépet kézzel lehet hozzáadni, a címével."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "OK: intri în dosar sau pornești filmul.\nINAPOI: dosarul de mai sus.\nSubtitrările de lângă film se iau singure; tasta SUB le arată pe toate și caută pe internet."
msgstr "OK: belépsz a mappába vagy elindítod a filmet.\nVISSZA: a feljebb lévő mappa.\nA film melletti feliratok maguktól betöltődnek; a SUB gomb mindet megmutatja, és az interneten is keres."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Se pregătește filmul..."
msgstr "A film előkészítése..."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Tastatura"
msgstr "Billentyűzet"

#: lib/python/Screens/HdsLocuriRetea.py
msgid "SMB: calculatorul cu Windows sau NAS-ul (dosarele partajate). NFS: NAS sau Linux. FTP și WebDAV: servere de fișiere. DLNA: serverul media din casă (folosește Caută în casă)."
msgstr "SMB: a Windows-os számítógép vagy a NAS (megosztott mappák). NFS: NAS vagy Linux. FTP és WebDAV: fájlszerverek. DLNA: az otthoni médiaszerver (használd ezt: Keresés otthon)."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Un nume ușor de recunoscut, de pildă NAS sufragerie."
msgstr "Könnyen felismerhető név, például NAS nappali."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Numele calculatorului sau adresa lui, de pildă 192.168.1.20. Merge și \\\\NAS\\Filme sau nas:/volume1/filme: se despart singure."
msgstr "A számítógép neve vagy címe, például 192.168.1.20. A \\\\NAS\\Filme vagy a nas:/volume1/filme is jó: maguktól szétválnak."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "SMB: numele dosarului partajat, de pildă Filme. NFS: dosarul exportat, de pildă volume1/filme. GALBEN: lista de pe server."
msgstr "SMB: a megosztott mappa neve, például Filme. NFS: az exportált mappa, például volume1/filme. SÁRGA: a szerveren lévő lista."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Contul de pe server. Pe Windows: numele contului sau CASA\\nume. Gol: fără cont (oaspete)."
msgstr "A fiók a szerveren. Windowson: a fiók neve vagy CASA\\nume. Üres: fiók nélkül (vendég)."

