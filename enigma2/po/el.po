msgid "„%s”"
msgstr "«%s»"

#, python-format
msgid ""
"„%s” a fost scos din folosință. Fișierul se șterge la următoarea pornire."
msgstr ""
"«%s» τέθηκε εκτός χρήσης. Το αρχείο θα διαγραφεί στην επόμενη εκκίνηση."

#, python-format
msgid "„%s” curățat: %d fișiere șterse, %s eliberați."
msgstr "«%s» καθαρίστηκε: σβήστηκαν %d αρχεία, %s ελευθερώθηκαν."

#, python-format
msgid "„%s” descărcat (%s), licență %s, folosibil în skin ca %s."
msgstr "«%s» λήφθηκε (%s), άδεια %s, χρησιμοποιήσιμο σε skin ως %s."

#, python-format
msgid "„%s” era deja oprită."
msgstr "«%s» ήταν ήδη σταματημένο."

#, python-format
msgid "„%s” era deja pornită."
msgstr "«%s» ήταν ήδη ανοιχτό."

msgid "„%s” este conectat, dar nu este ales pentru înregistrări."
msgstr "Το «%s» είναι συνδεδεμένο, αλλά δεν έχει επιλεγεί για εγγραφές."

msgid "„%s” este conectat, dar receptorul nu îl poate citi."
msgstr "«%s» συνδεδεμένο, αλλά δέκτης δεν μπορεί να το διαβάσει."

#, python-format
msgid "„%s” este pus acum."
msgstr "«%s» είναι σε χρήση τώρα."

#, python-format
msgid ""
"„%s” merge acum. Ca s-o oprești, șterge-o din listă; ce s-a înregistrat până "
"acum rămâne."
msgstr ""
"«%s» εκτελείται τώρα. Για διακοπή, σβήσε το από τη λίστα· ό,τι εγγράφηκε "
"μένει."

#, python-format
msgid "„%s” nu merge acum. Reîncarcă pagina."
msgstr "«%s» δεν τρέχει τώρα. Ανανέωσε σελίδα."

msgid ""
"„%s” nu poate fi citit de receptor. Formatează-l pe un calculator ca FAT32 "
"(se șterge tot de pe el)."
msgstr ""
"«%s» δεν διαβάζεται από τον δέκτη. Διαμόρφωσέ το σε υπολογιστή ως FAT32 "
"(διαγράφονται όλα)."

#, python-format
msgid ""
"„%s” nu poate fi citit de receptor. Îl poți formata aici sau pe un "
"calculator, ca FAT32. Formatarea șterge tot de pe el."
msgstr ""
"Ο δέκτης δεν μπορεί να διαβάσει «%s». Μπορείς να το διαμορφώσεις εδώ ή σε "
"υπολογιστή, ως FAT32. Η διαμόρφωση διαγράφει τα πάντα."

#, python-format
msgid ""
"„%s” nu se găsește în depozitul liber google/fonts: licență neconfirmată, nu "
"se descarcă."
msgstr ""
"«%s» δεν βρίσκεται στο ελεύθερο αποθετήριο google/fonts: η άδεια δεν "
"επιβεβαιώθηκε, δεν κατεβαίνει."

msgid "„%s” nu se poate folosi: %s."
msgstr "«%s» δεν μπορεί να χρησιμοποιηθεί: %s."

#, python-format
msgid "„%s” se alege cu 1 (da) sau 0 (nu)."
msgstr "Το «%s» επιλέγεται με 1 (ναι) ή 0 (όχι)."

msgid "„%s”, liber %s din %s"
msgstr "«%s», %s ελεύθερα από %s"

msgid "„%s”: aici se salvează acum"
msgstr "«%s»: εδώ αποθηκεύονται τώρα"

msgid "„%s”: aici se vor salva"
msgstr "«%s»: εδώ θα αποθηκεύονται"

msgid ""
"„Adresă proprie” (alt serviciu, cu adresa lui) și toate celelalte setări "
"sunt pe pagina cu toate setările:"
msgstr ""
"«Δική σου διεύθυνση» (άλλη υπηρεσία, με τη διεύθυνσή της) και όλες οι άλλες "
"ρυθμίσεις είναι στη σελίδα όλων των ρυθμίσεων:"

msgid ""
"„Adresă proprie” e pentru un server de traducere ales de tine, de exemplu un "
"LibreTranslate pornit pe un calculator din casă. Receptorul trimite fiecare "
"rând de subtitrare într-o cerere separată."
msgstr ""
"«Δική σου διεύθυνση» είναι για διακομιστή μετάφρασης που επιλέγεις εσύ, π.χ. "
"ένα LibreTranslate σε υπολογιστή στο σπίτι. Ο δέκτης στέλνει κάθε γραμμή "
"υποτίτλου σε ξεχωριστό αίτημα."

msgid "„Ca la calculator” revine la următoarea pornire a receptorului."
msgstr "«Σαν υπολογιστή» επανέρχεται στην επόμενη εκκίνηση του δέκτη."

msgid ""
"„Ca la calculator” revine numai după o repornire. Repornești receptorul acum?"
msgstr ""
"«Σαν υπολογιστή» επανέρχεται μόνο μετά από επανεκκίνηση. Επανεκκίνηση τώρα;"

msgid ""
"„Ca la calculator” se aplică la următoarea pornire; pe unele televizoare "
"imaginea iese spălăcită pe 60 Hz."
msgstr ""
"«Σαν υπολογιστή» εφαρμόζεται στην επόμενη εκκίνηση, σε ορισμένες τηλεοράσεις "
"η εικόνα βγαίνει ξεθωριασμένη στα 60 Hz."

msgid ""
"„Ca la calculator” se aplică numai după o repornire. Repornești receptorul "
"acum?"
msgstr ""
"«Σαν υπολογιστή» εφαρμόζεται μόνο μετά από επανεκκίνηση. Επανεκκίνηση τώρα;"

msgid ""
"„Enigma” și „Dreambox” sunt mărci ale Dream Property GmbH; celelalte nume de "
"produse aparțin deținătorilor lor."
msgstr ""
"«Enigma» και «Dreambox» είναι εμπορικά σήματα της Dream Property GmbH· τα "
"υπόλοιπα ονόματα προϊόντων ανήκουν στους κατόχους τους."

msgid ""
"„Folosește pentru înregistrări” face pe disc dosarul movie, dacă lipsește. "
"Nu se șterge și nu se formatează nimic."
msgstr ""
"«Χρήση για εγγραφές» δημιουργεί στον δίσκο τον φάκελο movie, αν λείπει. Δεν "
"διαγράφεται και δεν διαμορφώνεται τίποτα."

msgid "„Fără subtitrări niciodată” se alege cu 1 (da) sau 0 (nu)."
msgstr "«Να μην εμφανίζονται ποτέ υπότιτλοι» επιλέγεται με 1 (ναι) ή 0 (όχι)."

msgid ""
"„Redenumește” schimbă numele numai în acest buchet. „Redenumește peste tot” "
"îl schimbă în lista receptorului."
msgstr ""
"«Μετονομασία» αλλάζει το όνομα μόνο σε αυτό το μπουκέτο. «Μετονομασία "
"παντού» το αλλάζει στη λίστα του δέκτη."

msgid "„Standby” pornește automat fără nicio înregistrare activă."
msgstr "Η «αναμονή» ενεργοποιείται αυτόματα όταν δεν υπάρχει ενεργή εγγραφή."

msgid "„pornit” se alege cu 1 (da) sau 0 (nu)."
msgstr "Το «ενεργό» επιλέγεται με 1 (ναι) ή 0 (όχι)."

