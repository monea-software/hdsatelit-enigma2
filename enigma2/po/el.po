msgstr "Το όνομά σου στο φόρουμ είναι τώρα «%s»."

msgid "Numele și parola au fost șterse de pe receptor."
msgstr "Το όνομα και ο κωδικός διαγράφηκαν από τον δέκτη."

msgid "Numele și parola contului"
msgstr "Όνομα και κωδικός λογαριασμού"

msgid ""
"Numele și parola contului HMA. După salvare nu se mai arată nicăieri. Se "
"scriu mai ușor din telefon, în interfața web."
msgstr ""
"Όνομα και κωδικός λογαριασμού HMA. Μετά την αποθήκευση δεν εμφανίζονται "
"πουθενά. Γράφονται ευκολότερα από τηλέφωνο, στη διαδικτυακή διεπαφή."

msgid "Numele și parola de serviciu"
msgstr "Όνομα και κωδικός υπηρεσίας"

msgid "Numele și parola din fișier nu se folosesc: se scriu pe receptor."
msgstr ""
"Το όνομα και ο κωδικός από το αρχείο δεν χρησιμοποιούνται: γράφονται στον "
"δέκτη."

msgid "Numele și parola sunt salvate. Nu se mai arată nicăieri."
msgstr "Το όνομα και ο κωδικός αποθηκεύτηκαν. Δεν εμφανίζονται πλέον πουθενά."

msgid "Numele, cu tastatura de pe ecran"
msgstr "Το όνομα, με το πληκτρολόγιο οθόνης"

