msgid ""
"Serverul nu are niciun model descărcat. Descarcă unul pe calculator (vezi "
"toate setările), apoi caută din nou."
msgstr ""
"Ο διακομιστής δεν έχει κανένα μοντέλο κατεβασμένο. Κατέβασε ένα στον "
"υπολογιστή (δες όλες τις ρυθμίσεις) και μετά ψάξε ξανά."

msgid "Serverul nu are niciun model potrivit pentru traducere."
msgstr "Ο server δεν έχει κανένα μοντέλο κατάλληλο για μετάφραση."

msgid "Serverul nu are încă acordul tău. Mai încearcă peste câteva minute."
msgstr ""
"Ο διακομιστής δεν έχει ακόμα τη συγκατάθεσή σου. Δοκίμασε ξανά σε λίγα λεπτά."

#, python-format
msgid "Serverul nu dă lista modelelor (HTTP %s)."
msgstr "Ο διακομιστής δεν δίνει τη λίστα μοντέλων (HTTP %s)."

msgid "Serverul nu dă lista modelelor."
msgstr "Ο διακομιστής δεν δίνει τη λίστα μοντέλων."

msgid "Serverul nu este al acestui furnizor."
msgstr "Διακομιστής δεν ανήκει σε αυτόν τον πάροχο."

msgid ""
"Serverul nu folosește nicio versiune pe care o cunoaște receptorul. La SMB, "
"pornește pe server SMB 2 sau SMB 3."
msgstr ""
"Ο διακομιστής δεν χρησιμοποιεί καμία έκδοση που γνωρίζει ο δέκτης. Στο SMB, "
"ενεργοποίησε στον διακομιστή SMB 2 ή SMB 3."

msgid "Serverul nu mai există."
msgstr "Διακομιστής δεν υπάρχει πλέον."

msgid "Serverul nu răspunde acum. Încearcă mai târziu."
msgstr "Ο διακομιστής δεν απαντά τώρα. Δοκίμασε αργότερα."

msgid ""
"Serverul nu răspunde. Verifică dacă este pornit și în aceeași rețea cu "
"receptorul."
msgstr ""
"Ο διακομιστής δεν απαντά. Έλεγξε αν είναι ενεργοποιημένος και στο ίδιο "
"δίκτυο με τον δέκτη."

msgid "Serverul nu răspunde. Încearcă alt server sau TCP în loc de UDP."
msgstr "Διακομιστής δεν αποκρίνεται. Δοκίμασε άλλον ή TCP αντί UDP."

msgid "Serverul poate fi numai LibreTranslate sau compatibil OpenAI."
msgstr "Ο server μπορεί να είναι μόνο LibreTranslate ή συμβατός OpenAI."

msgid "Serverul refuză legătura. Încearcă alt server."
msgstr "Ο διακομιστής αρνείται τη σύνδεση. Δοκίμασε άλλον διακομιστή."

msgid "Serverul șterge tot ce a trimis acest receptor."
msgstr "Ο διακομιστής διαγράφει ό,τι έστειλε αυτός ο δέκτης."

