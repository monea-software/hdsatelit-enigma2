msgstr ": διαφάνεια"

msgid ": ștergi modelul ("
msgstr ": διαγράφεις το μοντέλο ("

msgid "; %s rânduri pierdute înainte"
msgstr "; %s γραμμές χάθηκαν πριν"

msgid "; 18 V ținut %s, apoi 13 V pentru transponder"
msgstr "; 18 V διατηρήθηκε %s, μετά 13 V για τον αναμεταδότη"

msgid "; antena crezută pe %s"
msgstr "; η κεραία πιστεύεται ότι είναι στο %s"

