msgstr ""
"У полі «Resource group» натисни «Create new» і напиши будь-яку назву. У "
"«Region» вибери «Global», у «Name» напиши свою назву, а в «Pricing tier» "
"вибери «Free F0»."

msgid "La „Înlocuiește lista de acum” pleacă."
msgstr "При «Замінити поточний список» зникають."

msgid "Lac de munte"
msgstr "Горне озеро"

msgid "Lalele"
msgstr "Тюльпани"

msgid "Language selection"
msgstr "Вибір мови"

msgid "Lansare automată aplicație"
msgstr "Автозапуск застосунку"

msgid "Lansează automat aplicația HbbTV cu AUTOSTART când schimbi canalul."
msgstr ""
"Автоматично запускає застосунок HbbTV з AUTOSTART, коли перемикаєш канал."

msgid "Last speed"
msgstr "Остання швидкість"

msgid "Lasă aici"
msgstr "ПокладИ тут"

msgid "Lasă subpaginile să meargă"
msgstr "Відпустити підсторінки"

msgid "Lasă-o acum, dar nu mai porni data viitoare"
msgstr "Не зупиняй, але не запускай."

msgid "Latimea capturii"
msgstr "Ширина знімка"

msgid "Latin"
msgstr "Латинський"

msgid "Latitude"
msgstr "Широта"

