msgid "Redenumește fișierul fără diacritice"
msgstr "Перейменуй файл без діакритичних знаків"

msgid "Redenumește peste tot"
msgstr "Перейменувати всюди"

msgid "Redenumește siglele după nume"
msgstr "Перейменувати логотипи за назвою"

msgid "Redenumește siglele după referință"
msgstr "Перейменувати логотипи за посиланням"

msgid "Redenumirea se face după referință sau după nume."
msgstr "Перейменування виконується за посиланням або за назвою."

