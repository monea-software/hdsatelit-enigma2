msgstr "На новому пульті натисни кнопку для: %s"

msgid ""
"Apasă un buton pe desen: receptorul îl primește ca de pe telecomanda lui. "
"Ținut apăsat = apăsare lungă."
msgstr ""
"Натисни кнопку на малюнку: ресивер отримає її як зі свого пульта. Утримання "
"= довге натискання."

msgid ""
"Apasă „Create API Key”, scrie un nume și copiază cheia (începe cu gsk_); "
"Groq o arată o singură dată."
msgstr ""
"Натисни «Create API Key», напиши назву й скопіюй ключ (починається з gsk_); "
"Groq показує його лише один раз."

msgid "Apasă „Create API key” și copiază cheia."
msgstr "Натисни «Create API key» і скопіюй ключ."

msgid ""
"Apasă „Create a Workers AI API Token”, apoi „Create API Token” și „Copy API "
"Token”. Păstrează jetonul."
msgstr ""
"Натисни «Create a Workers AI API Token», потім «Create API Token» і «Copy "
"API Token». Збережи токен."

msgid ""
"Apasă „Create a Workers AI API Token”, apoi „Create API Token” și „Copy API "
"Token”; copiază și „Account ID”, de la „Get Account ID”."
msgstr ""
"Натисни «Create a Workers AI API Token», потім «Create API Token» і «Copy "
"API Token»; скопіюй також «Account ID» у «Get Account ID»."

msgid "Apasă „Create credentials”, „API key” și copiază cheia."
msgstr "Натисни «Create credentials», «API key» і скопіюй ключ."

msgid ""
"Apasă „Probează traducerea”. Dacă nu merge, mesajul arată începutul "
"răspunsului serverului, ca să vezi unde e traducerea și ce cale să scrii."
msgstr ""
