msgstr "Не відповідає вже хвилину. Зупини її, лише якщо мережа зависла."

#, python-format
msgid "Nu mai vin date de la %s. Tunerul a fost eliberat."
msgstr "Дані від %s більше не надходять. Тюнер звільнено."

msgid "Nu mai vin date. Reiau acordul."
msgstr "Дані більше не надходять. Повторюю налаштування."

msgid "Nu mai întreba pentru limba asta"
msgstr "Не запитай більше за цю мову."

msgid "Nu merg acum"
msgstr "Зараз не працюють"

msgid "Nu merg toate serviciile de sistem; paznicul încearcă din nou: %s"
msgstr "Не всі системні служби працюють; охоронник спробує знову: %s"

msgid ""
"Nu merge acum niciun sunet (sau interfața nu are încă legătura cu "
