msgid "Nu merge nimic acum."
msgstr "Зараз нічого не відтворюється."

msgid "Nu pornește: %s. Încerc din nou."
msgstr "Не запускається: %s. Попробую ще раз."

msgid "Nu pot afla poziția curentă (serviciul nu e derulabil acum)."
msgstr ""
"Не вдається визначити поточну позицію (канал зараз не можна перемотувати)."

#, python-format
msgid "Nu pot arăta ce se va căuta. %s"
msgstr "Я не можу показати, що шукають. %s"

