#, python-format
msgid "Ceasul e înainte (%s): potrivește ora în Data și ora."
msgstr "Час поспішає (%s ): визначити час у розділі налаштування дати і часу."

#, python-format
msgid ""
"Ceasul receptorului e în urmă (arată %s), de aceea certificatele site-urilor "
"par încă nevalabile."
msgstr ""
"Час ресивера відстає (показано %s), тому сертифікати сайтів здаються ще "
"недійсними."

#, python-format
msgid ""
"Ceasul receptorului e înainte (arată %s), de aceea certificatele site-urilor "
"par expirate."
msgstr ""
"Час ресивера поспішає (показано %s), тому сертифікати сайтів здаються "
"закінченими."

msgid "Ceasul subtitrării merge din nou."
msgstr "Знову починається час субтитров."

msgid "Ceasurile afișajului"
msgstr "Час дисплею"

msgid "Cehia"
msgstr "Чехія"

msgid "Cehă"
msgstr "Чеський"

msgid "Cel mai lung"
msgstr "Найдовше"

msgid "Cel mai simplu de pornit, fără card; se poate opri dacă te uiți mult"
msgstr ""
"Найпростіше запустити, без картки; може зупинитися, якщо дивишся багато"

msgid ""
"Cel mai simplu, în casă: instalează Ollama de pe ollama.com pe un calculator "
"și pornește-l."
msgstr ""
"Найпростіше, удома: встанови Ollama з ollama.com на комп’ютер і запусти його."

msgid ""
"Cel mai simplu: pornește serverul pe calculator (pașii de mai jos), apoi "
"apasă „Caută în rețeaua de acasă”, pe televizor sau pe telefon. Receptorul "
"găsește singur serverul; nu mai trebuie să scrii adresa."
msgstr ""
"Найпростіше: запусти сервер на комп’ютері (кроки нижче), потім натисни "
"«Шукати в домашній мережі», на телевізорі або на телефоні. Ресивер сам "
"знайде сервер; адресу писати вже не потрібно."

#, python-format
msgid "Cel mult %d MHz sub %d °C, apoi %d MHz și %d MHz."
msgstr "Не більше %d MHz нижче %d °C, потім %d MHz і %d MHz."

#, python-format
msgid "Cel mult %d MHz sub %d °C, apoi %d MHz."
msgstr "Не більше %d МГц нижче %d °C, потім %d МГц."

#, python-format
msgid "Cel mult %d MHz."
msgstr "Не більше %d МГц."

#, python-format
msgid "Cel mult %d MHz. De la %d °C: %d MHz, până stă %s la cel mult %d °C."
msgstr ""
"Не більше %d МГц. З %d °C: %d МГц, поки не тримається %s при %d °C або нижче."

#, python-format
msgid "Cel mult %d MHz. De obicei procesorul stă oricum pe %d MHz."
msgstr "Не більше %d МГц. Як правило, процесор і так працює на %d МГц."

msgid "Cel mult %d de canale pe cerere."
msgstr "Не більше %d каналів за один запит."

#, python-format
