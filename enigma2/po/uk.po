msgid "Interfața camului se deschide pe televizor."
msgstr "Інтерфейс CAM відкривається на телевізорі."

msgid ""
"Interfața iese și pornește din nou singură. Browserul se conectează apoi din "
"nou, cu codul de pe televizor."
msgstr ""
"Інтерфейс закривається і запускається знову, а потім браузер знову "
"підключається з кодом з телевізора."

#, python-format
msgid "Interfața lucrează la: %s. Paznicul așteaptă să termine."
msgstr "Інтерфейс зайнятий: %s. Охоронник чекає, поки це закінчиться."

msgid "Interfața nu a apărut în 5 minute: s-a blocat la pornire."
msgstr "Інтерфейс не з’явився за 5 хвилин: він вивіс при запуску."

msgid "Interfața nu a mai răspuns. Paznicul a repornit-o."
msgstr "Інтерфейс перестає відповідати."

msgid ""
"Interfața nu a mai trimis semn de viață, dar interfața web răspunde. "
"Paznicul nu o repornește."
msgstr ""
"Інтерфейс перестає подавати сигнали життя, але інтерфейс Веб відповідає."

msgid "Interfața nu a revenit în 4 minute. Verifică receptorul."
msgstr "Інтерфейс не повернувся за 4 хвилини."

msgid "Interfața nu este gata pentru repornire."
msgstr "Інтерфейс не готовий до перезапуску."

msgid "Interfața nu este pornită încă."
msgstr "Інтерфейс ще не запущений."

msgid "Interfața nu pornește"
msgstr "Інтерфейс не запускається"

msgid "Interfața nu pornește deloc."
msgstr "Інтерфейс взагалі не запускається."

msgid ""
"Interfața nu s-a repornit, deci alegerea nu s-a făcut. Receptorul rămâne în "
"modul sigur; poți alege din nou."
msgstr ""
"Інтерфейс не запускається, тому вибір не виконується. Ресівер залишається в "
"безпечному режимі; можна вибрати знову."

msgid "Interfața nu s-a repornit. Apasă Repornește interfața."
msgstr "Інтерфейс не запустився. НаціснИ Перезапустити інтерфейс."

msgid ""
"Interfața receptorului: enigma2, schimbat de Monea Software pentru HD "
"Satelit."
msgstr "Інтерфейс ресивера: enigma2, змінений Monea Software для HD Satelit."

msgid "Interfața repornește acum, ca să intre setările antenei. Continui?"
msgstr ""
"Інтерфейс зараз перезапуститься, щоб застосувалися налаштування антени. "
"Продовжити?"

msgid "Interfața repornește acum, ca să intre setările importate. Continui?"
msgstr ""
"Інтерфейс зараз запускається, щоб застосувати імпортовані налаштування."

msgid "Interfața repornește și pune la loc copia. Pagina se reîncarcă singură."
msgstr "Інтерфейс перезапускається й відновлює копію. Сторінка оновиться сама."

msgid "Interfața repornește. Aștept să revină..."
msgstr "Інтерфейс запускається."

msgid "Interfața repornește. Pagina se poate reîncărca după un minut."
msgstr "Інтерфейс запускається. Страница може бути оновлена через хвилину."

msgid "Interfața repornește..."
msgstr "Інтерфейс перезапускається..."

msgid "Interfața s-a oprit la pornire din alt motiv."
msgstr "Інтерфейс зупинився при запуску з іншої причини."

#, no-python-format
msgid "Interfața s-a oprit neașteptat o dată în ultimele 10 minute."
msgid_plural "Interfața s-a oprit neașteptat de %d ori în ultimele 10 minute."
msgstr[0] "Інтерфейс неочікувано зупинився %d разів за останні 10 хвилин."
msgstr[1] "Інтерфейс неочікувано зупинився %d разів за останні 10 хвилин."
msgstr[2] "Інтерфейс неочікувано зупинився %d разів за останні 10 хвилин."

msgid "Interfața se repornește."
msgstr "Інтерфейс запускається."

msgid "Interfața se repornește. Pagina se reîncarcă singură în câteva secunde."
msgstr "Інтерфейс запускається. Страница обновлюється сама за кілька секунд."

