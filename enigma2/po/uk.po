msgstr "Безкоштовна квота: %s"

#, python-format
msgid "Could not connect to %s. Check the password and the signal."
msgstr "Не вдалося підключитися до %s. Перевір пароль і сигнал."

msgid "Could not open Picture in Picture"
msgstr "Не вдалося відкрити «картинку в картинці»"

#, python-format
msgid "Couldn't record due to conflicting timer %s"
msgstr "Не вдалося записати через конфлікт із таймером %s"

msgid "Crash Log Viewer"
msgstr "Журнали збоїв"

msgid "Create movie folder failed"
msgstr "Не вдалося створити папку записів"

