msgstr "Запущено, але немає веб-інтерфейсу (або зараз не відповідає)."

msgid "Pornit, le cere utilizatorul root și parola"
msgstr "Увімкнено, вимагає від них користувача root і пароль"

msgid ""
"Pornit, sunetul posturilor de radio trece prin procesor și se aude cu "
"reglajele de mai jos."
msgstr ""
"Увімкнено: звук радіостанцій проходить через процесор і звучить із "
"налаштуваннями нижче."

msgid "Pornit/Oprit"
msgstr "Увімк./Вимк."

#, python-format
msgid "Pornit: %s"
msgstr "Увімк.: %s"

