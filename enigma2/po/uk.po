msgstr "Країна / регіон (кабель)"

msgid "Ți-am trimis pe e-mail legătura de confirmare."
msgstr "Ми надіслали тобі на e-mail посилання для підтвердження."

msgid "Țin minte alegerea."
msgstr "Я запам'ятовую вибір."

msgid "Țin minte discul ales."
msgstr "Я запам'ятовую вибраний диск."

msgid "Ține subpagina"
msgstr "Утримати підсторінку"

