msgstr "Час запису обмежено через конфлікт із таймером %s"

msgid "Recorded files..."
msgstr "Записані файли..."

msgid "Recording"
msgstr "Запис"

msgid "Recording & Storage Setup"
msgstr "Записи та диски"

msgid "Recording Locations"
msgstr "Папки записів"

msgid "Recording(s) are in progress or coming up in few seconds!"
msgstr "Є записи, що тривають або почнуться за кілька секунд!"

msgid ""
"Recording(s) are in progress or coming up in few seconds!\n"
"Entering standby, after recording the box will shutdown."
msgstr ""
"Є записи, що тривають або почнуться за кілька секунд!\n"
"Перехід у режим очікування, після запису ресивер вимкнеться."

msgid "Recordings always have priority"
msgstr "Записи завжди мають пріоритет"

msgid "Recunoașterea textului"
msgstr "Розпізнавання тексту"

msgid "Recunoașterea textului (OCR)"
msgstr "Розпізнавання тексту (OCR)"

msgid ""
"Recunoașterea textului lucrează și acum: o cere traducerea subtitrărilor."
msgstr ""
"Розпізнавання тексту працює й зараз: воно потрібне для перекладу субтитрів."

msgid ""
"Recunoașterea textului nu e aleasă acum în Aspectul subtitrărilor: modelele "
"se folosesc după ce o alegi."
msgstr ""
"Розпізнавання тексту зараз не вибрано у «Вигляді субтитрів»: моделі "
"використовуються після того, як ти його вибереш."

msgid "Recunoașterea textului nu e pe receptor."
msgstr "Розпізнавання тексту немає на ресивері."

msgid "Recunosc cheia..."
msgstr "Впізнаю ключ..."

msgid "Recuperare cu un stick USB:"
msgstr "Відновлення з флешки USB:"

msgid "Recuperare prin Maintenance Mode (stick USB):"
msgstr "Відновлення через Maintenance Mode (USB-флешка):"

msgid "Redare"
msgstr "Відтворення"

msgid ""
"Redarea filmelor nu este pregătită: lipsește o componentă din programul "
"receptorului."
msgstr "Відтворення фільмів не готове: у програмі ресивера бракує компонента."

msgid "Redarea s-a oprit în browser."
msgstr "Відтворення в браузері зупинилося."

msgid "Redarea s-a oprit."
msgstr "Відтворення зупинилося."

