msgid ": mai mică"
msgstr ": менша"

msgid ": modulul de acum se oprește, iar"
msgstr ": поточний модуль зупиняється, а"

msgid ": recepționat"
msgstr ": прийнято"

msgid ": recepționat, calitate"
msgstr ": прийнято, якість"

msgid ": se recepționează"
msgstr ": триває прийом"

msgid ": se verifică alt transponder al satelitului ("
msgstr ": перевіряється інший транспондер супутника ("

#, python-format
msgid ": toată rețeaua, pornind de la %s MHz"
msgstr ": вся мережа, починаючи з %s МГц"

msgid ": transparență"
msgstr ": прозорість"

msgid ": ștergi modelul ("
msgstr ": видаляєш модель ("

msgid "; %s rânduri pierdute înainte"
msgstr "; %s рядків втрачено раніше"

