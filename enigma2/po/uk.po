msgstr "Перейменовано: %s"

msgid "Reducerea zgomotului"
msgstr "Зменшення шуму"

msgid "Redă"
msgstr "Відтворити"

msgid "Redă pe televizor"
msgstr "Відтворити на телевізорі"

