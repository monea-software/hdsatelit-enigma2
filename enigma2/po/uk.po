"означає хвилини до кінця поточної передачі або фільму, плюс дві. На "
"телевізорі: __DRUM_SOMN__."

#, python-format
msgid "Minutele se scriu ca număr întreg, de la %d la %d."
msgstr "Хвилини записуються цілим числом, від %d до %d."

msgid "Minutele și secundele"
msgstr "Хвилини і секунди"

msgid ""
