msgstr ""
"<code>POST /api/scanare-fluxuri</code>: valinta DAB+ / DVB-T2 -haun lopussa "
"televisiossa (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</code>, "
"<code>din_nou</code>, <code>porneste</code>)"

msgid ""
"<code>POST /api/scanare-opreste</code>: oprește căutarea sau închide "
"rezultatul rămas pe televizor"
msgstr ""
"<code>POST /api/scanare-opreste</code>: pysäyttää haun tai sulkee "
"televisioon jääneen tuloksen"

msgid ""
"<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;"
