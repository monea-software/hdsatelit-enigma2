msgstr "Televisio vastaanottaa"

#, python-format
msgid ""
"Televizorul primește %(format)s (până la %(canale)s) și îl decodează el."
msgstr ""
"Televisio vastaanottaa %(format)s (enintään %(canale)s) ja dekoodaa sen itse."

#, python-format
msgid ""
"Televizorul primește %(format)s numai stereo, deci receptorul îl decodează "
"el."
msgstr ""
"Televisio vastaanottaa %(format)s vain stereona, joten vastaanotin dekoodaa "
"sen itse."

