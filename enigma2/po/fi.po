msgstr "IP-televisio (IPTV)"

msgid ""
"Televiziunea nu dă fluxul în țara din care vine cererea. În browser fluxul "
"trece prin internetul acestui calculator sau telefon: aici ar trebui pornit "
"un VPN cu o adresă din țara canalului."
msgstr ""
"Televisio ei anna suoratoistoa maassa, josta pyyntö tulee. Selaimessa "
"suoratoisto kulkee tämän tietokoneen tai puhelimen internetin kautta: tässä "
"pitäisi käynnistää VPN, jonka osoite on kanavan maasta."

msgid ""
"Televiziunea terestră din România (rețeaua MUX1) e DVB-T2, iar imaginea "
"acordează deocamdată numai DVB-T. Căutarea va găsi 0 canale până la o "
"actualizare viitoare a imaginii."
msgstr ""
"Maanpäällinen televisio Romaniassa (MUX1-verkko) on DVB-T2, ja image "
"virittää toistaiseksi vain DVB-T:tä. Haku löytää 0 kanavaa, kunnes image "
"päivitetään."

msgid "Televizorul acesta nu primește această ieșire HDR."
msgstr "Tämä televisio ei hyväksy tätä HDR-lähtöä."

msgid ""
"Televizorul acesta nu primește „Ca la televizor”, deci primește „Ca la "
"calculator”."
msgstr ""
"Tämä televisio ei hyväksy ”Kuten televisiossa”, joten se saa ”Kuten "
"tietokoneessa”."

msgid ""
"Televizorul acesta nu primește „Ca la televizor”. Alegerea rămâne salvată."
msgstr ""
"Tämä televisio ei hyväksy ”Kuten televisiossa”. Valinta pysyy tallennettuna."

msgid ""
"Televizorul caută siglele numai după referință. După redenumirea după nume, "
"nu le mai arată."
msgstr ""
"TV etsii logot vain viitteen mukaan. Nimen mukaan nimeämisen jälkeen se ei "
"enää näytä niitä."

msgid ""
"Televizorul e stins sau în standby: subtitrările nu se citesc și nu se "
"traduc până se aprinde."
msgstr ""
"Televisio on sammutettu tai valmiustilassa: tekstityksiä ei lueta eikä "
"käännetä, ennen kuin se käynnistyy."

msgid "Televizorul legat (HDMI)"
msgstr "Kytketty televisio (HDMI)"

msgid ""
"Televizorul nu a spus ce sunet primește (poate e stins), deci receptorul "
"trimite stereo."
msgstr ""
"Televisio ei ole ilmoittanut, mitä ääntä se vastaanottaa (ehkä se on pois "
"päältä), joten vastaanotin lähettää stereona."

msgid "Televizorul nu a trecut pe acest canal."
msgstr "Televisio ei vaihtanut tälle kanavalle."

#, python-format
msgid ""
"Televizorul nu primește %(format)s, deci receptorul îl decodează și trimite "
"stereo."
msgstr ""
"Televisio ei vastaanota %(format)s, joten vastaanotin dekoodaa sen ja "
"lähettää stereona."

msgid ""
"Televizorul nu răspunde la CEC. Pornește SIMPLINK (sau CEC) din setările "
"televizorului."
msgstr ""
"Televisio ei vastaa CEC-komentoihin. Kytke SIMPLINK (tai CEC) päälle "
"television asetuksista."

