msgid "Numele pe televizor: %s, cerut de televizor la %s."
msgstr "Nimi televisiossa: %s, televisio kysyi sitä %s."

#, python-format
msgid "Numele pe televizor: %s."
msgstr "Nimi televisiossa: %s."

msgid "Numele plăcii de sunet are numai litere, cifre și : , _ - ."
msgstr "Äänilaitteen nimi sisältää vain kirjaimia, numeroita ja : , _ - ."

msgid ""
"Numele poate avea doar litere mici, cifre și semnele - _ . (cel mult 32)."
msgstr ""
"Nimessä voi olla vain pieniä kirjaimia, numeroita ja merkit - _ . (enintään "
"32)."

msgid "Numele postului de radio"
msgstr "Radioaseman nimi"

msgid "Numele public"
msgstr "Julkinen nimi"

msgid "Numele public are 2-40 de semne: litere, cifre, spațiu, punct, liniuță."
msgstr ""
"Julkisessa nimessä on 2-40 merkkiä: kirjaimia, numeroita, välilyönti, piste, "
"yhdysviiva."

msgid "Numele public e deja folosit de alt tester. Alege altul."
msgstr "Julkinen nimi on jo toisen testaajan käytössä. Valitse toinen."

msgid "Numele receptorului"
msgstr "Vastaanottimen nimi"

msgid "Numele receptorului pe televizor"
msgstr "Vastaanottimen nimi televisiossa"

msgid "Numele rețelei ascunse"
msgstr "Piilotetun verkon nimi"

msgid "Numele satelitului"
msgstr "Satelliitin nimi"

msgid "Numele satelitului are un caracter care nu se poate scrie în listă."
msgstr "Satelliitin nimessä on merkki, jota ei voi kirjoittaa luetteloon."

msgid "Numele satelitului e prea lung: cel mult %d de caractere."
msgstr "Satelliitin nimi on liian pitkä: enintään %d merkkiä."

msgid "Numele sau parola nu sunt bune. VPN-ul nu mai încearcă singur."
msgstr "Nimi tai salasana on väärä. VPN ei enää yritä itsestään."

msgid "Numele serverului NTP nu este valid."
msgstr "NTP-palvelimen nimi ei kelpaa."

msgid ""
"Numele serverului nu se găsește în rețea. Scrie adresa lui, de pildă "
"192.168.1.20."
msgstr ""
"Palvelimen nimeä ei löydy verkosta. Kirjoita sen osoite, esimerkiksi "
"192.168.1.20."

msgid "Numele setării, cu tastele 0-9"
msgstr "Asetuksen nimi, näppäimillä 0-9"

msgid ""
"Numele spune HD sau 4K, dar emițătorul îl anunță ca SD: filtrul „HD și 4K” "
"nu-l prinde. Filtrul „HD în nume, tip SD” din „Adaugă canale” le arată pe "
"toate, cu bife."
msgstr ""
"Nimi sanoo HD tai 4K, mutta lähettäjä ilmoittaa sen SD:nä: suodatin ”HD ja "
"4K” ei löydä sitä. Suodatin ”HD nimessä, SD-tyyppi” kohdassa ”Lisää kanavia” "
"näyttää ne kaikki, rasteilla."

msgid "Numele sursei (litere mici, cifre și -)"
msgstr "Lähteen nimi (pieniä kirjaimia, numeroita ja -)"

msgid "Numele sursei nu poate fi gol."
msgstr "Lähteen nimi ei voi olla tyhjä."

msgid "Numele sursei: litere mici, cifre și -"
msgstr "Lähteen nimi: pieniä kirjaimia, numeroita ja -"

msgid "Numele telecomenzii"
msgstr "Kaukosäätimen nimi"

msgid "Numele telecomenzii nu poate fi gol."
msgstr "Kaukosäätimen nimi ei voi olla tyhjä."

msgid "Numele tău pe forum"
msgstr "Nimesi foorumilla"

msgid "Numele tău pe forum e acum „%s”."
msgstr "Nimesi foorumilla on nyt ”%s”."

msgid "Numele și parola au fost șterse de pe receptor."
msgstr "Nimi ja salasana poistettiin vastaanottimelta."

msgid "Numele și parola contului"
msgstr "Tilin nimi ja salasana"

msgid ""
"Numele și parola contului HMA. După salvare nu se mai arată nicăieri. Se "
"scriu mai ușor din telefon, în interfața web."
msgstr ""
"HMA-tilin nimi ja salasana. Tallennuksen jälkeen niitä ei enää näytetä "
"missään. Ne on helpompi kirjoittaa puhelimella verkkokäyttöliittymässä."

msgid "Numele și parola de serviciu"
msgstr "Palvelun nimi ja salasana"

msgid "Numele și parola din fișier nu se folosesc: se scriu pe receptor."
msgstr ""
"Tiedostossa olevaa nimeä ja salasanaa ei käytetä: ne kirjoitetaan "
"vastaanottimelle."

msgid "Numele și parola sunt salvate. Nu se mai arată nicăieri."
msgstr "Nimi ja salasana on tallennettu. Niitä ei näytetä enää missään."

msgid "Numele, cu tastatura de pe ecran"
msgstr "Nimi, näytön näppäimistöllä"

msgid "Numele, cu tastele 0-9"
msgstr "Nimi, näppäimillä 0-9"

msgid ""
"Numerele DVB ale fluxului (pentru siglă): SID, TSID, ONID, namespace (hex)"
msgstr "Virran DVB-numerot (logoa varten): SID, TSID, ONID, namespace (hex)"

msgid "Număr de fișiere"
msgstr "Tiedostojen määrä"

msgid "Numărate de la ora"
msgstr "Laskettu kellonajasta"

msgid "Numărul canalului"
msgstr "Kanavan numero"

msgid "Numărul canalului din lista de canale."
msgstr "Kanavan numero kanavaluettelosta."

#, python-format
msgid "Numărul copiilor păstrate trebuie să fie între 1 și %d."
msgstr "Säilytettävien kopioiden määrän on oltava välillä 1-%d."

msgid "Numărul de bare"
msgstr "Palkkien määrä"

msgid "Numărul de secunde nu este bun."
msgstr "Sekuntien määrä ei kelpaa."

msgid "Numărul din lista de canale, cel la care duc cifrele telecomenzii."
msgstr "Kanavaluettelon numero, johon kaukosäätimen numerot johtavat."

msgid ""
"Numărul mare nu înseamnă procesor ocupat: include firele driverelor care "
"așteaptă."
msgstr ""
"Suuri luku ei tarkoita varattua prosessoria: se sisältää odottavat "
"ajurisäikeet."

msgid "Numărul operatorului"
msgstr "Operaattorin numero"

msgid "Numărul poziției (1-255)"
msgstr "Sijainnin numero (1-255)"

#, python-format
msgid "Numărul procesului (PID): %s"
msgstr "Prosessin numero (PID): %s"

msgid "Numărul rețelei (ONID)"
msgstr "Verkon numero (ONID)"

msgid "Numărul transponderului (TSID)"
msgstr "Transponderin numero (TSID)"

msgid "Numărul și numele"
msgstr "Numero ja nimi"

msgid "Numărătoarea opririlor"
msgstr "Pysäytyslaskuri"

msgid ""
"O adresă http:// merge numai pentru un server din rețeaua de acasă (de "
"exemplu 192.168.1.50); pentru un server de pe internet scrie https://."
msgstr ""
"http://-osoite toimii vain kotiverkon palvelimelle (esimerkiksi "
"192.168.1.50); internetin palvelimelle kirjoita https://."

msgid ""
"O altă placă e deja configurată. Pe televizor, aceeași întrebare apare la OK."
msgstr ""
"Toinen kortti on jo määritetty. Televisiossa sama kysymys tulee OK-"
"painikkeella."

msgid "O altă schimbare a rețelei încă lucrează. Așteaptă să se termine."
msgstr "Toinen verkon muutos on vielä käynnissä. Odota, että se päättyy."

msgid "O altă schimbare de LNB așteaptă confirmarea."
msgstr "Toinen LNB-muutos odottaa vahvistusta."

msgid "O altă valoare a receptorului nu se potrivește."
msgstr "Jokin muu vastaanottimen arvo ei täsmää."

msgid "O captură aleasă nu mai există. Alege din nou."
msgstr "Valittu kuvakaappaus ei ole enää olemassa. Valitse uudelleen."

msgid ""
"O cheie pleacă numai pe https:// sau spre un server din rețeaua de acasă. "
"Scrie adresa cu https://. Cheia nu a plecat nicăieri."
msgstr ""
"Avain lähetetään vain https://-protokollalla tai kotiverkon palvelimelle. "
"Kirjoita osoite https://-alkuisena. Avainta ei lähetetty minnekään."

msgid "O conectare Wi-Fi încă lucrează. Așteaptă să se termine sau oprește-o."
msgstr ""
"Wi-Fi-yhteys on vielä muodostumassa. Odota, että se päättyy, tai pysäytä se."

msgid "O copie așteaptă să fie pusă la loc la repornirea interfeței."
msgstr "Kopio odottaa palauttamista käyttöliittymän uudelleenkäynnistyksessä."

msgid "O copie se face deja. Așteaptă să se termine."
msgstr "Kopio on jo tekeillä. Odota, että se valmistuu."

msgid ""
"O copie se face singură înainte de fiecare salvare, aici și în interfața "
"web. Întoarcerea pune întâi lista de acum într-o copie nouă."
msgstr ""
"Kopio tehdään automaattisesti ennen jokaista tallennusta, täällä ja "
"verkkokäyttöliittymässä. Palautus laittaa ensin nykyisen listan uuteen "
"kopioon."

msgid "O cutie pentru toate rândurile"
msgstr "Yksi laatikko kaikille riveille"

msgid ""
"O căutare e deja în curs pe receptor. Așteaptă să se termine sau oprește-o."
msgstr ""
"Vastaanottimessa on jo haku käynnissä. Odota sen päättymistä tai pysäytä se."

msgid "O căutare e deja în curs."
msgstr "Haku on jo käynnissä."

msgid "O căutare sau o descărcare merge deja; așteaptă să se termine."
msgstr "Haku tai lataus on jo käynnissä; odota sen päättymistä."

msgid ""
"O data pe zi, in fundal, receptorul ia de pe stb.hdsatelit.com frecventele "
"si numele posturilor. Butonul Actualizeaza lista merge oricand."
msgstr ""
"Kerran päivässä taustalla vastaanotin hakee stb.hdsatelit.com-sivustolta "
"taajuudet ja asemien nimet. Päivitä luettelo -painike toimii milloin tahansa."

msgid "O dată pe minut"
msgstr "Kerran minuutissa"

msgid "O dată pe săptămână"
msgstr "Kerran viikossa"

msgid ""
"O dată pe zi, noaptea, numai felurile bifate, și imediat după o oprire "
"neașteptată a interfeței sau o actualizare care nu a reușit. Fără bifă "
"pleacă numai ce trimiți tu cu „Trimite acum”."
msgstr ""
"Kerran päivässä, yöllä, vain valitut tietotyypit, ja heti käyttöliittymän "
"odottamattoman pysähtymisen tai epäonnistuneen päivityksen jälkeen. Ilman "
"valintaa lähtee vain se, mitä lähetät ”Lähetä nyt” -painikkeella."

msgid ""
"O dată pe zi, în fundal, receptorul ia de pe stb.hdsatelit.com frecvențele "
"și numele posturilor. Butonul „Actualizează lista” merge oricând. <span "
"id=\"ultimaZilnica\"></span>"
msgstr ""
"Kerran päivässä, taustalla, vastaanotin hakee stb.hdsatelit.com-sivustolta "
"asemien taajuudet ja nimet. ”Päivitä luettelo” -painike toimii milloin "
"tahansa. <span id=\"ultimaZilnica\"></span>"

msgid "O eroare pe receptor."
msgstr "Virhe vastaanottimessa."

msgid "O greșeală, o idee sau o întrebare, direct echipei."
msgstr "Virhe, idea tai kysymys suoraan tiimille."

msgid "O lipești, iar receptorul recunoaște singur serviciul."
msgstr "Liität sen, ja vastaanotin tunnistaa palvelun itse."

msgid ""
"O listă de redare de pe disc nu se poate șterge din player, nici pe "
"televizor."
msgstr ""
"Levyllä olevaa soittolistaa ei voi poistaa soittimesta, ei edes televisiossa."

msgid "O margine e între 0 și 5 la sută din latura ei."
msgstr "Reuna on 0-5 prosenttia sivunsa pituudesta."

msgid "O notă despre emisiune. OK deschide tastatura."
msgstr "Muistiinpano ohjelmasta. OK avaa näppäimistön."

msgid "O pagină mai jos"
msgstr "Sivu alaspäin"

msgid "O pagină mai sus"
msgstr "Sivu ylöspäin"

msgid "O pagină în jos"
msgstr "Sivu alas"

msgid "O pagină în sus"
msgstr "Sivu ylös"

msgid ""
"O poză nu a putut fi urcată: trebuie să fie JPG sau PNG, de cel mult 4 MB."
msgstr "Kuvaa ei voitu ladata: sen on oltava JPG tai PNG, enintään 4 Mt."

msgid "O poți instala din nou oricând, din aceeași sursă."
msgstr "Voit asentaa sen uudelleen milloin tahansa samasta lähteestä."

msgid "O probă DiSEqC e deja deschisă pe televizor. Închide-o întâi."
msgstr "DiSEqC-testaus on jo avoinna televisiossa. Sulje se ensin."

msgid "O reîmprospătare e deja în lucru."
msgstr "Päivitys on jo käynnissä."

msgid "O reîncărcare e deja în curs."
msgstr "Uudelleenlataus on jo käynnissä."

msgid ""
"O scanare DAB+ sau DVB-T2 e deschisă pe televizor. Așteaptă să se termine "
"sau oprește-o."
msgstr ""
"DAB+- tai DVB-T2-haku on avoinna televisiossa. Odota sen päättymistä tai "
"pysäytä se."

msgid "O singură dată"
msgstr "Kerran"

msgid ""
"O singură dată sau repetat: în fiecare zi, o dată pe săptămână, de luni până "
"vineri sau în zilele alese."
msgstr ""
"Kerran tai toistuvasti: joka päivä, kerran viikossa, maanantaista "
"perjantaihin tai valittuina päivinä."

msgid "O singură limbă: forumul traduce singur."
msgstr "Yksi kieli: foorumi kääntää itse."

msgid ""
"O telecomandă USB (sau o tastatură) se bagă în receptor înainte; se vede "
"imediat."
msgstr ""
"USB-kaukosäädin (tai näppäimistö) liitetään vastaanottimeen ensin; se "
"tunnistetaan heti."

msgid ""
"O telecomandă cu infraroșu, alta decât a receptorului, nu se poate asocia "
"încă."
msgstr ""
"Muuta kuin vastaanottimen infrapunakaukosäädintä ei voi vielä parittaa."

msgid "O valoare a transponderului nu e bună: %s."
msgstr "Jokin transponderin arvo ei ole kelvollinen: %s."

msgid "O înregistrare e în curs."
msgstr "Tallennus on käynnissä."

msgid "O înregistrare e în curs: se oprește la revenire."
msgstr "Tallennus on käynnissä: se pysähtyy palattaessa."

msgid ""
"O înregistrare folosește acum antena. Comenzile pornesc după ce se termină."
msgstr "Tallennus käyttää nyt antennia. Komennot alkavat, kun se päättyy."

msgid ""
"O înregistrare folosește acum tunerul. Locul se schimbă după ce se termină."
msgstr "Tallennus käyttää nyt viritintä. Sijainti muuttuu, kun se päättyy."

msgid "O înregistrare programată nu poate porni: nu am unde să înregistrez."
msgstr "Ajastettu tallennus ei voi käynnistyä: ei ole minne tallentaa."

#, python-format
msgid "O înregistrare scrie acum pe acest disc: %s."
msgstr "Tallennus kirjoittaa nyt tälle levylle: %s."

msgid "O înregistrare începe în curând. Pornește scanarea detaliată după ea."
msgstr "Tallennus alkaa pian. Käynnistä yksityiskohtainen haku sen jälkeen."

#, python-format
msgid "O înregistrare începe în mai puțin de %d minute."
msgstr "Tallennus alkaa alle %d minuutin kuluttua."

msgid "O înregistrare începe în mai puțin de 6 minute."
msgstr "Tallennus alkaa alle 6 minuutin kuluttua."

msgid "OK"
msgstr "OK"

msgid "OK = da, EXIT = nu"
msgstr "OK = kyllä, EXIT = ei"

msgid "OK actualizează · Roșu șterge"
msgstr "OK päivittää · Punainen poistaa"

msgid "OK adaugă"
msgstr "OK lisää"

msgid ""
"OK adaugă canalul în buchetul din dreapta · cifrele scriu numele · HELP "
"ajutor"
msgstr ""
"OK lisää kanavan oikealla olevaan kanavanippuun · numerot kirjoittavat nimen "
"· HELP ohje"

msgid "OK add to playlist, MENU options, CH+ / CH- switch list"
msgstr "OK lisää soittolistaan, MENU asetukset, CH+ / CH- vaihda listaa"

msgid "OK alege"
msgstr "OK valitsee"

msgid "OK alege capturile, Verde le pune în mesaj."
msgstr "OK valitsee kuvakaappaukset, Vihreä lisää ne viestiin."

msgid "OK alege feedul pachetelor arătate."
msgstr "OK valitsee näytettävien pakettien syötteen."

msgid "OK alege feedul sau felul pachetelor arătate."
msgstr "OK valitsee näytettävien pakettien syötteen tai tyypin."

msgid ""
"OK alege latura: toate, sus, dreapta, jos sau stânga. Săgeata spre margine "
"duce latura aleasă spre marginea ecranului, săgeata opusă o aduce spre "
"mijloc. La toate laturile, Sus și Dreapta măresc cadrul, Jos și Stânga îl "
"micșorează. Potrivește cadrul până se vede întreg pe televizor."
msgstr ""
"OK valitsee sivun: kaikki, ylös, oikea, alas tai vasen. Reunaa kohti "
"osoittava nuoli vie valitun sivun näytön reunaan, vastakkainen nuoli tuo sen "
"keskemmälle. Kaikilla sivuilla Ylös ja Oikea suurentavat kehystä, Alas ja "
"Vasen pienentävät. Säädä kehystä, kunnes näet sen kokonaan televisiossa."

msgid ""
"OK alege orașul. Ora lui apare când „Ora din alt oraș” e în lista de rotire."
msgstr ""
"OK valitsee kaupungin. Sen aika näkyy, kun ”Aika toisessa kaupungissa” on "
"kiertoluettelossa."

msgid "OK alege valoarea."
msgstr "OK valitsee arvon."

msgid "OK alege valoarea. Luminozitatea se aplică după salvare."
msgstr "OK valitsee arvon. Kirkkaus tulee voimaan tallennuksen jälkeen."

msgid "OK alege valoarea. Se aplică după salvare."
msgstr "OK valitsee arvon. Se otetaan käyttöön tallennuksen jälkeen."

msgid "OK alege · Roșu arată tot"
msgstr "OK valitsee · Punainen näyttää kaikki"

msgid ""
"OK alegi canalele ale căror piste se citesc acum · Stânga înapoi la nume"
msgstr "OK valitsee kanavat, joiden raidat luetaan nyt · Vasen takaisin nimeen"

msgid "OK arată canalele"
msgstr "OK näyttää kanavat"

msgid "OK arată de ce"
msgstr "OK näyttää syyn"

msgid "OK arată de ce · Verde instalează înlocuitorul"
msgstr "OK näyttää syyn · Vihreä asentaa korvaavan"

msgid ""
"OK arată fișierele de setări ale serverelor SSH și FTP, așa cum sunt pe "
"receptor."
msgstr ""
"OK näyttää SSH- ja FTP-palvelinten asetustiedostot sellaisina kuin ne ovat "
"vastaanottimella."

msgid ""
"OK arată fișierele de setări ale serverului SSH, așa cum sunt pe receptor."
msgstr ""
"OK näyttää SSH-palvelimen asetustiedostot sellaisina kuin ne ovat "
"vastaanottimessa."

msgid "OK ascunde canalele"
msgstr "OK piilottaa kanavat"

msgid "OK bifează sau debifează"
msgstr "OK merkitsee tai poistaa merkinnän"

msgid "OK bifează sau debifează · pe titlul grupei: toată grupa"
msgstr "OK merkitsee tai poistaa merkinnän · ryhmän otsikossa: koko ryhmä"

msgid ""
"OK bifează și trece mai jos · tastele colorate lucrează pe rândurile bifate"
msgstr ""
"OK rastittaa ja siirtyy alemmas · väripainikkeet toimivat rastitetuilla "
"riveillä"

msgid "OK caută"
msgstr "OK hakee"

msgid ""
"OK caută singur serverul din casă (LibreTranslate sau Ollama) și îl "
"probează. Adresa se poate scrie și de mână, mai jos."
msgstr ""
"OK hakee itse kotisi palvelimen (LibreTranslate tai Ollama) ja testaa sen. "
"Osoitteen voi kirjoittaa myös käsin, alempana."

msgid "OK caută în rețea"
msgstr "OK etsii verkosta"

msgid "OK deschide"
msgstr "OK avaa"

msgid ""
"OK deschide adresele puse de mână, listele predefinite și pornirea DVB-I."
msgstr ""
"OK avaa käsin lisätyt osoitteet, valmiit listat ja DVB-I:n käyttöönoton."

msgid ""
"OK deschide buchetul · Stânga / Dreapta: coloana · < anulează · > refă · "
"HELP ajutor"
msgstr ""
"OK avaa kanavanipun · Vasen / Oikea: sarake · < kumoa · > tee uudelleen · "
"HELP ohje"

msgid ""
"OK deschide lista limbilor: cele din imagine, cele descărcate și cele care "
"se pot descărca, cu mărimea fiecăreia."
msgstr ""
"OK avaa kielten listan: imagessa olevat, ladatut ja ladattavissa olevat, "
"kunkin kokoineen."

msgid "OK deschide meniul, cu „Locul înregistrărilor”."
msgstr "OK avaa valikon, jossa on ”Tallennusten sijainti”."

msgid ""
"OK deschide pașii pentru serviciul ales: contul, cheia gratuită, cota și ce "
"se întâmplă la depășire."
msgstr ""
"OK avaa valitun palvelun vaiheet: tilin, ilmaisen avaimen, kiintiön ja mitä "
"tapahtuu, kun se ylittyy."

msgid "OK deschide sau închide toți sateliții"
msgstr "OK avaa tai sulkee kaikki satelliitit"

msgid "OK deschide tastatura."
