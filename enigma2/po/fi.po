msgid ""
"<code>GET /api/accel</code>: accelerarea 2D pe placa video: dacă receptorul "
"o are (<code>disponibila</code>), setarea pentru următoarea pornire "
"(implicit pornită) și ce s-a hotărât la pornirea de acum"
msgstr ""
"<code>GET /api/accel</code>: 2D-kiihdytys näytönohjaimessa: onko "
"vastaanottimessa sitä (<code>disponibila</code>), asetus seuraavaa "
"käynnistystä varten (oletuksena päällä) ja mitä päätettiin nykyisessä "
"käynnistyksessä"

msgid ""
"<code>GET /api/acces-canal</code>: accesul canalului care rulează (criptat "
"sau liber), sistemele, CAID-urile și ce decriptează modulul acum"
msgstr ""
"<code>GET /api/acces-canal</code>: käynnissä olevan kanavan pääsy (salattu "
"tai vapaa), järjestelmät, CAID:t ja mitä moduuli purkaa nyt"

msgid ""
"<code>GET /api/acces-conditionat</code>: modulele de acces condiționat pe "
"feluri (câmpul <code>fel</code>: numele felului, așa cum îl are receptorul; "
"întâi modulele obișnuite, apoi serverele de carduri), cel ales la pornirea "
"receptorului, cele care rulează, procesul care lucrează și memoria lui, "
"comanda în curs sau ultimul rezultat, dacă receptorul decriptează acum"
msgstr ""
"<code>GET /api/acces-conditionat</code>: ehdollisen pääsyn moduulit "
"tyypeittäin (kenttä <code>fel</code>: tyypin nimi, sellaisena kuin "
"vastaanotin sen tuntee; ensin tavalliset moduulit, sitten korttipalvelimet), "
"vastaanottimen käynnistyksessä valittu, käynnissä olevat, toimiva prosessi "
"ja sen muisti, käynnissä oleva komento tai viimeisin tulos, purkaako "
"vastaanotin nyt"

msgid ""
"<code>GET /api/acces-ssh</code>: intrarea pe receptor prin SSH: felul "
"parolei de administrator (fără parola însăși), cheile SSH (tipul, amprenta, "
"comentariul), „Fără parolă în rețeaua locală”, stările periculoase "
"(<code>alarme</code>), lucrarea în curs și rezultatul ultimei comenzi"
msgstr ""
"<code>GET /api/acces-ssh</code>: pääsy vastaanottimeen SSH:n kautta: "
"järjestelmänvalvojan salasanan tyyppi (ilman itse salasanaa), SSH-avaimet "
"(tyyppi, sormenjälki, kommentti), ”Ei salasanaa paikallisverkossa”, "
"vaaralliset tilat (<code>alarme</code>), käynnissä oleva työ ja viimeisimmän "
"komennon tulos"

msgid ""
"<code>GET /api/acces-ssh</code>: parola receptorului (FTP, SSH și SFTP): "
"felul parolei lui root (fără parola însăși), dacă merge FTP (<code>ftp</"
"code>), cheile SSH (tipul, amprenta, comentariul), opțiunea Fără parolă în "
"rețeaua locală, stările periculoase (<code>alarme</code>), lucrarea în curs "
"și rezultatul ultimei comenzi"
msgstr ""
"<code>GET /api/acces-ssh</code>: vastaanottimen salasana (FTP, SSH ja SFTP): "
"root-salasanan tyyppi (ilman itse salasanaa), toimiiko FTP (<code>ftp</"
"code>), SSH-avaimet (tyyppi, sormenjälki, kommentti), vaihtoehto Ei "
"salasanaa paikallisverkossa, vaaratilat (<code>alarme</code>), käynnissä "
"oleva tehtävä ja viimeisen komennon tulos"

msgid ""
"<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, "
"<code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, "
"<code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/"
"actualizari-reporneste</code>: actualizările prin pachete de pe stb."
"hdsatelit.com (starea, căutarea, instalarea, verificarea zilnică, repornirea "
"interfeței după instalare)"
msgstr ""
"<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, "
"<code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, "
"<code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/"
"actualizari-reporneste</code>: päivitykset pakettien kautta osoitteesta stb."
"hdsatelit.com (tila, haku, asennus, päivittäinen tarkistus, käyttöliittymän "
"uudelleenkäynnistys asennuksen jälkeen)"

msgid ""
"<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;"
"orase=1]</code>: afișajul din față: ce arată acum (măștile celor 4 cifre și "
"textul), lista de rotire, mesajele scurte, așteptarea, setările, minutarul "
"și cronometrul; cu <code>grupa</code> alegerile grupei cu desenul valorii de "
"acum, cu <code>catalog=1</code> toate alegerile (căutarea), cu "
"<code>orase=1</code> fusurile pentru ora din alt oraș"
msgstr ""
"<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;"
"orase=1]</code>: etupaneelin näyttö: mitä se näyttää nyt (4 numeron maskit "
"ja teksti), kiertolista, lyhyet viestit, odotus, asetukset, laskuri ja "
"sekuntikello; <code>grupa</code>-parametrilla ryhmän valinnat nykyisen arvon "
"piirroksella, <code>catalog=1</code>-parametrilla kaikki valinnat (haku), "
"<code>orase=1</code>-parametrilla aikavyöhykkeet toisen kaupungin ajalle"

msgid ""
"<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: "
"tunerele, LNB-ul, semnalul canalului curent și unghiurile antenei spre "
"fiecare satelit (numai citire)"
msgstr ""
"<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: "
"virittimet, LNB, nykyisen kanavan signaali ja antennin kulmat kullekin "
"satelliitille (vain luku)"

msgid ""
"<code>GET /api/calitate-imagine</code>: calitatea imaginii: „Reglajele după "
"canal”, profilul canalului de acum, cele 9 profiluri (SD, HD, 4K x SDR, "
"HDR10, HLG) cu reglajele lor, ieșirea HDR (alegerile primite de televizor, "
"ce e scris acum, întrebarea în curs) și textul brut al blocului de calitate"
msgstr ""
"<code>GET /api/calitate-imagine</code>: kuvanlaatu: ”Asetukset kanavittain”, "
"nykyisen kanavan profiili, 9 profiilia (SD, HD, 4K x SDR, HDR10, HLG) "
"asetuksineen, HDR-lähtö (television vastaanottamat valinnat, mitä nyt on "
"kirjoitettu, käynnissä oleva kysymys) ja laatulohkon raakateksti"

msgid "<code>GET /api/canale-acum</code>: canalul de pe televizor"
msgstr "<code>GET /api/canale-acum</code>: televisiossa oleva kanava"

msgid ""
"<code>GET /api/canale-buchete?fila=tv|radio</code>: listele de ales și lista "
"pe care stă televizorul"
msgstr ""
"<code>GET /api/canale-buchete?fila=tv|radio</code>: valittavat listat ja "
"lista, jolla televisio on"

msgid ""
"<code>GET /api/canale-epg?refs=r1,r2</code>: emisiunea de acum și cea "
"următoare, cel mult 50 de canale"
msgstr ""
"<code>GET /api/canale-epg?refs=r1,r2</code>: nykyinen ja seuraava ohjelma, "
"enintään 50 kanavalle"

msgid ""
"<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,"
"v2&amp;de_la=&amp;cate=</code>: rândurile, pe pagini de cel mult 200, cu "
"grupele de filtre și numerele lor"
msgstr ""
"<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,"
"v2&amp;de_la=&amp;cate=</code>: rivit, sivuittain enintään 200, "
"suodatinryhmineen ja lukumäärineen"

msgid ""
"<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: sigla canalului; la "
"listele de canale, 503 când receptorul are prea multe cereri în lucru și 504 "
"când nu termină în 10 s"
msgstr ""
"<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: kanavan logo; "
"kanavalistoissa 503, kun vastaanottimella on liikaa pyyntöjä käynnissä, ja "
"504, kun se ei valmistu 10 sekunnissa"

msgid ""
"<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Caută setări”: meniurile "
"și setările care au textul în nume (fără diacritice), cu drumul din meniu, "
"valoarea de acum și pagina web"
msgstr ""
"<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: ”Hae asetuksia”: valikot "
"ja asetukset, joiden nimessä on teksti (ilman diakriittisiä merkkejä), "
"valikkopolkuineen, nykyisine arvoineen ja verkkosivuineen"

msgid ""
"<code>GET /api/cautare-actualizeaza-stare</code>: cât a citit "
"(transponderul, canalele) sau rezultatul"
msgstr ""
"<code>GET /api/cautare-actualizeaza-stare</code>: kuinka paljon se on "
"lukenut (transponderi, kanavat) tai tulos"

msgid ""
"<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;"
"acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,"
"hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code>: căutarea de "
"canale, cu aceleași rânduri de filtre ca pe televizor și pistele știute ale "
"fiecărui canal"
msgstr ""
"<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;"
"acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,"
"hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code>: kanavahaku, "
"samoilla suodatinriveillä kuin televisiossa ja kunkin kanavan tunnetut raidat"

msgid ""
"<code>GET /api/ceas</code>: ora receptorului, fusul orar, sursa orei "
"(<code>auto</code>: Internet, apoi transponder; <code>ntp</code>; <code>dvb</"
"code>), serverul NTP, alegerile lor și ultima sincronizare"
msgstr ""
"<code>GET /api/ceas</code>: vastaanottimen aika, aikavyöhyke, ajan lähde "
"(<code>auto</code>: internet, sitten transponderi; <code>ntp</code>; "
"<code>dvb</code>), NTP-palvelin, niiden valinnat ja viimeisin synkronointi"

msgid ""
"<code>GET /api/copie-setari[?cauta=1]</code>: copia setărilor: stickurile și "
"discurile (<code>implicit</code> = stickul de actualizare), copiile găsite "
"(data, versiunea imaginii, acest receptor sau altul), copia automată, "
"ultimul rezultat; niciodată conținutul copiei"
msgstr ""
"<code>GET /api/copie-setari[?cauta=1]</code>: asetusten kopio: USB-"
"muistitikut ja levyt (<code>implicit</code> = päivitysmuistitikku), löydetyt "
"kopiot (päivämäärä, image-versio, tämä vastaanotin tai toinen), "
"automaattinen kopio, viimeinen tulos; ei koskaan kopion sisältöä"

msgid ""
"<code>GET /api/dabt2?fel=dab|t2</code>: fereastra „Fluxuri și setări” a "
"DAB+ / DVB-T2 din satelit: fluxurile cu poziția, numele, numărul de posturi "
"și starea, setările, Despre, lucrul în curs și <code>repunere</code> "
"(canalul de dinainte, pornit din nou după „Învață posturile”: starea și "
"mesajul)"
msgstr ""
"<code>GET /api/dabt2?fel=dab|t2</code>: ”Virrat ja asetukset”-ikkuna "
"satelliitin DAB+ / DVB-T2: virrat sijainnilla, nimellä, asemien määrällä ja "
"tilalla, asetukset, Tietoja, käynnissä oleva työ ja <code>repunere</code> "
"(edellinen kanava, käynnistetty uudelleen ”Opi asemat” jälkeen: tila ja "
"viesti)"

msgid ""
"<code>GET /api/descarcare-subtitrari</code> și <code>POST /api/descarcare-"
"subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, "
"<code>-verifica</code>, <code>-conturi</code>: descărcarea subtitrărilor "
"(numele, parolele și cheile numai în corpul cererii); pe un canal TV sau la "
"o înregistrare și <code>-film</code> (<code>fapta=identifica|alege|titlu|"
"local</code>: filmul din ghid, identificat în Wikidata) și <code>-potrivire</"
"code> (<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|"
"opreste</code>: potrivirea subtitrării pe canal)"
msgstr ""
"<code>GET /api/descarcare-subtitrari</code> ja <code>POST /api/descarcare-"
"subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, "
"<code>-verifica</code>, <code>-conturi</code>: tekstitysten lataaminen "
"(käyttäjänimet, salasanat ja avaimet vain pyynnön rungossa); "
"televisiokanavalla tai tallenteelle, sekä <code>-film</code> "
"(<code>fapta=identifica|alege|titlu|local</code>: elokuva ohjelmaoppaasta, "
"tunnistettu Wikidatasta) ja <code>-potrivire</code> (<code>fapta=urmatoarea|"
"dinainte|plus|minus|reclama|acum|viteza|opreste</code>: tekstityksen "
"sovittaminen kanavalle)"

msgid ""
"<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: "
"mesajul de pe ecranul negru (de ce nu se vede imaginea) și analiza fluxului "
"canalului"
msgstr ""
"<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: "
"viesti mustalla näytöllä (miksi kuvaa ei näy) ja kanavan virran analyysi"

msgid ""
"<code>GET /api/egalizator</code>: egalizatorul posturilor de radio: pornit "
"sau oprit, benzile, presetarea, modul de noapte, reglajele postului de acum "
"și dacă merge la acest post; <code>POST /api/egalizator-seteaza</code>: "
"schimbă și aplică pe loc"
msgstr ""
"<code>GET /api/egalizator</code>: radioasemien taajuuskorjain: päällä tai "
"pois, kaistat, esiasetus, yötila, nykyisen aseman asetukset ja toimiiko se "
"tällä asemalla; <code>POST /api/egalizator-seteaza</code>: muuttaa ja ottaa "
"heti käyttöön"

msgid ""
"<code>GET /api/filme</code>: filmul care merge (poziția, lungimea, starea, "
"locul ținut minte, mesajul de refuz) și setările filmelor; <code>GET /api/"
"filme-lista</code>: filmele din dosarul listei de filme, cu locul rămas"
msgstr ""
"<code>GET /api/filme</code>: toistettava elokuva (sijainti, pituus, tila, "
"muistettu kohta, hylkäysviesti) ja elokuvien asetukset; <code>GET /api/filme-"
"lista</code>: elokuvaluettelokansion elokuvat, kunkin pysähtymiskohta"

msgid ""
"<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: familiile libere de pe "
"Google Fonts și fonturile deja descărcate"
msgstr ""
"<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: Google Fontsin ilmaiset "
"fonttiperheet ja jo ladatut fontit"

msgid ""
"<code>GET /api/gasire-semnal-stare</code>: nivelul, calitatea, BER-ul și "
"verdictul măsurării"
msgstr ""
"<code>GET /api/gasire-semnal-stare</code>: taso, laatu, BER ja mittauksen "
"tulos"

msgid ""
"<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: "
"transponderele unui satelit"
msgstr ""
"<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: "
"satelliitin transponderit"

msgid ""
"<code>GET /api/gasire-semnal</code>: tunerele, sateliții, transponderul de "
"la care pornește măsurarea și starea ei"
msgstr ""
"<code>GET /api/gasire-semnal</code>: virittimet, satelliitit, transponderi, "
"josta mittaus alkaa, ja sen tila"

msgid ""
"<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-"
"emisiune?ref=&amp;id=</code>: ghidul unui canal (fără <code>ref</code>, "
"canalul de pe televizor) și o emisiune cu descrierile"
msgstr ""
"<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-"
"emisiune?ref=&amp;id=</code>: kanavan ohjelmaopas (ilman <code>ref</code> "
"televisiossa oleva kanava) ja ohjelma kuvauksineen"

msgid ""
"<code>GET /api/import-surse?cauta=1</code>: copiile de canale și setări "
"găsite pe stick-uri și pe receptor, starea căutării și a importului"
msgstr ""
"<code>GET /api/import-surse?cauta=1</code>: USB-muistitikuilta ja "
"vastaanottimesta löydetyt kanava- ja asetuskopiot, haun ja tuonnin tila"

msgid ""
"<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|"
"retea|hdmi</code>: ecranele „System Information”, cu aceleași texte ca pe "
"televizor"
msgstr ""
"<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|"
"retea|hdmi</code>: ”System Information” -näytöt, samoilla teksteillä kuin "
"televisiossa"

msgid ""
"<code>GET /api/interfete-cam?reincarca=1</code>: modulele de acces "
"condiționat instalate și interfețele lor web, cu numele date de fiecare "
"modul (fără <code>reincarca</code> poate veni o căutare făcută cu câteva "
"secunde înainte)"
msgstr ""
"<code>GET /api/interfete-cam?reincarca=1</code>: asennetut ehdollisen pääsyn "
"moduulit ja niiden verkkokäyttöliittymät, kunkin moduulin antamilla nimillä "
"(ilman <code>reincarca</code> saattaa tulla muutamaa sekuntia aiemmin tehty "
"haku)"

msgid ""
"<code>GET /api/jurnal</code>: jurnalul de versiuni (ce s-a schimbat la "
"fiecare actualizare)"
msgstr ""
"<code>GET /api/jurnal</code>: versioloki (mitä muuttui kussakin "
"päivityksessä)"

msgid ""
"<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: "
"programele din imagine cu licența fiecăruia și textul unei licențe"
msgstr ""
"<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: "
"imagen ohjelmat kunkin lisenssillä ja lisenssin teksti"

msgid ""
"<code>GET /api/limba-interfata</code>: limba meniurilor de acum și lista "
"limbilor, cu numele de pe televizor"
msgstr ""
"<code>GET /api/limba-interfata</code>: valikoiden nykyinen kieli ja kielten "
"luettelo, televisiossa näkyvillä nimillä"

msgid ""
"<code>GET /api/limbi</code>: limba sunetului și a subtitrărilor: cele 7 "
"setări cu alegerile lor, ce se ține minte pe canalul de acum și canalele cu "
"alegeri de mână"
msgstr ""
"<code>GET /api/limbi</code>: äänen ja tekstitysten kieli: 7 asetusta "
"valintoineen, mitä nykyisellä kanavalla muistetaan, ja kanavat, joilla on "
"manuaaliset valinnat"

msgid ""
"<code>GET /api/liste-implicite</code>: listele de canale gata făcute și "
"drumurile spre scanare și import"
msgstr ""
"<code>GET /api/liste-implicite</code>: valmiit kanavaluettelot ja polut "
"kanavahakuun ja tuontiin"

msgid ""
"<code>GET /api/lnb-stare</code>: verificarea semnalului, întrebarea și "
"secundele rămase"
msgstr ""
"<code>GET /api/lnb-stare</code>: signaalin tarkistus, kysymys ja jäljellä "
"olevat sekunnit"

msgid ""
"<code>GET /api/lnb?slot=N</code>: LNB-urile tunerului, cu valorile, "
"alegerile și „Probă de calcul” (numai citire)"
msgstr ""
"<code>GET /api/lnb?slot=N</code>: virittimen LNB:t, arvoineen, valintoineen "
"ja ”Testilaskenta” (vain luku)"

msgid ""
"<code>GET /api/locul[?tara=RO]</code>: locul antenei pentru motorul USALS, "
"țările și orașele unei țări (tabelul din imagine)"
msgstr ""
"<code>GET /api/locul[?tara=RO]</code>: antennin sijainti USALS-moottorille, "
"maat ja maan kaupungit (imagen taulukko)"

msgid ""
"<code>GET /api/meniu</code>: tot meniul receptorului (tasta MENU), cu "
"aceleași intrări ca pe televizor pentru nivelul ales"
msgstr ""
"<code>GET /api/meniu</code>: vastaanottimen koko valikko (MENU-näppäin), "
"samoilla kohdilla kuin televisiossa valitulle tasolle"

msgid ""
"<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, "
"<code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: modul sigur (opririle "
"interfeței, alegerile de după ele) și fișierele lui ca text"
msgstr ""
"<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, "
"<code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: vikasietotila "
"(käyttöliittymän pysäytykset, niiden jälkeiset valinnat) ja sen tiedostot "
"tekstinä"

msgid ""
"<code>GET /api/motor-comenzi</code>: tunerele cu motor, sateliții și starea "
"comenzilor"
msgstr ""
"<code>GET /api/motor-comenzi</code>: moottorilliset virittimet, satelliitit "
"ja komentojen tila"

msgid ""
"<code>GET /api/motor-comenzi?urma=N</code>: urma comenzilor trimise "
"motorului (ultimele N, implicit 100, cel mult 500, cele mai noi întâi): ora, "
"comanda, unghiul, cine a cerut-o (televizorul, ecranul sau pagina motorului, "
"Găsire semnal, reacordarea), poziția crezută de receptor; numai citire, din "
"<code>/home/root/logs/hds-motor.log</code>"
msgstr ""
"<code>GET /api/motor-comenzi?urma=N</code>: moottorille lähetettyjen "
"komentojen jälki (viimeiset N, oletus 100, enintään 500, uusimmat ensin): "
"aika, komento, kulma, kuka sitä pyysi (televisio, näyttö tai moottorisivu, "
"Signaalin etsintä, uudelleenviritys), vastaanottimen olettama sijainti; vain "
"luku, tiedostosta <code>/home/root/logs/hds-motor.log</code>"

msgid ""
"<code>GET /api/motor</code>: starea rotirii antenei (de unde, pana unde, "
"poziția estimată, cât mai are de mers)"
msgstr ""
"<code>GET /api/motor</code>: antennin kääntymisen tila (mistä, mihin, "
"arvioitu sijainti, kuinka paljon vielä matkaa)"

msgid ""
"<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;"
"xp=&amp;yp=</code>: mouse-ul pe ecranul televizorului, ca în emulator: "
"<code>xp</code>, <code>yp</code> = locul în procente din ecran (sau <code>x</"
"code>, <code>y</code> în pixelii ecranului, 1920x1080); <code>clic</code> "
"alege rândul de sub mouse, iar pe rândul ales sau cu <code>clicuri=2</code> "
"dă OK; un buton colorat = tasta lui; <code>drag</code> (cu <code>x0p</code>, "
"<code>y0p</code> = locul apăsării, <code>nou=1</code> la prima mișcare) și "
"<code>dragend</code> = trasul pe bara de derulare; <code>rotita&amp;"
"pasi=-12..12</code> = sus/jos (3 pași sau mai mulți = o pagină); "
"<code>dreapta</code> = Meniu, <code>mijloc</code> = Ieșire. Răspunsul spune "
"ce s-a făcut (<code>facut</code>: selectie, ok, buton, bara, derulare, "
"tasta, nimic). Din browser, cu POST și antetul <code>X-HDS-CSRF</code>, ca "
"<code>remotecontrol</code>"
msgstr ""
"<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;"
"xp=&amp;yp=</code>: hiiri televisioruudulla, kuten emulaattorissa: <code>xp</"
"code>, <code>yp</code> = paikka prosentteina näytöstä (tai <code>x</code>, "
"<code>y</code> näytön pikseleinä, 1920x1080); <code>clic</code> valitsee "
"rivin hiiren alta, ja valitulla rivillä tai <code>clicuri=2</code> antaa OK; "
"värillinen painike = sen näppäin; <code>drag</code> (jossa <code>x0p</code>, "
"<code>y0p</code> = painalluskohta, <code>nou=1</code> ensimmäisessä "
"liikkeessä) ja <code>dragend</code> = vetäminen vierityspalkissa; "
"<code>rotita&amp;pasi=-12..12</code> = ylös/alas (3 askelta tai enemmän = "
"sivu); <code>dreapta</code> = Valikko, <code>mijloc</code> = Poistu. Vastaus "
"kertoo mitä tehtiin (<code>facut</code>: selectie, ok, buton, bara, "
"derulare, tasta, nimic). Selaimesta, POST-pyynnöllä ja <code>X-HDS-CSRF</"
"code>-otsikolla, kuten <code>remotecontrol</code>"

msgid ""
"<code>GET /api/navigator</code>: navigatorul web de pe televizor (deschis "
"sau nu, modul, desenul, felul câmpului ales, mărirea; fără adrese), setările "
"lui și favoritele"
msgstr ""
"<code>GET /api/navigator</code>: televisiossa oleva verkkoselain (auki vai "
"ei, tila, kuva, valitun kentän tyyppi, suurennus; ei osoitteita), sen "
"asetukset ja suosikit"

msgid ""
"<code>GET /api/ocr-limbi</code>: limbile recunoașterii textului (în imagine, "
"descărcate, de descărcat, cu mărimea și starea fiecăreia) și locul pentru "
"modelele noi"
msgstr ""
"<code>GET /api/ocr-limbi</code>: tekstintunnistuksen kielet (imagessa, "
"ladatut, ladattavissa, kunkin koko ja tila) ja paikka uusille malleille"

msgid ""
"<code>GET /api/pasi-decriptare</code>: pașii decriptării canalului de pe "
"televizor (cererea către modulul de acces, răspunsurile și timpul lor, "
"imaginea decriptată, mesajele modulului CI), numai cu setarea Arată pașii "
"decriptării pornită"
msgstr ""
"<code>GET /api/pasi-decriptare</code>: televisiossa olevan kanavan salauksen "
"purkamisen vaiheet (pyyntö pääsymoduulille, vastaukset ja niiden aika, "
"purettu kuva, CI-moduulin viestit), vain kun asetus Näytä salauksen "
"purkuvaiheet on päällä"

msgid ""
"<code>GET /api/paza-model</code>: paza de model (receptorul pentru care e "
"făcută imaginea și amprenta acestuia); <code>GET /api/actualizare-pachete</"
"code>: pachetele de actualizare găsite și verdictul pazei pentru fiecare"
msgstr ""
"<code>GET /api/paza-model</code>: mallivartija (vastaanotin, jolle image on "
"tehty, ja sen sormenjälki); <code>GET /api/actualizare-pachete</code>: "
"löydetyt päivityspaketit ja vartijan päätös kullekin"

msgid ""
"<code>GET /api/paznic</code>: paznicul receptorului: starea, setările "
"(<code>interfata</code>, <code>asteptare</code> în secunde), alegerile și "
"ultimele rânduri din jurnalul lui"
msgstr ""
"<code>GET /api/paznic</code>: vastaanottimen vahtikoira: tila, asetukset "
"(<code>interfata</code>, <code>asteptare</code> sekunteina), valinnat ja sen "
"lokin viimeiset rivit"

msgid ""
"<code>GET /api/portal</code>: starea HbbTV a canalului care rulează (da, nu "
"are, încă nu se știe), cu mesajul arătat pe televizor la tasta PORTAL"
msgstr ""
"<code>GET /api/portal</code>: käynnissä olevan kanavan HbbTV-tila (kyllä, ei "
"ole, ei vielä tiedossa), viestillä, joka näytetään televisiossa PORTAL-"
"näppäimellä"

msgid ""
"<code>GET /api/procesor</code>: procesorul: modul de lucru, modurile care "
"există pe receptor, frecvența setată și cea de acum, temperatura, tensiunea, "
"procentul folosit și timpul pe fiecare treaptă"
msgstr ""
"<code>GET /api/procesor</code>: prosessori: toimintatila, vastaanottimessa "
"olevat tilat, asetettu ja nykyinen taajuus, lämpötila, jännite, käytetty "
"prosentti ja aika kullakin taajuusportaalla"

msgid ""
"<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: postul de "
"radio care merge, cu textele ecranului radio; barele și nivelul sunetului"
msgstr ""
"<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: toistettava "
"radioasema, radionäytön teksteillä; palkit ja äänitaso"

msgid ""
"<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: apasă o "
"tastă ca de pe telecomanda receptorului (coduri de tastă Linux, de exemplu "
"352 pentru OK); cu <code>lung=1</code>, apăsare lungă"
msgstr ""
"<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: painaa "
"näppäintä kuten vastaanottimen kaukosäätimestä (Linux-näppäinkoodit, "
"esimerkiksi 352 OK:lle); <code>lung=1</code> tarkoittaa pitkää painallusta"

msgid ""
"<code>GET /api/scanare-stare</code>: starea căutării (procent, canale "
"găsite, transpondere, timp rămas, rezultat)"
msgstr ""
"<code>GET /api/scanare-stare</code>: haun tila (prosentti, löydetyt kanavat, "
"transponderit, jäljellä oleva aika, tulos)"

msgid ""
"<code>GET /api/scanare-ultima</code>: rezultatul ultimei scanări de canale, "
"ținut până la scanarea următoare: <code>inceput</code>, <code>sfarsit</"
"code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, "
"<code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, "
"<code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, "
"<code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, "
"iar când se știu <code>tsid</code>, <code>onid</code>, <code>nid</code> și, "
"la cablu, <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:"
"ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, "
"<code>caid</code>, iar când operatorul trimite numerele canalelor <code>lcn</"
"code> și <code>lcn_vizibil</code>): toate serviciile citite din SDT, vechi "
"și noi, și <code>retele</code> (<code>nid</code>, <code>nume</code>, "
"<code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, "
"<code>privati</code>): rețelele din tabela NIT; câmpurile din tabela NIT "
"(<code>nid</code>, <code>lcn</code>, <code>retele</code>) apar la căutarea "
"în rețea și la scanarea pe cablu pe o singură frecvență; numai citire, lista "
"de canale nu se schimbă; fără nicio scanare de la pornire, <code>result</"
"code> false"
msgstr ""
"<code>GET /api/scanare-ultima</code>: viimeisimmän kanavahaun tulos, "
"säilytetään seuraavaan hakuun asti: <code>inceput</code>, <code>sfarsit</"
"code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, "
"<code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, "
"<code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, "
"<code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, "
"ja kun tunnetaan <code>tsid</code>, <code>onid</code>, <code>nid</code> ja "
"kaapelilla <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:"
"ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, "
"<code>caid</code>, ja kun operaattori lähettää kanavanumerot <code>lcn</"
"code> ja <code>lcn_vizibil</code>): kaikki SDT:stä luetut palvelut, vanhat "
"ja uudet, ja <code>retele</code> (<code>nid</code>, <code>nume</code>, "
"<code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, "
"<code>privati</code>): NIT-taulukon verkot; NIT-taulukon kentät (<code>nid</"
"code>, <code>lcn</code>, <code>retele</code>) ilmestyvät verkkohaun ja yhden "
"taajuuden kaapelihaun yhteydessä; vain luku, kanavaluettelo ei muutu; jos "
"käynnistyksen jälkeen ei ole ollut hakua, <code>result</code> false"

msgid ""
"<code>GET /api/scanare</code>: secțiunile „Scanare” și „Orientarea și "
"setarea antenei”, cu felurile de scanare, în ordinea din meniul "
"receptorului; cu <code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</"
"code>, câmpurile felului și ce s-ar căuta"
msgstr ""
"<code>GET /api/scanare</code>: ”Kanavahaku” ja ”Antennin suuntaus ja "
"asennus” -osiot, hakutyypit vastaanottimen valikon järjestyksessä; "
"<code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</code> antaa tyypin "
"kentät ja mitä haettaisiin"

msgid ""
"<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;"
"mode=all|video|osd&amp;download=1</code>: imaginea de pe ecran; <code>mode</"
"code>: <code>all</code> cu afișajul OSD (implicit), <code>video</code> numai "
"imaginea canalului, <code>osd</code> numai afișajul OSD; <code>download=1</"
"code>: descărcare ca fișier, cu data și ora receptorului în nume"
msgstr ""
"<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;"
"mode=all|video|osd&amp;download=1</code>: näytön kuva; <code>mode</code>: "
"<code>all</code> OSD-näytön kanssa (oletus), <code>video</code> vain kanavan "
"kuva, <code>osd</code> vain OSD-näyttö; <code>download=1</code>: lataus "
"tiedostona, vastaanottimen päivämäärä ja aika nimessä"

msgid ""
"<code>GET /api/setari-din-copie</code>: setările importate: câte așteaptă "
"repornirea interfeței (<code>asteapta</code>), proba lor (<code>garda</"
"code>), scoase după opriri neașteptate (<code>cazut</code>), textele stării"
msgstr ""
"<code>GET /api/setari-din-copie</code>: tuodut asetukset: kuinka monta "
"odottaa käyttöliittymän uudelleenkäynnistystä (<code>asteapta</code>), "
"niiden testi (<code>garda</code>), odottamattomien pysäytysten jälkeen "
"poistetut (<code>cazut</code>), tilatekstit"

msgid ""
"<code>GET /api/setari</code>: ecranele de setări din meniu; cu <code>id=&lt;"
"cheie&gt;</code>, rândurile lor (aceleași ca pe televizor, cu alegerile)"
msgstr ""
"<code>GET /api/setari</code>: valikon asetusnäytöt; <code>id=&lt;cheie&gt;</"
"code> antaa niiden rivit (samat kuin televisiossa, valintoineen)"

msgid ""
"<code>GET /api/standby-tv</code>: ieșirea HDMI în standby (oprită sau "
"pornită, oprirea din nou după aprinderea televizorului) și starea CEC"
msgstr ""
"<code>GET /api/standby-tv</code>: HDMI-lähtö valmiustilassa (pois tai "
"päällä, sammutus uudelleen television käynnistämisen jälkeen) ja CEC-tila"

msgid ""
"<code>GET /api/stare-retea</code>: legătura cu routerul și internetul (cablu "
"sau Wi-Fi, treptele semnalului Wi-Fi, internetul merge, routerul nu are "
"internet sau receptorul nu e conectat la router), cu desenul pictogramei și "
"textul ei, ca pictograma din bara de pe televizor"
msgstr ""
"<code>GET /api/stare-retea</code>: yhteys reitittimeen ja internetiin "
"(kaapeli tai Wi-Fi, Wi-Fi-signaalin tasot, internet toimii, reitittimellä ei "
"ole internetiä tai vastaanotin ei ole yhteydessä reitittimeen), kuvakkeen "
"kuva ja sen teksti, kuten television palkissa oleva kuvake"

msgid "<code>GET /api/statusinfo</code>: canalul curent, volumul, standby"
msgstr "<code>GET /api/statusinfo</code>: nykyinen kanava, ääni, valmiustila"

msgid ""
"<code>GET /api/stocare</code>: locul înregistrărilor, spațiul liber și "
"discurile conectate"
msgstr ""
"<code>GET /api/stocare</code>: tallenteiden sijainti, vapaa tila ja liitetyt "
"levyt"

msgid ""
"<code>GET /api/subtitrari-aspect</code>: aspectul subtitrărilor text "
"(fontul, grosimea, mărimea și culoarea literelor, conturul, umbra, fundalul, "
"înălțimea, distanța dintre rânduri) și mărirea subtitrărilor DVB, cu "
"alegerile posibile (<code>alegeri</code>), stilurile gata făcute și valorile "
"de la început"
msgstr ""
"<code>GET /api/subtitrari-aspect</code>: tekstitekstitysten ulkoasu (fontti, "
"lihavuus, kirjainten koko ja väri, ääriviiva, varjo, tausta, korkeus, "
"riviväli) ja DVB-tekstitysten suurennus, mahdollisine valintoineen "
"(<code>alegeri</code>), valmiine tyyleineen ja alkuarvoineen"

msgid ""
"<code>GET /api/subtitrari-film</code>: filmul care merge, subtitrările lui, "
"întârzierea, codarea și cadrele pe secundă"
msgstr ""
"<code>GET /api/subtitrari-film</code>: toistettava elokuva, sen "
"tekstitykset, viive, koodaus ja ruudut sekunnissa"

msgid ""
"<code>GET /api/subtitrari-ocr</code>: contorul recunoașterii textului din "
"subtitrările DVB (pagini citite ca text, rămase imagine și de ce, timpul "
"mediu, ultimele pagini, viteza serviciului)"
msgstr ""
"<code>GET /api/subtitrari-ocr</code>: DVB-tekstitysten tekstintunnistuksen "
"laskuri (tekstinä luetut sivut, kuvina jääneet ja miksi, keskimääräinen "
"aika, viimeiset sivut, palvelun nopeus)"

msgid ""
"<code>GET /api/sunet</code>: ieșirea sunetului (Automat / Manual), AC3 și "
"DTS downmix, pista AC3, ce primește televizorul (EDID), ce se trimite acum "
"și de ce, ce arată driverul pe HDMI și optic"
msgstr ""
"<code>GET /api/sunet</code>: äänilähtö (Automaattinen / Manuaalinen), AC3- "
"ja DTS-downmix, AC3-raita, mitä televisio vastaanottaa (EDID), mitä nyt "
"lähetetään ja miksi, mitä ajuri näyttää HDMI:ssä ja optisessa"

msgid ""
"<code>GET /api/telecomenzi-export?format=json|csv</code>: codurile "
"telecomenzii receptorului și ale celor asociate, pentru aplicații"
msgstr ""
"<code>GET /api/telecomenzi-export?format=json|csv</code>: vastaanottimen "
"kaukosäätimen ja siihen liitettyjen koodit, sovelluksille"

msgid ""
"<code>GET /api/telecomenzi</code>: telecomenzile asociate, tastele lor și "
"captura paginii (cititorul, proba, asocierea)"
msgstr ""
"<code>GET /api/telecomenzi</code>: liitetyt kaukosäätimet, niiden näppäimet "
"ja sivun kaappaus (lukija, testi, liittäminen)"

msgid ""
"<code>GET /api/teletext-copii</code> (cu <code>?canale=1</code> și canalele "
"care au teletext): copiile de teletext salvate (canalul, data, paginile, "
"mărimea), dosarul, spațiul folosit și cel ales, urmăritorul (caruselul "
"canalului de acum, reîmprospătarea în lucru) și setările"
msgstr ""
"<code>GET /api/teletext-copii</code> (jossa <code>?canale=1</code> ja "
"teletext-kanavat): tallennetut teletext-kopiot (kanava, päivämäärä, sivut, "
"koko), kansio, käytetty ja valittu tila, seuraaja (nykyisen kanavan teletext-"
"karuselli, käynnissä oleva päivitys) ja asetukset"

msgid ""
"<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> "
"(fără <code>ref</code>: canalul de acum): <code>date</code> = fișierul "
"copiei (.ttx, comprimat), <code>html</code> = o singură pagină HTML cu toate "
"paginile, care se citește fără receptor"
msgstr ""
"<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> "
"(ilman <code>ref</code>: nykyinen kanava): <code>date</code> = kopiotiedosto "
"(.ttx, pakattu), <code>html</code> = yksi HTML-sivu kaikkine sivuineen, joka "
"on luettavissa ilman vastaanotinta"

msgid ""
"<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;"
"ref&gt;</code>: o pagină de teletext, ca pe televizor la tasta TEXT: cele 25 "
"de rânduri a câte 40 de celule (litera, culoarea, fundalul, mozaicul, "
"atributele), textul paginii, subpaginile, paginile tastelor colorate, "
"paginile vecine și pagina de pe televizor; fără <code>pagina</code>, pagina "
"de pe televizor sau cea de pornire; <code>sub=-1</code> = cea mai nouă; "
"<code>ascuns=1</code> arată ce e ascuns; cu <code>copie</code>, paginile din "
"copia salvată a canalului, fără tuner (<code>sursa</code>: <code>direct</"
"code> sau <code>copie</code>); <code>hd</code> = setarea Teletext neted, "
"<code>optiuni</code> = conturul literelor, umbra literelor și formele în "
"relief (<code>contur</code>, <code>umbra</code>, <code>relief</code>, ca pe "
"televizor). Pagina lipsă: <code>gasita</code> fals și mesajul că se caută"
msgstr ""
"<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;"
"ref&gt;</code>: teletext-sivu, kuten televisiossa TEXT-näppäimellä: 25 "
"riviä, kussakin 40 solua (kirjain, väri, tausta, mosaiikki, attribuutit), "
"sivun teksti, alasivut, värinäppäinten sivut, viereiset sivut ja "
"televisiossa näkyvä sivu; ilman <code>pagina</code> televisiossa oleva tai "
"aloitussivu; <code>sub=-1</code> = uusin; <code>ascuns=1</code> näyttää "
"piilotetun; <code>copie</code> antaa kanavan tallennetun kopion sivut ilman "
"viritintä (<code>sursa</code>: <code>direct</code> tai <code>copie</code>); "
"<code>hd</code> = Pehmeä teletext -asetus, <code>optiuni</code> = kirjainten "
"ääriviiva, kirjainten varjo ja kohokuviot (<code>contur</code>, <code>umbra</"
"code>, <code>relief</code>, kuten televisiossa). Puuttuva sivu: "
"<code>gasita</code> epätosi ja viesti, että sitä etsitään"

msgid ""
"<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/"
"temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: jurnalul unei "
"înregistrări, pe înțelesul oricui, cu mesajul tehnic; golirea lui"
msgstr ""
"<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/"
"temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: tallenteen loki "
"ymmärrettävässä muodossa, teknisellä viestillä; sen tyhjennys"

msgid ""
"<code>GET /api/temporizatoare</code>: înregistrările programate (aceeași "
"ordine, stare și detalii ca pe televizor), locul înregistrărilor și spațiul "
"liber"
msgstr ""
"<code>GET /api/temporizatoare</code>: ajastetut tallenteet (sama järjestys, "
"tila ja tiedot kuin televisiossa), tallenteiden sijainti ja vapaa tila"

msgid ""
"<code>GET /api/traducere-configurare</code>: configurarea pas cu pas a "
"traducerii: ce e pus acum (<code>acum</code>: serviciul, dacă are cheie, "
"pornită sau nu, ultima probă, <code>chei_din_nou</code>), lucrarea "
"configurării (<code>configurare</code>: starea, pasul, proba, modelul și "
"modelele, mesajul și ce să faci), căutarea serverelor din casă "
"(<code>cautare</code>: progresul și serverele găsite), instrucțiunile și "
"pagina cheii fiecărui serviciu, regiunile Azure; niciodată o cheie"
msgstr ""
"<code>GET /api/traducere-configurare</code>: käännöksen vaiheittainen "
"asetusten määrittely: mitä nyt on asetettu (<code>acum</code>: palvelu, onko "
"sillä avain, käytössä vai ei, viimeinen kokeilu, <code>chei_din_nou</code>), "
"asetustyö (<code>configurare</code>: tila, vaihe, kokeilu, malli ja mallit, "
"viesti ja mitä tehdä), kotiverkon palvelinten haku (<code>cautare</code>: "
"edistyminen ja löydetyt palvelimet), ohjeet ja kunkin palvelun avainsivu, "
"Azure-alueet; ei koskaan avainta"

msgid ""
"<code>GET /api/traducere-subtitrari</code>: traducerea automată a "
"subtitrărilor text: valorile (<code>pornit</code>, <code>serviciu</code>, "
"<code>limba</code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</"
"code>, <code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</"
"code>, <code>adresa_libre</code>, <code>adresa_openai</code>, "
"<code>model_gemini</code>, <code>model_openai</code>, <code>model_groq</"
"code>, <code>model_cloudflare</code>, <code>cont_cloudflare</code> și, "
"pentru adresa proprie, <code>propriu_adresa</code>, <code>propriu_metoda</"
"code>, <code>propriu_corp</code>, <code>propriu_tip_corp</code>, "
"<code>propriu_antet</code>, <code>propriu_raspuns</code>, "
"<code>propriu_cale</code>), alegerile posibile (<code>alegeri</code>), ce "
"cere fiecare serviciu (<code>cere</code>), care serviciu are cheie "
"(<code>chei</code>, niciodată cheia), dacă cheile trebuie puse din nou "
"(<code>chei_din_nou</code>, textul notei, gol când nu e cazul), starea cheii "
"serviciului ales, ca pe televizor (<code>cheie_fel</code> și "
"<code>cheie_text</code>: pusă, pusă pentru alt server, lipsă), textele "
"paginii în limba receptorului (<code>texte</code>), ce lipsește, "
"confidențialitatea, instrucțiunile pas cu pas (cu <code>pagina_cheie</code>, "
"adresa oficială pentru codul QR) și starea (contorul, proba, pauza după "
"erori)"
msgstr ""
"<code>GET /api/traducere-subtitrari</code>: tekstityksen automaattinen "
"kääntäminen: arvot (<code>pornit</code>, <code>serviciu</code>, <code>limba</"
"code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</code>, "
"<code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</code>, "
"<code>adresa_libre</code>, <code>adresa_openai</code>, <code>model_gemini</"
"code>, <code>model_openai</code>, <code>model_groq</code>, "
"<code>model_cloudflare</code>, <code>cont_cloudflare</code> ja omalle "
"osoitteelle <code>propriu_adresa</code>, <code>propriu_metoda</code>, "
"<code>propriu_corp</code>, <code>propriu_tip_corp</code>, "
"<code>propriu_antet</code>, <code>propriu_raspuns</code>, "
"<code>propriu_cale</code>), mahdolliset valinnat (<code>alegeri</code>), "
"mitä kukin palvelu vaatii (<code>cere</code>), millä palvelulla on avain "
"(<code>chei</code>, ei koskaan avainta), onko avaimet annettava uudelleen "
"(<code>chei_din_nou</code>, huomautuksen teksti, tyhjä kun ei tarvita), "
"valitun palvelun avaimen tila, kuten televisiossa (<code>cheie_fel</code> ja "
"<code>cheie_text</code>: annettu, annettu toiselle palvelimelle, puuttuu), "
"sivun tekstit vastaanottimen kielellä (<code>texte</code>), mitä puuttuu, "
"tietosuoja, vaiheittaiset ohjeet (mukaan lukien <code>pagina_cheie</code>, "
"virallinen osoite QR-koodille) ja tila (laskuri, kokeilu, tauko virheiden "
"jälkeen)"

msgid ""
"<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: canalele "
"de pe frecvența televizorului și din lista lui, fiecare cu merge acum sau "
"motivul, codecul imaginii și felul sunetului; cu <code>wasm=1</code> "
"(browserul are playerul MPEG-2) merg și canalele cu imagine MPEG-2; "
"<code>ac3=1</code>: pagina redă sunetul AC-3, cu decodorul browserului sau "
"cu decodorul wasm al paginii"
msgstr ""
"<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: kanavat "
"television taajuudella ja sen luettelossa, kussakin toimii nyt tai syy, "
"kuvakoodekki ja äänen tyyppi; <code>wasm=1</code> (selaimessa on MPEG-2-"
"soitin) toimivat myös MPEG-2-kuvalliset kanavat; <code>ac3=1</code>: sivu "
"toistaa AC-3-äänen, selaimen dekooderilla tai sivun wasm-dekooderilla"

msgid ""
"<code>GET /api/tv-stare</code>: TV în browser: transmisiile de acum (canal, "
"browser, de când, octeți), setările, memoria driverului video (câte canale "
"noi se mai pot deschide până la repornire), transmisia acestui browser și "
"motivul ultimei opriri"
msgstr ""
"<code>GET /api/tv-stare</code>: TV selaimessa: nykyiset lähetykset (kanava, "
"selain, mistä lähtien, tavut), asetukset, videoajurin muisti (kuinka monta "
"uutta kanavaa voidaan vielä avata ennen uudelleenkäynnistystä), tämän "
"selaimen lähetys ja viimeisen pysäytyksen syy"

msgid ""
"<code>GET /api/video</code>: setările video ca în Setări &gt; Video: "
"rezoluțiile, frecvențele fiecărei rezoluții (cu <code>auto</code> = automat "
"după canal), culorile HDMI, <code>zapmode</code> (ce se vede la schimbarea "
"canalului) și încercarea în curs"
msgstr ""
"<code>GET /api/video</code>: videoasetukset kuten kohdassa Asetukset &gt; "
"Video: resoluutiot, kunkin resoluution taajuudet (jossa <code>auto</code> = "
"automaattinen kanavan mukaan), HDMI-värit, <code>zapmode</code> (mitä näkyy "
"kanavaa vaihdettaessa) ja käynnissä oleva kokeilu"

msgid "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: schimbă canalul"
msgstr "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: vaihtaa kanavaa"

msgid "<code>POST /api/accel-reporneste</code>: repornește interfața (enigma2)"
msgstr ""
"<code>POST /api/accel-reporneste</code>: uudelleenkäynnistää liittymän "
"(enigma2)"

msgid ""
"<code>POST /api/accel-seteaza?pornita=0|1</code>: pornește sau oprește "
"accelerarea de la următoarea pornire a interfeței (refuzat pe un receptor "
"fără accelerarea 2D)"
msgstr ""
"<code>POST /api/accel-seteaza?pornita=0|1</code>: kytkee kiihdytyksen päälle "
"tai pois käyttöliittymän seuraavasta käynnistyksestä (hylätään "
"vastaanottimessa ilman 2D-kiihdytystä)"

msgid ""
"<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|"
"reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</"
"code> ca în <code>GET /api/acces-conditionat</code>): pornește comanda prin "
"scriptul modulului, pe rând, una singură deodată (și cu televizorul); "
"rezultatul vine prin <code>GET /api/acces-conditionat</code>"
msgstr ""
"<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|"
"reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</"
"code> kuten <code>GET /api/acces-conditionat</code>): käynnistää komennon "
"moduulin skriptillä, vuorotellen, vain yksi kerrallaan (myös televisiolla); "
"tulos tulee <code>GET /api/acces-conditionat</code>-kutsun kautta"

msgid ""
"<code>POST /api/acces-ssh-adauga</code> (corp: <code>cheie=</code>), "
"<code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?"
"amprenta=SHA256:..&amp;confirmat=1</code>: cheile publice lipite, cele din "
"dosarul hdsatelit/ssh de pe stick, ștergerea unei chei"
msgstr ""
"<code>POST /api/acces-ssh-adauga</code> (runko: <code>cheie=</code>), "
"<code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?"
"amprenta=SHA256:..&amp;confirmat=1</code>: liitetyt julkiset avaimet, USB-"
"muistitikun hdsatelit/ssh-kansiossa olevat, avaimen poistaminen"

msgid ""
"<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</"
"code> cere și <code>confirmat=1</code>): opțiunea Fără parolă în rețeaua "
"locală. Parola, textul brut și toate schimbările merg numai dintr-un browser "
"conectat cu codul de pe televizor (altfel 403 cu <code>trebuie_cod</code>), "
"niciodată cu <code>?token=</code>; cât ecranul Parola receptorului e deschis "
"pe receptor, la fel <code>/api/remotecontrol</code> și <code>/api/"
"screenshot</code>"
msgstr ""
"<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</"
"code> vaatii myös <code>confirmat=1</code>): vaihtoehto Ei salasanaa "
"paikallisverkossa. Salasana, raakateksti ja kaikki muutokset toimivat vain "
"selaimesta, joka on yhdistetty televisiossa näkyvällä koodilla (muuten 403 "
"ja <code>trebuie_cod</code>), ei koskaan <code>?token=</code>-parametrilla; "
"niin kauan kuin Vastaanottimen salasana -näyttö on auki vastaanottimella, "
"sama koskee <code>/api/remotecontrol</code> ja <code>/api/screenshot</code>"

msgid ""
"<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</"
"code> cere și <code>confirmat=1</code>): „Fără parolă în rețeaua locală”. "
"Parola, textul brut și toate schimbările merg numai dintr-un browser "
"conectat cu codul de pe televizor (altfel 403 cu <code>trebuie_cod</code>), "
"niciodată cu <code>?token=</code>; cât ecranul „Acces SSH” e deschis pe "
"televizor, la fel <code>/api/remotecontrol</code> și <code>/api/screenshot</"
"code>"
msgstr ""
"<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</"
"code> vaatii myös <code>confirmat=1</code>): ”Ei salasanaa paikallisessa "
"verkossa”. Salasana, raakateksti ja kaikki muutokset toimivat vain "
"selaimesta, joka on yhdistetty television koodilla (muuten 403 ja "
"<code>trebuie_cod</code>), ei koskaan <code>?token=</code>-parametrilla; kun "
"”SSH-käyttö”-näyttö on avoinna televisiossa, sama koskee <code>/api/"
"remotecontrol</code>- ja <code>/api/screenshot</code>-kutsuja"

msgid ""
"<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/"
"acces-ssh-ascunde</code>: o parolă nouă; „Am notat parola” (textul parolei "
"se șterge de pe receptor, parola rămâne)"
msgstr ""
"<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/"
"acces-ssh-ascunde</code>: uusi salasana; ”Kirjoitin salasanan "
"muistiin” (salasanan teksti poistetaan vastaanottimesta, salasana jää)"

msgid ""
"<code>POST /api/acces-ssh-parola</code>: textul parolei (se vede oricând); "
"<code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: fișierele serverelor "
"SSH și FTP ca text (fără /etc/shadow)"
msgstr ""
"<code>POST /api/acces-ssh-parola</code>: salasanan teksti (näkyy milloin "
"tahansa); <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: SSH- ja FTP-"
"palvelinten tiedostot tekstinä (ilman /etc/shadow)"

msgid ""
"<code>POST /api/acces-ssh-parola</code>: textul parolei, cât timp nu a fost "
"ascunsă; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: fișierele "
"serverului SSH ca text (fără /etc/shadow)"
msgstr ""
"<code>POST /api/acces-ssh-parola</code>: salasanan teksti, kunnes se on "
"piilotettu; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: SSH-"
"palvelimen tiedostot tekstinä (ilman /etc/shadow)"

msgid ""
"<code>POST /api/acces-ssh-pune</code> (corp: <code>parola=</code>): parola "
"aleasă (4-64 de semne: litere fără diacritice, cifre și semne, fără spații); "
"<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>: o parolă nouă la "
"întâmplare"
msgstr ""
"<code>POST /api/acces-ssh-pune</code> (runko: <code>parola=</code>): valittu "
"salasana (4-64 merkkiä: kirjaimia ilman tarkkeita, numeroita ja merkkejä, ei "
"välilyöntejä); <code>POST /api/acces-ssh-parola-noua?confirmat=1</code>: "
"uusi satunnainen salasana"

msgid ""
"<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;"
"evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;"
"viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;"
"luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;"
"noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: salvează și "
"aplică pe loc (oricare dintre ele); <code>previzualizare=1&amp;lista=...</"
"code> arată lista pe afișaj fără salvare (cel mult 2 minute fără o cerere "
"nouă), <code>previzualizare=0</code> revine; <code>minutar=0|1..120</code> "
"și <code>cronometru=porneste|opreste|zero</code> pornesc ceasurile "
"afișajului pe loc; <code>functionare=ora|canal|stins</code> merge ca înainte"
msgstr ""
"<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;"
"evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;"
"viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;"
"luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;"
"noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: tallentaa ja "
"ottaa käyttöön heti (minkä tahansa niistä); <code>previzualizare=1&amp;"
"lista=...</code> näyttää luettelon näytöllä tallentamatta (enintään 2 "
"minuuttia ilman uutta pyyntöä), <code>previzualizare=0</code> palaa "
"takaisin; <code>minutar=0|1..120</code> ja <code>cronometru=porneste|opreste|"
"zero</code> käynnistävät näytön kellot heti; <code>functionare=ora|canal|"
"stins</code> toimii kuten ennen"

msgid ""
"<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;"
"claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</"
"code>: salvează reglajele unui profil (multipli de 5); cu <code>incearca=1</"
"code> se văd pe loc fără să se salveze, <code>renunta=1</code> pune înapoi "
"ce e salvat; <code>POST /api/calitate-imagine-implicite?profil=&lt;"
"profil&gt;|toate</code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|"
"hdr10|hlg|none</code> (canalul pornește din nou, întrebarea apare pe "
"televizor); <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;"
"&amp;pornit=0|1</code> (jumătate de ecran, 60 s)"
msgstr ""
"<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;"
"claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</"
"code>: tallentaa profiilin säädöt (5:n kerrannaiset); <code>incearca=1</"
"code> näyttää ne heti tallentamatta, <code>renunta=1</code> palauttaa "
"tallennetun; <code>POST /api/calitate-imagine-implicite?profil=&lt;"
"profil&gt;|toate</code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|"
"hdr10|hlg|none</code> (kanava käynnistyy uudelleen, kysymys ilmestyy "
"televisioon); <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;"
"cheie&gt;&amp;pornit=0|1</code> (puoli näyttöä, 60 s)"

msgid ""
"<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: pornește "
"canalul prin lista de pe televizor"
msgstr ""
"<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: "
"käynnistää kanavan television luettelon kautta"

msgid ""
"<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: deschide "
"pe televizor un rezultat al căutării, cu rândul găsit ales"
msgstr ""
"<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: avaa "
"televisiossa hakutuloksen, löydetty rivi valittuna"

msgid ""
"<code>POST /api/cautare-actualizeaza-opreste</code>: oprește citirea și "
"revine la canalul de dinainte"
msgstr ""
"<code>POST /api/cautare-actualizeaza-opreste</code>: pysäyttää lukemisen ja "
"palaa edelliseen kanavaan"

msgid ""
"<code>POST /api/cautare-actualizeaza-sari</code>: sare peste satelitul pe "
"care e antena acum și trece la următorul (tasta GALBEN de pe televizor)"
msgstr ""
"<code>POST /api/cautare-actualizeaza-sari</code>: ohittaa satelliitin, jolla "
"antenni nyt on, ja siirtyy seuraavaan (KELTAINEN painike televisiossa)"

msgid ""
"<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: "
"întrebarea (durata, motorul); cu <code>confirmat=1</code> pornește pe "
"televizor citirea pistelor, transponder cu transponder"
msgstr ""
"<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: kysymys "
"(kesto, moottori); <code>confirmat=1</code> käynnistää televisiossa raitojen "
"lukemisen, transponderi transponderilta"

msgid ""
"<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: "
"citirea pistelor în timpul vizionării (oprită, numai canalul privit, tot "
"transponderul), aceeași setare ca pe televizor"
msgstr ""
"<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: "
"raitojen lukeminen katselun aikana (pois päältä, vain katseltava kanava, "
"koko transponderi), sama asetus kuin televisiossa"

msgid ""
"<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;"
"&amp;fus=&lt;fus orar&gt;</code>: schimbă și salvează oricare dintre ele "
"(valorile exacte sunt în <code>/api/ceas</code>)"
msgstr ""
"<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;"
"&amp;fus=&lt;fus orar&gt;</code>: muuttaa ja tallentaa minkä tahansa niistä "
"(tarkat arvot ovat <code>/api/ceas</code>-kutsussa)"

msgid ""
"<code>POST /api/ceas-sincronizeaza</code>: o sincronizare a orei prin "
"Internet, acum"
msgstr ""
"<code>POST /api/ceas-sincronizeaza</code>: kellonajan synkronointi "
"Internetin kautta, nyt"

msgid ""
"<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/"
"copie-setari-pune?copie=&lt;id&gt;</code> (repornește interfața; copia se "
"pune la loc înainte să pornească), <code>POST /api/copie-setari-sterge?"
"copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|"
"zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"
msgstr ""
"<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/"
"copie-setari-pune?copie=&lt;id&gt;</code> (käynnistää käyttöliittymän "
"uudelleen; kopio palautetaan ennen käynnistystä), <code>POST /api/copie-"
"setari-sterge?copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?"
"automat=oprita|zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-"
"anuleaza</code>"

msgid ""
"<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|"
"invata|sterge&amp;flux=..</code>: actualizează lista, reface buchetele, "
"învață posturile unui flux, șterge un flux adăugat de mână"
msgstr ""
"<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|"
"invata|sterge&amp;flux=..</code>: päivittää luettelon, rakentaa kanavanippu "
"uudelleen, oppii virran asemat, poistaa käsin lisätyn virran"

msgid ""
"<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;"
"emisfera=E|V&amp;frecventa=..&amp;...</code>: un flux adăugat de mână, cu "
"aceleași câmpuri și limite ca „Adaugă manual”"
msgstr ""
"<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;"
"emisfera=E|V&amp;frecventa=..&amp;...</code>: käsin lisätty virta, samoilla "
"kentillä ja rajoilla kuin ”Lisää manuaalisesti”"

msgid ""
"<code>POST /api/dabt2-seteaza?cheie=tasta|dosar|latime|nedecodabile&amp;"
"valoare=..</code>: setările ferestrei, aceleași ca pe televizor"
msgstr ""
"<code>POST /api/dabt2-seteaza?cheie=tasta|dosar|latime|nedecodabile&amp;"
"valoare=..</code>: ikkunan asetukset, samat kuin televisiossa"

msgid ""
"<code>POST /api/dabt2-televizor?fel=dab|t2</code>: deschide fereastra pe "
"televizor"
msgstr ""
"<code>POST /api/dabt2-televizor?fel=dab|t2</code>: avaa ikkunan televisiossa"

msgid ""
"<code>POST /api/ecran-negru-fapta?fapta=&lt;id&gt;|ascunde</code>: fapta "
"mesajului de acum, pe televizor, sau ascunderea lui"
msgstr ""
"<code>POST /api/ecran-negru-fapta?fapta=&lt;id&gt;|ascunde</code>: nykyisen "
"viestin toiminto televisiossa, tai sen piilottaminen"

msgid ""
"<code>POST /api/ecran-sterge?sursa=galerie|propriu&amp;id=..</code>, "
"<code>POST /api/ecran-la-loc</code>: șterge un ecran de pornire din galerie "
"(nu cel din fabrică și nici cel pus) sau pune la loc ecranele șterse"
msgstr ""
"<code>POST /api/ecran-sterge?sursa=galerie|propriu&amp;id=..</code>, "
"<code>POST /api/ecran-la-loc</code>: poistaa käynnistysnäytön galleriasta "
"(ei tehdasasetuksena olevaa eikä käytössä olevaa) tai palauttaa poistetut "
"näytöt"

msgid ""
"<code>POST /api/filme-comanda?fa=pauza|redare|inainte|inapoi</code>, <code>?"
"fa=salt&amp;secunde=-60</code>, <code>?fa=la&amp;secunde=N</code>, "
"<code>POST /api/filme-seteaza?pornire=&amp;oprire=&amp;sfarsit=</code>, "
"<code>POST /api/filme-porneste?cale=..&amp;de_la=loc|inceput</code>: "
"aceleași comenzi ca pe telecomandă în player și în lista de filme"
msgstr ""
"<code>POST /api/filme-comanda?fa=pauza|redare|inainte|inapoi</code>, <code>?"
"fa=salt&amp;secunde=-60</code>, <code>?fa=la&amp;secunde=N</code>, "
"<code>POST /api/filme-seteaza?pornire=&amp;oprire=&amp;sfarsit=</code>, "
"<code>POST /api/filme-porneste?cale=..&amp;de_la=loc|inceput</code>: samat "
"komennot kuin kaukosäätimellä soittimessa ja elokuvaluettelossa"

msgid ""
"<code>POST /api/fonturi-descarca?familie=&lt;Familia&gt;&amp;mare=1</code>: "
"descarcă, verifică și înregistrează un font"
msgstr ""
"<code>POST /api/fonturi-descarca?familie=&lt;Familia&gt;&amp;mare=1</code>: "
"lataa, tarkistaa ja rekisteröi fontin"

msgid ""
"<code>POST /api/fonturi-sterge?alias=&lt;NumeInSkin&gt;</code>: șterge un "
"font descărcat"
msgstr ""
"<code>POST /api/fonturi-sterge?alias=&lt;NumeInSkin&gt;</code>: poistaa "
"ladatun fontin"

msgid ""
"<code>POST /api/gasire-semnal-porneste</code>, <code>-reacordeaza</code>, "
"<code>-opreste</code>: pornește, acordează din nou sau oprește măsurarea"
msgstr ""
"<code>POST /api/gasire-semnal-porneste</code>, <code>-reacordeaza</code>, "
"<code>-opreste</code>: käynnistää, virittää uudelleen tai pysäyttää "
"mittauksen"

msgid ""
"<code>POST /api/ghid-temporizator?ref=&amp;id=&amp;fel=inregistrare|comutare|"
"scoate</code>: pune sau scoate înregistrarea unei emisiuni (409 la "
"suprapunere)"
msgstr ""
"<code>POST /api/ghid-temporizator?ref=&amp;id=&amp;fel=inregistrare|comutare|"
"scoate</code>: asettaa tai poistaa ohjelman tallenteen (409 "
"päällekkäisyydessä)"

msgid ""
"<code>POST /api/import-alta-imagine?raspuns=da|nu|ascunde</code>: răspunsul "
"la întrebarea de la prima pornire (canalele și setările din altă imagine, "
"găsite pe stick sau disc); starea în <code>/api/import-surse</code> "
"(<code>alta_imagine</code>)"
msgstr ""
"<code>POST /api/import-alta-imagine?raspuns=da|nu|ascunde</code>: vastaus "
"ensimmäisen käynnistyksen kysymykseen (toisen imagen kanavat ja asetukset, "
"löydetty USB-muistitikulta tai levyltä); tila <code>/api/import-surse</code>-"
"kutsussa (<code>alta_imagine</code>)"

msgid ""
"<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;"
"temporizatoare=0&amp;generale=0</code>: pornește importul (întâi copia de "
"siguranță)"
msgstr ""
"<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;"
"temporizatoare=0&amp;generale=0</code>: käynnistää tuonnin (ensin "
"varmuuskopio)"

msgid ""
"<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: schimbă limba "
"meniurilor și o salvează, ca OK în ecranul limbii de pe televizor"
msgstr ""
"<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: muuttaa "
"valikkojen kielen ja tallentaa sen, kuten OK kielinäytössä televisiossa"

msgid ""
"<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;"
"fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</"
"code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în "
"<code>/api/limbi</code>; <code>tradu_orice</code> = „Tradu automat din orice "
"subtitrare disponibilă”, contează cu traducerea subtitrărilor pornită) și le "
"aplică pe canalul de acum"
msgstr ""
"<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;"
"fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</"
"code>: muuttaa ja tallentaa minkä tahansa niistä (tarkat arvot ovat <code>/"
"api/limbi</code>-kutsussa; <code>tradu_orice</code> = ”Käännä "
"automaattisesti mistä tahansa saatavilla olevasta tekstityksestä”, vaikuttaa "
"kun tekstityksen kääntäminen on käytössä) ja ottaa ne käyttöön nykyisellä "
"kanavalla"

msgid ""
"<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /"
"api/limbi-uita-toate?confirmat=1</code>: uită alegerile de mână ale unui "
"canal sau ale tuturor"
msgstr ""
"<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /"
"api/limbi-uita-toate?confirmat=1</code>: unohtaa yhden kanavan tai kaikkien "
"kanavien manuaaliset valinnat"

msgid ""
"<code>POST /api/lnb-aplica</code>: aplică planul văzut (<code>semn=</code>), "
"verifică semnalul și așteaptă răspunsul 60 de secunde"
msgstr ""
"<code>POST /api/lnb-aplica</code>: ottaa käyttöön nähdyn suunnitelman "
"(<code>semn=</code>), tarkistaa signaalin ja odottaa vastausta 60 sekuntia"

msgid ""
"<code>POST /api/lnb-plan</code>: ce s-ar schimba pentru câmpurile trimise "
"(<code>l_&lt;lnb&gt;_&lt;câmp&gt;</code>), sau pentru „Ce era înainte” cu "
"<code>fel=inainte</code>; nu scrie nimic"
msgstr ""
"<code>POST /api/lnb-plan</code>: mitä muuttuisi lähetetyille kentille "
"(<code>l_&lt;lnb&gt;_&lt;câmp&gt;</code>), tai ”Mitä oli ennen” -"
"vaihtoehdolle <code>fel=inainte</code>; ei kirjoita mitään"

msgid ""
"<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code>: răspunsul la "
"„Păstrezi noile setări?”"
msgstr ""
"<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code>: vastaus "
"kysymykseen ”Pidätkö uudet asetukset?”"

msgid ""
"<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</"
"code>: locul antenei aflat după adresa de internet a receptorului, de "
"serverul HD Satelit, numai la cerere și numai din browserul conectat; se "
"scrie abia după confirmare, cu <code>POST /api/locul-seteaza</code> și "
"<code>internet=&lt;semn&gt;</code>"
msgstr ""
"<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</"
"code>: antennin sijainti, joka on selvitetty vastaanottimen Internet-"
"osoitteen perusteella HD Satelit -palvelimella, vain pyynnöstä ja vain "
"yhdistetystä selaimesta; se kirjoitetaan vasta vahvistuksen jälkeen, "
"<code>POST /api/locul-seteaza</code>- ja <code>internet=&lt;semn&gt;</code>-"
"kutsuilla"

msgid ""
"<code>POST /api/locul-seteaza</code>: locul antenei din tabel (<code>tara</"
"code>, <code>oras</code>) sau scris (<code>lat</code>, <code>lon</code>, "
"grade, nord și est pozitive)"
msgstr ""
"<code>POST /api/locul-seteaza</code>: antennin sijainti taulukosta "
"(<code>tara</code>, <code>oras</code>) tai kirjoitettuna (<code>lat</code>, "
"<code>lon</code>, astetta, pohjoinen ja itä positiivisia)"

msgid ""
"<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: deschide pe "
"televizor ecranul unei intrări (nu oprirea sau repornirea)"
msgstr ""
"<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: avaa televisiossa "
"kohdan näytön (ei sammutusta tai uudelleenkäynnistystä)"

msgid ""
"<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code>: pas, mișcare "
"fără oprire, poziții memorate, mergi la satelit, limite, oprire"
msgstr ""
"<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code>: askel, tauoton "
"liike, tallennetut asennot, mene satelliittiin, rajat, pysäytys"

msgid ""
"<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /"
"api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-"
"inchide</code>: navigatorul pe televizor"
msgstr ""
"<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /"
"api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-"
"inchide</code>: selain televisiossa"

msgid ""
"<code>POST /api/navigator-text</code>: text trimis în câmpul ales pe "
"televizor; numai din browserul asociat, cu textul în corpul cererii (cu "
"<code>?token=</code> se refuză)"
msgstr ""
"<code>POST /api/navigator-text</code>: teksti lähetetty televisiossa "
"valittuun kenttään; vain yhdistetystä selaimesta, teksti pyynnön rungossa "
"(<code>?token=</code>-parametrilla hylätään)"

msgid ""
"<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: descarcă "
"modelul unei limbi (pe stick sau disc; în memoria internă numai cu intern=1)"
msgstr ""
"<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: lataa "
"kielen mallin (tikulle tai levylle; sisäiseen muistiin vain arvolla intern=1)"

msgid ""
"<code>POST /api/ocr-limbi-intreaba</code>: receptorul întreabă din nou "
"pentru limbile cu \"Nu mai întreba\""
msgstr ""
"<code>POST /api/ocr-limbi-intreaba</code>: vastaanotin kysyy uudelleen "
"kielistä, joissa on ”Älä kysy uudelleen”"

msgid "<code>POST /api/ocr-limbi-opreste?model=slk</code>: oprește descărcarea"
msgstr ""
"<code>POST /api/ocr-limbi-opreste?model=slk</code>: pysäyttää latauksen"

msgid ""
"<code>POST /api/ocr-limbi-sterge?model=slk</code>: șterge un model descărcat "
"(sau îl scoate din listă când stickul lui nu e pus)"
msgstr ""
"<code>POST /api/ocr-limbi-sterge?model=slk</code>: poistaa ladatun mallin "
"(tai poistaa sen luettelosta, kun sen muistitikku ei ole paikalla)"

msgid ""
"<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</"
"code>: repornirea interfeței când nu mai răspunde și așteptarea dinaintea ei"
msgstr ""
"<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</"
"code>: käyttöliittymän uudelleenkäynnistys, kun se lakkaa vastaamasta, ja "
"odotus ennen sitä"

msgid ""
"<code>POST /api/procesor-seteaza?mod=automat|racoros|normal|performanta</"
"code>: salvează modul și îl aplică pe loc"
msgstr ""
"<code>POST /api/procesor-seteaza?mod=automat|racoros|normal|performanta</"
"code>: tallentaa tilan ja ottaa sen käyttöön heti"

msgid ""
"<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=.."
"&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</"
"code>: setările ecranului radio"
msgstr ""
"<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=.."
"&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</"
"code>: radionäytön asetukset"

msgid ""
"<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: vizualizarea "
