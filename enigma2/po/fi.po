msgstr ""
"<code>POST /api/telecomenzi-asociere?pas=inapoi|sari|gata|continua|anuleaza|"
"proba|inchide&amp;pastreaza=0|1</code>: uuden kaukosäätimen parituksen "
"vaiheet"

msgid ""
"<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|"
