msgstr "HbbTV forrit þessarar rásar er tóm síða: stöðin setti ekkert í hana."

msgid ""
"Aplicația HbbTV a acestui canal e prea mare pentru memoria receptorului."
msgstr "HbbTV-forrit þessarar rásar er of stórt fyrir minni móttakarans."

msgid "Aplicația HbbTV a acestui canal nu are o adresă pe internet."
msgstr "HbbTV-forrit þessarar rásar hefur ekkert netfang á netinu."

msgid ""
"Aplicația HbbTV a acestui canal nu mai este la adresa anunțată de post: "
"pagina a fost mutată sau ștearsă."
msgstr ""
"HbbTV forrit þessarar rásar er ekki lengur á vistfanginu sem stöðin "
"tilkynnti: síðan var færð eða eytt."

msgid ""
"Aplicația HbbTV a acestui canal nu s-a încărcat întreagă din satelit: "
"semnalul e prea slab."
msgstr ""
"HbbTV-forrit þessarar rásar hlaðnaðist ekki að fullu úr gervihnettinum: "
"merkið er of veikt."

msgid ""
"Aplicația HbbTV a acestui canal nu vine din satelit: pista ei e criptată sau "
"semnalul lipsește."
msgstr ""
"HbbTV-forrit þessarar rásar kemur ekki úr gervihnettinum: rás þess er "
"dulkóðuð eða merkið vantar."

msgid ""
"Aplicația HbbTV a acestui canal pornește cu tasta ALBASTRU. Apasă ALBASTRU."
msgstr "HbbTV forrit þessarar rásar ræsist með BLÁA hnappnum. Ýttu á BLÁAN."

msgid ""
"Aplicația HbbTV a acestui canal se deschide numai pe anumite televizoare și "
"nu a primit receptorul."
msgstr ""
"HbbTV forrit þessarar rásar opnast aðeins á ákveðnum sjónvörpum og tók ekki "
"við móttakaranum."

msgid ""
"Aplicația HbbTV a acestui canal vine din semnalul altui canal și receptorul "
"nu o poate încărca de aici."
msgstr ""
"HbbTV-forrit þessarar rásar kemur í merki annarrar rásar og móttakarinn "
"getur ekki hlaðið því héðan."

msgid ""
"Aplicația HbbTV a acestui canal începe cu o întrebare de consimțământ care "
"nu se vede pe ecran. De obicei trece singură în jumătate de minut."
msgstr ""
"HbbTV forrit þessarar rásar byrjar á samþykkisspurningu sem sést ekki á "
"skjánum. Venjulega heldur það sjálft áfram innan hálfrar mínútu."

msgid "Aplicația HbbTV a canalului (butonul roșu)"
msgstr "HbbTV-forrit rásarinnar (rauði hnappurinn)"

msgid "Aplicația HbbTV a canalului nu s-a arătat pe ecran."
msgstr "HbbTV-forrit rásarinnar birtist ekki á skjánum."

msgid ""
"Aplicația HbbTV a canalului nu s-a arătat pe ecran. Unele aplicații lucrează "
"numai în fundal, fără nimic de arătat."
msgstr ""
"HbbTV-forrit rásarinnar birtist ekki á skjánum. Sum forrit vinna aðeins í "
"bakgrunni, án þess að sýna neitt."

msgid "Aplicația HbbTV a canalului nu s-a arătat încă. Apasă din nou ROȘU."
msgstr "HbbTV-forrit rásarinnar hefur ekki birst enn. Ýttu aftur á RAUÐA."

msgid "Aplicația HbbTV a canalului s-a închis singură, înainte să se arate."
msgstr "HbbTV forrit rásarinnar lokaði sér sjálft áður en það birtist."

msgid "Aplicația HbbTV din satelit nu are pagina de pornire anunțată de canal."
msgstr ""
"HbbTV-forritið úr gervihnettinum hefur ekki upphafssíðuna sem rásin "
"tilkynnti."

msgid ""
"Aplicația HbbTV din satelit nu se poate citi acum din semnalul canalului."
msgstr ""
"Ekki er hægt að lesa HbbTV-forritið úr gervihnettinum úr merki rásarinnar "
"núna."

msgid "Aplicația HbbTV nu a pornit."
msgstr "HbbTV-forritið byrjaði ekki."

msgid "Aplicația HbbTV s-a închis."
msgstr "HbbTV forritið lokaðist."

