msgstr ""
"<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, "
"<code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, "
"<code>POST /api/temporizatoare-curata?confirmat=1</code>: eyðir einni, "
"stöðvar hana eða ræsir aftur, eyðir þeim loknu"

msgid ""
"<code>POST /api/traducere-configurare-cauta</code>: caută în rețeaua de "
"acasă serverele Ollama (11434) și LibreTranslate (5000); rezultatul vine în "
"<code>cautare</code>"
msgstr ""
"<code>POST /api/traducere-configurare-cauta</code>: leitar á heimanetinu að "
"Ollama (11434) og LibreTranslate (5000) þjónum; niðurstaðan kemur í "
"<code>cautare</code>"

msgid ""
"<code>POST /api/traducere-configurare-cheie</code>, corpul <code>cheie=&lt;"
"cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;"
"&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: probează cheia pe loc "
"și, dacă merge, o salvează și pornește traducerea; numai în corpul cererii, "
"niciodată în adresă; rezultatul vine în <code>configurare</code> din "
"<code>GET /api/traducere-configurare</code>"
msgstr ""
"<code>POST /api/traducere-configurare-cheie</code>, meginmálið "
"<code>cheie=&lt;cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|"
"cloudflare|google&gt;&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: "
"prófar lykilinn strax og, ef hann virkar, vistar hann og ræsir þýðinguna; "
"aðeins í meginmáli beiðninnar, aldrei í vistfanginu; niðurstaðan kemur í "
"<code>configurare</code> úr <code>GET /api/traducere-configurare</code>"

msgid ""
"<code>POST /api/traducere-configurare-model?model=..</code>: alt model "
"pentru serviciul ales acum, cu probă"
msgstr ""
"<code>POST /api/traducere-configurare-model?model=..</code>: annað líkan "
"fyrir þjónustuna sem valin er núna, með prófun"

msgid ""
"<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;"
"&amp;adresa=..&amp;model=..</code>: folosește serverul din casă (adresa "
"completată de receptor, modelul ales singur dacă lipsește) și îl probează"
msgstr ""
"<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;"
"&amp;adresa=..&amp;model=..</code>: notar heimaþjóninn (vistfangið fyllt út "
"af móttakaranum, líkanið valið sjálfkrafa ef það vantar) og prófar hann"

msgid ""
"<code>POST /api/traducere-subtitrari-cheie</code>, corpul <code>serviciu=&lt;"
"cod&gt;&amp;cheie=&lt;cheia&gt;</code>: pune cheia unui serviciu (goală = o "
"șterge); la <code>serviciu=propriu</code> cheia este valoarea antetului "
"adresei proprii (de exemplu <code>Bearer</code> și cheia); numai în corpul "
"cererii, niciodată în adresă; răspunsul spune doar care serviciu are cheie"
msgstr ""
"<code>POST /api/traducere-subtitrari-cheie</code>, meginmálið "
"<code>serviciu=&lt;cod&gt;&amp;cheie=&lt;cheia&gt;</code>: setur lykil "
"þjónustu (tómt = eyðir honum); með <code>serviciu=propriu</code> er "
"lykillinn gildi hauss eigin vistfangs (til dæmis <code>Bearer</code> og "
"lykillinn); aðeins í meginmáli beiðninnar, aldrei í vistfanginu; svarið "
"segir aðeins hvaða þjónusta er með lykil"

msgid ""
"<code>POST /api/traducere-subtitrari-proba</code>: probează traducerea cu "
"serviciul ales; rezultatul vine în <code>stare.proba</code> din <code>GET /"
"api/traducere-subtitrari</code>"
msgstr ""
"<code>POST /api/traducere-subtitrari-proba</code>: prófar þýðinguna með "
"valinni þjónustu; niðurstaðan kemur í <code>stare.proba</code> úr <code>GET /"
"api/traducere-subtitrari</code>"

msgid ""
"<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;"
"gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;"
"limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;"
"tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;"
"&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;"
"adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=.."
"&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;"
"propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|"
"formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;"
"propriu_cale=..</code>: schimbă și salvează oricare dintre ele (valorile "
"exacte sunt în <code>alegeri</code>); o valoare greșită refuză tot. Adresa "
"proprie: adresa e un șablon cu <code>{text}</code>, <code>{sursa}</code>, "
"<code>{tinta}</code> (http:// numai pentru un server din rețeaua de acasă); "
"adresa receptorului însuși (127.0.0.1, localhost, IP-ul lui) e refuzată, și "
"la <code>adresa_libre</code> și <code>adresa_openai</code>; calea în JSON "
"are chei și numere despărțite prin punct, <code>*</code> = toate elementele"
msgstr ""
"<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;"
"gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;"
"limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;"
"tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;"
"&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;"
"adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=.."
"&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;"
"propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|"
"formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;"
"propriu_cale=..</code>: breytir og vistar hvaða þeirra sem er (nákvæmu "
"gildin eru í <code>alegeri</code>); rangt gildi hafnar öllu. Eigið vistfang: "
"vistfangið er sniðmát með <code>{text}</code>, <code>{sursa}</code>, "
"<code>{tinta}</code> (http:// aðeins fyrir þjón á heimanetinu); vistfang "
"móttakarans sjálfs (127.0.0.1, localhost, IP hans) er hafnað, einnig fyrir "
"<code>adresa_libre</code> og <code>adresa_openai</code>; slóðin í JSON hefur "
"lykla og tölur aðskildar með punkti, <code>*</code> = öll stök"

msgid ""
"<code>POST /api/traducere-subtitrari-zero</code>: contorul traducerii pus la "
"zero"
msgstr ""
"<code>POST /api/traducere-subtitrari-zero</code>: teljari þýðingarinnar "
"settur á núll"

msgid ""
"<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|"
"1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /"
"api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;"
"asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: fluxul TS al "
"transmisiei acestui browser. Pornirea și fluxul merg numai din browserul "
"conectat, cu antetul <code>X-HDS-CSRF</code>, niciodată cu <code>?token=</"
"code>"
msgstr ""
"<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|"
"1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /"
"api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;"
"asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: TS-straumur "
"sendingar þessa vafra. Ræsingin og straumurinn virka aðeins frá tengda "
"vafranum, með hausnum <code>X-HDS-CSRF</code>, aldrei með <code>?token=</"
"code>"

msgid ""
"<code>POST /api/video-confirma</code> și <code>POST /api/video-revino</"
"code>: păstrează modul încercat sau revine la cel de dinainte"
msgstr ""
"<code>POST /api/video-confirma</code> og <code>POST /api/video-revino</"
"code>: heldur prófaða hamnum eða fer aftur í þann fyrri"

msgid ""
"<code>POST /api/video-reporneste</code>: repornește receptorul (culorile „Ca "
"la calculator” se aplică numai după o repornire); cu o înregistrare în curs, "
"întrebarea apare pe televizor"
msgstr ""
"<code>POST /api/video-reporneste</code>: endurræsir móttakarann (litirnir "
"„Eins og á tölvu“ taka gildi aðeins eftir endurræsingu); ef upptaka er í "
"gangi birtist spurningin á sjónvarpinu"

msgid ""
"<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;"
"frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=.."
"&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;"
"ycbcr|rgb&gt;</code>: un mod nou se încearcă (aceeași întrebare pe "
"televizor, 20 s, fără răspuns revine); zapmode se salvează direct; "
"culori_hdmi=ycbcr se încearcă la fel (aceeași întrebare), rgb se salvează și "
"se aplică după o repornire"
msgstr ""
"<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;"
"frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=.."
"&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;"
"ycbcr|rgb&gt;</code>: nýr hamur er prófaður (sama spurning á sjónvarpinu, 20 "
"s, án svars fer til baka); zapmode er vistað beint; culori_hdmi=ycbcr er "
"prófað eins (sama spurning), rgb er vistað og beitt eftir endurræsingu"

