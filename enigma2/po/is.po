msgstr "Nýtt lykilorð: 4-64 stafir, án bila og án broddstafa"

#, python-format
msgid "Parola nu este bună (cel mult %d semne, pe un singur rând)."
msgstr "Lykilorðið er ekki gilt (í mesta lagi %d stafir, í einni línu)."

msgid ""
"Parola nu s-a putut face. Alege „Fă o parolă”. Până atunci se intră numai cu "
"o cheie."
msgstr ""
"Ekki tókst að búa til lykilorðið. Veldu „Búa til lykilorð“. Þangað til "
"virkar innskráning aðeins með lykli."

msgid "Parola nu s-a putut pune. Parola de dinainte rămâne."
msgstr "Ekki tókst að setja lykilorðið. Fyrra lykilorðið helst."

msgid ""
"Parola nu se arată: o scrii doar când vrei s-o schimbi. Un câmp de parolă "
"gol o lasă cum e."
msgstr ""
"Lykilorðið er ekki sýnt: þú skrifar það aðeins þegar þú vilt breyta því. "
"Tómur lykilorðareitur skilur það eftir eins og það er."

