msgstr ""
"Há tala þýðir ekki upptekinn örgjörvi: hún inniheldur biðþræði reklanna."

msgid "Numărul operatorului"
msgstr "Númer rekstraraðila"

msgid "Numărul poziției (1-255)"
msgstr "Númer stöðu (1-255)"

