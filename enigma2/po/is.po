msgstr "ATSC 3.0 (Bandaríkin, ný kynslóð)"

msgid ""
"ATSC 3.0: Next-gen american (NextGen TV). SUA din 2020+.\n"
"IP-based, Ultra HD, HDR, audio imersiv."
msgstr ""
"ATSC 3.0: Bandarísk næsta kynslóð (NextGen TV). Bandaríkin frá 2020+.\n"
"Byggt á IP, Ultra HD, HDR, umlykjandi hljóð."

msgid ""
"ATSC 3.0: standardul nou din SUA, folosit din 2020.\n"
"Ultra HD, HDR, sunet cu efect de spațiu."
msgstr ""
"ATSC 3.0: nýi staðallinn í Bandaríkjunum, í notkun frá 2020.\n"
"Ultra HD, HDR, umgerðarhljóð."

msgid "ATSC: gestionat de BDA pe PC. Folosește aplicația ATSC dedicată."
msgstr "ATSC: meðhöndlað af BDA á tölvu. Notaðu sérstaka ATSC-forritið."

