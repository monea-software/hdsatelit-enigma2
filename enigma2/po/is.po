msgstr ""
"„%s“ finnst ekki í frjálsa safninu google/fonts: leyfi óstaðfest, ekkert er "
"sótt."

msgid "„%s” nu se poate folosi: %s."
msgstr "„%s“ er ekki hægt að nota: %s."

