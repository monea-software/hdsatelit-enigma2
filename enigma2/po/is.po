msgstr ""
"Einu sinni á dag, í bakgrunni, sækir móttakarinn tíðnir og nöfn stöðvanna af "
"stb.hdsatelit.com. Hnappurinn Uppfæra lista virkar hvenær sem er."

msgid "O dată pe minut"
msgstr "Einu sinni á mínútu"

msgid "O dată pe săptămână"
msgstr "Einu sinni í viku"

msgid ""
"O dată pe zi, noaptea, numai felurile bifate, și imediat după o oprire "
"neașteptată a interfeței sau o actualizare care nu a reușit. Fără bifă "
"pleacă numai ce trimiți tu cu „Trimite acum”."
msgstr ""
"Einu sinni á dag, að nóttu til, aðeins þær tegundir sem hakað er við, og "
"strax eftir óvænta stöðvun viðmótsins eða misheppnaða uppfærslu. Án hak fer "
"aðeins það sem þú sendir með „Senda núna“."

msgid ""
"O dată pe zi, în fundal, receptorul ia de pe stb.hdsatelit.com frecvențele "
"și numele posturilor. Butonul „Actualizează lista” merge oricând. <span "
"id=\"ultimaZilnica\"></span>"
msgstr ""
"Einu sinni á dag, í bakgrunni, sækir móttakarinn tíðnir og nöfn stöðva af "
"stb.hdsatelit.com. Hnappurinn „Uppfærðu listann“ virkar hvenær sem er. <span "
"id=\"ultimaZilnica\"></span>"

msgid "O eroare pe receptor."
msgstr "Villa á móttakaranum."

msgid "O greșeală, o idee sau o întrebare, direct echipei."
msgstr "Villa, hugmynd eða spurning, beint til teymisins."

msgid "O lipești, iar receptorul recunoaște singur serviciul."
msgstr "Þú límir hana og móttakarinn þekkir þjónustuna sjálfur."

msgid ""
"O listă de redare de pe disc nu se poate șterge din player, nici pe "
"televizor."
msgstr ""
"Spilunarlista á diski er ekki hægt að eyða úr spilaranum, ekki heldur í "
"sjónvarpinu."

msgid "O margine e între 0 și 5 la sută din latura ei."
msgstr "Brún er á milli 0 og 5 prósent af sinni hlið."

msgid "O notă despre emisiune. OK deschide tastatura."
msgstr "Athugasemd um dagskrána. OK opnar lyklaborðið."

msgid "O pagină mai jos"
msgstr "Ein síða niður"

msgid "O pagină mai sus"
msgstr "Ein síða upp"

msgid "O pagină în jos"
msgstr "Ein síða niður"

msgid "O pagină în sus"
msgstr "Ein síða upp"

msgid ""
"O poză nu a putut fi urcată: trebuie să fie JPG sau PNG, de cel mult 4 MB."
msgstr ""
"Ekki tókst að hlaða upp mynd: hún verður að vera JPG eða PNG, í mesta lagi 4 "
"MB."

msgid "O poți instala din nou oricând, din aceeași sursă."
msgstr "Þú getur sett það upp aftur hvenær sem er, úr sömu heimild."

msgid "O probă DiSEqC e deja deschisă pe televizor. Închide-o întâi."
msgstr "DiSEqC-prófun er þegar opin á sjónvarpinu. Lokaðu henni fyrst."

msgid "O reîmprospătare e deja în lucru."
msgstr "Endurnýjun er þegar í gangi."

msgid "O reîncărcare e deja în curs."
msgstr "Endurhleðsla er þegar í gangi."

msgid ""
"O scanare DAB+ sau DVB-T2 e deschisă pe televizor. Așteaptă să se termine "
"sau oprește-o."
msgstr ""
"DAB+ eða DVB-T2 rásaleit er opin á sjónvarpinu. Bíddu eftir að henni ljúki "
"eða stöðvaðu hana."

msgid "O singură dată"
msgstr "Einu sinni"

msgid ""
"O singură dată sau repetat: în fiecare zi, o dată pe săptămână, de luni până "
"vineri sau în zilele alese."
msgstr ""
"Einu sinni eða endurtekið: alla daga, einu sinni í viku, mánudaga til "
"föstudaga eða á völdum dögum."

msgid "O singură limbă: forumul traduce singur."
msgstr "Eitt tungumál: spjallborðið þýðir sjálft."

msgid ""
"O telecomandă USB (sau o tastatură) se bagă în receptor înainte; se vede "
"imediat."
msgstr ""
"USB-fjarstýring (eða lyklaborð) er sett í móttakarann fyrst; hún finnst "
"strax."

msgid ""
"O telecomandă cu infraroșu, alta decât a receptorului, nu se poate asocia "
"încă."
msgstr "Innrauð fjarstýring, önnur en móttakarans, er ekki hægt að para enn."

msgid "O valoare a transponderului nu e bună: %s."
msgstr "Eitt gildi sendisins er ógilt: %s."

msgid "O înregistrare e în curs."
msgstr "Upptaka er í gangi."

msgid "O înregistrare e în curs: se oprește la revenire."
msgstr "Upptaka er í gangi: hún stöðvast við endurræsingu."

msgid ""
"O înregistrare folosește acum antena. Comenzile pornesc după ce se termină."
msgstr "Upptaka notar loftnetið núna. Skipanirnar hefjast þegar henni lýkur."

msgid ""
"O înregistrare folosește acum tunerul. Locul se schimbă după ce se termină."
msgstr ""
"Upptaka notar núna móttakarann. Staðsetningin breytist eftir að henni lýkur."

msgid "O înregistrare programată nu poate porni: nu am unde să înregistrez."
msgstr "Áætluð upptaka getur ekki byrjað: enginn staður fyrir upptökur."

#, python-format
msgid "O înregistrare scrie acum pe acest disc: %s."
msgstr "Upptaka skrifar núna á þennan disk: %s."

msgid "O înregistrare începe în curând. Pornește scanarea detaliată după ea."
msgstr "Upptaka byrjar bráðum. Ræstu ítarlegu leitina eftir hana."

#, python-format
msgid "O înregistrare începe în mai puțin de %d minute."
msgstr "Upptaka hefst eftir innan við %d mínútur."

msgid "O înregistrare începe în mai puțin de 6 minute."
msgstr "Upptaka hefst eftir minna en 6 mínútur."

