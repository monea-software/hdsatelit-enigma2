#, python-format
msgid "Acest receptor nu a prins niciodată semnal pe o poziție: %s."
msgstr "Denne mottakeren har aldri mottatt signal på én posisjon: %s."

msgid "Acest receptor nu are încă unealta care face ecranul dintr-o poză."
msgstr ""
"Denne mottakeren har ennå ikke verktøyet som lager skjermen fra et bilde."

msgid ""
"Acest receptor nu poate muta imaginea; cadrul arată numai unde ar ajunge "
"marginile."
msgstr ""
"Denne mottakeren kan ikke flytte bildet; rammen viser bare hvor margene "
"ville havne."

msgid ""
"Acest satelit se recepționează numai cu motorul USALS, iar motorul nu știe "
"unde ești, deci antena nu se rotește. Apasă OK și alege țara și orașul."
msgstr ""
"Denne satellitten mottas bare med USALS-motoren, og motoren vet ikke hvor du "
"er, så antennen roterer ikke. Trykk OK og velg land og by."

msgid ""
"Acest serviciu nu are imagine și nici sunet. Trimite numai date, de exemplu "
"actualizări sau ghidul programelor."
msgstr ""
"Denne tjenesten har verken bilde eller lyd. Den sender bare data, for "
"eksempel oppdateringer eller programguiden."

msgid "Acest serviciu nu are imagine și nici sunet. Trimite: %s."
msgstr "Denne tjenesten har verken bilde eller lyd. Den sender: %s."

