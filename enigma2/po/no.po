msgstr "Radiokanalens navn"

msgid "Numele public"
msgstr "Offentlig navn"

msgid "Numele public are 2-40 de semne: litere, cifre, spațiu, punct, liniuță."
msgstr ""
"Det offentlige navnet har 2-40 tegn: bokstaver, tall, mellomrom, punktum, "
"bindestrek."

msgid "Numele public e deja folosit de alt tester. Alege altul."
msgstr ""
"Det offentlige navnet er allerede brukt av en annen tester. Velg et annet."

msgid "Numele receptorului"
msgstr "Mottakernavn"

msgid "Numele receptorului pe televizor"
msgstr "Mottakerens navn på TV-en"

msgid "Numele rețelei ascunse"
msgstr "Navnet på det skjulte nettverket"

msgid "Numele satelitului"
msgstr "Satellittens navn"

msgid "Numele satelitului are un caracter care nu se poate scrie în listă."
msgstr "Satellittnavnet har et tegn som ikke kan skrives i listen."

msgid "Numele satelitului e prea lung: cel mult %d de caractere."
msgstr "Satellittnavnet er for langt: maks %d tegn."

msgid "Numele sau parola nu sunt bune. VPN-ul nu mai încearcă singur."
msgstr "Navnet eller passordet er feil. VPN-en prøver ikke lenger selv."

msgid "Numele serverului NTP nu este valid."
msgstr "Navnet på NTP-serveren er ikke gyldig."

msgid ""
"Numele serverului nu se găsește în rețea. Scrie adresa lui, de pildă "
"192.168.1.20."
msgstr ""
"Servernavnet finnes ikke på nettverket. Skriv inn adressen dens, for "
"eksempel 192.168.1.20."

msgid "Numele setării, cu tastele 0-9"
msgstr "Navnet på innstillingen, med tastene 0-9"

msgid ""
"Numele spune HD sau 4K, dar emițătorul îl anunță ca SD: filtrul „HD și 4K” "
"nu-l prinde. Filtrul „HD în nume, tip SD” din „Adaugă canale” le arată pe "
"toate, cu bife."
msgstr ""
"Navnet sier HD eller 4K, men kringkasteren oppgir kanalen som SD: filteret "
"«HD og 4K» fanger den ikke. Filteret «HD i navnet, type SD» under «Legg til "
"kanaler» viser alle, med avkryssing."

msgid "Numele sursei (litere mici, cifre și -)"
msgstr "Kildenavnet (små bokstaver, sifre og -)"

msgid "Numele sursei nu poate fi gol."
msgstr "Kildenavnet kan ikke være tomt."

msgid "Numele sursei: litere mici, cifre și -"
msgstr "Kildenavnet: små bokstaver, tall og -"

msgid "Numele telecomenzii"
msgstr "Navnet på fjernkontrollen"

msgid "Numele telecomenzii nu poate fi gol."
msgstr "Navnet på fjernkontrollen kan ikke være tomt."

msgid "Numele tău pe forum"
msgstr "Ditt navn på forumet"

msgid "Numele tău pe forum e acum „%s”."
msgstr "Navnet ditt på forumet er nå «%s»."

msgid "Numele și parola au fost șterse de pe receptor."
msgstr "Navnet og passordet ble slettet fra mottakeren."

msgid "Numele și parola contului"
msgstr "Kontonavn og passord"

msgid ""
"Numele și parola contului HMA. După salvare nu se mai arată nicăieri. Se "
"scriu mai ușor din telefon, în interfața web."
msgstr ""
"Navnet og passordet til HMA-kontoen. Etter lagring vises de ikke lenger noe "
"sted. De er enklere å skrive fra telefonen, i nettgrensesnittet."

msgid "Numele și parola de serviciu"
msgstr "Tjenestenavn og -passord"

msgid "Numele și parola din fișier nu se folosesc: se scriu pe receptor."
msgstr "Navnet og passordet i filen brukes ikke: de skrives på mottakeren."

msgid "Numele și parola sunt salvate. Nu se mai arată nicăieri."
msgstr "Navnet og passordet er lagret. De vises ikke lenger noe sted."

msgid "Numele, cu tastatura de pe ecran"
msgstr "Navnet, med skjermtastaturet"

msgid "Numele, cu tastele 0-9"
msgstr "Navnet, med tastene 0-9"

msgid ""
"Numerele DVB ale fluxului (pentru siglă): SID, TSID, ONID, namespace (hex)"
msgstr "DVB-numrene for strømmen (for logo): SID, TSID, ONID, namespace (hex)"

msgid "Număr de fișiere"
msgstr "Antall filer"

msgid "Numărate de la ora"
msgstr "Telt fra klokken"

msgid "Numărul canalului"
msgstr "Kanalnummer"

msgid "Numărul canalului din lista de canale."
msgstr "Kanalnummeret fra kanallisten."

#, python-format
msgid "Numărul copiilor păstrate trebuie să fie între 1 și %d."
msgstr "Antallet beholdte kopier må være mellom 1 og %d."

msgid "Numărul de bare"
msgstr "Antall søyler"

msgid "Numărul de secunde nu este bun."
msgstr "Antallet sekunder er ugyldig."

msgid "Numărul din lista de canale, cel la care duc cifrele telecomenzii."
msgstr "Nummeret fra kanallisten, det sifrene på fjernkontrollen fører til."

msgid ""
"Numărul mare nu înseamnă procesor ocupat: include firele driverelor care "
"așteaptă."
msgstr ""
"Et høyt tall betyr ikke at prosessoren er opptatt: Det inkluderer "
"drivertråder som venter."

msgid "Numărul operatorului"
msgstr "Operatørens nummer"

msgid "Numărul poziției (1-255)"
msgstr "Posisjonens nummer (1-255)"

#, python-format
msgid "Numărul procesului (PID): %s"
msgstr "Prosessnummer (PID): %s"

msgid "Numărul rețelei (ONID)"
msgstr "Nettverksnummer (ONID)"

msgid "Numărul transponderului (TSID)"
msgstr "Transpondernummer (TSID)"

msgid "Numărul și numele"
msgstr "Nummer og navn"

msgid "Numărătoarea opririlor"
msgstr "Stoppteller"

msgid ""
"O adresă http:// merge numai pentru un server din rețeaua de acasă (de "
"exemplu 192.168.1.50); pentru un server de pe internet scrie https://."
msgstr ""
"En http://-adresse virker bare for en server på hjemmenettverket (for "
"eksempel 192.168.1.50); for en server på internett skriver du https://."

msgid ""
"O altă placă e deja configurată. Pe televizor, aceeași întrebare apare la OK."
msgstr ""
"Et annet kort er allerede konfigurert. På TV-en vises samme spørsmål ved OK."

msgid "O altă schimbare a rețelei încă lucrează. Așteaptă să se termine."
msgstr "En annen nettverksendring pågår fortsatt. Vent til den er ferdig."

msgid "O altă schimbare de LNB așteaptă confirmarea."
msgstr "En annen LNB-endring venter på bekreftelse."

msgid "O altă valoare a receptorului nu se potrivește."
msgstr "En annen verdi på mottakeren stemmer ikke."

msgid "O captură aleasă nu mai există. Alege din nou."
msgstr "Et valgt skjermbilde finnes ikke lenger. Velg på nytt."

msgid ""
"O cheie pleacă numai pe https:// sau spre un server din rețeaua de acasă. "
"Scrie adresa cu https://. Cheia nu a plecat nicăieri."
msgstr ""
"En nøkkel sendes bare over https:// eller til en server på hjemmenettverket. "
"Skriv adressen med https://. Nøkkelen ble ikke sendt noe sted."

msgid "O conectare Wi-Fi încă lucrează. Așteaptă să se termine sau oprește-o."
msgstr ""
"En Wi-Fi-tilkobling pågår fortsatt. Vent til den er ferdig, eller stopp den."

msgid "O copie așteaptă să fie pusă la loc la repornirea interfeței."
msgstr ""
"En kopi venter på å bli lagt tilbake når grensesnittet starter på nytt."

msgid "O copie se face deja. Așteaptă să se termine."
msgstr "En kopi lages allerede. Vent til den er ferdig."

msgid ""
"O copie se face singură înainte de fiecare salvare, aici și în interfața "
"web. Întoarcerea pune întâi lista de acum într-o copie nouă."
msgstr ""
"En kopi lages automatisk før hver lagring, her og i nettgrensesnittet. "
"Tilbakestilling legger først gjeldende liste i en ny kopi."

msgid "O cutie pentru toate rândurile"
msgstr "En boks for alle linjene"

msgid ""
"O căutare e deja în curs pe receptor. Așteaptă să se termine sau oprește-o."
msgstr ""
"En søking pågår allerede på mottakeren. Vent til den er ferdig eller stopp "
"den."

msgid "O căutare e deja în curs."
msgstr "Et søk pågår allerede."

msgid "O căutare sau o descărcare merge deja; așteaptă să se termine."
msgstr "Et søk eller en nedlasting kjører allerede; vent til den er ferdig."

msgid ""
"O data pe zi, in fundal, receptorul ia de pe stb.hdsatelit.com frecventele "
"si numele posturilor. Butonul Actualizeaza lista merge oricand."
msgstr ""
"Én gang om dagen, i bakgrunnen, henter mottakeren frekvensene og "
"stasjonsnavnene fra stb.hdsatelit.com. Knappen «Oppdater listen» fungerer "
"når som helst."

msgid "O dată pe minut"
msgstr "Én gang i minuttet"

msgid "O dată pe săptămână"
msgstr "Én gang i uken"

msgid ""
"O dată pe zi, noaptea, numai felurile bifate, și imediat după o oprire "
"neașteptată a interfeței sau o actualizare care nu a reușit. Fără bifă "
"pleacă numai ce trimiți tu cu „Trimite acum”."
msgstr ""
"Én gang om dagen, om natten, bare de avkryssede typene, og rett etter et "
"uventet stopp av grensesnittet eller en mislykket oppdatering. Uten "
"avkrysning sendes bare det du sender med «Send nå»."

msgid ""
"O dată pe zi, în fundal, receptorul ia de pe stb.hdsatelit.com frecvențele "
"și numele posturilor. Butonul „Actualizează lista” merge oricând. <span "
"id=\"ultimaZilnica\"></span>"
msgstr ""
"En gang om dagen, i bakgrunnen, henter mottakeren frekvensene og navnene på "
"stasjonene fra stb.hdsatelit.com. Knappen «Oppdater listen» fungerer når som "
"helst. <span id=\"ultimaZilnica\"></span>"

msgid "O eroare pe receptor."
msgstr "En feil på mottakeren."

msgid "O greșeală, o idee sau o întrebare, direct echipei."
msgstr "En feil, en idé eller et spørsmål, rett til teamet."

msgid "O lipești, iar receptorul recunoaște singur serviciul."
msgstr "Du limer den inn, og mottakeren gjenkjenner tjenesten selv."

msgid ""
"O listă de redare de pe disc nu se poate șterge din player, nici pe "
"televizor."
msgstr ""
"En spilleliste på disken kan ikke slettes fra spilleren, heller ikke på TV-"
"en."

msgid "O margine e între 0 și 5 la sută din latura ei."
msgstr "En marg er mellom 0 og 5 prosent av sin side."

msgid "O notă despre emisiune. OK deschide tastatura."
msgstr "En merknad om programmet. OK åpner tastaturet."

msgid "O pagină mai jos"
msgstr "Én side ned"

msgid "O pagină mai sus"
msgstr "Én side opp"

msgid "O pagină în jos"
msgstr "Én side ned"

msgid "O pagină în sus"
msgstr "Én side opp"

msgid ""
"O poză nu a putut fi urcată: trebuie să fie JPG sau PNG, de cel mult 4 MB."
msgstr "Et bilde kunne ikke lastes opp: det må være JPG eller PNG, høyst 4 MB."

msgid "O poți instala din nou oricând, din aceeași sursă."
msgstr "Du kan installere den på nytt når som helst, fra samme kilde."

msgid "O probă DiSEqC e deja deschisă pe televizor. Închide-o întâi."
msgstr "En DiSEqC-test er allerede åpen på TV-en. Lukk den først."

msgid "O reîmprospătare e deja în lucru."
msgstr "En oppdatering er allerede i gang."

msgid "O reîncărcare e deja în curs."
msgstr "En ny innlasting pågår allerede."

msgid ""
"O scanare DAB+ sau DVB-T2 e deschisă pe televizor. Așteaptă să se termine "
"sau oprește-o."
msgstr ""
"En DAB+- eller DVB-T2-skanning er åpen på TV-en. Vent til den er ferdig "
"eller stopp den."

msgid "O singură dată"
msgstr "Én gang"

msgid ""
"O singură dată sau repetat: în fiecare zi, o dată pe săptămână, de luni până "
"vineri sau în zilele alese."
msgstr ""
"Én gang eller gjentatt: hver dag, én gang i uken, mandag til fredag eller på "
"valgte dager."

msgid "O singură limbă: forumul traduce singur."
msgstr "Ett språk: forumet oversetter selv."

msgid ""
"O telecomandă USB (sau o tastatură) se bagă în receptor înainte; se vede "
"imediat."
msgstr ""
"En USB-fjernkontroll (eller et tastatur) settes inn i mottakeren først; den "
"oppdages med en gang."

msgid ""
"O telecomandă cu infraroșu, alta decât a receptorului, nu se poate asocia "
"încă."
msgstr ""
"En infrarød fjernkontroll som ikke hører til mottakeren, kan ikke kobles til "
"ennå."

msgid "O valoare a transponderului nu e bună: %s."
msgstr "En verdi for transponderen er ugyldig: %s."

msgid "O înregistrare e în curs."
msgstr "Et opptak pågår."

msgid "O înregistrare e în curs: se oprește la revenire."
msgstr "Et opptak pågår: det stopper ved tilbakestilling."

msgid ""
"O înregistrare folosește acum antena. Comenzile pornesc după ce se termină."
msgstr "Et opptak bruker parabolen nå. Kommandoene starter når det er ferdig."

msgid ""
"O înregistrare folosește acum tunerul. Locul se schimbă după ce se termină."
msgstr ""
"Et opptak bruker nå tuneren. Plasseringen endres etter at det er ferdig."

msgid "O înregistrare programată nu poate porni: nu am unde să înregistrez."
msgstr "Et planlagt opptak kan ikke starte: Det er ingen steder å ta opp."

#, python-format
msgid "O înregistrare scrie acum pe acest disc: %s."
msgstr "Et opptak skriver nå til denne disken: %s."

msgid "O înregistrare începe în curând. Pornește scanarea detaliată după ea."
msgstr "Et opptak starter snart. Start det detaljerte søket etter det."

#, python-format
msgid "O înregistrare începe în mai puțin de %d minute."
msgstr "Et opptak starter om mindre enn %d minutter."

msgid "O înregistrare începe în mai puțin de 6 minute."
msgstr "Et opptak starter om mindre enn 6 minutter."

msgid "OK"
msgstr "OK"

msgid "OK = da, EXIT = nu"
msgstr "OK = ja, EXIT = nei"

msgid "OK actualizează · Roșu șterge"
msgstr "OK oppdaterer · Rød sletter"

msgid "OK adaugă"
msgstr "OK legger til"

msgid ""
"OK adaugă canalul în buchetul din dreapta · cifrele scriu numele · HELP "
"ajutor"
msgstr ""
"OK legger kanalen til buketten til høyre · sifrene skriver navnet · HELP "
"hjelp"

msgid "OK add to playlist, MENU options, CH+ / CH- switch list"
msgstr "OK legg til i spilleliste, MENU alternativer, CH+ / CH- bytt liste"

msgid "OK alege"
msgstr "OK velger"

msgid "OK alege capturile, Verde le pune în mesaj."
msgstr "OK velger skjermbildene, Grønn legger dem i meldingen."

msgid "OK alege feedul pachetelor arătate."
msgstr "OK velger feeden for de viste pakkene."

msgid "OK alege feedul sau felul pachetelor arătate."
msgstr "OK velger feeden eller typen viste pakker."

msgid ""
"OK alege latura: toate, sus, dreapta, jos sau stânga. Săgeata spre margine "
"duce latura aleasă spre marginea ecranului, săgeata opusă o aduce spre "
"mijloc. La toate laturile, Sus și Dreapta măresc cadrul, Jos și Stânga îl "
"micșorează. Potrivește cadrul până se vede întreg pe televizor."
msgstr ""
"OK velger siden: alle, opp, høyre, ned eller venstre. Piltasten mot kanten "
"flytter valgt side mot skjermkanten, motsatt piltast fører den mot midten. "
"Ved alle sider forstørrer Opp og Høyre rammen, Ned og Venstre forminsker "
"den. Tilpass rammen til du ser hele på TV-en."

msgid ""
"OK alege orașul. Ora lui apare când „Ora din alt oraș” e în lista de rotire."
msgstr ""
"OK velger byen. Tiden vises når «Tid i en annen by» er i roteringslisten."

msgid "OK alege valoarea."
msgstr "OK velger verdien."

msgid "OK alege valoarea. Luminozitatea se aplică după salvare."
msgstr "OK velger verdien. Lysstyrken gjelder etter lagring."

msgid "OK alege valoarea. Se aplică după salvare."
msgstr "OK velger verdien. Den gjelder etter lagring."

msgid "OK alege · Roșu arată tot"
msgstr "OK velger · Rød viser alt"

msgid ""
"OK alegi canalele ale căror piste se citesc acum · Stânga înapoi la nume"
msgstr "OK velger kanalene hvis spor leses nå · Venstre tilbake til navnet"

msgid "OK arată canalele"
msgstr "OK viser kanalene"

msgid "OK arată de ce"
msgstr "OK viser hvorfor"

msgid "OK arată de ce · Verde instalează înlocuitorul"
msgstr "OK viser hvorfor · Grønn installerer erstatningen"

msgid ""
"OK arată fișierele de setări ale serverelor SSH și FTP, așa cum sunt pe "
"receptor."
msgstr ""
"OK viser innstillingsfilene til SSH- og FTP-serverne slik de er på "
"mottakeren."

msgid ""
"OK arată fișierele de setări ale serverului SSH, așa cum sunt pe receptor."
msgstr "OK viser SSH-serverens innstillingsfiler slik de er på mottakeren."

msgid "OK ascunde canalele"
msgstr "OK skjuler kanalene"

msgid "OK bifează sau debifează"
msgstr "OK krysser av eller fjerner merking"

msgid "OK bifează sau debifează · pe titlul grupei: toată grupa"
msgstr "OK krysser av eller fjerner merking · på gruppetittelen: hele gruppen"

msgid ""
"OK bifează și trece mai jos · tastele colorate lucrează pe rândurile bifate"
msgstr ""
"OK krysser av og går nedover · fargetastene virker på de avmerkede radene"

msgid "OK caută"
msgstr "OK søker"

msgid ""
"OK caută singur serverul din casă (LibreTranslate sau Ollama) și îl "
"probează. Adresa se poate scrie și de mână, mai jos."
msgstr ""
"OK finner selv serveren hjemme (LibreTranslate eller Ollama) og tester den. "
"Adressen kan også skrives for hånd, nedenfor."

msgid "OK caută în rețea"
msgstr "OK søker i nettverket"

msgid "OK deschide"
msgstr "OK åpner"

msgid ""
"OK deschide adresele puse de mână, listele predefinite și pornirea DVB-I."
msgstr ""
"OK åpner de manuelt lagt til adressene, de forhåndsdefinerte listene og av/"
"på for DVB-I."

msgid ""
"OK deschide buchetul · Stânga / Dreapta: coloana · < anulează · > refă · "
"HELP ajutor"
msgstr ""
"OK åpner buketten · Venstre / Høyre: kolonne · < angre · > gjør om · HELP "
"hjelp"

msgid ""
"OK deschide lista limbilor: cele din imagine, cele descărcate și cele care "
"se pot descărca, cu mărimea fiecăreia."
msgstr ""
"OK åpner listen over språk: de i image, de nedlastede og de som kan lastes "
"ned, med størrelsen på hvert."

msgid "OK deschide meniul, cu „Locul înregistrărilor”."
msgstr "OK åpner menyen, med «Lagringssted for opptak»."

msgid ""
"OK deschide pașii pentru serviciul ales: contul, cheia gratuită, cota și ce "
"se întâmplă la depășire."
msgstr ""
"OK åpner trinnene for den valgte tjenesten: kontoen, gratisnøkkelen, kvoten "
"og hva som skjer når du overskrider den."

msgid "OK deschide sau închide toți sateliții"
msgstr "OK åpner eller lukker alle satellitter"

msgid "OK deschide tastatura."
msgstr "OK åpner tastaturet."

msgid ""
"OK deschide tastatura. ID-ul contului are 32 de litere și cifre: în panoul "
"Cloudflare, la „Account ID”."
msgstr ""
"OK åpner tastaturet. Konto-ID-en har 32 bokstaver og sifre: i Cloudflare-"
"panelet, under «Account ID»."

msgid ""
"OK deschide tastatura. Textul apare când „Textul tău” e în lista de rotire."
msgstr ""
"OK åpner tastaturet. Teksten vises når «Din tekst» er i roteringslisten."

msgid ""
"OK deschide · Stânga / Dreapta: coloana · cifrele scriu numele · HELP ajutor"
msgstr ""
"OK åpner · Venstre / Høyre: kolonne · sifrene skriver navnet · HELP hjelp"

msgid "OK deschide · cifrele: poziția · < anulează · > refă · HELP ajutor"
msgstr "OK åpner · sifrene: posisjon · < angre · > gjør om · HELP hjelp"

msgid "OK full screen, INFO details, EXIT back to the list"
msgstr "OK fullskjerm, INFO detaljer, EXIT tilbake til listen"

msgid ""
"OK ia rândul ca să-l muți · cifrele: poziția · < anulează · > refă · HELP "
"ajutor"
msgstr ""
"OK tar raden for å flytte den · sifrene: posisjon · < angre · > gjør om · "
"HELP hjelp"

msgid "OK instalează"
msgstr "OK installerer"

msgid "OK instalează fișierul"
msgstr "OK installerer filen"

msgid "OK le deschide"
msgstr "OK åpner dem"

msgid "OK o arată acum pe afișaj, o dată."
msgstr "OK viser det på displayet nå, én gang."

msgid "OK oprește VPN-ul. Internetul merge apoi direct, prin rețeaua ta."
msgstr ""
"OK stopper VPN-en. Internett går deretter direkte, gjennom nettverket ditt."

msgid ""
"OK oprește. Oricine din rețeaua ta de acasă intră acum pe receptor fără "
"parolă."
msgstr ""
"OK slår det av. Alle på hjemmenettverket ditt kommer nå inn på mottakeren "
"uten passord."

msgid "OK pe o pagină: deschide-o sau scoate-o din favorite."
msgstr "OK på en side: åpne den eller fjern den fra favoritter."

msgid ""
"OK pe un rând deschide tastatura. Parola nu se arată: o scrii numai când "
"vrei s-o schimbi; un rând gol o lasă cum e."
msgstr ""
"OK på en rad åpner tastaturet. Passordet vises ikke: du skriver det bare når "
"du vil endre det; en tom rad lar det være som det er."

msgid "OK pornește VPN-ul cu serverul ales."
msgstr "OK starter VPN-en med den valgte serveren."

msgid "OK pornește canalul · Stânga/Dreapta: pagina · Sus la filtre"
msgstr "OK starter kanalen · Venstre/Høyre: side · Opp til filtrene"

msgid ""
"OK pornește sau oprește, pe loc. Se vede când e în lista de rotire (grupa "
"„Ora și data”)."
msgstr ""
"OK starter eller stopper med en gang. Den vises når den er i roteringslisten "
"(gruppen «Tid og dato»)."

msgid "OK probează"
msgstr "OK tester den"

msgid "OK pune contorul la zero."
msgstr "OK nullstiller telleren."

#, python-format
msgid "OK pune ecranul „%s”. Se vede la următoarea pornire."
msgstr "OK setter skjermen «%s». Den vises ved neste oppstart."

msgid "OK salvează alegerile și închide ecranul."
msgstr "OK lagrer valgene og lukker skjermen."

msgid "OK sau Albastru descarcă lista"
msgstr "OK eller Blå laster ned listen"

msgid "OK sau EXIT închide fereastra și anulează codul."
msgstr "OK eller EXIT lukker vinduet og avbryter koden."

msgid "OK sau EXIT închide fereastra."
msgstr "OK eller EXIT lukker vinduet."

