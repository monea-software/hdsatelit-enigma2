msgstr "Kopien stoppet: %s."

#, python-format
msgid "Copia s-a salvat: %d de pagini"
msgstr "Kopien ble lagret: %d sider"

msgid "Copia s-a șters."
msgstr "Kopien ble slettet."

msgid "Copia se pune la loc la repornirea interfeței."
msgstr "Kopien legges tilbake når grensesnittet starter på nytt."

msgid "Copia setărilor"
msgstr "Innstillingskopi"

