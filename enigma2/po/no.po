msgid "Thai"
msgstr "thai"

msgid "Thailanda"
msgstr "Thailand"

msgid ""
"Thank you for using the wizard. Your box is now ready to use.\n"
"Please press OK to start using your receiver."
msgstr ""
"Takk for at du brukte veiviseren. Mottakeren er nå klar til bruk.\n"
"Trykk OK for å begynne å bruke mottakeren."

msgid ""
"The NetworkWizard extension is not installed!\n"
"Please install it."
msgstr ""
"Utvidelsen NetworkWizard er ikke installert!\n"
"Installer den."

msgid "The PIN code has been changed successfully."
msgstr "PIN-koden ble endret."

msgid "The PIN codes you entered are different."
msgstr "PIN-kodene du skrev inn er forskjellige."

msgid ""
"The Softwaremanagement extension is not installed!\n"
"Please install it."
msgstr ""
"Utvidelsen Softwaremanagement er ikke installert!\n"
"Installer den."

msgid "The WiFi adapter could not be started."
msgstr "Wi-Fi-adapteren kunne ikke startes."

msgid "The WiFi screen could not be opened."
msgstr "Wi-Fi-skjermen kunne ikke åpnes."

msgid "The WiFi settings could not be saved."
msgstr "Wi-Fi-innstillingene kunne ikke lagres."

#, python-format
msgid ""
"The directory %s is not writable.\n"
