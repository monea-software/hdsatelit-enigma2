msgstr "Visning"

msgid "Afișează din nou codul pe televizor"
msgstr "Vis koden på TV-en igjen"

msgid ""
"Afișează iconița Buton Roșu în bara de informații când HbbTV e disponibil."
msgstr ""
"Vis ikonet for rød knapp i informasjonslinjen når HbbTV er tilgjengelig."

msgid "Află adresa IP și țara pe care le văd site-urile acum."
msgstr "Finner IP-adressen og landet som nettsider ser nå."

msgid ""
"Află adresa calculatorului în rețea (de exemplu 192.168.1.50) și scrie aici "
"http://192.168.1.50:5000. Cheie nu trebuie."
msgstr ""
"Finn datamaskinens adresse på nettverket (for eksempel 192.168.1.50) og "
"skriv http://192.168.1.50:5000 her. Ingen nøkkel trengs."

msgid "Află locul după internet"
msgstr "Finn stedet via internett"

