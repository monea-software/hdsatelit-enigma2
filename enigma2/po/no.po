msgid_plural "Copiate %d rânduri"
msgstr[0] "Kopiert %d rad"
msgstr[1] "Kopiert %d rader"

msgid "Copiat."
msgstr "Kopiert."

msgid "Copiate. Alege locul și apasă Ctrl+V."
msgstr "Kopiert. Velg stedet og trykk Ctrl+V."

msgid ""
"Copiaz-o întreagă din pagina cheii (console.cloud.google.com/apis/"
"credentials), fără spații. În proiectul cheii pornește „Cloud Translation "
"API” și verifică să nu fie cheia restrânsă la alt API."
msgstr ""
"Kopier den helt fra nøkkelsiden (console.cloud.google.com/apis/credentials), "
"uten mellomrom. I nøkkelens prosjekt slår du på «Cloud Translation API» og "
"sjekker at nøkkelen ikke er begrenset til en annen API."

msgid "Copiaz-o întreagă din pagina cheii, fără spații, și încearcă din nou."
msgstr "Kopier den helt fra nøkkelsiden, uten mellomrom, og prøv igjen."

msgid ""
"Copiaz-o întreagă din pagina cheii, fără spații. Cheia pentru Gemini se face "
"pe aistudio.google.com/apikey."
msgstr ""
"Kopier den helt fra nøkkelsiden, uten mellomrom. Nøkkelen for Gemini lages "
"på aistudio.google.com/apikey."

#, python-format
msgid "Copiaz-o întreagă din pagina cheilor (%s), fără spații."
msgstr "Kopier den helt fra nøkkelsiden (%s), uten mellomrom."

msgid ""
"Copiaz-o întreagă din pagina cheilor DeepL (www.deepl.com/your-account/"
"keys), fără spații. Trebuie o cheie de la DeepL API, nu de la traducătorul "
"obișnuit."
msgstr ""
"Kopier den helt fra DeepL-nøkkelsiden (www.deepl.com/your-account/keys), "
"uten mellomrom. Det må være en nøkkel fra DeepL API, ikke fra den vanlige "
"oversetteren."

msgid ""
"Copiaz-o întreagă din portal (resursa Translator, „Keys and Endpoint”, KEY "
"1), fără spații, și verifică regiunea: scrisă exact ca în portal (de exemplu "
"westeurope), sau Global dacă resursa e globală."
msgstr ""
"Kopier den helt fra portalen (Translator-ressursen, «Keys and Endpoint», KEY "
"1), uten mellomrom, og sjekk regionen: skrevet nøyaktig som i portalen (for "
"eksempel westeurope), eller Global hvis ressursen er global."

msgid "Copiază"
msgstr "Kopier"

msgid ""
"Copiază acum cele două adrese în aparat: se arată numai o dată. Dacă le "
"pierzi, adaugi aparatul din nou și îl revoci pe cel vechi."
msgstr ""
"Kopier nå de to adressene inn i enheten: de vises bare én gang. Hvis du "
"mister dem, legger du til enheten på nytt og tilbakekaller den gamle."

msgid "Copiază adresa"
msgstr "Kopier adressen"

msgid "Copiază buchetul"
msgstr "Kopier buketten"

msgid "Copiază cheia cu iconița de lângă ea și pune-o aici."
msgstr "Kopier nøkkelen med ikonet ved siden av og legg den inn her."

msgid ""
"Copiază cheia și pune-o aici. Nu adăuga card (facturare) la proiect: așa "
"rămâi pe gratuit."
msgstr ""
"Kopier nøkkelen og legg den inn her. Ikke legg til kort (fakturering) til "
"prosjektet: slik forblir du på gratisnivå."

msgid ""
"Copiază datele de mai jos și trimite-le pe forumul unde ai găsit software-ul "
"sau la %s."
msgstr ""
"Kopier dataene nedenfor og send dem til forumet der du fant programvaren "
"eller til %s."

msgid ""
"Copiază din nou KEY 1 de la „Keys and Endpoint”, întreagă, și alege regiunea "
"scrisă acolo la „Location/Region” (sau Global, dacă resursa e globală)."
msgstr ""
