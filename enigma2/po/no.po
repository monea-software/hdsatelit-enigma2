msgstr ""
"Kopien ble ikke oppdatert: i løpet av %(minute)d minutter ble ikke kanalens "
"tekst-TV samlet helt. Samlede sider: %(pagini)d."

#, python-format
msgid ""
"Copia nu s-a reîmprospătat: în %(secunde)d de secunde canalul nu a trimis "
"nicio pagină de teletext (fără semnal sau fără teletext)."
msgstr ""
"Kopien ble ikke oppdatert: i løpet av %(secunde)d sekunder sendte kanalen "
"ingen tekst-TV-side (uten signal eller uten tekst-TV)."

msgid "Copia nu se mai pune la loc."
msgstr "Kopien legges ikke lenger tilbake."

msgid "Copia nu se poate citi."
msgstr "Kopien kan ikke leses."

