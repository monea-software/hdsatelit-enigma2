msgid "Receptorul scrie încă bucata de dinainte. Încearcă din nou."
msgstr "Mottakeren skriver fortsatt forrige del. Prøv igjen."

#, python-format
msgid "Receptorul se apără singur de căldură: încetinește la %d °C."
msgstr "Mottakeren beskytter seg mot varme: Den saktner ved %d °C."

msgid ""
