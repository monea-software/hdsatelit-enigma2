#, python-format
msgid ""
"Chei SSH pe receptor: %d. Calculatoarele cu aceste chei intră fără parolă."
msgstr ""
"SSH-nøkler på mottakeren: %d. Datamaskiner med disse nøklene logger inn uten "
"passord."

msgid "Chei SSH pe receptor: niciuna."
msgstr "SSH-nøkler på mottakeren: ingen."

#, python-format
msgid "Chei adăugate: %d. Erau deja: %d. Refuzate: %d."
msgstr "Nøkler lagt til: %d. Var allerede der: %d. Avvist: %d."

msgid ""
"Chei și indici despărțiți prin punct, de exemplu translatedText sau data.0."
"text; * ia toate elementele, lipite în ordine. Albastru: exemplul."
msgstr ""
"Nøkler og indekser atskilt med punktum, for eksempel translatedText eller "
"data.0.text; * tar alle elementer, satt sammen i rekkefølge. Blå: eksempelet."

msgid ""
"Chei și numere (de la 0) despărțite prin punct, de exemplu translatedText "
"sau data.translations.0.translatedText; * ia toate elementele, lipite în "
"ordine (de exemplu 0.*.0)."
msgstr ""
"Nøkler og tall (fra 0) atskilt med punktum, for eksempel translatedText "
"eller data.translations.0.translatedText; * tar alle elementer, satt sammen "
"i rekkefølge (for eksempel 0.*.0)."

msgid "Cheia"
msgstr "Nøkkelen"

#, python-format
msgid "Cheia %s nu este bună."
msgstr "Nøkkelen %s er ikke gyldig."

msgid "Cheia API"
msgstr "API-nøkkel"

msgid ""
"Cheia API din panoul contului tău SubDL. Parola contului SubDL nu se cere."
msgstr ""
"API-nøkkelen fra panelet for SubDL-kontoen din. Passordet for SubDL-kontoen "
"kreves ikke."

msgid ""
"Cheia API din profilul tău de pe subs.ro. Fiecare cheie are o cotă de cereri "
"pe zi."
msgstr ""
"API-nøkkelen fra profilen din på subs.ro. Hver nøkkel har en daglig kvote "
"for forespørsler."

#, python-format
msgid "Cheia API pentru %s"
msgstr "API-nøkkel for %s"

#, python-format
msgid ""
"Cheia RSA are %d de biți. Receptorul primește numai chei RSA de cel puțin %d "
"de biți."
msgstr ""
"RSA-nøkkelen har %d bit. Mottakeren godtar bare RSA-nøkler med minst %d bit."

msgid "Cheia SubDL merge."
msgstr "SubDL-nøkkelen virker."

msgid "Cheia a fost ștearsă."
msgstr "Nøkkelen er slettet."

msgid ""
"Cheia a fost ștearsă. Calculatorul cu această cheie intră de acum numai cu "
"parola."
msgstr ""
"Nøkkelen ble slettet. Datamaskinen med denne nøkkelen logger nå inn bare med "
"passordet."

msgid ""
"Cheia apare în portal; o poți verifica la „Test your API Key”. Aici scrie "
"adresa https://libretranslate.com și lipește cheia."
msgstr ""
"Nøkkelen vises i portalen; du kan kontrollere den under «Test your API Key». "
"Skriv inn adressen https://libretranslate.com her og lim inn nøkkelen."

msgid ""
"Cheia aplicației HD Satelit la OpenSubtitles. O dă HD Satelit; nu e cheia "
"contului tău."
msgstr ""
"Applikasjonsnøkkelen for HD Satelit hos OpenSubtitles. Den gis av HD "
"Satelit; den er ikke nøkkelen for kontoen din."

msgid "Cheia aplicației OpenSubtitles lipsește; o pune HD Satelit."
msgstr ""
"Applikasjonsnøkkelen for OpenSubtitles mangler; den leveres av HD Satelit."

msgid ""
"Cheia are caractere care nu pot fi într-o cheie (sau e prea lungă). Nu s-a "
"schimbat nimic."
msgstr ""
"Nøkkelen har tegn som ikke kan være i en nøkkel (eller er for lang). "
"Ingenting ble endret."

msgid "Cheia are caractere care nu pot fi într-o cheie, sau e prea lungă."
msgstr "Nøkkelen har tegn som ikke kan stå i en nøkkel, eller den er for lang."

msgid ""
"Cheia are caractere care nu pot fi într-o cheie, sau e prea lungă. Copiaz-o "
"din nou, întreagă."
msgstr ""
"Nøkkelen har tegn som ikke kan stå i en nøkkel, eller den er for lang. "
"Kopier den på nytt, helt."

msgid "Cheia cere regiunea resursei Azure."
msgstr "Nøkkelen krever regionen til Azure-ressursen."

#, python-format
msgid "Cheia e bună și e salvată, cu %s, dar cota s-a terminat."
msgstr "Nøkkelen er god og lagret, med %s, men kvoten er brukt opp."

msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota (la Azure, luna următoare)."
msgstr ""
"Nøkkelen er god, men kvoten er brukt opp. Oversettelsen virker igjen når "
"kvoten er fornyet (for Azure, neste måned)."

msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota (la Gemini, de obicei a doua zi, în jurul orei 10, ora României)."
msgstr ""
"Nøkkelen er god, men kvoten er brukt opp. Oversettelsen virker igjen når "
"kvoten er fornyet (for Gemini, vanligvis neste dag, rundt kl. 10 rumensk "
"tid)."

msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota."
msgstr ""
"Nøkkelen er god, men kvoten er brukt opp. Oversettelsen virker igjen når "
"kvoten er fornyet."

msgid ""
"Cheia e bună, dar în proiectul ei nu e pornit „Cloud Translation API”. În "
"Google Cloud (console.cloud.google.com) mergi la „APIs & Services”, caută "
"„Cloud Translation API”, apasă „Enable”, așteaptă câteva minute și încearcă "
"din nou."
msgstr ""
"Nøkkelen er god, men i prosjektet er ikke «Cloud Translation API» slått på. "
"I Google Cloud (console.cloud.google.com) gå til «APIs & Services», søk "
"etter «Cloud Translation API», trykk «Enable», vent noen minutter og prøv "
"igjen."

msgid "Cheia e opțională: numai dacă serverul cere cheie."
msgstr "Nøkkelen er valgfri: bare hvis serveren ber om nøkkel."

msgid "Cheia e prea lungă. Nu s-a pornit nimic."
msgstr "Nøkkelen er for lang. Ingenting ble startet."

msgid "Cheia e prea lungă. Nu s-a schimbat nimic."
msgstr "Nøkkelen er for lang. Ingenting ble endret."

msgid "Cheia e salvată pe receptor."
msgstr "Nøkkelen er lagret på mottakeren."

msgid "Cheia e stricată (textul de după tip nu e o cheie întreagă)."
msgstr ""
"Nøkkelen er ødelagt (teksten etter typen er ikke en fullstendig nøkkel)."

msgid ""
"Cheia nouă pentru panoul web e făcută. Din rețeaua locală, telefoanele și "
"browserele intră din nou fără cod, ca până acum."
msgstr ""
"Den nye nøkkelen for webpanelet er laget. Fra lokalnettverket kommer "
"telefoner og nettlesere inn igjen uten kode, som før."

msgid ""
"Cheia nouă pentru panoul web e făcută. Fiecare telefon și browser cere din "
"nou codul de pe televizor: Albastru, apoi Conectează un browser nou."
msgstr ""
"Den nye nøkkelen for webpanelet er laget. Hver telefon og nettleser ber på "
"nytt om koden fra TV-en: Blå, deretter Koble til en ny nettleser."

msgid "Cheia nouă pentru panoul web e făcută. Pagina se încarcă din nou."
msgstr "Den nye nøkkelen for webpanelet er laget. Siden lastes inn på nytt."

msgid "Cheia nouă pentru scripturi e făcută. Pagina se încarcă din nou."
msgstr "Den nye nøkkelen for skript er laget. Siden lastes inn på nytt."

#, python-format
msgid "Cheia nu a mers la %s."
msgstr "Nøkkelen virket ikke med %s."

msgid "Cheia nu mai era pe receptor."
msgstr "Nøkkelen var ikke lenger på mottakeren."

msgid "Cheia nu pleacă pe http:// spre internet. Scrie adresa cu https://."
msgstr ""
"Nøkkelen sendes ikke over http:// til internett. Skriv adressen med https://."

msgid "Cheia nu s-a putut salva pe receptor."
msgstr "Nøkkelen kunne ikke lagres på mottakeren."

msgid ""
"Cheia nu se trimite în adresă: adresa rămâne în istoricul browserului și în "
"jurnale. Lipește-o în pagină. Nu s-a salvat și nu s-a pornit nimic."
msgstr ""
"Nøkkelen sendes ikke i adressen: adressen blir i nettleserhistorikken og i "
"loggene. Lim den inn på siden. Ingenting ble lagret og ingenting ble startet."

msgid ""
"Cheia nu se trimite în adresă: adresa rămâne în istoricul browserului și în "
"jurnale. Trimite-o în corpul cererii POST. Nu s-a salvat nimic."
msgstr ""
"Nøkkelen sendes ikke i adressen: adressen blir i nettleserhistorikken og i "
"loggene. Send den i brødteksten til POST-forespørselen. Ingenting ble lagret."

msgid ""
"Cheia o faci cu contul tău Google. La subtitrări continue poate da „prea "
"multe cereri”."
msgstr ""
"Nøkkelen lager du med Google-kontoen din. Ved kontinuerlige undertekster kan "
"den gi «for mange forespørsler»."

msgid ""
"Cheia o faci cu emailul sau cu contul tău Google. Pune și o rezervă pentru "
"zilele cu multe subtitrări."
msgstr ""
"Nøkkelen lager du med e-posten din eller Google-kontoen din. Sett også opp "
"en reserve for dager med mange undertekster."

#, python-format
msgid "Cheia pentru %s e salvată ca rezervă; traducerea rămâne pe %s."
msgstr "Nøkkelen for %s er lagret som reserve; oversettelsen forblir på %s."

msgid "Cheia pentru scripturi"
msgstr "Nøkkelen for skript"

msgid ""
"Cheia pleacă numai spre adresa serverului de acum: scrie întâi adresa, apoi "
"pune cheia."
msgstr ""
"Nøkkelen sendes bare til den nåværende serveradressen: skriv først adressen, "
"deretter legg inn nøkkelen."

msgid ""
"Cheia pleacă numai spre receptor, se păstrează criptată și nu se mai arată "
"niciodată."
msgstr ""
"Nøkkelen sendes bare til mottakeren, lagres kryptert og vises aldri igjen."

msgid ""
"Cheia salvată a fost pusă pentru alt server (%s), deci nu pleacă spre adresa "
"de acum. Dacă serverul cere cheie, pune-o din nou."
msgstr ""
"Den lagrede nøkkelen ble lagt inn for en annen server (%s), så den sendes "
"ikke til den nåværende adressen. Hvis serveren krever nøkkel, legg den inn "
"på nytt."

msgid ""
"Cheia salvată nu e legată de adresa de acum, deci nu pleacă nicăieri. Dacă "
"serverul cere cheie, pune-o din nou."
msgstr ""
"Den lagrede nøkkelen er ikke knyttet til den nåværende adressen, så den "
"sendes ingen steder. Hvis serveren krever nøkkel, legg den inn på nytt."

msgid ""
"Cheia sau regiunea nu se potrivesc: verifică amândouă în portal (Keys and "
"Endpoint)."
msgstr ""
"Nøkkelen og regionen stemmer ikke: sjekk begge i portalen (Keys and "
"Endpoint)."

msgid "Cheia se păstrează pe receptor, criptată; nu se mai arată niciodată."
msgstr "Nøkkelen lagres på mottakeren, kryptert; den vises aldri igjen."

msgid "Cheia se trimite numai cu POST, din pagină. Nu s-a salvat nimic."
msgstr "Nøkkelen sendes bare med POST, fra siden. Ingenting ble lagret."

msgid "Cheia se trimite numai cu POST, în corpul cererii. Nu s-a salvat nimic."
msgstr ""
"Nøkkelen sendes bare med POST, i brødteksten til forespørselen. Ingenting "
"ble lagret."

#, python-format
msgid "Cheia subs.ro merge. Cererile rămase azi: %s din %s."
msgstr "subs.ro-nøkkelen virker. Gjenværende forespørsler i dag: %s av %s."

msgid ""
"Cheia, adresa sau modelul unei rezerve se pun alegând-o pe rând la "
"„Serviciul” (sau din configurarea pas cu pas)."
msgstr ""
"Nøkkelen, adressen eller modellen til en reserve angis ved å velge den etter "
"tur under «Tjenesten» (eller fra trinnvis oppsett)."

msgid "Cheie nouă pentru panoul web"
msgstr "Ny nøkkel for webpanelet"

msgid "Cheie nouă pentru scripturi"
msgstr "Ny nøkkel for skript"

#, python-format
msgid "Cheie pentru scripturi (doar pentru programatori): %s"
msgstr "Nøkkel for skript (bare for programmerere): %s"

msgid "Cheie pusă"
msgstr "Nøkkel satt"

msgid ""
"Cheie pusă pentru alt server (%s): nu pleacă spre adresa de acum. Pune-o din "
"nou."
msgstr ""
"Nøkkel satt for en annen server (%s): den sendes ikke til den nåværende "
"adressen. Legg den inn på nytt."

msgid ""
"Cheie pusă, dar nelegată de adresa de acum: nu pleacă nicăieri. Pune-o din "
"nou."
msgstr ""
"Nøkkel satt, men ikke knyttet til den nåværende adressen: den sendes ingen "
"steder. Legg den inn på nytt."

msgid ""
"Cheie pusă, dar nu pleacă pe http:// spre internet. Scrie adresa cu https://."
msgstr ""
"Nøkkel satt, men den sendes ikke over http:// til internett. Skriv adressen "
"med https://."

msgid "Cheile DSA nu mai sunt primite: sunt prea slabe. Fă o cheie Ed25519."
msgstr "DSA-nøkler godtas ikke lenger: de er for svake. Lag en Ed25519-nøkkel."

msgid "Cheile SSH"
msgstr "SSH-nøkler"

msgid "Cheile SSH din copie nu au forma obișnuită; nu s-au pus la loc."
