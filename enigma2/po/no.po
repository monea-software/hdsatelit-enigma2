msgstr "Teksten sendes bare via POST, fra siden «Nettleser»."

msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor spre serverul de la adresa pe care o scrii. Dacă serverul e în casa "
"ta, nimic nu iese din casă."
msgstr ""
"Teksten i undertekstene (bare teksten, uten bilde og uten lyd) går fra "
"mottakeren til serveren på adressen du skriver. Hvis serveren er hjemme hos "
"deg, går ingenting ut av huset."

#, python-format
msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor, prin internet, spre %s, care îl traduce. Cheia ta rămâne pe "
"receptor."
msgstr ""
"Teksten i undertekstene (bare teksten, uten bilde og uten lyd) går fra "
"mottakeren, via internett, til %s, som oversetter den. Nøkkelen din blir "
"værende på mottakeren."

#, python-format
msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor, prin internet, spre serverul de la adresa scrisă de tine (%s), "
"care îl traduce."
msgstr ""
"Teksten i undertekstene (bare teksten, uten bilde og uten lyd) går fra "
"mottakeren, via internett, til serveren på adressen du skrev (%s), som "
"oversetter den."

#, python-format
