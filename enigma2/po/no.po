#, python-format
msgid ""
"Receptorul nu a putut trece pe %s: %s. Încearcă din nou peste 10 minute."
msgstr ""
"Mottakeren kunne ikke bytte til %s: %s. Den prøver igjen om 10 minutter."

msgid "Receptorul nu a putut șterge înregistrarea."
msgstr "Mottakeren kunne ikke slette opptaket."

msgid "Receptorul nu a putut șterge înregistrările terminate."
msgstr "Mottakeren kunne ikke slette de fullførte opptakene."

msgid "Receptorul nu a răspuns ("
msgstr "Mottakeren svarte ikke ("

msgid "Receptorul nu a terminat la timp. Încearcă din nou."
msgstr "Mottakeren ble ikke ferdig i tide. Prøv på nytt."

msgid "Receptorul nu a terminat pornirea. Încearcă din nou peste un minut."
msgstr "Mottakeren ble ikke ferdig med å starte. Prøv igjen om ett minutt."

#, python-format
msgid ""
"Receptorul nu a terminat în %d de secunde. Poți închide ecranul; ce a reușit "
"se vede când îl deschizi din nou."
msgstr ""
"Mottakeren ble ikke ferdig innen %d sekunder. Du kan lukke skjermen; det som "
"lyktes, vises når du åpner den igjen."

msgid "Receptorul nu ajunge la forum. Verifică legătura la internet."
msgstr "Mottakeren når ikke forumet. Sjekk internettforbindelsen."

msgid "Receptorul nu arată niciun tuner."
msgstr "Mottakeren viser ingen tuner."

msgid ""
"Receptorul nu are acces la internet, iar aplicațiile HbbTV vin de pe "
"internet."
msgstr ""
"Mottakeren har ikke tilgang til internett, og HbbTV-applikasjonene kommer "
"fra internett."

msgid "Receptorul nu are această alegere."
msgstr "Mottakeren har ikke dette valget."

msgid ""
"Receptorul nu are ceas propriu cu baterie: la pornire ora vine din ultima "
"oră salvată, apoi se ia din Internet (NTP) și, până reușește, din "
"transponderul canalului. Ora de la un singur transponder rămâne provizorie "
"până o confirmă Internetul sau un al doilea transponder; numai ora sigură se "
"salvează. Aceleași setări sunt pe televizor, în __DRUM_MENIU__."
msgstr ""
"Mottakeren har ingen egen klokke med batteri: ved oppstart kommer tiden fra "
"sist lagrede tid, deretter hentes den fra Internett (NTP) og, inntil det "
"lykkes, fra kanalens transponder. Tiden fra én enkelt transponder forblir "
"midlertidig til Internett eller en annen transponder bekrefter den; bare "
"pålitelig tid lagres. De samme innstillingene finnes på TV-en, i "
"__DRUM_MENIU__."

msgid "Receptorul nu are comutatoare pentru sunetul AC3 și DTS."
msgstr "Mottakeren har ingen brytere for AC3- og DTS-lyd."

#, python-format
msgid ""
"Receptorul nu are decodor pentru %(format)s, iar televizorul nu îl primește: "
"pista aceasta poate fi fără sunet. Alege altă pistă de sunet."
msgstr ""
"Mottakeren har ingen dekoder for %(format)s, og TV-en mottar den ikke: dette "
"sporet kan være uten lyd. Velg et annet lydspor."

#, python-format
msgid ""
"Receptorul nu are decodor pentru %(format)s; sunetul pleacă neschimbat și îl "
"decodează televizorul."
msgstr ""
"Mottakeren har ingen dekoder for %(format)s; lyden går ut uendret og TV-en "
"dekoder den."

msgid ""
"Receptorul nu are internet acum, deci locul nu se poate afla singur. Alege "
"țara și orașul din listă."
msgstr ""
"Mottakeren har ikke internett nå, så stedet kan ikke finnes automatisk. Velg "
"land og by fra listen."

msgid "Receptorul nu are internet acum: alege țara și orașul din listă."
msgstr "Mottakeren har ikke internett nå: velg landet og byen fra listen."

msgid ""
"Receptorul nu are legătură în rețea, deci pagina nu se poate deschide nici "
"pe telefon."
msgstr ""
"Mottakeren har ingen nettverkstilkobling, så siden kan heller ikke åpnes på "
"telefonen."

msgid ""
"Receptorul nu are legătură în rețea, deci pagina nu se poate deschide pe "
"telefon."
msgstr ""
"Mottakeren har ingen nettverkstilkobling, så siden kan ikke åpnes på "
"telefonen."

#, python-format
msgid "Receptorul nu are niciun tuner %s."
msgstr "Mottakeren har ingen %s-tuner."

msgid ""
"Receptorul nu are niciun tuner de satelit, deci aici nu se poate măsura "
"semnalul."
msgstr "Mottakeren har ingen satellittuner, så signalet kan ikke måles her."

msgid ""
"Receptorul nu are niciun tuner de satelit, deci motorul nu se poate comanda "
"de aici."
msgstr "Mottakeren har ingen satellittuner, så motoren kan ikke styres herfra."

msgid "Receptorul nu are niciun tuner de satelit."
msgstr "Mottakeren har ingen satellittuner."

msgid ""
"Receptorul nu are o placă Wi-Fi. Pune una în portul USB și deschide din nou."
msgstr ""
"Mottakeren har ikke noe Wi-Fi-kort. Sett ett inn i USB-porten og åpne igjen."

msgid "Receptorul nu are o placă Wi-Fi. Pune una în portul USB."
msgstr "Mottakeren har ikke noe Wi-Fi-kort. Sett ett inn i USB-porten."

msgid ""
"Receptorul nu are placă Wi-Fi; rețeaua Wi-Fi din copie a rămas deoparte."
msgstr ""
"Mottakeren har ikke Wi-Fi-kort; Wi-Fi-nettverket fra sikkerhetskopien ble "
"lagt til side."

msgid ""
"Receptorul nu are placă de rețea pe cablu; setările cablului din copie au "
"rămas deoparte."
msgstr ""
"Mottakeren har ikke kablet nettverkskort; kabelinnstillingene fra "
"sikkerhetskopien ble lagt til side."

msgid "Receptorul nu are rețea."
msgstr "Mottakeren har ikke noe nettverk."

msgid ""
"Receptorul nu are setările acestor sateliți: canalele nu pornesc până nu pui "
"satelitul în setările antenei. Nimic nu e bifat; le ștergi numai dacă vrei."
msgstr ""
"Mottakeren har ikke innstillingene for disse satellittene: kanalene starter "
"ikke før du legger satellitten inn i antenneinnstillingene. Ingenting er "
"avkrysset; slett dem bare hvis du vil."

msgid "Receptorul nu are tuner de satelit."
msgstr "Mottakeren har ingen satellittuner."

msgid "Receptorul nu are utilitarul telecomenzilor."
msgstr "Mottakeren har ikke verktøyet for fjernkontroller."

msgid ""
"Receptorul nu are încă unealta care face ecranul de pornire dintr-o poză."
msgstr ""
"Mottakeren har ennå ikke verktøyet som lager et startskjermbilde av et bilde."

msgid "Receptorul nu cunoaște unul dintre aceste formate."
msgstr "Mottakeren støtter ikke ett av disse formatene."

msgid ""
"Receptorul nu decriptează acum niciun canal (canalul de acum nu este criptat "
"sau niciun modul nu îl decriptează)."
msgstr ""
"Mottakeren dekrypterer ikke noen kanal nå (den nåværende kanalen er ikke "
"kryptert eller ingen modul dekrypterer den)."

msgid "Receptorul nu e conectat la nicio rețea."
msgstr "Mottakeren er ikke koblet til noe nettverk."

msgid ""
"Receptorul nu e conectat la router (Wi-Fi). Verifică rețeaua Wi-Fi sau "
"routerul."
msgstr ""
"Mottakeren er ikke koblet til ruteren (Wi-Fi). Sjekk Wi-Fi-nettverket eller "
"ruteren."

msgid ""
"Receptorul nu e conectat la router (cablu). Verifică cablul sau routerul."
msgstr ""
"Mottakeren er ikke koblet til ruteren (kabel). Sjekk kabelen eller ruteren."

msgid "Receptorul nu e gata (sesiunea enigma2 lipsește)."
msgstr "Mottakeren er ikke klar (enigma2-økten mangler)."

msgid "Receptorul nu e gata."
msgstr "Mottakeren er ikke klar."

msgid ""
"Receptorul nu e legat prin Wi-Fi, deci nu știe care e rețeaua ta: în "
"socoteală intră toate rețelele găsite."
msgstr ""
"Mottakeren er ikke koblet til via Wi-Fi, så den vet ikke hvilket nettverk "
"som er ditt: alle nettverk som høres telles med."

msgid "Receptorul nu e într-o rețea de acasă (adresă privată); nu caut."
msgstr "Mottakeren er ikke på et hjemmenettverk (privat adresse); søker ikke."

msgid ""
"Receptorul nu este conectat la internet acum, deci actualizările nu se pot "
"căuta."
msgstr ""
"Mottakeren er ikke koblet til internett nå, så oppdateringer kan ikke søkes "
"etter."

msgid "Receptorul nu este legat la rețea."
msgstr "Mottakeren er ikke koblet til nettverket."

msgid "Receptorul nu este pregătit. Încearcă peste câteva secunde."
msgstr "Mottakeren er ikke klar. Prøv igjen om noen sekunder."

msgid "Receptorul nu este în modul sigur."
msgstr "Mottakeren er ikke i sikker modus."

msgid "Receptorul nu găsește nicio altă rețea de 2,4 GHz: orice canal e liber."
msgstr "Mottakeren hører ikke noe annet 2,4 GHz-nettverk: hver kanal er fri."

msgid ""
"Receptorul nu le poate citi sistemul de fișiere. Se pot folosi după "
"formatare: cu „Formatează”, care deschide pagina Discurile (receptorul "
"întreabă înainte), sau pe un calculator, ca FAT32. Formatarea șterge tot de "
"pe ele."
msgstr ""
"Mottakeren kan ikke lese filsystemet deres. De kan brukes etter formatering: "
"med «Formater», som åpner siden Disker (mottakeren spør først), eller på en "
"datamaskin, som FAT32. Formatering sletter alt på dem."

msgid ""
"Receptorul nu le poate prinde pe toate deodată. Alege una și apasă OK ca s-o "
"modifici sau s-o oprești; după schimbare încerc din nou."
msgstr ""
"Mottakeren kan ikke motta alle samtidig. Velg én og trykk OK for å endre "
"eller stoppe den; etter endringen prøver jeg igjen."

msgid "Receptorul nu mai transmite spre acest browser."
msgstr "Mottakeren strømmer ikke lenger til denne nettleseren."

msgid "Receptorul nu poate face dosarul în care se montează locul."
msgstr "Mottakeren kan ikke opprette mappen der stedet monteres."

msgid "Receptorul nu poate fi recunoscut"
msgstr "Mottakeren kan ikke gjenkjennes"

#, python-format
msgid "Receptorul nu poate transforma poza în ecran de pornire (%s)."
msgstr "Mottakeren kan ikke gjøre bildet om til et startskjermbilde (%s)."

msgid ""
"Receptorul nu poate trece singur pe Wi-Fi: nu e nicio rețea Wi-Fi salvată și "
"pornită. Conectează receptorul o dată la Wi-Fi (Rețea și internet), apoi "
"trecerea se face singură."
msgstr ""
"Mottakeren kan ikke bytte til Wi-Fi på egen hånd: ingen Wi-Fi-nettverk er "
"lagret og slått på. Koble mottakeren til Wi-Fi én gang (Nettverk og "
"internett), så skjer byttet automatisk."

msgid "Receptorul nu primește bucăți atât de mari."
msgstr "Mottakeren aksepterer ikke så store biter."

msgid "Receptorul nu recepționează semnalul acestui canal."
msgstr "Mottakeren mottar ikke signalet fra denne kanalen."

msgid "Receptorul nu răspunde."
msgstr "Mottakeren svarer ikke."

msgid "Receptorul nu răspunde. Trimiterea s-a oprit."
msgstr "Mottakeren svarer ikke. Sendingen ble stoppet."

msgid "Receptorul nu răspunde. Verifică dacă e pornit și în aceeași rețea."
msgstr "Mottakeren svarer ikke. Sjekk at den er på og i samme nettverk."

msgid "Receptorul nu răspunde. Verifică dacă este pornit și în aceeași rețea."
msgstr "Mottakeren svarer ikke. Kontroller at den er på og i samme nettverk."

msgid ""
"Receptorul nu răspunde. Verifică dacă telefonul e în aceeași rețea cu "
"receptorul."
msgstr ""
"Mottakeren svarer ikke. Kontroller at telefonen er på samme nettverk som "
"mottakeren."

msgid "Receptorul nu răspunde. Verifică să fie pornit și în aceeași rețea."
msgstr "Mottakeren svarer ikke. Kontroller at den er på og på samme nettverk."

msgid "Receptorul nu s-a putut lega la rețeaua Wi-Fi din copie."
msgstr "Mottakeren kunne ikke koble til Wi-Fi-nettverket fra sikkerhetskopien."

msgid "Receptorul nu spune ce canal e pe televizor."
msgstr "Mottakeren sier ikke hvilken kanal som er på TV-en."

msgid "Receptorul pornește din memoria internă."
msgstr "Mottakeren starter fra internminnet."

msgid "Receptorul pornește din nou programul."
msgstr "Mottakeren starter programmet på nytt."

msgid "Receptorul pornește din nou programul. Încearcă peste câteva secunde."
msgstr "Mottakeren starter kanalen på nytt. Prøv igjen om noen sekunder."

msgid ""
"Receptorul pornește imaginea din memoria lui internă în locul celei de acum. "
"Pe televizor: __DRUM_FLASH__."
msgstr ""
"Mottakeren starter imaget fra sitt interne minne i stedet for det nåværende. "
"På TV-en: __DRUM_FLASH__."

msgid ""
"Receptorul pornește pe rând fiecare canal din listă și notează ce se află "
"numai când canalul chiar rulează: rezoluția, cadrele pe secundă, codarea "
"imaginii, accesul (liber sau criptat), PID-urile și pistele de sunet și "
"subtitrare. Cât merge, televizorul e ocupat: imaginea se schimbă singură. "
"Orice tastă de pe telecomandă oprește scanarea detaliată, iar receptorul "
"revine la canalul de dinainte. Data viitoare scanarea detaliată continuă de "
"unde a rămas."
msgstr ""
"Mottakeren starter hver kanal i listen etter tur og noterer det som bare kan "
"læres mens kanalen faktisk spiller: oppløsningen, bilder per sekund, "
"bildekodingen, tilgangen (fri eller kryptert), PID-ene og lyd- og "
"undertittelsporene. Mens det pågår, er TV-en opptatt: bildet endrer seg av "
"seg selv. Enhver tast på fjernkontrollen stopper det detaljerte søket, og "
"mottakeren går tilbake til forrige kanal. Neste gang fortsetter det "
"detaljerte søket der det stoppet."

msgid "Receptorul pornește și trece pe canal."
msgstr "Mottakeren slår seg på og bytter til kanalen."

msgid "Receptorul pornește."
msgstr "Mottakeren starter."

msgid "Receptorul potrivește singur contrastul după fiecare scenă."
msgstr "Mottakeren tilpasser kontrasten selv til hver scene."

msgid "Receptorul pregătește deja o poză. Încearcă din nou peste câteva clipe."
msgstr "Mottakeren klargjør allerede et bilde. Prøv igjen om noen øyeblikk."

msgid ""
"Receptorul primește semnalul unei telecomenzi cu infraroșu, dar nu îl poate "
"folosi încă."
msgstr ""
"Mottakeren mottar signalet fra en infrarød fjernkontroll, men kan ikke bruke "
"det ennå."

msgid "Receptorul pune deja un ecran. Încearcă din nou peste câteva clipe."
msgstr "Mottakeren setter allerede en skjerm. Prøv igjen om noen øyeblikk."

msgid "Receptorul repornește o dată acum, ca să intre rețeaua din copie."
msgstr ""
