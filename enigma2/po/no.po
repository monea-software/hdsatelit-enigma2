msgid "<code>POST /api/ocr-limbi-opreste?model=slk</code>: oprește descărcarea"
msgstr ""
"<code>POST /api/ocr-limbi-opreste?model=slk</code>: stopper nedlastingen"

msgid ""
"<code>POST /api/ocr-limbi-sterge?model=slk</code>: șterge un model descărcat "
