msgstr "unvollständig"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Dacă foloseai o cheie pentru acest server, pune-o din nou."
msgstr "Wenn du für diesen Server einen Schlüssel benutzt hast, gib ihn neu ein."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheie pusă"
msgstr "Schlüssel gesetzt"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Fără cheie"
msgstr "Ohne Schlüssel"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheie pusă pentru alt server (%s): nu pleacă spre adresa de acum. Pune-o din nou."
msgstr "Schlüssel für einen anderen Server gesetzt (%s): Er geht nicht an die jetzige Adresse. Gib ihn neu ein."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheie pusă, dar nelegată de adresa de acum: nu pleacă nicăieri. Pune-o din nou."
msgstr "Schlüssel gesetzt, aber nicht an die jetzige Adresse gebunden: Er geht nirgendwohin. Gib ihn neu ein."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheie pusă, dar nu pleacă pe http:// spre internet. Scrie adresa cu https://."
msgstr "Schlüssel gesetzt, aber er wird nicht über http:// ins Internet gesendet. Schreib die Adresse mit https://."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "se traduce prin „Tradu EPG”"
msgstr "wird über „EPG übersetzen“ übersetzt"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "pornită, dar traducerea automată e oprită"
msgstr "an, aber die automatische Übersetzung ist aus"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "pornită, dar serviciul nu e completat"
msgstr "an, aber der Dienst ist nicht ausgefüllt"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Valoare greșită pentru: %s."
msgstr "Falscher Wert für: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Nu s-a trimis nicio alegere."
msgstr "Es wurde keine Auswahl gesendet."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Adresa începe cu http:// sau https://, fără nume și parolă în ea."
msgstr "Die Adresse beginnt mit http:// oder https://, ohne Name und Passwort darin."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Nu s-a schimbat nimic."
msgstr "Es wurde nichts geändert."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Lista rezervelor are un serviciu necunoscut."
msgstr "Die Liste der Ersatzdienste enthält einen unbekannten Dienst."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Un serviciu apare de două ori în lista rezervelor."
msgstr "Ein Dienst steht zweimal in der Liste der Ersatzdienste."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Serviciul ales nu intră și în lista rezervelor."
msgstr "Der gewählte Dienst kommt nicht zusätzlich in die Liste der Ersatzdienste."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Adresa-șablon începe cu https:// (sau http:// pentru un server din rețeaua de acasă), fără spații, fără nume și parolă și fără locuri în numele serverului."
msgstr "Die Adresse (Vorlage) beginnt mit https:// (oder http:// für einen Server im Heimnetz), ohne Leerzeichen, ohne Name und Passwort und ohne Platzhalter im Servernamen."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "O adresă http:// merge numai pentru un server din rețeaua de acasă (de exemplu 192.168.1.50); pentru un server de pe internet scrie https://."
msgstr "Eine http://-Adresse geht nur für einen Server im Heimnetz (zum Beispiel 192.168.1.50); für einen Server im Internet schreib https://."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Numele antetului are numai litere, cifre și - _ . (de exemplu Authorization); Host, Content-Type și Content-Length nu se pot alege."
msgstr "Der Name des Headers hat nur Buchstaben, Ziffern und - _ . (zum Beispiel Authorization); Host, Content-Type und Content-Length kann man nicht wählen."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Calea are chei și numere despărțite prin punct, fără spații (de exemplu data.translations.0.translatedText)."
msgstr "Der Pfad hat Schlüssel und Zahlen, durch Punkte getrennt, ohne Leerzeichen (zum Beispiel data.translations.0.translatedText)."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Corpul are cel mult %d de semne, fără caractere de control."
msgstr "Der Inhalt hat höchstens %d Zeichen, ohne Steuerzeichen."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "cheie refuzată"
msgstr "Schlüssel abgelehnt"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "cota terminată"
msgstr "Kontingent aufgebraucht"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "fără rețea"
msgstr "kein Netz"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "prea lent"
msgstr "zu langsam"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "răspuns neașteptat"
msgstr "unerwartete Antwort"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "limbă netradusă"
msgstr "Sprache nicht übersetzt"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "lipsă date"
msgstr "Angaben fehlen"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "adresă refuzată"
msgstr "Adresse abgelehnt"

#: lib/python/Screens/ScanerSatelit.py
msgid "Multistream"
msgstr "Multistream"

#: lib/python/Screens/ScanerSatelit.py
msgid "Fluxul (ISI, 0-255)"
msgstr "Datenstrom (ISI, 0-255)"

#: lib/python/Screens/ScanerSatelit.py
msgid "Secvența PLS"
msgstr "PLS-Sequenz"

#: lib/python/Screens/ScanerSatelit.py
msgid "Codul PLS"
msgstr "PLS-Code"

#: lib/python/Screens/ScanerSatelit.py
#, python-format
msgid "flux %d"
msgstr "Datenstrom %d"

#: lib/python/Screens/ScanerSatelit.py lib/python/Plugins/Extensions/HdsWebControl/scanare_web.py
msgid "(tunerul nu alege fluxul)"
msgstr "(der Tuner wählt den Datenstrom nicht)"

#: lib/python/Screens/ScanerSatelit.py
msgid "multistream există numai în DVB-S2"
msgstr "Multistream gibt es nur bei DVB-S2"

#: lib/python/Screens/ScanerSatelit.py
#, python-format
msgid "codul PLS trebuie să fie între 0 și %d"
msgstr "der PLS-Code muss zwischen 0 und %d liegen"

#: lib/python/Screens/ScanerSatelit.py
msgid "multistream, iar tunerul nu poate alege fluxul"
msgstr "Multistream, und der Tuner kann den Datenstrom nicht wählen"

#: lib/python/Screens/ScanerSatelit.py
#, python-format
msgid "Fluxul (ISI) e un număr între 0 și %d. Lasă-l gol dacă știi numai codul PLS."
msgstr "Der Datenstrom (ISI) ist eine Zahl zwischen 0 und %d. Lass ihn leer, wenn du nur den PLS-Code kennst."

#: lib/python/Screens/ScanerSatelit.py
#, python-format
msgid "Codul PLS e un număr între 0 și %d."
msgstr "Der PLS-Code ist eine Zahl zwischen 0 und %d."

#: lib/python/Screens/ScanerSatelit.py
msgid "Multistream fără flux și fără cod PLS: se caută ca un transponder obișnuit."
msgstr "Multistream ohne Datenstrom und ohne PLS-Code: Es wird wie auf einem gewöhnlichen Transponder gesucht."

#: lib/python/Screens/ScanerSatelit.py
msgid "Multistream există numai în DVB-S2: se caută ca DVB-S2."
msgstr "Multistream gibt es nur bei DVB-S2: Es wird als DVB-S2 gesucht."

#: lib/python/Screens/ScanerSatelit.py
#, python-format
msgid "Fluxul și secvența PLS sunt luate din lista receptorului: %s."
msgstr "Datenstrom und PLS-Sequenz werden aus der Liste des Receivers übernommen: %s."

#: lib/python/Screens/ScanerSatelit.py
#, python-format
msgid "Pe %d MHz lista receptorului are mai multe fluxuri (%s); se caută fără să se aleagă unul. Pentru unul anume pune „Multistream” pe Da și scrie fluxul."
msgstr "Auf %d MHz hat die Liste des Receivers mehrere Datenströme (%s); es wird gesucht, ohne einen zu wählen. Für einen bestimmten setze „Multistream“ auf Ja und gib den Datenstrom ein."

#: lib/python/Screens/ScanerSatelit.py
msgid "În lucru: scanarea și ascultarea DVB-T2 prin satelit nu au fost încă probate pe receptor."
msgstr "In Arbeit: Suchlauf und Empfang von DVB-T2 über Satellit wurden auf dem Receiver noch nicht erprobt."

#: lib/python/Screens/ScanerSatelit.py
#, python-format
msgid "%s: emisie în multistream (mai multe fluxuri pe același transponder), iar tunerul de satelit al acestui receptor nu poate alege fluxul. De aici nu se poate căuta; operatorii fără multistream din listă merg."
msgstr "%s: Multistream-Sendung (mehrere Datenströme auf demselben Transponder), und der Satellitentuner dieses Receivers kann den Datenstrom nicht wählen. Von hier aus kann nicht gesucht werden; die Betreiber ohne Multistream in der Liste funktionieren."

#: lib/python/Screens/ScanerSatelit.py
#, python-format
msgid "Transponderul are multistream (%s), iar tunerul de satelit al acestui receptor nu poate alege fluxul."
msgstr "Der Transponder hat Multistream (%s), und der Satellitentuner dieses Receivers kann den Datenstrom nicht wählen."

#: lib/python/Hds/DabT2/ecrane.py
msgid "Cauta posturile din flux"
msgstr "Sender im Datenstrom suchen"

#: lib/python/Hds/DabT2/ecrane.py
msgid "Cauta programele din flux"
msgstr "Programme im Datenstrom suchen"

#: lib/python/Hds/DabT2/ecrane.py
msgid "Citeste din flux numele posturilor si le pune in lista de canale."
msgstr "Liest die Sendernamen aus dem Datenstrom und trägt sie in die Kanalliste ein."

#: lib/python/Hds/DabT2/ecrane.py
msgid "Citeste din flux numele programelor si le pune in lista de canale."
msgstr "Liest die Programmnamen aus dem Datenstrom und trägt sie in die Kanalliste ein."

#: lib/python/Hds/DabT2/ecrane.py
msgid "Posturile nu sunt cautate inca: apasa OK, apoi Cauta posturile din flux."
msgstr "Noch nicht gesucht: drücke OK, dann „Sender im Datenstrom suchen“."

#: lib/python/Hds/DabT2/ecrane.py
msgid "Programele nu sunt cautate inca: apasa OK, apoi Cauta programele din flux."
msgstr "Noch nicht gesucht: drücke OK, dann „Programme im Datenstrom suchen“."

#: lib/python/Hds/DabT2/ecrane.py
#, python-format
msgid "Caut posturile din %s..."
msgstr "Suche Sender in %s..."

#: lib/python/Hds/DabT2/ecrane.py
#, python-format
msgid "Caut programele din %s..."
msgstr "Suche Programme in %s..."

#: lib/python/Hds/DabT2/ecrane.py
#, python-format
msgid "Gasite: %s."
msgstr "Gefunden: %s."

#: lib/python/Hds/DabT2/ecrane.py lib/python/Hds/DabT2/pornire.py
msgid "Cautarea posturilor s-a oprit."
msgstr "Die Sendersuche wurde gestoppt."

#: lib/python/Hds/DabT2/ecrane.py lib/python/Hds/DabT2/pornire.py
msgid "Cautarea programelor s-a oprit."
msgstr "Die Programmsuche wurde gestoppt."

#: lib/python/Components/HdsCopieSetari.py
