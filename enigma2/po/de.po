#: lib/python/Components/HdsModSigur.py
#, python-format
msgid "Mod sigur: o extensie instalată de tine e oprită acum, nu ștearsă."
msgid_plural "Mod sigur: %d extensii instalate de tine sunt oprite acum, nu șterse."
msgstr[0] "Abgesicherter Modus: %d von dir installierte Erweiterung ist jetzt angehalten, nicht gelöscht."
msgstr[1] "Abgesicherter Modus: %d von dir installierte Erweiterungen sind jetzt angehalten, nicht gelöscht."

