msgstr "„%s“ formatieren"

#: lib/python/Components/HdsLocInregistrari.py
msgid "Deschide formatarea. Înainte să șteargă ceva, receptorul te întreabă."
msgstr "Öffnet das Formatieren. Bevor etwas gelöscht wird, fragt dich der Receiver."

#: lib/python/Components/HdsFilmRedare.py lib/python/Screens/InfoBarGenerics.py
msgid "Canalul nu se poate reda pe acest receptor."
msgstr "Dieser Sender kann hier nicht abgespielt werden."

#: lib/python/Components/HdsFilmRedare.py
