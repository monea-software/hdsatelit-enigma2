#: lib/python/Components/HdsIpv6.py
msgid "IPv6"
msgstr "IPv6"

#: data/setup.xml
msgid "Nu (din fabrică): plăcile de rețea nu au adrese IPv6, iar clientul IPv6 nu pornește; rețeaua merge pe IPv4, ca până acum. Da: receptorul primește și adrese IPv6, dacă rețeaua ta le dă. Se aplică pe loc."
msgstr "Nein (ab Werk): Die Netzwerkkarten haben keine IPv6-Adressen, und der IPv6-Client startet nicht; das Netzwerk läuft über IPv4, wie bisher. Ja: Der Receiver bekommt auch IPv6-Adressen, wenn dein Netzwerk sie vergibt. Wirkt sofort."

#: lib/python/Plugins/Extensions/HdsWebControl/retea_web.py
msgid "Nu (din fabrică): plăcile de rețea nu au adrese IPv6, iar clientul IPv6 nu pornește; rețeaua merge pe IPv4, ca până acum. Da: receptorul primește și adrese IPv6, dacă rețeaua ta le dă. Se aplică pe loc. Aceeași setare pe televizor: Meniu &gt; Setări &gt; Rețea și Internet &gt; IPv6."
msgstr "Nein (ab Werk): Die Netzwerkkarten haben keine IPv6-Adressen, und der IPv6-Client startet nicht; das Netzwerk läuft über IPv4, wie bisher. Ja: Der Receiver bekommt auch IPv6-Adressen, wenn dein Netzwerk sie vergibt. Wirkt sofort. Dieselbe Einstellung auf dem Fernseher: Menü &gt; Einstellungen &gt; Netzwerk und Internet &gt; IPv6."

#: lib/python/Components/HdsIpv6.py
msgid "Oprit acum: plăcile de rețea nu au adrese IPv6, iar clientul IPv6 nu rulează."
msgstr "Jetzt aus: Die Netzwerkkarten haben keine IPv6-Adressen, und der IPv6-Client läuft nicht."

