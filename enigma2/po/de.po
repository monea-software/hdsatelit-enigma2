msgid "acest receptor"
msgstr "dieser Receiver"

#: lib/python/Components/HdsCopieSetari.py
msgid "alt receptor (se pun la loc numai canalele)"
msgstr "ein anderer Receiver (nur die Sender werden zurückgesetzt)"

#: lib/python/Components/HdsCopieSetari.py
msgid "automată"
msgstr "automatisch"

#: lib/python/Components/HdsCopieSetari.py
msgid "făcută de mână"
msgstr "von Hand erstellt"

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "%s, copia din %s (%s, imaginea %s), %s.\nAre: %s."
msgstr "%s, Kopie vom %s (%s, Image %s), %s.\nEnthält: %s."

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "Copia din %s e de pe alt receptor: se pun la loc numai canalele și listele DAB+ și DVB-T2. Interfața repornește acum. Continui?"
msgstr "Die Kopie vom %s stammt von einem anderen Receiver: Nur die Sender und die DAB+- und DVB-T2-Listen werden zurückgesetzt. Die Oberfläche startet jetzt neu. Weiter?"

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "Ștergi copia din %s de pe %s? Nu se mai poate aduce înapoi."
msgstr "Kopie vom %s auf %s löschen? Das lässt sich nicht rückgängig machen."

#: lib/python/Components/HdsCopieSetari.py
msgid "copia nu are o descriere bună (copie.txt)"
msgstr "die Kopie hat keine gültige Beschreibung (copie.txt)"

#: lib/python/Components/HdsCopieSetari.py
msgid "Copia se pune la loc la repornirea interfeței."
msgstr "Die Kopie wird beim Neustart der Oberfläche zurückgesetzt."

#: lib/python/Components/HdsCopieSetari.py
msgid "canalele, buchetele și listele DAB+ și DVB-T2"
msgstr "die Sender, die Bouquets und die DAB+- und DVB-T2-Listen"

#: lib/python/Components/HdsCopieSetari.py
msgid "setările"
msgstr "die Einstellungen"

#: lib/python/Components/HdsCopieSetari.py
msgid "rețeaua și Wi-Fi"
msgstr "das Netzwerk und WLAN"

#: lib/python/Components/HdsCopieSetari.py
