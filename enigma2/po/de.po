msgstr "Die aktuelle Senderliste hat nicht die übliche Form; sie kam so in die Kopie, wie sie ist."

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "Copia nu s-a putut scrie pe mediu (%s). Pe receptor nu s-a schimbat nimic."
msgstr "Die Kopie konnte nicht auf den Datenträger geschrieben werden (%s). Am Receiver wurde nichts geändert."

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "Copia nu s-a putut șterge (%s)."
msgstr "Die Kopie konnte nicht gelöscht werden (%s)."

#: lib/python/Components/HdsCopieSetari.py
msgid "arhiva are o cale nepermisă"
msgstr "das Archiv enthält einen unzulässigen Pfad"

#: lib/python/Components/HdsCopieSetari.py
msgid "arhiva are un fișier de un fel nepermis"
msgstr "das Archiv enthält eine unzulässige Dateiart"

#: lib/python/Components/HdsCopieSetari.py
msgid "arhiva are un fișier în afara locurilor permise"
msgstr "das Archiv enthält eine Datei außerhalb der erlaubten Orte"

#: lib/python/Components/HdsCopieSetari.py
msgid "copia modulelor are informații opkg străine"
msgstr "die Kopie der Module enthält fremde opkg-Angaben"

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "Arhiva rețelei din copie nu e bună (%s); nu s-a pus nimic la loc."
msgstr "Das Netzwerkarchiv in der Kopie ist ungültig (%s); nichts wurde zurückgesetzt."

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "Copia modulelor de acces condiționat nu e bună (%s); nu s-a pus la loc."
msgstr "Die Kopie der Module für die Zugangsberechtigung ist ungültig (%s); sie wurde nicht zurückgesetzt."

#: lib/python/Components/HdsCopieSetari.py
msgid "Cheile SSH din copie nu au forma obișnuită; nu s-au pus la loc."
msgstr "Die SSH-Schlüssel in der Kopie haben nicht die übliche Form; sie wurden nicht zurückgesetzt."

#: lib/python/Components/HdsCopieSetari.py
msgid "Modulele de acces condiționat nu s-au putut pune la loc."
msgstr "Die Module für die Zugangsberechtigung konnten nicht zurückgesetzt werden."

#: lib/python/Components/HdsCopieSetari.py
#, python-format
