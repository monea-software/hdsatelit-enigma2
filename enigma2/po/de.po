msgstr "Übernommen. Es ist auch am Fernseher zu hören."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Volumul se alege cu auto, aici sau placa."
msgstr "Die Lautstärke wird mit auto, aici oder placa gewählt."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Numele plăcii de sunet are numai litere, cifre și : , _ - ."
msgstr "Der Name des Soundgeräts hat nur Buchstaben, Ziffern und : , _ - ."

