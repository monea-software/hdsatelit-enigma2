msgstr "Die Kopie der Einstellungen wurde nicht zurückgesetzt."

#: lib/python/Components/HdsCopieSetari.py
msgid "Copia automată e oprită."
msgstr "Die automatische Kopie ist aus."

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "Copia automată se face zilnic; se păstrează ultimele %s pe mediu."
msgstr "Die automatische Kopie wird täglich erstellt; die letzten %s bleiben auf dem Datenträger."

#: lib/python/Components/HdsCopieSetari.py
msgid "(stickul de actualizare)"
msgstr "(der Update-Stick)"

#: lib/python/Components/HdsCopieSetari.py
msgid "Mediul ales nu mai este montat."
msgstr "Der gewählte Datenträger ist nicht mehr eingebunden."

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "Copia e gata: %s."
msgstr "Die Kopie ist fertig: %s."

#: lib/python/Components/HdsCopieSetari.py
msgid "Copia nu mai este pe mediu."
msgstr "Die Kopie ist nicht mehr auf dem Datenträger."

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "Copia din %s a fost ștearsă."
msgstr "Die Kopie vom %s wurde gelöscht."

#: lib/python/Components/HdsCopieSetari.py
msgid "canalele, buchetele, listele DAB+ și DVB-T2, setările"
msgstr "die Sender, die Bouquets, die DAB+- und DVB-T2-Listen, die Einstellungen"

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "Pui la loc copia din %s? Interfața repornește și o pune la loc. Dacă rețeaua din copie e alta, receptorul mai repornește o dată, singur."
msgstr "Kopie vom %s zurücksetzen? Die Oberfläche startet neu und setzt sie zurück. Ist das Netzwerk in der Kopie anders, startet der Receiver noch einmal von selbst neu."

#: lib/python/Components/HdsCopieSetari.py
msgid "lista pachetelor din copie nu e bună"
msgstr "die Paketliste in der Kopie ist ungültig"

#: lib/python/Components/HdsCopieSetari.py
msgid "Copia nu are o descriere bună; nu s-a pus nimic la loc."
msgstr "Die Kopie hat keine gültige Beschreibung; nichts wurde zurückgesetzt."

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "Am pus la loc din copia din %s (imaginea %s): %s."
msgstr "Aus der Kopie vom %s (Image %s) zurückgesetzt: %s."

#: lib/python/Components/HdsCopieSetari.py
msgid "Copia era de pe alt receptor, deci numai canalele."
msgstr "Die Kopie stammte von einem anderen Receiver, daher nur die Sender."

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "Se face copia pe %s…"
msgstr "Die Kopie wird auf %s erstellt…"

#: lib/python/Components/HdsCopieSetari.py
msgid "Receptorul repornește o dată acum, ca să intre rețeaua din copie."
msgstr "Der Receiver startet jetzt einmal neu, damit das Netzwerk aus der Kopie greift."

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "Pe mediul ales nu e destul loc (trebuie cam %d MB)."
msgstr "Auf dem gewählten Datenträger ist nicht genug Platz (etwa %d MB nötig)."

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "lipsește %s din copie"
msgstr "%s fehlt in der Kopie"

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "%s e prea mare"
msgstr "%s ist zu groß"

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "%s nu mai e cum a fost scris (md5)"
msgstr "%s ist nicht mehr so, wie es geschrieben wurde (md5)"

#: lib/python/Components/HdsCopieSetari.py
#, python-format
msgid "Copia nu e întreagă (%s); nu s-a pus nimic la loc."
msgstr "Die Kopie ist nicht vollständig (%s); nichts wurde zurückgesetzt."

#: lib/python/Components/HdsCopieSetari.py
#, python-format
