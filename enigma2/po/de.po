#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Cereri"
msgstr "Anfragen"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Chei și numere (de la 0) despărțite prin punct, de exemplu translatedText sau data.translations.0.translatedText; * ia toate elementele, lipite în ordine (de exemplu 0.*.0)."
msgstr "Schlüssel und Zahlen (ab 0), durch Punkte getrennt, zum Beispiel translatedText oder data.translations.0.translatedText; * nimmt alle Elemente, der Reihe nach aneinandergefügt (zum Beispiel 0.*.0)."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
