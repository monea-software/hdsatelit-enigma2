#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/accel</code>: accelerarea 2D pe placa video: dacă receptorul o are (<code>disponibila</code>), setarea pentru următoarea pornire (implicit pornită) și ce s-a hotărât la pornirea de acum"
msgstr "<code>GET /api/accel</code>: die 2D-Beschleunigung auf der Grafikkarte: ob der Receiver sie hat (<code>disponibila</code>), die Einstellung für den nächsten Start (standardmäßig eingeschaltet) und was beim aktuellen Start entschieden wurde"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-canal</code>: accesul canalului care rulează (criptat sau liber), sistemele, CAID-urile și ce decriptează modulul acum"
msgstr "<code>GET /api/acces-canal</code>: der Zugang des laufenden Senders (verschlüsselt oder frei), die Systeme, die CAIDs und was das Modul gerade entschlüsselt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-conditionat</code>: modulele de acces condiționat pe feluri (câmpul <code>fel</code>: numele felului, așa cum îl are receptorul; întâi modulele obișnuite, apoi serverele de carduri), cel ales la pornirea receptorului, cele care rulează, procesul care lucrează și memoria lui, comanda în curs sau ultimul rezultat, dacă receptorul decriptează acum"
msgstr "<code>GET /api/acces-conditionat</code>: die Module für die Zugangsberechtigung nach Arten (Feld <code>fel</code>: der Name der Art, so wie der Receiver ihn hat; zuerst die gewöhnlichen Module, dann die Kartenserver), das beim Start des Receivers gewählte, die laufenden, der arbeitende Prozess und sein Speicher, der laufende Befehl oder das letzte Ergebnis, ob der Receiver gerade entschlüsselt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-ssh</code>: intrarea pe receptor prin SSH: felul parolei de administrator (fără parola însăși), cheile SSH (tipul, amprenta, comentariul), „Fără parolă în rețeaua locală”, stările periculoase (<code>alarme</code>), lucrarea în curs și rezultatul ultimei comenzi"
msgstr "<code>GET /api/acces-ssh</code>: der Zugang zum Receiver über SSH: die Art des Administratorpassworts (ohne das Passwort selbst), die SSH-Schlüssel (Typ, Fingerabdruck, Kommentar), „Ohne Passwort im lokalen Netzwerk“, die gefährlichen Zustände (<code>alarme</code>), die laufende Arbeit und das Ergebnis des letzten Befehls"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, <code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, <code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/actualizari-reporneste</code>: actualizările prin pachete de pe stb.hdsatelit.com (starea, căutarea, instalarea, verificarea zilnică, repornirea interfeței după instalare)"
msgstr "<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, <code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, <code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/actualizari-reporneste</code>: die Aktualisierungen über Pakete von stb.hdsatelit.com (Zustand, Suche, Installation, tägliche Prüfung, Neustart der Oberfläche nach der Installation)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;orase=1]</code>: afișajul din față: ce arată acum (măștile celor 4 cifre și textul), lista de rotire, mesajele scurte, așteptarea, setările, minutarul și cronometrul; cu <code>grupa</code> alegerile grupei cu desenul valorii de acum, cu <code>catalog=1</code> toate alegerile (căutarea), cu <code>orase=1</code> fusurile pentru ora din alt oraș"
msgstr "<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;orase=1]</code>: das Frontdisplay: was es gerade zeigt (die Masken der 4 Ziffern und der Text), die Rotationsliste, die kurzen Meldungen, der Wartezustand, die Einstellungen, der Timer und die Stoppuhr; mit <code>grupa</code> die Auswahlen der Gruppe mit der Zeichnung des aktuellen Werts, mit <code>catalog=1</code> alle Auswahlen (die Suche), mit <code>orase=1</code> die Zeitzonen für die Uhrzeit in einer anderen Stadt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: tunerele, LNB-ul, semnalul canalului curent și unghiurile antenei spre fiecare satelit (numai citire)"
msgstr "<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: die Tuner, das LNB, das Signal des aktuellen Senders und die Winkel der Antenne zu jedem Satelliten (nur lesen)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/calitate-imagine</code>: calitatea imaginii: „Reglajele după canal”, profilul canalului de acum, cele 9 profiluri (SD, HD, 4K x SDR, HDR10, HLG) cu reglajele lor, ieșirea HDR (alegerile primite de televizor, ce e scris acum, întrebarea în curs) și textul brut al blocului de calitate"
msgstr "<code>GET /api/calitate-imagine</code>: die Bildqualität: „Einstellungen nach Sender“, das Profil des aktuellen Senders, die 9 Profile (SD, HD, 4K x SDR, HDR10, HLG) mit ihren Einstellungen, der HDR-Ausgang (die vom Fernseher empfangenen Auswahlen, was gerade geschrieben ist, die laufende Abfrage) und der Rohtext des Qualitätsblocks"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-acum</code>: canalul de pe televizor"
msgstr "<code>GET /api/canale-acum</code>: der Sender auf dem Fernseher"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-buchete?fila=tv|radio</code>: listele de ales și lista pe care stă televizorul"
msgstr "<code>GET /api/canale-buchete?fila=tv|radio</code>: die Auswahllisten und die Liste, auf der der Fernseher steht"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-epg?refs=r1,r2</code>: emisiunea de acum și cea următoare, cel mult 50 de canale"
msgstr "<code>GET /api/canale-epg?refs=r1,r2</code>: die aktuelle und die nächste Sendung, höchstens 50 Sender"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,v2&amp;de_la=&amp;cate=</code>: rândurile, pe pagini de cel mult 200, cu grupele de filtre și numerele lor"
msgstr "<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,v2&amp;de_la=&amp;cate=</code>: die Zeilen, in Seiten zu höchstens 200, mit den Filtergruppen und ihren Zahlen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: sigla canalului; la listele de canale, 503 când receptorul are prea multe cereri în lucru și 504 când nu termină în 10 s"
msgstr "<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: das Logo des Senders; bei den Senderlisten 503, wenn der Receiver zu viele Anfragen in Arbeit hat, und 504, wenn er nicht in 10 s fertig wird"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Caută setări”: meniurile și setările care au textul în nume (fără diacritice), cu drumul din meniu, valoarea de acum și pagina web"
msgstr "<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Einstellungen suchen“: die Menüs und Einstellungen, die den Text im Namen haben (ohne Diakritika), mit dem Weg im Menü, dem aktuellen Wert und der Webseite"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cautare-actualizeaza-stare</code>: cât a citit (transponderul, canalele) sau rezultatul"
msgstr "<code>GET /api/cautare-actualizeaza-stare</code>: wie viel gelesen wurde (der Transponder, die Sender) oder das Ergebnis"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code>: căutarea de canale, cu aceleași rânduri de filtre ca pe televizor și pistele știute ale fiecărui canal"
msgstr "<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code>: die Suche nach Sendern, mit denselben Filterzeilen wie auf dem Fernseher und den bekannten Spuren jedes Senders"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ceas</code>: ora receptorului, fusul orar, sursa orei (<code>auto</code>: Internet, apoi transponder; <code>ntp</code>; <code>dvb</code>), serverul NTP, alegerile lor și ultima sincronizare"
msgstr "<code>GET /api/ceas</code>: die Uhrzeit des Receivers, die Zeitzone, die Zeitquelle (<code>auto</code>: Internet, dann Transponder; <code>ntp</code>; <code>dvb</code>), der NTP-Server, ihre Auswahlen und die letzte Synchronisierung"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/copie-setari[?cauta=1]</code>: copia setărilor: stickurile și discurile (<code>implicit</code> = stickul de actualizare), copiile găsite (data, versiunea imaginii, acest receptor sau altul), copia automată, ultimul rezultat; niciodată conținutul copiei"
msgstr "<code>GET /api/copie-setari[?cauta=1]</code>: die Kopie der Einstellungen: die Sticks und Festplatten (<code>implicit</code> = der Update-Stick), die gefundenen Kopien (Datum, Version des Images, dieser Receiver oder ein anderer), die automatische Kopie, das letzte Ergebnis; niemals der Inhalt der Kopie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/dabt2?fel=dab|t2</code>: fereastra „Fluxuri și setări” a DAB+ / DVB-T2 din satelit: fluxurile cu poziția, numele, numărul de posturi și starea, setările, Despre, lucrul în curs și <code>repunere</code> (canalul de dinainte, pornit din nou după „Învață posturile”: starea și mesajul)"
msgstr "<code>GET /api/dabt2?fel=dab|t2</code>: das Fenster „Streams und Einstellungen“ von DAB+ / DVB-T2 über Satellit: die Streams mit Position, Name, Anzahl der Sender und Zustand, die Einstellungen, „Über“, die laufende Arbeit und <code>repunere</code> (der Sender davor, nach „Sender lernen“ wieder gestartet: der Zustand und die Meldung)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/descarcare-subtitrari</code> și <code>POST /api/descarcare-subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, <code>-verifica</code>, <code>-conturi</code>: descărcarea subtitrărilor (numele, parolele și cheile numai în corpul cererii); pe un canal TV sau la o înregistrare și <code>-film</code> (<code>fapta=identifica|alege|titlu|local</code>: filmul din ghid, identificat în Wikidata) și <code>-potrivire</code> (<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|opreste</code>: potrivirea subtitrării pe canal)"
msgstr "<code>GET /api/descarcare-subtitrari</code> und <code>POST /api/descarcare-subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, <code>-verifica</code>, <code>-conturi</code>: das Herunterladen von Untertiteln (Namen, Passwörter und Schlüssel nur im Anfragetext); bei einem TV-Sender oder einer Aufnahme und <code>-film</code> (<code>fapta=identifica|alege|titlu|local</code>: der Film aus dem Programmführer, in Wikidata identifiziert) und <code>-potrivire</code> (<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|opreste</code>: das Abgleichen der Untertitel auf dem Sender)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: mesajul de pe ecranul negru (de ce nu se vede imaginea) și analiza fluxului canalului"
msgstr "<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: die Meldung auf dem schwarzen Bildschirm (warum das Bild nicht zu sehen ist) und die Analyse des Streams des Senders"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/egalizator</code>: egalizatorul posturilor de radio: pornit sau oprit, benzile, presetarea, modul de noapte, reglajele postului de acum și dacă merge la acest post; <code>POST /api/egalizator-seteaza</code>: schimbă și aplică pe loc"
msgstr "<code>GET /api/egalizator</code>: der Equalizer der Radiosender: ein- oder ausgeschaltet, die Bänder, das Preset, der Nachtmodus, die Einstellungen des aktuellen Senders und ob er bei diesem Sender funktioniert; <code>POST /api/egalizator-seteaza</code>: ändert und wendet sofort an"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/filme</code>: filmul care merge (poziția, lungimea, starea, locul ținut minte, mesajul de refuz) și setările filmelor; <code>GET /api/filme-lista</code>: filmele din dosarul listei de filme, cu locul rămas"
msgstr "<code>GET /api/filme</code>: der laufende Film (Position, Länge, Zustand, gemerkte Stelle, Ablehnungsmeldung) und die Filmeinstellungen; <code>GET /api/filme-lista</code>: die Filme im Ordner der Filmliste, mit der gemerkten Stelle"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: familiile libere de pe Google Fonts și fonturile deja descărcate"
msgstr "<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: die freien Familien von Google Fonts und die bereits heruntergeladenen Schriften"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal-stare</code>: nivelul, calitatea, BER-ul și verdictul măsurării"
msgstr "<code>GET /api/gasire-semnal-stare</code>: Pegel, Qualität, BER und das Urteil der Messung"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: transponderele unui satelit"
msgstr "<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: die Transponder eines Satelliten"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal</code>: tunerele, sateliții, transponderul de la care pornește măsurarea și starea ei"
msgstr "<code>GET /api/gasire-semnal</code>: die Tuner, die Satelliten, der Transponder, bei dem die Messung beginnt, und ihr Zustand"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-emisiune?ref=&amp;id=</code>: ghidul unui canal (fără <code>ref</code>, canalul de pe televizor) și o emisiune cu descrierile"
msgstr "<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-emisiune?ref=&amp;id=</code>: der Programmführer eines Senders (ohne <code>ref</code> der Sender auf dem Fernseher) und eine Sendung mit den Beschreibungen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/import-surse?cauta=1</code>: copiile de canale și setări găsite pe stick-uri și pe receptor, starea căutării și a importului"
msgstr "<code>GET /api/import-surse?cauta=1</code>: die auf Sticks und im Receiver gefundenen Kopien von Sendern und Einstellungen, der Zustand der Suche und des Imports"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|retea|hdmi</code>: ecranele „System Information”, cu aceleași texte ca pe televizor"
msgstr "<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|retea|hdmi</code>: die Bildschirme „System Information“, mit denselben Texten wie auf dem Fernseher"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/interfete-cam?reincarca=1</code>: modulele de acces condiționat instalate și interfețele lor web, cu numele date de fiecare modul (fără <code>reincarca</code> poate veni o căutare făcută cu câteva secunde înainte)"
msgstr "<code>GET /api/interfete-cam?reincarca=1</code>: die installierten Module für die Zugangsberechtigung und ihre Weboberflächen, mit den Namen, die jedes Modul vergibt (ohne <code>reincarca</code> kann eine Suche kommen, die ein paar Sekunden zuvor gemacht wurde)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/jurnal</code>: jurnalul de versiuni (ce s-a schimbat la fiecare actualizare)"
msgstr "<code>GET /api/jurnal</code>: das Versionsprotokoll (was sich bei jeder Aktualisierung geändert hat)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: programele din imagine cu licența fiecăruia și textul unei licențe"
msgstr "<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: die Programme im Image mit der Lizenz jedes einzelnen und der Text einer Lizenz"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/limba-interfata</code>: limba meniurilor de acum și lista limbilor, cu numele de pe televizor"
msgstr "<code>GET /api/limba-interfata</code>: die aktuelle Sprache der Menüs und die Liste der Sprachen, mit dem Namen wie auf dem Fernseher"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/limbi</code>: limba sunetului și a subtitrărilor: cele 7 setări cu alegerile lor, ce se ține minte pe canalul de acum și canalele cu alegeri de mână"
msgstr "<code>GET /api/limbi</code>: die Sprache von Ton und Untertiteln: die 7 Einstellungen mit ihren Auswahlen, was für den aktuellen Sender gemerkt wird und die Sender mit von Hand gewählten Auswahlen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/liste-implicite</code>: listele de canale gata făcute și drumurile spre scanare și import"
msgstr "<code>GET /api/liste-implicite</code>: die fertigen Senderlisten und die Wege zu Suchlauf und Import"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/lnb-stare</code>: verificarea semnalului, întrebarea și secundele rămase"
msgstr "<code>GET /api/lnb-stare</code>: die Signalprüfung, die Frage und die verbleibenden Sekunden"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/lnb?slot=N</code>: LNB-urile tunerului, cu valorile, alegerile și „Probă de calcul” (numai citire)"
msgstr "<code>GET /api/lnb?slot=N</code>: die LNBs des Tuners, mit den Werten, den Auswahlen und „Probeberechnung“ (nur lesen)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/locul[?tara=RO]</code>: locul antenei pentru motorul USALS, țările și orașele unei țări (tabelul din imagine)"
msgstr "<code>GET /api/locul[?tara=RO]</code>: der Standort der Antenne für den USALS-Motor, die Länder und die Städte eines Landes (die Tabelle im Image)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/meniu</code>: tot meniul receptorului (tasta MENU), cu aceleași intrări ca pe televizor pentru nivelul ales"
msgstr "<code>GET /api/meniu</code>: das ganze Menü des Receivers (Taste MENU), mit denselben Einträgen wie auf dem Fernseher für die gewählte Ebene"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, <code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: modul sigur (opririle interfeței, alegerile de după ele) și fișierele lui ca text"
msgstr "<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, <code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: der sichere Modus (die Stopps der Oberfläche, die Auswahlen danach) und seine Dateien als Text"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor-comenzi</code>: tunerele cu motor, sateliții și starea comenzilor"
msgstr "<code>GET /api/motor-comenzi</code>: die Tuner mit Motor, die Satelliten und der Zustand der Befehle"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor-comenzi?urma=N</code>: urma comenzilor trimise motorului (ultimele N, implicit 100, cel mult 500, cele mai noi întâi): ora, comanda, unghiul, cine a cerut-o (televizorul, ecranul sau pagina motorului, Găsire semnal, reacordarea), poziția crezută de receptor; numai citire, din <code>/home/root/logs/hds-motor.log</code>"
msgstr "<code>GET /api/motor-comenzi?urma=N</code>: die Spur der an den Motor gesendeten Befehle (die letzten N, standardmäßig 100, höchstens 500, die neuesten zuerst): Uhrzeit, Befehl, Winkel, wer ihn angefordert hat (der Fernseher, der Bildschirm oder die Motorseite, Signalsuche, das erneute Abstimmen), die vom Receiver angenommene Position; nur lesen, aus <code>/home/root/logs/hds-motor.log</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor</code>: starea rotirii antenei (de unde, pana unde, poziția estimată, cât mai are de mers)"
msgstr "<code>GET /api/motor</code>: der Zustand der Drehung der Antenne (von wo, bis wohin, geschätzte Position, wie weit sie noch fahren muss)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;xp=&amp;yp=</code>: mouse-ul pe ecranul televizorului, ca în emulator: <code>xp</code>, <code>yp</code> = locul în procente din ecran (sau <code>x</code>, <code>y</code> în pixelii ecranului, 1920x1080); <code>clic</code> alege rândul de sub mouse, iar pe rândul ales sau cu <code>clicuri=2</code> dă OK; un buton colorat = tasta lui; <code>drag</code> (cu <code>x0p</code>, <code>y0p</code> = locul apăsării, <code>nou=1</code> la prima mișcare) și <code>dragend</code> = trasul pe bara de derulare; <code>rotita&amp;pasi=-12..12</code> = sus/jos (3 pași sau mai mulți = o pagină); <code>dreapta</code> = Meniu, <code>mijloc</code> = Ieșire. Răspunsul spune ce s-a făcut (<code>facut</code>: selectie, ok, buton, bara, derulare, tasta, nimic). Din browser, cu POST și antetul <code>X-HDS-CSRF</code>, ca <code>remotecontrol</code>"
msgstr "<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;xp=&amp;yp=</code>: die Maus auf dem Bildschirm des Fernsehers, wie im Emulator: <code>xp</code>, <code>yp</code> = der Ort in Prozent des Bildschirms (oder <code>x</code>, <code>y</code> in Pixeln des Bildschirms, 1920x1080); <code>clic</code> wählt die Zeile unter der Maus, und auf der gewählten Zeile oder mit <code>clicuri=2</code> gibt es OK; eine farbige Taste = ihre Taste; <code>drag</code> (mit <code>x0p</code>, <code>y0p</code> = der Ort des Drückens, <code>nou=1</code> bei der ersten Bewegung) und <code>dragend</code> = das Ziehen an der Bildlaufleiste; <code>rotita&amp;pasi=-12..12</code> = nach oben/unten (3 Schritte oder mehr = eine Seite); <code>dreapta</code> = Menü, <code>mijloc</code> = Beenden. Die Antwort sagt, was getan wurde (<code>facut</code>: selectie, ok, buton, bara, derulare, tasta, nimic). Aus dem Browser, mit POST und dem Header <code>X-HDS-CSRF</code>, wie <code>remotecontrol</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/navigator</code>: navigatorul web de pe televizor (deschis sau nu, modul, desenul, felul câmpului ales, mărirea; fără adrese), setările lui și favoritele"
msgstr "<code>GET /api/navigator</code>: der Webbrowser auf dem Fernseher (geöffnet oder nicht, der Modus, die Zeichnung, die Art des gewählten Feldes, die Vergrößerung; ohne Adressen), seine Einstellungen und die Favoriten"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ocr-limbi</code>: limbile recunoașterii textului (în imagine, descărcate, de descărcat, cu mărimea și starea fiecăreia) și locul pentru modelele noi"
msgstr "<code>GET /api/ocr-limbi</code>: die Sprachen der Texterkennung (im Image, heruntergeladen, herunterzuladen, mit Größe und Zustand jeder einzelnen) und der Ort für neue Modelle"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/pasi-decriptare</code>: pașii decriptării canalului de pe televizor (cererea către modulul de acces, răspunsurile și timpul lor, imaginea decriptată, mesajele modulului CI), numai cu setarea Arată pașii decriptării pornită"
msgstr "<code>GET /api/pasi-decriptare</code>: die Schritte der Entschlüsselung des Senders auf dem Fernseher (die Anfrage an das Zugangsmodul, die Antworten und ihre Zeit, das entschlüsselte Bild, die Meldungen des CI-Moduls), nur bei eingeschalteter Einstellung Entschlüsselungsschritte anzeigen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/paza-model</code>: paza de model (receptorul pentru care e făcută imaginea și amprenta acestuia); <code>GET /api/actualizare-pachete</code>: pachetele de actualizare găsite și verdictul pazei pentru fiecare"
msgstr "<code>GET /api/paza-model</code>: der Modellschutz (der Receiver, für den das Image gemacht ist, und sein Fingerabdruck); <code>GET /api/actualizare-pachete</code>: die gefundenen Aktualisierungspakete und das Urteil des Schutzes für jedes"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/paznic</code>: paznicul receptorului: starea, setările (<code>interfata</code>, <code>asteptare</code> în secunde), alegerile și ultimele rânduri din jurnalul lui"
msgstr "<code>GET /api/paznic</code>: der Wachhund des Receivers: der Zustand, die Einstellungen (<code>interfata</code>, <code>asteptare</code> in Sekunden), die Auswahlen und die letzten Zeilen seines Protokolls"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/portal</code>: starea HbbTV a canalului care rulează (da, nu are, încă nu se știe), cu mesajul arătat pe televizor la tasta PORTAL"
msgstr "<code>GET /api/portal</code>: der HbbTV-Zustand des laufenden Senders (ja, hat keinen, noch nicht bekannt), mit der Meldung, die der Fernseher bei der Taste PORTAL zeigt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/procesor</code>: procesorul: modul de lucru, modurile care există pe receptor, frecvența setată și cea de acum, temperatura, tensiunea, procentul folosit și timpul pe fiecare treaptă"
msgstr "<code>GET /api/procesor</code>: der Prozessor: der Arbeitsmodus, die auf dem Receiver vorhandenen Modi, die eingestellte und die aktuelle Frequenz, die Temperatur, die Spannung, der genutzte Prozentsatz und die Zeit in jeder Stufe"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: postul de radio care merge, cu textele ecranului radio; barele și nivelul sunetului"
msgstr "<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: der laufende Radiosender, mit den Texten des Radiobildschirms; die Balken und der Tonpegel"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: apasă o tastă ca de pe telecomanda receptorului (coduri de tastă Linux, de exemplu 352 pentru OK); cu <code>lung=1</code>, apăsare lungă"
msgstr "<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: drückt eine Taste wie auf der Fernbedienung des Receivers (Linux-Tastencodes, zum Beispiel 352 für OK); mit <code>lung=1</code> langer Druck"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare-stare</code>: starea căutării (procent, canale găsite, transpondere, timp rămas, rezultat)"
msgstr "<code>GET /api/scanare-stare</code>: der Zustand der Suche (Prozent, gefundene Sender, Transponder, verbleibende Zeit, Ergebnis)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare-ultima</code>: rezultatul ultimei scanări de canale, ținut până la scanarea următoare: <code>inceput</code>, <code>sfarsit</code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, <code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, <code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, <code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, iar când se știu <code>tsid</code>, <code>onid</code>, <code>nid</code> și, la cablu, <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, <code>caid</code>, iar când operatorul trimite numerele canalelor <code>lcn</code> și <code>lcn_vizibil</code>): toate serviciile citite din SDT, vechi și noi, și <code>retele</code> (<code>nid</code>, <code>nume</code>, <code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, <code>privati</code>): rețelele din tabela NIT; câmpurile din tabela NIT (<code>nid</code>, <code>lcn</code>, <code>retele</code>) apar la căutarea în rețea și la scanarea pe cablu pe o singură frecvență; numai citire, lista de canale nu se schimbă; fără nicio scanare de la pornire, <code>result</code> false"
msgstr "<code>GET /api/scanare-ultima</code>: das Ergebnis des letzten Sender-Suchlaufs, bis zum nächsten Suchlauf aufbewahrt: <code>inceput</code>, <code>sfarsit</code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, <code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, <code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, <code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, und wenn bekannt <code>tsid</code>, <code>onid</code>, <code>nid</code> sowie bei Kabel <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, <code>caid</code>, und wenn der Betreiber Sendernummern sendet <code>lcn</code> und <code>lcn_vizibil</code>): alle aus der SDT gelesenen Dienste, alte und neue, sowie <code>retele</code> (<code>nid</code>, <code>nume</code>, <code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, <code>privati</code>): die Netze aus der NIT-Tabelle; die NIT-Felder (<code>nid</code>, <code>lcn</code>, <code>retele</code>) erscheinen bei der Netzwerksuche und beim Kabel-Suchlauf auf einer einzigen Frequenz; nur lesen, die Senderliste ändert sich nicht; ohne Suchlauf seit dem Start <code>result</code> false"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare</code>: secțiunile „Scanare” și „Orientarea și setarea antenei”, cu felurile de scanare, în ordinea din meniul receptorului; cu <code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</code>, câmpurile felului și ce s-ar căuta"
msgstr "<code>GET /api/scanare</code>: die Abschnitte „Sendersuche“ und „Antenne ausrichten und einstellen“, mit den Suchlaufarten, in der Reihenfolge des Receiver-Menüs; mit <code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</code> die Felder der Art und was gesucht würde"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;mode=all|video|osd&amp;download=1</code>: imaginea de pe ecran; <code>mode</code>: <code>all</code> cu afișajul OSD (implicit), <code>video</code> numai imaginea canalului, <code>osd</code> numai afișajul OSD; <code>download=1</code>: descărcare ca fișier, cu data și ora receptorului în nume"
msgstr "<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;mode=all|video|osd&amp;download=1</code>: das Bild auf dem Bildschirm; <code>mode</code>: <code>all</code> mit der OSD-Anzeige (Standard), <code>video</code> nur das Bild des Senders, <code>osd</code> nur die OSD-Anzeige; <code>download=1</code>: Download als Datei, mit Datum und Uhrzeit des Receivers im Namen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/setari-din-copie</code>: setările importate: câte așteaptă repornirea interfeței (<code>asteapta</code>), proba lor (<code>garda</code>), scoase după opriri neașteptate (<code>cazut</code>), textele stării"
msgstr "<code>GET /api/setari-din-copie</code>: die importierten Einstellungen: wie viele auf den Neustart der Oberfläche warten (<code>asteapta</code>), ihre Prüfung (<code>garda</code>), nach unerwarteten Stopps entfernt (<code>cazut</code>), die Texte des Zustands"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/setari</code>: ecranele de setări din meniu; cu <code>id=&lt;cheie&gt;</code>, rândurile lor (aceleași ca pe televizor, cu alegerile)"
msgstr "<code>GET /api/setari</code>: die Einstellungsbildschirme aus dem Menü; mit <code>id=&lt;cheie&gt;</code> ihre Zeilen (dieselben wie auf dem Fernseher, mit den Auswahlen)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/standby-tv</code>: ieșirea HDMI în standby (oprită sau pornită, oprirea din nou după aprinderea televizorului) și starea CEC"
msgstr "<code>GET /api/standby-tv</code>: der HDMI-Ausgang im Standby (aus oder an, das erneute Ausschalten nach dem Einschalten des Fernsehers) und der CEC-Zustand"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/stare-retea</code>: legătura cu routerul și internetul (cablu sau Wi-Fi, treptele semnalului Wi-Fi, internetul merge, routerul nu are internet sau receptorul nu e conectat la router), cu desenul pictogramei și textul ei, ca pictograma din bara de pe televizor"
msgstr "<code>GET /api/stare-retea</code>: die Verbindung zum Router und zum Internet (Kabel oder Wi-Fi, die Stufen des Wi-Fi-Signals, das Internet funktioniert, der Router hat kein Internet oder der Receiver ist nicht mit dem Router verbunden), mit der Zeichnung des Symbols und seinem Text, wie das Symbol in der Leiste auf dem Fernseher"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/statusinfo</code>: canalul curent, volumul, standby"
msgstr "<code>GET /api/statusinfo</code>: der aktuelle Sender, die Lautstärke, Standby"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/stocare</code>: locul înregistrărilor, spațiul liber și discurile conectate"
msgstr "<code>GET /api/stocare</code>: der Ort der Aufnahmen, der freie Platz und die angeschlossenen Festplatten"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-aspect</code>: aspectul subtitrărilor text (fontul, grosimea, mărimea și culoarea literelor, conturul, umbra, fundalul, înălțimea, distanța dintre rânduri) și mărirea subtitrărilor DVB, cu alegerile posibile (<code>alegeri</code>), stilurile gata făcute și valorile de la început"
msgstr "<code>GET /api/subtitrari-aspect</code>: das Aussehen der Text-Untertitel (die Schrift, die Stärke, die Größe und die Farbe der Buchstaben, die Kontur, der Schatten, der Hintergrund, die Höhe, der Zeilenabstand) und die Vergrößerung der DVB-Untertitel, mit den möglichen Auswahlen (<code>alegeri</code>), den fertigen Stilen und den Anfangswerten"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-film</code>: filmul care merge, subtitrările lui, întârzierea, codarea și cadrele pe secundă"
msgstr "<code>GET /api/subtitrari-film</code>: der laufende Film, seine Untertitel, die Verzögerung, die Kodierung und die Bilder pro Sekunde"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-ocr</code>: contorul recunoașterii textului din subtitrările DVB (pagini citite ca text, rămase imagine și de ce, timpul mediu, ultimele pagini, viteza serviciului)"
msgstr "<code>GET /api/subtitrari-ocr</code>: der Zähler der Texterkennung der DVB-Untertitel (als Text gelesene Seiten, als Bild geblieben und warum, die mittlere Zeit, die letzten Seiten, die Geschwindigkeit des Dienstes)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/sunet</code>: ieșirea sunetului (Automat / Manual), AC3 și DTS downmix, pista AC3, ce primește televizorul (EDID), ce se trimite acum și de ce, ce arată driverul pe HDMI și optic"
msgstr "<code>GET /api/sunet</code>: der Tonausgang (Automatisch / Manuell), AC3- und DTS-Downmix, die AC3-Spur, was der Fernseher annimmt (EDID), was jetzt gesendet wird und warum, was der Treiber an HDMI und optisch zeigt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/telecomenzi-export?format=json|csv</code>: codurile telecomenzii receptorului și ale celor asociate, pentru aplicații"
msgstr "<code>GET /api/telecomenzi-export?format=json|csv</code>: die Codes der Fernbedienung des Receivers und der angelernten, für Apps"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/telecomenzi</code>: telecomenzile asociate, tastele lor și captura paginii (cititorul, proba, asocierea)"
msgstr "<code>GET /api/telecomenzi</code>: die angelernten Fernbedienungen, ihre Tasten und die Erfassung der Seite (der Leser, der Test, das Anlernen)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext-copii</code> (cu <code>?canale=1</code> și canalele care au teletext): copiile de teletext salvate (canalul, data, paginile, mărimea), dosarul, spațiul folosit și cel ales, urmăritorul (caruselul canalului de acum, reîmprospătarea în lucru) și setările"
msgstr "<code>GET /api/teletext-copii</code> (mit <code>?canale=1</code> auch die Sender, die Videotext haben): die gespeicherten Videotext-Kopien (Sender, Datum, Seiten, Größe), der Ordner, der belegte und der gewählte Platz, der Verfolger (das Karussell des aktuellen Senders, die Aktualisierung in Arbeit) und die Einstellungen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> (fără <code>ref</code>: canalul de acum): <code>date</code> = fișierul copiei (.ttx, comprimat), <code>html</code> = o singură pagină HTML cu toate paginile, care se citește fără receptor"
msgstr "<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> (ohne <code>ref</code>: der aktuelle Sender): <code>date</code> = die Datei der Kopie (.ttx, komprimiert), <code>html</code> = eine einzige HTML-Seite mit allen Seiten, die sich ohne Receiver lesen lässt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;ref&gt;</code>: o pagină de teletext, ca pe televizor la tasta TEXT: cele 25 de rânduri a câte 40 de celule (litera, culoarea, fundalul, mozaicul, atributele), textul paginii, subpaginile, paginile tastelor colorate, paginile vecine și pagina de pe televizor; fără <code>pagina</code>, pagina de pe televizor sau cea de pornire; <code>sub=-1</code> = cea mai nouă; <code>ascuns=1</code> arată ce e ascuns; cu <code>copie</code>, paginile din copia salvată a canalului, fără tuner (<code>sursa</code>: <code>direct</code> sau <code>copie</code>); <code>hd</code> = setarea Teletext neted, <code>optiuni</code> = conturul literelor, umbra literelor și formele în relief (<code>contur</code>, <code>umbra</code>, <code>relief</code>, ca pe televizor). Pagina lipsă: <code>gasita</code> fals și mesajul că se caută"
msgstr "<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;ref&gt;</code>: eine Videotext-Seite, wie auf dem Fernseher bei der Taste TEXT: die 25 Zeilen zu je 40 Zellen (Buchstabe, Farbe, Hintergrund, Mosaik, Attribute), der Text der Seite, die Unterseiten, die Seiten der Farbtasten, die Nachbarseiten und die Seite auf dem Fernseher; ohne <code>pagina</code> die Seite auf dem Fernseher oder die Startseite; <code>sub=-1</code> = die neueste; <code>ascuns=1</code> zeigt, was verborgen ist; mit <code>copie</code> die Seiten aus der gespeicherten Kopie des Senders, ohne Tuner (<code>sursa</code>: <code>direct</code> oder <code>copie</code>); <code>hd</code> = die Einstellung Geglätteter Videotext, <code>optiuni</code> = die Kontur der Buchstaben, der Schatten der Buchstaben und die Reliefformen (<code>contur</code>, <code>umbra</code>, <code>relief</code>, wie auf dem Fernseher). Fehlende Seite: <code>gasita</code> false und die Meldung, dass gesucht wird"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: jurnalul unei înregistrări, pe înțelesul oricui, cu mesajul tehnic; golirea lui"
msgstr "<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: das Protokoll einer Aufnahme, für jeden verständlich, mit der technischen Meldung; das Leeren des Protokolls"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/temporizatoare</code>: înregistrările programate (aceeași ordine, stare și detalii ca pe televizor), locul înregistrărilor și spațiul liber"
msgstr "<code>GET /api/temporizatoare</code>: die programmierten Aufnahmen (dieselbe Reihenfolge, derselbe Zustand und dieselben Details wie auf dem Fernseher), der Ort der Aufnahmen und der freie Platz"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/traducere-configurare</code>: configurarea pas cu pas a traducerii: ce e pus acum (<code>acum</code>: serviciul, dacă are cheie, pornită sau nu, ultima probă, <code>chei_din_nou</code>), lucrarea configurării (<code>configurare</code>: starea, pasul, proba, modelul și modelele, mesajul și ce să faci), căutarea serverelor din casă (<code>cautare</code>: progresul și serverele găsite), instrucțiunile și pagina cheii fiecărui serviciu, regiunile Azure; niciodată o cheie"
msgstr "<code>GET /api/traducere-configurare</code>: die Einrichtung der Übersetzung Schritt für Schritt: was jetzt eingestellt ist (<code>acum</code>: der Dienst, ob er einen Schlüssel hat, ein- oder ausgeschaltet, der letzte Test, <code>chei_din_nou</code>), die Arbeit der Einrichtung (<code>configurare</code>: der Zustand, der Schritt, der Test, das Modell und die Modelle, die Meldung und was du tun sollst), die Suche nach den Servern im Haus (<code>cautare</code>: der Fortschritt und die gefundenen Server), die Anleitungen und die Schlüsselseite jedes Dienstes, die Azure-Regionen; niemals ein Schlüssel"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/traducere-subtitrari</code>: traducerea automată a subtitrărilor text: valorile (<code>pornit</code>, <code>serviciu</code>, <code>limba</code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</code>, <code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</code>, <code>adresa_libre</code>, <code>adresa_openai</code>, <code>model_gemini</code>, <code>model_openai</code>, <code>model_groq</code>, <code>model_cloudflare</code>, <code>cont_cloudflare</code> și, pentru adresa proprie, <code>propriu_adresa</code>, <code>propriu_metoda</code>, <code>propriu_corp</code>, <code>propriu_tip_corp</code>, <code>propriu_antet</code>, <code>propriu_raspuns</code>, <code>propriu_cale</code>), alegerile posibile (<code>alegeri</code>), ce cere fiecare serviciu (<code>cere</code>), care serviciu are cheie (<code>chei</code>, niciodată cheia), dacă cheile trebuie puse din nou (<code>chei_din_nou</code>, textul notei, gol când nu e cazul), starea cheii serviciului ales, ca pe televizor (<code>cheie_fel</code> și <code>cheie_text</code>: pusă, pusă pentru alt server, lipsă), textele paginii în limba receptorului (<code>texte</code>), ce lipsește, confidențialitatea, instrucțiunile pas cu pas (cu <code>pagina_cheie</code>, adresa oficială pentru codul QR) și starea (contorul, proba, pauza după erori)"
msgstr "<code>GET /api/traducere-subtitrari</code>: die automatische Übersetzung der Text-Untertitel: die Werte (<code>pornit</code>, <code>serviciu</code>, <code>limba</code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</code>, <code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</code>, <code>adresa_libre</code>, <code>adresa_openai</code>, <code>model_gemini</code>, <code>model_openai</code>, <code>model_groq</code>, <code>model_cloudflare</code>, <code>cont_cloudflare</code> und, für die eigene Adresse, <code>propriu_adresa</code>, <code>propriu_metoda</code>, <code>propriu_corp</code>, <code>propriu_tip_corp</code>, <code>propriu_antet</code>, <code>propriu_raspuns</code>, <code>propriu_cale</code>), die möglichen Auswahlen (<code>alegeri</code>), was jeder Dienst verlangt (<code>cere</code>), welcher Dienst einen Schlüssel hat (<code>chei</code>, niemals der Schlüssel), ob die Schlüssel neu eingegeben werden müssen (<code>chei_din_nou</code>, der Text des Hinweises, leer, wenn es nicht nötig ist), der Zustand des Schlüssels des gewählten Dienstes, wie auf dem Fernseher (<code>cheie_fel</code> und <code>cheie_text</code>: gesetzt, für einen anderen Server gesetzt, fehlt), die Texte der Seite in der Sprache des Receivers (<code>texte</code>), was fehlt, der Datenschutz, die Anleitung Schritt für Schritt (mit <code>pagina_cheie</code>, die offizielle Adresse für den QR-Code) und der Zustand (der Zähler, der Test, die Pause nach Fehlern)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: canalele de pe frecvența televizorului și din lista lui, fiecare cu merge acum sau motivul, codecul imaginii și felul sunetului; cu <code>wasm=1</code> (browserul are playerul MPEG-2) merg și canalele cu imagine MPEG-2; <code>ac3=1</code>: pagina redă sunetul AC-3, cu decodorul browserului sau cu decodorul wasm al paginii"
msgstr "<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: die Sender auf der Frequenz des Fernsehers und aus seiner Liste, jeder mit „läuft jetzt“ oder dem Grund, dem Codec des Bildes und der Art des Tons; mit <code>wasm=1</code> (der Browser hat den MPEG-2-Player) laufen auch die Sender mit MPEG-2-Bild; <code>ac3=1</code>: die Seite gibt den AC-3-Ton wieder, mit dem Decoder des Browsers oder mit dem wasm-Decoder der Seite"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/tv-stare</code>: TV în browser: transmisiile de acum (canal, browser, de când, octeți), setările, memoria driverului video (câte canale noi se mai pot deschide până la repornire), transmisia acestui browser și motivul ultimei opriri"
msgstr "<code>GET /api/tv-stare</code>: TV im Browser: die aktuellen Übertragungen (Sender, Browser, seit wann, Bytes), die Einstellungen, der Speicher des Videotreibers (wie viele neue Sender sich bis zum Neustart noch öffnen lassen), die Übertragung dieses Browsers und der Grund des letzten Stopps"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/video</code>: setările video ca în Setări &gt; Video: rezoluțiile, frecvențele fiecărei rezoluții (cu <code>auto</code> = automat după canal), culorile HDMI, <code>zapmode</code> (ce se vede la schimbarea canalului) și încercarea în curs"
msgstr "<code>GET /api/video</code>: die Videoeinstellungen wie unter Einstellungen &gt; Video: die Auflösungen, die Frequenzen jeder Auflösung (mit <code>auto</code> = automatisch nach Sender), die HDMI-Farben, <code>zapmode</code> (was beim Senderwechsel zu sehen ist) und der laufende Versuch"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: schimbă canalul"
msgstr "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: wechselt den Sender"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/accel-reporneste</code>: repornește interfața (enigma2)"
msgstr "<code>POST /api/accel-reporneste</code>: startet die Oberfläche (enigma2) neu"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/accel-seteaza?pornita=0|1</code>: pornește sau oprește accelerarea de la următoarea pornire a interfeței (refuzat pe un receptor fără accelerarea 2D)"
msgstr "<code>POST /api/accel-seteaza?pornita=0|1</code>: schaltet die Beschleunigung ab dem nächsten Start der Oberfläche ein oder aus (abgelehnt bei einem Receiver ohne 2D-Beschleunigung)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</code> ca în <code>GET /api/acces-conditionat</code>): pornește comanda prin scriptul modulului, pe rând, una singură deodată (și cu televizorul); rezultatul vine prin <code>GET /api/acces-conditionat</code>"
msgstr "<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</code> wie in <code>GET /api/acces-conditionat</code>): startet den Befehl über das Skript des Moduls, der Reihe nach, immer nur einer gleichzeitig (auch mit dem Fernseher); das Ergebnis kommt über <code>GET /api/acces-conditionat</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-adauga</code> (corp: <code>cheie=</code>), <code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?amprenta=SHA256:..&amp;confirmat=1</code>: cheile publice lipite, cele din dosarul hdsatelit/ssh de pe stick, ștergerea unei chei"
msgstr "<code>POST /api/acces-ssh-adauga</code> (Anfragetext: <code>cheie=</code>), <code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?amprenta=SHA256:..&amp;confirmat=1</code>: die eingefügten öffentlichen Schlüssel, die aus dem Ordner hdsatelit/ssh auf dem Stick, das Löschen eines Schlüssels"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</code> cere și <code>confirmat=1</code>): „Fără parolă în rețeaua locală”. Parola, textul brut și toate schimbările merg numai dintr-un browser conectat cu codul de pe televizor (altfel 403 cu <code>trebuie_cod</code>), niciodată cu <code>?token=</code>; cât ecranul „Acces SSH” e deschis pe televizor, la fel <code>/api/remotecontrol</code> și <code>/api/screenshot</code>"
msgstr "<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</code> verlangt auch <code>confirmat=1</code>): „Ohne Passwort im lokalen Netz“. Das Passwort, der Rohtext und alle Änderungen gehen nur aus einem Browser, der mit dem Code vom Fernseher verbunden ist (sonst 403 mit <code>trebuie_cod</code>), niemals mit <code>?token=</code>; solange der Bildschirm „SSH-Zugang“ auf dem Fernseher geöffnet ist, ebenso <code>/api/remotecontrol</code> und <code>/api/screenshot</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/acces-ssh-ascunde</code>: o parolă nouă; „Am notat parola” (textul parolei se șterge de pe receptor, parola rămâne)"
msgstr "<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/acces-ssh-ascunde</code>: ein neues Passwort; „Passwort notiert“ (der Text des Passworts wird vom Receiver gelöscht, das Passwort bleibt)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-parola</code>: textul parolei, cât timp nu a fost ascunsă; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: fișierele serverului SSH ca text (fără /etc/shadow)"
msgstr "<code>POST /api/acces-ssh-parola</code>: der Text des Passworts, solange er nicht ausgeblendet wurde; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: die Dateien des SSH-Servers als Text (ohne /etc/shadow)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: salvează și aplică pe loc (oricare dintre ele); <code>previzualizare=1&amp;lista=...</code> arată lista pe afișaj fără salvare (cel mult 2 minute fără o cerere nouă), <code>previzualizare=0</code> revine; <code>minutar=0|1..120</code> și <code>cronometru=porneste|opreste|zero</code> pornesc ceasurile afișajului pe loc; <code>functionare=ora|canal|stins</code> merge ca înainte"
msgstr "<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: speichert und wendet sofort an (jedes beliebige davon); <code>previzualizare=1&amp;lista=...</code> zeigt die Liste auf dem Display ohne Speichern (höchstens 2 Minuten ohne neue Anfrage), <code>previzualizare=0</code> kehrt zurück; <code>minutar=0|1..120</code> und <code>cronometru=porneste|opreste|zero</code> starten die Uhren des Displays sofort; <code>functionare=ora|canal|stins</code> funktioniert wie zuvor"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</code>: salvează reglajele unui profil (multipli de 5); cu <code>incearca=1</code> se văd pe loc fără să se salveze, <code>renunta=1</code> pune înapoi ce e salvat; <code>POST /api/calitate-imagine-implicite?profil=&lt;profil&gt;|toate</code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|hdr10|hlg|none</code> (canalul pornește din nou, întrebarea apare pe televizor); <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;&amp;pornit=0|1</code> (jumătate de ecran, 60 s)"
msgstr "<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</code>: speichert die Einstellungen eines Profils (Vielfache von 5); mit <code>incearca=1</code> sind sie sofort zu sehen, ohne gespeichert zu werden, <code>renunta=1</code> stellt wieder her, was gespeichert ist; <code>POST /api/calitate-imagine-implicite?profil=&lt;profil&gt;|toate</code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|hdr10|hlg|none</code> (der Sender startet neu, die Frage erscheint auf dem Fernseher); <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;&amp;pornit=0|1</code> (halber Bildschirm, 60 s)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: pornește canalul prin lista de pe televizor"
msgstr "<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: startet den Sender über die Liste auf dem Fernseher"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: deschide pe televizor un rezultat al căutării, cu rândul găsit ales"
msgstr "<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: öffnet auf dem Fernseher ein Suchergebnis, mit der gefundenen Zeile ausgewählt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza-opreste</code>: oprește citirea și revine la canalul de dinainte"
msgstr "<code>POST /api/cautare-actualizeaza-opreste</code>: stoppt das Lesen und kehrt zum vorherigen Sender zurück"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza-sari</code>: sare peste satelitul pe care e antena acum și trece la următorul (tasta GALBEN de pe televizor)"
msgstr "<code>POST /api/cautare-actualizeaza-sari</code>: überspringt den Satelliten, auf dem die Antenne jetzt steht, und geht zum nächsten (Taste GELB auf dem Fernseher)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: întrebarea (durata, motorul); cu <code>confirmat=1</code> pornește pe televizor citirea pistelor, transponder cu transponder"
msgstr "<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: die Frage (die Dauer, der Motor); mit <code>confirmat=1</code> startet auf dem Fernseher das Lesen der Spuren, Transponder für Transponder"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: citirea pistelor în timpul vizionării (oprită, numai canalul privit, tot transponderul), aceeași setare ca pe televizor"
msgstr "<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: das Lesen der Spuren während des Anschauens (aus, nur der angesehene Sender, der ganze Transponder), dieselbe Einstellung wie auf dem Fernseher"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;&amp;fus=&lt;fus orar&gt;</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>/api/ceas</code>)"
msgstr "<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;&amp;fus=&lt;fus orar&gt;</code>: ändert und speichert beliebige davon (die genauen Werte stehen in <code>/api/ceas</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ceas-sincronizeaza</code>: o sincronizare a orei prin Internet, acum"
msgstr "<code>POST /api/ceas-sincronizeaza</code>: eine Synchronisierung der Uhrzeit über das Internet, jetzt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/copie-setari-pune?copie=&lt;id&gt;</code> (repornește interfața; copia se pune la loc înainte să pornească), <code>POST /api/copie-setari-sterge?copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"
msgstr "<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/copie-setari-pune?copie=&lt;id&gt;</code> (startet die Oberfläche neu; die Kopie wird zurückgespielt, bevor sie startet), <code>POST /api/copie-setari-sterge?copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|invata|sterge&amp;flux=..</code>: actualizează lista, reface buchetele, învață posturile unui flux, șterge un flux adăugat de mână"
msgstr "<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|invata|sterge&amp;flux=..</code>: aktualisiert die Liste, erstellt die Bouquets neu, lernt die Sender eines Streams, löscht einen von Hand hinzugefügten Stream"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;emisfera=E|V&amp;frecventa=..&amp;...</code>: un flux adăugat de mână, cu aceleași câmpuri și limite ca „Adaugă manual”"
msgstr "<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;emisfera=E|V&amp;frecventa=..&amp;...</code>: ein von Hand hinzugefügter Stream, mit denselben Feldern und Grenzen wie „Manuell hinzufügen“"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-seteaza?cheie=tasta|dosar|latime|nedecodabile&amp;valoare=..</code>: setările ferestrei, aceleași ca pe televizor"
msgstr "<code>POST /api/dabt2-seteaza?cheie=tasta|dosar|latime|nedecodabile&amp;valoare=..</code>: die Einstellungen des Fensters, dieselben wie auf dem Fernseher"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-televizor?fel=dab|t2</code>: deschide fereastra pe televizor"
msgstr "<code>POST /api/dabt2-televizor?fel=dab|t2</code>: öffnet das Fenster auf dem Fernseher"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ecran-negru-fapta?fapta=&lt;id&gt;|ascunde</code>: fapta mesajului de acum, pe televizor, sau ascunderea lui"
msgstr "<code>POST /api/ecran-negru-fapta?fapta=&lt;id&gt;|ascunde</code>: die Aktion der aktuellen Meldung, auf dem Fernseher, oder ihr Ausblenden"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ecran-sterge?sursa=galerie|propriu&amp;id=..</code>, <code>POST /api/ecran-la-loc</code>: șterge un ecran de pornire din galerie (nu cel din fabrică și nici cel pus) sau pune la loc ecranele șterse"
msgstr "<code>POST /api/ecran-sterge?sursa=galerie|propriu&amp;id=..</code>, <code>POST /api/ecran-la-loc</code>: löscht einen Startbildschirm aus der Galerie (nicht den werkseitigen und auch nicht den gesetzten) oder stellt die gelöschten Bildschirme wieder her"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/filme-comanda?fa=pauza|redare|inainte|inapoi</code>, <code>?fa=salt&amp;secunde=-60</code>, <code>?fa=la&amp;secunde=N</code>, <code>POST /api/filme-seteaza?pornire=&amp;oprire=&amp;sfarsit=</code>, <code>POST /api/filme-porneste?cale=..&amp;de_la=loc|inceput</code>: aceleași comenzi ca pe telecomandă în player și în lista de filme"
msgstr "<code>POST /api/filme-comanda?fa=pauza|redare|inainte|inapoi</code>, <code>?fa=salt&amp;secunde=-60</code>, <code>?fa=la&amp;secunde=N</code>, <code>POST /api/filme-seteaza?pornire=&amp;oprire=&amp;sfarsit=</code>, <code>POST /api/filme-porneste?cale=..&amp;de_la=loc|inceput</code>: dieselben Befehle wie auf der Fernbedienung im Player und in der Filmliste"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/fonturi-descarca?familie=&lt;Familia&gt;&amp;mare=1</code>: descarcă, verifică și înregistrează un font"
msgstr "<code>POST /api/fonturi-descarca?familie=&lt;Familia&gt;&amp;mare=1</code>: lädt eine Schrift herunter, prüft sie und registriert sie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/fonturi-sterge?alias=&lt;NumeInSkin&gt;</code>: șterge un font descărcat"
msgstr "<code>POST /api/fonturi-sterge?alias=&lt;NumeInSkin&gt;</code>: löscht eine heruntergeladene Schrift"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/gasire-semnal-porneste</code>, <code>-reacordeaza</code>, <code>-opreste</code>: pornește, acordează din nou sau oprește măsurarea"
msgstr "<code>POST /api/gasire-semnal-porneste</code>, <code>-reacordeaza</code>, <code>-opreste</code>: startet die Messung, stimmt sie neu ab oder stoppt sie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ghid-temporizator?ref=&amp;id=&amp;fel=inregistrare|comutare|scoate</code>: pune sau scoate înregistrarea unei emisiuni (409 la suprapunere)"
msgstr "<code>POST /api/ghid-temporizator?ref=&amp;id=&amp;fel=inregistrare|comutare|scoate</code>: setzt oder entfernt die Aufnahme einer Sendung (409 bei Überschneidung)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/import-alta-imagine?raspuns=da|nu|ascunde</code>: răspunsul la întrebarea de la prima pornire (canalele și setările din altă imagine, găsite pe stick sau disc); starea în <code>/api/import-surse</code> (<code>alta_imagine</code>)"
msgstr "<code>POST /api/import-alta-imagine?raspuns=da|nu|ascunde</code>: die Antwort auf die Frage beim ersten Start (die Sender und Einstellungen aus einem anderen Image, gefunden auf Stick oder Festplatte); der Zustand steht in <code>/api/import-surse</code> (<code>alta_imagine</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;temporizatoare=0&amp;generale=0</code>: pornește importul (întâi copia de siguranță)"
msgstr "<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;temporizatoare=0&amp;generale=0</code>: startet den Import (zuerst die Sicherungskopie)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: schimbă limba meniurilor și o salvează, ca OK în ecranul limbii de pe televizor"
msgstr "<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: ändert die Sprache der Menüs und speichert sie, wie OK im Sprachbildschirm auf dem Fernseher"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>/api/limbi</code>; <code>tradu_orice</code> = „Tradu automat din orice subtitrare disponibilă”, contează cu traducerea subtitrărilor pornită) și le aplică pe canalul de acum"
msgstr "<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</code>: ändert und speichert beliebige davon (die genauen Werte stehen in <code>/api/limbi</code>; <code>tradu_orice</code> = „Automatisch aus jedem verfügbaren Untertitel übersetzen“, zählt bei eingeschalteter Untertitelübersetzung) und wendet sie auf den aktuellen Sender an"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /api/limbi-uita-toate?confirmat=1</code>: uită alegerile de mână ale unui canal sau ale tuturor"
msgstr "<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /api/limbi-uita-toate?confirmat=1</code>: vergisst die von Hand gewählten Auswahlen eines Senders oder aller Sender"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-aplica</code>: aplică planul văzut (<code>semn=</code>), verifică semnalul și așteaptă răspunsul 60 de secunde"
msgstr "<code>POST /api/lnb-aplica</code>: wendet den gezeigten Plan an (<code>semn=</code>), prüft das Signal und wartet 60 Sekunden auf die Antwort"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-plan</code>: ce s-ar schimba pentru câmpurile trimise (<code>l_&lt;lnb&gt;_&lt;câmp&gt;</code>), sau pentru „Ce era înainte” cu <code>fel=inainte</code>; nu scrie nimic"
msgstr "<code>POST /api/lnb-plan</code>: was sich für die gesendeten Felder ändern würde (<code>l_&lt;lnb&gt;_&lt;câmp&gt;</code>), oder für „Wie es vorher war“ mit <code>fel=inainte</code>; schreibt nichts"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code>: răspunsul la „Păstrezi noile setări?”"
msgstr "<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code>: die Antwort auf „Neue Einstellungen behalten?“"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</code>: locul antenei aflat după adresa de internet a receptorului, de serverul HD Satelit, numai la cerere și numai din browserul conectat; se scrie abia după confirmare, cu <code>POST /api/locul-seteaza</code> și <code>internet=&lt;semn&gt;</code>"
msgstr "<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</code>: der Standort der Antenne, ermittelt über die Internetadresse des Receivers, vom HD Satelit-Server, nur auf Anfrage und nur aus dem verbundenen Browser; er wird erst nach Bestätigung geschrieben, mit <code>POST /api/locul-seteaza</code> und <code>internet=&lt;semn&gt;</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/locul-seteaza</code>: locul antenei din tabel (<code>tara</code>, <code>oras</code>) sau scris (<code>lat</code>, <code>lon</code>, grade, nord și est pozitive)"
msgstr "<code>POST /api/locul-seteaza</code>: der Standort der Antenne aus der Tabelle (<code>tara</code>, <code>oras</code>) oder geschrieben (<code>lat</code>, <code>lon</code>, Grad, Nord und Ost positiv)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: deschide pe televizor ecranul unei intrări (nu oprirea sau repornirea)"
msgstr "<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: öffnet auf dem Fernseher den Bildschirm eines Eintrags (nicht das Ausschalten oder den Neustart)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code>: pas, mișcare fără oprire, poziții memorate, mergi la satelit, limite, oprire"
msgstr "<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code>: Schritt, Bewegung ohne Halt, gespeicherte Positionen, zum Satelliten fahren, Grenzen, Stopp"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-inchide</code>: navigatorul pe televizor"
msgstr "<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-inchide</code>: der Browser auf dem Fernseher"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/navigator-text</code>: text trimis în câmpul ales pe televizor; numai din browserul asociat, cu textul în corpul cererii (cu <code>?token=</code> se refuză)"
msgstr "<code>POST /api/navigator-text</code>: Text, der in das auf dem Fernseher gewählte Feld gesendet wird; nur aus dem angelernten Browser, mit dem Text im Anfragetext (mit <code>?token=</code> wird er abgelehnt)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: descarcă modelul unei limbi (pe stick sau disc; în memoria internă numai cu intern=1)"
msgstr "<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: lädt das Modell einer Sprache herunter (auf Stick oder Festplatte; im internen Speicher nur mit intern=1)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-intreaba</code>: receptorul întreabă din nou pentru limbile cu \"Nu mai întreba\""
msgstr "<code>POST /api/ocr-limbi-intreaba</code>: der Receiver fragt erneut nach den Sprachen mit „Nicht mehr fragen“"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-opreste?model=slk</code>: oprește descărcarea"
msgstr "<code>POST /api/ocr-limbi-opreste?model=slk</code>: stoppt den Download"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-sterge?model=slk</code>: șterge un model descărcat (sau îl scoate din listă când stickul lui nu e pus)"
msgstr "<code>POST /api/ocr-limbi-sterge?model=slk</code>: löscht ein heruntergeladenes Modell (oder entfernt es aus der Liste, wenn sein Stick nicht steckt)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</code>: repornirea interfeței când nu mai răspunde și așteptarea dinaintea ei"
msgstr "<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</code>: der Neustart der Oberfläche, wenn sie nicht mehr antwortet, und das Warten davor"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/procesor-seteaza?mod=automat|racoros|normal|performanta</code>: salvează modul și îl aplică pe loc"
msgstr "<code>POST /api/procesor-seteaza?mod=automat|racoros|normal|performanta</code>: speichert den Modus und wendet ihn sofort an"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=..&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</code>: setările ecranului radio"
msgstr "<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=..&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</code>: die Einstellungen des Radiobildschirms"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: vizualizarea sau culorile următoare (ca tastele galbenă și albastră pe ecranul radio)"
msgstr "<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: die nächste Visualisierung oder die nächsten Farben (wie die gelbe und die blaue Taste auf dem Radiobildschirm)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-fluxuri</code>: alegerea de la sfârșitul scanării DAB+ / DVB-T2 de pe televizor (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"
msgstr "<code>POST /api/scanare-fluxuri</code>: die Auswahl am Ende des DAB+ / DVB-T2-Suchlaufs auf dem Fernseher (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-opreste</code>: oprește căutarea sau închide rezultatul rămas pe televizor"
msgstr "<code>POST /api/scanare-opreste</code>: stoppt die Suche oder schließt das auf dem Fernseher verbliebene Ergebnis"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;&amp;...</code>: pornește căutarea pe televizor (cu <code>confirmat=1</code> după o întrebare)"
msgstr "<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;&amp;...</code>: startet die Suche auf dem Fernseher (mit <code>confirmat=1</code> nach einer Frage)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: deschide pe televizor ecranul unei intrări din cele două secțiuni"
msgstr "<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: öffnet auf dem Fernseher den Bildschirm eines Eintrags aus den beiden Abschnitten"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/setari-din-copie-reporneste</code>: repornește interfața, ca setările importate să se unească"
msgstr "<code>POST /api/setari-din-copie-reporneste</code>: startet die Oberfläche neu, damit die importierten Einstellungen zusammengeführt werden"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/setari-seteaza?id=&lt;cheie&gt;&amp;r&lt;N&gt;=&lt;valoare&gt;</code>: schimbă și salvează rândurile trimise (o valoare greșită nu schimbă nimic; la o alegere multiplă, ca vitezele de derulare, alegerile despărțite prin virgulă, de pildă <code>r20=2,8,16</code>; gol = nicio alegere)"
msgstr "<code>POST /api/setari-seteaza?id=&lt;cheie&gt;&amp;r&lt;N&gt;=&lt;valoare&gt;</code>: ändert und speichert die gesendeten Zeilen (ein falscher Wert ändert nichts; bei einer Mehrfachauswahl, wie die Spulgeschwindigkeiten, die durch Komma getrennten Auswahlen, zum Beispiel <code>r20=2,8,16</code>; leer = keine Auswahl)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/stocare-foloseste?punct=/media/usb</code>: folosește discul pentru înregistrări (face dosarul movie, fără formatare)"
msgstr "<code>POST /api/stocare-foloseste?punct=/media/usb</code>: verwendet die Festplatte für Aufnahmen (legt den Ordner movie an, ohne Formatierung)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-aspect-implicite</code>: toate înapoi la valorile de la început"
msgstr "<code>POST /api/subtitrari-aspect-implicite</code>: alles zurück auf die Anfangswerte"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-aspect-seteaza?stil_font=&lt;skin|ingust|tiresias_info|tiresias_pc|google:Alias&gt;&amp;grosime=&lt;automata|normala|ingrosata|foarte_ingrosata&gt;&amp;marime=&lt;60..200&gt;&amp;culoare=&lt;emisiune|%23rrggbb&gt;&amp;contur=&lt;fara|subtire|normal|gros|foarte_gros&gt;&amp;culoare_contur=&lt;%23rrggbb&gt;&amp;umbra=0|1&amp;culoare_umbra=&lt;%23rrggbb&gt;&amp;directie_umbra=&lt;sus|sus_dreapta|dreapta|jos_dreapta|jos|jos_stanga|stanga|sus_stanga&gt;&amp;distanta_umbra=&lt;50|100|150|200|300&gt;&amp;umbra_moale=&lt;tare|moale|foarte_moale&gt;&amp;fundal=&lt;niciunul|rand|cutie&gt;&amp;culoare_fundal=&lt;%23rrggbb&gt;&amp;opacitate_fundal=&lt;10..100&gt;&amp;jos=&lt;2..25&gt;&amp;spatiere=&lt;80|90|100|110|125|150&gt;&amp;marire_dvb=&lt;clara|ocr&gt;</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>alegeri</code>; o valoare greșită nu schimbă nimic); sau <code>stil=&lt;cheie&gt;</code>, un stil gata făcut"
msgstr "<code>POST /api/subtitrari-aspect-seteaza?stil_font=&lt;skin|ingust|tiresias_info|tiresias_pc|google:Alias&gt;&amp;grosime=&lt;automata|normala|ingrosata|foarte_ingrosata&gt;&amp;marime=&lt;60..200&gt;&amp;culoare=&lt;emisiune|%23rrggbb&gt;&amp;contur=&lt;fara|subtire|normal|gros|foarte_gros&gt;&amp;culoare_contur=&lt;%23rrggbb&gt;&amp;umbra=0|1&amp;culoare_umbra=&lt;%23rrggbb&gt;&amp;directie_umbra=&lt;sus|sus_dreapta|dreapta|jos_dreapta|jos|jos_stanga|stanga|sus_stanga&gt;&amp;distanta_umbra=&lt;50|100|150|200|300&gt;&amp;umbra_moale=&lt;tare|moale|foarte_moale&gt;&amp;fundal=&lt;niciunul|rand|cutie&gt;&amp;culoare_fundal=&lt;%23rrggbb&gt;&amp;opacitate_fundal=&lt;10..100&gt;&amp;jos=&lt;2..25&gt;&amp;spatiere=&lt;80|90|100|110|125|150&gt;&amp;marire_dvb=&lt;clara|ocr&gt;</code>: ändert und speichert beliebige davon (die genauen Werte stehen in <code>alegeri</code>; ein falscher Wert ändert nichts); oder <code>stil=&lt;cheie&gt;</code>, ein fertiger Stil"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-film-alege?id=&lt;id&gt;|oprit</code>, <code>POST /api/subtitrari-film-intarziere?ms=N</code> (sau <code>pas=</code>), <code>POST /api/subtitrari-film-codare?cod=..</code>, <code>POST /api/subtitrari-film-fps?fps=..</code>: aceleași alegeri ca tasta SUB la un film din fișier"
msgstr "<code>POST /api/subtitrari-film-alege?id=&lt;id&gt;|oprit</code>, <code>POST /api/subtitrari-film-intarziere?ms=N</code> (oder <code>pas=</code>), <code>POST /api/subtitrari-film-codare?cod=..</code>, <code>POST /api/subtitrari-film-fps?fps=..</code>: dieselben Auswahlen wie die Taste SUB bei einem Film aus einer Datei"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-ocr-zero</code>: contorul recunoașterii textului pus la zero"
msgstr "<code>POST /api/subtitrari-ocr-zero</code>: der Zähler der Texterkennung auf null gesetzt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/sunet-seteaza?iesire=&lt;auto|manual&gt;&amp;ac3=&lt;da|nu&gt;&amp;dts=&lt;da|nu&gt;&amp;pista=&lt;da|nu&gt;</code>: oricare dintre ele, salvate; ac3 / dts sunt setările pentru Manual"
msgstr "<code>POST /api/sunet-seteaza?iesire=&lt;auto|manual&gt;&amp;ac3=&lt;da|nu&gt;&amp;dts=&lt;da|nu&gt;&amp;pista=&lt;da|nu&gt;</code>: beliebige davon, gespeichert; ac3 / dts sind die Einstellungen für Manuell"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-asociere?pas=inapoi|sari|gata|continua|anuleaza|proba|inchide&amp;pastreaza=0|1</code>: pașii asocierii unei telecomenzi noi"
msgstr "<code>POST /api/telecomenzi-asociere?pas=inapoi|sari|gata|continua|anuleaza|proba|inchide&amp;pastreaza=0|1</code>: die Schritte beim Anlernen einer neuen Fernbedienung"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|oprit</code>: pornește sau oprește captura paginii (cititorul și proba numai ascultă, cel mult 2 minute)"
msgstr "<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|oprit</code>: startet oder stoppt die Erfassung der Seite (der Leser und der Test hören nur zu, höchstens 2 Minuten)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-schimba?actiune=activa|neasociate|redenumeste|sterge-tasta|sterge|sterge-tot&amp;id=..&amp;cod=..&amp;nume=..&amp;confirmat=1</code>: aceleași schimbări ca în lista de pe televizor"
msgstr "<code>POST /api/telecomenzi-schimba?actiune=activa|neasociate|redenumeste|sterge-tasta|sterge|sterge-tot&amp;id=..&amp;cod=..&amp;nume=..&amp;confirmat=1</code>: dieselben Änderungen wie in der Liste auf dem Fernseher"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/teletext-salveaza</code>, <code>POST /api/teletext-sterge?ref=</code>, <code>POST /api/teletext-reimprospateaza?ref=</code> (receptorul trece pe canal, așteaptă o trecere completă a teletextului, face copia și se întoarce la canalul de dinainte; răspunde pe loc), <code>POST /api/teletext-setari?hd=0|1&amp;contur=0|1&amp;umbra=0|1&amp;relief=0|1&amp;copie_automata=0|1&amp;spatiu=5|10|20|50|100</code> (<code>hd</code> = Teletext neted): aceleași alegeri ca meniul teletextului de pe televizor"
msgstr "<code>POST /api/teletext-salveaza</code>, <code>POST /api/teletext-sterge?ref=</code>, <code>POST /api/teletext-reimprospateaza?ref=</code> (der Receiver wechselt auf den Sender, wartet auf einen vollständigen Durchlauf des Videotexts, erstellt die Kopie und kehrt zum vorherigen Sender zurück; antwortet sofort), <code>POST /api/teletext-setari?hd=0|1&amp;contur=0|1&amp;umbra=0|1&amp;relief=0|1&amp;copie_automata=0|1&amp;spatiu=5|10|20|50|100</code> (<code>hd</code> = Geglätteter Videotext): dieselben Auswahlen wie das Videotext-Menü auf dem Fernseher"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-adauga?ref=&lt;canal&gt;&amp;zi=AAAA-LL-ZZ&amp;inceput=HH:MM&amp;sfarsit=HH:MM&amp;nume=..&amp;doar_comuta=0|1</code>: pune o înregistrare (sau doar schimbarea canalului); la suprapunere nu pune nimic și spune cu ce se suprapune"
msgstr "<code>POST /api/temporizatoare-adauga?ref=&lt;canal&gt;&amp;zi=AAAA-LL-ZZ&amp;inceput=HH:MM&amp;sfarsit=HH:MM&amp;nume=..&amp;doar_comuta=0|1</code>: setzt eine Aufnahme (oder nur den Senderwechsel); bei Überschneidung setzt es nichts und sagt, womit sie sich überschneidet"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-modifica?id=..&amp;zi=..&amp;inceput=..&amp;sfarsit=..&amp;repetare=o_data|zilnic|luni_vineri|zile&amp;zile=0,1,..&amp;dupa=nimic|asteptare|oprire|automat&amp;loc=..</code>: aceleași câmpuri ca fereastra de pe televizor, cu aceeași verificare a suprapunerii; <code>POST /api/temporizatoare-opreste?id=..&amp;alegere=stoponlycurrent|stopall|stoponlycoming</code>: una repetată care merge acum"
msgstr "<code>POST /api/temporizatoare-modifica?id=..&amp;zi=..&amp;inceput=..&amp;sfarsit=..&amp;repetare=o_data|zilnic|luni_vineri|zile&amp;zile=0,1,..&amp;dupa=nimic|asteptare|oprire|automat&amp;loc=..</code>: dieselben Felder wie das Fenster auf dem Fernseher, mit derselben Prüfung auf Überschneidung; <code>POST /api/temporizatoare-opreste?id=..&amp;alegere=stoponlycurrent|stopall|stoponlycoming</code>: eine wiederholte, die gerade läuft"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, <code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, <code>POST /api/temporizatoare-curata?confirmat=1</code>: șterge una, o oprește sau o pornește din nou, șterge cele terminate"
msgstr "<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, <code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, <code>POST /api/temporizatoare-curata?confirmat=1</code>: löscht eine, hält sie an oder startet sie wieder, löscht die beendeten"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-cauta</code>: caută în rețeaua de acasă serverele Ollama (11434) și LibreTranslate (5000); rezultatul vine în <code>cautare</code>"
msgstr "<code>POST /api/traducere-configurare-cauta</code>: sucht im Heimnetzwerk die Server Ollama (11434) und LibreTranslate (5000); das Ergebnis kommt in <code>cautare</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-cheie</code>, corpul <code>cheie=&lt;cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: probează cheia pe loc și, dacă merge, o salvează și pornește traducerea; numai în corpul cererii, niciodată în adresă; rezultatul vine în <code>configurare</code> din <code>GET /api/traducere-configurare</code>"
msgstr "<code>POST /api/traducere-configurare-cheie</code>, Anfragetext <code>cheie=&lt;cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: testet den Schlüssel sofort und, wenn er funktioniert, speichert ihn und startet die Übersetzung; nur im Anfragetext, niemals in der Adresse; das Ergebnis kommt in <code>configurare</code> aus <code>GET /api/traducere-configurare</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-model?model=..</code>: alt model pentru serviciul ales acum, cu probă"
msgstr "<code>POST /api/traducere-configurare-model?model=..</code>: ein anderes Modell für den jetzt gewählten Dienst, mit Test"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;&amp;adresa=..&amp;model=..</code>: folosește serverul din casă (adresa completată de receptor, modelul ales singur dacă lipsește) și îl probează"
msgstr "<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;&amp;adresa=..&amp;model=..</code>: verwendet den Server im Haus (die Adresse vom Receiver ausgefüllt, das Modell von selbst gewählt, wenn es fehlt) und testet ihn"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-cheie</code>, corpul <code>serviciu=&lt;cod&gt;&amp;cheie=&lt;cheia&gt;</code>: pune cheia unui serviciu (goală = o șterge); la <code>serviciu=propriu</code> cheia este valoarea antetului adresei proprii (de exemplu <code>Bearer</code> și cheia); numai în corpul cererii, niciodată în adresă; răspunsul spune doar care serviciu are cheie"
msgstr "<code>POST /api/traducere-subtitrari-cheie</code>, Anfragetext <code>serviciu=&lt;cod&gt;&amp;cheie=&lt;cheia&gt;</code>: setzt den Schlüssel eines Dienstes (leer = löscht ihn); bei <code>serviciu=propriu</code> ist der Schlüssel der Wert des Headers der eigenen Adresse (zum Beispiel <code>Bearer</code> und der Schlüssel); nur im Anfragetext, niemals in der Adresse; die Antwort sagt nur, welcher Dienst einen Schlüssel hat"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-proba</code>: probează traducerea cu serviciul ales; rezultatul vine în <code>stare.proba</code> din <code>GET /api/traducere-subtitrari</code>"
msgstr "<code>POST /api/traducere-subtitrari-proba</code>: testet die Übersetzung mit dem gewählten Dienst; das Ergebnis kommt in <code>stare.proba</code> aus <code>GET /api/traducere-subtitrari</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=..&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;propriu_cale=..</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>alegeri</code>); o valoare greșită refuză tot. Adresa proprie: adresa e un șablon cu <code>{text}</code>, <code>{sursa}</code>, <code>{tinta}</code> (http:// numai pentru un server din rețeaua de acasă); adresa receptorului însuși (127.0.0.1, localhost, IP-ul lui) e refuzată, și la <code>adresa_libre</code> și <code>adresa_openai</code>; calea în JSON are chei și numere despărțite prin punct, <code>*</code> = toate elementele"
msgstr "<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=..&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;propriu_cale=..</code>: ändert und speichert beliebige davon (die genauen Werte stehen in <code>alegeri</code>); ein falscher Wert lehnt alles ab. Eigene Adresse: die Adresse ist eine Vorlage mit <code>{text}</code>, <code>{sursa}</code>, <code>{tinta}</code> (http:// nur für einen Server im Heimnetzwerk); die Adresse des Receivers selbst (127.0.0.1, localhost, seine IP) wird abgelehnt, auch bei <code>adresa_libre</code> und <code>adresa_openai</code>; der Pfad im JSON hat Schlüssel und Zahlen, durch Punkte getrennt, <code>*</code> = alle Elemente"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-zero</code>: contorul traducerii pus la zero"
msgstr "<code>POST /api/traducere-subtitrari-zero</code>: der Zähler der Übersetzung auf null gesetzt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: fluxul TS al transmisiei acestui browser. Pornirea și fluxul merg numai din browserul conectat, cu antetul <code>X-HDS-CSRF</code>, niciodată cu <code>?token=</code>"
msgstr "<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: der TS-Stream der Übertragung dieses Browsers. Start und Stream gehen nur aus dem verbundenen Browser, mit dem Header <code>X-HDS-CSRF</code>, niemals mit <code>?token=</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-confirma</code> și <code>POST /api/video-revino</code>: păstrează modul încercat sau revine la cel de dinainte"
msgstr "<code>POST /api/video-confirma</code> und <code>POST /api/video-revino</code>: behält den versuchten Modus oder kehrt zum vorherigen zurück"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-reporneste</code>: repornește receptorul (culorile „Ca la calculator” se aplică numai după o repornire); cu o înregistrare în curs, întrebarea apare pe televizor"
msgstr "<code>POST /api/video-reporneste</code>: startet den Receiver neu (die Farben „Wie beim Computer“ gelten erst nach einem Neustart); bei einer laufenden Aufnahme erscheint die Frage auf dem Fernseher"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=..&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;ycbcr|rgb&gt;</code>: un mod nou se încearcă (aceeași întrebare pe televizor, 20 s, fără răspuns revine); zapmode se salvează direct; culori_hdmi=ycbcr se încearcă la fel (aceeași întrebare), rgb se salvează și se aplică după o repornire"
msgstr "<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=..&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;ycbcr|rgb&gt;</code>: ein neuer Modus wird ausprobiert (dieselbe Frage auf dem Fernseher, 20 s, ohne Antwort kehrt er zurück); zapmode wird direkt gespeichert; culori_hdmi=ycbcr wird genauso ausprobiert (dieselbe Frage), rgb wird gespeichert und nach einem Neustart angewendet"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<p class=\"gol\">Niciun font descărcat încă.</p>"
msgstr "<p class=\"gol\">Noch keine Schrift heruntergeladen.</p>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<p class=\"gol\">Nimic găsit.</p>"
msgstr "<p class=\"gol\">Nichts gefunden.</p>"

