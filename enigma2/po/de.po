#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Fă o parolă nouă"
msgstr "Neues Passwort erstellen"

#: lib/python/Screens/HdsAccesSsh.py
msgid "Receptorul face o parolă la întâmplare și o arată aici. Cea veche nu mai merge."
msgstr "Der Receiver erstellt ein zufälliges Passwort und zeigt es hier an. Das alte gilt dann nicht mehr."

#: lib/python/Screens/HdsAccesSsh.py
#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Fă o parolă"
msgstr "Passwort erstellen"

#: lib/python/Screens/HdsAccesSsh.py
msgid "Receptorul face o parolă la întâmplare și o arată aici."
msgstr "Der Receiver erstellt ein zufälliges Passwort und zeigt es hier an."

#: lib/python/Screens/HdsAccesSsh.py
msgid "Fără parolă în rețeaua locală: pornit"
msgstr "Ohne Passwort im lokalen Netz: an"

#: lib/python/Screens/HdsAccesSsh.py
msgid "OK oprește. Oricine din rețeaua ta de acasă intră acum pe receptor fără parolă."
msgstr "OK schaltet aus. Jeder in deinem Heimnetz meldet sich jetzt ohne Passwort am Receiver an."

#: lib/python/Screens/HdsAccesSsh.py
msgid "Fără parolă în rețeaua locală: oprit"
msgstr "Ohne Passwort im lokalen Netz: aus"

#: lib/python/Screens/HdsAccesSsh.py
#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Rămâne oprit dacă nu ai un motiv anume. Pornit, oricine din rețeaua ta de acasă intră pe receptor fără parolă."
msgstr "Bleibt aus, wenn du keinen bestimmten Grund hast. Eingeschaltet meldet sich jeder in deinem Heimnetz ohne Passwort am Receiver an."

#: lib/python/Screens/HdsAccesSsh.py
msgid "Așteaptă să se termine ce ai pornit înainte."
msgstr "Warte, bis der vorherige Vorgang abgeschlossen ist."

#: lib/python/Screens/HdsAccesSsh.py
#, python-format
msgid "Șterge cheia: %s"
msgstr "Löschen: %s"

#: lib/python/Screens/HdsAccesSsh.py
msgid "OK șterge cheia. Calculatorul cu această cheie intră apoi numai cu parola."
msgstr "OK löscht den Schlüssel. Der Computer mit diesem Schlüssel meldet sich danach nur mit dem Passwort an."

#: lib/python/Screens/HdsAccesSsh.py
#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Faci o parolă nouă? Cea de acum nu mai merge."
msgstr "Ein neues Passwort erstellen? Das jetzige gilt dann nicht mehr."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Așteaptă să se termine ce ai pornit înainte (pe televizor sau aici)."
msgstr "Warte, bis der vorherige Vorgang abgeschlossen ist (am Fernseher oder hier)."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Confirmă parola nouă: cea de acum nu mai merge după aceea."
msgstr "Bestätige das neue Passwort: das jetzige gilt danach nicht mehr."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Lipsește amprenta cheii."
msgstr "Der Fingerabdruck des Schlüssels fehlt."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Confirmă ștergerea cheii."
msgstr "Bestätige das Löschen des Schlüssels."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Alege pornit sau oprit."
msgstr "Wähle an oder aus."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Confirmă: oricine din rețeaua ta de acasă va intra pe receptor fără parolă."
msgstr "Bestätige: Jeder in deinem Heimnetz meldet sich dann ohne Passwort am Receiver an."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Parola nu se mai arată. Dacă ai uitat-o, fă una nouă."
msgstr "Das Passwort wird nicht mehr angezeigt. Wenn du es vergessen hast, erstelle ein neues."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Parola și cheile se văd și se schimbă numai dintr-un browser conectat cu codul de pe televizor."
msgstr "Passwort und Schlüssel sind nur in einem Browser sichtbar und änderbar, der mit dem Code vom Fernseher verbunden ist."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "(cu opțiuni)"
msgstr "(mit Optionen)"

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
#, python-format
msgid "Aceleași lucruri sunt pe televizor, în %s."
msgstr "Dasselbe findest du auf dem Fernseher unter %s."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Adaugă cheia"
msgstr "Schlüssel hinzufügen"

#: lib/python/Components/HdsAccesSsh.py
msgid "Adresa receptorului în rețea nu e cunoscută."
msgstr "Die Netzwerkadresse des Receivers ist nicht bekannt."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Ai lipit o cheie privată. Nu a plecat din pagină. Pune cheia publică (fișierul .pub); cheia privată rămâne numai la tine."
msgstr "Du hast einen privaten Schlüssel eingefügt. Er hat die Seite nicht verlassen. Füge den öffentlichen Schlüssel ein (die .pub-Datei); der private Schlüssel bleibt nur bei dir."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Ai notat parola? După aceea nu se mai arată nici aici, nici pe televizor."
msgstr "Passwort notiert? Danach erscheint es weder hier noch auf dem Fernseher."

#: lib/python/Screens/HdsAccesSsh.py
msgid "Ai notat parola? După aceea nu se mai arată nici aici, nici în interfața web."
msgstr "Passwort notiert? Danach erscheint es weder hier noch in der Weboberfläche."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Arată codul pe televizor"
msgstr "Code auf dem Fernseher anzeigen"

#: lib/python/Components/HdsAccesSsh.py
msgid "Atenție: root nu are parolă și oricine din rețea intră pe receptor."
msgstr "Achtung: root hat kein Passwort, und jeder im Netz kommt auf den Receiver."

#: lib/python/Components/HdsAccesSsh.py
msgid "Atenție: serverul SSH e pornit cu -B și primește conturi fără parolă."
msgstr "Achtung: Der SSH-Server läuft mit -B und lässt Konten ohne Passwort zu."

#: lib/python/Components/HdsAccesSsh.py
msgid "Atenție: „Fără parolă în rețeaua locală” e pornit. Oricine din rețeaua ta de acasă intră pe receptor."
msgstr "Achtung: „Ohne Passwort im lokalen Netz“ ist an. Jeder in deinem Heimnetz kommt auf den Receiver."

#: lib/python/Components/HdsAccesSsh.py
#, python-format
msgid "Cheia RSA are %d de biți. Receptorul primește numai chei RSA de cel puțin %d de biți."
msgstr "Der RSA-Schlüssel hat %d Bit. Der Receiver nimmt nur RSA-Schlüssel mit mindestens %d Bit an."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Codul are 6 cifre."
msgstr "Der Code hat 6 Ziffern."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Codul de pe televizor"
msgstr "Code vom Fernseher"

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Codul e pe televizor."
msgstr "Der Code ist auf dem Fernseher."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Codul nu a mers."
msgstr "Der Code hat nicht funktioniert."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Codul nu s-a putut cere."
msgstr "Der Code konnte nicht angefordert werden."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Conectat."
msgstr "Verbunden."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Conectează"
msgstr "Verbinden"

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Conectează browserul cu codul"
msgstr "Browser mit dem Code verbinden"

#: lib/python/Components/HdsAccesSsh.py
msgid "Contul root nu are parolă, deci nu se intră cu parolă, numai cu o cheie. Alege „Fă o parolă”."
msgstr "Das Konto root hat kein Passwort, also keine Anmeldung mit Passwort, nur mit Schlüssel. Wähle „Passwort erstellen“."

#: lib/python/Components/HdsAccesSsh.py
msgid "Contul root nu are parolă. Alege „Fă o parolă”."
msgstr "Das Konto root hat kein Passwort. Wähle „Passwort erstellen“."

#: lib/python/Components/HdsAccesSsh.py
msgid "Contul root nu are parolă: se intră numai cu o cheie. Dacă vrei și parolă, alege „Fă o parolă”."
msgstr "Das Konto root hat kein Passwort: Anmeldung nur mit Schlüssel. Für ein Passwort wähle „Passwort erstellen“."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Cu cheia pentru scripturi pagina arată numai starea. Parola și cheile se văd și se schimbă numai dintr-un browser conectat cu codul de pe televizor."
msgstr "Mit dem Schlüssel für Skripte zeigt die Seite nur den Zustand. Passwort und Schlüssel sind nur in einem Browser sichtbar und änderbar, der mit dem Code vom Fernseher verbunden ist."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Cu o cheie SSH pusă mai jos, calculatorul intră fără parolă. Fișierele se copiază cu SFTP (de exemplu WinSCP sau FileZilla), cu aceleași date."
msgstr "Mit einem unten hinzugefügten SSH-Schlüssel meldet sich der Computer ohne Passwort an. Dateien kopierst du per SFTP (zum Beispiel WinSCP oder FileZilla) mit denselben Daten."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Cum te conectezi"
msgstr "So verbindest du dich"

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Cât ecranul „Acces SSH” e deschis pe televizor, telecomanda și captura de ecran merg numai dintr-un browser conectat cu codul de pe televizor."
msgstr "Solange auf dem Fernseher „SSH-Zugang“ geöffnet ist, funktionieren Fernbedienung und Bildschirmfoto nur aus einem Browser, der mit dem Code vom Fernseher verbunden ist."

#: lib/python/Components/HdsAccesSsh.py
msgid "Dacă ai uitat parola, alege „Fă o parolă nouă”."
msgstr "Wenn du das Passwort vergessen hast, wähle „Neues Passwort erstellen“."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "De pe calculator, în terminal:"
msgstr "Vom Computer, im Terminal:"

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "De pe stick: pune dosarul hdsatelit/ssh cu fișierul authorized_keys sau cu cheile .pub, bagă stickul în receptor, apoi apasă butonul. Nu pune niciodată cheia privată (fișierul fără .pub)."
msgstr "Vom USB-Stick: Lege den Ordner hdsatelit/ssh mit der Datei authorized_keys oder den .pub-Schlüsseln an, stecke den Stick in den Receiver und drücke dann die Schaltfläche. Lege niemals den privaten Schlüssel ab (die Datei ohne .pub)."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Fișierul"
msgstr "Datei"

#: lib/python/Components/HdsAccesSsh.py
msgid "Fișierul cheilor de pe receptor e prea mare (peste 1 MB). Scoate prin SSH cheile vechi din el."
msgstr "Die Schlüsseldatei auf dem Receiver ist zu groß (über 1 MB). Entferne per SSH die alten Schlüssel daraus."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Fără parolă în rețeaua locală"
msgstr "Ohne Passwort im lokalen Netz"

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Lipește cheia publică (conținutul fișierului .pub, de exemplu id_ed25519.pub):"
msgstr "Füge den öffentlichen Schlüssel ein (Inhalt der .pub-Datei, zum Beispiel id_ed25519.pub):"

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Lipește întâi cheia publică."
msgstr "Füge zuerst den öffentlichen Schlüssel ein."

#: lib/python/Components/HdsAccesSsh.py
msgid "Nu s-a putut face"
msgstr "Fehlgeschlagen"

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Numai starea"
msgstr "Nur der Zustand"

#: lib/python/Screens/HdsAccesSsh.py
msgid "OK arată fișierele de setări ale serverului SSH, așa cum sunt pe receptor."
msgstr "OK zeigt die Einstellungsdateien des SSH-Servers so, wie sie auf dem Receiver sind."

#: lib/python/Screens/HdsAccesSsh.py
#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Parola de administrator (root)"
msgstr "Administratorpasswort (root)"

#: lib/python/Components/HdsAccesSsh.py
msgid "Parola nu s-a putut face. Alege „Fă o parolă”. Până atunci se intră numai cu o cheie."
msgstr "Das Passwort konnte nicht erstellt werden. Wähle „Passwort erstellen“. Bis dahin Anmeldung nur mit einem Schlüssel."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Parola se vede numai dintr-un browser conectat cu codul de pe televizor."
msgstr "Das Passwort ist nur in einem Browser sichtbar, der mit dem Code vom Fernseher verbunden ist."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Parola și cheile se văd și se schimbă numai dintr-un browser conectat cu codul de pe televizor. Așa, cine e doar în rețeaua ta de acasă nu le poate afla."
msgstr "Passwort und Schlüssel sind nur in einem Browser sichtbar und änderbar, der mit dem Code vom Fernseher verbunden ist. So kann sie niemand erfahren, der nur in deinem Heimnetz ist."

