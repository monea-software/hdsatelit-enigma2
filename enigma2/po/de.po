msgstr "Eigene Einstellung"

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Egalizatorul nu a putut porni la acest post (%s). Sunetul merge prin placa de sunet."
msgstr "Der Equalizer konnte bei diesem Sender nicht starten (%s). Der Ton läuft über den Soundchip."

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Se aude cu egalizator: %s."
msgstr "Mit Equalizer zu hören: %s."

#: lib/python/Components/HdsEgalizator.py
