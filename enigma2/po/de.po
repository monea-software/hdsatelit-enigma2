#: lib/python/Components/HdsProcesor.py lib/python/Plugins/Extensions/HdsWebControl/procesor_web.py
#, python-format
msgid "Istoricul începe acum %s."
msgstr "Der Verlauf beginnt vor %s."

#: lib/python/Components/HdsProcesor.py
msgid "Procesorul lucrează cât l-a reglat fabricantul. Recomandat dacă nu știi ce să alegi."
msgstr "Der Prozessor arbeitet so, wie ihn der Hersteller eingestellt hat. Empfohlen, wenn du nicht weißt, was du wählen sollst."

#: lib/python/Components/HdsProcesor.py
#, python-format
msgid "Receptorul se răcește (%d °C). Procesorul revine la viteza obișnuită după %s."
msgstr "Der Receiver kühlt ab (%d °C). Der Prozessor kehrt nach %s zur üblichen Geschwindigkeit zurück."

#: lib/python/Components/HdsProcesor.py
#, python-format
msgid "Receptorul se răcește. Procesorul revine la viteza obișnuită după %s."
msgstr "Der Receiver kühlt ab. Der Prozessor kehrt nach %s zur üblichen Geschwindigkeit zurück."

#: lib/python/Components/HdsProcesor.py
msgid "Imaginea și sunetul nu sunt afectate."
msgstr "Bild und Ton sind nicht betroffen."

#: lib/python/Components/HdsProcesor.py lib/python/Plugins/Extensions/HdsWebControl/procesor_web.py
#, python-format
msgid "Modul %s (%d MHz) apare după ce receptorul trece proba de căldură."
msgstr "Der Modus %s (%d MHz) erscheint, wenn der Receiver die Hitzeprobe bestanden hat."

#: lib/python/Components/HdsProcesor.py
#, python-format
msgid "cel mult %d MHz (%s, s-a încălzit)"
msgstr "höchstens %d MHz (%s, warm geworden)"

#: lib/python/Components/HdsProcesor.py
msgid "Alege cu stânga, dreapta sau OK cât timp arată graficul."
msgstr "Wähle mit links, rechts oder OK, welchen Zeitraum das Diagramm zeigt."

#: lib/python/Components/HdsProcesor.py lib/python/Plugins/Extensions/HdsWebControl/procesor_web.py
msgid "Istoricul se ține numai în memorie și începe din nou când repornește receptorul."
msgstr "Der Verlauf liegt nur im Speicher und beginnt neu, wenn der Receiver neu startet."

#: lib/python/Components/HdsProcesor.py lib/python/Plugins/Extensions/HdsWebControl/procesor_web.py
#, python-format
msgid "Linia colorată: temperatura cea mai mare din fiecare minut, galbenă de la %d °C, roșie de la %d °C. Barele de jos: viteza procesorului, galbene când a încetinit de căldură. Liniile drepte: unde încetinește procesorul (întreruptă: unde revine)."
msgstr "Farbige Linie: höchste Temperatur jeder Minute, gelb ab %d °C, rot ab %d °C. Balken unten: Tempo des Prozessors, gelb, wenn er wegen Hitze gebremst wurde. Gerade Linien: wo der Prozessor langsamer wird (gestrichelt: wo er zurückkehrt)."

#: lib/python/Components/HdsProcesor.py
#, python-format
msgid "cel mult %d MHz"
msgstr "höchstens %d MHz"

