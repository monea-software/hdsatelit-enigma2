msgstr "HDMI-Farben"

#: lib/python/Screens/VideoSetup.py
msgid "Imaginea se vede corect?"
msgstr "Wird das Bild richtig angezeigt?"

#: lib/python/Screens/VideoSetup.py
#: lib/python/Plugins/Extensions/HdsWebControl/video_web.py
#, python-format
msgid "Fără răspuns, în %d s setarea nu se păstrează."
msgstr "Ohne Antwort in %d s nicht behalten."

#: lib/python/Screens/VideoSetup.py
msgid "„Ca la calculator” revine la următoarea pornire a receptorului."
msgstr "„Wie beim Computer“ kommt beim nächsten Start des Receivers zurück."

#: lib/python/Screens/VideoSetup.py
#: lib/python/Plugins/Extensions/HdsWebControl/video_web.py
msgid "„Ca la calculator” revine numai după o repornire. Repornești receptorul acum?"
msgstr "„Wie beim Computer“ kommt erst nach einem Neustart zurück. Receiver jetzt neu starten?"

#: lib/python/Screens/VideoSetup.py
#: lib/python/Plugins/Extensions/HdsWebControl/video_web.py
msgid "„Ca la calculator” se aplică numai după o repornire. Repornești receptorul acum?"
msgstr "„Wie beim Computer“ gilt erst nach einem Neustart. Receiver jetzt neu starten?"

#: lib/python/Screens/VideoSetup.py
#: lib/python/Plugins/Extensions/HdsWebControl/video_web.py
