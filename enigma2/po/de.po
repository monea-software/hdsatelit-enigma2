msgstr "Etikett im Speicher des Receivers (der Name darin ist kein Beweis)"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Versiunea plăcii spusă de driver (aceeași pe toate plăcile u57)"
msgstr "Platinenversion laut Treiber (auf allen u57-Platinen gleich)"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Arborele dispozitivului"
msgstr "Gerätebaum"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Tunere"
msgstr "Tuner"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Paza de model"
msgstr "Modellschutz"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
#, python-format
msgid "Receptorul nu a putut citi starea: %s"
msgstr "Der Receiver konnte den Zustand nicht lesen: %s"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Cerut de software"
msgstr "Von der Software verlangt"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Citit pe receptor"
msgstr "Am Receiver gelesen"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Ce se verifică"
msgstr "Was geprüft wird"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Nu se verifică nimic aici."
msgstr "Hier wird nichts geprüft."

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Amprenta receptorului"
msgstr "Fingerabdruck des Receivers"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Amprenta se citește din procesor, din antetul de fabrică al partiției deviceinfo, din tabela partițiilor dată la pornire și din tipul plăcii (spus de driver și scris în eticheta receptorului). Numele modelului din etichetă nu intră în verificare."
msgstr "Der Fingerabdruck wird aus dem Prozessor, dem Werkskopf der Partition deviceinfo, der beim Start übergebenen Partitionstabelle und dem Platinentyp (laut Treiber und im Etikett des Receivers) gelesen. Der Modellname im Etikett wird nicht geprüft."

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Numai informativ"
msgstr "Nur zur Information"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Pe televizor: pe alt receptor, mesajul de mai sus apare singur, în locul interfeței."
msgstr "Auf dem Fernseher: Auf einem anderen Receiver erscheint die Meldung oben von selbst, anstelle der Oberfläche."

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Citit acum, după pornire:"
msgstr "Jetzt gelesen, nach dem Start:"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizare_web.py
msgid "Se caută pachetele pe stick și pe disc..."
msgstr "Pakete werden auf dem USB-Stick und der Festplatte gesucht..."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizare_web.py
msgid "Receptorul nu răspunde. Verifică dacă este pornit și în aceeași rețea."
msgstr "Der Receiver antwortet nicht. Prüfe, ob er eingeschaltet und im selben Netzwerk ist."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizare_web.py
msgid "Receptorul nu a putut citi pachetele."
msgstr "Der Receiver konnte die Pakete nicht lesen."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizare_web.py
#, python-format
msgid "Pachete găsite: %d."
msgstr "Gefundene Pakete: %d."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizare_web.py
#, python-format
msgid "Software-ul de acum este pentru %s."
msgstr "Die aktuelle Software ist für %s bestimmt."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizare_web.py
msgid "Aici se vede numai ce este pe stick și dacă se poate scrie. Scrierea se face pe televizor, cu simularea și două întrebări înainte:"
msgstr "Hier siehst du nur, was auf dem USB-Stick ist und ob es sich schreiben lässt. Geschrieben wird am Fernseher, mit Simulation und zwei Fragen vorher:"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizare_web.py
msgid "Un pachet se scrie numai dacă are semnul receptorului, semnul este pentru acest receptor și fișierele lui sunt întregi (sumele se verifică pe televizor, la OK)."
msgstr "Ein Paket wird nur geschrieben, wenn es das Receiver-Kennzeichen hat, das Kennzeichen für diesen Receiver gilt und seine Dateien vollständig sind (die Prüfsummen werden am Fernseher nach OK geprüft)."

#: lib/python/Components/VideoOutput.py
msgid "Ca la televizor (YCbCr)"
msgstr "Wie beim Fernseher (YCbCr)"

#: lib/python/Components/VideoOutput.py
msgid "Ca la calculator (RGB)"
msgstr "Wie beim Computer (RGB)"

#: lib/python/Components/VideoOutput.py
