msgstr "fehlt (wird nicht geprüft)"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "nu s-a putut citi"
msgstr "nicht lesbar"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
