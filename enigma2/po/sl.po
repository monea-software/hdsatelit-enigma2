msgstr "Po meri (Custom)"

#, python-format
msgid ""
"Peste %d minute pornește o înregistrare. Comenzile se opresc atunci singure."
msgstr "Čez %d min se začne snemanje. Ukazi se takrat ustavijo sami."

msgid ""
"Peste această frecvență, receptorul folosește oscilatorul de sus și pornește "
"tonul de 22 kHz."
msgstr ""
"Nad to frekvenco sprejemnik uporabi zgornji oscilator in vklopi ton 22 kHz."

msgid ""
"Peste cotă se plătește automat (20 de dolari pe milion de caractere), dacă "
"nu ai coborât cota pe zi. Cu cota coborâtă, traducerea se oprește până a "
"doua zi."
msgstr ""
"Nad kvoto se samodejno plača (20 dolarjev na milijon znakov), če nisi znižal "
"dnevne kvote. Z znižano kvoto se prevajanje ustavi do naslednjega dne."

msgid ""
"Peste limita pe minut, cererile primesc eroarea 429 câteva secunde: "
"receptorul așteaptă cât spune Google și trece între timp la serviciul de "
"rezervă, dacă ai pus unul. Peste limita pe zi, până a doua zi (în jurul orei "
"10, ora României). Fără card nu se plătește nimic."
msgstr ""
"Nad omejitvijo na minuto zahteve za nekaj sekund dobijo napako 429: "
"sprejemnik počaka, kolikor določi Google, in medtem preklopi na rezervno "
"storitev, če si jo nastavil. Nad dnevno omejitvijo do naslednjega dne (okoli "
"10. ure po romunskem času). Brez kartice se nič ne plača."

msgid ""
"Peste limită Groq răspunde cu eroarea 429: receptorul așteaptă cât spune "
"Groq și trece între timp la serviciul de rezervă, dacă ai pus unul. Fără "
"card nu se plătește nimic."
msgstr ""
"Nad omejitvijo Groq odgovori z napako 429: sprejemnik čaka toliko, kot pravi "
"Groq, in medtem preklopi na rezervno storitev, če si jo nastavil. Brez "
"kartice se nič ne plača."

msgid ""
"Peste mai puțin de un minut pornește o înregistrare. Comenzile motorului nu "
"pornesc acum."
msgstr ""
"Čez manj kot minuto se začne snemanje. Ukazi motorja se zdaj ne začnejo."

