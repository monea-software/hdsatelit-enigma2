msgid "„%s” nu merge acum. Reîncarcă pagina."
msgstr "»%s« zdaj ne teče. Znova naloži stran."

msgid ""
"„%s” nu poate fi citit de receptor. Formatează-l pe un calculator ca FAT32 "
"(se șterge tot de pe el)."
msgstr ""
"Sprejemnik ne more prebrati »%s«. Formatiraj ga na računalniku kot FAT32 (s "
"tem se izbriše vse na njem)."

#, python-format
msgid ""
"„%s” nu poate fi citit de receptor. Îl poți formata aici sau pe un "
"calculator, ca FAT32. Formatarea șterge tot de pe el."
msgstr ""
"»%s« sprejemnik ne more prebrati. Formatiraš ga lahko tukaj ali na "
"računalniku, kot FAT32. Formatiranje izbriše vse z njega."

#, python-format
msgid ""
"„%s” nu se găsește în depozitul liber google/fonts: licență neconfirmată, nu "
"se descarcă."
msgstr ""
"»%s« ni v prostem repozitoriju google/fonts: licenca ni potrjena, ne prenese "
"se."

msgid "„%s” nu se poate folosi: %s."
msgstr "»%s« ni mogoče uporabiti: %s."

#, python-format
msgid "„%s” se alege cu 1 (da) sau 0 (nu)."
msgstr "»%s« se izbere z 1 (da) ali 0 (ne)."

msgid "„%s”, liber %s din %s"
msgstr "»%s«, prosto %s od %s"

msgid "„%s”: aici se salvează acum"
msgstr "»%s«: sem se zdaj shranjuje"

msgid "„%s”: aici se vor salva"
msgstr "»%s«: tu se bodo shranili posnetki"

msgid ""
"„Adresă proprie” (alt serviciu, cu adresa lui) și toate celelalte setări "
"sunt pe pagina cu toate setările:"
msgstr ""
"»Lastni naslov« (druga storitev, s svojim naslovom) in vse ostale nastavitve "
"so na strani z vsemi nastavitvami:"

msgid ""
"„Adresă proprie” e pentru un server de traducere ales de tine, de exemplu un "
"LibreTranslate pornit pe un calculator din casă. Receptorul trimite fiecare "
"rând de subtitrare într-o cerere separată."
msgstr ""
"»Lastni naslov« je za prevajalski strežnik po tvoji izbiri, na primer "
"LibreTranslate, zagnan na računalniku doma. Sprejemnik vsako vrstico "
"podnapisa pošlje v ločeni zahtevi."

msgid "„Ca la calculator” revine la următoarea pornire a receptorului."
msgstr "»Kot računalnik« se vrne ob naslednjem zagonu sprejemnika."

msgid ""
"„Ca la calculator” revine numai după o repornire. Repornești receptorul acum?"
msgstr ""
"»Kot računalnik« se vrne šele po ponovnem zagonu. Ali zdaj znova zaženeš "
"sprejemnik?"

msgid ""
"„Ca la calculator” se aplică la următoarea pornire; pe unele televizoare "
"imaginea iese spălăcită pe 60 Hz."
msgstr ""
"»Kot računalnik« se uporabi ob naslednjem zagonu; na nekaterih televizorjih "
"je slika pri 60 Hz izprana."

msgid ""
"„Ca la calculator” se aplică numai după o repornire. Repornești receptorul "
"acum?"
msgstr ""
"»Kot računalnik« se uporabi šele po ponovnem zagonu. Ali zdaj znova zaženeš "
"sprejemnik?"

msgid ""
"„Enigma” și „Dreambox” sunt mărci ale Dream Property GmbH; celelalte nume de "
"produse aparțin deținătorilor lor."
msgstr ""
"»Enigma« in »Dreambox« sta blagovni znamki podjetja Dream Property GmbH; "
"druga imena izdelkov pripadajo njihovim lastnikom."

msgid ""
"„Folosește pentru înregistrări” face pe disc dosarul movie, dacă lipsește. "
"Nu se șterge și nu se formatează nimic."
msgstr ""
"»Uporabi za snemanja« na disku ustvari mapo movie, če je ni. Nič se ne "
"izbriše in nič se ne formatira."

msgid "„Fără subtitrări niciodată” se alege cu 1 (da) sau 0 (nu)."
msgstr "»Nikoli ne prikaži podnapisov« se izbere z 1 (da) ali 0 (ne)."

msgid ""
"„Redenumește” schimbă numele numai în acest buchet. „Redenumește peste tot” "
"îl schimbă în lista receptorului."
msgstr ""
"»Preimenuj« spremeni ime samo v tem paketu. »Preimenuj povsod« ga spremeni "
"na seznamu sprejemnika."

msgid "„Standby” pornește automat fără nicio înregistrare activă."
msgstr "»Pripravljenost« se vklopi samodejno, ko ni aktivnega snemanja."

msgid "„pornit” se alege cu 1 (da) sau 0 (nu)."
msgstr "»vklopljeno« izbereš z 1 (da) ali 0 (ne)."

