msgstr "Na novem daljincu pritisni tipko za: %s"

msgid ""
"Apasă un buton pe desen: receptorul îl primește ca de pe telecomanda lui. "
"Ținut apăsat = apăsare lungă."
msgstr ""
"Pritisni gumb na risbi: sprejemnik ga prejme kot s svojega daljinca. Držanje "
"= dolg pritisk."

msgid ""
"Apasă „Create API Key”, scrie un nume și copiază cheia (începe cu gsk_); "
"Groq o arată o singură dată."
msgstr ""
"Pritisni »Create API Key«, vpiši ime in kopiraj ključ (začne se z gsk_); "
"Groq ga pokaže samo enkrat."

msgid "Apasă „Create API key” și copiază cheia."
msgstr "Pritisni »Create API key« in kopiraj ključ."

msgid ""
"Apasă „Create a Workers AI API Token”, apoi „Create API Token” și „Copy API "
"Token”. Păstrează jetonul."
msgstr ""
"Pritisni »Create a Workers AI API Token«, nato »Create API Token« in »Copy "
"API Token«. Shrani žeton."

msgid ""
"Apasă „Create a Workers AI API Token”, apoi „Create API Token” și „Copy API "
"Token”; copiază și „Account ID”, de la „Get Account ID”."
msgstr ""
"Pritisni »Create a Workers AI API Token«, nato »Create API Token« in »Copy "
"API Token«; kopiraj tudi »Account ID« pod »Get Account ID«."

msgid "Apasă „Create credentials”, „API key” și copiază cheia."
msgstr "Pritisni »Create credentials«, »API key« in kopiraj ključ."

msgid ""
"Apasă „Probează traducerea”. Dacă nu merge, mesajul arată începutul "
"răspunsului serverului, ca să vezi unde e traducerea și ce cale să scrii."
msgstr ""
"Pritisni »Preizkusi prevod«. Če ne deluje, sporočilo prikaže začetek "
"odgovora strežnika, da vidiš, kje je prevod in katero pot vpisati."

msgid ""
"Apasă „Review + create”, apoi „Create”. Când e gata, apasă „Go to resource”."
msgstr ""
"Pritisni »Review + create«, nato »Create«. Ko je pripravljeno, pritisni »Go "
"to resource«."

msgid ""
"Aplicația HbbTV a acestui canal e folosită numai pentru măsurarea audienței "
