msgid_plural "Copiate %d rânduri"
msgstr[0] "Kopirana %d vrstica"
msgstr[1] "Kopirani %d vrstici"
msgstr[2] "Kopirane %d vrstice"
msgstr[3] "Kopiranih %d vrstic"

msgid "Copiat."
msgstr "Kopirano."

