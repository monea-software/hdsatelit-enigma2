msgid ""
"Aceasta e telecomanda receptorului. Apasă un buton pe cealaltă telecomandă."
msgstr "To je daljinec sprejemnika. Pritisni tipko na drugem daljincu."

msgid ""
"Această acțiune se face numai din browserul conectat, nu cu cheia din adresă."
msgstr ""
"To dejanje je mogoče izvesti samo iz povezanega brskalnika, ne s ključem v "
"naslovu."

msgid ""
"Această imagine nu are încă liste de canale gata făcute. Canalele se găsesc "
"cu o scanare, pe satelit, prin cablu sau terestru, sau se aduc dintr-o copie "
"de pe stick."
msgstr ""
"Ta image še nima pripravljenih seznamov kanalov. Kanale najdeš z iskanjem, "
"prek satelita, kabla ali prizemno, ali jih preneseš iz kopije na USB ključu."

msgid "Această intrare se deschide numai din telecomandă."
msgstr "Ta vnos se odpre samo z daljincem."

msgid "Această pistă audio nu se aude în browser."
msgstr "Ta zvočni posnetek v brskalniku ni slišen."

msgid "Aceeași alegere este pe televizor, în __DRUM_MENIU__."
msgstr "Enaka izbira je na televizorju, v __DRUM_MENIU__."

msgid "Aceeași listă este pe televizor, la tasta TIMER sau în __DRUM_MENIU__."
msgstr "Enak seznam je na televizorju, pri tipki TIMER ali v __DRUM_MENIU__."

msgid ""
"Aceeași probă e pe televizor, în __DRUM_MENIU__. Proba pornită din "
"telecomandă se vede și aici."
msgstr ""
"Enak preizkus je na televizorju, v __DRUM_MENIU__. Preizkus, zagnan z "
"daljincem, je viden tudi tukaj."

msgid "Acel rând e o explicație și nu se poate alege."
msgstr "Ta vrstica je samo razlaga in je ni mogoče izbrati."

msgid "Acela e un titlu de grupă. Alege un rând de sub el."
msgstr "To je naslov skupine. Izberi vrstico pod njim."

msgid ""
"Același SID pe același transponder, scris de două ori cu alt tip de serviciu."
msgstr ""
"Isti SID na istem transponderju, zapisan dvakrat z drugo vrsto storitve."

msgid ""
"Același canal de două ori în același buchet. Același nume pe alt satelit nu "
"e dublură."
msgstr ""
"Isti kanal dvakrat v istem paketu. Isto ime na drugem satelitu ni dvojnik."

msgid "Același canal de două ori în listă"
msgstr "Isti kanal dvakrat na seznamu"

msgid "Același canal, cu alt nume decât în copie."
msgstr "Isti kanal z drugim imenom kot v kopiji."

msgid "Același ecran e pe televizor, în %s."
msgstr "Isti zaslon je na televizorju, v %s."

msgid "Același ecran e pe televizor, în __DRUM_MENIU__."
msgstr "Enak zaslon je na televizorju, v __DRUM_MENIU__."

msgid "Același ecran este pe televizor, în __DRUM_MENIU__."
msgstr "Enak zaslon je na televizorju, v __DRUM_MENIU__."

msgid "Același forum e pe televizor: __DRUM_MENIU__, Forumul receptorului."
msgstr "Isti forum je na televizorju: __DRUM_MENIU__, Forum sprejemnika."

msgid ""
"Același meniu ca la tasta MENU, cu aceleași intrări pentru nivelul ales pe "
"receptor. La fiecare intrare: pagina ei din interfața web, dacă are, pagina "
"de setări sau „Deschide pe televizor”."
msgstr ""
"Enak meni kot pri tipki MENU, z enakimi vnosi za raven, izbrano na "
"sprejemniku. Pri vsakem vnosu: njegova stran v spletnem vmesniku, če jo ima, "
"stran z nastavitvami ali »Odpri na televizorju«."

msgid ""
"Același mesaj apare și în interfața web a receptorului, la pagina /paza-"
"model."
msgstr ""
"Enako sporočilo se pojavi tudi v spletnem vmesniku sprejemnika, na strani /"
"paza-model."

#, python-format
msgid "Același mesaj apare și în interfața web a receptorului: %s"
msgstr "Enako sporočilo se pojavi tudi v spletnem vmesniku sprejemnika: %s"

msgid "Același nume pe aceeași poziție"
msgstr "Isto ime na istem položaju"

msgid "Același program e pe televizor, în __DRUM_MENIU__."
msgstr "Isti program je na televizorju, v __DRUM_MENIU__."

msgid "Același rând e pe televizor, în"
msgstr "Enaka vrstica je na televizorju, v"

#, python-format
msgid "Același satelit e pe două porturi (%s). Schimbă întâi din Setări tuner."
msgstr ""
"Isti satelit je na dveh priključkih (%s). Najprej to spremeni v Nastavitvah "
"tunerja."

msgid "Același utilitar e pe televizor, în __DRUM_MENIU__."
msgstr "Enako orodje je na televizorju, v __DRUM_MENIU__."

msgid ""
"Același utilitar e pe televizor, în __DRUM_MENIU__. Cât ascultă pagina, "
"tastele merg și pe televizor, cel mult 2 minute, iar pe televizor apare un "
"anunț. Din standby adânc receptorul pornește numai cu telecomanda lui."
msgstr ""
"Enako orodje je na televizorju, v __DRUM_MENIU__. Medtem ko stran posluša, "
"tipke delujejo tudi na televizorju, največ 2 minuti, na televizorju pa se "
"prikaže obvestilo. Iz globokega stanja pripravljenosti se sprejemnik vklopi "
"samo s svojim daljincem."

msgid ""
"Același utilitar e pe televizor, în __DRUM_MENIU__. Placa Wi-Fi a "
"receptorului recepționează numai rețelele de 2,4 GHz. Căutarea e aceeași ca "
"la lista rețelelor Wi-Fi: nu trimite nimic altceva."
msgstr ""
"Enako orodje je na televizorju, v __DRUM_MENIU__. Wi-Fi kartica sprejemnika "
"sprejema samo omrežja 2,4 GHz. Iskanje je enako kot pri seznamu omrežij Wi-"
"Fi: ne pošilja ničesar drugega."

msgid "Aceleași alegeri sunt și în interfața web, la pagina /mod-sigur."
msgstr "Iste izbire so tudi v spletnem vmesniku, na strani /mod-sigur."

#, python-format
msgid "Aceleași alegeri sunt și în interfața web: %s"
msgstr "Iste izbire so tudi v spletnem vmesniku: %s"

msgid "Aceleași comenzi sunt pe televizor, în __DRUM_MENIU__."
msgstr "Enaki ukazi so na televizorju, v __DRUM_MENIU__."

msgid ""
"Aceleași culori sunt pe televizor, în __DRUM_MENIU__ › Culori pe roluri, "
"unde le alegi pe o grilă. Paleta, opacitatea panourilor și pagina tehnică se "
"aleg tot acolo."
msgstr ""
"Enake barve so na televizorju, v __DRUM_MENIU__ › Barve po vlogah, kjer jih "
"izbereš na mreži. Paleta, prosojnost plošč in tehnična stran se izberejo "
"prav tam."

msgid "Aceleași ecrane sunt pe televizor, în __DRUM_MENIU__."
msgstr "Enaki zasloni so na televizorju, v __DRUM_MENIU__."

msgid ""
"Aceleași ecrane sunt pe televizor, în __DRUM_MENIU__; tasta albastră arată "
"acolo textul brut."
msgstr ""
"Enaki zasloni so na televizorju, v __DRUM_MENIU__; modra tipka tam prikaže "
"surovo besedilo."

msgid "Aceleași extensii și acțiuni sunt pe televizor, în __DRUM_MENIU__."
msgstr "Enake razširitve in dejanja so na televizorju, v __DRUM_MENIU__."

msgid "Aceleași filme ca în lista de filme de pe televizor."
msgstr "Isti filmi kot na seznamu filmov na televizorju."

#, python-format
msgid "Aceleași lucruri sunt pe televizor, în %s."
msgstr "Enako je na televizorju, v %s."

msgid "Aceleași lucruri sunt și în meniul receptorului, în %s."
msgstr "Enako je tudi v meniju sprejemnika, v %s."

#, python-format
msgid ""
"Aceleași reglaje sunt pe televizor, în %s. Luminozitatea, contrastul, "
"saturația și nuanța schimbă și meniurile. Ce se vede cu adevărat se judecă "
"pe televizor: capturile de ecran nu arată prelucrarea plăcii."
msgstr ""
"Enake nastavitve so na televizorju, v %s. Svetlost, kontrast, nasičenost in "
"odtenek spremenijo tudi menije. Kar je res vidno, presodi na televizorju: "
"posnetki zaslona ne prikažejo obdelave vezja."

msgid "Aceleași reglaje sunt pe televizor, în __DRUM_MENIU__."
msgstr "Iste nastavitve so na televizorju, v __DRUM_MENIU__."

msgid ""
"Aceleași rezultate ca pe televizor, în Meniu, „Setări”, „Caută setări” (sau "
"tasta TEXT în orice meniu): meniurile și setările pe care le arată acum "
"receptorul. Literele mari și diacriticele nu contează. La fiecare rezultat: "
"pagina lui din interfața web, dacă are, sau „Deschide pe televizor”, cu "
"rândul găsit deja ales."
msgstr ""
"Isti rezultati kot na televizorju, v Meniju, »Nastavitve«, »Išči "
"nastavitve« (ali tipka TEXT v katerem koli meniju): meniji in nastavitve, ki "
"jih sprejemnik trenutno prikazuje. Velike črke in diakritična znamenja niso "
"pomembna. Pri vsakem rezultatu: njegova stran v spletnem vmesniku, če jo "
"ima, ali »Odpri na televizorju«, z že izbrano najdeno vrstico."

msgid ""
"Aceleași rânduri, cu aceleași alegeri, sunt pe televizor în ecranul cu "
"același nume. Rândurile care se văd depind de „__NIVEL__”, ales pe televizor "
"în __DRUM_MENIU__. Setările fără listă de alegeri se schimbă de pe televizor."
msgstr ""
"Iste vrstice z enakimi izbirami so na televizorju na zaslonu z enakim "
"imenom. Vrstice, ki so vidne, so odvisne od »__NIVEL__«, izbranega na "
"televizorju v __DRUM_MENIU__. Nastavitve brez seznama izbir se spremenijo s "
"televizorja."

#, python-format
msgid "Aceleași setări sunt pe televizor, în %s."
msgstr "Enake nastavitve so na televizorju, v %s."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__ (cu nivelul de meniu "
"Expert). Locul unde ai rămas se ține minte lângă film, în fișierul cu "
"același nume și terminația .cuts, numai după primul minut și dacă stick-ul "
"sau discul se poate scrie."
msgstr ""
"Iste nastavitve so na televizorju, v __DRUM_MENIU__ (z ravnijo menija "
"Strokovnjak). Mesto, kjer si ostal, se zapomni ob filmu, v datoteki z enakim "
"imenom in končnico .cuts, šele po prvi minuti in če je mogoče pisati na "
"ključ ali disk."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__ (tasta albastră). "
"Miniaturile le face browserul din poze; din pagină se văd numai stick-urile "
"și discurile, nu memoria internă a receptorului."
msgstr ""
"Iste nastavitve so na televizorju, v __DRUM_MENIU__ (modra tipka). Sličice "
"izdeluje brskalnik iz slik; na strani so vidni samo ključi in diski, ne pa "
"notranji pomnilnik sprejemnika."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__ (în meniul playerului, "
"tasta Menu), unde sunt și aceleași comenzi. Din pagină se văd numai stick-"
"urile și discurile, nu memoria internă a receptorului."
msgstr ""
"Iste nastavitve so na televizorju, v __DRUM_MENIU__ (v meniju predvajalnika, "
"tipka Menu), kjer so tudi enaki ukazi. Na strani so vidni samo ključi in "
"diski, ne pa notranji pomnilnik sprejemnika."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__, și cu OK ținut apăsat "
"pe ecranul radio."
msgstr ""
"Iste nastavitve so na televizorju, v __DRUM_MENIU__, in z dolgim pritiskom "
"OK na radijskem zaslonu."

msgid "Aceleași setări sunt pe televizor, în __DRUM_MENIU__."
msgstr "Iste nastavitve so na televizorju, v __DRUM_MENIU__."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Redarea folosește "
"biblioteca mpegts.js (Apache-2.0), venită cu imaginea: <a href=\"/tv/mpegts-"
"licenta.txt\">licența</a>. Canalele cu imagine MPEG-2 și sunetul AC-3 (unde "
"browserul nu îl redă singur) se decodează în browser, pe procesorul "
"calculatorului, cu decodorul FFmpeg (LGPL-2.1) venit tot cu imaginea: <a "
"href=\"/tv/tv-wasm/ffmpeg-licenta.txt\">licența și sursa</a>; toate "
"licențele sunt în <a href=\"/licente\">Licențe</a>."
msgstr ""
"Iste nastavitve so na televizorju, v __DRUM_MENIU__. Predvajanje uporablja "
"knjižnico mpegts.js (Apache-2.0), ki je priložena image-u: <a href=\"/tv/"
"mpegts-licenta.txt\">licenca</a>. Kanale s sliko MPEG-2 in zvokom AC-3 (kjer "
"ga brskalnik ne predvaja sam) se dekodirajo v brskalniku, na procesorju "
"računalnika, z dekoderjem FFmpeg (LGPL-2.1), ki je tudi priložen image-u: <a "
"href=\"/tv/tv-wasm/ffmpeg-licenta.txt\">licenca in izvorna koda</a>; vse "
"licence so v <a href=\"/licente\">Licence</a>."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Serverele DNS au "
"pagina lor: <a href=\"/dns\" id=\"legaturaDns\">Servere DNS</a>."
msgstr ""
"Iste nastavitve so na televizorju, v __DRUM_MENIU__. Strežniki DNS imajo "
"svojo stran: <a href=\"/dns\" id=\"legaturaDns\">Strežniki DNS</a>."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Tema și culorile "
"paginilor web sunt în pagina Setări."
msgstr ""
"Iste nastavitve so na televizorju, v __DRUM_MENIU__. Tema in barve spletnih "
"strani so na strani Nastavitve."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Întârzierea pistei e "
"și în ecranul tastei AUDIO."
msgstr ""
"Iste nastavitve so na televizorju, v __DRUM_MENIU__. Zamik zvočnega posnetka "
"je tudi na zaslonu tipke AUDIO."

msgid ""
"Aceleași setări sunt pe televizor, în „Fluxuri și setări”, pe tasta MENU."
msgstr ""
"Iste nastavitve so na televizorju, v »Tokovi in nastavitve«, s tipko MENU."

msgid ""
"Acest browser nu poate decoda imaginea HEVC (H.265) a acestui canal, de "
"pildă 4K pe 10 biți. Deschide-l într-un player din casă cu playlistul de mai "
"jos."
msgstr ""
"Ta brskalnik ne more dekodirati slike HEVC (H.265) tega kanala, na primer 4K "
"z 10 biti. Odpri ga v domačem predvajalniku s spodnjim seznamom predvajanja."

msgid ""
"Acest browser nu poate decoda imaginea HEVC (H.265) a acestui canal, de "
"pildă 4K pe 10 biți. Încearcă alt browser sau un player din casă."
msgstr ""
"Ta brskalnik ne more dekodirati slike HEVC (H.265) tega kanala, na primer 4K "
"z 10 biti. Poskusi drug brskalnik ali domači predvajalnik."

msgid ""
"Acest browser nu poate reda fluxul (îi lipsește MediaSource). Încearcă "
"Chrome, Edge, Firefox sau Safari nou."
msgstr ""
"Ta brskalnik ne more predvajati toka (manjka mu MediaSource). Poskusi "
"novejši Chrome, Edge, Firefox ali Safari."

msgid ""
"Acest browser rămâne conectat. Scripturile care folosesc cheia veche nu mai "
"merg până primesc cheia nouă."
msgstr ""
"Ta brskalnik ostane povezan. Skripte, ki uporabljajo stari ključ, ne "
"delujejo več, dokler ne dobijo novega."

msgid "Acest browser:"
msgstr "Ta brskalnik:"

msgid "Acest canal nu poate fi pus pe pauză."
msgstr "Tega kanala ni mogoče začasno ustaviti."

msgid "Acest canal nu poate fi înregistrat."
msgstr "Tega kanala ni mogoče snemati."

msgid ""
"Acest canal trimite imaginea în HEVC, iar acest browser nu o poate reda. "
"Încearcă Chrome sau Edge pe un calculator cu placă video nouă, sau Safari."
msgstr ""
"Ta kanal pošilja sliko v HEVC, tega brskalnika pa je ne more predvajati. "
"Poskusi Chrome ali Edge na računalniku z novo grafično kartico ali Safari."

msgid ""
"Acest canal trimite imaginea în MPEG-2, iar acest browser nu o poate reda "
"(îi lipsește WebAssembly sau WebGL). Încearcă Chrome, Edge, Firefox sau "
"Safari nou."
msgstr ""
"Ta kanal pošilja sliko v MPEG-2, tega brskalnika pa je ne more predvajati "
"(manjka mu WebAssembly ali WebGL). Poskusi novejši Chrome, Edge, Firefox ali "
"Safari."

msgid ""
"Acest canal trimite imaginea într-un format pe care browserele nu îl redau."
msgstr "Ta kanal pošilja sliko v formatu, ki ga brskalniki ne predvajajo."

#, python-format
msgid ""
"Acest ecran nu are marcaje: serviciul curent nu suportă tăieri (de exemplu, "
"televiziune live)."
msgstr ""
"Ta zaslon nima oznak: trenutna storitev ne podpira rezov (na primer "
"televizija v živo)."

msgid "Acest ecran nu are poză mică de previzualizare."
msgstr "Ta zaslon nima majhne predogledne slike."

msgid "Acest ecran se folosește pe televizor."
msgstr "Ta zaslon se uporablja na televizorju."

msgid "Acest fel de loc nu se poate monta pe receptor."
msgstr "Tovrstnega mesta ni mogoče priklopiti na sprejemnik."

#, python-format
msgid ""
"Acest pachet (HD Satelit %(versiune)s) este pentru receptorul %(model)s "
"(placa %(hw)s, procesor %(cip)s)."
msgstr ""
"Ta paket (HD Satelit %(versiune)s) je namenjen sprejemniku %(model)s (plošča "
"%(hw)s, procesor %(cip)s)."

#, no-python-format
msgid "Acest receptor nu a prins niciodată semnal pe %d poziție: %s."
msgid_plural "Acest receptor nu a prins niciodată semnal pe %d poziții: %s."
msgstr[0] "Ta sprejemnik nikoli ni ujel signala na %d položaju: %s."
msgstr[1] "Ta sprejemnik nikoli ni ujel signala na %d položajih: %s."
msgstr[2] "Ta sprejemnik nikoli ni ujel signala na %d položajih: %s."
msgstr[3] "Ta sprejemnik nikoli ni ujel signala na %d položajih: %s."

#, python-format
msgid "Acest receptor nu a prins niciodată semnal pe o poziție: %s."
msgstr "Ta sprejemnik nikoli ni ujel signala na enem položaju: %s."

msgid "Acest receptor nu are încă unealta care face ecranul dintr-o poză."
msgstr "Ta sprejemnik še nima orodja, ki izdela zaslon iz slike."

msgid ""
"Acest receptor nu poate muta imaginea; cadrul arată numai unde ar ajunge "
"marginile."
msgstr ""
"Ta sprejemnik ne more premakniti slike; okvir le prikazuje, kje bi bili "
"robovi."

msgid ""
"Acest satelit se recepționează numai cu motorul USALS, iar motorul nu știe "
"unde ești, deci antena nu se rotește. Apasă OK și alege țara și orașul."
msgstr ""
"Ta satelit je mogoče sprejemati samo z motorjem USALS, motor pa ne ve, kje "
"si, zato se antena ne zavrti. Pritisni OK in izberi državo in mesto."

msgid ""
"Acest serviciu nu are imagine și nici sunet. Trimite numai date, de exemplu "
"actualizări sau ghidul programelor."
msgstr ""
