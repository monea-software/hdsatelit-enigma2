msgid ""
"Aplicația HbbTV a acestui canal e prea mare pentru memoria receptorului."
msgstr "Aplikacija HbbTV tega kanala je prevelika za pomnilnik sprejemnika."

msgid "Aplicația HbbTV a acestui canal nu are o adresă pe internet."
msgstr "Aplikacija HbbTV tega kanala nima internetnega naslova."

msgid ""
"Aplicația HbbTV a acestui canal nu mai este la adresa anunțată de post: "
"pagina a fost mutată sau ștearsă."
msgstr ""
"Aplikacije HbbTV tega kanala ni več na naslovu, ki ga navaja postaja: stran "
"je bila premaknjena ali izbrisana."

msgid ""
"Aplicația HbbTV a acestui canal nu s-a încărcat întreagă din satelit: "
"semnalul e prea slab."
msgstr ""
"Aplikacija HbbTV tega kanala se ni v celoti naložila s satelita: signal je "
"prešibek."

msgid ""
"Aplicația HbbTV a acestui canal nu vine din satelit: pista ei e criptată sau "
"semnalul lipsește."
msgstr ""
"Aplikacija HbbTV tega kanala ne prihaja s satelita: njen tok je šifriran ali "
"signal manjka."

msgid ""
"Aplicația HbbTV a acestui canal pornește cu tasta ALBASTRU. Apasă ALBASTRU."
msgstr "Aplikacija HbbTV tega kanala se zažene s tipko MODRA. Pritisni MODRO."

msgid ""
"Aplicația HbbTV a acestui canal se deschide numai pe anumite televizoare și "
"nu a primit receptorul."
msgstr ""
"Aplikacija HbbTV tega kanala se odpre samo na določenih televizorjih in ni "
"sprejela sprejemnika."

msgid ""
"Aplicația HbbTV a acestui canal vine din semnalul altui canal și receptorul "
"nu o poate încărca de aici."
msgstr ""
"Aplikacija HbbTV tega kanala prihaja v signalu drugega kanala in sprejemnik "
"je ne more naložiti od tu."

msgid ""
