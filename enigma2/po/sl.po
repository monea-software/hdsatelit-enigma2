msgid ""
"<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|"
"oprit</code>: pornește sau oprește captura paginii (cititorul și proba numai "
"ascultă, cel mult 2 minute)"
msgstr ""
"<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|"
"oprit</code>: zažene ali ustavi zajem strani (čitalnik in preizkus samo "
"poslušata, največ 2 minuti)"

msgid ""
"<code>POST /api/telecomenzi-schimba?actiune=activa|neasociate|redenumeste|"
"sterge-tasta|sterge|sterge-tot&amp;id=..&amp;cod=..&amp;nume=..&amp;"
"confirmat=1</code>: aceleași schimbări ca în lista de pe televizor"
msgstr ""
"<code>POST /api/telecomenzi-schimba?actiune=activa|neasociate|redenumeste|"
"sterge-tasta|sterge|sterge-tot&amp;id=..&amp;cod=..&amp;nume=..&amp;"
"confirmat=1</code>: enake spremembe kot na seznamu na televizorju"

msgid ""
"<code>POST /api/teletext-salveaza</code>, <code>POST /api/teletext-sterge?"
"ref=</code>, <code>POST /api/teletext-reimprospateaza?ref=</code> "
"(receptorul trece pe canal, așteaptă o trecere completă a teletextului, face "
"copia și se întoarce la canalul de dinainte; răspunde pe loc), <code>POST /"
"api/teletext-setari?hd=0|1&amp;contur=0|1&amp;umbra=0|1&amp;relief=0|1&amp;"
"copie_automata=0|1&amp;spatiu=5|10|20|50|100</code> (<code>hd</code> = "
"Teletext neted): aceleași alegeri ca meniul teletextului de pe televizor"
msgstr ""
"<code>POST /api/teletext-salveaza</code>, <code>POST /api/teletext-sterge?"
"ref=</code>, <code>POST /api/teletext-reimprospateaza?ref=</code> "
"(sprejemnik preklopi na kanal, počaka na celoten prehod teleteksta, naredi "
"kopijo in se vrne na prejšnji kanal; odgovori takoj), <code>POST /api/"
"teletext-setari?hd=0|1&amp;contur=0|1&amp;umbra=0|1&amp;relief=0|1&amp;"
"copie_automata=0|1&amp;spatiu=5|10|20|50|100</code> (<code>hd</code> = "
"Glajen teletekst): enake izbire kot meni teleteksta na televizorju"

msgid ""
"<code>POST /api/temporizatoare-adauga?ref=&lt;canal&gt;&amp;zi=AAAA-LL-"
"ZZ&amp;inceput=HH:MM&amp;sfarsit=HH:MM&amp;nume=..&amp;doar_comuta=0|1</"
"code>: pune o înregistrare (sau doar schimbarea canalului); la suprapunere "
"nu pune nimic și spune cu ce se suprapune"
msgstr ""
"<code>POST /api/temporizatoare-adauga?ref=&lt;canal&gt;&amp;zi=AAAA-LL-"
"ZZ&amp;inceput=HH:MM&amp;sfarsit=HH:MM&amp;nume=..&amp;doar_comuta=0|1</"
"code>: nastavi snemanje (ali samo preklop kanala); ob prekrivanju ne nastavi "
"ničesar in pove, s čim se prekriva"

msgid ""
"<code>POST /api/temporizatoare-modifica?id=..&amp;zi=..&amp;inceput=..&amp;"
"sfarsit=..&amp;repetare=o_data|zilnic|luni_vineri|zile&amp;zile=0,1,..&amp;"
"dupa=nimic|asteptare|oprire|automat&amp;loc=..</code>: aceleași câmpuri ca "
"fereastra de pe televizor, cu aceeași verificare a suprapunerii; <code>POST /"
"api/temporizatoare-opreste?id=..&amp;alegere=stoponlycurrent|stopall|"
"stoponlycoming</code>: una repetată care merge acum"
msgstr ""
"<code>POST /api/temporizatoare-modifica?id=..&amp;zi=..&amp;inceput=..&amp;"
"sfarsit=..&amp;repetare=o_data|zilnic|luni_vineri|zile&amp;zile=0,1,..&amp;"
"dupa=nimic|asteptare|oprire|automat&amp;loc=..</code>: enaka polja kot okno "
"na televizorju, z enakim preverjanjem prekrivanja; <code>POST /api/"
"temporizatoare-opreste?id=..&amp;alegere=stoponlycurrent|stopall|"
"stoponlycoming</code>: ponavljajoči se, ki zdaj teče"

msgid ""
"<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, "
"<code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, "
"<code>POST /api/temporizatoare-curata?confirmat=1</code>: șterge una, o "
"oprește sau o pornește din nou, șterge cele terminate"
msgstr ""
"<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, "
"<code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, "
"<code>POST /api/temporizatoare-curata?confirmat=1</code>: izbriše enega, ga "
"ustavi ali znova zažene, izbriše končane"

msgid ""
"<code>POST /api/traducere-configurare-cauta</code>: caută în rețeaua de "
"acasă serverele Ollama (11434) și LibreTranslate (5000); rezultatul vine în "
"<code>cautare</code>"
msgstr ""
"<code>POST /api/traducere-configurare-cauta</code>: v domačem omrežju poišče "
"strežnike Ollama (11434) in LibreTranslate (5000); rezultat pride v "
"<code>cautare</code>"

msgid ""
"<code>POST /api/traducere-configurare-cheie</code>, corpul <code>cheie=&lt;"
"cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;"
"&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: probează cheia pe loc "
"și, dacă merge, o salvează și pornește traducerea; numai în corpul cererii, "
"niciodată în adresă; rezultatul vine în <code>configurare</code> din "
"<code>GET /api/traducere-configurare</code>"
msgstr ""
"<code>POST /api/traducere-configurare-cheie</code>, telo <code>cheie=&lt;"
"cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;"
"&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: takoj preizkusi ključ "
"in, če deluje, ga shrani in zažene prevajanje; samo v telesu zahteve, nikoli "
"v naslovu; rezultat pride v <code>configurare</code> iz <code>GET /api/"
"traducere-configurare</code>"

msgid ""
"<code>POST /api/traducere-configurare-model?model=..</code>: alt model "
"pentru serviciul ales acum, cu probă"
msgstr ""
"<code>POST /api/traducere-configurare-model?model=..</code>: drug model za "
"zdaj izbrano storitev, s preizkusom"

msgid ""
"<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;"
"&amp;adresa=..&amp;model=..</code>: folosește serverul din casă (adresa "
"completată de receptor, modelul ales singur dacă lipsește) și îl probează"
msgstr ""
"<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;"
"&amp;adresa=..&amp;model=..</code>: uporabi domači strežnik (naslov dopolni "
"sprejemnik, model izbere sam, če manjka) in ga preizkusi"

msgid ""
"<code>POST /api/traducere-subtitrari-cheie</code>, corpul <code>serviciu=&lt;"
"cod&gt;&amp;cheie=&lt;cheia&gt;</code>: pune cheia unui serviciu (goală = o "
"șterge); la <code>serviciu=propriu</code> cheia este valoarea antetului "
"adresei proprii (de exemplu <code>Bearer</code> și cheia); numai în corpul "
"cererii, niciodată în adresă; răspunsul spune doar care serviciu are cheie"
msgstr ""
"<code>POST /api/traducere-subtitrari-cheie</code>, telo <code>serviciu=&lt;"
"cod&gt;&amp;cheie=&lt;cheia&gt;</code>: nastavi ključ storitve (prazno = ga "
"izbriše); pri <code>serviciu=propriu</code> je ključ vrednost glave lastnega "
"naslova (na primer <code>Bearer</code> in ključ); samo v telesu zahteve, "
"nikoli v naslovu; odgovor pove samo, katera storitev ima ključ"

msgid ""
"<code>POST /api/traducere-subtitrari-proba</code>: probează traducerea cu "
"serviciul ales; rezultatul vine în <code>stare.proba</code> din <code>GET /"
"api/traducere-subtitrari</code>"
msgstr ""
"<code>POST /api/traducere-subtitrari-proba</code>: preizkusi prevajanje z "
"izbrano storitvijo; rezultat pride v <code>stare.proba</code> iz <code>GET /"
"api/traducere-subtitrari</code>"

msgid ""
"<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;"
"gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;"
"limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;"
"tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;"
"&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;"
"adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=.."
"&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;"
"propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|"
"formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;"
"propriu_cale=..</code>: schimbă și salvează oricare dintre ele (valorile "
"exacte sunt în <code>alegeri</code>); o valoare greșită refuză tot. Adresa "
"proprie: adresa e un șablon cu <code>{text}</code>, <code>{sursa}</code>, "
"<code>{tinta}</code> (http:// numai pentru un server din rețeaua de acasă); "
"adresa receptorului însuși (127.0.0.1, localhost, IP-ul lui) e refuzată, și "
"la <code>adresa_libre</code> și <code>adresa_openai</code>; calea în JSON "
"are chei și numere despărțite prin punct, <code>*</code> = toate elementele"
msgstr ""
"<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;"
"gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;"
"limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;"
"tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;"
"&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;"
"adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=.."
"&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;"
"propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|"
"formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;"
"propriu_cale=..</code>: spremeni in shrani katero koli od njih (točne "
"vrednosti so v <code>alegeri</code>); napačna vrednost zavrne vse. Lastni "
"naslov: naslov je predloga z <code>{text}</code>, <code>{sursa}</code>, "
"<code>{tinta}</code> (http:// samo za strežnik v domačem omrežju); naslov "
"samega sprejemnika (127.0.0.1, localhost, njegov IP) je zavrnjen, tudi pri "
"<code>adresa_libre</code> in <code>adresa_openai</code>; pot v JSON ima "
"ključe in številke, ločene s piko, <code>*</code> = vsi elementi"

msgid ""
"<code>POST /api/traducere-subtitrari-zero</code>: contorul traducerii pus la "
"zero"
msgstr ""
"<code>POST /api/traducere-subtitrari-zero</code>: števec prevajanja "
"postavljen na nič"

msgid ""
"<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|"
"1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /"
"api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;"
"asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: fluxul TS al "
"transmisiei acestui browser. Pornirea și fluxul merg numai din browserul "
"conectat, cu antetul <code>X-HDS-CSRF</code>, niciodată cu <code>?token=</"
"code>"
msgstr ""
"<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|"
"1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /"
"api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;"
"asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: tok TS prenosa "
"tega brskalnika. Zagon in tok delujeta samo iz povezanega brskalnika, z "
"glavo <code>X-HDS-CSRF</code>, nikoli z <code>?token=</code>"

msgid ""
"<code>POST /api/video-confirma</code> și <code>POST /api/video-revino</"
"code>: păstrează modul încercat sau revine la cel de dinainte"
msgstr ""
"<code>POST /api/video-confirma</code> in <code>POST /api/video-revino</"
"code>: obdrži preizkušeni način ali se vrne na prejšnjega"

msgid ""
"<code>POST /api/video-reporneste</code>: repornește receptorul (culorile „Ca "
"la calculator” se aplică numai după o repornire); cu o înregistrare în curs, "
"întrebarea apare pe televizor"
msgstr ""
"<code>POST /api/video-reporneste</code>: ponovno zažene sprejemnik (barve "
"»Kot pri računalniku« se uporabijo šele po ponovnem zagonu); pri snemanju v "
"teku se vprašanje prikaže na televizorju"

msgid ""
"<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;"
"frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=.."
"&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;"
"ycbcr|rgb&gt;</code>: un mod nou se încearcă (aceeași întrebare pe "
"televizor, 20 s, fără răspuns revine); zapmode se salvează direct; "
"culori_hdmi=ycbcr se încearcă la fel (aceeași întrebare), rgb se salvează și "
"se aplică după o repornire"
msgstr ""
"<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;"
"frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=.."
"&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;"
"ycbcr|rgb&gt;</code>: nov način se preizkusi (isto vprašanje na televizorju, "
"20 s, brez odgovora se vrne); zapmode se shrani neposredno; "
"culori_hdmi=ycbcr se preizkusi enako (isto vprašanje), rgb se shrani in "
"uporabi po ponovnem zagonu"

msgid "<p class=\"gol\">Niciun font descărcat încă.</p>"
msgstr "<p class=\"gol\">Ni še prenesena nobena pisava.</p>"

msgid "<p class=\"gol\">Nimic găsit.</p>"
msgstr "<p class=\"gol\">Nič ni najdeno.</p>"

