"<span aria-hidden=\"true\">&#9632;</span> Oprește live (înapoi la captură)"
msgstr ""
"<span aria-hidden=\"true\">&#9632;</span> Ustavi v živo (nazaj na zajem)"

msgid "<span aria-hidden=\"true\">&#9654;</span> Privește live aici"
msgstr "<span aria-hidden=\"true\">&#9654;</span> Glej v živo tukaj"

