msgstr "Račun OpenSubtitles je bil odstranjen s sprejemnika."

msgid ""
"Contul de pe server. Pe Windows: numele contului sau CASA\\nume. Gol: fără "
"cont (oaspete)."
msgstr ""
"Račun na strežniku. V Windows: ime računa ali CASA\\nume. Prazno: brez "
"računa (gost)."

msgid ""
"Contul nu are credit pentru acest model. Cumpără credit sau alege alt model."
msgstr "Račun nima kredita za ta model. Kupi kredit ali izberi drug model."

msgid ""
"Contul root nu are parolă, deci nu se intră cu parolă, numai cu o cheie. "
"Alege „Fă o parolă”."
msgstr ""
"Račun root nima gesla, zato prijava z geslom ni mogoča, samo s ključem. "
"Izberi »Ustvari geslo«."

msgid "Contul root nu are parolă. Alege „Fă o parolă”."
msgstr "Račun root nima gesla. Izberi »Ustvari geslo«."

