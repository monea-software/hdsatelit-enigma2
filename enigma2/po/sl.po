msgid ""
"Exemplu, un LibreTranslate al tău din casă: adresa http://192.168.1.50:5000/"
"translate, metoda POST, corpul JSON {\"q\": \"{text}\", \"source\": "
"\"{sursa}\", \"target\": \"{tinta}\", \"format\": \"text\"}, răspunsul JSON, "
"calea translatedText."
msgstr ""
"Primer, tvoj lastni LibreTranslate doma: naslov http://192.168.1.50:5000/"
"translate, metoda POST, telo JSON {\\\"q\\\": \\\"{text}\\\", \\\"source\\"
"\": \\\"{sursa}\\\", \\\"target\\\": \\\"{tinta}\\\", \\\"format\\\": \\"
"\"text\\\"}, odgovor JSON, pot translatedText."

msgid ""
"Exemplu, un LibreTranslate al tău din casă: adresa http://192.168.1.50:5000/"
"translate, metoda POST, corpul JSON {\"q\": \"{text}\", \"source\": "
"\"{sursa}\", \"target\": \"{tinta}\", \"format\": \"text\"}, răspunsul JSON, "
"calea translatedText. Fiecare rând de subtitrare pleacă într-o cerere "
"separată. Dacă proba nu merge, mesajul arată începutul răspunsului "
"serverului."
msgstr ""
"Primer, tvoj lastni LibreTranslate doma: naslov http://192.168.1.50:5000/"
"translate, metoda POST, telo JSON {\"q\": \"{text}\", \"source\": "
"\"{sursa}\", \"target\": \"{tinta}\", \"format\": \"text\"}, odgovor JSON, "
"pot translatedText. Vsaka vrstica podnapisov gre v ločenem zahtevku. Če "
"preizkus ne deluje, sporočilo prikaže začetek odgovora strežnika."

