msgstr "Ročno vpisane koordinate"

msgid "Copia aceasta nu există."
msgstr "Ta kopija ne obstaja."

msgid "Copia aleasă nu are așa ceva."
msgstr "Izbrana kopija tega ne vsebuje."

msgid "Copia aleasă nu mai era pe mediu la repornire; nu s-a pus nimic la loc."
msgstr ""
"Izbrane kopije ob ponovnem zagonu ni bilo več na mediju; nič ni bilo "
"obnovljeno."

msgid "Copia aleasă nu mai este în listă. Caută din nou."
msgstr "Izbrane kopije ni več na seznamu. Išči znova."

msgid ""
"Copia are canalele, buchetele, listele DAB+ și DVB-T2, setările, rețeaua și "
"Wi-Fi, cheile SSH și modulele de acces condiționat. După o actualizare, "
"imaginea nouă o pune singură la loc la prima pornire, dacă stickul e băgat."
msgstr ""
"Kopija vsebuje kanale, pakete, sezname DAB+ in DVB-T2, nastavitve, omrežje "
"in Wi-Fi, ključe SSH in module pogojnega dostopa. Po posodobitvi jo nova "
"image ob prvem zagonu sama obnovi, če je USB ključ vstavljen."

msgid "Copia are mai multe piconuri decât încap; am adus o parte."
msgstr ""
"Varnostna kopija ima več piconov, kot jih je mogoče shraniti; prenesel sem "
"del."

msgid ""
"Copia are numai lamedb5, pe care această imagine nu îl citește: lista de "
"canale a rămas cea de dinainte."
msgstr ""
"Kopija vsebuje samo lamedb5, ki ga ta image ne bere: seznam kanalov je ostal "
"prejšnji."

msgid ""
"Copia are parolele Wi-Fi și setările modulelor de acces condiționat: ține "
"stickul la tine."
msgstr ""
"Kopija vsebuje gesla za Wi-Fi in nastavitve modulov za pogojni dostop: imej "
"USB ključ pri sebi."

msgid "Copia automată"
msgstr "Samodejna kopija"

msgid "Copia automată e oprită."
msgstr "Samodejna kopija je izklopljena."

msgid ""
"Copia automată merge pe stickul de actualizare, dacă e băgat, altfel pe "
"primul stick sau disc găsit."
msgstr ""
"Samodejna kopija gre na posodobitveni ključ USB, če je vtaknjen, sicer na "
"prvi najdeni ključ USB ali disk."

msgid ""
"Copia automată merge pe stickul de actualizare, dacă e băgat, altfel pe "
"primul stick sau disc găsit. Copiile făcute de mână nu se șterg singure."
msgstr ""
"Samodejna kopija gre na posodobitveni USB ključ, če je vstavljen, sicer na "
"prvi najdeni ključ ali disk. Ročno narejene kopije se ne izbrišejo same."

msgid "Copia automată oprită"
msgstr "Samodejna kopija izklopljena"

msgid "Copia automată pornită"
msgstr "Samodejna kopija vklopljena"

