msgid ""
"Înapoi la culorile din paletă. Se văd pe televizor după repornirea "
"interfeței."
msgstr ""
"Nazaj na barve iz palete. Prikažejo se na televizorju po ponovnem zagonu "
"vmesnika."

msgid "Înapoi la editor"
msgstr "Nazaj na urejevalnik"

msgid "Înapoi la imaginea din memoria internă"
msgstr "Nazaj na image v notranjem pomnilniku"

msgid "Înapoi la implicite"
msgstr "Nazaj na privzeto"

msgid "Înapoi la import"
msgstr "Nazaj na uvoz"

msgid "Înapoi la lista de canale"
msgstr "Nazaj na seznam kanalov"

msgid "Înapoi la meniu"
msgstr "Nazaj v meni"

msgid "Înapoi la pagină"
msgstr "Nazaj na stran"

msgid "Înapoi la panou"
msgstr "Nazaj na ploščo"

msgid "Înapoi, pune înapoi sau ieși"
msgstr "Nazaj, vrni nazaj ali izstopi"

msgid "Încarcă de pe calculator"
msgstr "Naloži z računalnika"

msgid "Încarcă lista"
msgstr "Naloži seznam"

msgid "Încarcă un model pe server și încearcă din nou."
msgstr "Naloži model na strežnik in poskusi znova."

msgid "Încarcă în listă"
msgstr "Naloži v seznam"

msgid "Încearcă canalele"
msgstr "Preizkusi kanale"

msgid "Încearcă din nou"
msgstr "Poskusi znova"

msgid "Încearcă din nou cu regiunea aleasă"
msgstr "Poskusi znova z izbrano regijo"

msgid "Încearcă din nou."
msgstr "Poskusi znova."

msgid "Încearcă din nou; dacă se repetă, repornește receptorul."
msgstr "Poskusi znova; če se ponovi, znova zaženi sprejemnik."

msgid ""
"Încearcă fiecare sursă cu datele scrise și spune dacă merge și câte "
"descărcări mai sunt azi."
msgstr ""
"Preizkusi vsak vir z vnesenimi podatki in pove, ali deluje ter koliko "
"prenosov je še danes."

msgid "Încearcă pe televizor"
msgstr "Preizkusi na televizorju"

msgid ""
"Încearcă un model mai mic sau alt serviciu (Gemini, gratuit, fără card)."
msgstr ""
"Poskusi z manjšim modelom ali drugo storitvijo (Gemini, brezplačno, brez "
"kartice)."

msgid "Începe cu"
msgstr "Začne se z"

msgid "Începe din nou"
msgstr "Začni znova"

msgid "Începe din ziua"
msgstr "Začne z dnem"

msgid "Începe o înregistrare."
msgstr "Začenja se snemanje."

msgid "Începutul ieșirii care nu s-a putut citi:"
msgstr "Začetek izhoda, ki ga ni bilo mogoče prebrati:"

