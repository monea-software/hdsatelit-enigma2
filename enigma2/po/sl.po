#, python-format
msgid ""
"Chei SSH pe receptor: %d. Calculatoarele cu aceste chei intră fără parolă."
msgstr ""
"SSH ključi na sprejemniku: %d. Računalniki s temi ključi se prijavijo brez "
"gesla."

msgid "Chei SSH pe receptor: niciuna."
msgstr "SSH ključi na sprejemniku: noben."

#, python-format
msgid "Chei adăugate: %d. Erau deja: %d. Refuzate: %d."
msgstr "Dodani ključi: %d. Že prisotni: %d. Zavrnjeni: %d."

msgid ""
"Chei și indici despărțiți prin punct, de exemplu translatedText sau data.0."
"text; * ia toate elementele, lipite în ordine. Albastru: exemplul."
msgstr ""
"Ključi in indeksi ločeni s piko, na primer translatedText ali data.0.text; * "
"vzame vse elemente, združene po vrsti. Modra: primer."

msgid ""
"Chei și numere (de la 0) despărțite prin punct, de exemplu translatedText "
"sau data.translations.0.translatedText; * ia toate elementele, lipite în "
"ordine (de exemplu 0.*.0)."
msgstr ""
"Ključi in številke (od 0), ločeni s piko, na primer translatedText ali data."
"translations.0.translatedText; * vzame vse elemente, združene po vrsti (na "
"primer 0.*.0)."

msgid "Cheia"
msgstr "Ključ"

#, python-format
msgid "Cheia %s nu este bună."
msgstr "Ključ %s ni veljaven."

msgid "Cheia API"
msgstr "Ključ API"

msgid ""
"Cheia API din panoul contului tău SubDL. Parola contului SubDL nu se cere."
msgstr ""
"Ključ API s plošče tvojega računa SubDL. Geslo računa SubDL ni potrebno."

msgid ""
"Cheia API din profilul tău de pe subs.ro. Fiecare cheie are o cotă de cereri "
"pe zi."
msgstr ""
"Ključ API iz tvojega profila na subs.ro. Vsak ključ ima dnevno kvoto zahtev."

#, python-format
msgid "Cheia API pentru %s"
msgstr "Ključ API za %s"

#, python-format
msgid ""
"Cheia RSA are %d de biți. Receptorul primește numai chei RSA de cel puțin %d "
"de biți."
msgstr ""
"Ključ RSA ima %d bitov. Sprejemnik sprejme samo ključe RSA z vsaj %d bitov."

msgid "Cheia SubDL merge."
msgstr "Ključ SubDL deluje."

msgid "Cheia a fost ștearsă."
msgstr "Ključ je bil izbrisan."

msgid ""
"Cheia a fost ștearsă. Calculatorul cu această cheie intră de acum numai cu "
"parola."
msgstr ""
"Ključ je bil izbrisan. Računalnik s tem ključem se zdaj prijavi samo z "
"geslom."

msgid ""
"Cheia apare în portal; o poți verifica la „Test your API Key”. Aici scrie "
"adresa https://libretranslate.com și lipește cheia."
msgstr ""
"Ključ se prikaže na portalu; preveriš ga lahko pod »Test your API Key«. "
"Tukaj vpiši naslov https://libretranslate.com in prilepi ključ."

msgid ""
"Cheia aplicației HD Satelit la OpenSubtitles. O dă HD Satelit; nu e cheia "
"contului tău."
msgstr ""
"Ključ aplikacije HD Satelit pri OpenSubtitles. Zagotavlja ga HD Satelit; ni "
"ključ tvojega računa."

msgid "Cheia aplicației OpenSubtitles lipsește; o pune HD Satelit."
msgstr "Manjka ključ aplikacije OpenSubtitles; zagotovi ga HD Satelit."

msgid ""
"Cheia are caractere care nu pot fi într-o cheie (sau e prea lungă). Nu s-a "
"schimbat nimic."
msgstr ""
"Ključ vsebuje znake, ki ne smejo biti v ključu (ali je predolg). Nič se ni "
"spremenilo."

msgid "Cheia are caractere care nu pot fi într-o cheie, sau e prea lungă."
msgstr "Ključ vsebuje znake, ki v ključu ne smejo biti, ali pa je predolg."

msgid ""
"Cheia are caractere care nu pot fi într-o cheie, sau e prea lungă. Copiaz-o "
"din nou, întreagă."
msgstr ""
"Ključ vsebuje znake, ki v ključu ne smejo biti, ali pa je predolg. Ponovno "
"ga v celoti kopiraj."

msgid "Cheia cere regiunea resursei Azure."
msgstr "Ključ zahteva regijo vira Azure."

#, python-format
msgid "Cheia e bună și e salvată, cu %s, dar cota s-a terminat."
msgstr ""
"Ključ je pravilen in shranjen, s storitvijo %s, vendar je kvota porabljena."

msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota (la Azure, luna următoare)."
msgstr ""
"Ključ je pravilen, vendar je kvota porabljena. Prevod bo spet deloval, ko se "
"kvota obnovi (pri Azure naslednji mesec)."

msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota (la Gemini, de obicei a doua zi, în jurul orei 10, ora României)."
msgstr ""
"Ključ je pravilen, vendar je kvota porabljena. Prevod bo spet deloval, ko se "
"kvota obnovi (pri Gemini običajno naslednji dan okoli 10. ure po romunskem "
"času)."

msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota."
msgstr ""
"Ključ je pravilen, vendar je kvota porabljena. Prevod bo spet deloval, ko se "
"kvota obnovi."

msgid ""
"Cheia e bună, dar în proiectul ei nu e pornit „Cloud Translation API”. În "
"Google Cloud (console.cloud.google.com) mergi la „APIs & Services”, caută "
"„Cloud Translation API”, apasă „Enable”, așteaptă câteva minute și încearcă "
"din nou."
msgstr ""
"Ključ je pravilen, vendar v njegovem projektu ni vklopljen »Cloud "
"Translation API«. V Google Cloud (console.cloud.google.com) pojdi na »APIs & "
"Services«, poišči »Cloud Translation API«, pritisni »Enable«, počakaj nekaj "
"minut in poskusi znova."

msgid "Cheia e opțională: numai dacă serverul cere cheie."
msgstr "Ključ je neobvezen: samo če strežnik zahteva ključ."

msgid "Cheia e prea lungă. Nu s-a pornit nimic."
msgstr "Ključ je predolg. Nič se ni zagnalo."

msgid "Cheia e prea lungă. Nu s-a schimbat nimic."
msgstr "Ključ je predolg. Nič se ni spremenilo."

msgid "Cheia e salvată pe receptor."
msgstr "Ključ je shranjen na sprejemniku."

msgid "Cheia e stricată (textul de după tip nu e o cheie întreagă)."
msgstr "Ključ je poškodovan (besedilo za tipom ni celoten ključ)."

msgid ""
"Cheia nouă pentru panoul web e făcută. Din rețeaua locală, telefoanele și "
"browserele intră din nou fără cod, ca până acum."
msgstr ""
"Nov ključ za spletno ploščo je ustvarjen. Iz lokalnega omrežja telefoni in "
"brskalniki spet vstopijo brez kode, kot doslej."

msgid ""
"Cheia nouă pentru panoul web e făcută. Fiecare telefon și browser cere din "
"nou codul de pe televizor: Albastru, apoi Conectează un browser nou."
msgstr ""
"Nov ključ za spletno ploščo je ustvarjen. Vsak telefon in brskalnik znova "
"zahteva kodo s televizorja: Modra, nato Poveži nov brskalnik."

msgid "Cheia nouă pentru panoul web e făcută. Pagina se încarcă din nou."
msgstr "Nov ključ za spletno ploščo je ustvarjen. Stran se znova naloži."

msgid "Cheia nouă pentru scripturi e făcută. Pagina se încarcă din nou."
msgstr "Novi ključ za skripte je ustvarjen. Stran se znova naloži."

#, python-format
msgid "Cheia nu a mers la %s."
msgstr "Ključ pri %s ni deloval."

msgid "Cheia nu mai era pe receptor."
msgstr "Ključa ni bilo več na sprejemniku."

msgid "Cheia nu pleacă pe http:// spre internet. Scrie adresa cu https://."
msgstr "Ključ se ne pošilja po http:// v internet. Naslov napiši s https://."

msgid "Cheia nu s-a putut salva pe receptor."
msgstr "Ključa ni bilo mogoče shraniti na sprejemniku."

msgid ""
"Cheia nu se trimite în adresă: adresa rămâne în istoricul browserului și în "
"jurnale. Lipește-o în pagină. Nu s-a salvat și nu s-a pornit nimic."
msgstr ""
"Ključ se ne pošlje v naslovu: naslov ostane v zgodovini brskalnika in v "
"dnevnikih. Prilepi ga na stran. Nič se ni shranilo in nič se ni zagnalo."

msgid ""
"Cheia nu se trimite în adresă: adresa rămâne în istoricul browserului și în "
"jurnale. Trimite-o în corpul cererii POST. Nu s-a salvat nimic."
msgstr ""
"Ključ se ne pošlje v naslovu: naslov ostane v zgodovini brskalnika in v "
"dnevnikih. Pošlji ga v telesu zahteve POST. Nič se ni shranilo."

msgid ""
"Cheia o faci cu contul tău Google. La subtitrări continue poate da „prea "
"multe cereri”."
msgstr ""
"Ključ ustvariš s svojim Google računom. Pri neprekinjenih podnapisih lahko "
"javi »preveč zahtev«."

msgid ""
"Cheia o faci cu emailul sau cu contul tău Google. Pune și o rezervă pentru "
"zilele cu multe subtitrări."
msgstr ""
"Ključ ustvariš z e-pošto ali s svojim Google računom. Nastavi tudi rezervo "
"za dneve z veliko podnapisi."

#, python-format
msgid "Cheia pentru %s e salvată ca rezervă; traducerea rămâne pe %s."
msgstr "Ključ za %s je shranjen kot rezerva; prevod ostane pri %s."

msgid "Cheia pentru scripturi"
msgstr "Ključ za skripte"

msgid ""
"Cheia pleacă numai spre adresa serverului de acum: scrie întâi adresa, apoi "
"pune cheia."
msgstr ""
"Ključ se pošlje samo na trenutni naslov strežnika: najprej napiši naslov, "
"nato vnesi ključ."

msgid ""
"Cheia pleacă numai spre receptor, se păstrează criptată și nu se mai arată "
"niciodată."
msgstr ""
"Ključ se pošlje samo sprejemniku, shrani se šifrirano in se nikoli več ne "
"prikaže."

msgid ""
"Cheia salvată a fost pusă pentru alt server (%s), deci nu pleacă spre adresa "
"de acum. Dacă serverul cere cheie, pune-o din nou."
msgstr ""
"Shranjeni ključ je bil vnesen za drug strežnik (%s), zato se ne pošlje na "
"trenutni naslov. Če strežnik zahteva ključ, ga vnesi znova."

msgid ""
"Cheia salvată nu e legată de adresa de acum, deci nu pleacă nicăieri. Dacă "
"serverul cere cheie, pune-o din nou."
msgstr ""
"Shranjeni ključ ni vezan na trenutni naslov, zato se nikamor ne pošlje. Če "
"strežnik zahteva ključ, ga vnesi znova."

msgid ""
"Cheia sau regiunea nu se potrivesc: verifică amândouă în portal (Keys and "
"Endpoint)."
msgstr ""
"Ključ in regija se ne ujemata: preveri oba na portalu (Keys and Endpoint)."

msgid "Cheia se păstrează pe receptor, criptată; nu se mai arată niciodată."
msgstr "Ključ se hrani na sprejemniku, šifrirano; nikoli več se ne prikaže."

msgid "Cheia se trimite numai cu POST, din pagină. Nu s-a salvat nimic."
msgstr "Ključ se pošlje samo s POST, s strani. Nič se ni shranilo."

msgid "Cheia se trimite numai cu POST, în corpul cererii. Nu s-a salvat nimic."
msgstr "Ključ se pošlje samo s POST, v telesu zahteve. Nič se ni shranilo."

#, python-format
msgid "Cheia subs.ro merge. Cererile rămase azi: %s din %s."
msgstr "Ključ subs.ro deluje. Preostale zahteve danes: %s od %s."

msgid ""
"Cheia, adresa sau modelul unei rezerve se pun alegând-o pe rând la "
"„Serviciul” (sau din configurarea pas cu pas)."
msgstr ""
"Ključ, naslov ali model rezervne storitve se nastavi tako, da ga izbereš po "
"vrsti pri »Storitev« (ali v postopni nastavitvi)."

msgid "Cheie nouă pentru panoul web"
msgstr "Nov ključ za spletno ploščo"

msgid "Cheie nouă pentru scripturi"
msgstr "Nov ključ za skripte"

#, python-format
msgid "Cheie pentru scripturi (doar pentru programatori): %s"
msgstr "Ključ za skripte (samo za programerje): %s"

msgid "Cheie pusă"
msgstr "Ključ nastavljen"

msgid ""
"Cheie pusă pentru alt server (%s): nu pleacă spre adresa de acum. Pune-o din "
"nou."
msgstr ""
"Ključ je nastavljen za drug strežnik (%s): ne pošlje se na trenutni naslov. "
"Vnesi ga znova."

msgid ""
"Cheie pusă, dar nelegată de adresa de acum: nu pleacă nicăieri. Pune-o din "
"nou."
msgstr ""
"Ključ je nastavljen, vendar ni vezan na trenutni naslov: nikamor se ne "
"pošlje. Vnesi ga znova."

msgid ""
"Cheie pusă, dar nu pleacă pe http:// spre internet. Scrie adresa cu https://."
msgstr ""
"Ključ je nastavljen, vendar se ne pošilja po http:// v internet. Naslov "
"napiši s https://."

msgid "Cheile DSA nu mai sunt primite: sunt prea slabe. Fă o cheie Ed25519."
msgstr "Ključi DSA niso več sprejeti: prešibki so. Ustvari ključ Ed25519."

msgid "Cheile SSH"
msgstr "Ključi SSH"

msgid "Cheile SSH din copie nu au forma obișnuită; nu s-au pus la loc."
msgstr "Ključi SSH v kopiji nimajo običajne oblike; niso bili obnovljeni."

msgid ""
"Cheile de traducere trebuie puse din nou: cele salvate înainte nu se mai pot "
"citi pe acest receptor."
msgstr ""
"Prevajalske ključe je treba vnesti znova: prej shranjenih na tem sprejemniku "
"ni več mogoče prebrati."

msgid ""
"Cheile de traducere trebuie puse din nou: cele salvate înainte nu se mai pot "
"citi pe acest receptor. Le pui în Meniu › Setări › Sunet și subtitrări › "
"Traducerea subtitrărilor sau de pe telefon, cu codul QR de acolo."
msgstr ""
"Prevajalske ključe je treba vnesti znova: prej shranjenih na tem sprejemniku "
"ni več mogoče prebrati. Vneseš jih v Meni › Nastavitve › Zvok in podnapisi › "
"Prevod podnapisov ali s telefona, s kodo QR, ki je tam."

msgid "Chenarul pe selecție"
msgstr "Okvir okoli izbire"

