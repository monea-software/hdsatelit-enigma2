msgstr "Varnostna kopija nima omrežnih nastavitev, ki bi jih lahko uporabil."

#, python-format
msgid "Copia nu e întreagă (%s); nu s-a pus nimic la loc."
msgstr "Kopija ni celotna (%s); nič ni bilo obnovljeno."

msgid "Copia nu mai este pe mediu."
msgstr "Kopije ni več na mediju."

msgid "Copia nu mai este pe stick sau pe disc."
msgstr "Kopije ni več na ključu USB ali disku."

msgid "Copia nu mai există."
msgstr "Varnostna kopija ne obstaja več."

msgid ""
"Copia nu s-a putut pregăti pe receptor (memoria plină sau copia stricată); "
"nu s-a pus nimic la loc."
msgstr ""
"Kopije na sprejemniku ni bilo mogoče pripraviti (poln pomnilnik ali "
"poškodovana kopija); nič ni bilo obnovljeno."

msgid "Copia nu s-a putut reîmprospăta."
msgstr "Kopije ni bilo mogoče osvežiti."

msgid "Copia nu s-a putut salva."
msgstr "Kopije ni bilo mogoče shraniti."

#, python-format
