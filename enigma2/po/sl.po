msgstr ""
"Kopija ni bila osvežena: v %(minute)d minutah teletekst kanala ni bil v "
"celoti zbran. Zbranih strani: %(pagini)d."

#, python-format
msgid ""
"Copia nu s-a reîmprospătat: în %(secunde)d de secunde canalul nu a trimis "
"nicio pagină de teletext (fără semnal sau fără teletext)."
msgstr ""
"Kopija ni bila osvežena: v %(secunde)d sekundah kanal ni poslal nobene "
"strani teleteksta (brez signala ali brez teleteksta)."

msgid "Copia nu se mai pune la loc."
msgstr "Kopija se ne bo več obnovila."

msgid "Copia nu se poate citi."
msgstr "Kopije ni mogoče prebrati."

#, python-format
msgid "Copia s-a oprit: %s."
msgstr "Kopija se je ustavila: %s."

