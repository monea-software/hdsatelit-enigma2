msgid "Numele contului VPN"
msgstr "VPN konta vārds"

msgid ""
"Numele cu care apare în listă și în fișierul înregistrării. OK deschide "
"tastatura."
msgstr ""
"Nosaukums, ar kādu tas parādās sarakstā un ieraksta failā. OK atver "
"tastatūru."

msgid "Numele cu care apari pe forum și pe site."
msgstr "Vārds, ar kuru tu parādies forumā un vietnē."

msgid ""
"Numele de utilizator al contului tău OpenSubtitles.com (nu adresa de e-"
"mail). Un cont gratuit dă 20 de descărcări pe zi."
msgstr ""
"Tava OpenSubtitles.com konta lietotājvārds (ne e-pasta adrese). Bezmaksas "
"konts dod 20 lejupielādes dienā."

msgid "Numele de utilizator nu poate conține virgule sau rânduri noi."
msgstr "Lietotājvārds nedrīkst saturēt komatus vai jaunas rindiņas."

msgid ""
"Numele de utilizator sau parola nu sunt bune, ori utilizatorul nu are voie "
"în acest dosar."
msgstr ""
"Lietotājvārds vai parole ir nepareiza, vai lietotājam nav piekļuves šai "
"mapei."

msgid "Numele dosarului nou"
msgstr "Jaunās mapes nosaukums"

msgid "Numele e cel al programului care rulează."
msgstr "Nosaukums ir darbojošās programmas nosaukums."

msgid "Numele e cel din cererea lui de parolă."
msgstr "Nosaukums ir no tā paroles pieprasījuma."

msgid "Numele e cel din pachetul lui."
msgstr "Nosaukums ir no tā pakotnes."

msgid "Numele e cel din scriptul lui de pornire."
msgstr "Nosaukums ir no tā starta skripta."

msgid "Numele e cel trimis de serverul lui."
msgstr "Nosaukums ir tas, ko nosūta tā serveris."

msgid "Numele e deja folosit. Alege altul."
msgstr "Vārds jau tiek lietots. Izvēlies citu."

msgid ""
"Numele e gol sau are numai semne (punct, liniuță, spații). Unele pot fi "
"fluxuri care pornesc numai uneori: uită-te la frecvență și la imagine / "
"sunet."
msgstr ""
"Nosaukums ir tukšs vai satur tikai simbolus (punktu, domuzīmi, atstarpes). "
"Daži var būt plūsmas, kas raida tikai reizēm: paskaties frekvenci un "
"attēlu / skaņu."

msgid "Numele e salvat."
msgstr "Vārds ir saglabāts."

msgid "Numele e titlul paginii lui."
msgstr "Nosaukums ir tā lapas virsraksts."

msgid "Numele filmului"
msgstr "Filmas nosaukums"

msgid ""
"Numele fișierului nu e bun sau playerul nu cunoaște acest fel de fișier."
msgstr "Faila nosaukums nav derīgs vai atskaņotājs nepazīst šādu faila tipu."

msgid "Numele fișierului nu se poate citi"
msgstr "Faila nosaukumu nevar nolasīt"

msgid ""
"Numele fișierului nu se poate citi pe receptor. Redenumește-l fără "
"diacritice."
msgstr ""
"Faila nosaukumu nevar nolasīt uztvērējā. Pārdēvē to bez diakritiskajām zīmēm."

msgid "Numele fluxului"
msgstr "Straumējuma vārds"

msgid "Numele fontului"
msgstr "Fonta nosaukums"

msgid "Numele fontului, de exemplu Roboto"
msgstr "Fonta nosaukums, piemēram, Roboto"

msgid "Numele marcajului"
msgstr "Marķiera nosaukums"

msgid "Numele modelului de pe server, de exemplu gemma3:4b sau qwen2.5:7b."
msgstr "Modeļa nosaukums serverī, piemēram, gemma3:4b vai qwen2.5:7b."

msgid ""
"Numele modelului e prea lung sau are caractere nepermise. Nu s-a pornit "
"nimic."
msgstr ""
"Modeļa nosaukums ir pārāk garš vai satur neatļautas rakstzīmes. Nekas netika "
"ieslēgts."

msgid "Numele modelului nu e bun."
msgstr "Modeļa nosaukums nav pareizs."

msgid "Numele modulelor: %s"
msgstr "Moduļu nosaukumi: %s"

msgid "Numele nou"
msgstr "Jauns nosaukums"

#, python-format
msgid "Numele nu este bun (cel mult %d semne, pe un singur rând)."
msgstr "Vārds nav derīgs (ne vairāk par %d zīmēm, vienā rindā)."

msgid "Numele nu poate fi gol."
msgstr "Vārds nevar būt tukšs."

msgid "Numele nu se poate schimba încă de aici."
msgstr "Vārdu vēl nevar mainīt no šejienes."

msgid "Numele pachetului nu este valid. Nu se instalează."
msgstr "Pakotnes nosaukums nav derīgs. Tas netiek instalēts."

msgid "Numele pachetului nu este valid. Nu se șterge."
msgstr "Pakotnes nosaukums nav derīgs. Tas netiek dzēsts."

msgid "Numele paginii (dacă vrei)"
msgstr "Lapas nosaukums (ja vēlies)"

#, python-format
msgid "Numele pe televizor: %s, cerut de televizor la %s."
msgstr "Vārds televizorā: %s, televizors to pieprasīja %s."

#, python-format
msgid "Numele pe televizor: %s."
msgstr "Vārds televizorā: %s."

msgid "Numele plăcii de sunet are numai litere, cifre și : , _ - ."
msgstr "Skaņas ierīces nosaukumā ir tikai burti, cipari un : , _ - ."

msgid ""
"Numele poate avea doar litere mici, cifre și semnele - _ . (cel mult 32)."
msgstr ""
"Nosaukumā drīkst būt tikai mazie burti, cipari un zīmes - _ . (ne vairāk kā "
"32)."

msgid "Numele postului de radio"
msgstr "Radio stacijas nosaukums"

msgid "Numele public"
msgstr "Publiskais vārds"

msgid "Numele public are 2-40 de semne: litere, cifre, spațiu, punct, liniuță."
msgstr ""
"Publiskajam vārdam ir 2-40 rakstzīmju: burti, cipari, atstarpe, punkts, "
"defise."

msgid "Numele public e deja folosit de alt tester. Alege altul."
msgstr "Publiskais vārds jau tiek lietots citam testētājam. Izvēlies citu."

msgid "Numele receptorului"
msgstr "Uztvērēja nosaukums"

msgid "Numele receptorului pe televizor"
msgstr "Uztvērēja vārds televizorā"

msgid "Numele rețelei ascunse"
msgstr "Slēptā tīkla nosaukums"

msgid "Numele satelitului"
msgstr "Satelīta nosaukums"

msgid "Numele satelitului are un caracter care nu se poate scrie în listă."
msgstr "Satelīta nosaukumā ir rakstzīme, ko nevar ierakstīt sarakstā."

msgid "Numele satelitului e prea lung: cel mult %d de caractere."
msgstr "Satelīta nosaukums ir pārāk garš: ne vairāk kā %d rakstzīmes."

msgid "Numele sau parola nu sunt bune. VPN-ul nu mai încearcă singur."
msgstr "Vārds vai parole nav derīgi. VPN vairs nemēģina pats."

msgid "Numele serverului NTP nu este valid."
msgstr "NTP servera nosaukums nav derīgs."

msgid ""
"Numele serverului nu se găsește în rețea. Scrie adresa lui, de pildă "
"192.168.1.20."
msgstr ""
"Servera nosaukums tīklā nav atrodams. Ieraksti tā adresi, piemēram, "
"192.168.1.20."

msgid "Numele setării, cu tastele 0-9"
msgstr "Iestatījuma nosaukums, ar taustiņiem 0-9"

msgid ""
"Numele spune HD sau 4K, dar emițătorul îl anunță ca SD: filtrul „HD și 4K” "
"nu-l prinde. Filtrul „HD în nume, tip SD” din „Adaugă canale” le arată pe "
"toate, cu bife."
msgstr ""
"Nosaukums saka HD vai 4K, bet raidītājs to paziņo kā SD: filtrs „HD un 4K” "
"to neuztver. Filtrs „HD nosaukumā, SD tips” sadaļā „Pievienot kanālus” rāda "
"tos visus, ar atzīmēm."

msgid "Numele sursei (litere mici, cifre și -)"
msgstr "Avota nosaukums (mazie burti, cipari un -)"

msgid "Numele sursei nu poate fi gol."
msgstr "Avota nosaukums nevar būt tukšs."

msgid "Numele sursei: litere mici, cifre și -"
msgstr "Avota nosaukums: mazie burti, cipari un -"

msgid "Numele telecomenzii"
msgstr "Pults nosaukums"

msgid "Numele telecomenzii nu poate fi gol."
msgstr "Tālvadības pults nosaukums nevar būt tukšs."

msgid "Numele tău pe forum"
msgstr "Tavs vārds forumā"

msgid "Numele tău pe forum e acum „%s”."
msgstr "Tavs vārds forumā tagad ir „%s“."

msgid "Numele și parola au fost șterse de pe receptor."
msgstr "Vārds un parole tika dzēsti no uztvērēja."

msgid "Numele și parola contului"
msgstr "Konta vārds un parole"

msgid ""
"Numele și parola contului HMA. După salvare nu se mai arată nicăieri. Se "
"scriu mai ușor din telefon, în interfața web."
msgstr ""
"HMA konta vārds un parole. Pēc saglabāšanas tie vairs nekur netiek rādīti. "
"Tos ērtāk ievadīt no tālruņa tīmekļa saskarnē."

msgid "Numele și parola de serviciu"
msgstr "Servisa vārds un parole"

msgid "Numele și parola din fișier nu se folosesc: se scriu pe receptor."
msgstr "Failā esošais vārds un parole netiek izmantoti: tos ievada uztvērējā."

msgid "Numele și parola sunt salvate. Nu se mai arată nicăieri."
msgstr "Vārds un parole ir saglabāti. Tie vairs nekur netiek rādīti."

msgid "Numele, cu tastatura de pe ecran"
msgstr "Nosaukums, ar ekrāna tastatūru"

msgid "Numele, cu tastele 0-9"
msgstr "Nosaukums ar taustiņiem 0-9"

msgid ""
"Numerele DVB ale fluxului (pentru siglă): SID, TSID, ONID, namespace (hex)"
msgstr "Straumes DVB numuri (logotipam): SID, TSID, ONID, namespace (hex)"

msgid "Număr de fișiere"
msgstr "Failu skaits"

msgid "Numărate de la ora"
msgstr "Skaitīti no"

msgid "Numărul canalului"
msgstr "Kanāla numurs"

msgid "Numărul canalului din lista de canale."
msgstr "Kanāla numurs no kanālu saraksta."

#, python-format
msgid "Numărul copiilor păstrate trebuie să fie între 1 și %d."
msgstr "Saglabājamo kopiju skaitam jābūt no 1 līdz %d."

msgid "Numărul de bare"
msgstr "Joslu skaits"

msgid "Numărul de secunde nu este bun."
msgstr "Sekunžu skaits nav derīgs."

msgid "Numărul din lista de canale, cel la care duc cifrele telecomenzii."
msgstr "Numurs no kanālu saraksta, uz kuru ved pults cipari."

msgid ""
"Numărul mare nu înseamnă procesor ocupat: include firele driverelor care "
"așteaptă."
msgstr ""
"Liels skaitlis nenozīmē noslogotu procesoru: tas ietver draiveru pavedienus, "
"kas gaida."

msgid "Numărul operatorului"
msgstr "Operatora numurs"

msgid "Numărul poziției (1-255)"
msgstr "Pozīcijas numurs (1-255)"

#, python-format
msgid "Numărul procesului (PID): %s"
msgstr "Procesa numurs (PID): %s"

msgid "Numărul rețelei (ONID)"
msgstr "Tīkla numurs (ONID)"

msgid "Numărul transponderului (TSID)"
msgstr "Transpondera numurs (TSID)"

msgid "Numărul și numele"
msgstr "Nr. un nosauk"

msgid "Numărătoarea opririlor"
msgstr "Apturēšanas skaitītājs"

msgid ""
"O adresă http:// merge numai pentru un server din rețeaua de acasă (de "
"exemplu 192.168.1.50); pentru un server de pe internet scrie https://."
msgstr ""
"http:// adrese der tikai serverim mājas tīklā (piemēram, 192.168.1.50); "
"interneta serverim raksti https://."

msgid ""
"O altă placă e deja configurată. Pe televizor, aceeași întrebare apare la OK."
msgstr ""
"Cita plate jau ir konfigurēta. Televizorā tas pats jautājums parādās pie OK."

msgid "O altă schimbare a rețelei încă lucrează. Așteaptă să se termine."
msgstr "Cita tīkla maiņa vēl darbojas. Pagaidi, līdz tā beigsies."

msgid "O altă schimbare de LNB așteaptă confirmarea."
msgstr "Cita LNB izmaiņa gaida apstiprinājumu."

msgid "O altă valoare a receptorului nu se potrivește."
msgstr "Cita uztvērēja vērtība nesakrīt."

msgid "O captură aleasă nu mai există. Alege din nou."
msgstr "Izvēlētais ekrānuzņēmums vairs nav. Izvēlies vēlreiz."

msgid ""
"O cheie pleacă numai pe https:// sau spre un server din rețeaua de acasă. "
"Scrie adresa cu https://. Cheia nu a plecat nicăieri."
msgstr ""
"Atslēga tiek sūtīta tikai pa https:// vai uz serveri mājas tīklā. Ieraksti "
"adresi ar https://. Atslēga nekur netika nosūtīta."

msgid "O conectare Wi-Fi încă lucrează. Așteaptă să se termine sau oprește-o."
msgstr ""
"Wi-Fi savienošana vēl darbojas. Pagaidi, līdz tā beigsies, vai apturi to."

msgid "O copie așteaptă să fie pusă la loc la repornirea interfeței."
msgstr "Kopija gaida atjaunošanu, kad saskarne pārstartēsies."

msgid "O copie se face deja. Așteaptă să se termine."
msgstr "Kopija jau tiek veidota. Uzgaidi, līdz tā beigsies."

msgid ""
"O copie se face singură înainte de fiecare salvare, aici și în interfața "
"web. Întoarcerea pune întâi lista de acum într-o copie nouă."
msgstr ""
"Kopija tiek izveidota automātiski pirms katras saglabāšanas, šeit un tīmekļa "
"saskarnē. Atgriešana vispirms ievieto pašreizējo sarakstu jaunā kopijā."

msgid "O cutie pentru toate rândurile"
msgstr "Viena kaste visām rindām"

msgid ""
"O căutare e deja în curs pe receptor. Așteaptă să se termine sau oprește-o."
msgstr ""
"Uztvērējā jau notiek meklēšana. Uzgaidi, līdz tā beidzas, vai apturi to."

msgid "O căutare e deja în curs."
msgstr "Meklēšana jau notiek."

msgid "O căutare sau o descărcare merge deja; așteaptă să se termine."
msgstr "Meklēšana vai lejupielāde jau notiek; pagaidi, līdz tā beidzas."

msgid ""
"O data pe zi, in fundal, receptorul ia de pe stb.hdsatelit.com frecventele "
"si numele posturilor. Butonul Actualizeaza lista merge oricand."
msgstr ""
"Reizi dienā, fonā, uztvērējs no stb.hdsatelit.com iegūst frekvences un "
"staciju nosaukumus. Poga „Atjaunināt sarakstu” darbojas jebkurā laikā."

msgid "O dată pe minut"
msgstr "Vienu reizi minūtē"

msgid "O dată pe săptămână"
msgstr "Reizi nedēļā"

msgid ""
"O dată pe zi, noaptea, numai felurile bifate, și imediat după o oprire "
"neașteptată a interfeței sau o actualizare care nu a reușit. Fără bifă "
"pleacă numai ce trimiți tu cu „Trimite acum”."
msgstr ""
"Reizi dienā, naktī, tikai atzīmētos veidus, un uzreiz pēc negaidītas "
"saskarnes apstāšanās vai neizdevušās atjaunināšanas. Bez atzīmes tiek sūtīts "
"tikai tas, ko tu pats sūti ar „Sūtīt tagad”."

msgid ""
"O dată pe zi, în fundal, receptorul ia de pe stb.hdsatelit.com frecvențele "
"și numele posturilor. Butonul „Actualizează lista” merge oricând. <span "
"id=\"ultimaZilnica\"></span>"
msgstr ""
"Reizi dienā, fonā, uztvērējs no stb.hdsatelit.com saņem frekvences un "
"staciju nosaukumus. Poga „Atjaunināt sarakstu” darbojas jebkurā laikā. <span "
"id=\"ultimaZilnica\"></span>"

msgid "O eroare pe receptor."
msgstr "Uztvērējā radās kļūda."

msgid "O greșeală, o idee sau o întrebare, direct echipei."
msgstr "Kļūda, ideja vai jautājums, tieši komandai."

msgid "O lipești, iar receptorul recunoaște singur serviciul."
msgstr "Tu to ielīmē, un uztvērējs pats atpazīst pakalpojumu."

msgid ""
"O listă de redare de pe disc nu se poate șterge din player, nici pe "
"televizor."
msgstr ""
"Atskaņošanas sarakstu no diska nevar dzēst atskaņotājā, pat televizorā."

msgid "O margine e între 0 și 5 la sută din latura ei."
msgstr "Mala ir no 0 līdz 5 procentiem no savas malas garuma."

msgid "O notă despre emisiune. OK deschide tastatura."
msgstr "Piezīme par raidījumu. OK atver tastatūru."

msgid "O pagină mai jos"
msgstr "Par lapu zemāk"

msgid "O pagină mai sus"
msgstr "Par lapu augstāk"

msgid "O pagină în jos"
msgstr "Vienu lapu uz leju"

msgid "O pagină în sus"
msgstr "Vienu lapu uz augšu"

msgid ""
"O poză nu a putut fi urcată: trebuie să fie JPG sau PNG, de cel mult 4 MB."
msgstr ""
"Vienu attēlu nevarēja augšupielādēt: tam jābūt JPG vai PNG, ne vairāk kā 4 "
"MB."

msgid "O poți instala din nou oricând, din aceeași sursă."
msgstr "To vari instalēt atkārtoti jebkurā laikā no tā paša avota."

msgid "O probă DiSEqC e deja deschisă pe televizor. Închide-o întâi."
msgstr "Televizorā jau ir atvērts DiSEqC tests. Vispirms aizver to."

msgid "O reîmprospătare e deja în lucru."
msgstr "Atjaunināšana jau notiek."

msgid "O reîncărcare e deja în curs."
msgstr "Pārlādēšana jau notiek."

msgid ""
"O scanare DAB+ sau DVB-T2 e deschisă pe televizor. Așteaptă să se termine "
"sau oprește-o."
msgstr ""
"Televizorā ir atvērta DAB+ vai DVB-T2 skenēšana. Uzgaidi, līdz tā beidzas, "
"vai apturi to."

msgid "O singură dată"
msgstr "Vienreiz"

msgid ""
"O singură dată sau repetat: în fiecare zi, o dată pe săptămână, de luni până "
"vineri sau în zilele alese."
msgstr ""
"Vienreiz vai atkārtoti: katru dienu, reizi nedēļā, no pirmdienas līdz "
"piektdienai vai izvēlētajās dienās."

msgid "O singură limbă: forumul traduce singur."
msgstr "Viena valoda: forums tulko pats."

msgid ""
"O telecomandă USB (sau o tastatură) se bagă în receptor înainte; se vede "
"imediat."
msgstr ""
"USB pulti (vai tastatūru) vispirms pievieno uztvērējam; tā tiek uzreiz "
"atpazīta."

msgid ""
"O telecomandă cu infraroșu, alta decât a receptorului, nu se poate asocia "
"încă."
msgstr "Infrasarkano staru pulti, kas nav uztvērēja, vēl nevar piesaistīt."

msgid "O valoare a transponderului nu e bună: %s."
msgstr "Viena transpondera vērtība nav derīga: %s."

msgid "O înregistrare e în curs."
msgstr "Notiek ierakstīšana."

msgid "O înregistrare e în curs: se oprește la revenire."
msgstr "Notiek ieraksts: tas apstājas atgriežoties."

msgid ""
"O înregistrare folosește acum antena. Comenzile pornesc după ce se termină."
msgstr ""
"Antenu pašlaik izmanto ierakstīšana. Komandas darbosies, kad tā beigsies."

msgid ""
"O înregistrare folosește acum tunerul. Locul se schimbă după ce se termină."
msgstr ""
"Ieraksts tagad izmanto uztvērēju. Atrašanās vieta mainās pēc tā beigām."

msgid "O înregistrare programată nu poate porni: nu am unde să înregistrez."
msgstr "Ieplānots ieraksts nevar sākties: man nav kur ierakstīt."

#, python-format
msgid "O înregistrare scrie acum pe acest disc: %s."
msgstr "Tagad uz šī diska notiek ieraksts: %s."

msgid "O înregistrare începe în curând. Pornește scanarea detaliată după ea."
msgstr "Drīz sāksies ierakstīšana. Sāc detalizēto meklēšanu pēc tās."

#, python-format
msgid "O înregistrare începe în mai puțin de %d minute."
msgstr "Ieraksts sākas mazāk nekā pēc %d minūtēm."

msgid "O înregistrare începe în mai puțin de 6 minute."
msgstr "Ierakstīšana sāksies mazāk nekā pēc 6 minūtēm."

msgid "OK"
msgstr "OK"

msgid "OK = da, EXIT = nu"
msgstr "OK = jā, EXIT = nē"

msgid "OK actualizează · Roșu șterge"
msgstr "OK atjaunina · Sarkanais dzēš"

msgid "OK adaugă"
msgstr "OK pievieno"

msgid ""
"OK adaugă canalul în buchetul din dreapta · cifrele scriu numele · HELP "
"ajutor"
msgstr ""
"OK pievieno kanālu kopai labajā pusē · cipari raksta nosaukumu · HELP "
"palīdzība"

msgid "OK add to playlist, MENU options, CH+ / CH- switch list"
msgstr "OK pievienot sarakstam, MENU opcijas, CH+ / CH− pārslēgt sarakstu"

msgid "OK alege"
msgstr "OK izvēlas"

msgid "OK alege capturile, Verde le pune în mesaj."
msgstr "OK izvēlas ekrānuzņēmumus, Zaļā poga tos pievieno ziņojumam."

msgid "OK alege feedul pachetelor arătate."
msgstr "OK izvēlas parādīto pakotņu padevi."

msgid "OK alege feedul sau felul pachetelor arătate."
msgstr "OK izvēlas padevi vai parādīto pakotņu veidu."

msgid ""
"OK alege latura: toate, sus, dreapta, jos sau stânga. Săgeata spre margine "
"duce latura aleasă spre marginea ecranului, săgeata opusă o aduce spre "
"mijloc. La toate laturile, Sus și Dreapta măresc cadrul, Jos și Stânga îl "
"micșorează. Potrivește cadrul până se vede întreg pe televizor."
msgstr ""
"OK izvēlas malu: visas, augša, labā, apakša vai kreisā. Bultiņa uz malu "
"virza izvēlēto malu uz ekrāna malu, pretējā bultiņa virza uz vidu. Pie visām "
"malām Augšup un Pa labi palielina rāmi, Lejup un Pa kreisi samazina. Pielāgo "
"rāmi, līdz tas viss redzams televizorā."

msgid ""
