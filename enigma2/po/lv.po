msgstr ""
"Šim attēlam vēl nav gatavu kanālu sarakstu. Kanālus atrod ar meklēšanu - "
"satelītā, kabelī vai virszemē - vai pārnes no kopijas USB zibatmiņā."

msgid "Această intrare se deschide numai din telecomandă."
msgstr "Šo vienumu var atvērt tikai no pults."

msgid "Această pistă audio nu se aude în browser."
msgstr "Šis audio celiņš pārlūkprogrammā nav dzirdams."

msgid "Aceeași alegere este pe televizor, în __DRUM_MENIU__."
msgstr "Tāda pati izvēle ir televizorā, sadaļā __DRUM_MENIU__."

msgid "Aceeași listă este pe televizor, la tasta TIMER sau în __DRUM_MENIU__."
msgstr ""
"Tāds pats saraksts ir televizorā, ar pogu TIMER vai sadaļā __DRUM_MENIU__."

msgid ""
"Aceeași probă e pe televizor, în __DRUM_MENIU__. Proba pornită din "
"telecomandă se vede și aici."
msgstr ""
"Tāda pati pārbaude ir televizorā, sadaļā __DRUM_MENIU__. No pults sākta "
"pārbaude ir redzama arī šeit."

msgid "Acel rând e o explicație și nu se poate alege."
msgstr "Šī rinda ir tikai paskaidrojums, un to nevar izvēlēties."

msgid "Acela e un titlu de grupă. Alege un rând de sub el."
msgstr "Tas ir grupas virsraksts. Izvēlies rindu zem tā."

msgid ""
"Același SID pe același transponder, scris de două ori cu alt tip de serviciu."
msgstr ""
"Tas pats SID tajā pašā transponderā, ierakstīts divreiz ar citu servisa tipu."

msgid ""
"Același canal de două ori în același buchet. Același nume pe alt satelit nu "
"e dublură."
msgstr ""
"Tas pats kanāls divreiz vienā kanālu kopā. Tas pats nosaukums uz cita "
"satelīta nav dublikāts."

msgid "Același canal de două ori în listă"
msgstr "Tas pats kanāls divreiz sarakstā"

