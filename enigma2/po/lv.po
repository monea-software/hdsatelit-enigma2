msgstr "Uztvērējam nav Wi-Fi adaptera. Ievieto to USB portā."

msgid ""
"Receptorul nu are placă Wi-Fi; rețeaua Wi-Fi din copie a rămas deoparte."
msgstr ""
"Uztvērējam nav Wi-Fi adaptera; Wi-Fi tīkls no kopijas netika izmantots."

msgid ""
"Receptorul nu are placă de rețea pe cablu; setările cablului din copie au "
"rămas deoparte."
msgstr ""
"Uztvērējam nav vadu tīkla adaptera; kabeļa iestatījumi no kopijas netika "
"izmantoti."

msgid "Receptorul nu are rețea."
msgstr "Uztvērējam nav tīkla."

msgid ""
"Receptorul nu are setările acestor sateliți: canalele nu pornesc până nu pui "
"satelitul în setările antenei. Nimic nu e bifat; le ștergi numai dacă vrei."
msgstr ""
"Uztvērējam nav šo satelītu iestatījumu: kanāli nesāksies, kamēr nepievienosi "
"satelītu antenas iestatījumos. Nekas nav atzīmēts; dzēs tos tikai tad, ja "
"vēlies."

msgid "Receptorul nu are tuner de satelit."
msgstr "Uztvērējam nav satelīta tūnera."

msgid "Receptorul nu are utilitarul telecomenzilor."
msgstr "Uztvērējam nav tālvadības pultu utilītas."

msgid ""
"Receptorul nu are încă unealta care face ecranul de pornire dintr-o poză."
msgstr "Uztvērējam vēl nav rīka, kas no attēla izveido starta ekrānu."

msgid "Receptorul nu cunoaște unul dintre aceste formate."
msgstr "Uztvērējs neatbalsta vienu no šiem formātiem."

msgid ""
"Receptorul nu decriptează acum niciun canal (canalul de acum nu este criptat "
"sau niciun modul nu îl decriptează)."
msgstr ""
"Uztvērējs tagad neatšifrē nevienu kanālu (pašreizējais kanāls nav šifrēts "
"vai neviens modulis to neatšifrē)."

msgid "Receptorul nu e conectat la nicio rețea."
msgstr "Uztvērējs nav savienots ne ar vienu tīklu."

msgid ""
"Receptorul nu e conectat la router (Wi-Fi). Verifică rețeaua Wi-Fi sau "
"routerul."
msgstr ""
"Uztvērējs nav savienots ar rūteri (Wi-Fi). Pārbaudi Wi-Fi tīklu vai rūteri."

msgid ""
"Receptorul nu e conectat la router (cablu). Verifică cablul sau routerul."
msgstr ""
"Uztvērējs nav savienots ar rūteri (kabelis). Pārbaudi kabeli vai rūteri."

msgid "Receptorul nu e gata (sesiunea enigma2 lipsește)."
msgstr "Uztvērējs nav gatavs (trūkst enigma2 sesijas)."

msgid "Receptorul nu e gata."
msgstr "Uztvērējs nav gatavs."

msgid ""
"Receptorul nu e legat prin Wi-Fi, deci nu știe care e rețeaua ta: în "
"socoteală intră toate rețelele găsite."
msgstr ""
"Uztvērējs nav savienots caur Wi-Fi, tāpēc nezina, kurš tīkls ir tavs: tiek "
"ņemti vērā visi atrastie tīkli."

msgid "Receptorul nu e într-o rețea de acasă (adresă privată); nu caut."
msgstr "Uztvērējs nav mājas tīklā (privāta adrese); nemeklēju."

msgid ""
"Receptorul nu este conectat la internet acum, deci actualizările nu se pot "
"căuta."
msgstr ""
"Uztvērējs tagad nav savienots ar internetu, tāpēc atjauninājumus nevar "
"meklēt."

msgid "Receptorul nu este legat la rețea."
msgstr "Uztvērējs nav pievienots tīklam."

msgid "Receptorul nu este pregătit. Încearcă peste câteva secunde."
msgstr "Uztvērējs nav gatavs. Mēģini vēlreiz pēc dažām sekundēm."

msgid "Receptorul nu este în modul sigur."
msgstr "Uztvērējs nav drošajā režīmā."

msgid "Receptorul nu găsește nicio altă rețea de 2,4 GHz: orice canal e liber."
msgstr "Uztvērējs nedzird nevienu citu 2,4 GHz tīklu: jebkurš kanāls ir brīvs."

msgid ""
"Receptorul nu le poate citi sistemul de fișiere. Se pot folosi după "
"formatare: cu „Formatează”, care deschide pagina Discurile (receptorul "
"întreabă înainte), sau pe un calculator, ca FAT32. Formatarea șterge tot de "
"pe ele."
msgstr ""
"Uztvērējs nevar nolasīt to failu sistēmu. Tos var lietot pēc formatēšanas: "
"ar „Formatē”, kas atver lapu Diski (uztvērējs vispirms jautā), vai datorā, "
"kā FAT32. Formatēšana izdzēš no tiem visu."

msgid ""
"Receptorul nu le poate prinde pe toate deodată. Alege una și apasă OK ca s-o "
"modifici sau s-o oprești; după schimbare încerc din nou."
msgstr ""
"Uztvērējs nevar tos visus uztvert vienlaikus. Izvēlies vienu un nospied OK, "
"lai to rediģētu vai apturētu; pēc izmaiņas mēģināšu vēlreiz."

msgid "Receptorul nu mai transmite spre acest browser."
msgstr "Uztvērējs vairs nesūta uz šo pārlūkprogrammu."

msgid "Receptorul nu poate face dosarul în care se montează locul."
msgstr "Uztvērējs nevar izveidot mapi, kurā vieta tiek montēta."

msgid "Receptorul nu poate fi recunoscut"
msgstr "Uztvērēju nevar atpazīt"

#, python-format
msgid "Receptorul nu poate transforma poza în ecran de pornire (%s)."
msgstr "Uztvērējs nevar pārvērst attēlu par starta ekrānu (%s)."

msgid ""
"Receptorul nu poate trece singur pe Wi-Fi: nu e nicio rețea Wi-Fi salvată și "
"pornită. Conectează receptorul o dată la Wi-Fi (Rețea și internet), apoi "
"trecerea se face singură."
msgstr ""
"Uztvērējs pats nevar pārslēgties uz Wi-Fi: nav neviena saglabāta un ieslēgta "
"Wi-Fi tīkla. Vienreiz savieno uztvērēju ar Wi-Fi (Tīkls un internets), pēc "
"tam pārslēgšanās notiks automātiski."

msgid "Receptorul nu primește bucăți atât de mari."
msgstr "Uztvērējs nepieņem tik lielus fragmentus."

msgid "Receptorul nu recepționează semnalul acestui canal."
msgstr "Uztvērējs nesaņem šī kanāla signālu."

msgid "Receptorul nu răspunde."
msgstr "Uztvērējs neatbild."

msgid "Receptorul nu răspunde. Trimiterea s-a oprit."
msgstr "Uztvērējs neatbild. Sūtīšana pārtraukta."

msgid "Receptorul nu răspunde. Verifică dacă e pornit și în aceeași rețea."
msgstr "Uztvērējs neatbild. Pārbaudi, vai tas ir ieslēgts un tajā pašā tīklā."

msgid "Receptorul nu răspunde. Verifică dacă este pornit și în aceeași rețea."
msgstr "Uztvērējs neatbild. Pārbaudi, vai tas ir ieslēgts un tajā pašā tīklā."

msgid ""
"Receptorul nu răspunde. Verifică dacă telefonul e în aceeași rețea cu "
"receptorul."
msgstr ""
"Uztvērējs neatbild. Pārbaudi, vai tālrunis ir tajā pašā tīklā kā uztvērējs."

msgid "Receptorul nu răspunde. Verifică să fie pornit și în aceeași rețea."
msgstr "Uztvērējs neatbild. Pārbaudi, vai tas ir ieslēgts un tajā pašā tīklā."

msgid "Receptorul nu s-a putut lega la rețeaua Wi-Fi din copie."
msgstr "Uztvērējs nevarēja izveidot savienojumu ar Wi-Fi tīklu no kopijas."

msgid "Receptorul nu spune ce canal e pe televizor."
msgstr "Uztvērējs nesaka, kāds kanāls ir televizorā."

msgid "Receptorul pornește din memoria internă."
msgstr "Uztvērējs startē no iekšējās atmiņas."

msgid "Receptorul pornește din nou programul."
msgstr "Uztvērējs vēlreiz startē programmu."

msgid "Receptorul pornește din nou programul. Încearcă peste câteva secunde."
msgstr "Uztvērējs no jauna palaiž kanālu. Mēģini pēc dažām sekundēm."

msgid ""
"Receptorul pornește imaginea din memoria lui internă în locul celei de acum. "
"Pe televizor: __DRUM_FLASH__."
msgstr ""
"Uztvērējs startē attēlu no savas iekšējās atmiņas pašreizējā attēla vietā. "
"Televizorā: __DRUM_FLASH__."

msgid ""
"Receptorul pornește pe rând fiecare canal din listă și notează ce se află "
"numai când canalul chiar rulează: rezoluția, cadrele pe secundă, codarea "
"imaginii, accesul (liber sau criptat), PID-urile și pistele de sunet și "
"subtitrare. Cât merge, televizorul e ocupat: imaginea se schimbă singură. "
"Orice tastă de pe telecomandă oprește scanarea detaliată, iar receptorul "
"revine la canalul de dinainte. Data viitoare scanarea detaliată continuă de "
"unde a rămas."
msgstr ""
"Uztvērējs pēc kārtas ieslēdz katru kanālu no saraksta un atzīmē to, ko var "
"uzzināt tikai tad, kad kanāls patiešām atskaņojas: izšķirtspēju, kadrus "
"sekundē, video kodējumu, piekļuvi (brīva vai šifrēta), PID un audio un "
"subtitru celiņus. Kamēr tas notiek, televizors ir aizņemts: attēls mainās "
"pats. Jebkurš pults taustiņš aptur detalizēto meklēšanu, un uztvērējs "
"atgriežas pie iepriekšējā kanāla. Nākamreiz detalizētā meklēšana turpinās no "
"vietas, kur tā apstājās."

msgid "Receptorul pornește și trece pe canal."
msgstr "Uztvērējs ieslēdzas un pārslēdzas uz kanālu."

msgid "Receptorul pornește."
msgstr "Uztvērējs ieslēdzas."

msgid "Receptorul potrivește singur contrastul după fiecare scenă."
msgstr "Uztvērējs pats pielāgo kontrastu katrai ainai."

msgid "Receptorul pregătește deja o poză. Încearcă din nou peste câteva clipe."
msgstr "Uztvērējs jau sagatavo attēlu. Mēģini vēlreiz pēc mirkļa."

msgid ""
"Receptorul primește semnalul unei telecomenzi cu infraroșu, dar nu îl poate "
"folosi încă."
msgstr ""
"Uztvērējs saņem infrasarkano staru pults signālu, bet vēl nevar to izmantot."

msgid "Receptorul pune deja un ecran. Încearcă din nou peste câteva clipe."
msgstr "Uztvērējs jau iestata ekrānu. Mēģini vēlreiz pēc mirkļa."

msgid "Receptorul repornește o dată acum, ca să intre rețeaua din copie."
msgstr "Uztvērējs tagad vienreiz pārstartēsies, lai iedarbotos kopijas tīkls."

msgid "Receptorul repornește. Pagina merge din nou după pornire."
msgstr "Uztvērējs pārstartējas. Lapa atkal darbosies pēc startēšanas."

msgid "Receptorul repornește. Pagina se poate reîncărca după două minute."
msgstr "Uztvērējs restartējas. Lapu var pārlādēt pēc divām minūtēm."

msgid ""
"Receptorul s-a oprit neașteptat de două ori cu procesorul accelerat. Am "
"trecut înapoi pe modul Normal."
msgstr ""
"Uztvērējs divreiz negaidīti apstājās ar paātrinātu procesoru. Mēs "
"pārslēdzāmies atpakaļ uz režīmu Normāls."

msgid "Receptorul s-a răcit. Procesorul lucrează din nou la viteza obișnuită."
msgstr "Uztvērējs ir atdzisis. Procesors atkal darbojas ar parasto ātrumu."

#, python-format
msgid ""
"Receptorul s-a încălzit (%d °C). Procesorul lucrează mai încet până se "
"răcește."
msgstr "Uztvērējs ir sasilis (%d °C). Procesors darbojas lēnāk, līdz atdziest."

msgid "Receptorul s-a încălzit și își încetinește singur procesorul."
msgstr "Uztvērējs ir sasilis un pats palēnina savu procesoru."

msgid "Receptorul s-a încălzit. Procesorul lucrează mai încet până se răcește."
msgstr "Uztvērējs ir sasilis. Procesors darbojas lēnāk, līdz atdziest."

#, python-format
msgid "Receptorul s-a întors pe %s: internetul merge din nou acolo."
msgstr "Uztvērējs atgriezās uz %s: tur internets atkal darbojas."

msgid ""
"Receptorul sau televizorul nu e gata. „Ca la televizor” se aplică singur "
"când e gata."
msgstr ""
"Uztvērējs vai televizors nav gatavs. „Kā televizoram“ tiks piemērots pats, "
"kad būs gatavs."

msgid "Receptorul scrie încă bucata de dinainte. Încearcă din nou."
msgstr "Uztvērējs vēl ieraksta iepriekšējo daļu. Mēģini vēlreiz."

#, python-format
msgid "Receptorul se apără singur de căldură: încetinește la %d °C."
msgstr "Uztvērējs pats aizsargājas no karstuma: palēninās pie %d °C."

msgid ""
"Receptorul se oprește de tot și se pornește din nou din butonul de pornire "
"al telecomenzii. Pe televizor: __DRUM_OPRIRE__."
msgstr ""
"Uztvērējs pilnībā izslēdzas un atkal ieslēdzas ar pults ieslēgšanas pogu. "
"Televizorā: __DRUM_OPRIRE__."

msgid "Receptorul se oprește."
msgstr "Uztvērējs tiek izslēgts."

msgid "Receptorul se pornește din nou din butonul de pornire al telecomenzii."
msgstr "Uztvērējs atkal tiek ieslēgts ar pults ieslēgšanas pogu."

msgid ""
"Receptorul se repornește. Pagina se reîncarcă singură când răspunde din nou."
msgstr "Uztvērējs restartējas. Lapa pārlādējas pati, kad tas atkal atbild."

#, python-format
msgid ""
"Receptorul se răcește (%d °C). Procesorul revine la viteza obișnuită după %s."
msgstr ""
"Uztvērējs atdziest (%d °C). Procesors atgriezīsies pie parastā ātruma pēc %s."

#, python-format
msgid "Receptorul se răcește. Procesorul revine la viteza obișnuită după %s."
msgstr "Uztvērējs atdziest. Procesors atgriezīsies pie parastā ātruma pēc %s."

#, python-format
msgid ""
"Receptorul transmite deja spre %s. Oprește acea transmisie din pagina TV în "
"browser sau de pe televizor."
msgstr ""
"Uztvērējs jau straumē uz %s. Apturi šo straumi TV lapā pārlūkprogrammā vai "
"televizorā."

msgid ""
"Receptorul trebuie repornit din meniu pentru ca imaginea sa ramana stabila."
msgstr "Uztvērējs ir jāpārstartē no izvēlnes, lai image paliktu stabils."

msgid "Receptorul trebuie repornit din meniu."
msgstr "Uztvērējs ir jāpārstartē no izvēlnes."

msgid "Receptorul trece în standby."
msgstr "Uztvērējs pāriet gaidstāvē."

#, python-format
msgid ""
"Receptorul trimite deja cât poate deodată: %d înregistrări aceluiași aparat, "
"%d în total. Încearcă din nou după ce se oprește una."
msgstr ""
"Uztvērējs jau sūta, cik var vienlaikus: %d ierakstus vienai ierīcei, %d "
"kopā. Mēģini vēlreiz pēc tam, kad viens apstājas."

msgid ""
"Receptorul trimite și o amprentă calculată din placa lui, ca să fie numărat "
"o singură dată chiar dacă e instalat în mai multe sloturi sau reinstalat. "
"Din amprentă nu se pot afla adresa MAC sau seria, iar acestea nu pleacă de "
"pe receptor."
msgstr ""
"Uztvērējs sūta arī no tā plates aprēķinātu pirksta nospiedumu, lai tas tiktu "
"skaitīts tikai vienu reizi pat tad, ja tas ir instalēts vairākos slotos vai "
"pārinstalēts. No pirksta nospieduma nevar uzzināt MAC adresi vai sērijas "
"numuru, un šie dati nepamet uztvērēju."

#, python-format
msgid "Receptorul tău: %(model)s, placa %(hw)s, procesor %(cip)s."
msgstr "Tavs uztvērējs: %(model)s, plate %(hw)s, procesors %(cip)s."

msgid ""
"Receptorul verifică singur, în fundal, dacă are internet: trimite o "
"întrebare DNS mică spre serverele publice 1.1.1.1, 9.9.9.9 și 8.8.8.8, fără "
"date despre tine. La orice schimbare a rețelei (cablul, Wi-Fi, adresa) "
"verifică pe loc. Aceeași setare pe televizor: Meniu &gt; Setări &gt; Rețea "
"și Internet &gt; Verificarea internetului."
msgstr ""
"Uztvērējs pats fonā pārbauda, vai tam ir internets: sūta nelielu DNS "
"vaicājumu uz publiskajiem serveriem 1.1.1.1, 9.9.9.9 un 8.8.8.8, bez datiem "
"par tevi. Pēc jebkuras tīkla izmaiņas (vads, Wi-Fi, adrese) pārbauda uzreiz. "
"Tas pats iestatījums televizorā: Izvēlne &gt; Iestatījumi &gt; Tīkls un "
"Internets &gt; Interneta pārbaude."

msgid ""
"Receptorul verifică singur, în fundal, dacă are internet: trimite o "
"întrebare DNS mică spre serverele publice 1.1.1.1, 9.9.9.9 și 8.8.8.8, fără "
"date despre tine. La orice schimbare a rețelei (cablul, Wi-Fi, adresa) "
"verifică pe loc. Pictograma din bară arată rezultatul."
msgstr ""
"Uztvērējs pats fonā pārbauda, vai tam ir internets: tas nosūta nelielu DNS "
"pieprasījumu publiskajiem serveriem 1.1.1.1, 9.9.9.9 un 8.8.8.8, bez datiem "
"par tevi. Pie jebkurām tīkla izmaiņām (kabelis, Wi-Fi, adrese) tas pārbauda "
"uzreiz. Joslā redzamā ikona parāda rezultātu."

msgid ""
"Receptorul încă lucrează. Reîncarcă pagina peste puțin timp ca să vezi "
"rezultatul."
msgstr "Uztvērējs vēl strādā. Pārlādē lapu pēc brīža, lai redzētu rezultātu."

msgid ""
"Receptorul întreabă scurt aparatele din rețeaua ta: servere media, "
"calculatoare cu Windows, NAS-uri. Nimic nu pleacă în afara rețelei.\n"
"Un calculator care nu apare se adaugă de mână, cu adresa lui."
msgstr ""
"Uztvērējs īsi aptaujā tavas tīkla ierīces: mediju serverus, Windows datorus, "
"NAS ierīces. Nekas neiziet ārpus tīkla.\n"
"Datoru, kas neparādās, pievieno ar roku, norādot tā adresi."

msgid ""
"Receptorul întreabă scurt aparatele din rețeaua ta: serverele media (DLNA), "
"calculatoarele cu Windows și NAS-urile cu dosare partajate, serverele care "
"se anunță (NFS, WebDAV, FTP). Nimic nu pleacă în afara rețelei tale și nimic "
"nu se caută singur."
msgstr ""
"Uztvērējs īsi aptaujā tavas tīkla ierīces: mediju serverus (DLNA), Windows "
"datorus un NAS ierīces ar koplietotām mapēm, serverus, kas sevi paziņo (NFS, "
"WebDAV, FTP). Nekas neiziet ārpus tava tīkla, un nekas netiek meklēts pats."

msgid ""
"Receptorul întreabă serverul HD Satelit ce oraș arată adresa lui de "
"internet. Locul se schimbă numai după ce îl confirmi."
msgstr ""
"Uztvērējs jautā HD Satelit serverim, kuru pilsētu rāda tā interneta adrese. "
"Vieta mainās tikai pēc tam, kad to apstiprini."

#, python-format
msgid ""
"Receptorul ține deschis un fișier de pe disc (de pildă un film care se "
"redă): %s."
msgstr ""
"Uztvērējs tur atvērtu failu no diska (piemēram, atskaņojamu filmu): %s."

msgid "Receptorul:"
msgstr "Uztvērējs:"

msgid "Recepția"
msgstr "Uztveršana"

msgid "Recepție"
msgstr "Uztvere"

msgid "Reclamă"
msgstr "Reklāma"

msgid "Reclamă: ceasul subtitrării stă. Apasă din nou când revine filmul."
msgstr ""
"Reklāma: subtitru pulkstenis stāv. Nospied vēlreiz, kad filma atgriezīsies."

msgid "Reclamă: oprește ceasul"
msgstr "Reklāma: apturēt pulksteni"

msgid "Reclamă: pornește ceasul"
msgstr "Reklāma: startēt pulksteni"

msgid "Recomandare"
msgstr "Ieteikums"

msgid "Recomandat pentru subtitrări zilnice"
msgstr "Ieteicams ikdienas subtitriem"

msgid ""
"Recomandat: 1080p 50 Hz (Full HD) sau 2160p 50 Hz (4K UHD); canalele din "
"Europa au 50 Hz."
msgstr ""
"Ieteicams: 1080p 50 Hz (Full HD) vai 2160p 50 Hz (4K UHD); Eiropas kanāliem "
"ir 50 Hz."

msgid "Record"
msgstr "Ierakstīt"

#, python-format
msgid "Record time limited due to conflicting timer %s"
msgstr "Ieraksta laiks ierobežots konfliktējošā taimera %s dēļ"

msgid "Recorded files..."
msgstr "Ierakstītie faili..."

msgid "Recording"
msgstr "Ierakstīšana"

msgid "Recording & Storage Setup"
msgstr "Ierakstīšanas un glabāšanas iestatījumi"

msgid "Recording Locations"
msgstr "Ierakstu atrašanās vietas"

msgid "Recording(s) are in progress or coming up in few seconds!"
msgstr "Notiek ieraksts(-i) vai sāksies pēc dažām sekundēm!"

msgid ""
"Recording(s) are in progress or coming up in few seconds!\n"
"Entering standby, after recording the box will shutdown."
msgstr ""
"Notiek ieraksts(-i) vai sāksies pēc dažām sekundēm!\n"
"Pāriet gaidstāvē; pēc ieraksta uztvērējs izslēgsies."

msgid "Recordings always have priority"
msgstr "Ierakstiem vienmēr ir prioritāte"

msgid "Recunoașterea textului"
msgstr "Teksta atpazīšana"

msgid "Recunoașterea textului (OCR)"
msgstr "Teksta atpazīšana (OCR)"

msgid ""
"Recunoașterea textului lucrează și acum: o cere traducerea subtitrărilor."
