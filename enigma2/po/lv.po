msgstr ""
"<code>POST /api/acces-ssh-parola</code>: paroles teksts (redzams vienmēr); "
"<code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: SSH un FTP serveru "
"faili kā teksts (bez /etc/shadow)"

msgid ""
"<code>POST /api/acces-ssh-parola</code>: textul parolei, cât timp nu a fost "
"ascunsă; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: fișierele "
"serverului SSH ca text (fără /etc/shadow)"
msgstr ""
"<code>POST /api/acces-ssh-parola</code>: paroles teksts, kamēr tā nav "
"paslēpta; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: SSH servera "
"faili kā teksts (bez /etc/shadow)"

msgid ""
"<code>POST /api/acces-ssh-pune</code> (corp: <code>parola=</code>): parola "
"aleasă (4-64 de semne: litere fără diacritice, cifre și semne, fără spații); "
