msgstr "Rezervē"

msgid "Pe sateliți"
msgstr "Pēc satelītiem"

msgid "Pe scurt"
msgstr "Īsumā"

msgid "Pe server"
msgstr "Serverī"

msgid "Pe server nu mai este loc."
msgstr "Serverī vairs nav vietas."

msgid ""
"Pe stick e o cheie privată. Lasă pe stick numai cheile publice (.pub). Cheia "
"privată rămâne numai la tine."
msgstr ""
"Uz USB zibatmiņas ir privātā atslēga. Atstāj uz tās tikai publiskās atslēgas "
"(.pub). Privātā atslēga paliek tikai pie tevis."

msgid ""
"Pe stick nu am găsit dosarul hdsatelit/ssh cu chei. Pune în el fișierul "
"authorized_keys sau cheile tale .pub."
msgstr ""
"Uz USB zibatmiņas netika atrasta mape hdsatelit/ssh ar atslēgām. Ievieto "
"tajā failu authorized_keys vai savas .pub atslēgas."

msgid ""
"Pe stick nu am găsit dosarul hdsatelit/vpn. Pune în el fișierele .ovpn, ."
"conf sau arhiva .zip."
msgstr ""
"Zibatmiņā netika atrasta mape hdsatelit/vpn. Ievieto tajā .ovpn, .conf "
"failus vai .zip arhīvu."

msgid "Pe telecomanda nouă: ține apăsat 2 secunde = Sari."
msgstr "Uz jaunās pults: turi nospiestu 2 sekundes = Izlaist."

msgid ""
"Pe telecomanda nouă: ține apăsat 2 secunde = Sari. Gata merge după MENU."
msgstr ""
"Uz jaunās pults: turi nospiestu 2 sekundes = Izlaist. Gatavs darbojas pēc "
"MENU."

msgid ""
"Pe telecomanda nouă: ține apăsat 2 secunde = Sari; ține apăsat EXIT = Gata."
msgstr ""
"Uz jaunās pults: turi nospiestu 2 sekundes = Izlaist; turi nospiestu EXIT = "
"Gatavs."

msgid "Pe telecomanda televizorului"
msgstr "Uz televizora pults"

msgid "Pe televizor"
msgstr "Televizorā"

msgid ""
"Pe televizor apare apoi aceeași întrebare: se face numai după ce răspunzi Da "
"acolo sau, la o înregistrare, singur, după ce se termină."
msgstr ""
"Pēc tam televizorā parādīsies tas pats jautājums: darbība tiks veikta tikai "
"pēc tam, kad tur atbildēsi Jā, vai ieraksta gadījumā - automātiski, kad tas "
"beigsies."

msgid ""
"Pe televizor așteaptă deja o întrebare de oprire sau de repornire. Răspunde "
"acolo."
msgstr ""
"Televizorā jau gaida jautājums par izslēgšanu vai restartēšanu. Atbildi tur."

msgid "Pe televizor așteaptă deja o întrebare."
msgstr "Televizorā jau gaida jautājums."

msgid "Pe televizor e ales un câmp de parolă: textul nu se vede pe ecran."
msgstr "Televizorā ir izvēlēts paroles lauks: teksts ekrānā nav redzams."

msgid ""
"Pe televizor e deschis alt ecran. Închide-l, apoi pornește din nou filmul."
msgstr ""
"Televizorā ir atvērts cits ekrāns. Aizver to, tad palaid filmu vēlreiz."

msgid "Pe televizor e deschis alt ecran. Închide-l, apoi încearcă din nou."
msgstr "Televizorā ir atvērts cits ekrāns. Aizver to un mēģini vēlreiz."

msgid ""
"Pe televizor e deschis ecranul Calitatea imaginii. Închide-l, apoi încearcă "
"din nou."
msgstr ""
"Televizorā ir atvērts ekrāns Attēla kvalitāte. Aizver to un mēģini vēlreiz."

msgid ""
"Pe televizor e deschis ecranul Video sau asistentul de pornire. Închide-l, "
"apoi încearcă din nou."
msgstr ""
"Televizorā ir atvērts Video ekrāns vai sākuma palīgs. Aizver to, tad mēģini "
"vēlreiz."

#, python-format
msgid "Pe televizor e deschis ecranul „%s”. Închide-l, apoi încearcă din nou."
msgstr "Televizorā ir atvērts ekrāns „%s“. Aizver to un mēģini vēlreiz."

msgid ""
"Pe televizor e deschis rezultatul scanării DAB+ sau DVB-T2. Alege acolo sau "
"în pagină ce pornești sau întoarce-te la canalul tău, apoi pornește căutarea "
"nouă."
msgstr ""
"Televizorā ir atvērts DAB+ vai DVB-T2 meklēšanas rezultāts. Izvēlies tur vai "
"lapā, ko palaist, vai atgriezies pie sava kanāla, pēc tam sāc jaunu "
"meklēšanu."

msgid ""
"Pe televizor e deschis un ecran cu setările sunetului. Închide-l, apoi "
"încearcă din nou."
msgstr ""
"Televizorā ir atvērts ekrāns ar skaņas iestatījumiem. Aizver to, tad mēģini "
"vēlreiz."

msgid ""
"Pe televizor e deschis un mesaj peste probă. Închide-l cu OK, apoi încearcă "
"din nou."
msgstr ""
"Televizorā pār testu ir atvērts ziņojums. Aizver to ar OK, pēc tam mēģini "
"vēlreiz."

msgid ""
"Pe televizor e deschisă altă fereastră peste căutare. Închide-o întâi (tasta "
"Exit), apoi încearcă din nou."
msgstr ""
"Televizorā virs meklēšanas ir atvērts cits logs. Vispirms aizver to "
"(taustiņš Exit), pēc tam mēģini vēlreiz."

msgid ""
"Pe televizor e deschisă altă fereastră peste scanare. Închide-o întâi (tasta "
"EXIT), apoi încearcă din nou."
msgstr ""
"Televizorā virs kanālu meklēšanas ir atvērts cits logs. Vispirms aizver to "
"(taustiņš EXIT), pēc tam mēģini vēlreiz."

msgid "Pe televizor e deschisă interfața camului. Închide-o întâi."
msgstr "Televizorā ir atvērta CAM saskarne. Vispirms aizver to."

msgid "Pe televizor e deschisă interfața web a modulului. Închide-o întâi."
msgstr "Televizorā ir atvērta moduļa tīmekļa saskarne. Vispirms aizver to."

msgid "Pe televizor e deschisă o fereastră peste navigator."
msgstr "Televizorā pārlūkam virsū ir atvērts logs."

msgid ""
"Pe televizor e încă deschis rezultatul căutării de dinainte. Închide-l "
"(butonul din pagină sau tasta Exit), apoi pornește căutarea nouă."
msgstr ""
"Televizorā joprojām ir atvērts iepriekšējās meklēšanas rezultāts. Aizver to "
"(pogu lapā vai taustiņu Exit), pēc tam sāc jaunu meklēšanu."

msgid "Pe televizor este deschis alt ecran. Închide-l și încearcă încă o dată."
msgstr "Televizorā ir atvērts cits ekrāns. Aizver to un mēģini vēlreiz."

msgid "Pe televizor merge acum ceva ce nu se poate transmite în browser."
msgstr ""
"Televizorā pašlaik tiek atskaņots kaut kas, ko nevar pārraidīt "
"pārlūkprogrammā."

msgid "Pe televizor nu e deschis niciun câmp de text."
msgstr "Televizorā nav atvērts neviens teksta lauks."

msgid "Pe televizor nu merge acum niciun canal."
msgstr "Televizorā pašlaik nedarbojas neviens kanāls."

msgid "Pe televizor nu se arată nicio poză."
msgstr "Televizorā netiek rādīts neviens attēls."

msgid ""
"Pe televizor nu se arată nicio poză. Alege o poză mai jos și apasă Arată pe "
"televizor."
msgstr ""
"Televizorā netiek rādīts neviens fotoattēls. Izvēlies fotoattēlu zemāk un "
"nospied Rādīt televizorā."

msgid ""
"Pe televizor poți alege și direct o emisiune din ghidul TV: acolo marginile "
"de dinainte și de după se pun singure."
msgstr ""
"Televizorā vari arī tieši izvēlēties raidījumu no TV ceļveža: tur atstarpes "
"pirms un pēc tiek iestatītas automātiski."

msgid ""
"Pe televizor s-a deschis Asistența de la distanță: citește și apasă Verde "
"acolo."
msgstr "Televizorā ir atvērta Attālā palīdzība: izlasi un tur nospied Zaļo."

msgid ""
"Pe televizor se cere o confirmare: o înregistrare e în curs sau începe "
"curând, sau lucrează ceva în fundal. Se face numai dacă răspunzi Da acolo."
msgstr ""
"Televizorā tiek prasīts apstiprinājums: notiek ierakstīšana vai tā drīz "
"sāksies, vai kaut kas darbojas fonā. Darbība tiks veikta tikai tad, ja tur "
"atbildēsi Jā."

msgid ""
"Pe televizor se cere o confirmare: o înregistrare e în curs sau începe "
"curând. Alegerea se face numai dacă răspunzi Da acolo."
msgstr ""
"Televizors lūdz apstiprinājumu: notiek ierakstīšana vai tā drīz sāksies. "
"Izvēle tiks veikta tikai tad, ja tur atbildēsi Jā."

msgid ""
"Pe televizor se cere o confirmare: o înregistrare e în curs sau începe "
"curând. Repornirea se face numai dacă răspunzi Da acolo."
msgstr ""
"Televizorā tiek prasīts apstiprinājums: notiek ierakstīšana vai tā drīz "
"sāksies. Restartēšana notiks tikai tad, ja tur atbildēsi Jā."

msgid ""
"Pe televizor se deschide ecranul probei. Îl închizi de acolo cu EXIT sau din "
"pagină."
msgstr "Televizorā atvērsies testa ekrāns. Aizver to tur ar EXIT vai no lapas."

msgid ""
"Pe televizor, același mesaj apare singur la pornire, în modul sigur, și din "
"Meniu > Informații despre sistem > Mod sigur."
msgstr ""
"Televizorā tas pats ziņojums parādās pats startēšanas laikā drošajā režīmā, "
"kā arī no Izvēlne > Sistēmas informācija > Drošais režīms."

msgid ""
"Pe televizor, asta se poate numai cu nivelul de meniu Intermediar sau Expert."
msgstr "Televizorā to var tikai ar izvēlnes līmeni Vidējais vai Eksperts."

msgid ""
"Pe televizor, ecranul diagnosticului apare singur numai când pornirea nu "
"reușește; altfel se deschide din MENU > Informații despre sistem > "
"Diagnosticul pornirii."
msgstr ""
"Televizorā diagnostikas ekrāns parādās pats tikai tad, kad palaišana "
"neizdodas; citādi atver to no IZVĒLNE > Sistēmas informācija > Palaišanas "
"diagnostika."

msgid ""
"Pe televizor, pe ecranul radio: tasta galbenă trece la altă vizualizare, "
"tasta albastră la alte culori. Alegerea se ține minte."
msgstr ""
"Televizorā, radio ekrānā: dzeltenā poga pārslēdz uz citu vizualizāciju, zilā "
"uz citām krāsām. Izvēle tiek atcerēta."

msgid ""
"Pe televizor, pe ecranul radio: tasta galbenă trece la altă vizualizare, "
"tasta albastră la alte culori. Alegerea se ține minte. Tasta verde deschide "
"egalizatorul."
msgstr ""
"Televizorā, radio ekrānā: dzeltenais taustiņš pārslēdzas uz citu skatu, "
"zilais uz citām krāsām. Izvēle tiek atcerēta. Zaļais taustiņš atver "
"ekvalaizeri."

msgid ""
"Pe televizor, setările playerului apar numai cu nivelul de meniu Intermediar "
"sau Expert."
msgstr ""
"Televizorā atskaņotāja iestatījumi parādās tikai ar izvēlnes līmeni Vidējs "
"vai Eksperts."

msgid "Pe televizor:"
msgstr "Televizorā:"

#, python-format
msgid "Pe televizor: %s. Mai sunt %s s până revine ieșirea de dinainte."
msgstr "Televizorā: %s. Vēl %s s līdz atgriezīsies iepriekšējā izeja."

msgid ""
"Pe televizor: <span id=\"drumDab\">__DRUM_DAB__</span><span "
"id=\"drumT2\">__DRUM_T2__</span> &gt; Fluxuri și setări."
msgstr ""
"Televizorā: <span id=\"drumDab\">__DRUM_DAB__</span><span "
"id=\"drumT2\">__DRUM_T2__</span> &gt; Plūsmas un iestatījumi."

msgid "Pe televizor: Meniu, Setări, Software &amp; Firmware, Copia setărilor."
msgstr ""
"Televizorā: Izvēlne, Iestatījumi, Software &amp; Firmware, Iestatījumu "
"kopija."

msgid ""
"Pe televizor: apasă OK de două ori pe un canal; prima pagină a barei este "
"ghidul canalului."
msgstr ""
"Televizorā: divreiz nospied OK uz kanāla; pirmā joslas lapa ir kanāla "
"ceļvedis."

msgid ""
"Pe televizor: pe alt receptor, mesajul de mai sus apare singur, în locul "
"interfeței."
msgstr ""
"Uz televizora: citā uztvērējā augstāk redzamais ziņojums parādās pats, "
"saskarnes vietā."

msgid ""
"Pe televizor: tasta SUB în timpul filmului. Setările implicite sunt în "
"__DRUM_MENIU__."
msgstr ""
"Televizorā: taustiņš SUB filmas laikā. Noklusējuma iestatījumi ir "
"__DRUM_MENIU__."

msgid "Pe televizor: tasta TEXT."
msgstr "Televizorā: poga TEXT."

#, python-format
msgid ""
"Pe televizor: în dreapta cu reglajul, în stânga fără. Se oprește singură "
"după %d de secunde."
msgstr ""
"Televizorā: labajā pusē ar iestatījumu, kreisajā bez. Pats izslēgsies pēc %d "
"sekundēm."

msgid "Pe transpondere"
msgstr "Pēc transponderiem"

#, python-format
msgid ""
"Pe tunerul %s nu e legat niciun satelit. Alege sateliții din Setări tuner."
msgstr ""
"Uztvērējam %s nav pievienots neviens satelīts. Izvēlies satelītus sadaļā "
"Uztvērēja iestatījumi."

msgid ""
"Pe un calculator din casă instalează Docker Desktop (docs.docker.com) și "
"pornește-l."
msgstr "Uz mājas datora instalē Docker Desktop (docs.docker.com) un palaid to."

msgid ""
"Pe un calculator din casă rulează LibreTranslate sau Ollama. Receptorul îl "
"caută în rețeaua de acasă, alege singur modelul și face proba."
msgstr ""
"Mājas datorā darbojas LibreTranslate vai Ollama. Uztvērējs to meklē mājas "
"tīklā, pats izvēlas modeli un veic pārbaudi."

msgid "Pe un canal cu subcanale, VERDE scurt arată întâi lista lor."
msgstr "Kanālā ar apakškanāliem īss ZAĻĀS vispirms parāda to sarakstu."

msgid "Pe „%s” lipsește dosarul %s, în care se salvează timeshift-ul."
msgstr "Uz „%s” trūkst mape %s, kurā tiek saglabāts timeshift."

msgid "Pe „%s” lipsește dosarul %s, în care se salvează înregistrările."
msgstr "Uz „%s” trūkst mape %s, kurā tiek saglabāti ieraksti."

msgid "Peisaje"
msgstr "Ainavas"

#, python-format
msgid "Pentru %s lipsește: %s."
msgstr "Trūkst %s: %s."

msgid ""
"Pentru Cloudflare Workers scrie și ID-ul contului (32 de litere și cifre, de "
"la „Account ID”). Cheia nu a plecat nicăieri."
msgstr ""
"Cloudflare Workers ieraksti arī konta ID (32 burti un cipari, no „Account "
"ID”). Atslēga nekur nav nosūtīta."

msgid "Pentru Gemini lipsește cheia. Pune întâi cheia."
msgstr "Gemini trūkst atslēgas. Vispirms ievadi atslēgu."

msgid "Pentru Python 3 există %s, în feedul %s."
msgstr "Python 3 ir %s, padevē %s."

msgid "Pentru SubDL scrie în setări cheia ta API (din panoul contului SubDL)."
msgstr ""
"Lai lietotu SubDL, iestatījumos ievadi savu API atslēgu (no SubDL konta "
"paneļa)."

msgid ""
"Pentru Uniunea Europeană, Google spune că nici la nivelul gratuit nu "
"folosește textele trimise ca să-și îmbunătățească produsele."
msgstr ""
"Eiropas Savienībā Google saka, ka pat bezmaksas līmenī neizmanto nosūtītos "
"tekstus, lai uzlabotu savus produktus."

msgid ""
"Pentru a face loc pe disc fără să pierzi setările, folosește curățenia "
"discului. Același ecran e pe televizor, în __DRUM_MENIU__."
msgstr ""
"Lai atbrīvotu vietu diskā, nezaudējot iestatījumus, izmanto diska tīrīšanu. "
"Tas pats ekrāns ir televizorā, __DRUM_MENIU__."

msgid "Pentru această actualizare trebuie pusă imaginea nouă."
msgstr "Šim atjauninājumam jāinstalē jaunais attēls."

msgid "Pentru acest post"
msgstr "Šai stacijai"

msgid "Pentru acest post (nu merge niciun post)"
msgstr "Šai stacijai (nedarbojas neviena stacija)"

msgid ""
"Pentru aceste limbi ai ales să nu te mai întreb când apare o subtitrare fără "
"model:"
msgstr ""
"Šīm valodām tu izvēlējies, lai es vairs nejautātu, kad parādās subtitri bez "
"modeļa:"

msgid "Pentru daltonism"
msgstr "Daltoniķiem"

msgid ""
"Pentru descărcări de pe OpenSubtitles scrie în setări contul tău (gratuit)."
msgstr ""
"Lai lejupielādētu no OpenSubtitles, iestatījumos ievadi savu (bezmaksas) "
"kontu."

msgid ""
"Pentru fișierele de subtitrare care nu sunt UTF-8 și pentru textul din "
"filmele MKV scris altfel. Europa Centrală citește corect fișierele românești "
"vechi. La pistele din film se aplică de la filmul următor."
msgstr ""
"Subtitru failiem, kas nav UTF-8, un MKV filmu tekstam, kas rakstīts citā "
"kodējumā. Centrāleiropa pareizi lasa vecos rumāņu failus. Filmā esošajiem "
"celiņiem stājas spēkā no nākamās filmas."

msgid ""
"Pentru limbile acestea ai ales „Nu mai întreba pentru limba asta”. OK: te "
"întreb din nou când apare o subtitrare în ele."
msgstr ""
"Šīm valodām tu izvēlējies „Vairs nejautāt par šo valodu”. OK: es jautāšu "
"vēlreiz, kad parādīsies subtitri tajās."

msgid ""
"Pentru o bară de sunet legată la ieșirea optică a receptorului alege Manual "
"și pune Downmix AC3 pe Nu. Schimbarea se aude sigur de la următorul canal."
msgstr ""
"Skaņas joslai, kas pievienota uztvērēja optiskajai izejai, izvēlies Manuāli "
"un iestati Downmix AC3 uz Nē. Izmaiņas noteikti būs dzirdamas no nākamā "
"kanāla."

msgid "Pentru pasionați."
msgstr "Entuziastiem."

msgid "Pentru probe și potriviri"
msgstr "Pārbaudēm un pielāgošanai"

msgid "Pentru programatori"
msgstr "Programmētājiem"

#, python-format
msgid ""
"Pentru recuperare, Maintenance Mode caută imaginea pe stick în dosarul %s."
msgstr "Atkopšanai Maintenance Mode meklē attēlu zibatmiņā mapē %s."

msgid ""
"Pentru satelitul ales nu există niciun transponder în lista de sateliți, "
"deci receptorul nu are ce acorda."
msgstr ""
"Izvēlētajam satelītam satelītu sarakstā nav neviena transpondera, tāpēc "
"uztvērējam nav ko noskaņot."

msgid "Pentru serverul compatibil OpenAI lipsește adresa. Pune întâi adresa."
msgstr "Ar OpenAI saderīgajam serverim trūkst adreses. Vispirms ievadi adresi."

msgid ""
"Pentru subs.ro scrie în setări cheia ta API (din profilul de pe subs.ro)."
msgstr ""
"Lai lietotu subs.ro, iestatījumos ievadi savu API atslēgu (no profila vietnē "
"subs.ro)."

msgid ""
"Pentru subtitrări multe (filme întregi, zilnic) e recomandat Azure "
"Translator, planul Free F0: 2 milioane de caractere pe lună; cardul se cere "
"numai la înscriere, iar pe F0 nu se plătește nimic. Gemini e gratuit pentru "
"folosire ocazională, dar la subtitrări continue poate da „prea multe cereri” "
"după câteva minute."
msgstr ""
"Daudziem subtitriem (veselas filmas, katru dienu) ieteicams Azure "
"Translator, plāns Free F0: 2 miljoni rakstzīmju mēnesī; karte tiek prasīta "
"tikai reģistrējoties, un F0 nekas nav jāmaksā. Gemini ir bezmaksas "
"neregulārai lietošanai, bet nepārtrauktiem subtitriem pēc dažām minūtēm var "
"paziņot „pārāk daudz pieprasījumu”."

msgid ""
"Pentru subtitrări multe (filme întregi, în fiecare zi) pune în setări și "
"servicii de rezervă, de exemplu Azure Translator: când Gemini dă eroarea "
"429, receptorul trece singur la următorul. Lista se face din servicii "
"diferite: limita Gemini e pe proiect, iar mai multe conturi făcute ca să "
"aduni limitele gratuite înseamnă ocolirea limitelor, pe care termenii Google "
"o interzic."
msgstr ""
"Daudziem subtitriem (veselas filmas, katru dienu) iestatījumos pievieno arī "
"rezerves servisus, piemēram, Azure Translator: kad Gemini dod kļūdu 429, "
"uztvērējs pats pāriet uz nākamo. Sarakstu veido no dažādiem servisiem: "
"Gemini limits ir uz projektu, un vairāki konti, kas izveidoti, lai summētu "
"bezmaksas limitus, nozīmē limitu apiešanu, ko Google noteikumi aizliedz."

msgid ""
"Pentru subtitrări multe pune în setări și servicii de rezervă, de exemplu "
"Azure Translator: când Groq dă eroarea 429, receptorul trece singur la "
"următorul."
msgstr ""
"Daudziem subtitriem iestatījumos uzstādi arī rezerves pakalpojumus, "
"piemēram, Azure Translator: kad Groq dod kļūdu 429, uztvērējs pats pāriet uz "
"nākamo."

msgid "Pentru timeshift:"
msgstr "Laika nobīdei:"

msgid ""
"Pentru un canal de satelit, pornește întâi pe televizor un canal de pe "
"același satelit. Antena nu se rotește din browser."
msgstr ""
"Satelīta kanālam vispirms ieslēdz televizorā kanālu no tā paša satelīta. "
"Antena netiek pagriezta no pārlūkprogrammas."

msgid ""
"Pentru un server din casă scrie întâi adresa lui (pasul cu adresa "
"serverului)."
