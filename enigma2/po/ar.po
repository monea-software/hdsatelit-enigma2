#, python-format
msgid "Vrei HD Satelit și pe alt model de receptor? Scrie-ne la %s. Avem nevoie de receptor, dat gratuit și definitiv, și de driverele și tot ce mai trebuie de la producător."
msgstr "هل تريد HD Satelit على طراز آخر من أجهزة الاستقبال؟ راسلنا على %s. نحتاج إلى جهاز الاستقبال مجانًا وبشكل نهائي، وإلى برامج التشغيل وكل ما يلزم من الشركة المصنّعة."

msgid "Canale și recepție"
msgstr "القنوات والاستقبال"

msgid "Subtitrări și traducere"
msgstr "الترجمة النصية والترجمة"

msgid "Navigator web și HbbTV"
msgstr "متصفح الويب وHbbTV"

msgid "Telefon și interfața web"
msgstr "الهاتف وواجهة الويب"

msgid "Radio și afișaj"
msgstr "الراديو وشاشة الجهاز"

msgid "Setări și siguranță"
msgstr "الإعدادات والأمان"

msgid "Radiourile DAB+ din satelit: le cauți și le asculți ca pe orice post de radio."
msgstr "محطات DAB+ عبر القمر الصناعي: ابحث عنها واستمع إليها كأي محطة راديو."

msgid "Canalele DVB-T2 din satelit: le cauți și le vezi ca pe orice canal."
msgstr "قنوات DVB-T2 عبر القمر الصناعي: ابحث عنها وشاهدها كأي قناة."

msgid "Scanare detaliată: fiecare canal pornit pe rând, cu rezoluția, codarea și pistele."
msgstr "فحص مفصّل: تُفتح كل قناة على حدة، مع عرض الدقة والترميز والمسارات."

msgid "Căutare de canale după nume, limba sunetului sau a subtitrării, teletext sau HbbTV."
msgstr "البحث عن القنوات بالاسم أو لغة الصوت أو الترجمة أو النص التلفزيوني أو HbbTV."

msgid "Favorite dintr-o apăsare: tasta FAV pune canalul în Favorite sau îl scoate."
msgstr "المفضلة بضغطة واحدة: يضيف زر FAV القناة إلى المفضلة أو يزيلها."

msgid "Configurare LNB cu probă de semnal: setările noi rămân numai după ce confirmi."
msgstr "إعداد رأس الاستقبال LNB مع اختبار الإشارة: لا تُحفظ الإعدادات الجديدة إلا بعد تأكيدك."

msgid "Rotirea antenei desenată pe ecran: sateliții pe arc, plecarea, ținta și raza."
msgstr "رسم حركة الطبق على الشاشة: الأقمار على القوس، ونقطة الانطلاق والهدف والشعاع."

msgid "Traducerea automată a subtitrărilor în limba ta: teletext, DVB și fișiere."
msgstr "ترجمة تلقائية للترجمات النصية إلى لغتك: النص التلفزيوني وترجمات DVB والملفات."

msgid "Ghidul de programe și bara de jos, traduse automat în limba ta."
msgstr "ترجمة دليل البرامج والشريط السفلي تلقائيًا إلى لغتك."

msgid "Subtitrările DVB mărite la mărimea ecranului, cu margini clare."
msgstr "تكبير ترجمات DVB لتناسب حجم الشاشة، مع حواف واضحة."

msgid "Subtitrările DVB citite ca text, ca să poată fi traduse și scrise cu literele tale."
msgstr "قراءة ترجمات DVB كنص لتتم ترجمتها وعرضها بحروف لغتك."

msgid "Aspectul subtitrărilor: mărimea, culoarea, conturul, umbra și fundalul."
msgstr "مظهر الترجمة: الحجم واللون والحدود والظل والخلفية."

msgid "HbbTV, aplicațiile canalelor la tasta ROȘIE: îl pornești din Setări navigator web."
msgstr "HbbTV، تطبيقات القنوات بالزر الأحمر: فعّله من إعدادات متصفح الويب."

msgid "Navigator web pe televizor, cu telecomanda: indicator ca un mouse și tastatură pe ecran."
msgstr "متصفح ويب على التلفزيون تتحكم فيه بالريموت: مؤشر مثل الماوس ولوحة مفاتيح على الشاشة."

msgid "Interfață web proprie: fiecare ecran al receptorului are pereche în browser."
msgstr "واجهة ويب خاصة: لكل شاشة في جهاز الاستقبال صفحة مقابلة في المتصفح."

msgid "Browserul intră numai cu un cod de șase cifre arătat pe televizor."
msgstr "لا يمكن الدخول من المتصفح إلا برمز من ستة أرقام يظهر على التلفزيون."

msgid "Aplicațiile de telefon pentru receptoare: telecomandă, canale, ghid și înregistrări."
msgstr "تطبيقات الهاتف لأجهزة الاستقبال: ريموت وقنوات ودليل برامج وتسجيلات."

msgid "Înregistrările se văd și pe telefon, chiar și cât se înregistrează."
msgstr "يمكن مشاهدة التسجيلات على الهاتف أيضًا، حتى أثناء التسجيل."

msgid "Ecranul radio pe tot ecranul: piesa, textul radio, bare de sunet și egalizator."
msgstr "شاشة راديو تملأ الشاشة: المقطوعة والنص الإذاعي وأعمدة الصوت ومعادل الصوت."

msgid "Afișajul din față arată pe rând ora, canalul, semnalul și peste o sută de alte date."
msgstr "تعرض الشاشة الأمامية بالتناوب الوقت والقناة والإشارة وأكثر من مئة معلومة أخرى."

msgid "Caută setări: scrii câteva litere cu cifrele telecomenzii și ajungi la setare."
msgstr "البحث عن الإعدادات: اكتب بضعة أحرف بأزرار أرقام الريموت للوصول إلى الإعداد."

msgid "Copia setărilor pe stick, pusă singură la loc după o actualizare."
msgstr "نسخة من الإعدادات على ذاكرة USB، تُستعاد تلقائيًا بعد التحديث."

msgid "Mod sigur: după opriri neașteptate repetate, receptorul pornește fără extensii."
msgstr "الوضع الآمن: بعد تكرار التوقف المفاجئ، يبدأ جهاز الاستقبال دون إضافات."

msgid "Telecomenzi: proba tastelor pe telecomanda desenată și o telecomandă USB asociată."
msgstr "أجهزة الريموت: اختبار الأزرار على رسم للريموت، وريموت USB مقترن بالجهاز."

msgid "Meniurile traduse complet în 28 de limbi."
msgstr "القوائم مترجمة بالكامل إلى 28 لغة."

msgid "Un canal se trimite acum în rețea (spre un telefon, un calculator sau pagina /tv a panoului web) și ține tunerul. Oprește redarea acolo, apoi apasă galben."
msgstr "تُبث قناة الآن عبر الشبكة إلى هاتف أو كمبيوتر أو صفحة /tv في لوحة الويب، وهي تشغل موالف الاستقبال. أوقف المشاهدة هناك، ثم اضغط الزر الأصفر."

msgid "Nivelul e la maximul tunerului, dar semnalul nu se recepționează: poate fi prea puternic sau o interferență. Încearcă un atenuator de linie."
msgstr "المستوى عند الحد الأقصى لموالف الاستقبال، لكن لا يمكن استقبال الإشارة: قد تكون قوية جدًا أو يوجد تشويش. جرّب مخفّض إشارة على الكابل."

#, python-format
msgid "Primește canalul: %s."
msgstr "استقبل القناة: %s."

msgid "Semnal recepționat"
msgstr "تم استقبال الإشارة"

msgid "Tunerul e folosit de o transmisie"
msgstr "موالف الاستقبال مشغول ببث"

msgid "Aplicațiile HbbTV nu pornesc cât timeshift-ul e pornit."
msgstr "لا تعمل تطبيقات HbbTV أثناء تفعيل المشاهدة المؤجلة."

msgid "Aplicația HbbTV a acestui canal vine din semnalul altui canal și receptorul nu o poate încărca de aici."
msgstr "يأتي تطبيق HbbTV لهذه القناة من إشارة قناة أخرى، ولا يستطيع جهاز الاستقبال تحميله من هنا."

msgid "HbbTV: se încarcă aplicația din satelit..."
msgstr "HbbTV: جارٍ تحميل التطبيق من القمر الصناعي..."

#, python-format
msgid "HbbTV: se încarcă aplicația din satelit (%(gata)d din %(toate)d părți)..."
msgstr "HbbTV: جارٍ تحميل التطبيق من القمر الصناعي (%(gata)d من %(toate)d جزءًا)..."

msgid "Aplicația HbbTV a acestui canal nu vine din satelit: pista ei e criptată sau semnalul lipsește."
msgstr "لا يصل تطبيق HbbTV لهذه القناة من القمر الصناعي: مساره مشفّر أو الإشارة مفقودة."

msgid "Aplicația HbbTV a acestui canal nu s-a încărcat întreagă din satelit: semnalul e prea slab."
msgstr "لم يكتمل تحميل تطبيق HbbTV لهذه القناة من القمر الصناعي: الإشارة ضعيفة جدًا."

msgid "Aplicația HbbTV a acestui canal e prea mare pentru memoria receptorului."
msgstr "حجم تطبيق HbbTV لهذه القناة أكبر من سعة ذاكرة جهاز الاستقبال."

msgid "Aplicația HbbTV din satelit nu are pagina de pornire anunțată de canal."
msgstr "لا يحتوي تطبيق HbbTV القادم من القمر الصناعي على صفحة البداية التي أعلنت عنها القناة."

msgid "Aplicația HbbTV din satelit nu se poate citi acum din semnalul canalului."
msgstr "لا يمكن قراءة تطبيق HbbTV القادم من القمر الصناعي من إشارة القناة الآن."

msgid "Aplicația HbbTV a acestui canal nu are o adresă pe internet."
msgstr "لا يوجد عنوان على الإنترنت لتطبيق HbbTV لهذه القناة."

msgid "Memoria liberă a receptorului a scăzut, așa că aplicația HbbTV s-a închis."
msgstr "أُغلق تطبيق HbbTV بسبب انخفاض الذاكرة المتاحة في جهاز الاستقبال."

msgid "Aplicația HbbTV nu a pornit."
msgstr "لم يبدأ تطبيق HbbTV."

msgid "Aplicația HbbTV s-a închis."
msgstr "أُغلق تطبيق HbbTV."

msgid "Aplicația HbbTV a canalului s-a închis singură, înainte să se arate."
msgstr "أُغلق تطبيق HbbTV للقناة تلقائيًا قبل ظهوره."

msgid "Navigatorul web e deschis. Închide-l, apoi apasă din nou ROȘU."
msgstr "متصفح الويب مفتوح. أغلقه، ثم اضغط الزر الأحمر مرة أخرى."

msgid "Aplicația HbbTV a canalului nu s-a arătat pe ecran. Unele aplicații lucrează numai în fundal, fără nimic de arătat."
msgstr "لم يظهر تطبيق HbbTV للقناة على الشاشة. تعمل بعض التطبيقات في الخلفية فقط، دون عرض أي شيء."

msgid "Aplicațiile HbbTV nu pornesc cât rulează o înregistrare."
msgstr "لا تعمل تطبيقات HbbTV أثناء إجراء تسجيل."

msgid "A început o înregistrare, așa că aplicația HbbTV s-a închis."
msgstr "بدأ تسجيل، لذلك أُغلق تطبيق HbbTV."

msgid "Memoria liberă a receptorului nu ajunge acum pentru aplicația HbbTV."
msgstr "الذاكرة المتاحة في جهاز الاستقبال لا تكفي لتطبيق HbbTV الآن."

msgid "Aplicația HbbTV a acestui canal e folosită numai pentru măsurarea audienței și nu are nimic de arătat pe ecran."
msgstr "يُستخدم تطبيق HbbTV لهذه القناة لقياس نسب المشاهدة فقط، ولا يعرض أي شيء على الشاشة."

msgid "Aplicația HbbTV a acestui canal e o pagină goală: postul nu a pus nimic în ea."
msgstr "تطبيق HbbTV لهذه القناة صفحة فارغة: لم تضع القناة أي شيء فيها."

msgid "Aplicația HbbTV a acestui canal nu mai este la adresa anunțată de post: pagina a fost mutată sau ștearsă."
msgstr "لم يعد تطبيق HbbTV لهذه القناة موجودًا على العنوان الذي أعلنته القناة: نُقلت الصفحة أو حُذفت."

msgid "Adresa aplicației HbbTV a acestui canal nu mai există pe internet."
msgstr "لم يعد عنوان تطبيق HbbTV لهذه القناة موجودًا على الإنترنت."

msgid "Receptorul nu are acces la internet, iar aplicațiile HbbTV vin de pe internet."
msgstr "جهاز الاستقبال غير متصل بالإنترنت، وتطبيقات HbbTV تُحمّل من الإنترنت."

msgid "Aplicația HbbTV a acestui canal se deschide numai pe anumite televizoare și nu a primit receptorul."
msgstr "لا يفتح تطبيق HbbTV لهذه القناة إلا على أجهزة تلفزيون معيّنة، ولم يسمح لجهاز الاستقبال بالدخول."

msgid "Aplicația HbbTV a acestui canal pornește cu tasta ALBASTRU. Apasă ALBASTRU."
msgstr "يبدأ تطبيق HbbTV لهذه القناة بالزر الأزرق. اضغط الزر الأزرق."

msgid "Aplicația HbbTV a acestui canal începe cu o întrebare de consimțământ care nu se vede pe ecran. De obicei trece singură în jumătate de minut."
msgstr "يبدأ تطبيق HbbTV لهذه القناة بسؤال موافقة لا يظهر على الشاشة. عادةً يتجاوزه تلقائيًا خلال نصف دقيقة."

msgid "Canalul e criptat și receptorul nu îl poate decripta acum, iar aplicația lui HbbTV nu s-a deschis."
msgstr "القناة مشفّرة ولا يستطيع جهاز الاستقبال فك تشفيرها الآن، ولم يفتح تطبيق HbbTV الخاص بها."

msgid "EXIT: renunță"
msgstr "EXIT: إلغاء"

msgid "HbbTV: se pornește aplicația canalului..."
msgstr "HbbTV: جارٍ بدء تطبيق القناة..."

msgid "Da, actualizează"
msgstr "نعم، تحديث"

msgid "Nu acum"
msgstr "ليس الآن"

#, python-format
msgid "Există o imagine nouă pentru receptorul tău: %s. Acum ai %s. O instalez acum? Canalele și setările tale rămân."
msgstr "تتوفر نسخة نظام جديدة لجهاز الاستقبال: %s. لديك الآن %s. هل أثبّتها الآن؟ ستبقى قنواتك وإعداداتك."

#, python-format
msgid "Există o versiune nouă pentru receptorul tău: %s. Acum ai %s. O instalez acum? Canalele și setările tale rămân."
msgstr "يتوفر إصدار جديد لجهاز الاستقبال: %s. لديك الآن %s. هل أثبّته الآن؟ ستبقى قنواتك وإعداداتك."

msgid "Pune un stick USB și apasă din nou."
msgstr "أدخل ذاكرة USB واضغط مرة أخرى."

#, python-format
msgid "Pe stick nu e destul loc: trebuie %d MB liberi."
msgstr "لا توجد مساحة كافية على ذاكرة USB: يلزم توفر %d ميغابايت."

msgid "Receptorul rulează acum de pe stick sau dintr-un loc necunoscut, deci nu pun singur imaginea nouă. O poți lua de pe site."
msgstr "يعمل جهاز الاستقبال الآن من ذاكرة USB أو من مكان غير معروف، لذلك لن أثبّت نسخة النظام الجديدة تلقائيًا. يمكنك تنزيلها من الموقع."

msgid "Numele stickului are spații sau semne cu care scrierea nu merge. Schimbă-i numele în calculator (de exemplu HDSATELIT) și apasă din nou."
msgstr "يحتوي اسم ذاكرة USB على مسافات أو رموز تمنع الكتابة. غيّر اسمها على الكمبيوتر، مثل HDSATELIT، واضغط مرة أخرى."

msgid "Ai cea mai nouă imagine pentru receptorul tău."
