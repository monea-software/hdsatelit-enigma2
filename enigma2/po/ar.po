#, python-format
msgid "cota terminată până la %s"
msgstr "نفدت الحصة حتى %s"

msgid "Canalul e criptat și receptorul nu-l poate decripta acum (fără card sau fără drepturi pentru el)."
msgstr "القناة مشفرة ولا يستطيع جهاز الاستقبال فك تشفيرها الآن (لا توجد بطاقة أو لا تتوفر صلاحية لمشاهدتها)."

msgid "Sunetul acestui canal nu se aude în browser."
msgstr "لا يمكن سماع صوت هذه القناة في المتصفح."

msgid "Imaginea merge."
msgstr "الصورة تعمل."

msgid "Imaginea acestui canal (MPEG-2) se decodează în browser, pe procesorul calculatorului."
msgstr "تُفك شفرة صورة هذه القناة (MPEG-2) داخل المتصفح باستخدام معالج الكمبيوتر."

msgid "Acest canal trimite imaginea în HEVC, iar acest browser nu o poate reda. Încearcă Chrome sau Edge pe un calculator cu placă video nouă, sau Safari."
msgstr "تبث هذه القناة الصورة بصيغة HEVC، ولا يستطيع هذا المتصفح عرضها. جرّب Chrome أو Edge على كمبيوتر ببطاقة رسومات حديثة، أو Safari."

msgid "Acest canal trimite imaginea într-un format pe care browserele nu îl redau."
msgstr "تبث هذه القناة الصورة بصيغة لا تدعمها المتصفحات."

msgid "Formatul imaginii nu se știe încă. Dacă nu apare imaginea, canalul e probabil MPEG-2."
msgstr "صيغة الصورة غير معروفة بعد. إذا لم تظهر الصورة، فالقناة على الأرجح تستخدم MPEG-2."

msgid "Sunetul acestui canal e AC-3 și nu se aude în acest browser."
msgstr "صوت هذه القناة بصيغة AC-3 ولا يمكن سماعه في هذا المتصفح."

msgid "Sunetul acestui canal (E-AC-3) nu se aude în browser."
msgstr "لا يمكن سماع صوت هذه القناة (E-AC-3) في المتصفح."

msgid "Sunetul acestui canal (HE-AAC LATM) nu se aude în browser."
msgstr "لا يمكن سماع صوت هذه القناة (HE-AAC LATM) في المتصفح."

msgid "Transmisia a fost preluată de altă fereastră."
msgstr "انتقل البث إلى نافذة أخرى."

msgid "Ai ales alt canal."
msgstr "اخترت قناة أخرى."

msgid "Pista audio nu există (poate s-a schimbat emisiunea)."
msgstr "المسار الصوتي غير موجود (ربما تغيّر البرنامج)."

msgid "Canalul nu se poate porni (nu e în lista receptorului)."
msgstr "لا يمكن تشغيل القناة (ليست في قائمة جهاز الاستقبال)."

msgid "Tunerul nu se poate folosi acum."
msgstr "لا يمكن استخدام الموالف الآن."

msgid "Acest canal trimite imaginea în MPEG-2, iar acest browser nu o poate reda (îi lipsește WebAssembly sau WebGL). Încearcă Chrome, Edge, Firefox sau Safari nou."
msgstr "تبث هذه القناة الصورة بصيغة MPEG-2، ولا يستطيع هذا المتصفح عرضها (لا يتوفر فيه WebAssembly أو WebGL). جرّب إصدارًا حديثًا من Chrome أو Edge أو Firefox أو Safari."

msgid "Sunetul acestui canal e AC-3. Unele browsere îl redau, altele nu."
msgstr "صوت هذه القناة بصيغة AC-3. تدعمه بعض المتصفحات ولا تدعمه أخرى."

msgid "Tunerul e ocupat de o înregistrare pe altă frecvență."
msgstr "الموالف مشغول بتسجيل على تردد آخر."

msgid "Alege un canal din listă."
msgstr "اختر قناة من القائمة."

msgid "Transmisia în browser e oprită din setări (pe televizor sau în această pagină)."
msgstr "البث إلى المتصفح معطّل في الإعدادات (على التلفزيون أو في هذه الصفحة)."

msgid "Receptorul e în standby. Transmisia în standby e oprită din setări."
msgstr "جهاز الاستقبال في وضع الاستعداد. البث في وضع الاستعداد معطّل في الإعدادات."

msgid "Tunerul e folosit acum pe altă frecvență (de televizor sau de o înregistrare). Alege un canal de pe aceeași frecvență cu televizorul."
msgstr "الموالف مستخدم حاليًا على تردد آخر (للتلفزيون أو لتسجيل). اختر قناة على التردد نفسه الذي يستخدمه التلفزيون."

msgid "Nimeni nu se mai uita."
msgstr "لم يعد أحد يشاهد."

msgid "Nu transmite nimic spre acest browser."
msgstr "لا يوجد بث إلى هذا المتصفح."

msgid "Transmisia s-a oprit."
msgstr "توقف البث."

msgid "Transmisia s-a oprit: televizorul a trecut pe un canal de pe altă frecvență."
msgstr "توقف البث: انتقل التلفزيون إلى قناة على تردد آخر."

msgid "Transmisia merge numai pe receptor."
msgstr "البث يعمل على جهاز الاستقبال فقط."

#, python-format
msgid "Tunerul nu poate primi acest canal acum (%d)."
msgstr "لا يستطيع الموالف استقبال هذه القناة الآن (%d)."

#, python-format
msgid "Canalul nu pornește (%d)."
msgstr "تعذر تشغيل القناة (%d)."

#, python-format
msgid "Receptorul transmite deja spre %s. Oprește acea transmisie din pagina TV în browser sau de pe televizor."
msgstr "جهاز الاستقبال يبث بالفعل إلى %s. أوقف ذلك البث من صفحة التلفزيون في المتصفح أو من التلفزيون."

msgid "Memoria driverului video e pe sfârșite. Repornește receptorul ca să poți transmite din nou."
msgstr "أوشكت ذاكرة برنامج تشغيل الفيديو على النفاد. أعد تشغيل جهاز الاستقبال لتتمكن من البث مجددًا."

msgid "Memoria driverului video ar ajunge prea jos. Repornește receptorul ca să poți transmite din nou."
msgstr "ستصبح الذاكرة المتاحة لبرنامج تشغيل الفيديو قليلة جدًا. أعد تشغيل جهاز الاستقبال لتتمكن من البث مجددًا."

msgid "Pentru un canal de satelit, pornește întâi pe televizor un canal de pe același satelit. Antena nu se rotește din browser."
msgstr "لمشاهدة قناة فضائية، شغّل أولًا على التلفزيون قناة من القمر الصناعي نفسه. لا يمكن تدوير الطبق من المتصفح."

msgid "Canalul e pe alt satelit decât televizorul. Antena ar trebui să se rotească."
msgstr "القناة على قمر صناعي مختلف عن القمر المستخدم على التلفزيون. سيتطلب ذلك تدوير الطبق."

msgid "Pe acest receptor (antenă cu motor sau un singur tuner de satelit) transmisia merge numai cu canalele de pe frecvența televizorului: altfel tunerul s-ar reacorda și antena s-ar putea mișca. Schimbă întâi canalul pe televizor."
msgstr "على هذا الجهاز (بطبق متحرك أو بموالف فضائي واحد)، يعمل البث فقط مع القنوات الموجودة على تردد قناة التلفزيون: استخدام تردد آخر سيغيّر ضبط الموالف وقد يحرك الطبق. غيّر القناة على التلفزيون أولًا."

msgid "Pista audio nu e un număr."
msgstr "رقم المسار الصوتي ليس عددًا."

msgid "Transmisia în browser a fost oprită din setări."
msgstr "تم تعطيل البث إلى المتصفح من الإعدادات."

msgid "Transmisia s-a oprit: a pornit o înregistrare pe altă frecvență."
msgstr "توقف البث: بدأ تسجيل على تردد آخر."

#, python-format
