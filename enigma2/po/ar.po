msgstr "طلبت التشغيل من صفحة الويب. اقرأ، ثم اضغط الزر الأخضر إذا أردت."

msgid "Asistență de la distanță activă"
msgstr "الدعم عن بُعد مفعّل"

#, python-format
msgid "Conectat. Mai sunt %s."
msgstr "متصل. الوقت المتبقي: %s."

#, python-format
msgid "Dai acces la distanță pentru %s, nivel „Citire și probe”. Pornind, confirmi că ai cel puțin 16 ani sau acordul unui părinte. Poți opri oricând. Pornești?"
msgstr "ستمنح وصولًا عن بُعد لمدة %s، بمستوى «القراءة والاختبارات». بتشغيله، تؤكد أن عمرك 16 عامًا على الأقل أو أنك حصلت على موافقة أحد والديك. يمكنك إيقافه في أي وقت. هل تريد تشغيله؟"

#, python-format
msgid "Oprești din %s"
msgstr "يمكنك الإيقاف من %s"

msgid "Pe televizor s-a deschis Asistența de la distanță: citește și apasă Verde acolo."
msgstr "فُتح الدعم عن بُعد على التلفزيون: اقرأ واضغط الزر الأخضر هناك."

#, python-format
msgid "Spune-ne codul de mai jos. Mai sunt %s."
msgstr "أخبرنا بالرمز أدناه. الوقت المتبقي: %s."

msgid "Datele le primește Eduard Monea, persoană fizică (mărcile Monea Software și HD Satelit), contact@hdsatelit.com. Pleacă numai felurile bifate de tine, cu un identificator întâmplător, fără adresa IP, fără parole și fără listele tale de canale, numai ca să îmbunătățim imaginea pe modelul tău de receptor. Jurnalele se păstrează 6 luni, celelalte date 12 luni. Poți debifa oricând un fel de date sau poți ieși din program cu ștergerea datelor. Nota întreagă e la adresa de mai jos."
msgstr "يتلقى البيانات Eduard Monea، بصفته شخصًا طبيعيًا (العلامتان التجاريتان Monea Software وHD Satelit)، contact@hdsatelit.com. لا تُرسل إلا أنواع البيانات التي تحددها، مع معرّف عشوائي، ودون عنوان IP أو كلمات مرور أو قوائم القنوات الخاصة بك، وذلك فقط لتحسين الصورة على طراز جهاز الاستقبال لديك. تُحفظ السجلات لمدة 6 أشهر، والبيانات الأخرى لمدة 12 شهرًا. يمكنك في أي وقت إلغاء تحديد أي نوع من البيانات أو الانسحاب من البرنامج مع حذف البيانات. الإشعار الكامل متاح على العنوان أدناه."

msgid "Mulțumim. Ești beta tester. Datele bifate pleacă de acum."
msgstr "شكرًا لك. أصبحت مختبِرًا للنسخ التجريبية. سيبدأ الآن إرسال البيانات التي حددتها."

msgid "Cere ajutor de la distanță"
msgstr "طلب مساعدة عن بُعد"

msgid "cererea a expirat"
msgstr "انتهت مهلة الطلب"

msgid "codul a expirat"
msgstr "انتهت صلاحية الرمز"

msgid "Ne lași să vedem starea receptorului, cât alegi tu."
msgstr "تسمح لنا بالاطّلاع على حالة جهاز الاستقبال للمدة التي تختارها."

msgid "La o problemă, ne lași să ne uităm la receptor, cât vrei tu"
msgstr "عند حدوث مشكلة، تسمح لنا بفحص جهاز الاستقبال للمدة التي تريدها"

msgid "Asistența de la distanță: o pornești tu și o oprești oricând."
msgstr "الدعم عن بُعد: تشغّله بنفسك وتوقفه في أي وقت."

msgid "Asistența de la distanță e pentru beta testeri."
msgstr "الدعم عن بُعد مخصص لمختبِري النسخ التجريبية."

msgid "cod arătat pe ecran, aștept aprobarea"
msgstr "ظهر الرمز على الشاشة، بانتظار الموافقة"

msgid "codul a expirat fără aprobare"
msgstr "انتهت صلاحية الرمز دون موافقة"

msgid "reluată după repornirea interfeței"
msgstr "تم الاستئناف بعد إعادة تشغيل الواجهة"

msgid "copie filtrată a setărilor (audio, video, interfață, rețea; fără parole și chei)"
msgstr "نسخة من الإعدادات بعد تصفيتها (الصوت، الفيديو، الواجهة، الشبكة؛ دون كلمات المرور والمفاتيح)"

msgid "o captură a ecranului (numai meniurile, fără imaginea canalului)"
msgstr "لقطة للشاشة (القوائم فقط، دون صورة القناة)"

msgid "rețeaua: cablu sau Wi-Fi, legat sau nu, ruta implicită, DNS (fără numele rețelei, MAC mascat)"
msgstr "الشبكة: كابل أو Wi-Fi، متصل أم لا، المسار الافتراضي، DNS (دون اسم الشبكة، مع إخفاء عنوان MAC)"

msgid "un mesaj nou"
msgstr "رسالة جديدة واحدة"

msgid "Parola lui root, aceeași pentru FTP, SSH și SFTP"
msgstr "كلمة مرور root، وهي نفسها لـ FTP وSSH وSFTP"

#, python-format
msgid "FTP sau SFTP: %s, utilizatorul root · SSH: ssh root@%s"
msgstr "FTP أو SFTP: %s، المستخدم root · SSH: ssh root@%s"

msgid "Cu parola se intră numai din rețeaua ta de acasă. Cu o cheie SSH pusă mai jos, calculatorul intră fără parolă."
msgstr "تتيح كلمة المرور الدخول من شبكتك المنزلية فقط. وبإضافة مفتاح SSH أدناه، يتصل الكمبيوتر دون كلمة مرور."

msgid "Antenă terestră (DVB-T/T2)"
msgstr "هوائي أرضي (DVB-T/T2)"

msgid "Cablu (DVB-C)"
msgstr "كابل (DVB-C)"

msgid "Fiecare frecvență se încearcă DVB-T2 și DVB-T."
msgstr "يُجرَّب كل تردد بنظامي DVB-T2 وDVB-T."

msgid "Modulația aleasă nu e primită. Alege alta."
msgstr "لا يمكن استقبال نوع التضمين المختار. اختر نوعًا آخر."

msgid "256QAM e numai la DVB-T2: alege DVB-T2 la Sistem sau altă modulație."
msgstr "256QAM متاح فقط مع DVB-T2: اختر DVB-T2 في خانة النظام أو اختر نوع تضمين آخر."

msgid "Acceptă nota nouă"
msgstr "قبول الإشعار الجديد"

msgid "Cu ce te ajutăm?"
msgstr "كيف نساعدك؟"

msgid "Scrie pe scurt (opțional)"
msgstr "اكتب باختصار (اختياري)"

msgid "Dacă vrei, alege cu ce te ajutăm și scrie pe scurt ce se întâmplă (OK deschide lista sau tastatura). Nu e obligatoriu: Verde pornește oricum."
msgstr "إذا أردت، اختر ما تحتاج إلى مساعدة فيه واكتب باختصار ما يحدث (يفتح زر OK القائمة أو لوحة المفاتيح). هذا اختياري: الزر الأخضر يشغّل الدعم في جميع الأحوال."

msgid "Am primit cererea ta, cu codul de mai jos. Nu trebuie să faci nimic."
msgstr "وصلنا طلبك بالرمز الموضح أدناه. لا تحتاج إلى فعل أي شيء."

#, python-format
msgid "Am primit cererea ta, cu codul de mai jos. Nu trebuie să faci nimic. Mai sunt %s."
msgstr "وصلنا طلبك بالرمز الموضح أدناه. لا تحتاج إلى فعل أي شيء. المتبقي %s."

msgid "Dai acces la distanță permanent, până îl oprești tu, nivel „Citire și probe”. Pornind, confirmi că ai cel puțin 16 ani sau acordul unui părinte. Poți opri oricând. Pornești?"
msgstr "ستسمح بالوصول عن بُعد بشكل دائم، حتى توقفه بنفسك، بمستوى \"القراءة والاختبارات\". بتفعيله، تؤكد أن عمرك 16 عامًا على الأقل أو أن لديك موافقة أحد والديك. يمكنك إيقافه في أي وقت. هل تريد تفعيله؟"

msgid "Poate rămâne pornită cât alegi tu: 2 ore, 12 ore, o zi, o săptămână, o lună sau permanent. O oprești oricând, de pe receptor sau din pagina web. Cât e pornită, echipa poate intra oricând, dar face numai citirile și probele din lista fixă, fără să schimbe nimic."
msgstr "يمكنك إبقاء الخدمة مفعّلة للمدة التي تختارها: ساعتين، أو 12 ساعة، أو يومًا، أو أسبوعًا، أو شهرًا، أو بشكل دائم. يمكنك إيقافها في أي وقت من جهاز الاستقبال أو من صفحة الويب. ما دامت مفعّلة، يمكن للفريق الدخول في أي وقت، لكنه يكتفي بقراءة المعلومات وإجراء الاختبارات الواردة في القائمة المحددة، دون تغيير أي شيء."

msgid "Adaugă, șterge și sari între marcaje de tăiere pe înregistrarea aflată în redare"
msgstr "أضف علامات القطع واحذفها وتنقّل بينها في التسجيل الذي تشاهده"

msgid "Alege o poză de pe stick. Se aduce la 1920x1080 fără deformare și i se scrie rândul de jos."
msgstr "اختر صورة من ذاكرة USB. سيُضبط مقاسها على 1920x1080 دون تشويه، وسيُكتب عليها السطر السفلي."

#, python-format
msgid "Deocamdată nu se poate: receptorului îi lipsește %s. Ecranele gata făcute merg toate."
msgstr "هذا غير ممكن حاليًا: يفتقر جهاز الاستقبال إلى %s. جميع الشاشات الجاهزة تعمل."

#, python-format
msgid "Deocamdată nu se pot folosi poze proprii: receptorului îi lipsește %s. Ecranele gata făcute merg toate, le poți schimba de aici oricând."
msgstr "لا يمكن استخدام صورك الخاصة حاليًا: يفتقر جهاز الاستقبال إلى %s. جميع الشاشات الجاهزة تعمل، ويمكنك تغييرها من هنا في أي وقت."

msgid "Galeria de ecrane nu este instalată pe acest receptor. Poți totuși folosi o poză proprie, dacă receptorul are uneltele necesare."
msgstr "معرض الشاشات غير مثبّت على جهاز الاستقبال هذا. ومع ذلك، يمكنك استخدام صورة خاصة بك إذا توفرت في جهاز الاستقبال الأدوات اللازمة."

msgid "Picture Sharpness (HD Satelit)"
msgstr "حدة الصورة (HD Satelit)"

#, python-format
msgid "Poziția curentă: %s; Verde adaugă un marcaj simplu, Galben adaugă START/STOP tăiere."
msgstr "الموضع الحالي: %s؛ الزر الأخضر يضيف علامة عادية، والأصفر يضيف علامة بداية/نهاية القطع."

msgid "Previzualizarea se vede după ce receptorul primește și pozele mici ale ecranelor."
msgstr "ستظهر المعاينة بعد أن يتلقى جهاز الاستقبال الصور المصغّرة للشاشات أيضًا."

msgid "START tăiere"
msgstr "بداية القطع"

msgid "START tăiere (aici începe porțiunea de sărit)"
msgstr "بداية القطع (هنا يبدأ الجزء الذي سيتم تخطيه)"

msgid "START/STOP tăiere aici"
msgstr "بداية/نهاية القطع هنا"

msgid "STOP tăiere"
msgstr "نهاية القطع"

msgid "STOP tăiere (aici se termină porțiunea de sărit)"
msgstr "نهاية القطع (هنا ينتهي الجزء الذي سيتم تخطيه)"

#, python-format
msgid "ULTIMA CONFIRMARE: se scrie REAL noul software pe receptor.\nNU opri receptorul de la curent și NU scoate mediul cât timp scrie.\nInterfața se va opri și receptorul se va reporni singur la final.\n\nPachet: %s\n\nChiar continui?"
msgstr "التأكيد الأخير: ستتم كتابة البرنامج الجديد فعليًا على جهاز الاستقبال.\nلا تفصل جهاز الاستقبال عن الكهرباء ولا تنزع وسيط التخزين أثناء الكتابة.\nستتوقف الواجهة وسيُعاد تشغيل جهاز الاستقبال تلقائيًا عند الانتهاء.\n\nالحزمة: %s\n\nهل تريد المتابعة فعلًا؟"

msgid "Echipa HD Satelit vede prin internet starea receptorului tău, ca să te ajute, fără să schimbe nimic. O oprești oricând."
msgstr "يطّلع فريق HD Satelit عبر الإنترنت على حالة جهاز الاستقبال لديك لمساعدتك، دون تغيير أي شيء. يمكنك إيقاف الخدمة في أي وقت."

msgid "Start o pornește pentru 2 ore. O oprești oricând, de pe receptor sau din pagina web. Cât e pornită, echipa poate intra oricând, dar face numai citirile și probele din lista fixă, fără să schimbe nimic."
msgstr "زر البدء يفعّل الخدمة لمدة ساعتين. يمكنك إيقافها في أي وقت من جهاز الاستقبال أو من صفحة الويب. ما دامت مفعّلة، يمكن للفريق الدخول في أي وقت، لكنه يكتفي بقراءة المعلومات وإجراء الاختبارات الواردة في القائمة المحددة، دون تغيير أي شيء."

msgid "Derularea listelor"
msgstr "تمرير القوائم"

msgid "Rând cu rând"
msgstr "سطرًا بسطر"

msgid "Pagină cu pagină"
msgstr "صفحة بصفحة"

msgid "Cum se mișcă meniurile, listele de alegere și ecranele de setări când cursorul ajunge la marginea ecranului. Rând cu rând: lista urcă un rând și vezi mereu încă două rânduri sub cursor, deci observi că mai sunt rânduri. Pagină cu pagină: lista sare pe pagina următoare, ca înainte. Lista de canale și ghidul rămân pe pagini."
msgstr "طريقة تمرير القوائم وقوائم الاختيار وشاشات الإعدادات عندما يصل المؤشر إلى حافة الشاشة. سطرًا بسطر: تتحرك القائمة سطرًا واحدًا إلى الأعلى، ويظهر دائمًا سطران إضافيان أسفل المؤشر، لتلاحظ وجود المزيد من السطور. صفحة بصفحة: تنتقل القائمة إلى الصفحة التالية، كما كانت تفعل من قبل. تظل قائمة القنوات ودليل البرامج بنظام الصفحات."

msgid "Forma ecranului televizorului: 16:9 la televizoarele late de azi, 4:3 la cele vechi. Ce se face cu emisiunile 4:3 se alege în Setări video avansate, la „Imaginea 4:3”."
msgstr "نسبة أبعاد شاشة التلفزيون: 16:9 للتلفزيونات العريضة الحديثة، و4:3 للتلفزيونات القديمة. يمكنك اختيار طريقة عرض البرامج ذات النسبة 4:3 من الإعدادات المتقدمة للفيديو، ضمن \"صورة 4:3\"."

msgid "Câte setări se văd în meniuri: Simplu arată numai ce se folosește des, Intermediar și Expert arată tot mai multe."
msgstr "عدد الإعدادات التي تظهر في القوائم: يعرض المستوى البسيط الإعدادات الشائعة فقط، بينما يعرض المستوى المتوسط ثم مستوى الخبير المزيد من الإعدادات."

msgid "Pornire automată"
msgstr "التشغيل التلقائي"

msgid "nu se scrie: numele stickului are spații"
msgstr "لا يمكن الكتابة: اسم ذاكرة USB يحتوي على مسافات"

msgid "nu se scrie: numele stickului are semne neacceptate"
msgstr "لا يمكن الكتابة: اسم ذاكرة USB يحتوي على رموز غير مقبولة"

msgid "not available"
msgstr "غير متاح"

msgid "Pe stick nu se poate scrie, deci nu pornește scrierea. Pe receptor nu s-a schimbat nimic."
msgstr "لا يمكن الكتابة على ذاكرة USB، لذلك لن تبدأ عملية الكتابة. لم يتغير أي شيء في جهاز الاستقبال."
