msgstr "يتم إرسال sus=0|1 وdhcp=0|1."

#, python-format
msgid "Activezi aceste setări de rețea pentru %s?"
msgstr "هل تريد تفعيل إعدادات الشبكة هذه لـ %s؟"

msgid "Placa implicită se alege numai când sunt două plăci configurate."
msgstr "لا يمكن اختيار البطاقة الافتراضية إلا عند إعداد بطاقتين."

msgid "Placa aceasta e deja cea implicită."
msgstr "هذه البطاقة هي الافتراضية بالفعل."

#, python-format
msgid "Faci din %s placa implicită? Rețeaua repornește."
msgstr "هل تريد جعل %s البطاقة الافتراضية؟ سيُعاد تشغيل الشبكة."

msgid "Cât rețeaua repornește, legătura cu receptorul se întrerupe câteva secunde."
msgstr "أثناء إعادة تشغيل الشبكة، ينقطع الاتصال بجهاز الاستقبال لبضع ثوانٍ."

msgid "Proba rețelei încă lucrează."
msgstr "لا يزال اختبار الشبكة جاريًا."

msgid "Nu s-a găsit nicio rețea. Caută din nou."
msgstr "لم يتم العثور على أي شبكة. ابحث من جديد."

msgid "Căutarea n-a reușit. Caută din nou."
msgstr "تعذر البحث. ابحث من جديد."

msgid "The WiFi adapter could not be started."
msgstr "تعذر تشغيل بطاقة WiFi."

#, python-format
msgid "Te conectezi la rețeaua Wi-Fi %s?"
msgstr "هل تريد الاتصال بشبكة Wi-Fi %s؟"

msgid "Dacă nu se poate conecta, receptorul pune înapoi setările de acum."
msgstr "إذا تعذر الاتصال، فسيعيد جهاز الاستقبال الإعدادات الحالية."

msgid "Nu se face nicio conectare acum."
msgstr "لا توجد محاولة اتصال جارية الآن."

msgid "Fără niciun server DNS, receptorul nu mai găsește adresele de pe internet după nume."
msgstr "من دون أي خادم DNS، لن يعود جهاز الاستقبال قادرًا على العثور على عناوين الإنترنت باستخدام أسمائها."

#, python-format
msgid "Placa de rețea %s nu există pe receptor."
msgstr "بطاقة الشبكة %s غير موجودة على جهاز الاستقبال."

msgid "Browserul tău e legat la receptor prin această placă. Când placa se oprește, pagina nu mai răspunde până o pornești din nou de pe televizor."
msgstr "متصفحك متصل بجهاز الاستقبال عبر هذه البطاقة. عند إيقاف البطاقة، لن تستجيب الصفحة حتى تعيد تشغيلها من التلفزيون."

#, python-format
msgid "Se oprește și cealaltă placă configurată: %s."
msgstr "ستتوقف أيضًا البطاقة الأخرى المضبوطة: %s."

msgid "Browserul tău e legat la receptor prin ea: pagina nu va mai răspunde de aici."
msgstr "متصفحك متصل بجهاز الاستقبال عبرها: لن تستجيب الصفحة من هنا بعد ذلك."

#, python-format
msgid "Placa %s nu e o placă Wi-Fi."
msgstr "البطاقة %s ليست بطاقة Wi-Fi."

#, python-format
msgid "Networks found: %d"
msgstr "الشبكات التي عُثر عليها: %d"

msgid "Scrie numele rețelei ascunse."
msgstr "أدخل اسم الشبكة المخفية."

msgid "A network name may have at most 32 bytes."
msgstr "يجب ألا يتجاوز اسم الشبكة 32 بايت."

msgid "Alege o rețea din listă."
msgstr "اختر شبكة من القائمة."

#, python-format
msgid "Placa %s se oprește și pornește din nou cu rețeaua aleasă. Dacă browserul e legat la receptor prin Wi-Fi, legătura se poate pierde."
msgstr "ستتوقف البطاقة %s ثم تعمل مجددًا بالشبكة المختارة. إذا كان المتصفح متصلًا بجهاز الاستقبال عبر Wi-Fi، فقد ينقطع الاتصال."

msgid "Se trimite lista servere=a.b.c.d,e.f.g.h (poate fi goală)."
msgstr "تُرسَل القائمة servere=a.b.c.d,e.f.g.h (يمكن أن تكون فارغة)."

#, python-format
msgid "Valoarea %s nu e bună pentru %s (se alege 0 sau 1)."
msgstr "القيمة %s غير صالحة لـ %s (اختر 0 أو 1)."

#, python-format
msgid "Adresa %s nu e bună. Se scrie ca 192.168.1.10."
msgstr "العنوان %s غير صالح. اكتبه بهذا الشكل: 192.168.1.10."

#, python-format
msgid "Masca %s nu e bună (exemplu: 255.255.255.0)."
msgstr "قناع الشبكة %s غير صالح (مثال: 255.255.255.0)."

#, python-format
msgid "Adresa IP %s nu poate fi a receptorului în această rețea."
msgstr "لا يمكن استخدام عنوان IP %s لجهاز الاستقبال في هذه الشبكة."

msgid "Browserul tău e legat la receptor prin această placă. Adresa o va da routerul și poate fi alta decât acum: o vezi pe televizor, la informațiile despre rețea, sau în lista routerului."
msgstr "متصفحك متصل بجهاز الاستقبال عبر هذه البطاقة. سيحدد الراوتر العنوان، وقد يختلف عن العنوان الحالي: ستجده على التلفزيون ضمن معلومات الشبكة، أو في قائمة الراوتر."

#, python-format
msgid "Conectarea nu s-a putut face: %s"
msgstr "تعذر الاتصال: %s"

#, python-format
msgid "Cel mult %d servere DNS."
msgstr "الحد الأقصى لعدد خوادم DNS هو %d."

#, python-format
msgid "Poarta %s nu e bună."
msgstr "البوابة %s غير صالحة."

#, python-format
msgid "Poarta %s nu e în aceeași rețea cu adresa %s și masca %s."
msgstr "البوابة %s ليست ضمن الشبكة نفسها مع العنوان %s وقناع الشبكة %s."

#, python-format
msgid "Adresa %s nu e a unui server DNS."
msgstr "العنوان %s ليس عنوان خادم DNS."

#, python-format
msgid "Browserul tău e legat la receptor prin această placă. După aplicare, pagina va fi la %s."
msgstr "متصفحك متصل بجهاز الاستقبال عبر هذه البطاقة. بعد تطبيق الإعدادات، ستكون الصفحة على العنوان %s."

#, python-format
msgid "WiFi is not active on %s."
msgstr "Wi-Fi غير مفعّل على %s."

msgid "Importul a pornit."
msgstr "بدأ الاستيراد."

msgid "Da, adu-le"
msgstr "نعم، استوردها"

msgid "Am adus"
msgstr "استوردتها"

msgid "Nu am adus"
msgstr "لم أستوردها"

msgid "Am înțeles"
msgstr "فهمت"

msgid "Copia din care se importă"
msgstr "النسخة التي سيتم الاستيراد منها"

msgid "Ce se importă"
msgstr "ما سيتم استيراده"

msgid "Pluginurile din copie"
msgstr "الإضافات الموجودة في النسخة"

msgid "Sunt în sursele receptorului și nu sunt instalate. Fiecare are întrebarea lui, ca la Extensii și aplicații."
msgstr "متوفرة في مصادر جهاز الاستقبال وغير مثبتة. سيظهر سؤال لكل إضافة، كما في الإضافات والتطبيقات."

msgid "<a href=\"/setari-din-copie\">Setările importate</a>: starea lor și repornirea interfeței."
msgstr "<a href=\"/setari-din-copie\">الإعدادات المستوردة</a>: حالتها وإعادة تشغيل الواجهة."

msgid "Înainte de import, receptorul păstrează canalele și setările de acum într-o copie de siguranță, care apare apoi în lista de mai sus („Copiile de siguranță de pe receptor”; se păstrează ultimele cinci): cu ea importul se poate întoarce. Setările alese intră la următoarea pornire a interfeței. Pe televizor: Meniu, Scanare, Import canale și setări."
msgstr "قبل الاستيراد، يحفظ جهاز الاستقبال القنوات والإعدادات الحالية في نسخة احتياطية تظهر لاحقًا في القائمة أعلاه («النسخ الاحتياطية على جهاز الاستقبال»؛ تُحفظ آخر خمس نسخ): يمكنك استخدامها للتراجع عن الاستيراد. تُطبّق الإعدادات المختارة عند تشغيل الواجهة في المرة التالية. على التلفزيون: القائمة، البحث، استيراد القنوات والإعدادات."

msgid "(lipsește din copie)"
msgstr "(غير موجود في النسخة)"

msgid "Se caută copiile pe stick-uri, discuri și în memoria receptorului..."
msgstr "جارٍ البحث عن النسخ في وحدات USB والأقراص وذاكرة جهاز الاستقبال..."

msgid "Receptorul nu a putut citi sursele."
msgstr "تعذر على جهاز الاستقبال قراءة المصادر."

msgid "Interfața repornește acum, ca să intre setările antenei. Continui?"
msgstr "ستُعاد الآن تشغيل الواجهة لتطبيق إعدادات الطبق. هل تريد المتابعة؟"

msgid "Interfața repornește..."
msgstr "جارٍ إعادة تشغيل الواجهة..."

msgid "Canalele și setările alese se înlocuiesc cu cele din:"
msgstr "سيتم استبدال القنوات والإعدادات المختارة بتلك الموجودة في:"

msgid "Cele de acum se păstrează într-o copie de siguranță pe receptor. Continui?"
msgstr "ستُحفظ القنوات والإعدادات الحالية في نسخة احتياطية على جهاز الاستقبال. هل تريد المتابعة؟"

msgid "Se pregătește copia..."
msgstr "جارٍ تجهيز النسخة..."

msgid "Copia aleasă nu mai este în listă. Caută din nou."
msgstr "لم تعد النسخة المختارة موجودة في القائمة. ابحث مجددًا."

msgid "Receptorul nu a putut citi listele."
msgstr "تعذر على جهاز الاستقبال قراءة القوائم."

msgid "Se deschide de pe televizor."
msgstr "يُفتح من التلفزيون."

msgid "Nicio scanare de canale de la pornirea receptorului."
msgstr "لم يُجرَ أي بحث عن القنوات منذ تشغيل جهاز الاستقبال."

msgid "O scanare DAB+ sau DVB-T2 e deschisă pe televizor. Așteaptă să se termine sau oprește-o."
msgstr "يوجد بحث DAB+ أو DVB-T2 مفتوح على التلفزيون. انتظر حتى ينتهي أو أوقفه."

msgid "O căutare e deja în curs pe receptor. Așteaptă să se termine sau oprește-o."
msgstr "يوجد بحث جارٍ بالفعل على جهاز الاستقبال. انتظر حتى ينتهي أو أوقفه."

msgid "Ecranul scanării nu s-a deschis pe televizor. Detalii în jurnalul receptorului."
msgstr "لم تُفتح شاشة البحث على التلفزيون. التفاصيل في سجل جهاز الاستقبال."

msgid "Acum nu se poate face asta: ecranul de pe televizor e la alt pas."
msgstr "لا يمكن تنفيذ ذلك الآن: الشاشة على التلفزيون في خطوة أخرى."

msgid "Scanare și antenă"
msgstr "البحث والطبق"

msgid "Se citește meniul receptorului..."
msgstr "جارٍ قراءة قائمة جهاز الاستقبال..."

msgid "Caută totuși"
msgstr "ابحث على أي حال"

msgid "Căutarea de pe televizor"
msgstr "البحث على التلفزيون"

msgid "Răspunsul detectorului și notele scanării, așa cum le arată televizorul pe tasta albastră."
