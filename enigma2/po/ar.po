msgstr "(MUX1 في %s)"

msgid "nicio listă"
msgstr "لا توجد قائمة"

#, python-format
msgid "Copia de siguranță a setărilor de acum: %s (%d fișiere)."
msgstr "النسخة الاحتياطية للإعدادات الحالية: %s (%d ملف)."

#, python-format
msgid "Canale și buchete importate: %d fișiere."
msgstr "القنوات والباقات المستوردة: %d ملف."

#, python-format
msgid "Înregistrări programate importate: %d fișiere."
msgstr "التسجيلات المجدولة المستوردة: %d ملف."

msgid "Limba și setările generale"
msgstr "اللغة والإعدادات العامة"

msgid "Limba meniului, fusul orar și setările de folosire, din copie."
msgstr "لغة القائمة والمنطقة الزمنية وإعدادات الاستخدام، من النسخة الاحتياطية."

msgid "Schimbă valorile cu OK, stânga sau dreapta. Caută cu OK pe „Caută acum” sau cu Verde."
msgstr "غيّر القيم باستخدام OK أو اليسار أو اليمين. ابدأ البحث بالضغط على OK عند \"بحث الآن\" أو بالزر الأخضر."

msgid "Apasă OK pe „Caută acum”: se deschide lista sateliților antenei, bifează-i pe cei de căutat."
msgstr "اضغط OK عند \"بحث الآن\": ستفتح قائمة الأقمار الصناعية التي يستقبلها الطبق، وحدد الأقمار المطلوب البحث فيها."

msgid "Nu e bifat niciun satelit. Bifează cu stânga sau dreapta sateliții de căutat, apoi apasă OK."
msgstr "لم يتم تحديد أي قمر صناعي. حدد الأقمار الصناعية المطلوب البحث فيها باستخدام اليسار أو اليمين، ثم اضغط OK."

msgid "Bifează sateliții de căutat cu stânga sau dreapta, apoi apasă OK."
msgstr "حدد الأقمار الصناعية المطلوب البحث فيها باستخدام اليسار أو اليمين، ثم اضغط OK."

msgid "Caută cu OK pe „Caută acum”."
msgstr "ابدأ البحث بالضغط على OK عند \"بحث الآن\"."

#, python-format
msgid "%d fișier"
msgstr "%d ملف"

#, python-format
msgid "%d fișier nu s-a putut copia (%s)"
msgstr "تعذّر نسخ %d ملف (%s)"

