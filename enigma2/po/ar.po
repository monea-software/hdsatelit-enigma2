msgstr "قائمة التشغيل (%d)"

msgid "The playlist is empty"
msgstr "قائمة التشغيل فارغة"

msgid "No picture could be shown"
msgstr "تعذّر عرض أي صورة"

msgid "OK full screen, INFO details, EXIT back to the list"
msgstr "OK ملء الشاشة، INFO تفاصيل، EXIT رجوع إلى القائمة"

