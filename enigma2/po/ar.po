msgid "%s (%s): %d frecvență."
msgstr "%s (%s): %d تردد."

#, python-format
msgid "%s: niciun operator de acest fel. Alte țări: OK pe rândul „Operator”."
msgstr "%s: لا يوجد مشغّل من هذا النوع. لدول أخرى: اضغط OK عند سطر \"المشغّل\"."

#, python-format
msgid ", %d frecvență"
msgstr "، %d تردد"

#, python-format
msgid ": toată rețeaua, pornind de la %s MHz"
msgstr ": الشبكة بأكملها، بدءًا من %s MHz"

msgid "Ansambluri DAB+"
msgstr "مجموعات بث DAB+"

msgid "Apasă OK pe „Caută acum”: se deschide lista sateliților de bifat."
msgstr "اضغط OK عند \"بحث الآن\": ستفتح قائمة الأقمار الصناعية لتحديدها."

msgid "DTMB (China, Hong Kong, Cuba)"
msgstr "DTMB (الصين، هونغ كونغ، كوبا)"

msgid "DVB-T (Europa clasic)"
msgstr "DVB-T (النظام الأوروبي التقليدي)"

msgid "Digi București, lista veche"
msgstr "Digi بوخارست، القائمة القديمة"

msgid "După canal"
msgstr "حسب القناة"

msgid "După regiune"
msgstr "حسب المنطقة"

msgid "Multiplexuri DVB-T2"
msgstr "حزم بث DVB-T2"

#, python-format
msgid "Operatorul %s (%s): %d frecvență cunoscută, plus cele anunțate în semnal."
msgstr "المشغّل %s (%s): %d تردد معروف، إضافة إلى الترددات المعلنة ضمن الإشارة."

msgid "Orange: căutare pe toată banda (frecvențele nu sunt publice)"
msgstr "Orange: بحث في النطاق الكامل (الترددات غير منشورة)"

msgid "Orange: frecvențele nu sunt publice; caută cu Cablu, „Toată banda”."
msgstr "Orange: الترددات غير منشورة؛ ابحث باختيار الكابل، ثم \"النطاق الكامل\"."

#, python-format
msgid "Pe acest canal emite MUX1 în: %s."
msgstr "يبث MUX1 على هذه القناة في: %s."

msgid "Schimbă cu OK, stânga sau dreapta; caută cu OK pe „Caută acum”."
msgstr "غيّر باستخدام OK أو اليسار أو اليمين؛ وابدأ البحث بالضغط على OK عند \"بحث الآن\"."

msgid "alege cu stânga sau dreapta"
msgstr "اختر باستخدام اليسار أو اليمين"

#, python-format
msgid "canale și buchete (%d fișier)"
msgstr "القنوات والباقات (%d ملف)"

#, python-format
msgid "înregistrări programate (%d fișier)"
msgstr "التسجيلات المجدولة (%d ملف)"

#, python-format
msgid "Scoți temporizatorul pentru %s?"
msgstr "هل تريد إزالة مؤقّت %s؟"

msgid "Pune temporizator"
msgstr "إضافة مؤقّت"

msgid "Ghidul tuturor canalelor"
msgstr "دليل جميع القنوات"

msgid "Ecranul nu mai e negru. Nu mai e nimic de făcut."
msgstr "لم تعد الشاشة سوداء. لا حاجة إلى أي إجراء آخر."

msgid "Mesajul a fost ascuns pe televizor."
msgstr "تم إخفاء الرسالة على التلفزيون."

msgid "Mesajul de pe televizor s-a schimbat. Reîncarcă pagina."
msgstr "تغيّرت الرسالة على التلفزيون. أعد تحميل الصفحة."

msgid "Pe televizor e deschis alt ecran. Închide-l, apoi încearcă din nou."
msgstr "هناك شاشة أخرى مفتوحة على التلفزيون. أغلقها، ثم حاول مجددًا."

msgid "S-a pornit pe televizor."
msgstr "تم تشغيله على التلفزيون."

msgid "Explicații pe ecranul negru"
msgstr "توضيحات على الشاشة السوداء"

msgid "Da: cât timp ecranul rămâne negru (canal criptat, fără semnal, canal mutat, tuner ocupat și altele), pe mijlocul ecranului scrie de ce și ce se poate face. EXIT ascunde mesajul. Nu: ferestrele scurte de eroare, ca înainte."
msgstr "نعم: ما دامت الشاشة سوداء (قناة مشفّرة، انقطاع الإشارة، قناة انتقلت، الموالف مشغول، وغير ذلك)، يظهر في وسط الشاشة السبب وما يمكن فعله. يخفي EXIT الرسالة. لا: تظهر رسائل الخطأ القصيرة كما كانت من قبل."

msgid "Analiza fluxului a pornit. Rezultatul apare aici în câteva secunde."
msgstr "بدأ تحليل البث. ستظهر النتيجة هنا خلال بضع ثوانٍ."

msgid "Analiza fluxului merge deja."
msgstr "تحليل البث جارٍ بالفعل."

msgid "Analiza fluxului pe ecranul negru"
msgstr "تحليل البث على الشاشة السوداء"

msgid "La canalele fără imagine (serviciu de date, format necunoscut), receptorul poate citi din flux ce trimite canalul: fișiere, date IP, actualizări, aplicații. La apăsarea OK: numai când ceri, cu OK pe mesaj. Automat: imediat ce apare mesajul."
msgstr "في القنوات التي لا تعرض صورة (خدمة بيانات، تنسيق غير معروف)، يستطيع جهاز الاستقبال قراءة ما ترسله القناة عبر البث: ملفات، بيانات IP، تحديثات، تطبيقات. عند الضغط على OK: فقط عند طلبك، بالضغط على OK على الرسالة. تلقائيًا: بمجرد ظهور الرسالة."

msgid "Acest canal nu poate fi pus pe pauză."
msgstr "لا يمكن إيقاف هذه القناة مؤقتًا."

msgid "serviciul nu are timeshift"
msgstr "الخدمة لا تدعم الإيقاف المؤقت"

msgid "Pauza nu a pornit. Verifică discul sau stick-ul USB ales pentru timeshift."
msgstr "لم يبدأ الإيقاف المؤقت. تحقّق من القرص أو ذاكرة USB المختارة للإيقاف المؤقت."

#, python-format
msgid "timeshift nu a pornit în %s"
msgstr "لم يبدأ الإيقاف المؤقت في %s"

msgid "Afișajul rămâne stins."
msgstr "تبقى شاشة العرض مطفأة."

msgid "Canalul de acum nu are număr în lista de canale, deci afișajul arată ora."
msgstr "القناة الحالية ليس لها رقم في قائمة القنوات، لذا تعرض الشاشة الساعة."

#, python-format
msgid "Ora se arată fără cele două puncte: %s înseamnă %s:%s."
msgstr "تظهر الساعة دون النقطتين: %s تعني %s:%s."

msgid "Numărul canalului din lista de canale."
msgstr "رقم القناة في قائمة القنوات."

msgid "Afișajul din fața receptorului are 4 cifre. Alege ce arată când receptorul este pornit și când este în așteptare."
msgstr "شاشة العرض الأمامية لجهاز الاستقبال تتسع لأربعة أرقام. اختر ما تعرضه عندما يكون جهاز الاستقبال قيد التشغيل وفي وضع الاستعداد."

msgid "Așa va arăta afișajul cu receptorul pornit"
msgstr "هكذا ستبدو شاشة العرض أثناء تشغيل جهاز الاستقبال"

msgid "Așa va arăta afișajul în așteptare"
msgstr "هكذا ستبدو شاشة العرض في وضع الاستعداد"

msgid "Când receptorul este pornit"
msgstr "عندما يكون جهاز الاستقبال قيد التشغيل"

msgid "Stânga și dreapta schimbă alegerea. OK salvează, EXIT renunță."
msgstr "غيّر الاختيار بالسهمين الأيسر والأيمن. للحفظ اضغط OK، وللإلغاء اضغط EXIT."

msgid "Salvează alegerile și le aplică pe loc"
msgstr "حفظ الاختيارات وتطبيقها فورًا"

msgid "Închide fără să salveze"
msgstr "إغلاق دون حفظ"

msgid "Alegerea de dinainte a rândului ales"
msgstr "الخيار السابق للسطر المحدد"

msgid "Alegerea următoare a rândului ales"
msgstr "الخيار التالي للسطر المحدد"

msgid "Lipsește alegerea: functionare=ora|canal|stins sau asteptare=ora|stins."
msgstr "الاختيار مفقود: functionare=ora|canal|stins أو asteptare=ora|stins."

#, python-format
msgid "Afișajul din fața receptorului are 4 cifre. Ora se arată fără cele două puncte: 2105 înseamnă 21:05. Numărul canalului este cel din lista de canale; când canalul nu are număr în listă, se arată ora. Aceleași setări sunt pe televizor, în %s."
msgstr "شاشة العرض الأمامية لجهاز الاستقبال تتسع لأربعة أرقام. تظهر الساعة دون النقطتين: 2105 تعني 21:05. رقم القناة هو رقمها في قائمة القنوات؛ وإذا لم يكن للقناة رقم في القائمة، تظهر الساعة. تجد الإعدادات نفسها على التلفزيون في %s."

msgid "OK deschide meniul, cu „Locul înregistrărilor”."
msgstr "يفتح OK القائمة التي تتضمن \"مكان التسجيلات\"."

msgid "Nu ai nicio înregistrare programată. Apasă VERDE ca să adaugi una sau alege o emisiune din ghidul TV."
msgstr "ليس لديك أي تسجيل مجدول. اضغط الزر الأخضر لإضافة تسجيل، أو اختر برنامجًا من دليل البرامج."

msgid "Meniul cu ce poți face; pe lista goală, cu locul înregistrărilor bun, o înregistrare nouă"
msgstr "قائمة الإجراءات المتاحة؛ وإذا كانت القائمة فارغة ومكان التسجيلات صالحًا، إضافة تسجيل جديد"

msgid "Meniul cu ce poți face cu înregistrarea aleasă"
msgstr "قائمة الإجراءات المتاحة للتسجيل المحدد"

#, python-format
msgid "%d secundă"
msgstr "%d ثانية"

#, python-format
msgid "Satelit: %s (%s)"
msgstr "القمر الصناعي: %s (%s)"

#, python-format
msgid "Satelit: %s (%s)\nAzimut: %s grade  |  Elevație: %s grade  |  Skew LNB: %s grade"
msgstr "القمر الصناعي: %s (%s)\nالسمت: %s درجة  |  الارتفاع: %s درجة  |  زاوية ميل LNB: %s درجة"

#, python-format
msgid "%s (implicit, niciun satelit configurat pe tuner)"
msgstr "%s (افتراضي، لم يُضبط أي قمر صناعي على الموالف)"

msgid "Astra (implicit, nicio listă de sateliți încărcată)"
msgstr "Astra (افتراضي، لم تُحمّل أي قائمة للأقمار الصناعية)"

msgid "Memoria receptorului e plină."
msgstr "ذاكرة جهاز الاستقبال ممتلئة."

msgid "Memoria receptorului nu se poate scrie acum."
msgstr "لا يمكن الكتابة في ذاكرة جهاز الاستقبال الآن."

msgid "Eroare neașteptată în receptor; detaliile sunt în jurnal."
msgstr "حدث خطأ غير متوقع في جهاز الاستقبال؛ التفاصيل موجودة في السجل."

msgid "Tunerul de satelit e folosit acum de altceva, de exemplu de o înregistrare. Încearcă din nou după ce se termină."
msgstr "موالف الأقمار الصناعية مشغول الآن بمهمة أخرى، مثل تسجيل. حاول مجددًا بعد انتهائها."

#, python-format
msgid "Nu am recepționat semnal pe %s. Verifică antena și încearcă din nou."
msgstr "لم نستقبل إشارة على %s. تحقّق من الطبق وحاول مجددًا."

#, python-format
msgid "Nu am putut porni tunerul pe %s. Încearcă din nou."
msgstr "تعذّر تشغيل الموالف على %s. حاول مجددًا."

msgid "Ce am găsit nu s-a putut salva. Încearcă din nou."
msgstr "تعذّر حفظ ما تم العثور عليه. حاول مجددًا."

#, python-format
msgid "Nu pot arăta ce se va căuta. %s"
msgstr "لا يمكن عرض ما سيُبحث عنه. %s"

#, python-format
msgid "Căutarea nu a putut porni. %s"
msgstr "تعذّر بدء البحث. %s"

msgid "Furnizori și Nou la fiecare satelit"
msgstr "مزوّدو الخدمة والجديد لكل قمر صناعي"

msgid "Da: în lista de canale, la „Sateliți”, fiecare satelit are sub numele lui și rândurile „Furnizori” (canalele lui după furnizor) și „Nou” (canalele noi găsite la căutare). Nu: un singur rând pe satelit, iar furnizorii tuturor sateliților rămân pe tasta galbenă."
msgstr "نعم: في قائمة القنوات، ضمن \"الأقمار الصناعية\"، يظهر تحت اسم كل قمر صناعي سطر \"مزوّدو الخدمة\" (قنواته حسب المزوّد) وسطر \"الجديد\" (القنوات الجديدة التي عُثر عليها أثناء البحث). لا: سطر واحد لكل قمر صناعي، ويبقى الوصول إلى مزوّدي الخدمة لجميع الأقمار الصناعية عبر الزر الأصفر."

msgid "Mouse pe ecran: clic = alege, dublu clic = OK, rotița = sus și jos, clic dreapta = Meniu, clic pe rotiță = Ieșire."
msgstr "الماوس على الشاشة: نقرة = اختيار، نقرتان = OK، العجلة = أعلى وأسفل، نقرة بالزر الأيمن = القائمة، نقرة على العجلة = خروج."

msgid "Pe ecran: atinge = alege, atinge rândul ales = OK, glisează = derulează, ține apăsat = Meniu."
msgstr "على الشاشة: لمسة = اختيار، لمس السطر المحدد = OK، سحب = تمرير، ضغط مطوّل = القائمة."

#, python-format
msgid "Readucerea antenei pe %s după pierderea semnalului: încercarea %s, prin %s, în curs."
msgstr "إعادة الطبق إلى %s بعد فقدان الإشارة: المحاولة %s، عبر %s، جارية."

#, python-format
msgid "Readucerea antenei pe %s după pierderea semnalului: încercarea %s, prin %s; antena se întoarce pe %s."
msgstr "إعادة الطبق إلى %s بعد فقدان الإشارة: المحاولة %s، عبر %s؛ يعود الطبق إلى %s."

msgid "Decodorul receptorului nu mai are memorie pentru filme și pentru imaginea posturilor de radio. Canalele TV merg în continuare. Repornește receptorul."
msgstr "نفدت ذاكرة وحدة فك الترميز في جهاز الاستقبال المخصّصة للأفلام وصور محطات الراديو. تواصل القنوات التلفزيونية العمل. أعد تشغيل جهاز الاستقبال."

msgid "Decodorul receptorului nu mai are memorie. Repornește receptorul."
msgstr "نفدت ذاكرة وحدة فك الترميز في جهاز الاستقبال. أعد تشغيل جهاز الاستقبال."

#, python-format
msgid "E bine să repornești receptorul când îți convine. Memoria decodorului s-a fărâmițat: cea mai mare bucată liberă are %d MB, sub pragul de %d MB. Fără repornirea receptorului, după o repornire a interfeței s-ar putea să nu mai meargă imaginea posturilor de radio și filmele."
msgstr "يُفضّل إعادة تشغيل جهاز الاستقبال في وقت يناسبك. أصبحت ذاكرة وحدة فك الترميز مجزّأة: أكبر مساحة متاحة متصلة حجمها %d MB، وهي أقل من الحد المحدد وهو %d MB. إذا لم تُعد تشغيل جهاز الاستقبال، فقد تتوقف صور محطات الراديو والأفلام عن العمل بعد إعادة تشغيل الواجهة."

msgid "Repornește receptorul noaptea când memoria decodorului e fărâmițată"
msgstr "إعادة تشغيل جهاز الاستقبال ليلًا عند تجزّؤ ذاكرة وحدة فك الترميز"

msgid "Da: pictograma rețelei (cablu sau Wi-Fi și dacă merge internetul) se vede în bare, în capul ferestrelor Pro și în antetul paginilor web. Nu: nu se mai vede, iar ce era lângă ea revine la locul ei. Verificarea internetului și mesajul de pe ecran merg mai departe."
msgstr "نعم: تظهر أيقونة الشبكة (الاتصال بالكابل أو Wi-Fi وحالة الإنترنت) في الأشرطة وأعلى نوافذ Pro وفي ترويسة صفحات الويب. لا: تختفي الأيقونة وتعود العناصر المجاورة إلى أماكنها. يستمر فحص الإنترنت وظهور الرسالة على الشاشة."

msgid "Decriptarea înregistrărilor"
msgstr "فك تشفير التسجيلات"

msgid "Ce se alege din oficiu la o înregistrare programată nouă. Decriptează acum: ca până acum. Decodează mai târziu: înregistrarea se salvează criptată și receptorul o decodează mai târziu, când e în așteptare. Se poate schimba la fiecare înregistrare."
msgstr "الخيار الافتراضي لأي تسجيل مجدول جديد. فك التشفير الآن: كما كان من قبل. فك التشفير لاحقًا: يُحفظ التسجيل مشفّرًا ويفك جهاز الاستقبال تشفيره لاحقًا في وضع الاستعداد. يمكن تغيير الخيار لكل تسجيل."

msgid "Portul local al modulului de acces"
msgstr "المنفذ المحلي لوحدة الوصول"

msgid "Portul de pe acest receptor (127.0.0.1) la care programul de decodare cere modulului de acces cheile înregistrărilor de decodat mai târziu. 0: nefolosit."
msgstr "المنفذ على جهاز الاستقبال هذا (127.0.0.1) الذي يطلب عبره برنامج فك التشفير من وحدة الوصول مفاتيح التسجيلات المراد فك تشفيرها لاحقًا. 0: غير مستخدم."

msgid "IPv6"
msgstr "IPv6"

msgid "Nu (din fabrică): plăcile de rețea nu au adrese IPv6, iar clientul IPv6 nu pornește; rețeaua merge pe IPv4, ca până acum. Da: receptorul primește și adrese IPv6, dacă rețeaua ta le dă. Se aplică pe loc."
msgstr "لا (إعداد المصنع): لا تحصل بطاقات الشبكة على عناوين IPv6 ولا يبدأ عميل IPv6؛ وتعمل الشبكة عبر IPv4 كما كانت من قبل. نعم: يحصل جهاز الاستقبال أيضًا على عناوين IPv6 إذا كانت شبكتك توفّرها. يُطبّق فورًا."

