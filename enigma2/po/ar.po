msgid "Acel rând e o explicație și nu se poate alege."
msgstr "هذا السطر توضيحي ولا يمكن اختياره."

msgid "PLP ID (numai DVB-T2)"
msgstr "معرّف PLP (فقط DVB-T2)"

#, python-format
