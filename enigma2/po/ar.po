#, python-format
msgid "Adresa receptorului: %s (sau hdsatelit.local)."
msgstr "عنوان جهاز الاستقبال: %s (أو hdsatelit.local)."

msgid "Cablul, apoi Wi-Fi"
msgstr "الكابل، ثم Wi-Fi"

msgid "Wi-Fi, apoi cablul"
msgstr "Wi-Fi، ثم الكابل"

msgid "Receptorul nu poate trece singur pe Wi-Fi: nu e nicio rețea Wi-Fi salvată și pornită. Conectează receptorul o dată la Wi-Fi (Rețea și internet), apoi trecerea se face singură."
msgstr "لا يستطيع جهاز الاستقبال الانتقال تلقائيا إلى Wi-Fi: لا توجد شبكة Wi-Fi محفوظة ومفعلة. وصّل جهاز الاستقبال بشبكة Wi-Fi مرة واحدة (الشبكة والإنترنت)، ثم سيتم الانتقال تلقائيا."

msgid "Internetul nu merge și nicio altă rețea nu are internet acum. Receptorul încearcă din nou peste 10 minute."
msgstr "الإنترنت لا يعمل، ولا تتوفر حاليا أي شبكة أخرى متصلة بالإنترنت. سيحاول جهاز الاستقبال مجددا بعد 10 دقائق."

#, python-format
msgid "Internetul nu mergea prin %s. Receptorul a trecut pe %s."
msgstr "لم يكن الإنترنت يعمل عبر %s. انتقل جهاز الاستقبال إلى %s."

#, python-format
msgid "Receptorul nu a putut trece pe %s: %s. Încearcă din nou peste 10 minute."
msgstr "تعذر على جهاز الاستقبال الانتقال إلى %s: %s. سيحاول مجددا بعد 10 دقائق."

msgid "rețeaua de până acum"
msgstr "الشبكة السابقة"

msgid "Lipsește regiunea resursei Azure: o găsești în portal, la resursa Translator, Overview › Location (de exemplu Germany West Central = germanywestcentral)."
msgstr "منطقة مورد Azure غير محددة: تجدها في البوابة ضمن مورد Translator، في Overview › Location (مثلا Germany West Central = germanywestcentral)."

msgid "Cheia sau regiunea nu se potrivesc: verifică amândouă în portal (Keys and Endpoint)."
msgstr "هناك خطأ في المفتاح أو المنطقة: تحقق منهما في البوابة (Keys and Endpoint)."

msgid "Ollama ascultă din fabrică numai pe calculatorul lui. În Ollama 0.9.5 sau mai nou: Settings, pornește „Expose Ollama to the network”."
msgstr "يستقبل Ollama الاتصالات افتراضيا من الكمبيوتر المثبت عليه فقط. في Ollama 0.9.5 أو أحدث: افتح Settings وفعّل \"Expose Ollama to the network\"."

msgid "Sau: închide Ollama de lângă ceas, pune variabila de mediu OLLAMA_HOST cu valoarea 0.0.0.0:11434 și pornește din nou Ollama."
msgstr "أو: أغلق Ollama من جوار الساعة، واضبط متغير البيئة OLLAMA_HOST على القيمة 0.0.0.0:11434 ثم شغّل Ollama من جديد."

msgid "LM Studio: fila „Developer”, „Start server” și „Serve on Local Network”. Căutarea nu-l găsește: scrie adresa de mână (portul 1234), ca server compatibil OpenAI."
msgstr "LM Studio: علامة التبويب \"Developer\"، ثم \"Start server\" و\"Serve on Local Network\". لن يعثر عليه البحث: أدخل العنوان يدويا (المنفذ 1234)، كخادم متوافق مع OpenAI."

msgid "Windows: la întrebarea paravanului apasă „Allow access”. Altfel: Windows Security, „Allow an app through firewall”, bifează Ollama la „Private”."
msgstr "Windows: عندما يسألك جدار الحماية، اضغط \"Allow access\". أو افتح Windows Security، ثم \"Allow an app through firewall\"، وضع علامة أمام Ollama في خانة \"Private\"."

msgid "Rețeaua de acasă pe calculator trebuie să fie „Private network” (Settings › Network & internet), iar receptorul și calculatorul în același router."
msgstr "يجب ضبط شبكة المنزل على الكمبيوتر على \"Private network\" (Settings › Network & internet)، ويجب توصيل جهاز الاستقبال والكمبيوتر بالراوتر نفسه."

msgid "Server compatibil OpenAI"
msgstr "خادم متوافق مع OpenAI"

msgid "Serviciul a răspuns neașteptat. Încearcă din nou peste câteva minute."
msgstr "أعادت الخدمة ردا غير متوقع. حاول مجددا بعد بضع دقائق."

msgid "Scrie adresa calculatorului din casă (de exemplu http://192.168.1.50:11434) sau a serverului din internet, cu https://."
msgstr "أدخل عنوان الكمبيوتر في المنزل (مثلا http://192.168.1.50:11434) أو عنوان الخادم على الإنترنت، مع https://."

msgid "Copiaz-o întreagă din pagina cheii, fără spații, și încearcă din nou."
msgstr "انسخه كاملا من صفحة المفتاح، دون مسافات، ثم حاول مجددا."

msgid "Contul nu are credit pentru acest model. Cumpără credit sau alege alt model."
msgstr "لا يحتوي الحساب على رصيد لهذا النموذج. اشتر رصيدا أو اختر نموذجا آخر."

msgid "Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se reface cota."
msgstr "المفتاح صحيح، لكن الحصة نفدت. ستعمل الترجمة مجددا بعد تجديد الحصة."

msgid "Serviciul nu traduce în limba aleasă. Alege altă limbă în setările traducerii."
msgstr "الخدمة لا تترجم إلى اللغة المحددة. اختر لغة أخرى في إعدادات الترجمة."

msgid "Modelul nu e pe server. Alege alt model din listă."
msgstr "هذا النموذج غير موجود على الخادم. اختر نموذجًا آخر من القائمة."

msgid "Serverul a răspuns neașteptat. Verifică adresa și portul și încearcă din nou."
msgstr "ردّ الخادم بشكل غير متوقع. تحقق من العنوان والمنفذ وحاول مجددًا."

#, python-format
msgid "Proba a durat %s secunde: serverul e prea lent ca subtitrările traduse să apară la timp; vor veni târziu, după original."
msgstr "استغرق الاختبار %s ثانية: الخادم بطيء جدًا لعرض النصوص المصاحبة المترجمة في وقتها؛ ستظهر متأخرة عن النص الأصلي."

msgid "Încearcă un model mai mic sau alt serviciu (Gemini, gratuit, fără card)."
msgstr "جرّب نموذجًا أصغر أو خدمة أخرى (Gemini، مجانية، ولا تحتاج إلى بطاقة)."

msgid "Serviciul ales nu are adresă de server."
msgstr "الخدمة المختارة ليس لها عنوان خادم."

msgid "Adresa are spații sau caractere care nu pot fi într-o adresă."
msgstr "يحتوي العنوان على مسافات أو أحرف غير مسموح بها في العناوين."

msgid "Adresa trebuie să înceapă cu http:// sau https://."
msgstr "يجب أن يبدأ العنوان بـ http:// أو https://."

msgid "Adresa nu poate avea nume de utilizator sau parolă. Scrie numai adresa serverului; cheia, dacă serverul cere una, se pune separat."
msgstr "لا يمكن أن يحتوي العنوان على اسم مستخدم أو كلمة مرور. أدخل عنوان الخادم فقط؛ وإذا كان الخادم يتطلب مفتاحًا، فأدخله بشكل منفصل."

msgid "Adresa nu are numele sau IP-ul serverului."
msgstr "اسم الخادم أو عنوان IP غير موجود في العنوان."

msgid "Portul din adresă nu e bun: trebuie un număr între 1 și 65535."
msgstr "المنفذ في العنوان غير صالح: يجب أن يكون رقمًا بين 1 و65535."

msgid "Copiaz-o întreagă din pagina cheii, fără spații. Cheia pentru Gemini se face pe aistudio.google.com/apikey."
msgstr "انسخ المفتاح كاملًا من صفحته، دون مسافات. يمكنك إنشاء مفتاح Gemini على aistudio.google.com/apikey."

msgid "Copiaz-o întreagă din pagina cheii (console.cloud.google.com/apis/credentials), fără spații. În proiectul cheii pornește „Cloud Translation API” și verifică să nu fie cheia restrânsă la alt API."
msgstr "انسخ المفتاح كاملًا من صفحته (console.cloud.google.com/apis/credentials)، دون مسافات. فعّل «Cloud Translation API» في مشروع المفتاح، وتأكد من أن المفتاح غير مقيّد بواجهة API أخرى."

msgid "Copiaz-o întreagă din portal (resursa Translator, „Keys and Endpoint”, KEY 1), fără spații, și verifică regiunea: scrisă exact ca în portal (de exemplu westeurope), sau Global dacă resursa e globală."
msgstr "انسخ المفتاح كاملًا من البوابة (مورد Translator، ثم «Keys and Endpoint»، ثم KEY 1)، دون مسافات، وتحقق من المنطقة: أدخلها كما تظهر تمامًا في البوابة (مثل westeurope)، أو Global إذا كان المورد عالميًا."

msgid "Copiaz-o întreagă din pagina cheilor DeepL (www.deepl.com/en/your-account/keys), fără spații. Trebuie o cheie de la DeepL API, nu de la traducătorul obișnuit."
msgstr "انسخ المفتاح كاملًا من صفحة مفاتيح DeepL (www.deepl.com/en/your-account/keys)، دون مسافات. يجب أن يكون مفتاح DeepL API، وليس مفتاح المترجم العادي."

msgid "Verifică jetonul și ID-ul contului: copiază din nou jetonul (în panoul Cloudflare, pagina „Workers AI”, „Use REST API”) și ID-ul contului (la „Account ID”), fără spații."
msgstr "تحقق من الرمز ومعرّف الحساب: انسخ الرمز مجددًا (من لوحة Cloudflare، صفحة «Workers AI»، ثم «Use REST API») ومعرّف الحساب (من «Account ID»)، دون مسافات."

msgid "Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se reface cota (la Gemini, de obicei a doua zi, în jurul orei 10, ora României)."
msgstr "المفتاح صحيح، لكن الحصة نفدت. ستعمل الترجمة مجددًا عند تجدد الحصة (في Gemini، يكون ذلك عادةً في اليوم التالي، نحو الساعة 10 بتوقيت رومانيا)."

msgid "Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se reface cota (la Azure, luna următoare)."
msgstr "المفتاح صحيح، لكن الحصة نفدت. ستعمل الترجمة مجددًا عند تجدد الحصة (في Azure، في الشهر التالي)."

msgid "Verifică internetul receptorului (Meniu › Setări › Rețea) și încearcă din nou."
msgstr "تحقق من اتصال الرسيفر بالإنترنت (القائمة › الإعدادات › الشبكة) وحاول مجددًا."

msgid "La adresa asta nu răspunde LibreTranslate. Verifică adresa și portul (de obicei 5000)."
msgstr "لا يستجيب LibreTranslate على هذا العنوان. تحقق من العنوان والمنفذ (عادةً 5000)."

msgid "Folosește un serviciu din internet (Gemini, gratuit, fără card) sau un model mai mic (de exemplu gemma3:4b)."
msgstr "استخدم خدمة عبر الإنترنت (Gemini، مجانية، ولا تحتاج إلى بطاقة) أو نموذجًا أصغر (مثل gemma3:4b)."

msgid "Folosește un serviciu din internet (Gemini, gratuit, fără card)."
msgstr "استخدم خدمة عبر الإنترنت (Gemini، مجانية، ولا تحتاج إلى بطاقة)."

msgid "Am pornit verificarea cheii."
msgstr "بدأت التحقق من المفتاح."

msgid "Am pornit verificarea serverului."
msgstr "بدأت التحقق من الخادم."

msgid "Am pornit proba modelului."
msgstr "بدأت اختبار النموذج."

msgid "Verifică adresa, sau scrie numele modelului."
msgstr "تحقق من العنوان، أو أدخل اسم النموذج."

msgid "Alege regiunea resursei din listă și pornește din nou. Dacă nici cu regiunea bună nu merge, cheia e greșită: copiaz-o din nou, întreagă (KEY 1, la „Keys and Endpoint”)."
msgstr "اختر منطقة المورد من القائمة وأعد المحاولة. إذا لم يعمل حتى مع المنطقة الصحيحة، فالمفتاح غير صحيح: انسخه مجددًا كاملًا (KEY 1، من «Keys and Endpoint»)."

msgid "Mă uit la serverul LibreTranslate..."
msgstr "أتحقق من خادم LibreTranslate..."

msgid "Citesc modelele de pe server..."
msgstr "أقرأ النماذج المتاحة على الخادم..."

msgid "Am pornit căutarea."
msgstr "بدأت البحث."

#, python-format
msgid "Scrie adresa serverului, de exemplu http://192.168.1.50:%d."
msgstr "أدخل عنوان الخادم، مثل http://192.168.1.50:%d."

#, python-format
msgid "Serverul de la %s cere o cheie. Scrie cheia serverului, sau pornește serverul fără cheie."
msgstr "الخادم على %s يتطلب مفتاحًا. أدخل مفتاح الخادم، أو شغّل الخادم دون مفتاح."

msgid "Cheia e bună, dar în proiectul ei nu e pornit „Cloud Translation API”. În Google Cloud (console.cloud.google.com) mergi la „APIs & Services”, caută „Cloud Translation API”, apasă „Enable”, așteaptă câteva minute și încearcă din nou."
msgstr "المفتاح صحيح، لكن «Cloud Translation API» غير مفعّلة في مشروعه. في Google Cloud (console.cloud.google.com)، انتقل إلى «APIs & Services»، وابحث عن «Cloud Translation API»، واضغط «Enable»، وانتظر بضع دقائق ثم حاول مجددًا."

#, python-format
msgid "Copiaz-o întreagă din pagina cheilor (%s), fără spații."
msgstr "انسخ المفتاح كاملًا من صفحة المفاتيح (%s)، دون مسافات."

msgid "Serverul a răspuns prea încet."
msgstr "استغرق الخادم وقتًا طويلًا جدًا للرد."

#, python-format
msgid "Pornește serverul LibreTranslate și cu limba „%s” (de exemplu --load-only en,ro,de,fr,it,es,hu)."
msgstr "شغّل خادم LibreTranslate مع تفعيل اللغة «%s» أيضًا (مثل --load-only en,ro,de,fr,it,es,hu)."

#, python-format
msgid "%s nu dă modelul ales (nu există sau cere planul plătit). Alege alt model din listă; cel din fabrică e %s."
msgstr "%s لا يتيح النموذج المختار (غير موجود أو يتطلب خطة مدفوعة). اختر نموذجًا آخر من القائمة؛ النموذج الافتراضي هو %s."

msgid "Lipește cheia."
msgstr "ألصق المفتاح."

msgid "Cheia are caractere care nu pot fi într-o cheie, sau e prea lungă. Copiaz-o din nou, întreagă."
msgstr "يحتوي المفتاح على أحرف غير مسموح بها، أو أنه أطول من اللازم. انسخه مجددًا كاملًا."

msgid "Regiunea nu e bună: scrie-o exact ca în portalul Azure, de exemplu westeurope."
msgstr "المنطقة غير صحيحة: أدخلها كما تظهر تمامًا في بوابة Azure، مثل westeurope."

msgid "Pentru un server din casă scrie întâi adresa lui (pasul cu adresa serverului)."
msgstr "إذا كان الخادم في المنزل، فأدخل عنوانه أولًا (في خطوة عنوان الخادم)."

msgid "O cheie pleacă numai pe https:// sau spre un server din rețeaua de acasă. Scrie adresa cu https://. Cheia nu a plecat nicăieri."
msgstr "لا يُرسل المفتاح إلا عبر https:// أو إلى خادم في الشبكة المنزلية. أدخل العنوان باستخدام https://. لم يُرسل المفتاح إلى أي جهة."

msgid "Merge deja o configurare. Așteaptă să se termine."
msgstr "هناك عملية إعداد جارية بالفعل. انتظر حتى تنتهي."

msgid "Recunosc cheia..."
msgstr "أتعرف على المفتاح..."

msgid "Serverul poate fi numai LibreTranslate sau compatibil OpenAI."
msgstr "يجب أن يكون الخادم LibreTranslate أو متوافقًا مع OpenAI."

msgid "Numele modelului nu e bun."
msgstr "اسم النموذج غير صالح."

msgid "Cheia are caractere care nu pot fi într-o cheie, sau e prea lungă."
msgstr "يحتوي المفتاح على أحرف غير مسموح بها، أو أنه أطول من اللازم."

msgid "Mă uit la server..."
msgstr "أتحقق من الخادم..."

msgid "Alege un model din listă."
msgstr "اختر نموذجًا من القائمة."

msgid "Modelul se schimbă numai la Gemini, Groq, Cloudflare Workers și la serverele compatibile OpenAI."
msgstr "يمكن تغيير النموذج فقط في Gemini وGroq وCloudflare Workers والخوادم المتوافقة مع OpenAI."

msgid "Pentru Gemini lipsește cheia. Pune întâi cheia."
msgstr "مفتاح Gemini غير موجود. أدخل المفتاح أولًا."

msgid "Pentru serverul compatibil OpenAI lipsește adresa. Pune întâi adresa."
msgstr "عنوان الخادم المتوافق مع OpenAI غير موجود. أدخل العنوان أولًا."

msgid "Serverul nu dă lista modelelor."
msgstr "الخادم لا يوفّر قائمة النماذج."

#, python-format
msgid "Probez traducerea cu %s..."
msgstr "أختبر الترجمة باستخدام %s..."

#, python-format
msgid "Cheia nu a mers la %s."
msgstr "لم يعمل المفتاح مع %s."

#, python-format
msgid "Probez traducerea cu %s (%s)..."
msgstr "أختبر الترجمة باستخدام %s (%s)..."

msgid "Copiază din nou KEY 1 de la „Keys and Endpoint”, întreagă, și alege regiunea scrisă acolo la „Location/Region” (sau Global, dacă resursa e globală)."
msgstr "انسخ KEY 1 مجددًا كاملًا من «Keys and Endpoint»، واختر المنطقة الظاهرة هناك تحت «Location/Region» (أو Global إذا كان المورد عالميًا)."

msgid "Serverul nu are niciun model potrivit pentru traducere."
msgstr "لا يوجد على الخادم أي نموذج مناسب للترجمة."

#, python-format
msgid "Cheia pentru %s e salvată ca rezervă; traducerea rămâne pe %s."
msgstr "حُفظ مفتاح %s كخيار احتياطي؛ ستستمر الترجمة باستخدام %s."

#, python-format
msgid "Am găsit regiunea: %s (%s). %s"
msgstr "وجدت المنطقة: %s (%s). %s"

#, python-format
msgid "%s e acum serviciul principal; %s e primul la rezerve."
msgstr "%s هي الخدمة الرئيسية الآن؛ و%s هي الخيار الاحتياطي الأول."

msgid "Caut servere în rețeaua de acasă..."
msgstr "أبحث عن خوادم في الشبكة المنزلية..."

msgid "adresa scrisă"
msgstr "العنوان المُدخل"

#, python-format
msgid "Verifică dacă serverul de la %s e pornit și dacă receptorul îl vede (același router)."
msgstr "تحقق من أن الخادم على %s يعمل وأن الرسيفر يستطيع الوصول إليه (عبر الراوتر نفسه)."

msgid "La Ollama, pe calculator trebuie OLLAMA_HOST=0.0.0.0:11434 (vezi instrucțiunile)."
msgstr "مع Ollama، يجب ضبط OLLAMA_HOST=0.0.0.0:11434 على الكمبيوتر (راجع التعليمات)."

msgid "Nu recunosc cheia după formă. Alege serviciul din listă și încearcă din nou; cheia nu a plecat nicăieri."
msgstr "لم أتعرف على المفتاح من شكله. اختر الخدمة من القائمة وحاول مجددًا؛ لم يُرسل المفتاح إلى أي جهة."

msgid "Serviciu necunoscut."
msgstr "خدمة غير معروفة."

msgid "ID-ul contului Cloudflare are 32 de litere și cifre (de la „Account ID”). Cheia nu a plecat nicăieri."
msgstr "يتكون معرّف حساب Cloudflare من 32 حرفًا ورقمًا (من «Account ID»). لم يُرسل المفتاح إلى أي جهة."

msgid "Pentru Cloudflare Workers scrie și ID-ul contului (32 de litere și cifre, de la „Account ID”). Cheia nu a plecat nicăieri."
msgstr "في Cloudflare Workers، أدخل معرّف الحساب أيضًا (32 حرفًا ورقمًا، من «Account ID»). لم يُرسل المفتاح إلى أي جهة."

msgid "Setările traducerii nu se pot citi."
msgstr "تعذرت قراءة إعدادات الترجمة."

#, python-format
msgid "Probez modelul %s..."
msgstr "أختبر النموذج %s..."

#, python-format
msgid "Serverul nu dă lista modelelor (HTTP %s)."
msgstr "الخادم لا يوفّر قائمة النماذج (HTTP %s)."

msgid "La adresa asta nu răspunde un server LibreTranslate."
msgstr "لا يستجيب أي خادم LibreTranslate على هذا العنوان."

#, python-format
msgid "Măsor viteza cu %s..."
msgstr "أقيس السرعة باستخدام %s..."

#, python-format
msgid "%s și %s"
msgstr "%s و%s"

#, python-format
msgid "Citesc modelele %s..."
msgstr "أقرأ نماذج %s..."

#, python-format
msgid "Caut regiunea resursei Azure: %s (%s)..."
msgstr "أبحث عن منطقة مورد Azure: %s (%s)..."

#, python-format
msgid "Serverul LibreTranslate nu are limba „%s”."
msgstr "اللغة «%s» غير متوفرة على خادم LibreTranslate."

msgid "Pe calculator descarcă un model, de exemplu: ollama pull gemma3:4b."
msgstr "نزّل نموذجًا على الكمبيوتر، مثل: ollama pull gemma3:4b."

msgid "Încarcă un model pe server și încearcă din nou."
msgstr "حمّل نموذجًا على الخادم وحاول مجددًا."

#, python-format
msgid "%s, %d din %d"
msgstr "%s، %d من %d"

msgid "Modelele probate nu au dat o traducere."
msgstr "لم تُنتج النماذج التي اختُبرت أي ترجمة."

