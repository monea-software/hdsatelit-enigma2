msgid "Serverul a refuzat cererea (%s)."
msgstr "رفض الخادم الطلب (%s)."

msgid "Echipa"
msgstr "الفريق"

msgid "încă neprimit de server"
msgstr "لم يصل إلى الخادم بعد"

msgid "Luminozitate"
msgstr "السطوع"

msgid "Cât de luminoasă e imaginea. Schimbă și meniurile."
msgstr "مدى سطوع الصورة. يؤثر أيضًا على القوائم."

msgid "Diferența dintre părțile întunecate și cele luminoase. Schimbă și meniurile."
msgstr "الفرق بين الأجزاء الداكنة والفاتحة. يؤثر أيضًا على القوائم."

msgid "Saturație"
msgstr "التشبع"

msgid "Cât de puternice sunt culorile. Schimbă și meniurile."
msgstr "مدى قوة الألوان. يؤثر أيضًا على القوائم."

msgid "Nuanță"
msgstr "درجة اللون"

msgid "Mută culorile spre verde sau spre roșu, pentru fețe naturale. Schimbă și meniurile."
msgstr "يميل بالألوان نحو الأخضر أو الأحمر لتبدو الوجوه طبيعية. يؤثر أيضًا على القوائم."

msgid "Claritate"
msgstr "الحدة"

msgid "Contururi mai precise după mărirea imaginii. Prea mult face margini albe în jurul obiectelor."
msgstr "يجعل الحواف أوضح بعد تكبير الصورة. زيادته كثيرًا تُظهر حواف بيضاء حول الأجسام."

msgid "Reducerea zgomotului"
msgstr "تقليل التشويش"

msgid "Liniștește purecii din imagine de la un cadru la altul. Prea mult lasă urme în spatele mișcării."
msgstr "يخفف النقاط المشوشة في الصورة بين إطار وآخر. زيادته كثيرًا تترك آثارًا خلف الأجسام المتحركة."

msgid "Zgomotul din cadru"
