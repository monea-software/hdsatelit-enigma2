msgstr "%s: %s بدلا من %s"

#, python-format
msgid "Sateliți fără LNB anume (advanced.sat.*.lnb = 0): încă %d."
msgstr "أقمار بدون LNB خاص (advanced.sat.*.lnb = 0): %d أخرى."

#, python-format
msgid "Port %s: %s"
msgstr "المنفذ %s: %s"

msgid "comutator DiSEqC A/B/C/D"
msgstr "مبدّل DiSEqC A/B/C/D"

#, python-format
msgid "Motor (LNB %d): toți sateliții"
msgstr "الموتور (LNB %d): كل الأقمار"

#, python-format
msgid "Cu acest LNB, receptorul nu poate acorda niciun transponder de pe %s: frecvența intermediară iese din 900-2200 MHz."
msgstr "مع هذا الـ LNB لا يستطيع جهاز الاستقبال ضبط أي تردد على %s: التردد الوسيط يخرج عن 900-2200 MHz."

#, python-format
msgid "Tunerul %s folosește setările tunerului %s."
msgstr "الموالف %s يستخدم إعدادات الموالف %s."

#, python-format
msgid "Tunerul %s nu e configurat. Configurează-l întâi din Setări tuner."
msgstr "الموالف %s غير مضبوط. اضبطه أولا من إعدادات الموالف."

#, python-format
msgid "Pe %s nu știu niciun transponder, deci nu pot verifica frecvența intermediară."
msgstr "لا أعرف أي تردد على %s، لذلك لا أستطيع فحص التردد الوسيط."

#, python-format
msgid "Canalul care rulează acum (pe %s) nu se mai poate acorda cu acest LNB."
msgstr "القناة المعروضة الآن (على %s) لم يعد ممكنا ضبطها مع هذا الـ LNB."

msgid "(nou)"
msgstr "(جديد)"

#, python-format
msgid "Același satelit e pe două porturi (%s). Schimbă întâi din Setări tuner."
msgstr "القمر نفسه على منفذين (%s). غيّر ذلك أولا من إعدادات الموالف."

#, python-format
msgid "Cu acest LNB se pot acorda numai o parte din transponderele cunoscute: %d din %d, pe sateliți: %d din %d."
msgstr "مع هذا الـ LNB يمكن ضبط جزء فقط من الترددات المعروفة: %d من %d، في الأقمار: %d من %d."

msgid "Setările de dinainte sunt puse la loc, dar tunerul nu le-a primit acum. Repornește receptorul."
msgstr "أعيدت الإعدادات السابقة، لكن الموالف لم يستقبلها الآن. أعد تشغيل جهاز الاستقبال."

msgid "Se înregistrează acum. Schimbă LNB-ul după ce se termină înregistrarea."
msgstr "يجري التسجيل الآن. غيّر الـ LNB بعد انتهاء التسجيل."

msgid "În mai puțin de două minute pornește o înregistrare programată. Schimbă LNB-ul după ce se termină."
msgstr "بعد أقل من دقيقتين يبدأ تسجيل مجدول. غيّر الـ LNB بعد انتهائه."

msgid "O altă schimbare de LNB așteaptă confirmarea."
msgstr "تغيير آخر للـ LNB ينتظر التأكيد."

msgid "Am păstrat noile setări."
msgstr "احتفظت بالإعدادات الجديدة."

#, python-format
msgid "Nu prind semnal pe %s cu noile setări."
msgstr "لا توجد إشارة على %s بالإعدادات الجديدة."

msgid "Receptorul pornește din nou programul. Încearcă peste câteva secunde."
msgstr "جهاز الاستقبال يشغّل القناة من جديد. حاول بعد بضع ثوان."

msgid "Nu am putut verifica semnalul: nu rula niciun canal de satelit pe acest tuner."
msgstr "لم أستطع فحص الإشارة: لم تكن أي قناة أقمار معروضة على هذا الموالف."

msgid "Canalul care rula e pe alt LNB decât cel schimbat, deci nu am ce verifica."
msgstr "القناة التي كانت معروضة على LNB آخر غير الذي تغيّر، فلا يوجد ما يُفحص."

msgid "Nu am putut verifica semnalul: imaginea în imagine (PiP) ține canalul deschis."
msgstr "لم أستطع فحص الإشارة: الصورة داخل الصورة (PiP) تبقي القناة مفتوحة."

msgid "După ultima schimbare de LNB, setările tunerului s-au schimbat și din alt loc (de exemplu din Setări tuner), deci nu mai pot reveni sigur la ce era."
msgstr "بعد آخر تغيير للـ LNB تغيّرت إعدادات الموالف من مكان آخر أيضا (مثلا من إعدادات الموالف)، لذلك لم أعد أستطيع إعادة ما كان بأمان."

#, python-format
msgid "Verific semnalul pe %s"
msgstr "أفحص الإشارة على %s"

#, python-format
msgid "Semnal prins pe %s."
msgstr "الإشارة موجودة على %s."

msgid "alți sateliți"
msgstr "أقمار أخرى"

msgid "eroare internă, scrisă în jurnal"
msgstr "خطأ داخلي، مكتوب في السجل"

msgid "Nu am putut verifica semnalul: între timp a pornit alt canal."
msgstr "لم أستطع فحص الإشارة: بدأت قناة أخرى في الأثناء."

msgid "A apărut o eroare (scrisă în jurnal), deci am revenit la setările de dinainte."
msgstr "حدث خطأ (مكتوب في السجل)، لذلك أعدت الإعدادات السابقة."

msgid "Am revenit la setările de dinainte."
msgstr "أعدت الإعدادات السابقة."

#, python-format
msgid "Revin la setările de dinainte de %s?"
msgstr "هل تعيد الإعدادات التي كانت قبل %s؟"

#, python-format
msgid "Tunerul e folosit acum de %s. Oprește-l, apoi încearcă din nou."
msgstr "الموالف مستخدم الآن من: %s. أوقفه ثم حاول من جديد."

#, python-format
msgid "Semnal prins pe %s, calitate %d %%."
msgstr "الإشارة موجودة على %s، الجودة %d %%."

#, python-format
msgid "Dacă nu răspunzi, revin singur la ce era. Secunde rămase: %d."
msgstr "إذا لم تجب، أعيد ما كان بنفسي. الثواني الباقية: %d."

msgid "Setările tunerului s-au schimbat între timp. Verifică din nou."
msgstr "تغيّرت إعدادات الموالف في الأثناء. افحص من جديد."

msgid "Nu am putut verifica semnalul: receptorul a intrat în standby."
msgstr "لم أستطع فحص الإشارة: دخل جهاز الاستقبال وضع الاستعداد."

msgid "Nu am putut verifica semnalul: programul nu a pornit din nou."
msgstr "لم أستطع فحص الإشارة: لم تبدأ القناة من جديد."

#, python-format
msgid "Nu am putut verifica semnalul: canalul a pornit pe tunerul %s, care nu folosește acest LNB."
msgstr "لم أستطع فحص الإشارة: بدأت القناة على الموالف %s، الذي لا يستخدم هذا الـ LNB."

msgid "Nu am putut verifica semnalul: nu știu pe ce tuner a pornit canalul."
msgstr "لم أستطع فحص الإشارة: لا أعرف على أي موالف بدأت القناة."

msgid "În timpul probei a pornit o înregistrare pe acest LNB, acordată cu setările noi. Verifică înregistrarea."
msgstr "أثناء الفحص بدأ تسجيل على هذا الـ LNB، مضبوط بالإعدادات الجديدة. افحص التسجيل."

#, python-format
msgid "Anulez: %s"
msgstr "ألغي: %s"

#, python-format
msgid "Schimbate din alt loc: %s."
msgstr "تغيّر من مكان آخر: %s."

#, python-format
msgid "Nu am putut aplica setările (%s). Am revenit la ce era."
msgstr "لم أستطع تطبيق الإعدادات (%s). أعدت ما كان."

msgid "Nu am putut aplica setările."
msgstr "لم أستطع تطبيق الإعدادات."

#, python-format
msgid "Pe televizor e deschis ecranul „%s”. Închide-l, apoi încearcă din nou."
msgstr "الشاشة «%s» مفتوحة على التلفاز. أغلقها ثم حاول من جديد."

msgid "Un transponder al satelitului nu apare aici, fiindcă imaginea nu îl poate acorda încă."
msgstr "تردد واحد من ترددات القمر لا يظهر هنا، لأن برنامج الجهاز لا يستطيع ضبطه بعد."

#, python-format
msgid "%d transpondere ale satelitului nu apar aici, fiindcă imaginea nu le poate acorda încă."
msgstr "عدد ترددات القمر التي لا تظهر هنا لأن برنامج الجهاز لا يستطيع ضبطها بعد: %d."

msgid "Receptorul a intrat în standby și tunerul a fost eliberat. Apasă galben ca să măsori din nou."
msgstr "دخل جهاز الاستقبال وضع الاستعداد وتحرر الموالف. اضغط الأصفر لتقيس من جديد."

msgid "Tunerul a fost cerut de altă funcție a receptorului. Apasă galben ca să măsori din nou."
msgstr "طلبت وظيفة أخرى في جهاز الاستقبال الموالف. اضغط الأصفر لتقيس من جديد."

msgid "Rețea confirmată: TS ID și ON ID sunt cele din lista satelitului."
msgstr "الشبكة مؤكدة: TS ID وON ID هما نفسهما في قائمة القمر."

msgid "Orizontală"
msgstr "أفقي"

msgid "Verticală"
msgstr "عمودي"

msgid "Circulară stânga"
msgstr "دائري يسار"

msgid "Circulară dreapta"
msgstr "دائري يمين"

msgid "Oprit"
msgstr "متوقف"

msgid "Pornit"
msgstr "يعمل"

#, python-format
msgid "%d de transpondere ale satelitului nu apar aici, fiindcă imaginea nu le poate acorda încă."
msgstr "عدد ترددات القمر التي لا تظهر هنا لأن برنامج الجهاز لا يستطيع ضبطها بعد: %d."

msgid "sub orizont"
msgstr "تحت الأفق"

msgid "Introdu frecvența (MHz) și rata de simbol (kSymb/s) ale transponderului."
msgstr "أدخل قيمة التردد (MHz) ومعدل الترميز (kSymb/s)."

msgid "Tunerul nu are DVB-S2. Alege un transponder DVB-S."
msgstr "لا يدعم الموالف DVB-S2. اختر ترددا DVB-S."

msgid "Găsirea semnalului e deschisă pe televizor."
msgstr "البحث عن الإشارة مفتوح على التلفاز."

msgid "Măsurarea pornită din web a fost preluată de televizor."
msgstr "القياس الذي بدأ من الويب انتقل إلى التلفاز."

msgid "Măsurarea s-a oprit: pagina web nu mai cere starea."
msgstr "توقف القياس: صفحة الويب لم تعد تطلب الحالة."

msgid "Antena se rotește."
msgstr "الهوائي يدور."

msgid "Canalul s-a oprit cât timp măsori și pornește la loc când ieși."
msgstr "توقفت القناة أثناء القياس وتعود عندما تخرج."

msgid "Satelitul nu are transpondere în lista lui: se măsoară valorile bătute de mână."
msgstr "لا توجد ترددات في قائمة القمر: تُقاس القيم المدخلة يدويا."

msgid "se citește"
msgstr "تُقرأ"

msgid "necitit"
msgstr "لم تُقرأ"

msgid "se rotește"
msgstr "يدور"

#, python-format
msgid "Transponder pe care imaginea nu îl poate acorda: %s"
msgstr "تردد لا يستطيع برنامج الجهاز ضبطه: %s"

msgid "satelit necunoscut"
msgstr "قمر غير معروف"

msgid "Receptorul nu are niciun tuner de satelit, deci aici nu se poate măsura semnalul."
msgstr "لا يوجد في جهاز الاستقبال موالف أقمار، لذلك لا يمكن قياس الإشارة هنا."

msgid "Tunerul nu are niciun satelit configurat. Configurează antena în „Setări tuner”, apoi revino aici."
msgstr "لا يوجد أي قمر مضبوط على الموالف. اضبط الهوائي في «إعدادات الموالف»، ثم عد إلى هنا."

#, python-format
msgid "La %s începe o înregistrare programată și are nevoie de tuner. Măsoară după ce se termină."
msgstr "عند %s يبدأ تسجيل مجدول يحتاج الموالف. قس بعد انتهائه."

msgid "Măsurarea nu e pornită."
msgstr "القياس غير مشغّل."

msgid "Antena se rotește: acordul din nou se face după ce se oprește."
msgstr "الهوائي يدور: الضبط من جديد يتم بعد توقفه."

#, python-format
msgid "Înregistrarea programată la %s are nevoie de tuner. Măsurarea s-a oprit și canalul a pornit la loc."
msgstr "التسجيل المجدول عند %s يحتاج الموالف. توقف القياس وعادت القناة."

msgid "Măsurare oprită"
msgstr "القياس متوقف"

msgid "Niciun tuner de satelit"
msgstr "لا يوجد موالف أقمار"

msgid "Niciun satelit configurat"
msgstr "لا يوجد قمر مضبوط"

msgid "Se acordează"
msgstr "جار الضبط"

msgid "Tunerul e ocupat"
msgstr "الموالف مشغول"

msgid "Tunerul înregistrează"
msgstr "الموالف يسجّل"

msgid "Urmează o înregistrare"
msgstr "تسجيل قادم"

msgid "Nu se poate acorda"
msgstr "لا يمكن الضبط"

msgid "Aștept motorul"
msgstr "أنتظر الموتور"

msgid "Semnal prins"
msgstr "الإشارة موجودة"

msgid "Fără semnal"
msgstr "لا توجد إشارة"

msgid "Semnal pierdut"
msgstr "ضاعت الإشارة"

#, python-format
msgid "La %s începe o înregistrare programată. Măsurarea se oprește singură cu un minut și jumătate înainte."
msgstr "عند %s يبدأ تسجيل مجدول. يتوقف القياس وحده قبله بدقيقة ونصف."

#, python-format
msgid "Cea mai bună calitate în ultimele 10 s: %d %%."
msgstr "أفضل جودة في آخر 10 ث: %d %%."

#, python-format
msgid "ON ID %d, iar în lista satelitului e %d. Antena poate fi pe alt satelit."
msgstr "ON ID هو %d، وفي قائمة القمر %d. ربما الهوائي على قمر آخر."

msgid "FEC pe care nucleul nu îl are"
msgstr "FEC لا تدعمه النواة"

#, python-format
msgid "Tunerul nu poate acorda %s: frecvența nu intră în banda LNB-ului sau satelitul lipsește din setările tunerului."
msgstr "لا يستطيع الموالف ضبط %s: التردد لا يقع في نطاق الـ LNB أو القمر غير موجود في إعدادات الموالف."

msgid "Antena se rotește spre est."
msgstr "الهوائي يدور نحو الشرق."

msgid "Antena se rotește spre vest."
msgstr "الهوائي يدور نحو الغرب."

#, python-format
msgid "Mai are aproximativ %s (estimat)."
msgstr "باقي حوالي %s (تقديري)."

#, python-format
msgid "Poziția de plecare nu e cunoscută: mersul poate ține încă până la %s."
msgstr "موقع البداية غير معروف: قد تستمر الحركة حتى %s أخرى."

msgid "spre"
msgstr "نحو"

msgid "roll-off pe care nucleul nu îl are"
msgstr "roll-off لا تدعمه النواة"

msgid "pilot necunoscut"
msgstr "pilot غير معروف"

msgid "Tunerul de satelit e folosit de o transmisie în rețea sau de o extensie. Oprește-o, apoi apasă galben."
msgstr "موالف الأقمار مستخدم من بث عبر الشبكة أو من إضافة. أوقفها ثم اضغط الأصفر."

msgid "Tunerul de satelit înregistrează acum. Găsirea semnalului merge după terminarea înregistrării."
msgstr "موالف الأقمار يسجّل الآن. البحث عن الإشارة يعمل بعد انتهاء التسجيل."

msgid "Antena poate fi încă în mișcare spre satelitul de dinainte."
msgstr "ربما ما زال الهوائي يتحرك نحو القمر السابق."

msgid "Se acordează după ce antena se oprește."
msgstr "الضبط يتم بعد توقف الهوائي."

msgid "Cifrele sunt din timpul mersului. Verdictul vine după ce antena se oprește."
msgstr "الأرقام من وقت الحركة. النتيجة تأتي بعد توقف الهوائي."

#, python-format
msgid "Niciun semnal în %d s. Se încearcă singur din nou la fiecare %d s (încercarea %d). Mișcă antena încet."
msgstr "لا إشارة منذ %d ث. محاولة جديدة تلقائيا كل %d ث (المحاولة %d). حرّك الهوائي ببطء."

#, python-format
msgid "Semnalul s-a pierdut. Se încearcă din nou la fiecare %d s."
msgstr "ضاعت الإشارة. محاولة جديدة كل %d ث."

msgid "O înregistrare folosește acum antena. Comenzile pornesc după ce se termină."
msgstr "تسجيل يستخدم الهوائي الآن. تبدأ الأوامر بعد انتهائه."

msgid "Peste mai puțin de un minut pornește o înregistrare. Comenzile motorului nu pornesc acum."
msgstr "بعد أقل من دقيقة يبدأ تسجيل. أوامر الموتور لا تبدأ الآن."

msgid "Limita de est se mută în poziția de acum a antenei. Continui?"
msgstr "الحد الشرقي ينتقل إلى موقع الهوائي الحالي. هل تتابع؟"

msgid "Limita de vest se mută în poziția de acum a antenei. Continui?"
msgstr "الحد الغربي ينتقل إلى موقع الهوائي الحالي. هل تتابع؟"

msgid "Fără limite, motorul poate duce antena în opritor și rupe cablul. Oprește-le numai ca să pui limite noi, cu ochii pe antenă. Pornesc singure la ieșire. Le oprești?"
msgstr "بدون حدود قد يدفع الموتور الهوائي حتى المصد ويقطع الكابل. أوقفها فقط لوضع حدود جديدة، وعينك على الهوائي. تعمل وحدها عند الخروج. هل توقفها؟"

msgid "Pornește întâi limitele: fără ele, antena poate merge până în opritor."
msgstr "شغّل الحدود أولا: بدونها قد يصل الهوائي حتى المصد."

msgid "Mișcarea s-a oprit: pagina nu a mai răspuns."
msgstr "توقفت الحركة: الصفحة لم تعد ترد."

msgid "Comanda a fost anulată."
msgstr "أُلغي الأمر."

msgid "Nici oprirea nu a putut fi trimisă. Dacă antena încă se mișcă, oprește receptorul din buton."
msgstr "لم يُرسل حتى الإيقاف. إذا كان الهوائي ما زال يتحرك، أطفئ جهاز الاستقبال من زره."

#, python-format
msgid "Poziția %d din memoria motorului se înlocuiește cu poziția de acum. Continui?"
msgstr "الموقع %d في ذاكرة الموتور يُستبدل بالموقع الحالي. هل تتابع؟"

msgid "Tunerul a fost cerut de altă funcție a receptorului. Motorul s-a oprit, iar programul revine când tunerul se eliberează."
msgstr "طلبت وظيفة أخرى في جهاز الاستقبال الموالف. توقف الموتور، وتعود القناة عندما يتحرر الموالف."

msgid "Tunerul a fost cerut de altă funcție a receptorului. Motorul s-a oprit."
msgstr "طلبت وظيفة أخرى في جهاز الاستقبال الموالف. توقف الموتور."

#, python-format
msgid "Antena încă merge spre %s. Comenzile pornesc după ce ajunge."
msgstr "الهوائي ما زال يتجه نحو: %s. تبدأ الأوامر بعد وصوله."

#, python-format
msgid "Peste %d minute pornește o înregistrare. Comenzile se opresc atunci singure."
msgstr "بعد %d د يبدأ تسجيل. عندها تتوقف الأوامر وحدها."

msgid "Tunerul cu motor e folosit de altcineva (o transmisie în rețea sau o extensie)."
msgstr "الموالف الذي عليه الموتور مستخدم من شيء آخر (بث عبر الشبكة أو إضافة)."

msgid "Limitele au rămas oprite la ultima folosire; le-am pornit."
msgstr "بقيت الحدود متوقفة منذ آخر استخدام، فشغّلتها."

#, python-format
msgid "Tunerul nu a putut fi pregătit pe %s."
msgstr "لم يمكن تجهيز الموالف على %s."

#, python-format
msgid "Receptorul așteaptă semnal pe %s ca să știe că antena a ajuns."
msgstr "جهاز الاستقبال ينتظر إشارة على %s ليعرف أن الهوائي وصل."

#, python-format
msgid "Antena a ajuns pe %s, semnal prins."
msgstr "وصل الهوائي إلى %s، الإشارة موجودة."

#, python-format
msgid "Antena a ajuns pe %s, dar încă nu are semnal."
msgstr "وصل الهوائي إلى %s، لكن لا إشارة بعد."

msgid "Comanda nu a putut fi trimisă din cauza unei erori în receptor. Am trimis oprirea."
msgstr "لم يمكن إرسال الأمر بسبب خطأ في جهاز الاستقبال. أرسلت الإيقاف."

#, python-format
msgid "Poziția %d a fost memorată în motor. Limitele sunt pornite."
msgstr "حُفظ الموقع %d في الموتور. الحدود تعمل."

msgid "Limita de est a fost pusă aici. Limitele sunt pornite."
msgstr "وُضع الحد الشرقي هنا. الحدود تعمل."

msgid "Limita de vest a fost pusă aici. Limitele sunt pornite."
msgstr "وُضع الحد الغربي هنا. الحدود تعمل."

msgid "satelitul programului"
msgstr "قمر القناة"

msgid "Limitele nu au fost oprite: receptorul nu a putut ține minte asta pe disc."
msgstr "لم تتوقف الحدود: لم يستطع جهاز الاستقبال حفظ ذلك على القرص."

msgid "Pornește o înregistrare. Motorul s-a oprit și programul a revenit."
msgstr "يبدأ تسجيل. توقف الموتور وعادت القناة."

#, python-format
msgid "Tunerul nu a acceptat comanda (cod %d). Am trimis oprirea."
msgstr "لم يقبل الموالف الأمر (الرمز %d). أرسلت الإيقاف."

#, python-format
msgid "În setările tunerului, poziția %d e folosită pentru %s."
msgstr "في إعدادات الموالف، الموقع %d مستخدم لـ: %s."

msgid "Un alt tuner legat de antenă a început să lucreze. Motorul s-a oprit."
msgstr "بدأ موالف آخر موصول بالهوائي بالعمل. توقف الموتور."

msgid "Receptorul nu are niciun tuner de satelit, deci motorul nu se poate comanda de aici."
msgstr "لا يوجد في جهاز الاستقبال موالف أقمار، لذلك لا يمكن التحكم بالموتور من هنا."

msgid "Niciun tuner nu e setat cu motor. Motorul se alege în Setări tuner (DiSEqC 1.2 sau USALS)."
msgstr "لا يوجد موالف مضبوط مع موتور. يُختار الموتور من إعدادات الموالف (DiSEqC 1.2 أو USALS)."

