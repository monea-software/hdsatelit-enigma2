msgstr "Nie ma podłączonego pendrive'a: raport został w odbiorniku."

#: lib/python/Components/HdsJurnaleSloturi.py
#, python-format
msgid "Trimis. Codul raportului: %s."
msgstr "Wysłano. Kod raportu: %s."

#: lib/python/Components/HdsJurnaleSloturi.py
msgid "Nu am putut trimite acum: raportul pleacă singur la pornirea următoare, când receptorul are rețea."
msgstr "Nie mogłem go teraz wysłać: raport wyjdzie sam przy następnym uruchomieniu, gdy odbiornik będzie miał sieć."

#: lib/python/Components/HdsJurnaleSloturi.py
msgid "Nu am putut face raportul."
msgstr "Nie udało się utworzyć raportu."

#: lib/python/Components/HdsJurnaleSloturi.py
msgid "Lipsește programul raportului din această imagine."
msgstr "W tym obrazie brakuje programu raportu."

#: lib/python/Plugins/Extensions/HdsWebControl/sloturi_web.py
msgid "Dacă o imagine dintr-un alt slot nu pornește, aici iei pașii pornirilor ei, rapoartele și jurnalele de cădere rămase acolo. O apăsare le pune pe stick și le trimite, ca să aflăm de ce nu pornește. Același ecran e pe receptor, în __DRUM_MENIU__."
msgstr "Jeśli obraz w innym slocie się nie uruchamia, tutaj dostajesz kroki jego uruchomień, raporty i dzienniki awarii, które tam zostały. Jedno naciśnięcie zapisuje je na pendrive i wysyła, abyśmy dowiedzieli się, dlaczego się nie uruchamia. Ten sam ekran jest w odbiorniku, w __DRUM_MENIU__."

#: lib/python/Components/HdsJurnaleSloturi.py
msgid "Ce am găsit în celelalte sloturi"
msgstr "Co znalazłem w pozostałych slotach"

#: lib/python/Components/HdsJurnaleSloturi.py
msgid "Codul raportului"
msgstr "Kod raportu"

