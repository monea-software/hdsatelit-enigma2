#: lib/python/Plugins/Extensions/HdsWebControl/subtitrari_film_web.py
msgid "<a id=\"spreInternet\" href=\"/descarcare-subtitrari\">Caută subtitrări pe internet</a> pentru filmul acesta."
msgstr "<a id=\"spreInternet\" href=\"/descarcare-subtitrari\">Szukaj napisów w internecie</a> dla tego filmu."

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/accel</code>: accelerarea 2D pe placa video: dacă receptorul o are (<code>disponibila</code>), setarea pentru următoarea pornire (implicit pornită) și ce s-a hotărât la pornirea de acum"
msgstr "<code>GET /api/accel</code>: akceleracja 2D na karcie graficznej: czy odbiornik ją ma (<code>disponibila</code>), ustawienie dla następnego uruchomienia (domyślnie włączone) i co zdecydowano przy obecnym uruchomieniu"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-canal</code>: accesul canalului care rulează (criptat sau liber), sistemele, CAID-urile și ce decriptează modulul acum"
msgstr "<code>GET /api/acces-canal</code>: dostęp bieżącego kanału (kodowany lub wolny), systemy, CAID-y i co moduł teraz dekoduje"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-conditionat</code>: modulele de acces condiționat pe feluri (câmpul <code>fel</code>: numele felului, așa cum îl are receptorul; întâi modulele obișnuite, apoi serverele de carduri), cel ales la pornirea receptorului, cele care rulează, procesul care lucrează și memoria lui, comanda în curs sau ultimul rezultat, dacă receptorul decriptează acum"
msgstr "<code>GET /api/acces-conditionat</code>: moduły dostępu warunkowego według rodzajów (pole <code>fel</code>: nazwa rodzaju, tak jak ma ją odbiornik; najpierw zwykłe moduły, potem serwery kart), moduł wybrany przy uruchomieniu odbiornika, moduły działające, proces, który pracuje, i jego pamięć, bieżące polecenie lub ostatni wynik, czy odbiornik teraz dekoduje"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-ssh</code>: intrarea pe receptor prin SSH: felul parolei de administrator (fără parola însăși), cheile SSH (tipul, amprenta, comentariul), „Fără parolă în rețeaua locală”, stările periculoase (<code>alarme</code>), lucrarea în curs și rezultatul ultimei comenzi"
msgstr "<code>GET /api/acces-ssh</code>: dostęp do odbiornika przez SSH: rodzaj hasła administratora (bez samego hasła), klucze SSH (typ, odcisk, komentarz), „Bez hasła w sieci lokalnej”, niebezpieczne stany (<code>alarme</code>), bieżące zadanie i wynik ostatniego polecenia"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, <code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, <code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/actualizari-reporneste</code>: actualizările prin pachete de pe stb.hdsatelit.com (starea, căutarea, instalarea, verificarea zilnică, repornirea interfeței după instalare)"
msgstr "<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, <code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, <code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/actualizari-reporneste</code>: aktualizacje przez pakiety z stb.hdsatelit.com (stan, wyszukiwanie, instalacja, codzienne sprawdzanie, ponowne uruchomienie interfejsu po instalacji)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;orase=1]</code>: afișajul din față: ce arată acum (măștile celor 4 cifre și textul), lista de rotire, mesajele scurte, așteptarea, setările, minutarul și cronometrul; cu <code>grupa</code> alegerile grupei cu desenul valorii de acum, cu <code>catalog=1</code> toate alegerile (căutarea), cu <code>orase=1</code> fusurile pentru ora din alt oraș"
msgstr "<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;orase=1]</code>: wyświetlacz z przodu: co teraz pokazuje (maski 4 cyfr i tekst), lista rotacji, krótkie komunikaty, oczekiwanie, ustawienia, minutnik i stoper; z <code>grupa</code> opcje grupy z rysunkiem obecnej wartości, z <code>catalog=1</code> wszystkie opcje (wyszukiwanie), z <code>orase=1</code> strefy czasowe dla godziny w innym mieście"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: tunerele, LNB-ul, semnalul canalului curent și unghiurile antenei spre fiecare satelit (numai citire)"
msgstr "<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: tunery, LNB, sygnał bieżącego kanału i kąty anteny do każdego satelity (tylko odczyt)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/calitate-imagine</code>: calitatea imaginii: „Reglajele după canal”, profilul canalului de acum, cele 9 profiluri (SD, HD, 4K x SDR, HDR10, HLG) cu reglajele lor, ieșirea HDR (alegerile primite de televizor, ce e scris acum, întrebarea în curs) și textul brut al blocului de calitate"
msgstr "<code>GET /api/calitate-imagine</code>: jakość obrazu: „Ustawienia według kanału”, profil bieżącego kanału, 9 profili (SD, HD, 4K x SDR, HDR10, HLG) z ich ustawieniami, wyjście HDR (opcje odebrane przez telewizor, co jest teraz zapisane, bieżące zapytanie) i surowy tekst bloku jakości"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-acum</code>: canalul de pe televizor"
msgstr "<code>GET /api/canale-acum</code>: kanał na telewizorze"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-buchete?fila=tv|radio</code>: listele de ales și lista pe care stă televizorul"
msgstr "<code>GET /api/canale-buchete?fila=tv|radio</code>: listy do wyboru i lista, na której jest telewizor"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-epg?refs=r1,r2</code>: emisiunea de acum și cea următoare, cel mult 50 de canale"
msgstr "<code>GET /api/canale-epg?refs=r1,r2</code>: bieżąca i następna audycja, najwyżej 50 kanałów"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,v2&amp;de_la=&amp;cate=</code>: rândurile, pe pagini de cel mult 200, cu grupele de filtre și numerele lor"
msgstr "<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,v2&amp;de_la=&amp;cate=</code>: wiersze, na stronach po najwyżej 200, z grupami filtrów i ich liczbami"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: sigla canalului; la listele de canale, 503 când receptorul are prea multe cereri în lucru și 504 când nu termină în 10 s"
msgstr "<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: logo kanału; przy listach kanałów 503, gdy odbiornik ma zbyt wiele żądań w toku, i 504, gdy nie skończy w 10 s"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Caută setări”: meniurile și setările care au textul în nume (fără diacritice), cu drumul din meniu, valoarea de acum și pagina web"
msgstr "<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Szukaj ustawień”: menu i ustawienia, które mają tekst w nazwie (bez znaków diakrytycznych), ze ścieżką w menu, obecną wartością i stroną WWW"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cautare-actualizeaza-stare</code>: cât a citit (transponderul, canalele) sau rezultatul"
msgstr "<code>GET /api/cautare-actualizeaza-stare</code>: ile odczytał (transponder, kanały) lub wynik"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code>: căutarea de canale, cu aceleași rânduri de filtre ca pe televizor și pistele știute ale fiecărui canal"
msgstr "<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code>: wyszukiwanie kanałów, z tymi samymi wierszami filtrów co na telewizorze i znanymi ścieżkami każdego kanału"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ceas</code>: ora receptorului, fusul orar, sursa orei (<code>auto</code>: Internet, apoi transponder; <code>ntp</code>; <code>dvb</code>), serverul NTP, alegerile lor și ultima sincronizare"
msgstr "<code>GET /api/ceas</code>: czas odbiornika, strefa czasowa, źródło czasu (<code>auto</code>: Internet, potem transponder; <code>ntp</code>; <code>dvb</code>), serwer NTP, ich opcje i ostatnia synchronizacja"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/copie-setari[?cauta=1]</code>: copia setărilor: stickurile și discurile (<code>implicit</code> = stickul de actualizare), copiile găsite (data, versiunea imaginii, acest receptor sau altul), copia automată, ultimul rezultat; niciodată conținutul copiei"
msgstr "<code>GET /api/copie-setari[?cauta=1]</code>: kopia ustawień: pendrive'y i dyski (<code>implicit</code> = pendrive aktualizacji), znalezione kopie (data, wersja obrazu systemu, ten odbiornik lub inny), automatyczna kopia, ostatni wynik; nigdy zawartość kopii"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/dabt2?fel=dab|t2</code>: fereastra „Fluxuri și setări” a DAB+ / DVB-T2 din satelit: fluxurile cu poziția, numele, numărul de posturi și starea, setările, Despre, lucrul în curs și <code>repunere</code> (canalul de dinainte, pornit din nou după „Învață posturile”: starea și mesajul)"
msgstr "<code>GET /api/dabt2?fel=dab|t2</code>: okno „Strumienie i ustawienia” DAB+ / DVB-T2 z satelity: strumienie z pozycją, nazwą, liczbą stacji i stanem, ustawienia, O programie, bieżąca praca i <code>repunere</code> (poprzedni kanał, włączony ponownie po „Poznaj stacje”: stan i komunikat)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/descarcare-subtitrari</code> și <code>POST /api/descarcare-subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, <code>-verifica</code>, <code>-conturi</code>: descărcarea subtitrărilor (numele, parolele și cheile numai în corpul cererii); pe un canal TV sau la o înregistrare și <code>-film</code> (<code>fapta=identifica|alege|titlu|local</code>: filmul din ghid, identificat în Wikidata) și <code>-potrivire</code> (<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|opreste</code>: potrivirea subtitrării pe canal)"
msgstr "<code>GET /api/descarcare-subtitrari</code> i <code>POST /api/descarcare-subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, <code>-verifica</code>, <code>-conturi</code>: pobieranie napisów (nazwy użytkowników, hasła i klucze tylko w treści żądania); na kanale TV lub przy nagraniu oraz <code>-film</code> (<code>fapta=identifica|alege|titlu|local</code>: film z programu TV, zidentyfikowany w Wikidata) i <code>-potrivire</code> (<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|opreste</code>: dopasowanie napisów na kanale)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: mesajul de pe ecranul negru (de ce nu se vede imaginea) și analiza fluxului canalului"
msgstr "<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: komunikat na czarnym ekranie (dlaczego nie widać obrazu) i analiza strumienia kanału"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/egalizator</code>: egalizatorul posturilor de radio: pornit sau oprit, benzile, presetarea, modul de noapte, reglajele postului de acum și dacă merge la acest post; <code>POST /api/egalizator-seteaza</code>: schimbă și aplică pe loc"
msgstr "<code>GET /api/egalizator</code>: korektor stacji radiowych: włączony lub wyłączony, pasma, ustawienie wstępne, tryb nocny, regulacje bieżącej stacji i czy działa na tej stacji; <code>POST /api/egalizator-seteaza</code>: zmienia i od razu stosuje"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/filme</code>: filmul care merge (poziția, lungimea, starea, locul ținut minte, mesajul de refuz) și setările filmelor; <code>GET /api/filme-lista</code>: filmele din dosarul listei de filme, cu locul rămas"
msgstr "<code>GET /api/filme</code>: odtwarzany film (pozycja, długość, stan, zapamiętane miejsce, komunikat odmowy) i ustawienia filmów; <code>GET /api/filme-lista</code>: filmy z folderu listy filmów, z miejscem zatrzymania"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: familiile libere de pe Google Fonts și fonturile deja descărcate"
msgstr "<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: darmowe rodziny z Google Fonts i już pobrane czcionki"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal-stare</code>: nivelul, calitatea, BER-ul și verdictul măsurării"
msgstr "<code>GET /api/gasire-semnal-stare</code>: poziom, jakość, BER i werdykt pomiaru"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: transponderele unui satelit"
msgstr "<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: transpondery satelity"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal</code>: tunerele, sateliții, transponderul de la care pornește măsurarea și starea ei"
msgstr "<code>GET /api/gasire-semnal</code>: tunery, satelity, transponder, od którego zaczyna się pomiar, i stan pomiaru"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-emisiune?ref=&amp;id=</code>: ghidul unui canal (fără <code>ref</code>, canalul de pe televizor) și o emisiune cu descrierile"
msgstr "<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-emisiune?ref=&amp;id=</code>: program kanału (bez <code>ref</code>, kanał na telewizorze) i audycja z opisami"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/import-surse?cauta=1</code>: copiile de canale și setări găsite pe stick-uri și pe receptor, starea căutării și a importului"
msgstr "<code>GET /api/import-surse?cauta=1</code>: kopie kanałów i ustawień znalezione na pendrive'ach i w odbiorniku, stan wyszukiwania i importu"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|retea|hdmi</code>: ecranele „System Information”, cu aceleași texte ca pe televizor"
msgstr "<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|retea|hdmi</code>: ekrany „System Information”, z tymi samymi tekstami co na telewizorze"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/interfete-cam?reincarca=1</code>: modulele de acces condiționat instalate și interfețele lor web, cu numele date de fiecare modul (fără <code>reincarca</code> poate veni o căutare făcută cu câteva secunde înainte)"
msgstr "<code>GET /api/interfete-cam?reincarca=1</code>: zainstalowane moduły dostępu warunkowego i ich interfejsy WWW, z nazwami nadanymi przez każdy moduł (bez <code>reincarca</code> może przyjść wynik wyszukiwania sprzed kilku sekund)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/jurnal</code>: jurnalul de versiuni (ce s-a schimbat la fiecare actualizare)"
msgstr "<code>GET /api/jurnal</code>: dziennik wersji (co się zmieniło w każdej aktualizacji)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: programele din imagine cu licența fiecăruia și textul unei licențe"
msgstr "<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: programy w obrazie systemu z licencją każdego z nich i tekst licencji"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/limba-interfata</code>: limba meniurilor de acum și lista limbilor, cu numele de pe televizor"
msgstr "<code>GET /api/limba-interfata</code>: bieżący język menu i lista języków, z nazwami z telewizora"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/limbi</code>: limba sunetului și a subtitrărilor: cele 7 setări cu alegerile lor, ce se ține minte pe canalul de acum și canalele cu alegeri de mână"
msgstr "<code>GET /api/limbi</code>: język dźwięku i napisów: 7 ustawień z ich opcjami, co jest zapamiętane na bieżącym kanale i kanały z ręcznymi wyborami"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/liste-implicite</code>: listele de canale gata făcute și drumurile spre scanare și import"
msgstr "<code>GET /api/liste-implicite</code>: gotowe listy kanałów i ścieżki do skanowania i importu"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/lnb-stare</code>: verificarea semnalului, întrebarea și secundele rămase"
msgstr "<code>GET /api/lnb-stare</code>: sprawdzanie sygnału, pytanie i pozostałe sekundy"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/lnb?slot=N</code>: LNB-urile tunerului, cu valorile, alegerile și „Probă de calcul” (numai citire)"
msgstr "<code>GET /api/lnb?slot=N</code>: LNB tunera, z wartościami, opcjami i „Próbą obliczenia” (tylko odczyt)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/locul[?tara=RO]</code>: locul antenei pentru motorul USALS, țările și orașele unei țări (tabelul din imagine)"
msgstr "<code>GET /api/locul[?tara=RO]</code>: lokalizacja anteny dla silnika USALS, kraje i miasta danego kraju (tabela z obrazu systemu)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/meniu</code>: tot meniul receptorului (tasta MENU), cu aceleași intrări ca pe televizor pentru nivelul ales"
msgstr "<code>GET /api/meniu</code>: całe menu odbiornika (przycisk MENU), z tymi samymi pozycjami co na telewizorze dla wybranego poziomu"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, <code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: modul sigur (opririle interfeței, alegerile de după ele) și fișierele lui ca text"
msgstr "<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, <code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: tryb bezpieczny (zatrzymania interfejsu, wybory po nich) i jego pliki jako tekst"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor-comenzi</code>: tunerele cu motor, sateliții și starea comenzilor"
msgstr "<code>GET /api/motor-comenzi</code>: tunery z silnikiem, satelity i stan poleceń"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor-comenzi?urma=N</code>: urma comenzilor trimise motorului (ultimele N, implicit 100, cel mult 500, cele mai noi întâi): ora, comanda, unghiul, cine a cerut-o (televizorul, ecranul sau pagina motorului, Găsire semnal, reacordarea), poziția crezută de receptor; numai citire, din <code>/home/root/logs/hds-motor.log</code>"
msgstr "<code>GET /api/motor-comenzi?urma=N</code>: ślad poleceń wysłanych do silnika (ostatnie N, domyślnie 100, najwyżej 500, najnowsze najpierw): godzina, polecenie, kąt, kto o nie poprosił (telewizor, ekran lub strona silnika, Wyszukiwacz sygnału, ponowne strojenie), pozycja zakładana przez odbiornik; tylko odczyt, z <code>/home/root/logs/hds-motor.log</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor</code>: starea rotirii antenei (de unde, pana unde, poziția estimată, cât mai are de mers)"
msgstr "<code>GET /api/motor</code>: stan obracania anteny (skąd, dokąd, szacowana pozycja, ile jeszcze zostało)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;xp=&amp;yp=</code>: mouse-ul pe ecranul televizorului, ca în emulator: <code>xp</code>, <code>yp</code> = locul în procente din ecran (sau <code>x</code>, <code>y</code> în pixelii ecranului, 1920x1080); <code>clic</code> alege rândul de sub mouse, iar pe rândul ales sau cu <code>clicuri=2</code> dă OK; un buton colorat = tasta lui; <code>drag</code> (cu <code>x0p</code>, <code>y0p</code> = locul apăsării, <code>nou=1</code> la prima mișcare) și <code>dragend</code> = trasul pe bara de derulare; <code>rotita&amp;pasi=-12..12</code> = sus/jos (3 pași sau mai mulți = o pagină); <code>dreapta</code> = Meniu, <code>mijloc</code> = Ieșire. Răspunsul spune ce s-a făcut (<code>facut</code>: selectie, ok, buton, bara, derulare, tasta, nimic). Din browser, cu POST și antetul <code>X-HDS-CSRF</code>, ca <code>remotecontrol</code>"
msgstr "<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;xp=&amp;yp=</code>: mysz na ekranie telewizora, jak w emulatorze: <code>xp</code>, <code>yp</code> = miejsce w procentach ekranu (lub <code>x</code>, <code>y</code> w pikselach ekranu, 1920x1080); <code>clic</code> wybiera wiersz pod myszą, a na wybranym wierszu lub z <code>clicuri=2</code> daje OK; kolorowy przycisk = jego klawisz; <code>drag</code> (z <code>x0p</code>, <code>y0p</code> = miejsce wciśnięcia, <code>nou=1</code> przy pierwszym ruchu) i <code>dragend</code> = przeciąganie na pasku przewijania; <code>rotita&amp;pasi=-12..12</code> = w górę/w dół (3 kroki lub więcej = jedna strona); <code>dreapta</code> = Menu, <code>mijloc</code> = Wyjście. Odpowiedź mówi, co zostało zrobione (<code>facut</code>: selectie, ok, buton, bara, derulare, tasta, nimic). Z przeglądarki, przez POST i nagłówek <code>X-HDS-CSRF</code>, jak <code>remotecontrol</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/navigator</code>: navigatorul web de pe televizor (deschis sau nu, modul, desenul, felul câmpului ales, mărirea; fără adrese), setările lui și favoritele"
msgstr "<code>GET /api/navigator</code>: przeglądarka WWW na telewizorze (otwarta czy nie, tryb, rysunek, rodzaj wybranego pola, powiększenie; bez adresów), jej ustawienia i ulubione"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ocr-limbi</code>: limbile recunoașterii textului (în imagine, descărcate, de descărcat, cu mărimea și starea fiecăreia) și locul pentru modelele noi"
msgstr "<code>GET /api/ocr-limbi</code>: języki rozpoznawania tekstu (w obrazie systemu, pobrane, do pobrania, z rozmiarem i stanem każdego) oraz miejsce na nowe modele"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/pasi-decriptare</code>: pașii decriptării canalului de pe televizor (cererea către modulul de acces, răspunsurile și timpul lor, imaginea decriptată, mesajele modulului CI), numai cu setarea Arată pașii decriptării pornită"
msgstr "<code>GET /api/pasi-decriptare</code>: kroki deszyfrowania kanału na telewizorze (żądanie do modułu dostępu, odpowiedzi i ich czas, odszyfrowany obraz, komunikaty modułu CI), tylko przy włączonym ustawieniu Pokaż kroki deszyfrowania"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/paza-model</code>: paza de model (receptorul pentru care e făcută imaginea și amprenta acestuia); <code>GET /api/actualizare-pachete</code>: pachetele de actualizare găsite și verdictul pazei pentru fiecare"
msgstr "<code>GET /api/paza-model</code>: ochrona modelu (odbiornik, dla którego zrobiono obraz systemu, i jego odcisk); <code>GET /api/actualizare-pachete</code>: znalezione pakiety aktualizacji i werdykt ochrony dla każdego"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/paznic</code>: paznicul receptorului: starea, setările (<code>interfata</code>, <code>asteptare</code> în secunde), alegerile și ultimele rânduri din jurnalul lui"
msgstr "<code>GET /api/paznic</code>: strażnik odbiornika: stan, ustawienia (<code>interfata</code>, <code>asteptare</code> w sekundach), opcje i ostatnie wiersze jego dziennika"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/portal</code>: starea HbbTV a canalului care rulează (da, nu are, încă nu se știe), cu mesajul arătat pe televizor la tasta PORTAL"
msgstr "<code>GET /api/portal</code>: stan HbbTV bieżącego kanału (tak, nie ma, jeszcze nie wiadomo), z komunikatem pokazywanym na telewizorze po naciśnięciu klawisza PORTAL"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/procesor</code>: procesorul: modul de lucru, modurile care există pe receptor, frecvența setată și cea de acum, temperatura, tensiunea, procentul folosit și timpul pe fiecare treaptă"
msgstr "<code>GET /api/procesor</code>: procesor: tryb pracy, tryby dostępne w odbiorniku, ustawiona i bieżąca częstotliwość, temperatura, napięcie, procent użycia i czas na każdym stopniu"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: postul de radio care merge, cu textele ecranului radio; barele și nivelul sunetului"
msgstr "<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: grająca stacja radiowa, z tekstami ekranu radia; słupki i poziom dźwięku"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: apasă o tastă ca de pe telecomanda receptorului (coduri de tastă Linux, de exemplu 352 pentru OK); cu <code>lung=1</code>, apăsare lungă"
msgstr "<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: naciska klawisz jak na pilocie odbiornika (kody klawiszy Linux, na przykład 352 dla OK); z <code>lung=1</code>, długie naciśnięcie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare-stare</code>: starea căutării (procent, canale găsite, transpondere, timp rămas, rezultat)"
msgstr "<code>GET /api/scanare-stare</code>: stan wyszukiwania (procent, znalezione kanały, transpondery, pozostały czas, wynik)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare-ultima</code>: rezultatul ultimei scanări de canale, ținut până la scanarea următoare: <code>inceput</code>, <code>sfarsit</code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, <code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, <code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, <code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, iar când se știu <code>tsid</code>, <code>onid</code>, <code>nid</code> și, la cablu, <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, <code>caid</code>, iar când operatorul trimite numerele canalelor <code>lcn</code> și <code>lcn_vizibil</code>): toate serviciile citite din SDT, vechi și noi, și <code>retele</code> (<code>nid</code>, <code>nume</code>, <code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, <code>privati</code>): rețelele din tabela NIT; câmpurile din tabela NIT (<code>nid</code>, <code>lcn</code>, <code>retele</code>) apar la căutarea în rețea și la scanarea pe cablu pe o singură frecvență; numai citire, lista de canale nu se schimbă; fără nicio scanare de la pornire, <code>result</code> false"
msgstr "<code>GET /api/scanare-ultima</code>: wynik ostatniego skanowania kanałów, przechowywany do następnego skanowania: <code>inceput</code>, <code>sfarsit</code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, <code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, <code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, <code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, a gdy są znane <code>tsid</code>, <code>onid</code>, <code>nid</code> i, w kablu, <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, <code>caid</code>, a gdy operator przesyła numery kanałów <code>lcn</code> i <code>lcn_vizibil</code>): wszystkie serwisy odczytane z SDT, stare i nowe, oraz <code>retele</code> (<code>nid</code>, <code>nume</code>, <code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, <code>privati</code>): sieci z tabeli NIT; pola z tabeli NIT (<code>nid</code>, <code>lcn</code>, <code>retele</code>) pojawiają się przy wyszukiwaniu w sieci i przy skanowaniu kablowym na jednej częstotliwości; tylko odczyt, lista kanałów się nie zmienia; bez żadnego skanowania od uruchomienia, <code>result</code> false"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare</code>: secțiunile „Scanare” și „Orientarea și setarea antenei”, cu felurile de scanare, în ordinea din meniul receptorului; cu <code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</code>, câmpurile felului și ce s-ar căuta"
msgstr "<code>GET /api/scanare</code>: sekcje „Wyszukiwanie kanałów” i „Ustawianie i konfiguracja anteny”, z rodzajami skanowania, w kolejności z menu odbiornika; z <code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</code>, pola danego rodzaju i to, co byłoby wyszukiwane"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;mode=all|video|osd&amp;download=1</code>: imaginea de pe ecran; <code>mode</code>: <code>all</code> cu afișajul OSD (implicit), <code>video</code> numai imaginea canalului, <code>osd</code> numai afișajul OSD; <code>download=1</code>: descărcare ca fișier, cu data și ora receptorului în nume"
msgstr "<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;mode=all|video|osd&amp;download=1</code>: obraz z ekranu; <code>mode</code>: <code>all</code> z wyświetlaczem OSD (domyślnie), <code>video</code> tylko obraz kanału, <code>osd</code> tylko wyświetlacz OSD; <code>download=1</code>: pobranie jako plik, z datą i godziną odbiornika w nazwie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/setari-din-copie</code>: setările importate: câte așteaptă repornirea interfeței (<code>asteapta</code>), proba lor (<code>garda</code>), scoase după opriri neașteptate (<code>cazut</code>), textele stării"
msgstr "<code>GET /api/setari-din-copie</code>: zaimportowane ustawienia: ile czeka na ponowne uruchomienie interfejsu (<code>asteapta</code>), ich próba (<code>garda</code>), usunięte po nieoczekiwanych zatrzymaniach (<code>cazut</code>), teksty stanu"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/setari</code>: ecranele de setări din meniu; cu <code>id=&lt;cheie&gt;</code>, rândurile lor (aceleași ca pe televizor, cu alegerile)"
msgstr "<code>GET /api/setari</code>: ekrany ustawień z menu; z <code>id=&lt;cheie&gt;</code>, ich wiersze (takie same jak na telewizorze, z opcjami)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/standby-tv</code>: ieșirea HDMI în standby (oprită sau pornită, oprirea din nou după aprinderea televizorului) și starea CEC"
msgstr "<code>GET /api/standby-tv</code>: wyjście HDMI w stanie czuwania (wyłączone lub włączone, ponowne wyłączenie po włączeniu telewizora) i stan CEC"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/stare-retea</code>: legătura cu routerul și internetul (cablu sau Wi-Fi, treptele semnalului Wi-Fi, internetul merge, routerul nu are internet sau receptorul nu e conectat la router), cu desenul pictogramei și textul ei, ca pictograma din bara de pe televizor"
msgstr "<code>GET /api/stare-retea</code>: połączenie z routerem i internetem (kabel lub Wi-Fi, poziomy sygnału Wi-Fi, internet działa, router nie ma internetu lub odbiornik nie jest połączony z routerem), z rysunkiem ikony i jej tekstem, jak ikona na pasku na telewizorze"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/statusinfo</code>: canalul curent, volumul, standby"
msgstr "<code>GET /api/statusinfo</code>: bieżący kanał, głośność, czuwanie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/stocare</code>: locul înregistrărilor, spațiul liber și discurile conectate"
msgstr "<code>GET /api/stocare</code>: miejsce nagrań, wolne miejsce i podłączone dyski"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-aspect</code>: aspectul subtitrărilor text (fontul, grosimea, mărimea și culoarea literelor, conturul, umbra, fundalul, înălțimea, distanța dintre rânduri) și mărirea subtitrărilor DVB, cu alegerile posibile (<code>alegeri</code>), stilurile gata făcute și valorile de la început"
msgstr "<code>GET /api/subtitrari-aspect</code>: wygląd napisów tekstowych (czcionka, grubość, rozmiar i kolor liter, obrys, cień, tło, wysokość, odstęp między wierszami) i powiększenie napisów DVB, z możliwymi opcjami (<code>alegeri</code>), gotowymi stylami i wartościami początkowymi"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-film</code>: filmul care merge, subtitrările lui, întârzierea, codarea și cadrele pe secundă"
msgstr "<code>GET /api/subtitrari-film</code>: odtwarzany film, jego napisy, opóźnienie, kodowanie i klatki na sekundę"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-ocr</code>: contorul recunoașterii textului din subtitrările DVB (pagini citite ca text, rămase imagine și de ce, timpul mediu, ultimele pagini, viteza serviciului)"
msgstr "<code>GET /api/subtitrari-ocr</code>: licznik rozpoznawania tekstu z napisów DVB (strony odczytane jako tekst, pozostawione jako obraz i dlaczego, średni czas, ostatnie strony, szybkość usługi)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/sunet</code>: ieșirea sunetului (Automat / Manual), AC3 și DTS downmix, pista AC3, ce primește televizorul (EDID), ce se trimite acum și de ce, ce arată driverul pe HDMI și optic"
msgstr "<code>GET /api/sunet</code>: wyjście dźwięku (Automatycznie / Ręcznie), AC3 i DTS downmix, ścieżka AC3, co przyjmuje telewizor (EDID), co jest teraz wysyłane i dlaczego, co pokazuje sterownik na HDMI i wyjściu optycznym"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/telecomenzi-export?format=json|csv</code>: codurile telecomenzii receptorului și ale celor asociate, pentru aplicații"
msgstr "<code>GET /api/telecomenzi-export?format=json|csv</code>: kody pilota odbiornika i przypisanych pilotów, dla aplikacji"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/telecomenzi</code>: telecomenzile asociate, tastele lor și captura paginii (cititorul, proba, asocierea)"
msgstr "<code>GET /api/telecomenzi</code>: przypisane piloty, ich klawisze i przechwytywanie strony (czytnik, test, przypisywanie)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext-copii</code> (cu <code>?canale=1</code> și canalele care au teletext): copiile de teletext salvate (canalul, data, paginile, mărimea), dosarul, spațiul folosit și cel ales, urmăritorul (caruselul canalului de acum, reîmprospătarea în lucru) și setările"
msgstr "<code>GET /api/teletext-copii</code> (z <code>?canale=1</code> i kanałami, które mają telegazetę): zapisane kopie telegazety (kanał, data, strony, rozmiar), katalog, zajęte miejsce i wybrany limit, obserwator (karuzela bieżącego kanału, odświeżanie w toku) i ustawienia"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> (fără <code>ref</code>: canalul de acum): <code>date</code> = fișierul copiei (.ttx, comprimat), <code>html</code> = o singură pagină HTML cu toate paginile, care se citește fără receptor"
msgstr "<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> (bez <code>ref</code>: bieżący kanał): <code>date</code> = plik kopii (.ttx, skompresowany), <code>html</code> = jedna strona HTML ze wszystkimi stronami, którą można czytać bez odbiornika"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;ref&gt;</code>: o pagină de teletext, ca pe televizor la tasta TEXT: cele 25 de rânduri a câte 40 de celule (litera, culoarea, fundalul, mozaicul, atributele), textul paginii, subpaginile, paginile tastelor colorate, paginile vecine și pagina de pe televizor; fără <code>pagina</code>, pagina de pe televizor sau cea de pornire; <code>sub=-1</code> = cea mai nouă; <code>ascuns=1</code> arată ce e ascuns; cu <code>copie</code>, paginile din copia salvată a canalului, fără tuner (<code>sursa</code>: <code>direct</code> sau <code>copie</code>); <code>hd</code> = setarea Teletext neted, <code>optiuni</code> = conturul literelor, umbra literelor și formele în relief (<code>contur</code>, <code>umbra</code>, <code>relief</code>, ca pe televizor). Pagina lipsă: <code>gasita</code> fals și mesajul că se caută"
msgstr "<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;ref&gt;</code>: strona telegazety, jak na telewizorze pod przyciskiem TEXT: 25 wierszy po 40 komórek (litera, kolor, tło, mozaika, atrybuty), tekst strony, podstrony, strony kolorowych przycisków, strony sąsiednie i strona z telewizora; bez <code>pagina</code> strona z telewizora lub startowa; <code>sub=-1</code> = najnowsza; <code>ascuns=1</code> pokazuje to, co ukryte; z <code>copie</code> strony z zapisanej kopii kanału, bez tunera (<code>sursa</code>: <code>direct</code> lub <code>copie</code>); <code>hd</code> = ustawienie Wygładzona telegazeta, <code>optiuni</code> = obrys liter, cień liter i kształty wypukłe (<code>contur</code>, <code>umbra</code>, <code>relief</code>, jak na telewizorze). Brak strony: <code>gasita</code> fałsz i komunikat, że trwa wyszukiwanie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: jurnalul unei înregistrări, pe înțelesul oricui, cu mesajul tehnic; golirea lui"
msgstr "<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: dziennik nagrania, zrozumiały dla każdego, z komunikatem technicznym; jego czyszczenie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/temporizatoare</code>: înregistrările programate (aceeași ordine, stare și detalii ca pe televizor), locul înregistrărilor și spațiul liber"
msgstr "<code>GET /api/temporizatoare</code>: zaplanowane nagrania (ta sama kolejność, stan i szczegóły co na telewizorze), miejsce nagrań i wolne miejsce"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/traducere-configurare</code>: configurarea pas cu pas a traducerii: ce e pus acum (<code>acum</code>: serviciul, dacă are cheie, pornită sau nu, ultima probă, <code>chei_din_nou</code>), lucrarea configurării (<code>configurare</code>: starea, pasul, proba, modelul și modelele, mesajul și ce să faci), căutarea serverelor din casă (<code>cautare</code>: progresul și serverele găsite), instrucțiunile și pagina cheii fiecărui serviciu, regiunile Azure; niciodată o cheie"
msgstr "<code>GET /api/traducere-configurare</code>: konfiguracja tłumaczenia krok po kroku: co jest ustawione teraz (<code>acum</code>: usługa, czy ma klucz, włączone czy nie, ostatni test, <code>chei_din_nou</code>), przebieg konfiguracji (<code>configurare</code>: stan, krok, test, model i modele, komunikat i co zrobić), wyszukiwanie serwerów w domu (<code>cautare</code>: postęp i znalezione serwery), instrukcje i strona klucza każdej usługi, regiony Azure; nigdy klucz"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/traducere-subtitrari</code>: traducerea automată a subtitrărilor text: valorile (<code>pornit</code>, <code>serviciu</code>, <code>limba</code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</code>, <code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</code>, <code>adresa_libre</code>, <code>adresa_openai</code>, <code>model_gemini</code>, <code>model_openai</code>, <code>model_groq</code>, <code>model_cloudflare</code>, <code>cont_cloudflare</code> și, pentru adresa proprie, <code>propriu_adresa</code>, <code>propriu_metoda</code>, <code>propriu_corp</code>, <code>propriu_tip_corp</code>, <code>propriu_antet</code>, <code>propriu_raspuns</code>, <code>propriu_cale</code>), alegerile posibile (<code>alegeri</code>), ce cere fiecare serviciu (<code>cere</code>), care serviciu are cheie (<code>chei</code>, niciodată cheia), dacă cheile trebuie puse din nou (<code>chei_din_nou</code>, textul notei, gol când nu e cazul), starea cheii serviciului ales, ca pe televizor (<code>cheie_fel</code> și <code>cheie_text</code>: pusă, pusă pentru alt server, lipsă), textele paginii în limba receptorului (<code>texte</code>), ce lipsește, confidențialitatea, instrucțiunile pas cu pas (cu <code>pagina_cheie</code>, adresa oficială pentru codul QR) și starea (contorul, proba, pauza după erori)"
msgstr "<code>GET /api/traducere-subtitrari</code>: automatyczne tłumaczenie napisów tekstowych: wartości (<code>pornit</code>, <code>serviciu</code>, <code>limba</code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</code>, <code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</code>, <code>adresa_libre</code>, <code>adresa_openai</code>, <code>model_gemini</code>, <code>model_openai</code>, <code>model_groq</code>, <code>model_cloudflare</code>, <code>cont_cloudflare</code> oraz, dla własnego adresu, <code>propriu_adresa</code>, <code>propriu_metoda</code>, <code>propriu_corp</code>, <code>propriu_tip_corp</code>, <code>propriu_antet</code>, <code>propriu_raspuns</code>, <code>propriu_cale</code>), możliwe wybory (<code>alegeri</code>), czego wymaga każda usługa (<code>cere</code>), która usługa ma klucz (<code>chei</code>, nigdy sam klucz), czy klucze trzeba wprowadzić ponownie (<code>chei_din_nou</code>, tekst uwagi, pusty, gdy nie dotyczy), stan klucza wybranej usługi, jak na telewizorze (<code>cheie_fel</code> i <code>cheie_text</code>: ustawiony, ustawiony dla innego serwera, brak), teksty strony w języku odbiornika (<code>texte</code>), czego brakuje, prywatność, instrukcje krok po kroku (z <code>pagina_cheie</code>, oficjalnym adresem dla kodu QR) i stan (licznik, test, przerwa po błędach)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: canalele de pe frecvența televizorului și din lista lui, fiecare cu merge acum sau motivul, codecul imaginii și felul sunetului; cu <code>wasm=1</code> (browserul are playerul MPEG-2) merg și canalele cu imagine MPEG-2; <code>ac3=1</code>: pagina redă sunetul AC-3, cu decodorul browserului sau cu decodorul wasm al paginii"
msgstr "<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: kanały z częstotliwości telewizora i z jego listy, każdy z informacją, czy działa teraz, lub z powodem, z kodekiem obrazu i rodzajem dźwięku; z <code>wasm=1</code> (przeglądarka ma odtwarzacz MPEG-2) działają też kanały z obrazem MPEG-2; <code>ac3=1</code>: strona odtwarza dźwięk AC-3 dekoderem przeglądarki lub dekoderem wasm strony"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/tv-stare</code>: TV în browser: transmisiile de acum (canal, browser, de când, octeți), setările, memoria driverului video (câte canale noi se mai pot deschide până la repornire), transmisia acestui browser și motivul ultimei opriri"
msgstr "<code>GET /api/tv-stare</code>: TV w przeglądarce: bieżące transmisje (kanał, przeglądarka, od kiedy, bajty), ustawienia, pamięć sterownika wideo (ile nowych kanałów można jeszcze otworzyć do ponownego uruchomienia), transmisja tej przeglądarki i powód ostatniego zatrzymania"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/video</code>: setările video ca în Setări &gt; Video: rezoluțiile, frecvențele fiecărei rezoluții (cu <code>auto</code> = automat după canal), culorile HDMI, <code>zapmode</code> (ce se vede la schimbarea canalului) și încercarea în curs"
msgstr "<code>GET /api/video</code>: ustawienia wideo jak w Ustawienia &gt; Wideo: rozdzielczości, częstotliwości każdej rozdzielczości (z <code>auto</code> = automatycznie według kanału), kolory HDMI, <code>zapmode</code> (co widać przy zmianie kanału) i trwająca próba"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: schimbă canalul"
msgstr "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: zmienia kanał"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/accel-reporneste</code>: repornește interfața (enigma2)"
msgstr "<code>POST /api/accel-reporneste</code>: uruchamia ponownie interfejs (enigma2)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/accel-seteaza?pornita=0|1</code>: pornește sau oprește accelerarea de la următoarea pornire a interfeței (refuzat pe un receptor fără accelerarea 2D)"
msgstr "<code>POST /api/accel-seteaza?pornita=0|1</code>: włącza lub wyłącza akcelerację od następnego uruchomienia interfejsu (odrzucane w odbiorniku bez akceleracji 2D)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</code> ca în <code>GET /api/acces-conditionat</code>): pornește comanda prin scriptul modulului, pe rând, una singură deodată (și cu televizorul); rezultatul vine prin <code>GET /api/acces-conditionat</code>"
msgstr "<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</code> jak w <code>GET /api/acces-conditionat</code>): uruchamia polecenie przez skrypt modułu, po kolei, tylko jedno naraz (także z telewizorem); wynik przychodzi przez <code>GET /api/acces-conditionat</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-adauga</code> (corp: <code>cheie=</code>), <code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?amprenta=SHA256:..&amp;confirmat=1</code>: cheile publice lipite, cele din dosarul hdsatelit/ssh de pe stick, ștergerea unei chei"
msgstr "<code>POST /api/acces-ssh-adauga</code> (treść: <code>cheie=</code>), <code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?amprenta=SHA256:..&amp;confirmat=1</code>: wklejone klucze publiczne, klucze z folderu hdsatelit/ssh na pendrivie, usuwanie klucza"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</code> cere și <code>confirmat=1</code>): „Fără parolă în rețeaua locală”. Parola, textul brut și toate schimbările merg numai dintr-un browser conectat cu codul de pe televizor (altfel 403 cu <code>trebuie_cod</code>), niciodată cu <code>?token=</code>; cât ecranul „Acces SSH” e deschis pe televizor, la fel <code>/api/remotecontrol</code> și <code>/api/screenshot</code>"
msgstr "<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</code> wymaga też <code>confirmat=1</code>): „Bez hasła w sieci lokalnej”. Hasło, surowy tekst i wszystkie zmiany działają tylko z przeglądarki połączonej kodem z telewizora (inaczej 403 z <code>trebuie_cod</code>), nigdy z <code>?token=</code>; dopóki ekran „Dostęp SSH” jest otwarty na telewizorze, tak samo <code>/api/remotecontrol</code> i <code>/api/screenshot</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/acces-ssh-ascunde</code>: o parolă nouă; „Am notat parola” (textul parolei se șterge de pe receptor, parola rămâne)"
msgstr "<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/acces-ssh-ascunde</code>: nowe hasło; „Zanotowałem hasło” (tekst hasła jest usuwany z odbiornika, hasło pozostaje)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-parola</code>: textul parolei, cât timp nu a fost ascunsă; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: fișierele serverului SSH ca text (fără /etc/shadow)"
msgstr "<code>POST /api/acces-ssh-parola</code>: tekst hasła, dopóki nie zostało ukryte; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: pliki serwera SSH jako tekst (bez /etc/shadow)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: salvează și aplică pe loc (oricare dintre ele); <code>previzualizare=1&amp;lista=...</code> arată lista pe afișaj fără salvare (cel mult 2 minute fără o cerere nouă), <code>previzualizare=0</code> revine; <code>minutar=0|1..120</code> și <code>cronometru=porneste|opreste|zero</code> pornesc ceasurile afișajului pe loc; <code>functionare=ora|canal|stins</code> merge ca înainte"
msgstr "<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: zapisuje i od razu stosuje (dowolne z nich); <code>previzualizare=1&amp;lista=...</code> pokazuje listę na wyświetlaczu bez zapisywania (najwyżej 2 minuty bez nowego żądania), <code>previzualizare=0</code> przywraca poprzedni stan; <code>minutar=0|1..120</code> i <code>cronometru=porneste|opreste|zero</code> od razu uruchamiają zegary wyświetlacza; <code>functionare=ora|canal|stins</code> działa jak wcześniej"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</code>: salvează reglajele unui profil (multipli de 5); cu <code>incearca=1</code> se văd pe loc fără să se salveze, <code>renunta=1</code> pune înapoi ce e salvat; <code>POST /api/calitate-imagine-implicite?profil=&lt;profil&gt;|toate</code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|hdr10|hlg|none</code> (canalul pornește din nou, întrebarea apare pe televizor); <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;&amp;pornit=0|1</code> (jumătate de ecran, 60 s)"
msgstr "<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</code>: zapisuje ustawienia profilu (wielokrotności 5); z <code>incearca=1</code> widać je od razu bez zapisywania, <code>renunta=1</code> przywraca to, co zapisane; <code>POST /api/calitate-imagine-implicite?profil=&lt;profil&gt;|toate</code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|hdr10|hlg|none</code> (kanał uruchamia się ponownie, pytanie pojawia się na telewizorze); <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;&amp;pornit=0|1</code> (pół ekranu, 60 s)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: pornește canalul prin lista de pe televizor"
msgstr "<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: uruchamia kanał przez listę na telewizorze"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: deschide pe televizor un rezultat al căutării, cu rândul găsit ales"
msgstr "<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: otwiera na telewizorze wynik wyszukiwania, z zaznaczonym znalezionym wierszem"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza-opreste</code>: oprește citirea și revine la canalul de dinainte"
msgstr "<code>POST /api/cautare-actualizeaza-opreste</code>: zatrzymuje odczyt i wraca do poprzedniego kanału"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza-sari</code>: sare peste satelitul pe care e antena acum și trece la următorul (tasta GALBEN de pe televizor)"
msgstr "<code>POST /api/cautare-actualizeaza-sari</code>: pomija satelitę, na który jest teraz skierowana antena, i przechodzi do następnego (przycisk ŻÓŁTY na telewizorze)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: întrebarea (durata, motorul); cu <code>confirmat=1</code> pornește pe televizor citirea pistelor, transponder cu transponder"
msgstr "<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: pytanie (czas trwania, silnik); z <code>confirmat=1</code> uruchamia na telewizorze odczyt ścieżek, transponder po transponderze"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: citirea pistelor în timpul vizionării (oprită, numai canalul privit, tot transponderul), aceeași setare ca pe televizor"
msgstr "<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: odczyt ścieżek podczas oglądania (wyłączony, tylko oglądany kanał, cały transponder), to samo ustawienie co na telewizorze"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;&amp;fus=&lt;fus orar&gt;</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>/api/ceas</code>)"
msgstr "<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;&amp;fus=&lt;fus orar&gt;</code>: zmienia i zapisuje dowolne z nich (dokładne wartości są w <code>/api/ceas</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ceas-sincronizeaza</code>: o sincronizare a orei prin Internet, acum"
msgstr "<code>POST /api/ceas-sincronizeaza</code>: jednorazowa synchronizacja czasu przez Internet, teraz"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/copie-setari-pune?copie=&lt;id&gt;</code> (repornește interfața; copia se pune la loc înainte să pornească), <code>POST /api/copie-setari-sterge?copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"
msgstr "<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/copie-setari-pune?copie=&lt;id&gt;</code> (restartuje interfejs; kopia jest przywracana przed uruchomieniem), <code>POST /api/copie-setari-sterge?copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|invata|sterge&amp;flux=..</code>: actualizează lista, reface buchetele, învață posturile unui flux, șterge un flux adăugat de mână"
msgstr "<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|invata|sterge&amp;flux=..</code>: aktualizuje listę, odtwarza bukiety, uczy się stacji strumienia, usuwa strumień dodany ręcznie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;emisfera=E|V&amp;frecventa=..&amp;...</code>: un flux adăugat de mână, cu aceleași câmpuri și limite ca „Adaugă manual”"
msgstr "<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;emisfera=E|V&amp;frecventa=..&amp;...</code>: strumień dodany ręcznie, z tymi samymi polami i limitami co „Dodaj ręcznie”"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-seteaza?cheie=tasta|dosar|latime|nedecodabile&amp;valoare=..</code>: setările ferestrei, aceleași ca pe televizor"
msgstr "<code>POST /api/dabt2-seteaza?cheie=tasta|dosar|latime|nedecodabile&amp;valoare=..</code>: ustawienia okna, takie same jak na telewizorze"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-televizor?fel=dab|t2</code>: deschide fereastra pe televizor"
msgstr "<code>POST /api/dabt2-televizor?fel=dab|t2</code>: otwiera okno na telewizorze"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ecran-negru-fapta?fapta=&lt;id&gt;|ascunde</code>: fapta mesajului de acum, pe televizor, sau ascunderea lui"
msgstr "<code>POST /api/ecran-negru-fapta?fapta=&lt;id&gt;|ascunde</code>: akcja bieżącego komunikatu na telewizorze lub jego ukrycie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ecran-sterge?sursa=galerie|propriu&amp;id=..</code>, <code>POST /api/ecran-la-loc</code>: șterge un ecran de pornire din galerie (nu cel din fabrică și nici cel pus) sau pune la loc ecranele șterse"
msgstr "<code>POST /api/ecran-sterge?sursa=galerie|propriu&amp;id=..</code>, <code>POST /api/ecran-la-loc</code>: usuwa ekran startowy z galerii (ani fabryczny, ani ustawiony) lub przywraca usunięte ekrany"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/filme-comanda?fa=pauza|redare|inainte|inapoi</code>, <code>?fa=salt&amp;secunde=-60</code>, <code>?fa=la&amp;secunde=N</code>, <code>POST /api/filme-seteaza?pornire=&amp;oprire=&amp;sfarsit=</code>, <code>POST /api/filme-porneste?cale=..&amp;de_la=loc|inceput</code>: aceleași comenzi ca pe telecomandă în player și în lista de filme"
msgstr "<code>POST /api/filme-comanda?fa=pauza|redare|inainte|inapoi</code>, <code>?fa=salt&amp;secunde=-60</code>, <code>?fa=la&amp;secunde=N</code>, <code>POST /api/filme-seteaza?pornire=&amp;oprire=&amp;sfarsit=</code>, <code>POST /api/filme-porneste?cale=..&amp;de_la=loc|inceput</code>: te same polecenia co na pilocie w odtwarzaczu i na liście filmów"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/fonturi-descarca?familie=&lt;Familia&gt;&amp;mare=1</code>: descarcă, verifică și înregistrează un font"
msgstr "<code>POST /api/fonturi-descarca?familie=&lt;Familia&gt;&amp;mare=1</code>: pobiera, sprawdza i rejestruje czcionkę"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/fonturi-sterge?alias=&lt;NumeInSkin&gt;</code>: șterge un font descărcat"
msgstr "<code>POST /api/fonturi-sterge?alias=&lt;NumeInSkin&gt;</code>: usuwa pobraną czcionkę"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/gasire-semnal-porneste</code>, <code>-reacordeaza</code>, <code>-opreste</code>: pornește, acordează din nou sau oprește măsurarea"
msgstr "<code>POST /api/gasire-semnal-porneste</code>, <code>-reacordeaza</code>, <code>-opreste</code>: uruchamia, ponownie dostraja lub zatrzymuje pomiar"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ghid-temporizator?ref=&amp;id=&amp;fel=inregistrare|comutare|scoate</code>: pune sau scoate înregistrarea unei emisiuni (409 la suprapunere)"
msgstr "<code>POST /api/ghid-temporizator?ref=&amp;id=&amp;fel=inregistrare|comutare|scoate</code>: ustawia lub usuwa nagrywanie audycji (409 przy nakładaniu się)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/import-alta-imagine?raspuns=da|nu|ascunde</code>: răspunsul la întrebarea de la prima pornire (canalele și setările din altă imagine, găsite pe stick sau disc); starea în <code>/api/import-surse</code> (<code>alta_imagine</code>)"
msgstr "<code>POST /api/import-alta-imagine?raspuns=da|nu|ascunde</code>: odpowiedź na pytanie z pierwszego uruchomienia (kanały i ustawienia z innego obrazu, znalezione na pendrivie lub dysku); stan w <code>/api/import-surse</code> (<code>alta_imagine</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;temporizatoare=0&amp;generale=0</code>: pornește importul (întâi copia de siguranță)"
msgstr "<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;temporizatoare=0&amp;generale=0</code>: uruchamia import (najpierw kopia zapasowa)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: schimbă limba meniurilor și o salvează, ca OK în ecranul limbii de pe televizor"
msgstr "<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: zmienia język menu i go zapisuje, jak OK na ekranie języka na telewizorze"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>/api/limbi</code>; <code>tradu_orice</code> = „Tradu automat din orice subtitrare disponibilă”, contează cu traducerea subtitrărilor pornită) și le aplică pe canalul de acum"
msgstr "<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</code>: zmienia i zapisuje dowolne z nich (dokładne wartości są w <code>/api/limbi</code>; <code>tradu_orice</code> = „Tłumacz automatycznie z dowolnych dostępnych napisów”, ma znaczenie przy włączonym tłumaczeniu napisów) i stosuje je na bieżącym kanale"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /api/limbi-uita-toate?confirmat=1</code>: uită alegerile de mână ale unui canal sau ale tuturor"
msgstr "<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /api/limbi-uita-toate?confirmat=1</code>: zapomina ręczne wybory jednego kanału lub wszystkich"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-aplica</code>: aplică planul văzut (<code>semn=</code>), verifică semnalul și așteaptă răspunsul 60 de secunde"
msgstr "<code>POST /api/lnb-aplica</code>: stosuje wyświetlony plan (<code>semn=</code>), sprawdza sygnał i czeka na odpowiedź 60 sekund"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-plan</code>: ce s-ar schimba pentru câmpurile trimise (<code>l_&lt;lnb&gt;_&lt;câmp&gt;</code>), sau pentru „Ce era înainte” cu <code>fel=inainte</code>; nu scrie nimic"
msgstr "<code>POST /api/lnb-plan</code>: co by się zmieniło dla wysłanych pól (<code>l_&lt;lnb&gt;_&lt;câmp&gt;</code>) lub dla „Co było wcześniej” z <code>fel=inainte</code>; niczego nie zapisuje"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code>: răspunsul la „Păstrezi noile setări?”"
msgstr "<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code>: odpowiedź na „Zachować nowe ustawienia?”"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</code>: locul antenei aflat după adresa de internet a receptorului, de serverul HD Satelit, numai la cerere și numai din browserul conectat; se scrie abia după confirmare, cu <code>POST /api/locul-seteaza</code> și <code>internet=&lt;semn&gt;</code>"
msgstr "<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</code>: lokalizacja anteny ustalona przez serwer HD Satelit na podstawie adresu internetowego odbiornika, tylko na żądanie i tylko z połączonej przeglądarki; zapisywana dopiero po potwierdzeniu, przez <code>POST /api/locul-seteaza</code> i <code>internet=&lt;semn&gt;</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/locul-seteaza</code>: locul antenei din tabel (<code>tara</code>, <code>oras</code>) sau scris (<code>lat</code>, <code>lon</code>, grade, nord și est pozitive)"
msgstr "<code>POST /api/locul-seteaza</code>: lokalizacja anteny z tabeli (<code>tara</code>, <code>oras</code>) lub wpisana (<code>lat</code>, <code>lon</code>, stopnie, północ i wschód dodatnie)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: deschide pe televizor ecranul unei intrări (nu oprirea sau repornirea)"
msgstr "<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: otwiera na telewizorze ekran danej pozycji (bez wyłączania ani ponownego uruchamiania)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code>: pas, mișcare fără oprire, poziții memorate, mergi la satelit, limite, oprire"
msgstr "<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code>: krok, ruch ciągły, zapamiętane pozycje, idź do satelity, limity, zatrzymanie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-inchide</code>: navigatorul pe televizor"
msgstr "<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-inchide</code>: przeglądarka na telewizorze"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/navigator-text</code>: text trimis în câmpul ales pe televizor; numai din browserul asociat, cu textul în corpul cererii (cu <code>?token=</code> se refuză)"
msgstr "<code>POST /api/navigator-text</code>: tekst wysyłany do wybranego pola na telewizorze; tylko z powiązanej przeglądarki, z tekstem w treści żądania (z <code>?token=</code> jest odrzucane)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: descarcă modelul unei limbi (pe stick sau disc; în memoria internă numai cu intern=1)"
msgstr "<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: pobiera model języka (na pendrive lub dysk; do pamięci wewnętrznej tylko z intern=1)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-intreaba</code>: receptorul întreabă din nou pentru limbile cu \"Nu mai întreba\""
msgstr "<code>POST /api/ocr-limbi-intreaba</code>: odbiornik ponownie pyta o języki oznaczone „Nie pytaj więcej”"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-opreste?model=slk</code>: oprește descărcarea"
msgstr "<code>POST /api/ocr-limbi-opreste?model=slk</code>: zatrzymuje pobieranie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-sterge?model=slk</code>: șterge un model descărcat (sau îl scoate din listă când stickul lui nu e pus)"
msgstr "<code>POST /api/ocr-limbi-sterge?model=slk</code>: usuwa pobrany model (lub usuwa go z listy, gdy jego pendrive nie jest podłączony)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</code>: repornirea interfeței când nu mai răspunde și așteptarea dinaintea ei"
msgstr "<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</code>: ponowne uruchomienie interfejsu, gdy przestaje odpowiadać, i czas oczekiwania przed nim"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/procesor-seteaza?mod=automat|racoros|normal|performanta</code>: salvează modul și îl aplică pe loc"
msgstr "<code>POST /api/procesor-seteaza?mod=automat|racoros|normal|performanta</code>: zapisuje tryb i od razu go stosuje"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=..&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</code>: setările ecranului radio"
msgstr "<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=..&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</code>: ustawienia ekranu radia"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: vizualizarea sau culorile următoare (ca tastele galbenă și albastră pe ecranul radio)"
msgstr "<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: następna wizualizacja lub następne kolory (jak żółty i niebieski przycisk na ekranie radia)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-fluxuri</code>: alegerea de la sfârșitul scanării DAB+ / DVB-T2 de pe televizor (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"
msgstr "<code>POST /api/scanare-fluxuri</code>: wybór na końcu skanowania DAB+ / DVB-T2 na telewizorze (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-opreste</code>: oprește căutarea sau închide rezultatul rămas pe televizor"
msgstr "<code>POST /api/scanare-opreste</code>: zatrzymuje wyszukiwanie lub zamyka wynik pozostały na telewizorze"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;&amp;...</code>: pornește căutarea pe televizor (cu <code>confirmat=1</code> după o întrebare)"
msgstr "<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;&amp;...</code>: uruchamia wyszukiwanie na telewizorze (z <code>confirmat=1</code> po pytaniu)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: deschide pe televizor ecranul unei intrări din cele două secțiuni"
msgstr "<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: otwiera na telewizorze ekran pozycji z jednej z dwóch sekcji"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/setari-din-copie-reporneste</code>: repornește interfața, ca setările importate să se unească"
msgstr "<code>POST /api/setari-din-copie-reporneste</code>: ponownie uruchamia interfejs, aby zaimportowane ustawienia zostały scalone"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/setari-seteaza?id=&lt;cheie&gt;&amp;r&lt;N&gt;=&lt;valoare&gt;</code>: schimbă și salvează rândurile trimise (o valoare greșită nu schimbă nimic; la o alegere multiplă, ca vitezele de derulare, alegerile despărțite prin virgulă, de pildă <code>r20=2,8,16</code>; gol = nicio alegere)"
msgstr "<code>POST /api/setari-seteaza?id=&lt;cheie&gt;&amp;r&lt;N&gt;=&lt;valoare&gt;</code>: zmienia i zapisuje wysłane wiersze (błędna wartość niczego nie zmienia; przy wyborze wielokrotnym, jak prędkości przewijania, wybory oddzielone przecinkami, np. <code>r20=2,8,16</code>; puste = brak wyboru)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/stocare-foloseste?punct=/media/usb</code>: folosește discul pentru înregistrări (face dosarul movie, fără formatare)"
msgstr "<code>POST /api/stocare-foloseste?punct=/media/usb</code>: używa dysku do nagrań (tworzy folder movie, bez formatowania)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-aspect-implicite</code>: toate înapoi la valorile de la început"
msgstr "<code>POST /api/subtitrari-aspect-implicite</code>: wszystko z powrotem do wartości początkowych"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-aspect-seteaza?stil_font=&lt;skin|ingust|tiresias_info|tiresias_pc|google:Alias&gt;&amp;grosime=&lt;automata|normala|ingrosata|foarte_ingrosata&gt;&amp;marime=&lt;60..200&gt;&amp;culoare=&lt;emisiune|%23rrggbb&gt;&amp;contur=&lt;fara|subtire|normal|gros|foarte_gros&gt;&amp;culoare_contur=&lt;%23rrggbb&gt;&amp;umbra=0|1&amp;culoare_umbra=&lt;%23rrggbb&gt;&amp;directie_umbra=&lt;sus|sus_dreapta|dreapta|jos_dreapta|jos|jos_stanga|stanga|sus_stanga&gt;&amp;distanta_umbra=&lt;50|100|150|200|300&gt;&amp;umbra_moale=&lt;tare|moale|foarte_moale&gt;&amp;fundal=&lt;niciunul|rand|cutie&gt;&amp;culoare_fundal=&lt;%23rrggbb&gt;&amp;opacitate_fundal=&lt;10..100&gt;&amp;jos=&lt;2..25&gt;&amp;spatiere=&lt;80|90|100|110|125|150&gt;&amp;marire_dvb=&lt;clara|ocr&gt;</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>alegeri</code>; o valoare greșită nu schimbă nimic); sau <code>stil=&lt;cheie&gt;</code>, un stil gata făcut"
msgstr "<code>POST /api/subtitrari-aspect-seteaza?stil_font=&lt;skin|ingust|tiresias_info|tiresias_pc|google:Alias&gt;&amp;grosime=&lt;automata|normala|ingrosata|foarte_ingrosata&gt;&amp;marime=&lt;60..200&gt;&amp;culoare=&lt;emisiune|%23rrggbb&gt;&amp;contur=&lt;fara|subtire|normal|gros|foarte_gros&gt;&amp;culoare_contur=&lt;%23rrggbb&gt;&amp;umbra=0|1&amp;culoare_umbra=&lt;%23rrggbb&gt;&amp;directie_umbra=&lt;sus|sus_dreapta|dreapta|jos_dreapta|jos|jos_stanga|stanga|sus_stanga&gt;&amp;distanta_umbra=&lt;50|100|150|200|300&gt;&amp;umbra_moale=&lt;tare|moale|foarte_moale&gt;&amp;fundal=&lt;niciunul|rand|cutie&gt;&amp;culoare_fundal=&lt;%23rrggbb&gt;&amp;opacitate_fundal=&lt;10..100&gt;&amp;jos=&lt;2..25&gt;&amp;spatiere=&lt;80|90|100|110|125|150&gt;&amp;marire_dvb=&lt;clara|ocr&gt;</code>: zmienia i zapisuje dowolne z nich (dokładne wartości są w <code>alegeri</code>; błędna wartość niczego nie zmienia); lub <code>stil=&lt;cheie&gt;</code>, gotowy styl"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-film-alege?id=&lt;id&gt;|oprit</code>, <code>POST /api/subtitrari-film-intarziere?ms=N</code> (sau <code>pas=</code>), <code>POST /api/subtitrari-film-codare?cod=..</code>, <code>POST /api/subtitrari-film-fps?fps=..</code>: aceleași alegeri ca tasta SUB la un film din fișier"
msgstr "<code>POST /api/subtitrari-film-alege?id=&lt;id&gt;|oprit</code>, <code>POST /api/subtitrari-film-intarziere?ms=N</code> (lub <code>pas=</code>), <code>POST /api/subtitrari-film-codare?cod=..</code>, <code>POST /api/subtitrari-film-fps?fps=..</code>: te same wybory co przycisk SUB przy filmie z pliku"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-ocr-zero</code>: contorul recunoașterii textului pus la zero"
msgstr "<code>POST /api/subtitrari-ocr-zero</code>: zerowanie licznika rozpoznawania tekstu"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/sunet-seteaza?iesire=&lt;auto|manual&gt;&amp;ac3=&lt;da|nu&gt;&amp;dts=&lt;da|nu&gt;&amp;pista=&lt;da|nu&gt;</code>: oricare dintre ele, salvate; ac3 / dts sunt setările pentru Manual"
msgstr "<code>POST /api/sunet-seteaza?iesire=&lt;auto|manual&gt;&amp;ac3=&lt;da|nu&gt;&amp;dts=&lt;da|nu&gt;&amp;pista=&lt;da|nu&gt;</code>: dowolne z nich, zapisywane; ac3 / dts to ustawienia dla trybu Manual"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-asociere?pas=inapoi|sari|gata|continua|anuleaza|proba|inchide&amp;pastreaza=0|1</code>: pașii asocierii unei telecomenzi noi"
msgstr "<code>POST /api/telecomenzi-asociere?pas=inapoi|sari|gata|continua|anuleaza|proba|inchide&amp;pastreaza=0|1</code>: kroki parowania nowego pilota"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|oprit</code>: pornește sau oprește captura paginii (cititorul și proba numai ascultă, cel mult 2 minute)"
msgstr "<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|oprit</code>: uruchamia lub zatrzymuje przechwytywanie przez stronę (czytnik i test tylko nasłuchują, maksymalnie 2 minuty)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-schimba?actiune=activa|neasociate|redenumeste|sterge-tasta|sterge|sterge-tot&amp;id=..&amp;cod=..&amp;nume=..&amp;confirmat=1</code>: aceleași schimbări ca în lista de pe televizor"
msgstr "<code>POST /api/telecomenzi-schimba?actiune=activa|neasociate|redenumeste|sterge-tasta|sterge|sterge-tot&amp;id=..&amp;cod=..&amp;nume=..&amp;confirmat=1</code>: te same zmiany co na liście na telewizorze"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/teletext-salveaza</code>, <code>POST /api/teletext-sterge?ref=</code>, <code>POST /api/teletext-reimprospateaza?ref=</code> (receptorul trece pe canal, așteaptă o trecere completă a teletextului, face copia și se întoarce la canalul de dinainte; răspunde pe loc), <code>POST /api/teletext-setari?hd=0|1&amp;contur=0|1&amp;umbra=0|1&amp;relief=0|1&amp;copie_automata=0|1&amp;spatiu=5|10|20|50|100</code> (<code>hd</code> = Teletext neted): aceleași alegeri ca meniul teletextului de pe televizor"
msgstr "<code>POST /api/teletext-salveaza</code>, <code>POST /api/teletext-sterge?ref=</code>, <code>POST /api/teletext-reimprospateaza?ref=</code> (odbiornik przełącza na kanał, czeka na pełny przebieg telegazety, robi kopię i wraca do poprzedniego kanału; odpowiada od razu), <code>POST /api/teletext-setari?hd=0|1&amp;contur=0|1&amp;umbra=0|1&amp;relief=0|1&amp;copie_automata=0|1&amp;spatiu=5|10|20|50|100</code> (<code>hd</code> = Wygładzona telegazeta): te same wybory co w menu telegazety na telewizorze"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-adauga?ref=&lt;canal&gt;&amp;zi=AAAA-LL-ZZ&amp;inceput=HH:MM&amp;sfarsit=HH:MM&amp;nume=..&amp;doar_comuta=0|1</code>: pune o înregistrare (sau doar schimbarea canalului); la suprapunere nu pune nimic și spune cu ce se suprapune"
msgstr "<code>POST /api/temporizatoare-adauga?ref=&lt;canal&gt;&amp;zi=AAAA-LL-ZZ&amp;inceput=HH:MM&amp;sfarsit=HH:MM&amp;nume=..&amp;doar_comuta=0|1</code>: ustawia nagranie (lub tylko przełączenie kanału); gdy coś się nakłada, nie ustawia nic i podaje, z czym się nakłada"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-modifica?id=..&amp;zi=..&amp;inceput=..&amp;sfarsit=..&amp;repetare=o_data|zilnic|luni_vineri|zile&amp;zile=0,1,..&amp;dupa=nimic|asteptare|oprire|automat&amp;loc=..</code>: aceleași câmpuri ca fereastra de pe televizor, cu aceeași verificare a suprapunerii; <code>POST /api/temporizatoare-opreste?id=..&amp;alegere=stoponlycurrent|stopall|stoponlycoming</code>: una repetată care merge acum"
msgstr "<code>POST /api/temporizatoare-modifica?id=..&amp;zi=..&amp;inceput=..&amp;sfarsit=..&amp;repetare=o_data|zilnic|luni_vineri|zile&amp;zile=0,1,..&amp;dupa=nimic|asteptare|oprire|automat&amp;loc=..</code>: te same pola co okno na telewizorze, z tym samym sprawdzaniem nakładania się; <code>POST /api/temporizatoare-opreste?id=..&amp;alegere=stoponlycurrent|stopall|stoponlycoming</code>: powtarzany, który trwa teraz"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, <code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, <code>POST /api/temporizatoare-curata?confirmat=1</code>: șterge una, o oprește sau o pornește din nou, șterge cele terminate"
msgstr "<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, <code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, <code>POST /api/temporizatoare-curata?confirmat=1</code>: usuwa jeden, wyłącza go lub włącza ponownie, usuwa zakończone"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-cauta</code>: caută în rețeaua de acasă serverele Ollama (11434) și LibreTranslate (5000); rezultatul vine în <code>cautare</code>"
msgstr "<code>POST /api/traducere-configurare-cauta</code>: szuka w sieci domowej serwerów Ollama (11434) i LibreTranslate (5000); wynik pojawia się w <code>cautare</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-cheie</code>, corpul <code>cheie=&lt;cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: probează cheia pe loc și, dacă merge, o salvează și pornește traducerea; numai în corpul cererii, niciodată în adresă; rezultatul vine în <code>configurare</code> din <code>GET /api/traducere-configurare</code>"
msgstr "<code>POST /api/traducere-configurare-cheie</code>, treść <code>cheie=&lt;cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: od razu testuje klucz i, jeśli działa, zapisuje go i włącza tłumaczenie; tylko w treści żądania, nigdy w adresie; wynik pojawia się w <code>configurare</code> z <code>GET /api/traducere-configurare</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-model?model=..</code>: alt model pentru serviciul ales acum, cu probă"
msgstr "<code>POST /api/traducere-configurare-model?model=..</code>: inny model dla obecnie wybranej usługi, z testem"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;&amp;adresa=..&amp;model=..</code>: folosește serverul din casă (adresa completată de receptor, modelul ales singur dacă lipsește) și îl probează"
msgstr "<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;&amp;adresa=..&amp;model=..</code>: używa domowego serwera (adres uzupełnia odbiornik, model wybierany sam, jeśli go brak) i go testuje"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-cheie</code>, corpul <code>serviciu=&lt;cod&gt;&amp;cheie=&lt;cheia&gt;</code>: pune cheia unui serviciu (goală = o șterge); la <code>serviciu=propriu</code> cheia este valoarea antetului adresei proprii (de exemplu <code>Bearer</code> și cheia); numai în corpul cererii, niciodată în adresă; răspunsul spune doar care serviciu are cheie"
msgstr "<code>POST /api/traducere-subtitrari-cheie</code>, treść <code>serviciu=&lt;cod&gt;&amp;cheie=&lt;cheia&gt;</code>: ustawia klucz usługi (pusty = usuwa go); przy <code>serviciu=propriu</code> klucz jest wartością nagłówka własnego adresu (na przykład <code>Bearer</code> i klucz); tylko w treści żądania, nigdy w adresie; odpowiedź podaje tylko, która usługa ma klucz"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-proba</code>: probează traducerea cu serviciul ales; rezultatul vine în <code>stare.proba</code> din <code>GET /api/traducere-subtitrari</code>"
msgstr "<code>POST /api/traducere-subtitrari-proba</code>: testuje tłumaczenie wybraną usługą; wynik pojawia się w <code>stare.proba</code> z <code>GET /api/traducere-subtitrari</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=..&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;propriu_cale=..</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>alegeri</code>); o valoare greșită refuză tot. Adresa proprie: adresa e un șablon cu <code>{text}</code>, <code>{sursa}</code>, <code>{tinta}</code> (http:// numai pentru un server din rețeaua de acasă); adresa receptorului însuși (127.0.0.1, localhost, IP-ul lui) e refuzată, și la <code>adresa_libre</code> și <code>adresa_openai</code>; calea în JSON are chei și numere despărțite prin punct, <code>*</code> = toate elementele"
msgstr "<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=..&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;propriu_cale=..</code>: zmienia i zapisuje dowolne z nich (dokładne wartości są w <code>alegeri</code>); jedna błędna wartość odrzuca wszystko. Własny adres: adres jest szablonem z <code>{text}</code>, <code>{sursa}</code>, <code>{tinta}</code> (http:// tylko dla serwera w sieci domowej); adres samego odbiornika (127.0.0.1, localhost, jego IP) jest odrzucany, również przy <code>adresa_libre</code> i <code>adresa_openai</code>; ścieżka w JSON ma klucze i liczby oddzielone kropką, <code>*</code> = wszystkie elementy"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-zero</code>: contorul traducerii pus la zero"
msgstr "<code>POST /api/traducere-subtitrari-zero</code>: licznik tłumaczenia wyzerowany"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: fluxul TS al transmisiei acestui browser. Pornirea și fluxul merg numai din browserul conectat, cu antetul <code>X-HDS-CSRF</code>, niciodată cu <code>?token=</code>"
msgstr "<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: strumień TS transmisji tej przeglądarki. Uruchamianie i strumień działają tylko z połączonej przeglądarki, z nagłówkiem <code>X-HDS-CSRF</code>, nigdy z <code>?token=</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-confirma</code> și <code>POST /api/video-revino</code>: păstrează modul încercat sau revine la cel de dinainte"
msgstr "<code>POST /api/video-confirma</code> i <code>POST /api/video-revino</code>: zachowuje wypróbowany tryb lub wraca do poprzedniego"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-reporneste</code>: repornește receptorul (culorile „Ca la calculator” se aplică numai după o repornire); cu o înregistrare în curs, întrebarea apare pe televizor"
msgstr "<code>POST /api/video-reporneste</code>: uruchamia ponownie odbiornik (kolory „Jak w komputerze” są stosowane dopiero po ponownym uruchomieniu); gdy trwa nagranie, pytanie pojawia się na telewizorze"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=..&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;ycbcr|rgb&gt;</code>: un mod nou se încearcă (aceeași întrebare pe televizor, 20 s, fără răspuns revine); zapmode se salvează direct; culori_hdmi=ycbcr se încearcă la fel (aceeași întrebare), rgb se salvează și se aplică după o repornire"
msgstr "<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=..&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;ycbcr|rgb&gt;</code>: nowy tryb jest wypróbowywany (to samo pytanie na telewizorze, 20 s, bez odpowiedzi wraca); zapmode zapisuje się od razu; culori_hdmi=ycbcr jest wypróbowywane tak samo (to samo pytanie), rgb zapisuje się i jest stosowane po ponownym uruchomieniu"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<p class=\"gol\">Niciun font descărcat încă.</p>"
msgstr "<p class=\"gol\">Nie pobrano jeszcze żadnej czcionki.</p>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<p class=\"gol\">Nimic găsit.</p>"
msgstr "<p class=\"gol\">Nic nie znaleziono.</p>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<span aria-hidden=\"true\">&#8595;</span> Descarcă playlist (M3U)"
msgstr "<span aria-hidden=\"true\">&#8595;</span> Pobierz playlistę (M3U)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<span aria-hidden=\"true\">&#9632;</span> Oprește live (înapoi la captură)"
msgstr "<span aria-hidden=\"true\">&#9632;</span> Zatrzymaj na żywo (powrót do zrzutu)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<span aria-hidden=\"true\">&#9654;</span> Privește live aici"
msgstr "<span aria-hidden=\"true\">&#9654;</span> Oglądaj na żywo tutaj"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<span class=\"mic\">descărcat</span>"
msgstr "<span class=\"mic\">pobrano</span>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<table><tr><th>Familia</th><th>Categorie</th><th>Diacritice</th><th>Familia întreagă</th><th></th></tr>"
msgstr "<table><tr><th>Rodzina</th><th>Kategoria</th><th>Znaki diakrytyczne</th><th>Cała rodzina</th><th></th></tr>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<table><tr><th>Familia</th><th>Nume in skin</th><th>Mărime</th><th>Diacritice</th><th>Verificare</th><th></th></tr>"
msgstr "<table><tr><th>Rodzina</th><th>Nazwa w skórce</th><th>Rozmiar</th><th>Znaki diakrytyczne</th><th>Weryfikacja</th><th></th></tr>"

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "? Playerele care îl folosesc nu mai primesc canalele, iar adresa nu mai merge niciodată. Dacă îl vrei din nou, descarci alt playlist."
msgstr "? Odtwarzacze, które go używają, przestaną otrzymywać kanały, a adres nigdy więcej nie zadziała. Jeśli zechcesz go ponownie, pobierz inną playlistę."

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "? Un skin care îl folosește va rămâne fără el."
msgstr "? Skórka, która go używa, zostanie bez niego."

#: lib/python/Plugins/Extensions/HdsWebControl/disc_web.py
