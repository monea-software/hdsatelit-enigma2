#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Actualizează rapid"
msgstr "Szybka aktualizacja"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Un singur clic caută actualizarea, o instalează dacă există și repornește interfața."
msgstr "Jedno kliknięcie wyszukuje aktualizację, instaluje ją, jeśli jest, i uruchamia ponownie interfejs."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Pornești actualizarea rapidă? Dacă există o actualizare, se instalează, apoi interfața se repornește singură."
msgstr "Uruchomić szybką aktualizację? Jeśli jest aktualizacja, zostanie zainstalowana, a potem interfejs sam uruchomi się ponownie."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Caut actualizarea"
msgstr "Szukam aktualizacji"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
#, python-format
msgid "Instalez versiunea %s"
msgstr "Instaluję wersję %s"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Instalez actualizarea"
msgstr "Instaluję aktualizację"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Repornesc interfața"
msgstr "Uruchamiam ponownie interfejs"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Interfața repornește. Aștept să revină..."
msgstr "Interfejs uruchamia się ponownie. Czekam, aż wróci..."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
#, python-format
msgid "Actualizat la %s."
msgstr "Zaktualizowano do %s."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
#, python-format
msgid "Interfața a repornit cu versiunea %s, nu cu %s."
msgstr "Interfejs uruchomił się ponownie z wersją %s, a nie %s."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Interfața nu a revenit în 4 minute. Verifică receptorul."
msgstr "Interfejs nie wrócił w ciągu 4 minut. Sprawdź odbiornik."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Interfața nu s-a repornit. Apasă Repornește interfața."
msgstr "Interfejs nie uruchomił się ponownie. Naciśnij Uruchom ponownie interfejs."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea rapidă este deja în lucru."
msgstr "Szybka aktualizacja już trwa."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Interfața se repornește acum."
msgstr "Aktualizacja jest zainstalowana. Interfejs uruchamia się teraz ponownie."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Interfața se repornește singură după înregistrare."
msgstr "Aktualizacja jest zainstalowana. Interfejs sam uruchomi się ponownie po nagrywaniu."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Interfața se repornește singură după ce se termină lucrarea din fundal."
msgstr "Aktualizacja jest zainstalowana. Interfejs sam uruchomi się ponownie, gdy zakończy się zadanie w tle."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Pe televizor se așteaptă un răspuns la întrebarea de repornire."
msgstr "Aktualizacja jest zainstalowana. Na telewizorze czeka pytanie o ponowne uruchomienie."

#: lib/python/Components/HdsActualizari.py
msgid "Repornirea a fost refuzată pe televizor. Actualizarea se folosește după ce repornești interfața."
msgstr "Ponowne uruchomienie odrzucono na telewizorze. Aktualizacja zadziała po ponownym uruchomieniu interfejsu."


#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Tradu teletextul"
msgstr "Tłumacz telegazetę"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Teletextul tradus"
msgstr "Przetłumaczona telegazeta"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Tradu HbbTV"
msgstr "Tłumacz HbbTV"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Ce s-a tradus din teletext și HbbTV"
msgstr "Co przetłumaczono z telegazety i HbbTV"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "%s: texte traduse %d (%d semne trimise, din cota serviciului), cereri %d, deja în limba ta %d, sărite %d."
msgstr "%s: przetłumaczone teksty %d (%d wysłanych znaków, z limitu usługi), żądania %d, już w twoim języku %d, pominięte %d."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Traduce paginile de teletext pe care le deschizi (tasta TEXT) în limba traducerii, cu aceleași servicii și chei. Pagina apare întâi în original, apoi tradusă. În teletext, AUDIO arată originalul paginii, iar MENU are aceleași alegeri. Consumă din cota serviciului, de aceea din fabrică e oprită; un text tradus o dată nu se mai cere."
msgstr "Tłumaczy otwierane strony telegazety (przycisk TEXT) na język tłumaczenia, tymi samymi usługami i kluczami. Strona pojawia się najpierw w oryginale, potem przetłumaczona. W telegazecie AUDIO pokazuje oryginał strony, a MENU ma te same wybory. Zużywa limit usługi, dlatego fabrycznie jest wyłączone; raz przetłumaczony tekst nie jest wysyłany ponownie."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "În pagină: rândurile traduse iau locul celor originale, în cele 40 de coloane ale paginii, cu aceleași culori; ce nu încape se taie cu „…”. Într-un panou: pagina originală, mai mică, în stânga, și traducerea întreagă în dreapta."
msgstr "Na stronie: przetłumaczone wiersze zajmują miejsce oryginalnych, w 40 kolumnach strony, w tych samych kolorach; co się nie mieści, jest ucinane znakiem „…”. W panelu: oryginalna strona, mniejsza, po lewej i całe tłumaczenie po prawej."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Traduce textele văzute din aplicațiile HbbTV (tasta ROȘIE), ca „Traduce pagina” din browsere: numai textele de pe ecran, nu adresele, codul sau câmpurile de scris. Pagina apare întâi în original. Consumă din cota serviciului, de aceea din fabrică e oprită. Aplicațiile deschise pe https rămân deocamdată în original."
msgstr "Tłumaczy widoczne teksty aplikacji HbbTV (CZERWONY przycisk), jak „Przetłumacz stronę” w przeglądarkach: tylko teksty na ekranie, nie adresy, kod ani pola do pisania. Strona pojawia się najpierw w oryginale. Zużywa limit usługi, dlatego fabrycznie jest wyłączone. Aplikacje otwarte przez https na razie zostają w oryginale."

