msgstr[1] "Usunąć %d zdublowane wiersze z bukietów? Kanały zostają na liście odbiornika."
msgstr[2] "Usunąć %d zdublowanych wierszy z bukietów? Kanały zostają na liście odbiornika."

#: lib/python/Screens/HdsEditorCanaleUnelte.py
msgid "Repari %d rând? Cel cu un canal găsit se leagă la el, altfel se șterge din buchet."
msgid_plural "Repari %d rânduri? Cele cu un canal găsit se leagă la el, celelalte se șterg din buchet."
msgstr[0] "Naprawić %d wiersz? Jeśli znajdzie się kanał, zostanie z nim połączony, inaczej usunięty z bukietu."
msgstr[1] "Naprawić %d wiersze? Te ze znalezionym kanałem zostaną z nim połączone, pozostałe usunięte z bukietu."
msgstr[2] "Naprawić %d wierszy? Te ze znalezionym kanałem zostaną z nim połączone, pozostałe usunięte z bukietu."

