msgstr "Sprawdzanie tłumaczenia z %s..."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Proba a mers (%s, %s): %s"
msgstr "Próba się udała (%s, %s): %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Proba nu a mers: %s"
msgstr "Próba się nie udała: %s"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Atenție: la Google Cloud facturarea e obligatorie, Google îți cere cardul la înscriere. Peste cota gratuită plătești automat, din card."
msgstr "Uwaga: w Google Cloud rozliczenia są obowiązkowe, Google przy rejestracji prosi o twoją kartę. Powyżej darmowego limitu płacisz automatycznie, z karty."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Sub original, traducerea se scrie cu galben deschis, ca s-o deosebești de original."
msgstr "Pod oryginałem tłumaczenie jest pisane jasnożółtym kolorem, żebyś odróżnił je od oryginału."

#: lib/python/Screens/HdsSubtitrariAspect.py
msgid "Recunoașterea textului lucrează și acum: o cere traducerea subtitrărilor."
msgstr "Rozpoznawanie tekstu działa także teraz: potrzebuje go tłumaczenie napisów."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Se probează pe receptor: %s"
msgstr "Próba na odbiorniku: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Gata: %s merge. Proba: %s"
msgstr "Gotowe: %s działa. Próba: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Serverul e prea lent pentru subtitrări la timp. Alege un serviciu din "
"internet (Gemini, gratuit, fără card) sau un model mai mic."
msgstr "Serwer jest za wolny, by napisy przychodziły na czas. Wybierz usługę z internetu (Gemini, darmowa, bez karty) albo mniejszy model."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Nu a mers: %s"
msgstr "Nie udało się: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Scanează cu telefonul: pagina oficială"
msgstr "Zeskanuj telefonem: oficjalna strona"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Configurează de pe telefon"
msgstr "Skonfiguruj z telefonu"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Scanează codul cu camera telefonului. Se deschide pagina receptorului, deja "
"conectată: alegi serviciul, îți faci cheia și o lipești. Receptorul o "
"probează pe loc."
msgstr "Zeskanuj kod aparatem telefonu. Otworzy się strona odbiornika, już połączona: wybierasz usługę, robisz swój klucz i go wklejasz. Odbiornik od razu go sprawdza."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK sau Ieșire închide."
msgstr "OK lub EXIT zamyka."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Receptorul nu are legătură în rețea, deci pagina nu se poate deschide pe "
"telefon."
msgstr "Odbiornik nie ma połączenia z siecią, więc strony nie można otworzyć na telefonie."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Sau scrie în browser: %s\n"
