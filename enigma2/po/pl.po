msgid "Ce scriu testerii acestui receptor; scrii și tu, cu capturi."
msgstr "Co piszą testerzy tego odbiornika; ty też piszesz, ze zrzutami."

msgid "O greșeală, o idee sau o întrebare, direct echipei."
msgstr "Błąd, pomysł albo pytanie, prosto do zespołu."

msgid "Datele bifate pleacă imediat."
msgstr "Zaznaczone dane wysyłane są od razu."

msgid "Ultimele pachete plecate și starea fiecăruia."
msgstr "Ostatnio wysłane paczki i stan każdej z nich."

msgid "Ce ți-a răspuns echipa la mesaje."
msgstr "Co zespół odpowiedział na twoje wiadomości."

msgid "Alegi ce date pleacă, numele și e-mailul."
msgstr "Wybierasz, jakie dane są wysyłane, nazwę i e-mail."

msgid "Tot ce a plecat în ultimul pachet."
msgstr "Wszystko, co wyszło w ostatniej paczce."

msgid "Probe pe receptor: ce merge și ce nu."
msgstr "Testy na odbiorniku: co działa, a co nie."

msgid "Ne lași să vedem starea receptorului, cât alegi tu."
msgstr "Pozwalasz nam zobaczyć stan odbiornika, na tak długo, jak wybierzesz."

msgid "Versiunile noi ajung întâi la tine."
msgstr "Nowe wersje docierają najpierw do ciebie."

msgid "Numele cu care apari pe forum și pe site."
msgstr "Nazwa, pod którą występujesz na forum i na stronie."

msgid "Ce date pleacă, cine le primește, cât se păstrează."
msgstr "Jakie dane są wysyłane, kto je otrzymuje, jak długo są przechowywane."

msgid "Serverul șterge tot ce a trimis acest receptor."
msgstr "Serwer usuwa wszystko, co wysłał ten odbiornik."

msgid "Alegi ce date trimiți; sunt anonime."
msgstr "Wybierasz, jakie dane wysyłasz; są anonimowe."

msgid "Citește ce scriu testerii acestui receptor."
msgstr "Przeczytaj, co piszą testerzy tego odbiornika."

msgid "Primești versiunile noi înaintea tuturor"
msgstr "Dostajesz nowe wersje przed wszystkimi"

msgid "Din meniul testerului alegi să primești întâi versiunile pentru testeri."
msgstr "W menu testera wybierasz, aby najpierw dostawać wersje dla testerów."

msgid "Scrii pe forumul receptorului, cu capturi de ecran"
msgstr "Piszesz na forum odbiornika, ze zrzutami ekranu"

msgid "Forumul traduce singur mesajele pentru fiecare cititor."
msgstr "Forum samo tłumaczy wiadomości dla każdego czytelnika."

msgid "La o problemă, ne lași să ne uităm la receptor, cât vrei tu"
msgstr "Przy problemie pozwalasz nam zajrzeć do odbiornika, na tak długo, jak chcesz"

msgid "Asistența de la distanță: o pornești tu și o oprești oricând."
msgstr "Pomoc zdalna: sam ją uruchamiasz i w każdej chwili zatrzymujesz."

msgid "Imaginea merge mai bine pe modelul tău"
msgstr "Obraz działa lepiej na twoim modelu"

msgid "Trimiți date anonime, numai cele bifate de tine."
msgstr "Wysyłasz anonimowe dane, tylko te zaznaczone przez ciebie."

msgid "Echipa îți răspunde la mesaje"
msgstr "Zespół odpowiada na twoje wiadomości"

msgid "Greșeli, idei, întrebări: răspunsul vine în meniul testerului."
msgstr "Błędy, pomysły, pytania: odpowiedź przychodzi do menu testera."

msgid "Asistența de la distanță e pentru beta testeri."
msgstr "Pomoc zdalna jest dla betatesterów."

msgid "Ca beta tester trimiți date anonime care ajută imaginea și poți scrie pe forumul receptorului."
msgstr "Jako betatester wysyłasz anonimowe dane, które pomagają obrazowi, i możesz pisać na forum odbiornika."

msgid "Ești beta tester"
msgstr "Jesteś betatesterem"

msgid "Înscris din %s"
msgstr "Zapisany od %s"

msgid "Ce primești ca beta tester"
msgstr "Co dostajesz jako betatester"

msgid "Ultimele mesaje de pe forum"
msgstr "Najnowsze wiadomości z forum"

msgid "    răspuns: cod %d, %d octeți"
msgstr "    odpowiedź: kod wyjścia %d, bajtów: %d"

msgid "Asistența a pornit."
msgstr "Pomoc zdalna została uruchomiona."

msgid "Asistența nu merge."
msgstr "Pomoc zdalna nie działa."

msgid "Asistența s-a oprit. Cheia a fost ștearsă."
msgstr "Pomoc zdalna została zatrzymana. Klucz został usunięty."

msgid "cerere refuzată: %s"
msgstr "żądanie odrzucone: %s"

msgid "cod arătat pe ecran, aștept aprobarea"
msgstr "kod pokazany na ekranie, czekam na zatwierdzenie"

msgid "codul a expirat fără aprobare"
msgstr "kod wygasł bez zatwierdzenia"

msgid "nu pot ajunge la serverul de asistență"
msgstr "nie można połączyć się z serwerem pomocy zdalnej"

msgid "oprită (%s)"
msgstr "zatrzymana (%s)"

msgid "pornită (%s, nivel %s, %d minute, text v%d)"
msgstr "uruchomiona (%s, poziom %s, %d min, tekst v%d)"

msgid "probă"
msgstr "test"

msgid "reluată după repornirea interfeței"
msgstr "wznowiona po ponownym uruchomieniu interfejsu"

msgid "serverul a refuzat înregistrarea (%s)"
msgstr "serwer odrzucił rejestrację (%s)"

msgid "copie filtrată a setărilor (audio, video, interfață, rețea; fără parole și chei)"
msgstr "filtrowana kopia ustawień (audio, wideo, interfejs, sieć; bez haseł i kluczy)"

msgid "lista jurnalelor receptorului, cu mărimile"
msgstr "lista dzienników odbiornika, z rozmiarami"

msgid "lista proceselor (numele, fără argumente)"
msgstr "lista procesów (nazwy, bez argumentów)"

msgid "memoria liberă și memoria decodorului"
msgstr "wolna pamięć i pamięć dekodera"

msgid "o captură a ecranului (numai meniurile, fără imaginea canalului)"
msgstr "zrzut ekranu (tylko menu, bez obrazu kanału)"

msgid "placa: procesorul, linia de comandă a nucleului, partițiile, modulele încărcate"
msgstr "płyta: procesor, wiersz poleceń jądra, partycje, załadowane moduły"

msgid "rețeaua: cablu sau Wi-Fi, legat sau nu, ruta implicită, DNS (fără numele rețelei, MAC mascat)"
msgstr "sieć: kabel lub Wi-Fi, połączona czy nie, trasa domyślna, DNS (bez nazwy sieci, MAC zamaskowany)"

msgid "tunerele și blocarea semnalului"
msgstr "tunery i blokada sygnału"

msgid "ultimele rânduri dintr-un jurnal"
msgstr "ostatnie wiersze dziennika"

msgid ""
"Datele le primește Eduard Monea, persoană fizică (mărcile Monea Software și "
"HD Satelit), contact@hdsatelit.com. Pleacă numai felurile bifate de tine, "
"cu un identificator întâmplător și o amprentă calculată din placă, ca "
"receptorul să fie numărat o singură dată (din ea nu se pot afla adresa MAC "
"sau seria), fără adresa IP, fără parole și fără listele tale de canale, "
"numai ca să îmbunătățim imaginea pe modelul tău de receptor. Jurnalele se "
"păstrează 6 luni, celelalte date 12 luni. Poți debifa oricând un fel de "
"date sau poți ieși din program cu ștergerea datelor. La o pornire ratată, "
"receptorul trimite singur un raport tehnic anonim, fără date personale. "
"Dacă scrii pe forumul receptorului, mesajul tău apare public, cu numele "
"ales de tine sau cu un nume automat. Nota întreagă e la adresa de mai jos."
msgstr ""
"Dane otrzymuje Eduard Monea, osoba fizyczna (marki Monea Software i HD "
"Satelit), contact@hdsatelit.com. Wysyłane są tylko zaznaczone przez ciebie "
"rodzaje, z losowym identyfikatorem i odciskiem obliczonym z płyty, żeby "
"odbiornik był liczony tylko raz (nie da się z niego odczytać adresu MAC ani "
"numeru seryjnego), bez adresu IP, bez haseł i bez twoich list kanałów, "
"tylko w celu ulepszenia obrazu na twoim modelu odbiornika. Dzienniki są "
"przechowywane 6 miesięcy, pozostałe dane 12 miesięcy. W każdej chwili "
"możesz odznaczyć rodzaj danych albo wyjść z programu z usunięciem danych. "
"Przy nieudanym uruchomieniu odbiornik sam wysyła anonimowy raport "
"techniczny, bez danych osobowych. Jeśli piszesz na forum odbiornika, twoja "
"wiadomość pojawia się publicznie, z nazwą wybraną przez ciebie lub z nazwą "
"automatyczną. Pełna informacja jest pod adresem poniżej."

msgid "Pozele se văd după aprobare."
msgstr "Zdjęcia będą widoczne po zatwierdzeniu."

msgid "Felicitări, ești beta tester. Datele bifate pleacă de acum."
msgstr "Gratulacje, jesteś betatesterem. Zaznaczone dane są wysyłane od teraz."

msgid "un mesaj nou"
msgid_plural "%d mesaje noi"
msgstr[0] "jedna nowa wiadomość"
msgstr[1] "%d nowe wiadomości"
msgstr[2] "%d nowych wiadomości"

#: data/menu.xml lib/python/Components/HdsJurnaleSloturi.py lib/python/Plugins/Extensions/HdsWebControl/sloturi_web.py
msgid "Jurnalele celorlalte sloturi"
msgstr "Dzienniki pozostałych slotów"

#: lib/python/Components/HdsJurnaleSloturi.py
msgid "Dacă o imagine dintr-un alt slot nu pornește, aici iei pașii pornirilor ei, rapoartele și jurnalele de cădere rămase acolo. O apăsare le pune pe stick și le trimite, ca să aflăm de ce nu pornește."
msgstr "Jeśli obraz w innym slocie się nie uruchamia, tutaj dostajesz kroki jego uruchomień, raporty i dzienniki awarii, które tam zostały. Jedno naciśnięcie zapisuje je na pendrive i wysyła, abyśmy dowiedzieli się, dlaczego się nie uruchamia."

#: lib/python/Components/HdsJurnaleSloturi.py lib/python/Plugins/Extensions/HdsWebControl/sloturi_web.py
msgid "Pune pe stick și trimite"
msgstr "Zapisz na pendrive i wyślij"

#: lib/python/Components/HdsJurnaleSloturi.py lib/python/Plugins/Extensions/HdsWebControl/sloturi_web.py
msgid "Caut celelalte sloturi..."
msgstr "Szukam pozostałych slotów..."

#: lib/python/Components/HdsJurnaleSloturi.py lib/python/Plugins/Extensions/HdsWebControl/sloturi_web.py
msgid "Nu am găsit alte sloturi pe acest receptor."
msgstr "Nie znalazłem innych slotów w tym odbiorniku."

#: lib/python/Components/HdsJurnaleSloturi.py
#, python-format
msgid "%(nume)s, %(imagine)s: porniri %(porniri)d, rapoarte %(rapoarte)d, jurnale de cădere %(caderi)d"
msgstr "%(nume)s, %(imagine)s: uruchomienia %(porniri)d, raporty %(rapoarte)d, dzienniki awarii %(caderi)d"

#: lib/python/Components/HdsJurnaleSloturi.py lib/python/Plugins/Extensions/HdsWebControl/sloturi_web.py
msgid "Pun jurnalele pe stick și le trimit..."
msgstr "Zapisuję dzienniki na pendrive i wysyłam je..."

#: lib/python/Components/HdsJurnaleSloturi.py
msgid "Pus pe stick, în dosarul hds-raport."
msgstr "Zapisano na pendrive, w folderze hds-raport."

#: lib/python/Components/HdsJurnaleSloturi.py
