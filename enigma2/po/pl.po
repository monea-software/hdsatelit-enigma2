#: lib/python/Plugins/Extensions/HdsWebControl/aplicatii_web.py
msgid "Receptorul e în standby. Pornește-l, apoi alege canalul."
msgstr "Odbiornik jest w trybie czuwania. Włącz go, a potem wybierz kanał."

#: lib/python/Plugins/Extensions/HdsWebControl/aplicatii_web.py
msgid "Tasta nu e cunoscută."
msgstr "Nieznany klawisz."

#: lib/python/Plugins/Extensions/HdsWebControl/aplicatii_web.py
msgid "Tasta nu a plecat."
msgstr "Klawisz nie został wysłany."

#: lib/python/Plugins/Extensions/HdsWebControl/aplicatii_web.py
msgid "Comanda de volum nu e cunoscută."
msgstr "Nieznane polecenie głośności."

#: lib/python/Plugins/Extensions/HdsWebControl/aplicatii_web.py
msgid "Volumul nu se poate schimba acum."
msgstr "Głośności nie można teraz zmienić."

#: lib/python/Plugins/Extensions/HdsWebControl/aplicatii_web.py
