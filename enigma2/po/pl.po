#, python-format
msgid "Sateliții bifați au %d transpondere în lista receptorului, dar niciunul cu parametri pe care tunerul îi primește (%s)."
msgstr "Zaznaczone satelity mają %d transponderów na liście odbiornika, ale żadnego z parametrami, które tuner przyjmuje (%s)."

#: lib/python/Screens/ScanerSatelit.py:247
msgid "sistem pe care imaginea nu îl știe"
msgstr "system, którego obraz nie zna"

#: lib/python/Screens/ScanerSatelit.py:251
msgid "modulație pe care imaginea nu o știe încă"
msgstr "modulacja, której obraz jeszcze nie zna"

#: lib/python/Screens/ScanerSatelit.py:257
#, python-format
msgid "rata de simbol %d kSymb/s nu e primită de tuner (%d-%d kSymb/s)"
msgstr "szybkość symbolowa %d kSymb/s nie jest przyjmowana przez tuner (%d-%d kSymb/s)"

#: lib/python/Screens/ScanerSatelit.py:312
msgid "DVB-S2X se caută ca DVB-S2."
msgstr "DVB-S2X jest wyszukiwany jak DVB-S2."

#: lib/python/Screens/ScanerSatelit.py:328
msgid "Factorul de rotunjire ales nu e primit de tuner, s-a folosit 0,35."
msgstr "Wybrany współczynnik roll-off nie jest przyjmowany przez tuner, użyto 0,35."

#: lib/python/Screens/ScanerSatelit.py:337
#, python-format
msgid "%d MHz nu e în lista receptorului pentru acest satelit, se caută cu valorile introduse."
msgstr "%d MHz nie ma na liście odbiornika dla tego satelity, wyszukiwanie z wpisanymi wartościami."

#: lib/python/Screens/ScanerSatelit.py:345
#, python-format
msgid "Sistemul, FEC-ul și modulația sunt luate din lista receptorului: %s."
msgstr "System, FEC i modulacja są brane z listy odbiornika: %s."

#: lib/python/Screens/ScanerSatelit.py:495
msgid "Sateliții aleși nu au în lista receptorului niciun transponder pe care tunerul să-l primească."
msgstr "Wybrane satelity nie mają na liście odbiornika żadnego transpondera, który tuner przyjmuje."

#: lib/python/Screens/ScanerSatelit.py:497
#, python-format
msgid "Căutare pe %d sateliți: %d transpondere din lista receptorului, plus cele anunțate în semnal."
msgstr "Wyszukiwanie na %d satelitach: %d transponderów z listy odbiornika oraz te ogłoszone w sygnale."

#: lib/python/Screens/ScanerSatelit.py:516
#, python-format
msgid "Satelitul %s are %d transpondere în lista receptorului, dar niciunul cu parametri pe care tunerul îi primește (%s). Nu am ce căuta."
msgstr "Satelita %s ma %d transponderów na liście odbiornika, ale żadnego z parametrami, które tuner przyjmuje (%s). Nie ma czego szukać."

#: lib/python/Screens/ScanerSatelit.py:519
#, python-format
msgid "Satelitul %s nu are niciun transponder în lista receptorului, deci nu am ce căuta. Alege alt satelit sau caută cu date introduse manual."
msgstr "Satelita %s nie ma żadnego transpondera na liście odbiornika, więc nie ma czego szukać. Wybierz innego satelitę lub szukaj z ręcznie wpisanymi danymi."

#: lib/python/Screens/ScanerSatelit.py:521
#, python-format
msgid "Căutare pe tot satelitul %s: %d transpondere din lista receptorului, plus cele anunțate în semnal."
msgstr "Wyszukiwanie na całym satelicie %s: %d transponderów z listy odbiornika oraz te ogłoszone w sygnale."

#: lib/python/Screens/ScanerSatelit.py:529
#, python-format
msgid "Satelitul %s nu are în lista receptorului niciun transponder pe care tunerul să-l primească. Caută cu date introduse manual."
msgstr "Satelita %s nie ma na liście odbiornika żadnego transpondera, który tuner przyjmuje. Szukaj z ręcznie wpisanymi danymi."

#: lib/python/Screens/ScanerSatelit.py:540
msgid "Se adaugă și transponderele anunțate în semnal."
msgstr "Dodawane są też transpondery ogłoszone w sygnale."

#: lib/python/Screens/ScanerSatelit.py:547
#, python-format
msgid "%s: la DVB-S2 FEC-ul nu poate fi Auto, iar transponderul nu e în lista receptorului. Alege modulația și FEC-ul."
msgstr "%s: w DVB-S2 FEC nie może być Auto, a transpondera nie ma na liście odbiornika. Wybierz modulację i FEC."

#: lib/python/Screens/ScanerSatelit.py:572
#, python-format
msgid "Căutare după operator: %s, pe %s. Se pornește de la transponderul %s, restul vin din ce anunță operatorul în semnal."
msgstr "Wyszukiwanie według operatora: %s, na %s. Start od transpondera %s, reszta pochodzi z tego, co operator ogłasza w sygnale."

#: lib/python/Screens/ScanerSatelit.py:661
#, python-format
msgid "Fluxurile găsite nu s-au putut pune în listă (%s). Încearcă din nou."
msgstr "Nie udało się umieścić znalezionych strumieni na liście (%s). Spróbuj ponownie."

#: lib/python/Screens/ScanerSatelit.py:795
msgid "Factorul de rotunjire (roll-off)"
msgstr "Współczynnik roll-off"

#: lib/python/Screens/ScanerSatelit.py:1017
#, python-format
msgid "%s: niciun operator de acest fel. Pentru operatorii din alte țări apasă OK pe rândul „Operator”."
msgstr "%s: brak operatora tego rodzaju. Aby zobaczyć operatorów z innych krajów, naciśnij OK w wierszu „Operator”."

#: lib/python/Screens/ScanerTerestru.py:84
msgid "DVB-T2: standardul nou din Europa și Asia.\nPoate duce mai multe multiplexuri pe aceeași frecvență.\nBanda: 8 MHz (Europa), 7/6 MHz (alte regiuni)."
msgstr "DVB-T2: nowy standard w Europie i Azji.\nMoże przenosić kilka multipleksów na tej samej częstotliwości.\nPasmo: 8 MHz (Europa), 7/6 MHz (inne regiony)."

#: lib/python/Screens/ScanerTerestru.py:88
msgid "ATSC 3.0: standardul nou din SUA, folosit din 2020.\nUltra HD, HDR, sunet cu efect de spațiu."
msgstr "ATSC 3.0: nowy standard w USA, używany od 2020 roku.\nUltra HD, HDR, dźwięk przestrzenny."

#: lib/python/Screens/ScanerTerestru.py:105
msgid "Lățimea de bandă aleasă nu e primită: imaginea știe numai 8, 7, 6 MHz și Auto. Alege alta."
msgstr "Wybrana szerokość pasma nie jest przyjmowana: obraz zna tylko 8, 7, 6 MHz i Auto. Wybierz inną."

#: lib/python/Screens/ScanerTerestru.py:107
msgid "Modulația aleasă (256QAM) e numai la DVB-T2, pe care imaginea nu îl recepționează încă. Alege QPSK, 16QAM, 64QAM sau Auto."
msgstr "Wybrana modulacja (256QAM) istnieje tylko w DVB-T2, którego obraz jeszcze nie odbiera. Wybierz QPSK, 16QAM, 64QAM lub Auto."

