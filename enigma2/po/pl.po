msgstr "Jasność"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Cât de luminoasă e imaginea. Schimbă și meniurile."
msgstr "Jak jasny jest obraz. Zmienia też menu."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Diferența dintre părțile întunecate și cele luminoase. Schimbă și meniurile."
msgstr "Różnica między ciemnymi a jasnymi częściami. Zmienia też menu."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Saturație"
msgstr "Nasycenie"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Cât de puternice sunt culorile. Schimbă și meniurile."
msgstr "Jak mocne są kolory. Zmienia też menu."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Nuanță"
msgstr "Odcień"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Mută culorile spre verde sau spre roșu, pentru fețe naturale. Schimbă și meniurile."
msgstr "Przesuwa kolory w stronę zieleni lub czerwieni, dla naturalnych twarzy. Zmienia też menu."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Claritate"
msgstr "Ostrość"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Contururi mai precise după mărirea imaginii. Prea mult face margini albe în jurul obiectelor."
msgstr "Dokładniejsze kontury po powiększeniu obrazu. Za dużo daje białe obwódki wokół przedmiotów."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Reducerea zgomotului"
msgstr "Redukcja szumu"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Liniștește purecii din imagine de la un cadru la altul. Prea mult lasă urme în spatele mișcării."
msgstr "Uspokaja ziarno obrazu między klatkami. Za dużo zostawia smugi za ruchem."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Zgomotul din cadru"
msgstr "Szum w klatce"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Netezește zonele plate ale fiecărui cadru. Prea mult face fețele și iarba ca de plastic."
msgstr "Wygładza płaskie obszary każdej klatki. Za dużo sprawia, że twarze i trawa wyglądają jak z plastiku."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Pătrățelele compresiei"
msgstr "Bloki kompresji"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Șterge marginile pătrățelelor care apar pe canalele cu debit mic."
msgstr "Usuwa krawędzie kwadracików widocznych na kanałach o niskiej przepływności."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Zgomotul de pe contururi"
msgstr "Szum na konturach"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Șterge tremurul din jurul literelor și al marginilor ascuțite."
msgstr "Usuwa drżenie wokół liter i ostrych krawędzi."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Contrast adaptiv"
msgstr "Kontrast adaptacyjny"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Receptorul potrivește singur contrastul după fiecare scenă."
msgstr "Odbiornik sam dopasowuje kontrast do każdej sceny."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Îmbunătățirea culorilor"
msgstr "Poprawa kolorów"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Culori mai vii și pielea mai naturală."
msgstr "Żywsze kolory i bardziej naturalna skóra."

