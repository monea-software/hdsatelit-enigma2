msgstr "Darmowy limit: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "La depășire: %s"
msgstr "Po przekroczeniu: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Sus și jos derulează. Stânga și dreapta: alt serviciu. OK sau Ieșire închide."
msgstr "Góra i dół przewijają. Lewo i prawo: inna usługa. OK lub EXIT zamyka."

