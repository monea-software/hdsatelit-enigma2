msgstr "Wyszukiwanie serwerów w domu..."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Nu s-a găsit niciun server. Verifică dacă e pornit sau adaugă-l de mână."
msgstr "Nie znaleziono żadnego serwera. Sprawdź, czy jest włączony, albo dodaj go ręcznie."

#: lib/python/Components/HdsStocareRetea.py
msgid "Dosar"
msgstr "Folder"

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Dosarul nu are filme, muzică sau alte dosare."
msgstr "Folder nie zawiera filmów, muzyki ani innych folderów."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Editează locul"
msgstr "Edytuj lokalizację"

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Adaugă un loc din rețea"
msgstr "Dodaj lokalizację sieciową"

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Felul locului"
msgstr "Rodzaj lokalizacji"

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Numele (cum apare în listă)"
msgstr "Nazwa (jak na liście)"

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Se păstrează criptată pe receptor și nu se mai arată. Gol: rămâne parola de acum."
msgstr "Jest przechowywane zaszyfrowane w odbiorniku i nie jest już pokazywane. Puste: zostaje obecne hasło."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Se păstrează criptată pe receptor și nu se mai arată."
msgstr "Jest przechowywane zaszyfrowane w odbiorniku i nie jest już pokazywane."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Scrie întâi serverul."
msgstr "Najpierw wpisz serwer."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Serverul nu a dat niciun dosar."
msgstr "Serwer nie zwrócił żadnego folderu."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Dosarele serverului"
msgstr "Foldery serwera"

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Se montează pe receptor: apare în Player media și poate ține înregistrări."
msgstr "Montowana w odbiorniku: pojawia się w Odtwarzacz i może przechowywać nagrania."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Se răsfoiește din Locuri din rețea; filmele merg cu salturi și subtitrări."
msgstr "Przeglądasz ją w sekcji Lokalizacje sieciowe; filmy działają z przewijaniem i napisami."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Ca FTP, cu legătura criptată."
msgstr "Jak FTP, z szyfrowanym połączeniem."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Ca WebDAV, cu legătura criptată (HTTPS)."
msgstr "Jak WebDAV, z szyfrowanym połączeniem (HTTPS)."

#: lib/python/Screens/HdsLocuriRetea.py
msgid "Se răsfoiește ca pe server; subtitrările date de server se iau singure."
msgstr "Przeglądasz jak na serwerze; napisy podane przez serwer są wczytywane same."

#: lib/python/Screens/HdsLocuriRetea.py
#, python-format
msgid "Montat în %s"
msgstr "Zamontowana w %s"

#: lib/python/Screens/HdsLocuriRetea.py
#, python-format
msgid "Bun pentru înregistrări (%s MB/s la scriere)"
msgstr "Nadaje się do nagrań (%s MB/s przy zapisie)"

