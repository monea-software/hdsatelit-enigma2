#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Traducerea subtitrărilor s-a oprit %d minute: %s"
msgstr "Tłumaczenie napisów zatrzymało się na %d minut: %s"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Intră pe azure.microsoft.com și apasă „Try Azure for free”. Te înscrii cu un "
"cont Microsoft; Microsoft cere un număr de telefon și un card, numai pentru "
"verificare."
msgstr "Wejdź na azure.microsoft.com i naciśnij „Try Azure for free”. Rejestrujesz się kontem Microsoft; Microsoft prosi o numer telefonu i kartę, tylko do weryfikacji."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Intră pe portal.azure.com, caută „Translator” în bara de sus și începe o "
"resursă nouă („Create”)."
msgstr "Wejdź na portal.azure.com, wyszukaj „Translator” na górnym pasku i zacznij nowy zasób („Create”)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"La „Resource group” apasă „Create new” și scrie orice nume. La „Region” "
"alege „Global”, la „Name” scrie un nume al tău, iar la „Pricing tier” alege "
"„Free F0”."
msgstr "Przy „Resource group” naciśnij „Create new” i wpisz dowolną nazwę. Przy „Region” wybierz „Global”, przy „Name” wpisz własną nazwę, a przy „Pricing tier” wybierz „Free F0”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Apasă „Review + create”, apoi „Create”. Când e gata, apasă „Go to resource”."
msgstr "Naciśnij „Review + create”, potem „Create”. Gdy będzie gotowe, naciśnij „Go to resource”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În stânga alege „Keys and Endpoint” și copiază „KEY 1”. Dacă nu ai ales "
"„Global”, notează și regiunea (de exemplu westeurope)."
msgstr "Po lewej wybierz „Keys and Endpoint” i skopiuj „KEY 1”. Jeśli nie wybrałeś „Global”, zapisz też region (na przykład westeurope)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pune cheia aici (și regiunea, dacă resursa nu e „Global”)."
msgstr "Wpisz tutaj klucz (i region, jeśli zasób nie jest „Global”)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În primele 30 de zile trece abonamentul pe „Pay as you go”, altfel Microsoft "
"oprește contul gratuit. Resursa „Free F0” rămâne gratuită."
msgstr "W ciągu pierwszych 30 dni przełącz subskrypcję na „Pay as you go”, inaczej Microsoft zatrzyma darmowe konto. Zasób „Free F0” pozostaje darmowy."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "2.000.000 de caractere pe lună, gratuit."
msgstr "2 000 000 znaków miesięcznie, za darmo."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Traducerea se oprește (eroarea 403) până luna următoare. Pe „Free F0” nu se "
"plătește nimic."
msgstr "Tłumaczenie zatrzymuje się (błąd 403) do następnego miesiąca. Na „Free F0” nic nie płacisz."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Intră pe console.cloud.google.com cu contul tău Google și fă un proiect nou."
msgstr "Wejdź na console.cloud.google.com ze swoim kontem Google i utwórz nowy projekt."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Activează facturarea: Google cere un card la înscriere (90 de zile de probă)."
msgstr "Włącz rozliczenia: Google przy rejestracji prosi o kartę (90 dni okresu próbnego)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Caută „Cloud Translation API” în bara de sus și apasă „Enable”."
msgstr "Wyszukaj „Cloud Translation API” na górnym pasku i naciśnij „Enable”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Mergi la „APIs & Services”, „Credentials”, „Create credentials”, „API key” "
"și copiază cheia."
msgstr "Przejdź do „APIs & Services”, „Credentials”, „Create credentials”, „API key” i skopiuj klucz."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Apasă pe cheie, la „API restrictions” alege „Restrict key”, bifează „Cloud "
"Translation API” și apasă „Save”."
msgstr "Kliknij klucz, przy „API restrictions” wybierz „Restrict key”, zaznacz „Cloud Translation API” i naciśnij „Save”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Ca să nu plătești: „APIs & Services”, „Cloud Translation API”, fila "
"„Quotas”, cota de caractere pe zi, „Edit quotas”, scrie 15000. O alertă de "
"buget NU oprește plata."
msgstr "Żeby nie płacić: „APIs & Services”, „Cloud Translation API”, karta „Quotas”, limit znaków na dzień, „Edit quotas”, wpisz 15000. Alert budżetowy NIE zatrzymuje płatności."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pune cheia aici."
msgstr "Wpisz tutaj klucz."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Primele 500.000 de caractere pe lună sunt gratuite."
msgstr "Pierwsze 500 000 znaków miesięcznie jest darmowe."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Peste cotă se plătește automat (20 de dolari pe milion de caractere), dacă "
"nu ai coborât cota pe zi. Cu cota coborâtă, traducerea se oprește până a "
"doua zi."
msgstr "Powyżej limitu płacisz automatycznie (20 dolarów za milion znaków), jeśli nie obniżyłeś limitu dziennego. Z obniżonym limitem tłumaczenie zatrzymuje się do następnego dnia."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Intră pe deepl.com/en/developers și apasă „Get a free API key”. DeepL nu "
"cere card."
msgstr "Wejdź na deepl.com/en/developers i naciśnij „Get a free API key”. DeepL nie prosi o kartę."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Dacă ai deja cont la traducătorul DeepL, ieși din el și fă un cont nou, "
"separat, pentru API."
msgstr "Jeśli masz już konto w tłumaczu DeepL, wyloguj się z niego i załóż nowe, osobne konto dla API."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Alege planul gratuit „DeepL API Developer” și termină înscrierea."
msgstr "Wybierz darmowy plan „DeepL API Developer” i dokończ rejestrację."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În cont mergi la „API Keys” („API Keys & Limits”). Dacă nu ai nicio cheie, "
"apasă „Create key”, scrie un nume și apasă din nou „Create key”."
msgstr "Na koncie przejdź do „API Keys” („API Keys & Limits”). Jeśli nie masz żadnego klucza, naciśnij „Create key”, wpisz nazwę i naciśnij ponownie „Create key”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Copiază cheia cu iconița de lângă ea și pune-o aici."
msgstr "Skopiuj klucz ikoną obok niego i wpisz go tutaj."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Cont nou: 1.000.000 de caractere în total, o singură dată, nu în fiecare "
"lună. O cheie veche „DeepL API Free” (se termină cu :fx) are 500.000 de "
"caractere pe lună."
msgstr "Nowe konto: 1 000 000 znaków łącznie, jednorazowo, nie co miesiąc. Stary klucz „DeepL API Free” (kończy się na :fx) ma 500 000 znaków miesięcznie."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Traducerea se oprește (eroarea 456). Nu se plătește nimic singur; pentru mai "
"mult trebuie un plan plătit."
msgstr "Tłumaczenie zatrzymuje się (błąd 456). Nic nie jest płacone samo; po więcej potrzebny jest płatny plan."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Pe un calculator din casă instalează Docker Desktop (docs.docker.com) și "
"pornește-l."
msgstr "Na komputerze w domu zainstaluj Docker Desktop (docs.docker.com) i uruchom go."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În PowerShell scrie o singură comandă: docker run -d --restart "
"unless-stopped --name libretranslate -p 5000:5000 -v "
"lt-local:/home/libretranslate/.local libretranslate/libretranslate "
"--load-only en,ro,de,fr,it,es,hu"
msgstr "W PowerShell wpisz jedno polecenie: docker run -d --restart unless-stopped --name libretranslate -p 5000:5000 -v lt-local:/home/libretranslate/.local libretranslate/libretranslate --load-only en,ro,de,fr,it,es,hu"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"La prima pornire așteaptă câteva minute (descarcă limbile). Deschide "
"http://localhost:5000 în browser: dacă apare pagina de traducere, merge."
msgstr "Przy pierwszym uruchomieniu poczekaj kilka minut (pobiera języki). Otwórz http://localhost:5000 w przeglądarce: jeśli pojawi się strona tłumaczenia, działa."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Află adresa calculatorului în rețea (de exemplu 192.168.1.50) și scrie aici "
"http://192.168.1.50:5000. Cheie nu trebuie."
msgstr "Sprawdź adres komputera w sieci (na przykład 192.168.1.50) i wpisz tutaj http://192.168.1.50:5000. Klucz nie jest potrzebny."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Calculatorul trebuie să fie pornit când vrei traducere."
msgstr "Komputer musi być włączony, kiedy chcesz tłumaczenia."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Nu are cotă: e gratuit și fără limită; viteza depinde de calculator. "
"Serviciul de pe libretranslate.com nu are variantă gratuită."
msgstr "Nie ma limitu: jest darmowy i bez ograniczeń; szybkość zależy od komputera. Usługa na libretranslate.com nie ma darmowej wersji."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Nu e cazul."
msgstr "Nie dotyczy."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Intră pe aistudio.google.com cu contul tău Google (de la 18 ani) și acceptă "
"termenii."
msgstr "Wejdź na aistudio.google.com ze swoim kontem Google (od 18 lat) i zaakceptuj warunki."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Deschide pagina „API Keys” din meniul din stânga și apasă „Create API key”."
msgstr "Otwórz stronę „API Keys” z menu po lewej i naciśnij „Create API key”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Copiază cheia și pune-o aici. Nu adăuga card (facturare) la proiect: așa "
"rămâi pe gratuit."
msgstr "Skopiuj klucz i wpisz go tutaj. Nie dodawaj karty (rozliczeń) do projektu: tak zostajesz przy darmowym planie."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Modelul recomandat e gemini-3.5-flash-lite; e scris deja."
msgstr "Zalecany model to gemini-3.5-flash-lite; jest już wpisany."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Câte cereri ai pe zi vezi la aistudio.google.com/rate-limit."
msgstr "Ile zapytań masz dziennie, zobaczysz na aistudio.google.com/rate-limit."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Gratuit, cu un număr limitat de cereri pe minut și pe zi; Google arată "
"cifrele numai în contul tău."
msgstr "Za darmo, z ograniczoną liczbą zapytań na minutę i na dzień; Google pokazuje liczby tylko na twoim koncie."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Cererile primesc eroarea 429 până a doua zi (în jurul orei 10, ora "
"României). Fără card nu se plătește nimic."
msgstr "Zapytania dostają błąd 429 do następnego dnia (około godziny 10 czasu rumuńskiego). Bez karty nic nie jest płacone."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Cel mai simplu, în casă: instalează Ollama de pe ollama.com pe un calculator "
"și pornește-l."
msgstr "Najprościej, w domu: zainstaluj Ollama z ollama.com na komputerze i uruchom go."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În PowerShell scrie: ollama pull gemma3:4b (3,3 GB; pentru un calculator "
"slab, gemma3:1b, 815 MB)."
msgstr "W PowerShell wpisz: ollama pull gemma3:4b (3,3 GB; dla słabego komputera gemma3:1b, 815 MB)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Ca să-l vadă receptorul: închide Ollama de lângă ceas („Quit”). În Setări "
"caută „environment variables”, alege „Edit environment variables for your "
"account”, apasă „New”, scrie OLLAMA_HOST cu valoarea 0.0.0.0:11434, apoi OK, "
"și pornește din nou Ollama."
msgstr "Żeby odbiornik go widział: zamknij Ollama przy zegarze („Quit”). W Ustawieniach wyszukaj „environment variables”, wybierz „Edit environment variables for your account”, naciśnij „New”, wpisz OLLAMA_HOST z wartością 0.0.0.0:11434, potem OK, i uruchom ponownie Ollama."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Aici scrie adresa http://IP-UL-CALCULATORULUI:11434 și modelul gemma3:4b. "
"Cheie nu trebuie."
msgstr "Tutaj wpisz adres http://IP-KOMPUTERA:11434 i model gemma3:4b. Klucz nie jest potrzebny."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"LM Studio merge la fel: fila „Developer”, „Start server”, apoi „Serve on "
"Local Network”; adresa http://IP-UL-CALCULATORULUI:1234 și numele modelului "
"din LM Studio."
msgstr "LM Studio działa tak samo: karta „Developer”, „Start server”, potem „Serve on Local Network”; adres http://IP-KOMPUTERA:1234 i nazwa modelu z LM Studio."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Pe internet, Groq are un plan gratuit: adresa "
"https://api.groq.com/openai/v1, un model din planul gratuit (de exemplu "
"openai/gpt-oss-20b) și cheia din console.groq.com."
msgstr "W internecie Groq ma darmowy plan: adres https://api.groq.com/openai/v1, model z darmowego planu (na przykład openai/gpt-oss-20b) i klucz z console.groq.com."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În casă nu are cotă: e gratuit, fără limită, și nimic nu iese din casă. La "
"Groq, gratuit: de exemplu 30 de cereri pe minut și 1.000 pe zi."
msgstr "W domu nie ma limitu: jest darmowo, bez ograniczeń, i nic nie wychodzi z domu. W Groq za darmo: na przykład 30 zapytań na minutę i 1000 dziennie."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În casă nu e cazul. La Groq, peste limită vine eroarea 429; planul gratuit "
"nu se plătește."
msgstr "W domu nie dotyczy. W Groq powyżej limitu przychodzi błąd 429; za darmowy plan się nie płaci."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cum pornești LibreTranslate"
msgstr "Jak uruchomić LibreTranslate"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cum pornești un server compatibil OpenAI"
msgstr "Jak uruchomić serwer zgodny z OpenAI"

