#: lib/python/Components/HdsIpv6.py
msgid "IPv6"
msgstr "IPv6"

#: data/setup.xml
msgid "Nu (din fabrică): plăcile de rețea nu au adrese IPv6, iar clientul IPv6 nu pornește; rețeaua merge pe IPv4, ca până acum. Da: receptorul primește și adrese IPv6, dacă rețeaua ta le dă. Se aplică pe loc."
msgstr "Nie (ustawienie fabryczne): karty sieciowe nie mają adresów IPv6, a klient IPv6 się nie uruchamia; sieć działa przez IPv4, jak dotąd. Tak: odbiornik dostaje też adresy IPv6, jeśli twoja sieć je daje. Działa od razu."

