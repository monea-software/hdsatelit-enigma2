msgstr "Włączony"

#, python-format
msgid "%d de transpondere ale satelitului nu apar aici, fiindcă imaginea nu le poate acorda încă."
msgstr "Liczba transponderów satelity, których tu nie ma, bo obraz jeszcze nie umie ich dostroić: %d."

msgid "sub orizont"
msgstr "pod horyzontem"

msgid "Tunerul nu are DVB-S2. Alege un transponder DVB-S."
msgstr "Tuner nie ma DVB-S2. Wybierz transponder DVB-S."

msgid "Găsirea semnalului e deschisă pe televizor."
msgstr "Wyszukiwacz sygnału jest otwarty na telewizorze."

msgid "Măsurarea pornită din web a fost preluată de televizor."
msgstr "Pomiar uruchomiony przez stronę WWW przejął telewizor."

msgid "Măsurarea s-a oprit: pagina web nu mai cere starea."
msgstr "Pomiar się zatrzymał: strona WWW nie pyta już o stan."

msgid "Antena se rotește."
msgstr "Antena się obraca."

msgid "Canalul s-a oprit cât timp măsori și pornește la loc când ieși."
msgstr "Kanał zatrzymał się na czas pomiaru i uruchomi się ponownie, gdy wyjdziesz."

msgid "Satelitul nu are transpondere în lista lui: se măsoară valorile bătute de mână."
msgstr "Satelita nie ma transponderów na swojej liście: mierzone są wartości wpisane ręcznie."

msgid "se citește"
msgstr "odczyt"

msgid "necitit"
msgstr "nieodczytane"

msgid "se rotește"
msgstr "obraca się"

#, python-format
msgid "Transponder pe care imaginea nu îl poate acorda: %s"
msgstr "Transponder, którego obraz nie umie dostroić: %s"

msgid "satelit necunoscut"
msgstr "nieznany satelita"

msgid "Receptorul nu are niciun tuner de satelit, deci aici nu se poate măsura semnalul."
msgstr "Odbiornik nie ma żadnego tunera satelitarnego, więc tu nie można mierzyć sygnału."

msgid "Tunerul nu are niciun satelit configurat. Configurează antena în „Setări tuner”, apoi revino aici."
msgstr "Tuner nie ma skonfigurowanego żadnego satelity. Skonfiguruj antenę w „Ustawienia tunera”, a potem wróć tutaj."

#, python-format
msgid "La %s începe o înregistrare programată și are nevoie de tuner. Măsoară după ce se termină."
msgstr "O %s zaczyna się zaplanowane nagrywanie, które potrzebuje tunera. Mierz, gdy się skończy."

msgid "Măsurarea nu e pornită."
msgstr "Pomiar nie jest uruchomiony."

msgid "Antena se rotește: acordul din nou se face după ce se oprește."
msgstr "Antena się obraca: ponowne dostrojenie nastąpi, gdy się zatrzyma."

#, python-format
msgid "Înregistrarea programată la %s are nevoie de tuner. Măsurarea s-a oprit și canalul a pornit la loc."
msgstr "Zaplanowane nagrywanie o %s potrzebuje tunera. Pomiar się zatrzymał, a kanał uruchomił się ponownie."

msgid "Măsurare oprită"
msgstr "Pomiar zatrzymany"

msgid "Niciun tuner de satelit"
msgstr "Brak tunera satelitarnego"

msgid "Niciun satelit configurat"
msgstr "Brak skonfigurowanego satelity"

msgid "Se acordează"
msgstr "Dostrajanie"

msgid "Tunerul e ocupat"
msgstr "Tuner jest zajęty"

msgid "Tunerul înregistrează"
msgstr "Tuner nagrywa"

msgid "Urmează o înregistrare"
msgstr "Zbliża się nagrywanie"

msgid "Nu se poate acorda"
msgstr "Nie da się dostroić"

msgid "Aștept motorul"
msgstr "Czekam na silnik"

msgid "Semnal recepționat"
msgstr "Sygnał złapany"

msgid "Fără semnal"
msgstr "Brak sygnału"

msgid "Semnal pierdut"
msgstr "Sygnał utracony"

#, python-format
msgid "La %s începe o înregistrare programată. Măsurarea se oprește singură cu un minut și jumătate înainte."
msgstr "O %s zaczyna się zaplanowane nagrywanie. Pomiar zatrzyma się sam półtorej minuty wcześniej."

#, python-format
msgid "Cea mai bună calitate în ultimele 10 s: %d %%."
msgstr "Najlepsza jakość w ostatnich 10 s: %d %%."

#, python-format
msgid "ON ID %d, iar în lista satelitului e %d. Antena poate fi pe alt satelit."
msgstr "ON ID %d, a na liście satelity jest %d. Antena może być na innym satelicie."

msgid "FEC pe care nucleul nu îl are"
msgstr "FEC, którego rdzeń nie obsługuje"

#, python-format
msgid "Tunerul nu poate acorda %s: frecvența nu intră în banda LNB-ului sau satelitul lipsește din setările tunerului."
msgstr "Tuner nie może dostroić %s: częstotliwość nie mieści się w paśmie LNB albo satelity brakuje w ustawieniach tunera."

msgid "Antena se rotește spre est."
msgstr "Antena obraca się na wschód."

msgid "Antena se rotește spre vest."
msgstr "Antena obraca się na zachód."

#, python-format
msgid "Mai are aproximativ %s (estimat)."
msgstr "Zostało około %s (szacunkowo)."

#, python-format
msgid "Poziția de plecare nu e cunoscută: mersul poate ține încă până la %s."
msgstr "Pozycja początkowa nie jest znana: ruch może jeszcze potrwać do %s."

msgid "spre"
msgstr "na"

msgid "roll-off pe care nucleul nu îl are"
msgstr "roll-off, którego rdzeń nie obsługuje"

msgid "pilot necunoscut"
msgstr "nieznany pilot"

msgid "Tunerul de satelit e folosit de o transmisie în rețea sau de o extensie. Oprește-o, apoi apasă galben."
msgstr "Tuner satelitarny jest używany przez transmisję sieciową albo wtyczkę. Zatrzymaj ją, a potem naciśnij żółty."

msgid "Tunerul de satelit înregistrează acum. Găsirea semnalului merge după terminarea înregistrării."
msgstr "Tuner satelitarny teraz nagrywa. Wyszukiwanie sygnału zadziała po zakończeniu nagrywania."

msgid "Antena poate fi încă în mișcare spre satelitul de dinainte."
msgstr "Antena może jeszcze jechać w stronę poprzedniego satelity."

msgid "Se acordează după ce antena se oprește."
msgstr "Dostrojenie nastąpi, gdy antena się zatrzyma."

msgid "Cifrele sunt din timpul mersului. Verdictul vine după ce antena se oprește."
msgstr "Liczby pochodzą z czasu ruchu. Wynik przyjdzie, gdy antena się zatrzyma."

#, python-format
msgid "Niciun semnal în %d s. Se încearcă singur din nou la fiecare %d s (încercarea %d). Mișcă antena încet."
msgstr "Brak sygnału przez %d s. Samoczynna ponowna próba co %d s (próba %d). Poruszaj anteną powoli."

#, python-format
msgid "Semnalul s-a pierdut. Se încearcă din nou la fiecare %d s."
msgstr "Sygnał utracony. Ponowna próba co %d s."

msgid "O înregistrare folosește acum antena. Comenzile pornesc după ce se termină."
msgstr "Nagrywanie używa teraz anteny. Polecenia ruszą po jego zakończeniu."

msgid "Peste mai puțin de un minut pornește o înregistrare. Comenzile motorului nu pornesc acum."
msgstr "Za mniej niż minutę zaczyna się nagrywanie. Polecenia silnika teraz nie ruszą."

msgid "Limita de est se mută în poziția de acum a antenei. Continui?"
msgstr "Limit wschodni przesunie się do obecnej pozycji anteny. Kontynuować?"

msgid "Limita de vest se mută în poziția de acum a antenei. Continui?"
msgstr "Limit zachodni przesunie się do obecnej pozycji anteny. Kontynuować?"

msgid "Fără limite, motorul poate duce antena în opritor și rupe cablul. Oprește-le numai ca să pui limite noi, cu ochii pe antenă. Pornesc singure la ieșire. Le oprești?"
msgstr "Bez limitów silnik może dopchnąć antenę do ogranicznika i zerwać kabel. Wyłączaj je tylko po to, żeby ustawić nowe limity, patrząc na antenę. Przy wyjściu włączą się same. Wyłączyć je?"

msgid "Pornește întâi limitele: fără ele, antena poate merge până în opritor."
msgstr "Najpierw włącz limity: bez nich antena może dojechać do ogranicznika."

msgid "Mișcarea s-a oprit: pagina nu a mai răspuns."
msgstr "Ruch się zatrzymał: strona przestała odpowiadać."

msgid "Comanda a fost anulată."
msgstr "Polecenie zostało anulowane."

msgid "Nici oprirea nu a putut fi trimisă. Dacă antena încă se mișcă, oprește receptorul din buton."
msgstr "Nie udało się wysłać nawet zatrzymania. Jeśli antena wciąż się rusza, wyłącz odbiornik przyciskiem."

#, python-format
msgid "Poziția %d din memoria motorului se înlocuiește cu poziția de acum. Continui?"
msgstr "Pozycja %d w pamięci silnika zostanie zastąpiona obecną pozycją. Kontynuować?"

msgid "Tunerul a fost cerut de altă funcție a receptorului. Motorul s-a oprit, iar programul revine când tunerul se eliberează."
msgstr "Tuner został zażądany przez inną funkcję odbiornika. Silnik się zatrzymał, a kanał wróci, gdy tuner się zwolni."

msgid "Tunerul a fost cerut de altă funcție a receptorului. Motorul s-a oprit."
msgstr "Tuner został zażądany przez inną funkcję odbiornika. Silnik się zatrzymał."

#, python-format
msgid "Antena încă merge spre %s. Comenzile pornesc după ce ajunge."
msgstr "Antena wciąż jedzie na %s. Polecenia ruszą, gdy dotrze."

#, python-format
msgid "Peste %d minute pornește o înregistrare. Comenzile se opresc atunci singure."
msgstr "Za %d min zaczyna się nagrywanie. Polecenia zatrzymają się wtedy same."

msgid "Tunerul cu motor e folosit de altcineva (o transmisie în rețea sau o extensie)."
msgstr "Tuner z silnikiem jest używany przez coś innego (transmisję sieciową albo wtyczkę)."

msgid "Limitele au rămas oprite la ultima folosire; le-am pornit."
msgstr "Limity zostały wyłączone przy ostatnim użyciu; włączyłem je."

#, python-format
msgid "Tunerul nu a putut fi pregătit pe %s."
msgstr "Nie udało się przygotować tunera na %s."

#, python-format
msgid "Receptorul așteaptă semnal pe %s ca să știe că antena a ajuns."
msgstr "Odbiornik czeka na sygnał na %s, żeby wiedzieć, że antena dotarła."

#, python-format
msgid "Antena a ajuns pe %s, semnal recepționat."
msgstr "Antena dotarła na %s, sygnał złapany."

#, python-format
msgid "Antena a ajuns pe %s, dar încă nu are semnal."
msgstr "Antena dotarła na %s, ale jeszcze nie ma sygnału."

msgid "Comanda nu a putut fi trimisă din cauza unei erori în receptor. Am trimis oprirea."
msgstr "Nie udało się wysłać polecenia z powodu błędu w odbiorniku. Wysłałem zatrzymanie."

#, python-format
msgid "Poziția %d a fost memorată în motor. Limitele sunt pornite."
msgstr "Pozycja %d została zapisana w silniku. Limity są włączone."

msgid "Limita de est a fost pusă aici. Limitele sunt pornite."
msgstr "Limit wschodni ustawiono tutaj. Limity są włączone."

msgid "Limita de vest a fost pusă aici. Limitele sunt pornite."
msgstr "Limit zachodni ustawiono tutaj. Limity są włączone."

msgid "satelitul programului"
msgstr "satelitę kanału"

msgid "Limitele nu au fost oprite: receptorul nu a putut ține minte asta pe disc."
msgstr "Limity nie zostały wyłączone: odbiornik nie mógł zapamiętać tego na dysku."

msgid "Pornește o înregistrare. Motorul s-a oprit și programul a revenit."
msgstr "Zaczyna się nagrywanie. Silnik się zatrzymał, a kanał wrócił."

#, python-format
msgid "Tunerul nu a acceptat comanda (cod %d). Am trimis oprirea."
msgstr "Tuner nie przyjął polecenia (kod %d). Wysłałem zatrzymanie."

#, python-format
msgid "În setările tunerului, poziția %d e folosită pentru %s."
msgstr "W ustawieniach tunera pozycja %d jest używana dla %s."

msgid "Un alt tuner legat de antenă a început să lucreze. Motorul s-a oprit."
msgstr "Zaczął pracować inny tuner podłączony do anteny. Silnik się zatrzymał."

msgid "Receptorul nu are niciun tuner de satelit, deci motorul nu se poate comanda de aici."
msgstr "Odbiornik nie ma żadnego tunera satelitarnego, więc stąd nie da się sterować silnikiem."

msgid "Niciun tuner nu e setat cu motor. Motorul se alege în Setări tuner (DiSEqC 1.2 sau USALS)."
msgstr "Żaden tuner nie jest ustawiony z silnikiem. Silnik wybiera się w Ustawieniach tunera (DiSEqC 1.2 albo USALS)."

