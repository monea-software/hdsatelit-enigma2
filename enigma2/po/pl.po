msgstr "Z tym LNB odbiornik nie może dostroić żadnego transpondera na %s: częstotliwość pośrednia wychodzi poza 900-2200 MHz."

#, python-format
msgid "Tunerul %s folosește setările tunerului %s."
msgstr "Tuner %s używa ustawień tunera %s."

#, python-format
msgid "Tunerul %s nu e configurat. Configurează-l întâi din Setări tuner."
msgstr "Tuner %s nie jest skonfigurowany. Najpierw skonfiguruj go w Ustawieniach tunera."

#, python-format
msgid "Pe %s nu știu niciun transponder, deci nu pot verifica frecvența intermediară."
msgstr "Na %s nie znam żadnego transpondera, więc nie mogę sprawdzić częstotliwości pośredniej."

#, python-format
msgid "Canalul care rulează acum (pe %s) nu se mai poate acorda cu acest LNB."
msgstr "Oglądanego teraz kanału (na %s) nie da się już dostroić z tym LNB."

msgid "(nou)"
msgstr "(nowe)"

#, python-format
msgid "Același satelit e pe două porturi (%s). Schimbă întâi din Setări tuner."
msgstr "Ten sam satelita jest na dwóch portach (%s). Najpierw zmień to w Ustawieniach tunera."

#, python-format
msgid "Cu acest LNB se pot acorda numai o parte din transponderele cunoscute: %d din %d, pe sateliți: %d din %d."
msgstr "Z tym LNB da się dostroić tylko część znanych transponderów: %d z %d, na satelitach: %d z %d."

msgid "Setările de dinainte sunt puse la loc, dar tunerul nu le-a primit acum. Repornește receptorul."
msgstr "Poprzednie ustawienia zostały przywrócone, ale tuner teraz ich nie przyjął. Uruchom odbiornik ponownie."

msgid "Se înregistrează acum. Schimbă LNB-ul după ce se termină înregistrarea."
msgstr "Trwa nagrywanie. Zmień LNB, gdy nagrywanie się skończy."

msgid "În mai puțin de două minute pornește o înregistrare programată. Schimbă LNB-ul după ce se termină."
msgstr "Za mniej niż dwie minuty zaczyna się zaplanowane nagrywanie. Zmień LNB, gdy się skończy."

msgid "O altă schimbare de LNB așteaptă confirmarea."
msgstr "Inna zmiana LNB czeka na potwierdzenie."

msgid "Am păstrat noile setări."
msgstr "Zostawiłem nowe ustawienia."

#, python-format
msgid "Nu recepționez semnal pe %s cu noile setări."
msgstr "Brak sygnału na %s z nowymi ustawieniami."

msgid "Receptorul pornește din nou programul. Încearcă peste câteva secunde."
msgstr "Odbiornik ponownie uruchamia kanał. Spróbuj za kilka sekund."

msgid "Nu am putut verifica semnalul: nu rula niciun canal de satelit pe acest tuner."
msgstr "Nie udało się sprawdzić sygnału: na tym tunerze nie był oglądany żaden kanał satelitarny."

msgid "Canalul care rula e pe alt LNB decât cel schimbat, deci nu am ce verifica."
msgstr "Oglądany kanał jest na innym LNB niż zmieniony, więc nie ma czego sprawdzać."

msgid "Nu am putut verifica semnalul: imaginea în imagine (PiP) ține canalul deschis."
msgstr "Nie udało się sprawdzić sygnału: obraz w obrazie (PiP) trzyma kanał otwarty."

msgid "După ultima schimbare de LNB, setările tunerului s-au schimbat și din alt loc (de exemplu din Setări tuner), deci nu mai pot reveni sigur la ce era."
msgstr "Po ostatniej zmianie LNB ustawienia tunera zmieniono też w innym miejscu (na przykład w Ustawieniach tunera), więc nie mogę już bezpiecznie wrócić do poprzednich."

#, python-format
msgid "Verific semnalul pe %s"
msgstr "Sprawdzam sygnał na %s"

#, python-format
msgid "Semnal recepționat pe %s."
msgstr "Sygnał na %s złapany."

msgid "alți sateliți"
msgstr "inne satelity"

msgid "eroare internă, scrisă în jurnal"
msgstr "błąd wewnętrzny, zapisany w dzienniku"

msgid "Nu am putut verifica semnalul: între timp a pornit alt canal."
msgstr "Nie udało się sprawdzić sygnału: w międzyczasie włączył się inny kanał."

msgid "A apărut o eroare (scrisă în jurnal), deci am revenit la setările de dinainte."
msgstr "Wystąpił błąd (zapisany w dzienniku), więc wróciłem do poprzednich ustawień."

msgid "Am revenit la setările de dinainte."
msgstr "Wróciłem do poprzednich ustawień."

#, python-format
msgid "Revin la setările de dinainte de %s?"
msgstr "Wrócić do ustawień sprzed %s?"

#, python-format
msgid "Tunerul e folosit acum de %s. Oprește-l, apoi încearcă din nou."
msgstr "Tuner jest teraz używany przez %s. Zatrzymaj to i spróbuj ponownie."

#, python-format
msgid "Semnal recepționat pe %s, calitate %d %%."
msgstr "Sygnał na %s złapany, jakość %d %%."

#, python-format
msgid "Dacă nu răspunzi, revin singur la ce era. Secunde rămase: %d."
msgstr "Jeśli nie odpowiesz, sam wrócę do poprzednich ustawień. Pozostało sekund: %d."

msgid "Setările tunerului s-au schimbat între timp. Verifică din nou."
msgstr "Ustawienia tunera zmieniły się w międzyczasie. Sprawdź ponownie."

msgid "Nu am putut verifica semnalul: receptorul a intrat în standby."
msgstr "Nie udało się sprawdzić sygnału: odbiornik przeszedł w stan czuwania."

msgid "Nu am putut verifica semnalul: programul nu a pornit din nou."
msgstr "Nie udało się sprawdzić sygnału: kanał nie uruchomił się ponownie."

#, python-format
msgid "Nu am putut verifica semnalul: canalul a pornit pe tunerul %s, care nu folosește acest LNB."
msgstr "Nie udało się sprawdzić sygnału: kanał uruchomił się na tunerze %s, który nie używa tego LNB."

msgid "Nu am putut verifica semnalul: nu știu pe ce tuner a pornit canalul."
msgstr "Nie udało się sprawdzić sygnału: nie wiem, na którym tunerze uruchomił się kanał."

msgid "În timpul probei a pornit o înregistrare pe acest LNB, acordată cu setările noi. Verifică înregistrarea."
msgstr "Podczas sprawdzania na tym LNB zaczęło się nagrywanie, dostrojone z nowymi ustawieniami. Sprawdź nagranie."

#, python-format
msgid "Anulez: %s"
msgstr "Cofam: %s"

#, python-format
msgid "Schimbate din alt loc: %s."
msgstr "Zmienione w innym miejscu: %s."

#, python-format
msgid "Nu am putut aplica setările (%s). Am revenit la ce era."
msgstr "Nie udało się zastosować ustawień (%s). Wróciłem do poprzednich."

msgid "Nu am putut aplica setările."
msgstr "Nie udało się zastosować ustawień."

#, python-format
msgid "Pe televizor e deschis ecranul „%s”. Închide-l, apoi încearcă din nou."
msgstr "Na telewizorze jest otwarty ekran „%s”. Zamknij go i spróbuj ponownie."

msgid "Un transponder al satelitului nu apare aici, fiindcă imaginea nu îl poate acorda încă."
msgstr "Jeden transponder satelity nie jest tu pokazany, bo obraz jeszcze nie umie go dostroić."

#, python-format
msgid "%d transpondere ale satelitului nu apar aici, fiindcă imaginea nu le poate acorda încă."
msgstr "Liczba transponderów satelity, których tu nie ma, bo obraz jeszcze nie umie ich dostroić: %d."

msgid "Receptorul a intrat în standby și tunerul a fost eliberat. Apasă galben ca să măsori din nou."
msgstr "Odbiornik przeszedł w stan czuwania i tuner został zwolniony. Naciśnij żółty, aby zmierzyć ponownie."

msgid "Tunerul a fost cerut de altă funcție a receptorului. Apasă galben ca să măsori din nou."
msgstr "Tuner został zażądany przez inną funkcję odbiornika. Naciśnij żółty, aby zmierzyć ponownie."

msgid "Rețea confirmată: TS ID și ON ID sunt cele din lista satelitului."
msgstr "Sieć potwierdzona: TS ID i ON ID są takie jak na liście satelity."

