#, python-format
msgid "Cum îți faci cheia pentru %s"
msgstr "Jak zrobić swój klucz dla %s"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Verificat pe pagina oficială la %s."
msgstr "Sprawdzono na oficjalnej stronie dnia %s."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Textul subtitrărilor merge la serverul din casa ta (%s). Nimic nu iese din "
"casă."
msgstr "Tekst napisów trafia do serwera w twoim domu (%s). Nic nie wychodzi z domu."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor spre serverul de la adresa pe care o scrii. Dacă serverul e în casa "
"ta, nimic nu iese din casă."
msgstr "Tekst napisów (tylko tekst, bez obrazu i bez dźwięku) wychodzi z odbiornika do serwera pod adresem, który wpisujesz. Jeśli serwer jest w twoim domu, nic nie wychodzi z domu."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor, prin internet, spre %s, care îl traduce. Cheia ta rămâne pe "
"receptor."
msgstr "Tekst napisów (tylko tekst, bez obrazu i bez dźwięku) wychodzi z odbiornika przez internet do usługi %s, która go tłumaczy. Twój klucz zostaje w odbiorniku."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Pentru Uniunea Europeană, Google spune că nici la nivelul gratuit nu "
"folosește textele trimise ca să-și îmbunătățească produsele."
msgstr "Dla Unii Europejskiej Google podaje, że nawet w darmowym planie nie używa wysłanych tekstów do ulepszania swoich produktów."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
