#: lib/python/Screens/HdsLocul.py
msgid "Află locul după internet"
msgstr "Ustal lokalizację przez internet"

#: lib/python/Screens/HdsLocul.py
msgid "Caut locul după adresa de internet a receptorului..."
msgstr "Szukam lokalizacji według adresu internetowego odbiornika..."

#: lib/python/Screens/HdsLocul.py
msgid "Receptorul nu are internet acum, deci locul nu se poate afla singur. Alege țara și orașul din listă."
msgstr "Odbiornik nie ma teraz internetu, więc lokalizacji nie da się ustalić samej. Wybierz kraj i miasto z listy."

#: lib/python/Screens/HdsLocul.py
msgid "Serverul HD Satelit nu a răspuns sau nu poate da locul acum. Alege țara și orașul din listă."
msgstr "Serwer HD Satelit nie odpowiedział albo nie może teraz podać lokalizacji. Wybierz kraj i miasto z listy."

#: lib/python/Screens/HdsLocul.py
msgid "Răspunsul serverului HD Satelit nu se poate folosi. Alege țara și orașul din listă."
msgstr "Odpowiedzi serwera HD Satelit nie da się użyć. Wybierz kraj i miasto z listy."

#: lib/python/Screens/HdsLocul.py
msgid "După adresa de internet a receptorului nu se știe orașul. Alege țara și orașul din listă."
msgstr "Na podstawie adresu internetowego odbiornika nie wiadomo, jakie to miasto. Wybierz kraj i miasto z listy."

#: lib/python/Screens/HdsLocul.py
msgid "Locul s-a cerut de prea multe ori de la această adresă de internet. Încearcă peste un minut sau alege țara și orașul din listă."
msgstr "Z tego adresu internetowego zbyt wiele razy pytano o lokalizację. Spróbuj za minutę albo wybierz kraj i miasto z listy."

#: lib/python/Screens/HdsLocul.py
msgid "Locul găsit nu mai este cel arătat. Caută din nou sau alege țara și orașul din listă."
msgstr "Znaleziona lokalizacja nie jest już tą pokazaną. Szukaj ponownie albo wybierz kraj i miasto z listy."

#: lib/python/Screens/HdsLocul.py
#, python-format
msgid ""
"Locul găsit după adresa de internet a receptorului:\n"
"\n"
"%(loc)s\n"
"%(coordonate)s\n"
"Sursa: %(sursa)s\n"
"\n"
"De obicei este orașul tău, dar uneori este orașul furnizorului de internet. Folosești acest loc? (Nu: alegi țara și orașul din listă.)"
msgstr ""
"Lokalizacja znaleziona według adresu internetowego odbiornika:\n"
"\n"
"%(loc)s\n"
"%(coordonate)s\n"
"Źródło: %(sursa)s\n"
"\n"
"Zwykle to twoje miasto, ale czasem miasto dostawcy internetu. Użyć tej lokalizacji? (Nie: wybierasz kraj i miasto z listy.)"

#: lib/python/Screens/HdsLocul.py
#, python-format
msgid "Coordonatele orașelor din listă: %s. Receptorul întreabă serverul HD Satelit numai când alegi „Află locul după internet”, iar serverul nu păstrează adresa de internet."
msgstr "Współrzędne miast z listy: %s. Odbiornik pyta serwer HD Satelit tylko wtedy, gdy wybierzesz „Ustal lokalizację przez internet”, a serwer nie przechowuje adresu internetowego."

#: lib/python/Screens/HdsLocul.py
msgid "prin serverul HD Satelit"
msgstr "przez serwer HD Satelit"

