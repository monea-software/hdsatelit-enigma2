msgstr "%s está en %s, pero esta posición no está en la lista del motor. Añádela en “Ajustes del sintonizador”."

#: lib/python/Screens/ScanerSatelit.py
#, python-format
msgid "Antena ta e fixă și vede numai: %s. %s se află pe %s, deci de aici nu se poate căuta."
msgstr "Tu antena es fija y solo ve: %s. %s está en %s, así que no se puede buscar desde aquí."

#: lib/python/Screens/ScanerSatelit.py
#, python-format
