msgstr "graves: la calidez de la música y de las voces masculinas"

#: lib/python/Screens/HdsEgalizator.py
msgid "partea de jos a vocilor și a instrumentelor"
msgstr "la parte baja de las voces y los instrumentos"

#: lib/python/Screens/HdsEgalizator.py
msgid "mijlocul de jos: prea mult sună înfundat"
msgstr "medios bajos: demasiado suena apagado"

#: lib/python/Screens/HdsEgalizator.py
msgid "mijlocul: corpul vocilor"
msgstr "medios: el cuerpo de las voces"

#: lib/python/Screens/HdsEgalizator.py
msgid "prezența vocilor: se înțeleg mai bine cuvintele"
msgstr "presencia de las voces: las palabras se entienden mejor"

#: lib/python/Screens/HdsEgalizator.py
msgid "claritatea: consoanele, chitarele"
msgstr "claridad: consonantes, guitarras"

#: lib/python/Screens/HdsEgalizator.py
msgid "strălucirea: talgerele, respirația vocii"
msgstr "brillo: platillos, respiración de la voz"

#: lib/python/Screens/HdsEgalizator.py
msgid "aerul: cele mai înalte sunete"
msgstr "aire: los sonidos más agudos"

#: data/menu.xml
msgid "Egalizator"
msgstr "Ecualizador"

