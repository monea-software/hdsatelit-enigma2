msgstr "Cargando el modelo en el ordenador... (%s, hasta un minuto)"

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Măsor viteza cu %s..."
msgstr "Midiendo la velocidad con %s..."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Cheia nu a mers la %s."
msgstr "La clave no ha funcionado en %s."

#: lib/python/Components/HdsConfigurareTraducere.py
