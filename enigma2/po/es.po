msgid "Renunță"
msgstr "Cancelar"

#: lib/python/Screens/HdsEgalizator.py
msgid "Păstrează"
msgstr "Guardar"

#: lib/python/Screens/HdsEgalizator.py
msgid "Presetarea următoare"
msgstr "Siguiente preajuste"

#: lib/python/Screens/HdsEgalizator.py
msgid "Pornit / Oprit"
msgstr "Encendido / Apagado"

#: lib/python/Screens/HdsEgalizator.py
msgid "Presetare"
msgstr "Preajuste"

#: lib/python/Screens/HdsEgalizator.py
msgid "Mod de noapte"
msgstr "Modo nocturno"

#: lib/python/Screens/HdsEgalizator.py
msgid "Pentru acest post"
msgstr "Para esta emisora"

#: lib/python/Screens/HdsEgalizator.py
msgid "Nivel"
msgstr "Nivel"

#: lib/python/Screens/HdsEgalizator.py
msgid "Fără post"
msgstr "Sin emisora"

#: lib/python/Screens/HdsEgalizator.py
msgid "Nu merge niciun post acum, deci reglajele se păstrează pentru toate posturile."
msgstr "Ahora no suena ninguna emisora, así que los ajustes se guardan para todas las emisoras."

#: lib/python/Screens/HdsEgalizator.py
msgid "Nivel: potrivești tăria sunetului cu egalizator față de sunetul obișnuit, între −12 și +12 dB."
msgstr "Nivel: iguala la intensidad del sonido con ecualizador a la del sonido habitual, entre −12 y +12 dB."

#: lib/python/Screens/HdsEgalizator.py
#, python-format
msgid "%s, %s. Sus și jos: cu 1 dB mai mult sau mai puțin, între −12 și +12 dB."
msgstr "%s, %s. Arriba y abajo: 1 dB más o menos, entre −12 y +12 dB."

#: lib/python/Screens/HdsEgalizator.py
msgid "acest post"
msgstr "esta emisora"

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Păstrat. Se aude și pe televizor."
msgstr "Guardado. También se oye en el televisor."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Volumul se alege cu auto, aici sau placa."
msgstr "El volumen se elige con auto, aici o placa."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Numele plăcii de sunet are numai litere, cifre și : , _ - ."
msgstr "El nombre del dispositivo de sonido solo tiene letras, cifras y : , _ - ."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Am pus înapoi reglajele păstrate."
msgstr "Se han restaurado los ajustes guardados."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Se aude acum. Apasă „Păstrează” ca să rămână."
msgstr "Se oye ahora. Pulsa „Guardar” para que se mantenga."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Presetarea „%s” nu există."
msgstr "El preajuste „%s” no existe."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Benzile se dau ca %d numere între %d și %d, cu virgulă între ele."
msgstr "Las bandas se indican como %d números entre %d y %d, separados por comas."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Nivelul se dă ca număr între %d și %d."
msgstr "El nivel se indica como un número entre %d y %d."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "„%s” se alege cu 1 (da) sau 0 (nu)."
msgstr "„%s” se elige con 1 (sí) o 0 (no)."

#: lib/python/Components/HdsEgalizator.py
msgid "Pauză. Sunetul revine cu egalizator când pornești din nou."
msgstr "Pausa. El sonido vuelve con ecualizador cuando reanudes la reproducción."

#: lib/python/Components/HdsEgalizator.py
msgid "La canalele TV egalizatorul nu merge încă: sunetul trebuie să rămână potrivit cu ce vezi pe ecran, deci merge prin placa de sunet. Egalizatorul lucrează la posturile de radio."
msgstr "En los canales de TV el ecualizador aún no funciona: el sonido debe seguir sincronizado con lo que ves en pantalla, así que va por el chip de sonido. El ecualizador funciona en las emisoras de radio."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul nu poate porni: receptorul nu are decodorul MPEG audio."
msgstr "El ecualizador no puede iniciarse: el receptor no tiene decodificador de audio MPEG."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul nu poate porni: lipsește decodarea sunetului în procesor (GStreamer)."
msgstr "El ecualizador no puede iniciarse: falta la decodificación del sonido en el procesador (GStreamer)."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul lipsește din programul acestui receptor. Setările se păstrează, dar nu se aud."
msgstr "El ecualizador falta en el software de este receptor. Los ajustes se guardan, pero no se oyen."

#: lib/python/Components/HdsEgalizator.py
msgid "ieșirea plăcii de sunet pentru procesor e oprită"
msgstr "la salida del chip de sonido para el procesador está apagada"

#: lib/python/Components/HdsEgalizator.py
msgid "receptorul nu are decodor AAC"
msgstr "el receptor no tiene decodificador AAC"

#: lib/python/Components/HdsEgalizator.py
msgid "receptorul nu are decodorul MPEG audio"
msgstr "el receptor no tiene decodificador de audio MPEG"

#: lib/python/Components/HdsEgalizator.py
msgid "lipsește decodarea sunetului în procesor"
msgstr "falta la decodificación del sonido en el procesador"

#: lib/python/Components/HdsEgalizator.py
msgid "placa de sunet nu se poate folosi din procesor"
msgstr "el chip de sonido no se puede usar desde el procesador"

#: lib/python/Components/HdsEgalizator.py
msgid "felul acesta de AAC nu se poate decoda încă"
msgstr "este tipo de AAC aún no se puede decodificar"

#: lib/python/Components/HdsEgalizator.py
msgid "fișierul probei nu există"
msgstr "el archivo de prueba no existe"

#: lib/python/Components/HdsEgalizator.py
msgid "fișierul probei nu s-a putut scrie"
msgstr "no se pudo escribir el archivo de prueba"

#: lib/python/Components/HdsEgalizator.py
msgid "o eroare neașteptată"
msgstr "un error inesperado"

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Probă din fișier, cu egalizator: %s. Proba merge și cu egalizatorul oprit."
msgstr "Prueba desde archivo, con ecualizador: %s. La prueba funciona también con el ecualizador apagado."

#: lib/python/Components/HdsEgalizator.py
msgid "decodat în procesor"
msgstr "decodificado en el procesador"

#: lib/python/Screens/HdsEgalizator.py
msgid "Păstrezi schimbările?"
msgstr "¿Guardar los cambios?"

#: lib/python/Screens/HdsEgalizator.py
msgid "Pornit, sunetul posturilor de radio trece prin procesor și se aude cu reglajele de mai jos."
msgstr "Encendido, el sonido de las emisoras de radio pasa por el procesador y se oye con los ajustes de abajo."

#: lib/python/Screens/HdsEgalizator.py
msgid "Presetarea pune singură toate benzile; apoi le poți potrivi una câte una. Barele din spate: cât de tare se aude acum fiecare bandă."
msgstr "El preajuste coloca todas las bandas; después puedes ajustarlas una a una. Las barras del fondo: lo fuerte que suena ahora cada banda."

#: lib/python/Screens/HdsEgalizator.py
msgid "Modul de noapte: sunetele tari devin mai încete, cele încete mai tari. Potrivit seara, când asculți încet."
msgstr "Modo nocturno: los sonidos fuertes bajan y los suaves suben. Útil por la noche, cuando escuchas bajo."

#: lib/python/Screens/HdsEgalizator.py
#, python-format
msgid "Da: reglajele de aici se țin minte numai pentru %s. Nu: postul folosește reglajele obișnuite, ale tuturor posturilor, pe care le vezi aici."
msgstr "Sí: los ajustes de aquí se guardan solo para %s. No: la emisora usa los ajustes habituales de todas las emisoras, que ves aquí."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. OK: pornești sau oprești. EXIT: ieși."
msgstr "Izquierda y derecha: elegir. OK: encender o apagar. EXIT: salir."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. Sus, jos sau OK: presetarea următoare. EXIT: ieși."
msgstr "Izquierda y derecha: elegir. Arriba, abajo u OK: siguiente preajuste. EXIT: salir."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. OK: da sau nu. EXIT: ieși."
msgstr "Izquierda y derecha: elegir. OK: sí o no. EXIT: salir."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. Sus și jos: schimbi. OK: păstrezi și închizi."
msgstr "Izquierda y derecha: elegir. Arriba y abajo: cambiar. OK: guardar y cerrar."

#: lib/python/Components/HdsEgalizator.py
msgid "La acest post (AAC) egalizatorul nu e disponibil din motive de licențiere a brevetelor AAC."
msgstr "En esta emisora (AAC) el ecualizador no está disponible por motivos de licencias de patentes AAC."

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Postul acesta are sunet %s. Egalizatorul lucrează la posturile cu sunet MPEG (MP2)."
msgstr "Esta emisora tiene sonido %s. El ecualizador funciona en emisoras con sonido MPEG (MP2)."

