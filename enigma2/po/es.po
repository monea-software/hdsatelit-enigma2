msgstr "El receptor no responde. El envío se ha detenido."

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "Receptorul nu răspunde. Verifică dacă telefonul e în aceeași rețea cu receptorul."
msgstr "El receptor no responde. Comprueba que el teléfono esté en la misma red que el receptor."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Receptorul nu răspunde. Verifică să fie pornit și în aceeași rețea."
msgstr "El receptor no responde. Comprueba que esté encendido y en la misma red."

