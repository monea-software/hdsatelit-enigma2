msgstr "Buscando servidores en la red doméstica..."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Am pornit căutarea."
msgstr "He empezado la búsqueda."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Am găsit un server."
msgstr "He encontrado un servidor."

#: lib/python/Components/HdsConfigurareTraducere.py
