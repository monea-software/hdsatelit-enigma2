msgstr "Los modelos probados no han dado ninguna traducción."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Alege alt model din listă, sau un serviciu din internet."
msgstr "Elige otro modelo de la lista, o un servicio de internet."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Setările nu s-au putut salva."
msgstr "No se han podido guardar los ajustes."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Încearcă din nou."
msgstr "Vuelve a intentarlo."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Încearcă din nou; dacă se repetă, repornește receptorul."
msgstr "Vuelve a intentarlo; si se repite, reinicia el receptor."

#: lib/python/Components/HdsConfigurareTraducere.py
