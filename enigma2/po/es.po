#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Căutarea nu e în această imagine."
msgstr "La búsqueda no está en esta imagen."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Se caută în rețeaua de acasă..."
msgstr "Buscando en la red doméstica..."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Nu am găsit niciun server în rețeaua de acasă."
msgstr "No se ha encontrado ningún servidor en la red doméstica."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Ollama la %s, modelul %s"
msgstr "Ollama en %s, modelo %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "LibreTranslate la %s"
msgstr "LibreTranslate en %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Am găsit %d. Alege serverul."
msgstr "Encontrados: %d. Elige el servidor."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Se probează serverul..."
msgstr "Probando el servidor..."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Se caută în rețeaua de acasă... %d din %d"
msgstr "Buscando en la red doméstica... %d de %d"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Fără limită, mai lent pe calculatoarele obișnuite"
msgstr "Sin límite, más lento en ordenadores normales"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Recomandat pentru subtitrări zilnice"
msgstr "Recomendado para subtítulos a diario"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cel mai simplu de pornit, fără card; se poate opri dacă te uiți mult"
msgstr "Lo más fácil de poner en marcha, sin tarjeta; puede pararse si ves mucho"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Formular"
msgstr "Formulario"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Text simplu"
msgstr "Texto simple"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Lista serviciilor de rezervă nu e bună (un serviciu necunoscut, unul de două "
"ori sau chiar cel principal). Nu s-a schimbat nimic."
msgstr "La lista de servicios de reserva no es válida (un servicio desconocido, uno repetido o incluso el principal). No se ha cambiado nada."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Adresă proprie"
msgstr "Dirección propia"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid "locul {text} în adresă (sau, la POST, în corp)"
msgstr "el marcador {text} en la dirección (o, con POST, en el cuerpo)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"o adresă https:// (http:// merge numai pentru un server din rețeaua de acasă)"
msgstr "una dirección https:// (http:// solo funciona para un servidor de la red doméstica)"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"un corp JSON bun (pune locurile între ghilimele, de exemplu \"q\": "
"\"{text}\")"
msgstr "un cuerpo JSON válido (pon los marcadores entre comillas, por ejemplo \"q\": \"{text}\")"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "un nume de antet bun (litere, cifre și - _ ., de exemplu Authorization)"
msgstr "un nombre de encabezado válido (letras, cifras y - _ ., por ejemplo Authorization)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"calea traducerii în răspunsul JSON (chei și numere despărțite prin punct, de "
"exemplu translatedText)"
msgstr "la ruta de la traducción en la respuesta JSON (claves y números separados por punto, por ejemplo translatedText)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Lipsește regiunea resursei Azure: o găsești în portal, la resursa "
"Translator, Overview › Location (de exemplu Germany West Central = "
"germanywestcentral)."
msgstr "Falta la región del recurso de Azure: la encuentras en el portal, en el recurso Translator, Overview › Location (por ejemplo Germany West Central = germanywestcentral)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Cheia sau regiunea nu se potrivesc: verifică amândouă în portal (Keys and "
"Endpoint)."
msgstr "La clave y la región no coinciden: comprueba las dos en el portal (Keys and Endpoint)."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Serverul de la adresa ta a răspuns cu eroarea HTTP %d. Începutul "
"răspunsului: „%s”"
msgstr "El servidor de tu dirección ha respondido con el error HTTP %d. Inicio de la respuesta: «%s»"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Răspunsul serverului nu e JSON (dacă serverul dă numai traducerea, alege "
"„Text simplu” la răspuns). Începutul răspunsului: „%s”"
msgstr "La respuesta del servidor no es JSON (si el servidor solo da la traducción, elige «Texto simple» en la respuesta). Inicio de la respuesta: «%s»"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Calea „%s” nu găsește nicio traducere în răspunsul serverului. Începutul "
"răspunsului: „%s”"
msgstr "La ruta «%s» no encuentra ninguna traducción en la respuesta del servidor. Inicio de la respuesta: «%s»"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Serverul nu a dat nicio traducere. Începutul răspunsului: „%s”"
msgstr "El servidor no ha dado ninguna traducción. Inicio de la respuesta: «%s»"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Traducerea subtitrărilor vine prea târziu: serverul răspunde în %s, în "
"medie. Alege un serviciu din internet (Gemini, gratuit, fără card) sau un "
"model mai mic."
msgstr "La traducción de subtítulos llega demasiado tarde: el servidor responde en %s, de media. Elige un servicio de internet (Gemini, gratis, sin tarjeta) o un modelo más pequeño."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "%s a ajuns la limita gratuită pe zi (sau pe lună)."
msgstr "%s ha llegado al límite gratuito diario (o mensual)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Traducerea s-a oprit până se reînnoiește limita. Ca să meargă și atunci, "
"pune servicii de rezervă în Meniu › Setări › Sunet și subtitrări › "
"Traducerea subtitrărilor."
msgstr "La traducción se ha detenido hasta que se renueve el límite. Para que funcione también entonces, pon servicios de reserva en Menú › Parámetros › Audio y pistas de sonido › Traducción de subtítulos."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"De exemplu Azure Translator: Free F0, 2.000.000 de caractere pe lună, "
"gratuit."
msgstr "Por ejemplo Azure Translator: Free F0, 2.000.000 de caracteres al mes, gratis."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Traducerea subtitrărilor s-a oprit până schimbi setările: %s"
msgstr "La traducción de subtítulos se ha detenido hasta que cambies los ajustes: %s"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Am găsit regiunea: %s (%s)."
msgstr "Región encontrada: %s (%s)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Cel mai simplu: pornește serverul pe calculator (pașii de mai jos), apoi "
"apasă „Caută în rețeaua de acasă”, pe televizor sau pe telefon. Receptorul "
"găsește singur serverul; nu mai trebuie să scrii adresa."
msgstr "Lo más sencillo: inicia el servidor en el ordenador (los pasos de abajo) y luego pulsa «Buscar en la red doméstica», en el televisor o en el teléfono. El receptor encuentra solo el servidor; ya no hace falta escribir la dirección."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Prima dată, Windows poate întreba dacă lași programul să primească conexiuni "
"din rețea: apasă „Allow access”. Dacă receptorul tot nu găsește serverul: "
"Windows Security, Firewall & network protection, „Allow an app through "
"firewall”, „Change settings” și bifează programul (Ollama, LM Studio sau "
"Docker) la „Private”. Rețeaua de acasă trebuie să fie „Private network” "
"(Settings, Network & internet, rețeaua ta, „Network profile type”)."
msgstr "La primera vez, Windows puede preguntar si dejas que el programa reciba conexiones de la red: pulsa «Allow access». Si el receptor sigue sin encontrar el servidor: Windows Security, Firewall & network protection, «Allow an app through firewall», «Change settings» y marca el programa (Ollama, LM Studio o Docker) en «Private». La red doméstica tiene que ser «Private network» (Settings, Network & internet, tu red, «Network profile type»)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"2.000.000 de caractere pe lună, gratuit (Free F0). E alegerea recomandată "
"pentru subtitrări multe (filme întregi, în fiecare zi), ca serviciu "
"principal sau de rezervă. Cardul se cere la înscriere numai pentru "
"verificare; pe Free F0 nu se plătește nimic. După 30 de zile contul trebuie "
"trecut pe „Pay as you go”, tot fără cost cât resursa rămâne Free F0."
msgstr "2.000.000 de caracteres al mes, gratis (Free F0). Es la opción recomendada para muchos subtítulos (películas enteras, cada día), como servicio principal o de reserva. La tarjeta se pide al registrarte solo para verificación; en Free F0 no se paga nada. Pasados 30 días hay que cambiar la cuenta a «Pay as you go», también sin coste mientras el recurso siga en Free F0."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Pentru subtitrări multe (filme întregi, în fiecare zi) pune în setări și "
"servicii de rezervă, de exemplu Azure Translator: când Gemini dă eroarea "
"429, receptorul trece singur la următorul. Lista se face din servicii "
"diferite: limita Gemini e pe proiect, iar mai multe conturi făcute ca să "
"aduni limitele gratuite înseamnă ocolirea limitelor, pe care termenii Google "
"o interzic."
msgstr "Para muchos subtítulos (películas enteras, cada día) pon también servicios de reserva en los ajustes, por ejemplo Azure Translator: cuando Gemini da el error 429, el receptor pasa solo al siguiente. La lista se hace con servicios distintos: el límite de Gemini es por proyecto, y varias cuentas creadas para sumar los límites gratuitos suponen eludir los límites, algo que los términos de Google prohíben."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Gratuit pentru folosire ocazională, cu un număr limitat de cereri pe minut "
"și pe zi; Google arată cifrele numai în contul tău. La subtitrări fără pauză "
"poate da eroarea 429 după câteva minute, iar limita pe zi se poate termina."
msgstr "Gratis para un uso ocasional, con un número limitado de solicitudes por minuto y por día; Google muestra las cifras solo en tu cuenta. Con subtítulos sin pausa puede dar el error 429 tras unos minutos, y el límite diario se puede agotar."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Peste limita pe minut, cererile primesc eroarea 429 câteva secunde: "
"receptorul așteaptă cât spune Google și trece între timp la serviciul de "
"rezervă, dacă ai pus unul. Peste limita pe zi, până a doua zi (în jurul orei "
"10, ora României). Fără card nu se plătește nimic."
msgstr "Por encima del límite por minuto, las solicitudes reciben el error 429 durante unos segundos: el receptor espera lo que dice Google y mientras tanto pasa al servicio de reserva, si has puesto uno. Por encima del límite diario, hasta el día siguiente (hacia las 10, hora de Rumanía). Sin tarjeta no se paga nada."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În casă: instalează Ollama de pe ollama.com pe un calculator și pornește-l."
msgstr "En casa: instala Ollama desde ollama.com en un ordenador y ábrelo."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În PowerShell scrie: ollama pull gemma3:4b (3,3 GB). gemma3:12b traduce mai "
"bine, dar e mai lent (8,1 GB); pentru un calculator slab, gemma3:1b (815 "
"MB). Modelele qwen2.5 traduc slab în română."
msgstr "En PowerShell escribe: ollama pull gemma3:4b (3,3 GB). gemma3:12b traduce mejor, pero es más lento (8,1 GB); para un ordenador poco potente, gemma3:1b (815 MB). Los modelos qwen2.5 traducen mal al rumano."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Ca să-l vadă receptorul: deschide Ollama, intră în Settings și pornește "
"„Expose Ollama to the network” (Ollama 0.9.5 sau mai nou; numele poate fi "
"puțin altul). Dacă nu găsești setarea: închide Ollama de lângă ceas "
"(„Quit”), caută în Start „environment variables” („variabile de mediu”), "
"adaugă la contul tău OLLAMA_HOST cu valoarea 0.0.0.0:11434, apasă OK și "
"pornește din nou Ollama."
msgstr "Para que el receptor lo vea: abre Ollama, entra en Settings y activa «Expose Ollama to the network» (Ollama 0.9.5 o más reciente; el nombre puede ser un poco distinto). Si no encuentras el ajuste: cierra Ollama junto al reloj («Quit»), busca en Inicio «environment variables» («variables de entorno»), añade a tu cuenta OLLAMA_HOST con el valor 0.0.0.0:11434, pulsa OK y abre Ollama de nuevo."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Fără căutare: scrie aici adresa http://IP-UL-CALCULATORULUI:11434 și modelul "
"gemma3:4b. Cheie nu trebuie."
msgstr "Sin búsqueda: escribe aquí la dirección http://IP-DEL-ORDENADOR:11434 y el modelo gemma3:4b. No hace falta clave."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"LM Studio merge la fel: fila „Developer”, „Start server”, apoi în setările "
"serverului „Serve on Local Network”, cu „Require Authentication” oprit; "
"adresa http://IP-UL-CALCULATORULUI:1234 și numele modelului din LM Studio."
msgstr "LM Studio funciona igual: pestaña «Developer», «Start server» y luego, en los ajustes del servidor, «Serve on Local Network», con «Require Authentication» desactivado; la dirección http://IP-DEL-ORDENADOR:1234 y el nombre del modelo en LM Studio."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"„Adresă proprie” e pentru un server de traducere ales de tine, de exemplu un "
"LibreTranslate pornit pe un calculator din casă. Receptorul trimite fiecare "
"rând de subtitrare într-o cerere separată."
msgstr "«Dirección propia» es para un servidor de traducción elegido por ti, por ejemplo un LibreTranslate en marcha en un ordenador de casa. El receptor envía cada línea de subtítulo en una petición aparte."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Adresa e un șablon: scrii adresa serverului și pui în ea locurile {text} "
"(textul de tradus), {sursa} (limba subtitrării, sau auto când nu se știe) și "
"{tinta} (limba traducerii, de exemplu ro). Receptorul le înlocuiește la "
"fiecare cerere."
msgstr "La dirección es una plantilla: escribes la dirección del servidor y pones en ella los marcadores {text} (el texto que se traduce), {sursa} (el idioma del subtítulo, o auto cuando no se sabe) y {tinta} (el idioma de la traducción, por ejemplo ro). El receptor los sustituye en cada petición."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Adresa începe cu https://. O adresă http:// merge numai pentru un server din "
"rețeaua de acasă (de exemplu 192.168.1.50). Nume și parolă nu se scriu în "
"adresă."
msgstr "La dirección empieza por https://. Una dirección http:// solo funciona para un servidor de la red doméstica (por ejemplo 192.168.1.50). El nombre y la contraseña no se escriben en la dirección."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Metoda GET trimite totul în adresă, deci {text} trebuie să fie în adresă. "
"Metoda POST trimite și un corp, cu aceleași locuri: JSON (pune locurile "
"între ghilimele, de exemplu \"q\": \"{text}\") sau formular (de exemplu "
"q={text}&target={tinta})."
msgstr "El método GET lo envía todo en la dirección, así que {text} tiene que estar en la dirección. El método POST envía también un cuerpo, con los mismos marcadores: JSON (pon los marcadores entre comillas, por ejemplo \"q\": \"{text}\") o formulario (por ejemplo q={text}&target={tinta})."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Antetul e opțional: dacă serverul cere o cheie, scrie numele antetului (de "
"exemplu Authorization) și, la valoare, ce cere serverul (de exemplu Bearer, "
"un spațiu și cheia). Valoarea se păstrează criptată pe receptor și nu se mai "
"arată."
msgstr "El encabezado es opcional: si el servidor pide una clave, escribe el nombre del encabezado (por ejemplo Authorization) y, como valor, lo que pide el servidor (por ejemplo Bearer, un espacio y la clave). El valor se guarda cifrado en el receptor y no se vuelve a mostrar."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Răspunsul: alege „Text simplu” dacă serverul dă numai traducerea. Pentru "
"JSON scrie calea până la traducere: numele cheilor și numerele pozițiilor "
"(de la 0), despărțite prin punct, de exemplu translatedText sau "
"data.translations.0.translatedText. Cu * iei toate elementele, lipite în "
"ordine, de exemplu 0.*.0."
msgstr "La respuesta: elige «Texto simple» si el servidor solo da la traducción. Para JSON escribe la ruta hasta la traducción: los nombres de las claves y los números de las posiciones (desde 0), separados por punto, por ejemplo translatedText o data.translations.0.translatedText. Con * tomas todos los elementos, unidos en orden, por ejemplo 0.*.0."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Exemplu, un LibreTranslate al tău din casă: adresa "
"http://192.168.1.50:5000/translate, metoda POST, corpul JSON {\"q\": "
"\"{text}\", \"source\": \"{sursa}\", \"target\": \"{tinta}\", \"format\": "
"\"text\"}, răspunsul JSON, calea translatedText."
msgstr "Ejemplo, tu propio LibreTranslate en casa: la dirección http://192.168.1.50:5000/translate, el método POST, el cuerpo JSON {\"q\": \"{text}\", \"source\": \"{sursa}\", \"target\": \"{tinta}\", \"format\": \"text\"}, la respuesta JSON, la ruta translatedText."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Exemplu cu GET: adresa "
"https://example.com/translate?q={text}&from={sursa}&to={tinta} și răspunsul "
"„Text simplu” (example.com ține locul serverului tău)."
msgstr "Ejemplo con GET: la dirección https://example.com/translate?q={text}&from={sursa}&to={tinta} y la respuesta «Texto simple» (example.com ocupa el lugar de tu servidor)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Apasă „Probează traducerea”. Dacă nu merge, mesajul arată începutul "
"răspunsului serverului, ca să vezi unde e traducerea și ce cale să scrii."
msgstr "Pulsa «Probar la traducción». Si no funciona, el mensaje muestra el inicio de la respuesta del servidor, para que veas dónde está la traducción y qué ruta escribir."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Depinde de server. Un server al tău din casă nu are cotă."
msgstr "Depende del servidor. Un servidor tuyo en casa no tiene cuota."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Depinde de server."
msgstr "Depende del servidor."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cum folosești o adresă proprie"
msgstr "Cómo usar una dirección propia"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor, prin internet, spre serverul de la adresa scrisă de tine (%s), "
"care îl traduce."
msgstr "El texto de los subtítulos (solo el texto, sin imagen y sin sonido) sale del receptor, por internet, hacia el servidor de la dirección que has escrito (%s), que lo traduce."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Ollama ascultă din fabrică numai pe calculatorul lui. În Ollama 0.9.5 sau "
"mai nou: Settings, pornește „Expose Ollama to the network”."
msgstr "De fábrica, Ollama solo escucha en su propio ordenador. En Ollama 0.9.5 o más reciente: Settings, activa «Expose Ollama to the network»."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Sau: închide Ollama de lângă ceas, pune variabila de mediu OLLAMA_HOST cu "
"valoarea 0.0.0.0:11434 și pornește din nou Ollama."
msgstr "O bien: cierra Ollama junto al reloj, pon la variable de entorno OLLAMA_HOST con el valor 0.0.0.0:11434 y abre Ollama de nuevo."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"LM Studio: fila „Developer”, „Start server” și „Serve on Local Network”. "
"Căutarea nu-l găsește: scrie adresa de mână (portul 1234), ca server "
"compatibil OpenAI."
msgstr "LM Studio: pestaña «Developer», «Start server» y «Serve on Local Network». La búsqueda no lo encuentra: escribe la dirección a mano (puerto 1234), como servidor compatible con OpenAI."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Windows: la întrebarea paravanului apasă „Allow access”. Altfel: Windows "
"Security, „Allow an app through firewall”, bifează Ollama la „Private”."
msgstr "Windows: cuando pregunte el cortafuegos, pulsa «Allow access». Si no: Windows Security, «Allow an app through firewall», marca Ollama en «Private»."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Rețeaua de acasă pe calculator trebuie să fie „Private network” (Settings › "
"Network & internet), iar receptorul și calculatorul în același router."
msgstr "En el ordenador, la red doméstica tiene que ser «Private network» (Settings › Network & internet), y el receptor y el ordenador, en el mismo router."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Traducerea subtitrărilor e gata, cu %s. Proba: %s"
msgstr "La traducción de subtítulos está lista, con %s. Prueba: %s"

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Traducerea subtitrărilor e pornită, cu %s, dar cota gratuită s-a terminat. "
"Merge din nou după ce se reface cota."
msgstr "La traducción de subtítulos está activada, con %s, pero la cuota gratuita se ha agotado. Vuelve a funcionar cuando se renueve la cuota."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Traducerea subtitrărilor e pornită, cu %s (fără probă)."
msgstr "La traducción de subtítulos está activada, con %s (sin prueba)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Server compatibil OpenAI"
msgstr "Servidor compatible con OpenAI"

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Serviciul ales nu are adresă de server."
msgstr "El servicio elegido no tiene dirección de servidor."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Scrie adresa serverului, de exemplu http://192.168.1.50:%d."
msgstr "Escribe la dirección del servidor, por ejemplo http://192.168.1.50:%d."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Adresa are spații sau caractere care nu pot fi într-o adresă."
msgstr "La dirección tiene espacios o caracteres que no pueden ir en una dirección."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Portul din adresă nu e bun: trebuie un număr între 1 și 65535."
msgstr "El puerto de la dirección no es correcto: tiene que ser un número entre 1 y 65535."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Adresa trebuie să înceapă cu http:// sau https://."
msgstr "La dirección tiene que empezar por http:// o https://."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Adresa nu poate avea nume de utilizator sau parolă. Scrie numai adresa "
"serverului; cheia, dacă serverul cere una, se pune separat."
msgstr "La dirección no puede llevar nombre de usuario ni contraseña. Escribe solo la dirección del servidor; la clave, si el servidor pide una, se pone aparte."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Adresa nu are numele sau IP-ul serverului."
msgstr "La dirección no tiene el nombre ni la IP del servidor."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Serverul de la %s cere o cheie. Scrie cheia serverului, sau pornește "
"serverul fără cheie."
msgstr "El servidor en la dirección %s pide una clave. Escribe la clave del servidor, o inicia el servidor sin clave."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "adresa scrisă"
msgstr "indicada"

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Copiaz-o întreagă din pagina cheii, fără spații. Cheia pentru Gemini se face "
"pe aistudio.google.com/apikey."
msgstr "Cópiala entera desde la página de la clave, sin espacios. La clave para Gemini se crea en aistudio.google.com/apikey."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Cheia e bună, dar în proiectul ei nu e pornit „Cloud Translation API”. În "
"Google Cloud (console.cloud.google.com) mergi la „APIs & Services”, caută "
"„Cloud Translation API”, apasă „Enable”, așteaptă câteva minute și încearcă "
"din nou."
msgstr "La clave es buena, pero en su proyecto no está activada «Cloud Translation API». En Google Cloud (console.cloud.google.com) ve a «APIs & Services», busca «Cloud Translation API», pulsa «Enable», espera unos minutos y vuelve a intentarlo."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Copiaz-o întreagă din pagina cheii "
"(console.cloud.google.com/apis/credentials), fără spații. În proiectul cheii "
"pornește „Cloud Translation API” și verifică să nu fie cheia restrânsă la "
"alt API."
msgstr "Cópiala entera desde la página de la clave (console.cloud.google.com/apis/credentials), sin espacios. En el proyecto de la clave activa «Cloud Translation API» y comprueba que la clave no esté limitada a otra API."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Copiaz-o întreagă din portal (resursa Translator, „Keys and Endpoint”, KEY "
"1), fără spații, și verifică regiunea: scrisă exact ca în portal (de exemplu "
"westeurope), sau Global dacă resursa e globală."
msgstr "Cópiala entera desde el portal (recurso Translator, «Keys and Endpoint», KEY 1), sin espacios, y comprueba la región: escrita exactamente como en el portal (por ejemplo westeurope), o Global si el recurso es global."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Copiaz-o întreagă din pagina cheilor DeepL "
"(www.deepl.com/your-account/keys), fără spații. Trebuie o cheie de la DeepL "
"API, nu de la traducătorul obișnuit."
msgstr "Cópiala entera desde la página de claves de DeepL (www.deepl.com/your-account/keys), sin espacios. Tiene que ser una clave de DeepL API, no del traductor normal."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Copiaz-o întreagă din pagina cheilor (%s), fără spații."
msgstr "Cópiala entera desde la página de claves (%s), sin espacios."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Copiaz-o întreagă din pagina cheii, fără spații, și încearcă din nou."
msgstr "Cópiala entera desde la página de la clave, sin espacios, y vuelve a intentarlo."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota (la Gemini, de obicei a doua zi, în jurul orei 10, ora României)."
msgstr "La clave es buena, pero la cuota se ha agotado. La traducción vuelve a funcionar cuando se renueve la cuota (en Gemini, normalmente al día siguiente, hacia las 10, hora de Rumanía)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota (la Azure, luna următoare)."
msgstr "La clave es buena, pero la cuota se ha agotado. La traducción vuelve a funcionar cuando se renueve la cuota (en Azure, el mes siguiente)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota."
msgstr "La clave es buena, pero la cuota se ha agotado. La traducción vuelve a funcionar cuando se renueve la cuota."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Serverul a răspuns prea încet."
msgstr "El servidor ha respondido demasiado despacio."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Verifică dacă serverul de la %s e pornit și dacă receptorul îl vede (același "
"router)."
msgstr "Comprueba que el servidor en la dirección %s está encendido y que el receptor lo ve (el mismo router)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"La Ollama, pe calculator trebuie OLLAMA_HOST=0.0.0.0:11434 (vezi "
"instrucțiunile)."
msgstr "Para Ollama, el ordenador necesita OLLAMA_HOST=0.0.0.0:11434 (mira las instrucciones)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Verifică internetul receptorului (Meniu › Setări › Rețea) și încearcă din "
"nou."
msgstr "Comprueba el internet del receptor (Menú › Parámetros › Red e Internet) y vuelve a intentarlo."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Pornește serverul LibreTranslate și cu limba „%s” (de exemplu --load-only "
"en,ro,de,fr,it,es,hu)."
msgstr "Inicia el servidor LibreTranslate también con el idioma «%s» (por ejemplo --load-only en,ro,de,fr,it,es,hu)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Serviciul nu traduce în limba aleasă. Alege altă limbă în setările "
"traducerii."
msgstr "El servicio no traduce al idioma elegido. Elige otro idioma en los ajustes de la traducción."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"La adresa asta nu răspunde LibreTranslate. Verifică adresa și portul (de "
"obicei 5000)."
msgstr "En esta dirección no responde LibreTranslate. Comprueba la dirección y el puerto (normalmente 5000)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Modelul nu e pe server. Alege alt model din listă."
msgstr "El modelo no está en el servidor. Elige otro modelo de la lista."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Contul nu are credit pentru acest model. Cumpără credit sau alege alt model."
msgstr "La cuenta no tiene crédito para este modelo. Compra crédito o elige otro modelo."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Serverul a răspuns neașteptat. Verifică adresa și portul și încearcă din nou."
msgstr "El servidor ha respondido de forma inesperada. Comprueba la dirección y el puerto y vuelve a intentarlo."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Serviciul a răspuns neașteptat. Încearcă din nou peste câteva minute."
msgstr "El servicio ha respondido de forma inesperada. Vuelve a intentarlo dentro de unos minutos."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Proba a durat %s secunde: serverul e prea lent ca subtitrările traduse să "
"apară la timp; vor veni târziu, după original."
msgstr "La prueba ha durado %s segundos: el servidor es demasiado lento para que los subtítulos traducidos lleguen a tiempo; llegarán tarde, después del original."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Folosește un serviciu din internet (Gemini, gratuit, fără card) sau un model "
"mai mic (de exemplu gemma3:4b)."
msgstr "Usa un servicio de internet (Gemini, gratis, sin tarjeta) o un modelo más pequeño (por ejemplo gemma3:4b)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Folosește un serviciu din internet (Gemini, gratuit, fără card)."
msgstr "Usa un servicio de internet (Gemini, gratis, sin tarjeta)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Încearcă un model mai mic sau alt serviciu (Gemini, gratuit, fără card)."
msgstr "Prueba un modelo más pequeño u otro servicio (Gemini, gratis, sin tarjeta)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Configurarea s-a oprit neașteptat."
msgstr "La configuración se ha detenido de forma inesperada."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Lipește cheia."
msgstr "Pega la clave."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Cheia are caractere care nu pot fi într-o cheie, sau e prea lungă. Copiaz-o "
"din nou, întreagă."
msgstr "La clave tiene caracteres que no pueden ir en una clave, o es demasiado larga. Cópiala otra vez, entera."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Nu recunosc cheia după formă. Alege serviciul din listă și încearcă din nou; "
"cheia nu a plecat nicăieri."
msgstr "No reconozco la clave por su forma. Elige el servicio de la lista y vuelve a intentarlo; la clave no se ha enviado a ninguna parte."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Regiunea nu e bună: scrie-o exact ca în portalul Azure, de exemplu "
"westeurope."
msgstr "La región no es correcta: escríbela exactamente como en el portal de Azure, por ejemplo westeurope."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Pentru un server din casă scrie întâi adresa lui (pasul cu adresa "
"serverului)."
msgstr "Para un servidor de tu casa, escribe primero su dirección (el paso de la dirección del servidor)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Merge deja o configurare. Așteaptă să se termine."
msgstr "Ya hay una configuración en marcha. Espera a que termine."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Recunosc cheia..."
msgstr "Reconociendo la clave..."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Am pornit verificarea cheii."
msgstr "He empezado a comprobar la clave."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Serverul poate fi numai LibreTranslate sau compatibil OpenAI."
msgstr "El servidor solo puede ser LibreTranslate o compatible con OpenAI."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Numele modelului nu e bun."
msgstr "El nombre del modelo no es correcto."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Cheia are caractere care nu pot fi într-o cheie, sau e prea lungă."
msgstr "La clave tiene caracteres que no pueden ir en una clave, o es demasiado larga."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Mă uit la server..."
msgstr "Mirando el servidor..."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Am pornit verificarea serverului."
msgstr "He empezado a comprobar el servidor."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Alege un model din listă."
msgstr "Elige un modelo de la lista."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Setările traducerii nu se pot citi."
msgstr "No se pueden leer los ajustes de la traducción."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Modelul se schimbă numai la Gemini și la serverele compatibile OpenAI."
msgstr "El modelo solo se cambia en Gemini y en los servidores compatibles con OpenAI."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Pentru Gemini lipsește cheia. Pune întâi cheia."
msgstr "Para Gemini falta la clave. Pon primero la clave."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Pentru serverul compatibil OpenAI lipsește adresa. Pune întâi adresa."
msgstr "Para el servidor compatible con OpenAI falta la dirección. Pon primero la dirección."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Probez modelul %s..."
msgstr "Probando el modelo %s..."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Am pornit proba modelului."
msgstr "He empezado la prueba del modelo."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Serverul nu dă lista modelelor (HTTP %s)."
msgstr "El servidor no da la lista de modelos (HTTP %s)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Serverul nu dă lista modelelor."
msgstr "El servidor no da la lista de modelos."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Verifică adresa, sau scrie numele modelului."
msgstr "Comprueba la dirección, o escribe el nombre del modelo."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "La adresa asta nu răspunde un server LibreTranslate (HTTP %s)."
msgstr "En esta dirección no responde ningún servidor LibreTranslate (HTTP %s)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "La adresa asta nu răspunde un server LibreTranslate."
msgstr "En esta dirección no responde ningún servidor LibreTranslate."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
