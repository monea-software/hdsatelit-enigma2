msgstr "Il servizio scelto non ha un indirizzo del server."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Scrie adresa serverului, de exemplu http://192.168.1.50:%d."
msgstr "Scrivi l’indirizzo del server, per esempio http://192.168.1.50:%d."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Adresa are spații sau caractere care nu pot fi într-o adresă."
msgstr "L’indirizzo ha spazi o caratteri che non possono stare in un indirizzo."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Portul din adresă nu e bun: trebuie un număr între 1 și 65535."
msgstr "La porta nell’indirizzo non va bene: serve un numero tra 1 e 65535."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Adresa trebuie să înceapă cu http:// sau https://."
msgstr "L’indirizzo deve iniziare con http:// o https://."

#: lib/python/Components/HdsConfigurareTraducere.py
