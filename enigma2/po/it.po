msgstr "La traduzione dei sottotitoli è attiva, con %s (senza prova)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Server compatibil OpenAI"
msgstr "Server compatibile con OpenAI"

#: lib/python/Components/HdsConfigurareTraducere.py
