#: lib/python/Components/HdsProcesor.py lib/python/Plugins/Extensions/HdsWebControl/procesor_web.py
msgid "Temperatura în ultimele 30 de minute"
msgstr "Temperatura negli ultimi 30 minuti"

#: lib/python/Components/HdsProcesor.py lib/python/Plugins/Extensions/HdsWebControl/procesor_web.py
#, python-format
msgid "Istoricul începe de la %s."
msgstr "La cronologia inizia alle %s."

#: lib/python/Components/HdsProcesor.py lib/python/Plugins/Extensions/HdsWebControl/procesor_web.py
#, python-format
msgid "Istoricul începe acum %s."
msgstr "La cronologia inizia %s fa."

#: lib/python/Components/HdsProcesor.py
msgid "Procesorul lucrează cât l-a reglat fabricantul. Recomandat dacă nu știi ce să alegi."
msgstr "Il processore lavora come lo ha regolato il produttore. Consigliato se non sai cosa scegliere."

#: lib/python/Components/HdsProcesor.py
#, python-format
msgid "Receptorul se răcește (%d °C). Procesorul revine la viteza obișnuită după %s."
msgstr "Il ricevitore si sta raffreddando (%d °C). Il processore torna alla velocità normale dopo %s."

#: lib/python/Components/HdsProcesor.py
#, python-format
msgid "Receptorul se răcește. Procesorul revine la viteza obișnuită după %s."
msgstr "Il ricevitore si sta raffreddando. Il processore torna alla velocità normale dopo %s."

#: lib/python/Components/HdsProcesor.py
msgid "Imaginea și sunetul nu sunt afectate."
msgstr "Immagine e audio non sono interessati."

#: lib/python/Components/HdsProcesor.py lib/python/Plugins/Extensions/HdsWebControl/procesor_web.py
#, python-format
msgid "Modul %s (%d MHz) apare după ce receptorul trece proba de căldură."
msgstr "La modalità %s (%d MHz) compare dopo che il ricevitore ha superato la prova di calore."

#: lib/python/Components/HdsProcesor.py
#, python-format
msgid "cel mult %d MHz (%s, s-a încălzit)"
msgstr "al massimo %d MHz (%s, si è scaldato)"

#: lib/python/Components/HdsProcesor.py
msgid "Alege cu stânga, dreapta sau OK cât timp arată graficul."
msgstr "Scegli con sinistra, destra o OK quanto tempo mostra il grafico."

#: lib/python/Components/HdsProcesor.py lib/python/Plugins/Extensions/HdsWebControl/procesor_web.py
msgid "Istoricul se ține numai în memorie și începe din nou când repornește receptorul."
msgstr "La cronologia è tenuta solo in memoria e ricomincia quando si riavvia il ricevitore."

#: lib/python/Components/HdsProcesor.py lib/python/Plugins/Extensions/HdsWebControl/procesor_web.py
#, python-format
msgid "Linia colorată: temperatura cea mai mare din fiecare minut, galbenă de la %d °C, roșie de la %d °C. Barele de jos: viteza procesorului, galbene când a încetinit de căldură. Liniile drepte: unde încetinește procesorul (întreruptă: unde revine)."
msgstr "Linea colorata: temperatura più alta di ogni minuto, gialla da %d °C, rossa da %d °C. Barre in basso: velocità del processore, gialle quando ha rallentato per il calore. Linee dritte: dove il processore rallenta (tratteggiata: dove torna)."

#: lib/python/Components/HdsProcesor.py
#, python-format
msgid "cel mult %d MHz"
msgstr "al massimo %d MHz"

#: lib/python/Components/HdsEgalizator.py
msgid "Reglat de tine"
msgstr "Personalizzato"

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Egalizatorul nu a putut porni la acest post (%s). Sunetul merge prin placa de sunet."
msgstr "L'equalizzatore non è riuscito ad avviarsi su questa stazione (%s). L'audio passa dal chip audio."

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Se aude cu egalizator: %s."
msgstr "Si sente con l'equalizzatore: %s."

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Probă din fișier, cu egalizator: %s."
msgstr "Prova da file, con l'equalizzatore: %s."

#: lib/python/Components/HdsEgalizator.py
msgid "Pornește egalizatorul la acest post..."
msgstr "Avvio dell'equalizzatore su questa stazione..."

#: lib/python/Components/HdsEgalizator.py
msgid "Postul nu mai trimite sunet. Egalizatorul așteaptă."
msgstr "La stazione non invia più audio. L'equalizzatore attende."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul e oprit. Sunetul merge ca de obicei, prin placa de sunet."
msgstr "L'equalizzatore è spento. L'audio passa come sempre dal chip audio."

#: lib/python/Components/HdsEgalizator.py
msgid "La înregistrări și la pauza cu reluare (timeshift) egalizatorul nu lucrează. Sunetul merge prin placa de sunet."
msgstr "Sulle registrazioni e con il timeshift l'equalizzatore non funziona. L'audio passa dal chip audio."

#: lib/python/Components/HdsEgalizator.py
msgid "Sunetul pleacă neschimbat spre bara de sunet: egalizatorul, volumul și modul de noapte le reglezi din bara de sunet."
msgstr "L'audio va invariato alla soundbar: equalizzatore, volume e modalità notte si regolano dalla soundbar."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul nu poate porni: placa de sunet nu se poate folosi din procesor."
msgstr "L'equalizzatore non può avviarsi: il chip audio non si può usare dal processore."

#: lib/python/Components/HdsEgalizator.py
msgid "Postul acesta nu are sunet."
msgstr "Questa stazione non ha audio."

#: lib/python/Components/HdsEgalizator.py
msgid "Nu merge niciun post acum. Setările se aplică la următorul post de radio."
msgstr "Ora non è in onda nessuna stazione. Le impostazioni valgono dalla prossima stazione radio."

#: lib/python/Components/HdsEgalizator.py
msgid "nu au venit date de sunet de la post"
msgstr "non sono arrivati dati audio dalla stazione"

#: lib/python/Components/HdsEgalizator.py
msgid "fluxul postului nu s-a putut citi"
msgstr "non è stato possibile leggere il flusso della stazione"

#: lib/python/Components/HdsEgalizator.py
msgid "placa de sunet nu a primit sunetul"
msgstr "il chip audio non ha accettato l'audio"

#: lib/python/Components/HdsEgalizator.py
msgid "placa de sunet s-a oprit"
msgstr "il chip audio si è fermato"

#: lib/python/Components/HdsEgalizator.py
msgid "sunetul nu s-a putut decoda"
msgstr "non è stato possibile decodificare l'audio"

#: lib/python/Components/HdsEgalizator.py
msgid "decodorul nu a pornit"
msgstr "il decodificatore non si è avviato"

#: lib/python/Components/HdsEgalizator.py
msgid "felul sunetului nu s-a recunoscut"
msgstr "il tipo di audio non è stato riconosciuto"

#: lib/python/Components/HdsEgalizator.py
msgid "Voce și știri"
msgstr "Voce e notizie"

#: lib/python/Components/HdsEgalizator.py
msgid "Pop"
msgstr "Pop"

#: lib/python/Components/HdsEgalizator.py
msgid "Rock"
msgstr "Rock"

#: lib/python/Components/HdsEgalizator.py
msgid "Clasică"
msgstr "Classica"

#: lib/python/Components/HdsEgalizator.py
msgid "Bas mai mult"
msgstr "Più bassi"

#: lib/python/Components/HdsEgalizator.py
msgid "Noapte"
msgstr "Notte"

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "procesor %s%% dintr-un nucleu"
msgstr "processore %s%% di un core"

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "întârziere %d ms"
msgstr "ritardo %d ms"

#: lib/python/Components/HdsEgalizator.py
msgid "În egalizator"
msgstr "Nell'equalizzatore"

#: lib/python/Components/HdsEgalizator.py
msgid "Pe placa de sunet"
msgstr "Sul chip audio"

#: lib/python/Screens/HdsEgalizator.py
msgid "basul cel mai adânc, care se simte mai mult decât se aude"
msgstr "i bassi più profondi, che si sentono sul corpo più che con l'orecchio"

#: lib/python/Screens/HdsEgalizator.py
msgid "basul adânc: toba mare, chitara bas"
msgstr "bassi profondi: grancassa, basso"

#: lib/python/Screens/HdsEgalizator.py
msgid "basul: căldura muzicii și a vocilor bărbătești"
msgstr "bassi: il calore della musica e delle voci maschili"

#: lib/python/Screens/HdsEgalizator.py
msgid "partea de jos a vocilor și a instrumentelor"
msgstr "la parte bassa delle voci e degli strumenti"

#: lib/python/Screens/HdsEgalizator.py
msgid "mijlocul de jos: prea mult sună înfundat"
msgstr "medio-bassi: troppo suona ovattato"

#: lib/python/Screens/HdsEgalizator.py
msgid "mijlocul: corpul vocilor"
msgstr "medi: il corpo delle voci"

#: lib/python/Screens/HdsEgalizator.py
msgid "prezența vocilor: se înțeleg mai bine cuvintele"
msgstr "presenza delle voci: le parole si capiscono meglio"

#: lib/python/Screens/HdsEgalizator.py
msgid "claritatea: consoanele, chitarele"
msgstr "chiarezza: consonanti, chitarre"

#: lib/python/Screens/HdsEgalizator.py
msgid "strălucirea: talgerele, respirația vocii"
msgstr "brillantezza: piatti, respiro della voce"

#: lib/python/Screens/HdsEgalizator.py
msgid "aerul: cele mai înalte sunete"
msgstr "aria: i suoni più acuti"

#: data/menu.xml
msgid "Egalizator"
msgstr "Equalizzatore"

#: lib/python/Screens/HdsEgalizator.py
msgid "Renunță"
msgstr "Annulla"

#: lib/python/Screens/HdsEgalizator.py
msgid "Păstrează"
msgstr "Mantieni"

#: lib/python/Screens/HdsEgalizator.py
msgid "Presetarea următoare"
msgstr "Preimpostazione successiva"

#: lib/python/Screens/HdsEgalizator.py
msgid "Pornit / Oprit"
msgstr "Acceso / Spento"

#: lib/python/Screens/HdsEgalizator.py
msgid "Presetare"
msgstr "Preimpostazione"

#: lib/python/Screens/HdsEgalizator.py
msgid "Mod de noapte"
msgstr "Modalità notte"

#: lib/python/Screens/HdsEgalizator.py
msgid "Pentru acest post"
msgstr "Per questa stazione"

#: lib/python/Screens/HdsEgalizator.py
msgid "Nivel"
msgstr "Livello"

#: lib/python/Screens/HdsEgalizator.py
msgid "Fără post"
msgstr "Nessuna stazione"

#: lib/python/Screens/HdsEgalizator.py
msgid "Nu merge niciun post acum, deci reglajele se păstrează pentru toate posturile."
msgstr "Ora non è in onda nessuna stazione, quindi le impostazioni valgono per tutte le stazioni."

#: lib/python/Screens/HdsEgalizator.py
msgid "Nivel: potrivești tăria sunetului cu egalizator față de sunetul obișnuit, între −12 și +12 dB."
msgstr "Livello: adegua il volume dell'audio con equalizzatore a quello normale, tra −12 e +12 dB."

#: lib/python/Screens/HdsEgalizator.py
#, python-format
msgid "%s, %s. Sus și jos: cu 1 dB mai mult sau mai puțin, între −12 și +12 dB."
msgstr "%s, %s. Su e giù: 1 dB in più o in meno, tra −12 e +12 dB."

#: lib/python/Screens/HdsEgalizator.py
msgid "acest post"
msgstr "questa stazione"

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Păstrat. Se aude și pe televizor."
msgstr "Mantenuto. Si sente anche sul televisore."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Volumul se alege cu auto, aici sau placa."
msgstr "Il volume si sceglie con auto, aici o placa."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Numele plăcii de sunet are numai litere, cifre și : , _ - ."
msgstr "Il nome del dispositivo audio ha solo lettere, cifre e : , _ - ."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Am pus înapoi reglajele păstrate."
msgstr "Sono state ripristinate le impostazioni mantenute."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Se aude acum. Apasă „Păstrează” ca să rămână."
msgstr "Si sente ora. Premi „Mantieni” perché resti."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Presetarea „%s” nu există."
msgstr "La preimpostazione „%s” non esiste."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Benzile se dau ca %d numere între %d și %d, cu virgulă între ele."
msgstr "Le bande si indicano come %d numeri tra %d e %d, separati da virgole."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Nivelul se dă ca număr între %d și %d."
msgstr "Il livello si indica come numero tra %d e %d."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "„%s” se alege cu 1 (da) sau 0 (nu)."
msgstr "„%s” si sceglie con 1 (sì) o 0 (no)."

#: lib/python/Components/HdsEgalizator.py
msgid "Pauză. Sunetul revine cu egalizator când pornești din nou."
msgstr "Pausa. L'audio torna con l'equalizzatore quando riprendi la riproduzione."

#: lib/python/Components/HdsEgalizator.py
msgid "La canalele TV egalizatorul nu merge încă: sunetul trebuie să rămână potrivit cu ce vezi pe ecran, deci merge prin placa de sunet. Egalizatorul lucrează la posturile de radio."
msgstr "Sui canali TV l'equalizzatore non funziona ancora: l'audio deve restare allineato a ciò che vedi sullo schermo, quindi passa dal chip audio. L'equalizzatore funziona sulle stazioni radio."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul nu poate porni: receptorul nu are decodorul MPEG audio."
msgstr "L'equalizzatore non può avviarsi: il ricevitore non ha il decoder audio MPEG."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul nu poate porni: lipsește decodarea sunetului în procesor (GStreamer)."
msgstr "L'equalizzatore non può avviarsi: manca la decodifica dell'audio nel processore (GStreamer)."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul lipsește din programul acestui receptor. Setările se păstrează, dar nu se aud."
msgstr "L'equalizzatore manca nel software di questo ricevitore. Le impostazioni si conservano, ma non si sentono."

#: lib/python/Components/HdsEgalizator.py
msgid "ieșirea plăcii de sunet pentru procesor e oprită"
msgstr "l'uscita del chip audio per il processore è spenta"

#: lib/python/Components/HdsEgalizator.py
msgid "receptorul nu are decodor AAC"
msgstr "il ricevitore non ha un decoder AAC"

#: lib/python/Components/HdsEgalizator.py
msgid "receptorul nu are decodorul MPEG audio"
msgstr "il ricevitore non ha il decoder audio MPEG"

#: lib/python/Components/HdsEgalizator.py
msgid "lipsește decodarea sunetului în procesor"
msgstr "manca la decodifica dell'audio nel processore"

#: lib/python/Components/HdsEgalizator.py
msgid "placa de sunet nu se poate folosi din procesor"
msgstr "il chip audio non si può usare dal processore"

#: lib/python/Components/HdsEgalizator.py
msgid "felul acesta de AAC nu se poate decoda încă"
msgstr "questo tipo di AAC non si può ancora decodificare"

#: lib/python/Components/HdsEgalizator.py
msgid "fișierul probei nu există"
msgstr "il file di prova non esiste"

#: lib/python/Components/HdsEgalizator.py
msgid "fișierul probei nu s-a putut scrie"
msgstr "non è stato possibile scrivere il file di prova"

#: lib/python/Components/HdsEgalizator.py
msgid "o eroare neașteptată"
msgstr "un errore inatteso"

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Probă din fișier, cu egalizator: %s. Proba merge și cu egalizatorul oprit."
msgstr "Prova da file, con equalizzatore: %s. La prova funziona anche con l'equalizzatore spento."

#: lib/python/Components/HdsEgalizator.py
msgid "decodat în procesor"
msgstr "decodificato nel processore"

#: lib/python/Screens/HdsEgalizator.py
msgid "Păstrezi schimbările?"
msgstr "Mantenere le modifiche?"

#: lib/python/Screens/HdsEgalizator.py
msgid "Pornit, sunetul posturilor de radio trece prin procesor și se aude cu reglajele de mai jos."
msgstr "Acceso, l'audio delle stazioni radio passa dal processore e si sente con le impostazioni qui sotto."

#: lib/python/Screens/HdsEgalizator.py
msgid "Presetarea pune singură toate benzile; apoi le poți potrivi una câte una. Barele din spate: cât de tare se aude acum fiecare bandă."
msgstr "La preimpostazione regola tutte le bande; poi puoi ritoccarle una per una. Le barre sullo sfondo: quanto suona forte ora ogni banda."

#: lib/python/Screens/HdsEgalizator.py
msgid "Modul de noapte: sunetele tari devin mai încete, cele încete mai tari. Potrivit seara, când asculți încet."
msgstr "Modalità notte: i suoni forti si abbassano, quelli deboli si alzano. Utile la sera, quando ascolti a basso volume."

#: lib/python/Screens/HdsEgalizator.py
#, python-format
msgid "Da: reglajele de aici se țin minte numai pentru %s. Nu: postul folosește reglajele obișnuite, ale tuturor posturilor, pe care le vezi aici."
msgstr "Sì: le impostazioni di qui valgono solo per %s. No: la stazione usa le impostazioni normali di tutte le stazioni, che vedi qui."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. OK: pornești sau oprești. EXIT: ieși."
msgstr "Sinistra e destra: scegliere. OK: accendere o spegnere. EXIT: uscire."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. Sus, jos sau OK: presetarea următoare. EXIT: ieși."
msgstr "Sinistra e destra: scegliere. Su, giù o OK: preimpostazione successiva. EXIT: uscire."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. OK: da sau nu. EXIT: ieși."
msgstr "Sinistra e destra: scegliere. OK: sì o no. EXIT: uscire."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. Sus și jos: schimbi. OK: păstrezi și închizi."
msgstr "Sinistra e destra: scegliere. Su e giù: cambiare. OK: mantenere e chiudere."

#: lib/python/Components/HdsEgalizator.py
msgid "La acest post (AAC) egalizatorul nu e disponibil din motive de licențiere a brevetelor AAC."
msgstr "Su questa stazione (AAC) l'equalizzatore non è disponibile per motivi di licenza dei brevetti AAC."

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Postul acesta are sunet %s. Egalizatorul lucrează la posturile cu sunet MPEG (MP2)."
msgstr "Questa stazione ha audio %s. L'equalizzatore funziona sulle stazioni con audio MPEG (MP2)."

