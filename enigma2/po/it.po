msgstr "qualità immagine profilo"

#: lib/python/Components/HdsCalitateImagine.py lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Ieșire HDR"
msgstr "Uscita HDR"

#: lib/python/Components/HdsCalitateImagine.py
msgid "claritate imagine ascuțire"
msgstr "nitidezza immagine contrasto contorni"

#: lib/python/Components/HdsCalitateImagine.py
msgid "zgomot purici"
msgstr "rumore grana"

#: lib/python/Components/HdsCalitateImagine.py
msgid "culori"
msgstr "colori"

#: lib/python/Components/HdsCalitateImagine.py
#, python-format
msgid "Imaginea se vede corect cu ieșirea HDR „%s”?"
msgstr "L'immagine si vede bene con l'uscita HDR «%s»?"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Acum nu e nicio imagine (radio sau niciun canal pornit)."
msgstr "Ora non c'è nessuna immagine (radio o nessun canale avviato)."

#: lib/python/Components/HdsCalitateImagine.py
#, python-format
msgid "Acum: canal %(clasa)s, %(latime)dx%(inaltime)d, imagine %(dinamica)s."
msgstr "Ora: canale %(clasa)s, %(latime)dx%(inaltime)d, immagine %(dinamica)s."

#: lib/python/Components/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Televizorul acesta nu primește această ieșire HDR."
msgstr "Questo televisore non accetta questa uscita HDR."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Pe televizor așteaptă deja o întrebare."
msgstr "Sul televisore aspetta già una domanda."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Ieșirea HDR era deja aceasta."
msgstr "L'uscita HDR era già questa."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Ieșirea HDR nu a fost confirmată. A revenit cea de dinainte."
msgstr "L'uscita HDR non è stata confermata. È tornata quella di prima."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Ieșirea HDR se folosește când pornește un canal. O păstrezi?"
msgstr "L'uscita HDR si usa quando parte un canale. La tieni?"

#: lib/python/Components/HdsCalitateImagine.py
#, python-format
msgid "Uită-te la televizor și răspunde la întrebare în %d de secunde."
msgstr "Guarda il televisore e rispondi alla domanda entro %d secondi."

#: lib/python/Components/HdsCalitateImagine.py
#, python-format
msgid "Păstrat: %s."
msgstr "Salvato: %s."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Întrebarea nu s-a putut deschide pe televizor. A rămas ieșirea de dinainte."
msgstr "La domanda non si è potuta aprire sul televisore. Resta l'uscita di prima."

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Ce schimbi se vede pe loc în imaginea de deasupra."
msgstr "Quello che cambi si vede subito nell'immagine sopra."

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py data/menu.xml
msgid "Calitatea imaginii"
msgstr "Qualità dell'immagine"

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Da: receptorul pune singur profilul canalului, după rezoluție și după felul imaginii trimise la televizor. Nu: imaginea rămâne ca din fabrică."
msgstr "Sì: il ricevitore imposta da solo il profilo del canale, secondo la risoluzione e il tipo di immagine inviata al televisore. No: l'immagine resta come di fabbrica."

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Acum nu e nicio imagine: reglajele se văd când pornești un canal TV."
msgstr "Ora non c'è nessuna immagine: le regolazioni si vedono quando avvii un canale TV."

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Alegi profilul pe care îl reglezi. SD, HD și 4K sunt rezoluția canalului; SDR, HDR10 și HLG sunt felul imaginii trimise la televizor."
msgstr "Scegli il profilo che regoli. SD, HD e 4K sono la risoluzione del canale; SDR, HDR10 e HLG sono il tipo di immagine inviata al televisore."

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Comparație"
msgstr "Confronto"

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Profilul acesta nu e al canalului de acum: îl vezi când pornești un canal %s."
msgstr "Questo profilo non è quello del canale attuale: lo vedi quando avvii un canale %s."

#: lib/python/Screens/HdsCalitateImagine.py
#, python-format
msgid "Comparația e pornită: în dreapta imaginea are reglajul „%s”, în stânga nu. Albastru o oprește."
msgstr "Il confronto è attivo: a destra l'immagine ha la regolazione «%s», a sinistra no. Blu lo spegne."

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Toate profilurile"
msgstr "Tutti i profili"

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Pui înapoi valorile din fabrică?"
msgstr "Rimetti i valori di fabbrica?"

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Profilul"
msgstr "Profilo"

#: lib/python/Screens/HdsCalitateImagine.py
#, python-format
msgid "Numai profilul %s"
msgstr "Solo il profilo %s"

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Automat: canalele HDR ies în HDR, celelalte în SDR. Mereu HDR10 sau HLG: și meniurile și canalele SDR ies în HDR, fără clipire la schimbarea canalului. Se aplică la tasta verde, cu o întrebare pe televizor."
msgstr "Automatico: i canali HDR escono in HDR, gli altri in SDR. Sempre HDR10 o HLG: anche i menu e i canali SDR escono in HDR, senza sfarfallio al cambio di canale. Si applica con il tasto verde, con una domanda sul televisore."

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "(acum)"
msgstr "(ora)"

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Din fabrică: %s."
msgstr "Di fabbrica: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Aceleași reglaje sunt pe televizor, în %s. Luminozitatea, contrastul, saturația și nuanța schimbă și meniurile. Ce se vede cu adevărat se judecă pe televizor: capturile de ecran nu arată prelucrarea plăcii."
msgstr "Le stesse regolazioni sono sul televisore, in %s. Luminosità, contrasto, saturazione e tinta cambiano anche i menu. Quello che si vede davvero si giudica sul televisore: le catture dello schermo non mostrano l'elaborazione della scheda."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Se citesc reglajele..."
msgstr "Lettura delle regolazioni..."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Reglaje"
msgstr "Regolazioni"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Fără bifă, imaginea rămâne ca din fabrică."
msgstr "Senza la spunta, l'immagine resta come di fabbrica."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Toate profilurile la implicite"
msgstr "Tutti i profili ai predefiniti"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Automat: canalele HDR ies în HDR, celelalte în SDR. Mereu HDR10 sau HLG: și meniurile și canalele SDR ies în HDR, fără clipire la schimbarea canalului. Canalul pornește din nou și pe televizor apare o întrebare: fără răspuns în 20 de secunde revine ieșirea de dinainte."
msgstr "Automatico: i canali HDR escono in HDR, gli altri in SDR. Sempre HDR10 o HLG: anche i menu e i canali SDR escono in HDR, senza sfarfallio al cambio di canale. Il canale riparte e sul televisore compare una domanda: senza risposta entro 20 secondi torna l'uscita di prima."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Încearcă pe televizor"
msgstr "Prova sul televisore"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Ce arată acum blocul de calitate al plăcii (/proc/msp/pq)."
msgstr "Quello che mostra ora il blocco qualità della scheda (/proc/msp/pq)."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Receptorul nu a putut citi reglajele."
msgstr "Il ricevitore non ha potuto leggere le regolazioni."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Receptorul acesta nu are blocul de calitate a imaginii."
msgstr "Questo ricevitore non ha il blocco qualità dell'immagine."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Ce schimbi se vede pe loc pe televizor."
msgstr "Quello che cambi si vede subito sul televisore."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Ieșire HDR acum: %s."
msgstr "Uscita HDR ora: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Pe televizor: %s. Mai sunt %s s până revine ieșirea de dinainte."
msgstr "Sul televisore: %s. Mancano %s s prima che torni l'uscita di prima."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Ai schimbări nepăstrate: rămân numai după „Păstrează”."
msgstr "Hai modifiche non salvate: restano solo dopo «Salva»."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Alege întâi o ieșire."
msgstr "Scegli prima un'uscita."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Pui înapoi valorile din fabrică pentru profilul %s?"
msgstr "Rimetti i valori di fabbrica per il profilo %s?"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Pui înapoi valorile din fabrică pentru toate profilurile?"
msgstr "Rimetti i valori di fabbrica per tutti i profili?"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Păstrat. Se vede și pe televizor."
msgstr "Salvato. Si vede anche sul televisore."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Toate profilurile au acum valorile din fabrică."
msgstr "Tutti i profili ora hanno i valori di fabbrica."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Pe televizor e deschis ecranul Calitatea imaginii. Închide-l, apoi încearcă din nou."
msgstr "Sul televisore è aperta la schermata Qualità dell'immagine. Chiudila, poi riprova."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Spune și profilul (profil=hd_sdr, de exemplu)."
msgstr "Indica anche il profilo (profil=hd_sdr, per esempio)."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Se vede acum pe televizor. Apasă „Păstrează” ca să rămână."
msgstr "Ora si vede sul televisore. Premi «Salva» perché resti."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Alege un profil sau „toate”."
msgstr "Scegli un profilo o «toate»."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Profilul %s are acum valorile din fabrică."
msgstr "Il profilo %s ora ha i valori di fabbrica."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "„pornit” se alege cu 1 (da) sau 0 (nu)."
msgstr "«pornit» si sceglie con 1 (sì) o 0 (no)."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Comparația e oprită."
msgstr "Il confronto è spento."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Reglajul acesta nu are comparație pe canalul de acum."
msgstr "Questa regolazione non ha confronto sul canale attuale."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Pe televizor: în dreapta cu reglajul, în stânga fără. Se oprește singură după %d de secunde."
msgstr "Sul televisore: a destra con la regolazione, a sinistra senza. Si ferma da sola dopo %d secondi."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Profilul „%s” nu există."
msgstr "Il profilo «%s» non esiste."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Interfața web nu are încă legătura cu ecranul receptorului."
msgstr "L'interfaccia web non è ancora collegata allo schermo del ricevitore."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Valorile se dau ca numere între 0 și 100."
msgstr "I valori si danno come numeri tra 0 e 100."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Reglajul „%s” nu e al acestui profil."
msgstr "La regolazione «%s» non è di questo profilo."

#: lib/python/Components/HdsEcranNegru.py
#, python-format
msgid "Imagine în formatul %s"
msgstr "Immagine in formato %s"

#: lib/python/Components/HdsEcranNegru.py
#, python-format
msgid "Canalul trimite imaginea în formatul %s, pe care acest receptor nu îl poate reda."
msgstr "Il canale invia l'immagine in formato %s, che questo ricevitore non può riprodurre."

#: lib/python/Screens/HdsCautareCanale.py
msgid "mai e mai puțin de un minut"
msgstr "manca meno di un minuto"

#: lib/python/Screens/HdsCautareCanale.py
#, python-format
msgid "mai durează cam %d minut"
msgid_plural "mai durează cam %d minute"
msgstr[0] "manca circa %d minuto"
msgstr[1] "mancano circa %d minuti"

#: lib/python/Screens/HdsCautareCanale.py
msgid "GALBEN: sari peste satelitul acesta"
msgstr "GIALLO: salta questo satellite"

#: lib/python/Screens/HdsCautareCanale.py
#, python-format
msgid "GALBEN: sari peste %s"
msgstr "GIALLO: salta %s"

#: lib/python/Components/HdsPisteCanale.py
#, python-format
msgid "Sărite la cererea ta: %s."
msgstr "Saltati su tua richiesta: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/cautare_web.py
#, python-format
msgid "Sărit peste %s. Trec la poziția următoare."
msgstr "Saltato %s. Passo alla posizione successiva."

#: lib/python/Components/HdsModSigur.py
msgid "eroare în codul Python al interfeței"
msgstr "errore nel codice Python dell'interfaccia"

#: lib/python/Components/HdsModSigur.py
msgid "cădere în programul interfeței"
msgstr "crash nel programma dell'interfaccia"

#: lib/python/Components/HdsModSigur.py
msgid "cădere în placa 2D (accelerarea s-a oprit singură)"
msgstr "crash nella grafica 2D (l'accelerazione si è spenta da sola)"

#: lib/python/Components/HdsModSigur.py
msgid "eroare fatală în programul interfeței"
msgstr "errore fatale nel programma dell'interfaccia"

#: lib/python/Components/HdsModSigur.py
msgid "oprită la cerere, nu e o cădere"
msgstr "fermata su richiesta, non è un crash"

#: lib/python/Components/HdsModSigur.py
msgid "oprită de sistem: memoria s-a terminat"
msgstr "fermata dal sistema: memoria esaurita"

#: lib/python/Components/HdsModSigur.py
msgid "oprită fără raport de eroare"
msgstr "fermata senza rapporto di errore"

#: lib/python/Components/HdsModSigur.py
#, python-format
msgid "Locul erorii: %s"
msgstr "Punto dell'errore: %s"

#: lib/python/Components/HdsModSigur.py
#, python-format
msgid "Locul căderii: %s"
msgstr "Punto del crash: %s"

#: lib/python/Components/HdsModSigur.py
msgid "Placa 2D lucra în acel moment, dar oprirea nu e pusă pe seama ei."
msgstr "La grafica 2D era in funzione in quel momento, ma l'arresto non le viene attribuito."

#: lib/python/Components/HdsTeletextCopie.py
#, python-format
msgid "Copia nu s-a reîmprospătat: în %(minute)d minute teletextul canalului nu s-a strâns tot. Pagini strânse: %(pagini)d."
msgstr "La copia non è stata aggiornata: in %(minute)d minuti il televideo del canale non è stato raccolto per intero. Pagine raccolte: %(pagini)d."

#: lib/python/Components/HdsTeletextCopie.py
#, python-format
msgid "Copia nu s-a reîmprospătat: în %(secunde)d de secunde canalul nu a trimis nicio pagină de teletext (fără semnal sau fără teletext)."
msgstr "La copia non è stata aggiornata: in %(secunde)d secondi il canale non ha inviato nessuna pagina di televideo (senza segnale o senza televideo)."

#: lib/python/Components/HdsTeletextCopie.py
msgid "Copia nu s-a reîmprospătat: receptorul nu a putut trece pe canal."
msgstr "La copia non è stata aggiornata: il ricevitore non è riuscito a passare al canale."

#: lib/python/Components/HdsInregistrariProgramate.py
msgid "Acest canal nu poate fi înregistrat."
msgstr "Questo canale non può essere registrato."

#: lib/python/Components/HdsInregistrariProgramate.py
msgid "Înregistrarea programelor DVB-T2 din satelit nu e încă posibilă."
msgstr "La registrazione dei programmi DVB-T2 da satellite non è ancora possibile."

#: lib/python/Components/HdsInregistrariProgramate.py
msgid "Înregistrarea posturilor DAB+ din satelit nu e încă posibilă."
msgstr "La registrazione delle stazioni DAB+ da satellite non è ancora possibile."

#: lib/python/Screens/TimerEntry.py
msgid "Alege alt canal din listă."
msgstr "Scegli un altro canale dall'elenco."

#: lib/python/Components/HdsActualizari.py
msgid "Trebuie pusă imaginea nouă de la zero, din „Imagine nouă de pe stick”. Instalată din meniu peste imaginea de acum, actualizarea poate face receptorul instabil, de aceea aici nu se instalează."
msgstr "La nuova immagine va installata da zero, da «Nuova immagine da chiavetta». Installato dal menu sopra l'immagine attuale, l'aggiornamento può rendere instabile il ricevitore, per questo qui non si installa."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizările nu au fost căutate încă."
msgstr "Gli aggiornamenti non sono ancora stati cercati."

#: lib/python/Components/HdsActualizari.py
msgid "Software-ul este la zi."
msgstr "Il software è aggiornato."

#: lib/python/Components/HdsActualizari.py
msgid "Este disponibilă o actualizare."
msgstr "È disponibile un aggiornamento."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea nu se poate instala din meniu."
msgstr "L'aggiornamento non si può installare dal menu."

#: lib/python/Components/HdsActualizari.py
msgid "Receptorul nu este conectat la internet acum, deci actualizările nu se pot căuta."
msgstr "Il ricevitore ora non è connesso a internet, quindi non si possono cercare aggiornamenti."

#: lib/python/Components/HdsActualizari.py
