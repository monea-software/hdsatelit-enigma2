msgstr "NAS o Linux: la cartella esportata (per esempio volume1/filme). Senza password."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Server FTP: dosarul de pe server (gol: tot serverul)."
msgstr "Server FTP: la cartella sul server (vuoto: tutto il server)."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "WebDAV: dosarul de pe server, de pildă remote.php/dav/files/nume."
msgstr "WebDAV: la cartella sul server, per esempio remote.php/dav/files/nume."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Serverul media din casă: îl găsești cel mai ușor cu Caută serverele din casă."
msgstr "Il server multimediale di casa: lo trovi più facilmente con Cerca i server di casa."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
