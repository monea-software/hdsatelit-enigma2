#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Arborele dispozitivului"
msgstr "Albero dei dispositivi"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Tunere"
msgstr "Sintonizzatori"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Paza de model"
msgstr "Protezione del modello"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
#, python-format
msgid "Receptorul nu a putut citi starea: %s"
msgstr "Il ricevitore non ha potuto leggere lo stato: %s"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Cerut de software"
msgstr "Richiesto dal software"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Citit pe receptor"
msgstr "Letto sul ricevitore"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Ce se verifică"
msgstr "Cosa si verifica"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Nu se verifică nimic aici."
msgstr "Qui non si verifica nulla."

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Amprenta receptorului"
msgstr "Impronta del ricevitore"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Amprenta se citește din procesor, din antetul de fabrică al partiției deviceinfo, din tabela partițiilor dată la pornire și din tipul plăcii (spus de driver și scris în eticheta receptorului). Numele modelului din etichetă nu intră în verificare."
msgstr "L'impronta si legge dal processore, dall'intestazione di fabbrica della partizione deviceinfo, dalla tabella delle partizioni data all'avvio e dal tipo di scheda (secondo il driver e scritto nell'etichetta del ricevitore). Il nome del modello nell'etichetta non viene verificato."

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
msgid "Numai informativ"
msgstr "Solo informativo"

#: lib/python/Plugins/Extensions/HdsWebControl/paza_model_web.py
