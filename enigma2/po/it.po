msgstr "Stazione DAB+ via satellite"

#: lib/python/Screens/ChannelSelection.py
msgid "Program DVB-T2 din satelit"
msgstr "Programma DVB-T2 via satellite"

#: lib/python/Hds/DabT2/tuner.py
