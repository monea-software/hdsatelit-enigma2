msgid "fișierul nu există"
msgstr "файл не существует"

#: lib/python/Components/HdsFonturiGoogle.py:464
#, python-format
msgid "fișier prea mic pentru un font (%d octeți)"
msgstr "файл слишком мал для шрифта (%d байт)"

#: lib/python/Components/HdsFonturiGoogle.py:467
