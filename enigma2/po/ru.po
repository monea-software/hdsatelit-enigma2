msgstr "Если ты использовал ключ для этого сервера, введи его заново."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheie pusă"
msgstr "Ключ задан"

#: lib/python/Components/HdsTraducereSubtitrari.py
