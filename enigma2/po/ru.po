msgstr "Проверено %d адресов потоков из букетов: эти сейчас не отвечают. Поток может снова заработать позже; убирай его, только если знаешь, что его больше нет."

#: lib/python/Components/HdsEditorCanaleUnelte.py:479
msgid "Fluxuri care nu răspund"
msgstr "Потоки, которые не отвечают"

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:1327
msgid "Sigle nefolosite"
msgstr "Неиспользуемые логотипы"

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:1327
