msgid "OK bifează sau debifează · pe titlul grupei: toată grupa"
msgstr "OK отмечает или снимает отметку · на заголовке группы: всю группу"

#: lib/python/Screens/HdsEditorCanaleUnelte.py
msgid "numai de văzut"
