msgstr[1] "%d новых букета"
msgstr[2] "%d новых букетов"

#: lib/python/Components/HdsEditorCanaleUnelte.py:230
msgid "Transpondere din lista receptorului fără niciun canal (rămase după ștergeri sau după căutări pe frecvențe goale). Nu încurcă, dar se pot șterge."
msgstr "Транспондеры в списке ресивера без единого канала (остались после удалений или поиска на пустых частотах). Не мешают, но их можно удалить."

#: lib/python/Components/HdsEditorCanaleUnelte.py:230
msgid "Transpondere fără canale"
msgstr "Транспондеры без каналов"

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:2973
msgid "Fără siglă"
msgstr "Без логотипа"

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:2976
msgid "Scoate din toate buchetele"
msgstr "Убрать из всех букетов"

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:2977
msgid "Le scoți din toate buchetele? Rămân în lista receptorului."
msgstr "Убрать их из всех букетов? Они останутся в списке ресивера."

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:2980
msgid "Șterge de pe disc"
msgstr "Удалить с диска"

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:2981
msgid "Fișierul buchetului se șterge la salvare. Poți anula până atunci."
msgstr "Файл букета удаляется при сохранении. До этого можно отменить."

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:2982
msgid "Pe transpondere"
msgstr "По транспондерам"

#: lib/python/Plugins/Extensions/HdsWebControl/editor_canale_web.py:2983
