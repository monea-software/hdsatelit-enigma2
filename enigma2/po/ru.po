msgstr "LibreTranslate на %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Am găsit %d. Alege serverul."
msgstr "Найдено: %d. Выбери сервер."

#: lib/python/Screens/HdsTraducereSubtitrari.py
