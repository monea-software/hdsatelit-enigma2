msgstr "Поток (ISI, 0-255)"

#: lib/python/Screens/ScanerSatelit.py
msgid "Secvența PLS"
msgstr "Последовательность PLS"

#: lib/python/Screens/ScanerSatelit.py
msgid "Codul PLS"
msgstr "Код PLS"

#: lib/python/Screens/ScanerSatelit.py
