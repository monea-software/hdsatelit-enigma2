msgstr "Ключ"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Cheia cere regiunea resursei Azure."
msgstr "Для ключа нужен регион ресурса Azure."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Cheia e opțională: numai dacă serverul cere cheie."
msgstr "Ключ необязателен: только если сервер требует ключ."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Cheia e prea lungă. Nu s-a pornit nimic."
msgstr "Ключ слишком длинный. Ничего не запущено."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Cheia e prea lungă. Nu s-a schimbat nimic."
msgstr "Ключ слишком длинный. Ничего не изменено."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
