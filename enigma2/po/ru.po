msgstr "файл абсурдно велик для шрифта"

#: lib/python/Components/HdsFonturiGoogle.py:477
msgid "colecție de fonturi (ttcf), nu un font singur"
msgstr "коллекция шрифтов (ttcf), а не отдельный шрифт"

#: lib/python/Components/HdsFonturiGoogle.py:481
#, python-format
msgid "nu e font: începe cu „%s”, nu cu o semnătură de font"
msgstr "это не шрифт: начинается с «%s», а не с сигнатуры шрифта"

#: lib/python/Components/HdsFonturiGoogle.py:487
msgid "antet rupt"
msgstr "повреждённый заголовок"

#: lib/python/Components/HdsFonturiGoogle.py:490
#, python-format
msgid "număr imposibil de tabele: %d"
msgstr "невозможное число таблиц: %d"

#: lib/python/Components/HdsFonturiGoogle.py:493
