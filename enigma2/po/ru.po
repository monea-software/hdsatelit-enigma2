msgstr "нижняя середина: избыток звучит глухо"

#: lib/python/Screens/HdsEgalizator.py
msgid "mijlocul: corpul vocilor"
msgstr "середина: тело голосов"

#: lib/python/Screens/HdsEgalizator.py
msgid "prezența vocilor: se înțeleg mai bine cuvintele"
msgstr "присутствие голосов: слова понятнее"

#: lib/python/Screens/HdsEgalizator.py
msgid "claritatea: consoanele, chitarele"
msgstr "чёткость: согласные, гитары"

#: lib/python/Screens/HdsEgalizator.py
msgid "strălucirea: talgerele, respirația vocii"
msgstr "блеск: тарелки, дыхание голоса"

#: lib/python/Screens/HdsEgalizator.py
msgid "aerul: cele mai înalte sunete"
msgstr "воздух: самые высокие звуки"

#: data/menu.xml
msgid "Egalizator"
msgstr "Эквалайзер"

#: lib/python/Screens/HdsEgalizator.py
msgid "Renunță"
msgstr "Отмена"

#: lib/python/Screens/HdsEgalizator.py
msgid "Păstrează"
msgstr "Сохранить"

#: lib/python/Screens/HdsEgalizator.py
msgid "Presetarea următoare"
msgstr "Следующая предустановка"

#: lib/python/Screens/HdsEgalizator.py
msgid "Pornit / Oprit"
msgstr "Вкл. / Выкл."

#: lib/python/Screens/HdsEgalizator.py
msgid "Presetare"
msgstr "Предустановка"

#: lib/python/Screens/HdsEgalizator.py
msgid "Mod de noapte"
msgstr "Ночной режим"

#: lib/python/Screens/HdsEgalizator.py
msgid "Pentru acest post"
msgstr "Для этой станции"

#: lib/python/Screens/HdsEgalizator.py
msgid "Nivel"
msgstr "Уровень"

#: lib/python/Screens/HdsEgalizator.py
msgid "Fără post"
msgstr "Нет станции"

#: lib/python/Screens/HdsEgalizator.py
msgid "Nu merge niciun post acum, deci reglajele se păstrează pentru toate posturile."
msgstr "Сейчас не играет ни одна станция, поэтому настройки сохраняются для всех станций."

#: lib/python/Screens/HdsEgalizator.py
msgid "Nivel: potrivești tăria sunetului cu egalizator față de sunetul obișnuit, între −12 și +12 dB."
msgstr "Уровень: подгоняет громкость звука с эквалайзером к обычному звуку, от −12 до +12 дБ."

#: lib/python/Screens/HdsEgalizator.py
#, python-format
msgid "%s, %s. Sus și jos: cu 1 dB mai mult sau mai puțin, între −12 și +12 dB."
msgstr "%s, %s. Вверх и вниз: на 1 дБ больше или меньше, от −12 до +12 дБ."

#: lib/python/Screens/HdsEgalizator.py
msgid "acest post"
msgstr "этой станции"

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Păstrat. Se aude și pe televizor."
msgstr "Сохранено. Это слышно и на телевизоре."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Volumul se alege cu auto, aici sau placa."
msgstr "Громкость выбирается значением auto, aici или placa."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Numele plăcii de sunet are numai litere, cifre și : , _ - ."
msgstr "Имя звукового устройства содержит только буквы, цифры и : , _ - ."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Am pus înapoi reglajele păstrate."
msgstr "Сохранённые настройки восстановлены."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Se aude acum. Apasă „Păstrează” ca să rămână."
msgstr "Сейчас звучит. Нажми „Сохранить”, чтобы это осталось."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Presetarea „%s” nu există."
msgstr "Предустановки „%s” нет."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Benzile se dau ca %d numere între %d și %d, cu virgulă între ele."
msgstr "Полосы задаются как %d чисел от %d до %d через запятую."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Nivelul se dă ca număr între %d și %d."
msgstr "Уровень задаётся числом от %d до %d."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "„%s” se alege cu 1 (da) sau 0 (nu)."
msgstr "„%s” выбирается значением 1 (да) или 0 (нет)."

#: lib/python/Components/HdsEgalizator.py
msgid "Pauză. Sunetul revine cu egalizator când pornești din nou."
msgstr "Пауза. Звук вернётся с эквалайзером, когда ты продолжишь воспроизведение."

#: lib/python/Components/HdsEgalizator.py
msgid "La canalele TV egalizatorul nu merge încă: sunetul trebuie să rămână potrivit cu ce vezi pe ecran, deci merge prin placa de sunet. Egalizatorul lucrează la posturile de radio."
msgstr "На телеканалах эквалайзер пока не работает: звук должен оставаться синхронным с тем, что ты видишь на экране, поэтому идёт через звуковой чип. Эквалайзер работает на радиостанциях."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul nu poate porni: receptorul nu are decodorul MPEG audio."
msgstr "Эквалайзер не может запуститься: у ресивера нет декодера MPEG audio."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul nu poate porni: lipsește decodarea sunetului în procesor (GStreamer)."
msgstr "Эквалайзер не может запуститься: нет декодирования звука в процессоре (GStreamer)."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul lipsește din programul acestui receptor. Setările se păstrează, dar nu se aud."
msgstr "Эквалайзера нет в программе этого ресивера. Настройки сохраняются, но не слышны."

#: lib/python/Components/HdsEgalizator.py
msgid "ieșirea plăcii de sunet pentru procesor e oprită"
msgstr "выход звукового чипа для процессора выключен"

#: lib/python/Components/HdsEgalizator.py
msgid "receptorul nu are decodor AAC"
msgstr "у ресивера нет декодера AAC"

#: lib/python/Components/HdsEgalizator.py
msgid "receptorul nu are decodorul MPEG audio"
msgstr "у ресивера нет декодера MPEG audio"

#: lib/python/Components/HdsEgalizator.py
msgid "lipsește decodarea sunetului în procesor"
msgstr "нет декодирования звука в процессоре"

#: lib/python/Components/HdsEgalizator.py
msgid "placa de sunet nu se poate folosi din procesor"
msgstr "звуковой чип нельзя использовать из процессора"

#: lib/python/Components/HdsEgalizator.py
msgid "felul acesta de AAC nu se poate decoda încă"
msgstr "этот вид AAC пока нельзя декодировать"

#: lib/python/Components/HdsEgalizator.py
msgid "fișierul probei nu există"
msgstr "файл пробы не существует"

#: lib/python/Components/HdsEgalizator.py
msgid "fișierul probei nu s-a putut scrie"
msgstr "файл пробы не удалось записать"

#: lib/python/Components/HdsEgalizator.py
msgid "o eroare neașteptată"
msgstr "непредвиденная ошибка"

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Probă din fișier, cu egalizator: %s. Proba merge și cu egalizatorul oprit."
msgstr "Проба из файла, с эквалайзером: %s. Проба работает и с выключенным эквалайзером."

#: lib/python/Components/HdsEgalizator.py
msgid "decodat în procesor"
msgstr "декодируется в процессоре"

#: lib/python/Screens/HdsEgalizator.py
msgid "Păstrezi schimbările?"
msgstr "Сохранить изменения?"

#: lib/python/Screens/HdsEgalizator.py
msgid "Pornit, sunetul posturilor de radio trece prin procesor și se aude cu reglajele de mai jos."
msgstr "Когда он включён, звук радиостанций идёт через процессор и звучит с настройками ниже."

#: lib/python/Screens/HdsEgalizator.py
msgid "Presetarea pune singură toate benzile; apoi le poți potrivi una câte una. Barele din spate: cât de tare se aude acum fiecare bandă."
msgstr "Предустановка сама выставляет все полосы; потом их можно подстроить по одной. Столбики на фоне: насколько громко сейчас звучит каждая полоса."

#: lib/python/Screens/HdsEgalizator.py
msgid "Modul de noapte: sunetele tari devin mai încete, cele încete mai tari. Potrivit seara, când asculți încet."
msgstr "Ночной режим: громкие звуки становятся тише, тихие громче. Удобно вечером, когда ты слушаешь тихо."

#: lib/python/Screens/HdsEgalizator.py
#, python-format
msgid "Da: reglajele de aici se țin minte numai pentru %s. Nu: postul folosește reglajele obișnuite, ale tuturor posturilor, pe care le vezi aici."
msgstr "Да: настройки здесь запоминаются только для %s. Нет: станция использует обычные настройки всех станций, которые ты видишь здесь."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. OK: pornești sau oprești. EXIT: ieși."
msgstr "Влево и вправо: выбор. OK: включить или выключить. EXIT: выход."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. Sus, jos sau OK: presetarea următoare. EXIT: ieși."
msgstr "Влево и вправо: выбор. Вверх, вниз или OK: следующая предустановка. EXIT: выход."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. OK: da sau nu. EXIT: ieși."
msgstr "Влево и вправо: выбор. OK: да или нет. EXIT: выход."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. Sus și jos: schimbi. OK: păstrezi și închizi."
msgstr "Влево и вправо: выбор. Вверх и вниз: изменение. OK: сохранить и закрыть."

#: lib/python/Components/HdsEgalizator.py
msgid "La acest post (AAC) egalizatorul nu e disponibil din motive de licențiere a brevetelor AAC."
msgstr "На этой станции (AAC) эквалайзер недоступен из-за лицензирования патентов AAC."

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Postul acesta are sunet %s. Egalizatorul lucrează la posturile cu sunet MPEG (MP2)."
msgstr "У этой станции звук %s. Эквалайзер работает на станциях со звуком MPEG (MP2)."

#: lib/python/Components/UsageConfig.py
msgid "Lista de canale radio"
msgstr "Список радиостанций"

#: lib/python/Components/UsageConfig.py
msgid "Lista de canale TV"
msgstr "Список ТВ-каналов"

#: lib/python/Plugins/Extensions/HdsWebControl/radio_web.py
msgid "Tasta verde deschide egalizatorul."
msgstr "Зелёная кнопка открывает эквалайзер."

