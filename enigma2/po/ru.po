#, python-format
msgid "DVB-T2 prin satelit: %s, pe %s. Se acordează transponderul %s și se caută fluxurile DVB-T2."
msgstr "DVB-T2 через спутник: %s, на %s. Настраивается транспондер %s и ищутся потоки DVB-T2."

#, python-format
msgid "DAB+ prin satelit: %s, pe %s. Se acordează transponderul %s și se caută radiourile DAB+."
msgstr "DAB+ через спутник: %s, на %s. Настраивается транспондер %s и ищутся радиостанции DAB+."

