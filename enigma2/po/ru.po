msgstr "Фильм не запустился."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Cererea a expirat. Încearcă încă o dată."
msgstr "Время запроса истекло. Попробуй ещё раз."

