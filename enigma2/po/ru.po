#: lib/python/Screens/HdsEditorCanaleUnelte.py
msgid "Ștergi %d rând dublat din buchete? Canalul rămâne în lista receptorului."
msgid_plural "Ștergi %d rânduri dublate din buchete? Canalele rămân în lista receptorului."
msgstr[0] "Удалить %d повторяющуюся строку из букетов? Канал остаётся в списке ресивера."
msgstr[1] "Удалить %d повторяющиеся строки из букетов? Каналы остаются в списке ресивера."
msgstr[2] "Удалить %d повторяющихся строк из букетов? Каналы остаются в списке ресивера."

#: lib/python/Screens/HdsEditorCanaleUnelte.py
msgid "Repari %d rând? Cel cu un canal găsit se leagă la el, altfel se șterge din buchet."
msgid_plural "Repari %d rânduri? Cele cu un canal găsit se leagă la el, celelalte se șterg din buchet."
msgstr[0] "Исправить %d строку? Если канал найден, она привяжется к нему, иначе удалится из букета."
msgstr[1] "Исправить %d строки? Те, для которых канал найден, привяжутся к нему, остальные удалятся из букета."
msgstr[2] "Исправить %d строк? Те, для которых канал найден, привяжутся к нему, остальные удалятся из букета."

#: lib/python/Screens/HdsEditorCanaleUnelte.py
msgid "în niciun buchet"
msgstr "ни в одном букете"

#: lib/python/Screens/HdsEditorCanaleUnelte.py
msgid "OK bifează sau debifează"
msgstr "OK отмечает или снимает отметку"

