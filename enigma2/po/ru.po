#: lib/python/Components/HdsFonturiGoogle.py:501
#, python-format
msgid "fișier tăiat: tabela „%s” trece de sfârșitul fișierului"
msgstr "обрезанный файл: таблица «%s» выходит за конец файла"

#: lib/python/Components/HdsFonturiGoogle.py:509
#, python-format
msgid "lipsește tabela obligatorie „%s”"
msgstr "нет обязательной таблицы «%s»"

#: lib/python/Components/HdsFonturiGoogle.py:512
msgid "nu are nici contururi (glyf), nici CFF: nu are ce desena"
msgstr "нет ни контуров (glyf), ни CFF: нечего рисовать"

#: lib/python/Components/HdsFonturiGoogle.py:518
msgid "nu are nume de familie în tabela „name”"
msgstr "в таблице «name» нет имени семейства"

#: lib/python/Components/HdsFonturiGoogle.py:524
#, python-format
msgid "fișierul se numește „%s”, nu „%s”"
msgstr "файл называется «%s», а не «%s»"

#: lib/python/Components/HdsFonturiGoogle.py:532
msgid "în regulă"
msgstr "в порядке"

#: lib/python/Components/HdsFonturiGoogle.py:615
#, python-format
msgid "Google nu a dat niciun fișier TTF pentru „%s”"
msgstr "Google не выдал ни одного файла TTF для «%s»"

#: lib/python/Components/HdsFonturiGoogle.py:639
