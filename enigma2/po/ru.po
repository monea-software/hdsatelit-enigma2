msgstr "Не отправлено ни одного выбора."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Adresa începe cu http:// sau https://, fără nume și parolă în ea."
msgstr "Адрес начинается с http:// или https://, без имени и пароля в нём."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Nu s-a schimbat nimic."
msgstr "Ничего не изменилось."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
