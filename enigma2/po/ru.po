msgstr "Убрать: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Serviciile de rezervă: când serviciul principal nu răspunde, receptorul "
"trece singur la următorul din listă."
msgstr "Резервные сервисы: когда основной сервис не отвечает, ресивер сам переходит к следующему в списке."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Căutarea nu e în această imagine."
msgstr "Поиска нет в этом образе."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Se caută în rețeaua de acasă..."
msgstr "Поиск в домашней сети..."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Nu am găsit niciun server în rețeaua de acasă."
msgstr "В домашней сети не найдено ни одного сервера."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Ollama la %s, modelul %s"
msgstr "Ollama на %s, модель %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
