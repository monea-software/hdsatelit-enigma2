msgid ""
"Apasă „Create a Workers AI API Token”, apoi „Create API Token” și „Copy API "
"Token”; copiază și „Account ID”, de la „Get Account ID”."
msgstr ""
"Druk op “Create a Workers AI API Token”, dan op “Create API Token” en “Copy "
"API Token”; kopiearje ek de “Account ID”, by “Get Account ID”."

msgid "Apasă „Create credentials”, „API key” și copiază cheia."
msgstr "Druk op “Create credentials”, “API key” en kopiearje de kaai."

msgid ""
"Apasă „Probează traducerea”. Dacă nu merge, mesajul arată începutul "
"răspunsului serverului, ca să vezi unde e traducerea și ce cale să scrii."
msgstr ""
"Druk op “Test de oersetting”. As it net wurket, toant de melding it begjin "
"fan it antwurd fan de server, sadatsto sjochst wêr't de oersetting stiet en "
"hokker paadsto type moatst."

msgid ""
"Apasă „Review + create”, apoi „Create”. Când e gata, apasă „Go to resource”."
msgstr ""
"Druk op “Review + create” en dêrnei op “Create”. As it klear is, drukst op "
"“Go to resource”."

