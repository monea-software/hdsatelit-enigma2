msgstr "the test file does not exist"

#: lib/python/Components/HdsEgalizator.py
msgid "fișierul probei nu s-a putut scrie"
msgstr "the test file could not be written"

#: lib/python/Components/HdsEgalizator.py
msgid "o eroare neașteptată"
msgstr "an unexpected error"

#: lib/python/Components/HdsEgalizator.py
#, python-format
