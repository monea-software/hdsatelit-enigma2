msgstr "The player did not load from the receiver. Reload the page."

#: lib/python/Plugins/Extensions/HdsWebControl/vezi_live_web.py
msgid "Exportă playlist (M3U)"
msgstr "Export playlist (M3U)"

#: lib/python/Plugins/Extensions/HdsWebControl/vezi_live_web.py
