msgstr "The name and password of your HMA account. Once saved they are never shown again. They are easier to type on your phone, in the web interface."

#: lib/python/Components/HdsVpn.py
msgid "Numele și parola de serviciu"
msgstr "Service name and password"

#: lib/python/Components/HdsVpn.py
msgid "Proton VPN, fișiere OpenVPN"
msgstr "Proton VPN, OpenVPN files"

#: lib/python/Components/HdsVpn.py
msgid "Surfshark, fișiere OpenVPN"
msgstr "Surfshark, OpenVPN files"

#: lib/python/Components/HdsVpn.py
