msgid "Ghidul: texte traduse %d (%d semne trimise, din cota serviciului), cereri %d, deja în limba ta %d, sărite %d."
msgstr "EPG: texts translated %d (%d characters sent, from the service quota), requests %d, already in your language %d, skipped %d."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Traduceri ținute minte: %d (%s)."
msgstr "Translations remembered: %d (%s)."

#: lib/python/Screens/HdsTraducereSubtitrari.py
