msgstr "The scan stopped before the end and saved nothing. Try again."

#: lib/python/Hds/DabT2/scanare.py
#, python-format
msgid "Detectorul s-a oprit cu codul %s, fara un raspuns care sa se poata citi."
msgstr "The detector exited with code %s without a readable answer."

#: lib/python/Hds/DabT2/scanare.py
