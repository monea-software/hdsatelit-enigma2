#: lib/python/Components/HdsConfigurareTraducere.py
msgid "%s nu dă modelul ales (nu există sau cere planul plătit). Alege alt model din listă; cel din fabrică e %s."
msgstr "%s does not provide the chosen model (it does not exist or needs the paid plan). Choose another model from the list; the default one is %s."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "%s spune că nu mai e credit în cont (HTTP 402)."
msgstr "%s says there is no credit left in the account (HTTP 402)."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "32 de litere și cifre, din panoul Cloudflare, la Account ID."
msgstr "32 letters and digits, from the Cloudflare dashboard, under Account ID."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Apasă „Create API Key”, scrie un nume și copiază cheia (începe cu gsk_); Groq o arată o singură dată."
msgstr "Press “Create API Key”, type a name and copy the key (it starts with gsk_); Groq shows it only once."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Apasă „Create a Workers AI API Token”, apoi „Create API Token” și „Copy API Token”. Păstrează jetonul."
msgstr "Press “Create a Workers AI API Token”, then “Create API Token” and “Copy API Token”. Keep the token."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Apasă „Create a Workers AI API Token”, apoi „Create API Token” și „Copy API Token”; copiază și „Account ID”, de la „Get Account ID”."
msgstr "Press “Create a Workers AI API Token”, then “Create API Token” and “Copy API Token”; also copy the “Account ID”, under “Get Account ID”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Calculatorul trebuie să fie pornit când vrei traducere. Calitatea e mai slabă decât la serviciile de pe internet, dar nu costă nimic și nimic nu iese din casă."
msgstr "The computer must be on when you want translation. The quality is lower than with the services on the internet, but it costs nothing and nothing leaves the house."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheia apare în portal; o poți verifica la „Test your API Key”. Aici scrie adresa https://libretranslate.com și lipește cheia."
msgstr "The key appears in the portal; you can check it under “Test your API Key”. Here, type the address https://libretranslate.com and paste the key."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Cheia o faci cu emailul sau cu contul tău Google. Pune și o rezervă pentru zilele cu multe subtitrări."
msgstr "You make the key with your email or your Google account. Also set a backup for days with many subtitles."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cloudflare Workers"
msgstr "Cloudflare Workers"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cloudflare Workers nu dă modelul ales din acest cont (HTTP %d): modelul cere planul plătit sau nu există. Alege alt model, de exemplu %s."
msgstr "Cloudflare Workers does not provide the chosen model for this account (HTTP %d): the model needs the paid plan or does not exist. Choose another model, for example %s."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cont nou (planul „Developer”): 1.000.000 de caractere în total, o singură dată, nu în fiecare lună. Cheile vechi (se termină cu :fx) merg în continuare."
msgstr "New account (the “Developer” plan): 1,000,000 characters in total, only once, not every month. Old keys (ending in :fx) keep working."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cum folosești LibreTranslate"
msgstr "How to use LibreTranslate"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Când s-au terminat, Cloudflare răspunde cu eroarea 429 până a doua zi: receptorul trece la serviciul de rezervă, dacă ai pus unul. Pe planul gratuit nu se plătește nimic."
msgstr "When they run out, Cloudflare answers with error 429 until the next day: the receiver switches to the backup service, if you have set one. On the free plan nothing is charged."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Din panoul Cloudflare iei un jeton și ID-ul contului."
msgstr "From the Cloudflare dashboard you take a token and the account ID."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Gratuit și rapid; limită pe zi, ajunge pentru câteva filme"
msgstr "Free and fast; daily limit, enough for a few films"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Gratuit: 10.000 de unități („neuroni”) pe zi, care ajung pentru câteva filme pe zi. Se reînnoiesc în fiecare zi la 00:00 UTC (ora 3 vara și ora 2 iarna, ora României)."
msgstr "Free: 10,000 units (“neurons”) per day, enough for a few films a day. They renew every day at 00:00 UTC (3 a.m. in summer and 2 a.m. in winter, Romanian time)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Gratuit: 30 de cereri pe minut, 1.000 pe zi și 200.000 de bucăți de text („tokeni”) pe zi; ajung pentru circa două filme pe zi. Cifrele le poate schimba Groq: le vezi în contul tău, la „Limits”."
msgstr "Free: 30 requests per minute, 1,000 per day and 200,000 pieces of text (“tokens”) per day; enough for about two films a day. Groq can change the figures: you see them in your account, under “Limits”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Gratuit; ajunge pentru câteva filme pe zi"
msgstr "Free; enough for a few films a day"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Groq"
msgstr "Groq"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "ID-ul contului Cloudflare"
msgstr "Cloudflare account ID"

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "ID-ul contului Cloudflare are 32 de litere și cifre (de la „Account ID”). Cheia nu a plecat nicăieri."
msgstr "The Cloudflare account ID has 32 letters and digits (under “Account ID”). The key was not sent anywhere."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Intră pe console.groq.com și înscrie-te cu emailul sau cu contul tău Google."
msgstr "Go to console.groq.com and sign up with your email or your Google account."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Intră pe dash.cloudflare.com și fă un cont gratuit (email și parolă)."
msgstr "Go to dash.cloudflare.com and make a free account (email and password)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Intră pe www.deepl.com/en/pro#api (prețurile DeepL) și alege fila „API”, nu „Translator”."
msgstr "Go to www.deepl.com/en/pro#api (the DeepL prices) and choose the “API” tab, not “Translator”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "La planul gratuit „Developer” apasă „Sign up for free”."
msgstr "On the free “Developer” plan, press “Sign up for free”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Mistral: adresa https://api.mistral.ai/v1, modelul mistral-small-2603 și cheia din contul tău Mistral, la „API keys”; limitele planului gratuit le vezi în cont."
msgstr "Mistral: the address https://api.mistral.ai/v1, the model mistral-small-2603 and the key from your Mistral account, under “API keys”; you see the limits of the free plan in the account."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Modelul Cloudflare Workers"
msgstr "Cloudflare Workers model"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Modelul Groq"
msgstr "Groq model"

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Modelul se schimbă numai la Gemini, Groq, Cloudflare Workers și la serverele compatibile OpenAI."
msgstr "The model can be changed only for Gemini, Groq, Cloudflare Workers and the OpenAI-compatible servers."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Nu adăuga card la cont, ca să rămâi pe planul gratuit."
msgstr "Do not add a card to the account, so that you stay on the free plan."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Nu scrie niciodată o parolă sau o cheie în adresă: pune-o la antet. Cheia LibreTranslate de pe internet pleacă în corpul cererii, deci pentru ea alege serviciul LibreTranslate, nu adresa proprie."
msgstr "Never write a password or a key in the address: put it in the header. The key for LibreTranslate on the internet is sent in the body of the request, so for it choose the LibreTranslate service, not “Custom address”."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Nu trece contul pe planul plătit („Workers Paid”), ca să rămâi pe gratuit."
msgstr "Do not switch the account to the paid plan (“Workers Paid”), so that you stay free."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK deschide tastatura. ID-ul contului are 32 de litere și cifre: în panoul Cloudflare, la „Account ID”."
msgstr "OK opens the keyboard. The account ID has 32 letters and digits: in the Cloudflare dashboard, under “Account ID”."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK: alegi modelul din listă (sau îl scrii). Cel din fabrică: %s."
msgstr "OK: you choose the model from the list (or type it). The default: %s."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "OpenRouter: adresa https://openrouter.ai/api/v1, un model cu :free la sfârșit (de exemplu google/gemma-4-31b-it:free) și cheia din contul tău OpenRouter. Gratuit sunt numai 50 de cereri pe zi, prea puțin pentru un film."
msgstr "OpenRouter: the address https://openrouter.ai/api/v1, a model with :free at the end (for example google/gemma-4-31b-it:free) and the key from your OpenRouter account. Only 50 requests per day are free, too few for a film."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pe aceeași pagină, la „Get Account ID”, copiază „Account ID” (ID-ul contului, 32 de litere și cifre)."
msgstr "On the same page, under “Get Account ID”, copy the “Account ID” (32 letters and digits)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pe calculatorul din casă: fără limită, gratuit; viteza depinde de calculator (pentru cele 7 limbi din comandă, cam 2 GB de memorie liberă). Pe libretranslate.com: Pro, traduceri nelimitate, cu rafale de până la 80 de cereri pe minut; Business, până la 200 pe minut. Varianta de pe internet nu e gratuită."
msgstr "On the computer at home: no limit, free; the speed depends on the computer (for the 7 languages in the command, about 2 GB of free memory). On libretranslate.com: Pro, unlimited translations, in bursts of up to 80 requests per minute; Business, up to 200 per minute. The internet version is not free."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pe internet, cu cheie: orice serviciu compatibil OpenAI merge; scrii adresa, modelul și cheia lui. Groq și Cloudflare Workers au locul lor în lista serviciilor, cu pașii lor: alege-le acolo."
msgstr "On the internet, with a key: any OpenAI-compatible service works; you type its address, the model and its key. Groq and Cloudflare Workers have their own place in the list of services, with their own steps: choose them there."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pe internet, cu plată: intră pe portal.libretranslate.com și apasă „Get API Key”. Alege planul (Pro: 29 de dolari pe lună; Business: 58 de dolari pe lună), apasă „BUY” și plătește. Nu există probă gratuită și nici cheie gratuită; ai 7 zile să ceri banii înapoi."
msgstr "On the internet, paid: go to portal.libretranslate.com and press “Get API Key”. Choose the plan (Pro: 29 dollars a month; Business: 58 dollars a month), press “BUY” and pay. There is no free trial and no free key; you have 7 days to ask for your money back."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Pe pagina deschisă intră cu emailul sau cu contul tău Google."
msgstr "On the opened page, sign in with your email or your Google account."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Pe pagina deschisă intră în contul Cloudflare (sau fă unul gratuit): se deschide pagina „Workers AI”. Apasă „Use REST API”."
msgstr "On the opened page, sign in to the Cloudflare account (or make a free one): the “Workers AI” page opens. Press “Use REST API”."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Pe pagina deschisă intră în contul DeepL API. Dacă nu ai unul, fă-l gratuit, cu planul „Developer” (1.000.000 de caractere, o singură dată)."
msgstr "On the opened page, sign in to the DeepL API account. If you do not have one, make it for free, with the “Developer” plan (1,000,000 characters, only once)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Pentru Cloudflare Workers scrie și ID-ul contului (32 de litere și cifre, de la „Account ID”). Cheia nu a plecat nicăieri."
msgstr "For Cloudflare Workers also type the account ID (32 letters and digits, under “Account ID”). The key was not sent anywhere."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pentru subtitrări multe pune în setări și servicii de rezervă, de exemplu Azure Translator: când Groq dă eroarea 429, receptorul trece singur la următorul."
msgstr "For many subtitles, also set backup services in the settings, for example Azure Translator: when Groq gives error 429, the receiver switches to the next one by itself."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Peste limită Groq răspunde cu eroarea 429: receptorul așteaptă cât spune Groq și trece între timp la serviciul de rezervă, dacă ai pus unul. Fără card nu se plătește nimic."
msgstr "Above the limit Groq answers with error 429: the receiver waits as long as Groq says and meanwhile switches to the backup service, if you have set one. Without a card nothing is charged."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Plan gratuit Developer: 1.000.000 de caractere, o singură dată."
msgstr "Free Developer plan: 1,000,000 characters, only once."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pune aici jetonul (la cheie) și ID-ul contului. Modelul e @cf/google/gemma-4-26b-a4b-it; e scris deja."
msgstr "Enter the token here (as the key) and the account ID. The model is @cf/google/gemma-4-26b-a4b-it; it is already filled in."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Pune cheia aici. Modelul recomandat e openai/gpt-oss-20b (rapid); e scris deja. openai/gpt-oss-120b e mai mare și mai lent."
msgstr "Enter the key here. The recommended model is openai/gpt-oss-20b (fast); it is already filled in. openai/gpt-oss-120b is bigger and slower."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Rezervele, în ordine: %s."
msgstr "The backups, in order: %s."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Scrie alt model"
msgstr "Type another model"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Serviciile de pe internet pot avea limită pe zi: pune și un serviciu de rezervă (de exemplu Azure Translator). Cheia o scrii o singură dată; receptorul o ține criptată și o trimite numai la adresa pentru care ai pus-o."
msgstr "Services on the internet can have a daily limit: also set a backup service (for example Azure Translator). You type the key only once; the receiver keeps it encrypted and sends it only to the address you set it for."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Termină înscrierea (email și parolă). Planul „Developer” e gratuit și nu trece singur pe plată."
msgstr "Finish signing up (email and password). The “Developer” plan is free and does not switch to paid by itself."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Verifică jetonul și ID-ul contului: copiază din nou jetonul (în panoul Cloudflare, pagina „Workers AI”, „Use REST API”) și ID-ul contului (la „Account ID”), fără spații."
msgstr "Check the token and the account ID: copy the token again (in the Cloudflare dashboard, the “Workers AI” page, “Use REST API”) and the account ID (under “Account ID”), without spaces."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "un ID de cont Cloudflare bun (32 de litere și cifre, de la Account ID)"
msgstr "a valid Cloudflare account ID (32 letters and digits, under Account ID)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "În casă nu are cotă: e gratuit, fără limită, și nimic nu iese din casă. Pe internet depinde de serviciu (vezi pașii)."
msgstr "At home there is no quota: it is free, without limit, and nothing leaves the house. On the internet it depends on the service (see the steps)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "În casă nu e cazul. Pe internet, peste limită vine eroarea 429, iar fără credit eroarea 402: receptorul trece singur la serviciul de rezervă, dacă ai pus unul."
msgstr "At home this does not apply. On the internet, above the limit comes error 429, and without credit error 402: the receiver switches to the backup service by itself, if you have set one."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "În casă nu e cazul. Pe libretranslate.com, peste limita pe minut vine eroarea 429 câteva secunde: receptorul trece la serviciul de rezervă, dacă ai pus unul. LibreTranslate pe internet costă bani în fiecare lună; pentru subtitrări gratuite folosește mai bine Azure sau Gemini."
msgstr "At home this does not apply. On libretranslate.com, above the per-minute limit comes error 429 for a few seconds: the receiver switches to the backup service, if you have set one. LibreTranslate on the internet costs money every month; for free subtitles better use Azure or Gemini."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "În meniu alege „API Keys”, apasă „Create API Key”, scrie un nume și copiază cheia (începe cu gsk_). Groq o arată o singură dată: copiaz-o imediat."
msgstr "In the menu choose “API Keys”, press “Create API Key”, type a name and copy the key (it starts with gsk_). Groq shows it only once: copy it right away."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "În panou deschide pagina „Workers AI” și apasă „Use REST API”."
msgstr "In the dashboard open the “Workers AI” page and press “Use REST API”."

# HD Satelit: Locuri din retea (Components/HdsStocareRetea.py, Screens/HdsLocuriRetea.py, locuri_retea_web.py)
#: lib/python/Components/HdsStocareRetea.py
msgid "Calculator cu Windows sau NAS (SMB)"
msgstr "Windows computer or NAS (SMB)"

#: lib/python/Components/HdsStocareRetea.py
msgid "NAS sau Linux (NFS)"
msgstr "NAS or Linux (NFS)"

#: lib/python/Components/HdsStocareRetea.py
msgid "Server FTP"
msgstr "FTP server"

#: lib/python/Components/HdsStocareRetea.py
msgid "Server FTP securizat (FTPS)"
msgstr "Secure FTP server (FTPS)"

#: lib/python/Components/HdsReteaProtocoale.py
msgid "WebDAV"
msgstr "WebDAV"

#: lib/python/Components/HdsStocareRetea.py
msgid "WebDAV securizat (HTTPS)"
msgstr "Secure WebDAV (HTTPS)"

#: lib/python/Components/HdsStocareRetea.py
msgid "Server media din casă (DLNA)"
msgstr "Home media server (DLNA)"

#: lib/python/Components/HdsStocareRetea.py
msgid "Numele de utilizator sau parola nu sunt bune, ori utilizatorul nu are voie în acest dosar."
msgstr "The user name or password is wrong, or the user is not allowed in this folder."

#: lib/python/Components/HdsStocareRetea.py
msgid "Serverul nu răspunde. Verifică dacă este pornit și în aceeași rețea cu receptorul."
msgstr "The server is not responding. Check that it is on and on the same network as the receiver."

#: lib/python/Components/HdsStocareRetea.py
msgid "Numele serverului nu se găsește în rețea. Scrie adresa lui, de pildă 192.168.1.20."
msgstr "The server name cannot be found on the network. Enter its address, for example 192.168.1.20."

#: lib/python/Components/HdsStocareRetea.py
msgid "Dosarul nu există pe server. Verifică numele lui."
msgstr "The folder does not exist on the server. Check its name."

#: lib/python/Components/HdsStocareRetea.py
msgid "Acest fel de loc nu se poate monta pe receptor."
msgstr "This kind of place cannot be mounted on the receiver."

#: lib/python/Components/HdsStocareRetea.py
msgid "Serverul nu folosește nicio versiune pe care o cunoaște receptorul. La SMB, pornește pe server SMB 2 sau SMB 3."
msgstr "The server uses no version the receiver knows. For SMB, turn on SMB 2 or SMB 3 on the server."

#: lib/python/Components/HdsStocareRetea.py
msgid "Locul este deja montat."
msgstr "The place is already mounted."

#: lib/python/Components/HdsStocareRetea.py
msgid "Pe server nu mai este loc."
msgstr "There is no space left on the server."

#: lib/python/Components/HdsStocareRetea.py
msgid "Pe acest loc nu se poate scrie: este numai pentru citire."
msgstr "This place cannot be written to: it is read-only."

#: lib/python/Components/HdsStocareRetea.py
msgid "Receptorul nu poate face dosarul în care se montează locul."
msgstr "The receiver cannot create the folder where the place is mounted."

#: lib/python/Components/HdsStocareRetea.py
msgid "Serverul nu a răspuns la timp. Încearcă încă o dată."
msgstr "The server did not respond in time. Try again."

#: lib/python/Components/HdsStocareRetea.py
msgid "Parola acestui loc nu este salvată pe receptor. Scrie-o din nou la Editează."
msgstr "This place's password is not saved on the receiver. Enter it again in Edit."

#: lib/python/Components/HdsStocareRetea.py
msgid "Legătura securizată cu serverul nu s-a putut face (certificatul nu este bun)."
msgstr "The secure connection to the server could not be made (the certificate is not valid)."

#: lib/python/Components/HdsStocareRetea.py
msgid "Receptorul nu este legat la rețea."
msgstr "The receiver is not connected to the network."

#: lib/python/Components/HdsStocareRetea.py
msgid "Locul este prea lent pentru înregistrări."
msgstr "The place is too slow for recordings."

#: lib/python/Components/HdsStocareRetea.py
msgid "Cererea nu este bună."
msgstr "The request is not valid."

#: lib/python/Components/HdsStocareRetea.py
msgid "Locul nu mai există. Poate a fost șters între timp."
msgstr "The place no longer exists. It may have been deleted in the meantime."

#: lib/python/Components/HdsStocareRetea.py
msgid "Locul nu s-a putut deschide. Încearcă încă o dată."
msgstr "The place could not be opened. Try again."

#: lib/python/Components/HdsStocareRetea.py
msgid "Gata de răsfoit"
msgstr "Ready to browse"

#: lib/python/Components/HdsStocareRetea.py
msgid "Montat"
msgstr "Mounted"

#: lib/python/Components/HdsStocareRetea.py
msgid "Nemontat"
msgstr "Not mounted"

#: lib/python/Components/HdsStocareRetea.py
#, python-format
msgid "Locul scrie cu %s MB/s: ajunge pentru înregistrări, și pentru canale 4K."
msgstr "The place writes at %s MB/s: enough for recordings, and for 4K channels too."

#: lib/python/Components/HdsStocareRetea.py
msgid "Alege felul locului."
msgstr "Choose the kind of place."

#: lib/python/Components/HdsStocareRetea.py
msgid "Portul trebuie să fie un număr între 1 și 65535 (0 pentru cel obișnuit)."
msgstr "The port must be a number between 1 and 65535 (0 for the default)."

#: lib/python/Components/HdsStocareRetea.py
msgid "Scrie numele dosarului partajat de pe server, de pildă Filme."
msgstr "Enter the name of the shared folder on the server, for example Filme."

#: lib/python/Components/HdsStocareRetea.py
msgid "Scrie dosarul exportat de server, de pildă volume1/filme."
msgstr "Enter the folder exported by the server, for example volume1/filme."

#: lib/python/Components/HdsStocareRetea.py
msgid "Dosarul nu poate conține '..'."
msgstr "The folder cannot contain '..'."

#: lib/python/Components/HdsStocareRetea.py
msgid "Numele de utilizator nu poate conține virgule sau rânduri noi."
msgstr "The user name cannot contain commas or new lines."

#: lib/python/Components/HdsStocareRetea.py
msgid "Nu s-a deschis"
msgstr "Not opened"

#: lib/python/Components/HdsStocareRetea.py
msgid "Montat, folosit și pentru înregistrări"
msgstr "Mounted, also used for recordings"

#: lib/python/Components/HdsStocareRetea.py
#, python-format
msgid "Locul scrie cu %s MB/s: prea încet pentru înregistrări (trebuie cel puțin %s MB/s). Încearcă un cablu de rețea în locul Wi-Fi-ului sau alt server."
msgstr "The place writes at %s MB/s: too slow for recordings (at least %s MB/s is needed). Try a network cable instead of Wi-Fi, or another server."

#: lib/python/Components/HdsStocareRetea.py
#, python-format
