#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Actualizează rapid"
msgstr "Quick update"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Un singur clic caută actualizarea, o instalează dacă există și repornește interfața."
msgstr "A single click looks for the update, installs it if there is one and restarts the interface."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Pornești actualizarea rapidă? Dacă există o actualizare, se instalează, apoi interfața se repornește singură."
msgstr "Start the quick update? If there is an update, it is installed, then the interface restarts by itself."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Caut actualizarea"
msgstr "Looking for the update"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
#, python-format
msgid "Instalez versiunea %s"
msgstr "Installing version %s"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Instalez actualizarea"
msgstr "Installing the update"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Repornesc interfața"
msgstr "Restarting the interface"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Interfața repornește. Aștept să revină..."
msgstr "The interface is restarting. Waiting for it to come back..."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
#, python-format
msgid "Actualizat la %s."
msgstr "Updated to %s."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
#, python-format
msgid "Interfața a repornit cu versiunea %s, nu cu %s."
msgstr "The interface restarted with version %s, not %s."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Interfața nu a revenit în 4 minute. Verifică receptorul."
msgstr "The interface did not come back within 4 minutes. Check the receiver."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Interfața nu s-a repornit. Apasă Repornește interfața."
msgstr "The interface did not restart. Press Restart the interface."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea rapidă este deja în lucru."
msgstr "The quick update is already in progress."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Interfața se repornește acum."
msgstr "The update has been installed. The interface is restarting now."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Interfața se repornește singură după înregistrare."
msgstr "The update has been installed. The interface restarts by itself after the recording."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Interfața se repornește singură după ce se termină lucrarea din fundal."
msgstr "The update has been installed. The interface restarts by itself when the background task ends."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Pe televizor se așteaptă un răspuns la întrebarea de repornire."
msgstr "The update has been installed. The TV is waiting for an answer to the restart question."

#: lib/python/Components/HdsActualizari.py
msgid "Repornirea a fost refuzată pe televizor. Actualizarea se folosește după ce repornești interfața."
msgstr "The restart was refused on the TV. The update is used after you restart the interface."


#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Tradu teletextul"
msgstr "Translate teletext"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Teletextul tradus"
msgstr "Translated teletext"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Tradu HbbTV"
msgstr "Translate HbbTV"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Ce s-a tradus din teletext și HbbTV"
msgstr "What was translated from teletext and HbbTV"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "%s: texte traduse %d (%d semne trimise, din cota serviciului), cereri %d, deja în limba ta %d, sărite %d."
msgstr "%s: texts translated %d (%d characters sent, from the service quota), requests %d, already in your language %d, skipped %d."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Traduce paginile de teletext pe care le deschizi (tasta TEXT) în limba traducerii, cu aceleași servicii și chei. Pagina apare întâi în original, apoi tradusă. În teletext, AUDIO arată originalul paginii, iar MENU are aceleași alegeri. Consumă din cota serviciului, de aceea din fabrică e oprită; un text tradus o dată nu se mai cere."
msgstr "Translates the teletext pages you open (TEXT button) into the translation language, with the same services and keys. The page appears in the original first, then translated. In teletext, AUDIO shows the original page, and MENU has the same choices. It uses the service quota, so it is off by default; a text translated once is not requested again."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "În pagină: rândurile traduse iau locul celor originale, în cele 40 de coloane ale paginii, cu aceleași culori; ce nu încape se taie cu „…”. Într-un panou: pagina originală, mai mică, în stânga, și traducerea întreagă în dreapta."
msgstr "On the page: the translated lines take the place of the original ones, in the 40 columns of the page, with the same colours; what does not fit is cut with \"…\". In a panel: the original page, smaller, on the left, and the whole translation on the right."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Traduce textele văzute din aplicațiile HbbTV (tasta ROȘIE), ca „Traduce pagina” din browsere: numai textele de pe ecran, nu adresele, codul sau câmpurile de scris. Pagina apare întâi în original. Consumă din cota serviciului, de aceea din fabrică e oprită. Aplicațiile deschise pe https rămân deocamdată în original."
msgstr "Translates the visible texts of HbbTV applications (RED button), like \"Translate page\" in browsers: only the texts on the screen, not addresses, code or input fields. The page appears in the original first. It uses the service quota, so it is off by default. Applications opened over https stay in the original for now."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "În pagină"
msgstr "On the page"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Într-un panou"
msgstr "In a panel"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cu „Tradu teletextul” pornită pleacă la același serviciu și textul paginilor de teletext pe care le deschizi."
msgstr "With \"Translate teletext\" on, the text of the teletext pages you open also goes to the same service."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cu „Tradu HbbTV” pornită pleacă la același serviciu și textele văzute ale aplicațiilor HbbTV pe care le deschizi."
msgstr "With \"Translate HbbTV\" on, the visible texts of the HbbTV applications you open also go to the same service."

#: lib/python/Screens/HdsTeletext.py
msgid "AUDIO: traducerea"
msgstr "AUDIO: translation"

#: lib/python/Screens/HdsTeletext.py
msgid "AUDIO: originalul"
msgstr "AUDIO: original"

#: lib/python/Screens/HdsTeletext.py
msgid "Pagina în original"
msgstr "Page in the original"

#: lib/python/Screens/HdsTeletext.py
msgid "Se traduce pagina…"
msgstr "Translating the page…"

#: lib/python/Screens/HdsTeletext.py
msgid "Pagina tradusă"
msgstr "Page translated"

#: lib/python/Screens/HdsTeletext.py
msgid "Pagina e deja în limba ta"
msgstr "The page is already in your language"

#: lib/python/Screens/HdsTeletext.py
msgid "Pagina nu are text de tradus"
msgstr "The page has no text to translate"

#: lib/python/Screens/HdsTeletext.py
msgid "Traducerea nu are un serviciu gata: Meniu, Traducerea subtitrărilor"
msgstr "No translation service is ready: Menu, Subtitle translation"

#: lib/python/Screens/HdsTeletext.py
msgid "Traducerea teletextului e oprită. O pornești din MENU."
msgstr "Teletext translation is off. Turn it on from MENU."

#: lib/python/Screens/HdsTeletext.py
msgid "Pagina în original. AUDIO: traducerea."
msgstr "Page in the original. AUDIO: translation."

#: lib/python/Screens/HdsTeletext.py
msgid "Pagina tradusă. AUDIO: originalul."
msgstr "Page translated. AUDIO: original."

#: lib/python/Screens/HdsTeletext.py
msgid "Traducerea teletextului pornită"
msgstr "Teletext translation on"

#: lib/python/Screens/HdsTeletext.py
msgid "Traducerea teletextului oprită"
msgstr "Teletext translation off"

#: lib/python/Screens/HdsTeletext.py
msgid "Traducerea într-un panou"
msgstr "Translation in a panel"

#: lib/python/Screens/HdsTeletext.py
msgid "Traducerea în pagină"
msgstr "Translation on the page"

#: lib/python/Screens/HdsTeletext.py
msgid "Tradu teletextul: oprește"
msgstr "Translate teletext: turn off"

#: lib/python/Screens/HdsTeletext.py
msgid "Tradu teletextul: pornește"
msgstr "Translate teletext: turn on"

