msgstr "The arrows choose, OK confirms. EXIT: stay in safe mode; the screen opens again from Menu > System Information > Safe mode."

#: lib/python/Screens/HdsModSigur.py
msgid "Aceleași alegeri sunt și în interfața web, la pagina /mod-sigur."
msgstr "The same choices are also in the web interface, on the /mod-sigur page."

#: lib/python/Screens/HdsModSigur.py
msgid "Ce s-a întâmplat"
msgstr "What happened"

#: lib/python/Screens/HdsModSigur.py
msgid "Text brut"
msgstr "Raw text"

#: lib/python/Screens/HdsModSigur.py
msgid "Stânga/Dreapta: alt fișier · Sus/Jos: derulare · OK: pe scurt · EXIT: înapoi"
msgstr "Left/Right: other file · Up/Down: scroll · OK: in short · EXIT: back"

#: lib/python/Screens/HdsModSigur.py
msgid "Sus/Jos: derulare · OK sau ALBASTRU: textul brut · EXIT: înapoi"
msgstr "Up/Down: scroll · OK or BLUE: raw text · EXIT: back"

#: lib/python/Screens/HdsModSigur.py
#, python-format
msgid "Aceleași alegeri sunt și în interfața web: %s"
msgstr "The same choices are also in the web interface: %s"

#: lib/python/Screens/HdsModSigur.py
msgid "Interfața se repornește."
msgstr "The interface is restarting."

#: lib/python/Screens/HdsModSigur.py
msgid "Nu există niciun fișier de arătat."
msgstr "There is no file to show."

#: lib/python/Screens/HdsModSigur.py
msgid "Se citesc fișierele..."
msgstr "Reading the files..."

#: lib/python/Screens/HdsModSigur.py
#, python-format
msgid "Fișierul: %s"
msgstr "File: %s"

#: lib/python/Plugins/Extensions/HdsWebControl/mod_sigur_web.py
msgid "Receptorul merge normal."
msgstr "The receiver is running normally."

#: lib/python/Plugins/Extensions/HdsWebControl/mod_sigur_web.py
#, python-format
msgid "Modul sigur pornește singur după %d opriri neașteptate ale interfeței în 10 minute: atunci pornesc numai extensiile venite cu imaginea, iar aici și pe televizor poți alege cum continui."
msgstr "Safe mode starts by itself after %d unexpected stops of the interface in 10 minutes: then only the extensions that came with the image start, and here and on the TV you can choose how to continue."

#: lib/python/Plugins/Extensions/HdsWebControl/mod_sigur_web.py
msgid "Alegere necunoscută."
msgstr "Unknown choice."

#: lib/python/Plugins/Extensions/HdsWebControl/mod_sigur_web.py
msgid "Receptorul nu este în modul sigur."
msgstr "The receiver is not in safe mode."

#: lib/python/Plugins/Extensions/HdsWebControl/mod_sigur_web.py
msgid "Interfața se repornește. Pagina se reîncarcă singură în câteva secunde."
msgstr "The interface is restarting. The page reloads by itself in a few seconds."

#: lib/python/Plugins/Extensions/HdsWebControl/mod_sigur_web.py
msgid "Ce poți face"
msgstr "What you can do"

#: lib/python/Plugins/Extensions/HdsWebControl/mod_sigur_web.py
msgid "Fișierele așa cum sunt pe receptor, fără rândurile cu parole sau cu cheia interfeței web."
msgstr "The files as they are on the receiver, without the lines with passwords or with the web interface key."

#: lib/python/Plugins/Extensions/HdsWebControl/mod_sigur_web.py
msgid "Pe televizor, același mesaj apare singur la pornire, în modul sigur, și din Meniu > Informații despre sistem > Mod sigur."
msgstr "On the TV, the same message appears by itself at startup in safe mode, and also from Menu > System Information > Safe mode."

#: lib/python/Plugins/Extensions/HdsWebControl/mod_sigur_web.py
msgid "Alegerea se aplică la următoarea repornire a interfeței."
msgstr "The choice applies at the next restart of the interface."

#: lib/python/Plugins/Extensions/HdsWebControl/mod_sigur_web.py
msgid "Pe televizor se cere o confirmare: o înregistrare e în curs sau începe curând. Alegerea se face numai dacă răspunzi Da acolo."
msgstr "The TV asks for a confirmation: a recording is in progress or starts soon. The choice is made only if you answer Yes there."

#: lib/python/Plugins/Extensions/HdsWebControl/mod_sigur_web.py
msgid "Receptorul a răspuns neașteptat."
msgstr "The receiver gave an unexpected answer."

#: lib/python/Plugins/Extensions/HdsWebControl/mod_sigur_web.py
msgid "Se aplică alegerea..."
msgstr "Applying the choice..."

#: lib/python/Screens/HdsFonturi.py
msgid "Mod sigur: fontul nu e încărcat acum."
msgstr "Safe mode: the font is not loaded now."

#: lib/python/Screens/HdsFonturi.py
msgid "Fontul nu e încărcat acum."
msgstr "The font is not loaded now."

#: lib/python/Screens/HdsAccesSsh.py
#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
#: data/menu.xml
msgid "Acces SSH"
msgstr "SSH access"

#: lib/python/Components/HdsAccesSsh.py
msgid "Cheia e stricată (textul de după tip nu e o cheie întreagă)."
msgstr "The key is damaged (the text after the type is not a complete key)."

#: lib/python/Components/HdsAccesSsh.py
msgid "Numai cu cheie"
msgstr "Key only"

#: lib/python/Components/HdsAccesSsh.py
msgid "Fără parolă în rețeaua locală: oprit."
msgstr "No password on the local network: off."

#: lib/python/Components/HdsAccesSsh.py
#, python-format
msgid "Chei adăugate: %d. Erau deja: %d. Refuzate: %d."
msgstr "Keys added: %d. Already there: %d. Refused: %d."

#: lib/python/Components/HdsAccesSsh.py
msgid "Cheia a fost ștearsă. Calculatorul cu această cheie intră de acum numai cu parola."
msgstr "The key was deleted. The computer with this key now logs in only with the password."

#: lib/python/Components/HdsAccesSsh.py
msgid "Oprit: pe receptor se intră numai cu parola sau cu o cheie."
msgstr "Off: the receiver can be accessed only with the password or a key."

#: lib/python/Components/HdsAccesSsh.py
msgid "Se lucrează..."
msgstr "Working..."

#: lib/python/Components/HdsAccesSsh.py
msgid "Nu am putut citi parola lui root."
msgstr "Could not read the root password."

#: lib/python/Components/HdsAccesSsh.py
msgid "Lipsește programul care face parola (hds-ssh-parola). Se intră numai cu o cheie."
msgstr "The program that creates the password (hds-ssh-parola) is missing. Login works only with a key."

#: lib/python/Components/HdsAccesSsh.py
msgid "Receptorul face parola, durează câteva secunde. Până atunci se intră numai cu o cheie."
msgstr "The receiver is creating the password, this takes a few seconds. Until then login works only with a key."

#: lib/python/Components/HdsAccesSsh.py
msgid "Pusă, nu se mai arată"
msgstr "Set, no longer shown"

#: lib/python/Components/HdsAccesSsh.py
msgid "Fără parolă"
msgstr "No password"

#: lib/python/Components/HdsAccesSsh.py
msgid "Necunoscută"
msgstr "Unknown"

#: lib/python/Components/HdsAccesSsh.py
msgid "Se face..."
msgstr "Being created..."

#: lib/python/Components/HdsAccesSsh.py
#, python-format
msgid "Te conectezi de pe calculator cu: ssh root@%s"
msgstr "Connect from a computer with: ssh root@%s"

#: lib/python/Components/HdsAccesSsh.py
msgid "Fără parolă în rețeaua locală: pornit. Oricine din rețeaua ta de acasă intră pe receptor fără parolă."
msgstr "No password on the local network: on. Anyone on your home network gets into the receiver without a password."

#: lib/python/Components/HdsAccesSsh.py
msgid "Rândul e prea lung pentru o cheie publică."
msgstr "The line is too long for a public key."

#: lib/python/Components/HdsAccesSsh.py
msgid "Rândul e gol."
msgstr "The line is empty."

#: lib/python/Components/HdsAccesSsh.py
msgid "Nu e o cheie publică SSH. Cheia începe cu ssh-ed25519, ssh-rsa sau ecdsa-sha2-."
msgstr "This is not an SSH public key. The key starts with ssh-ed25519, ssh-rsa or ecdsa-sha2-."

#: lib/python/Components/HdsAccesSsh.py
#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Nu ai dat nicio cheie."
msgstr "You did not give any key."

#: lib/python/Components/HdsAccesSsh.py
#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Textul e prea lung pentru câteva chei publice."
msgstr "The text is too long for a few public keys."

#: lib/python/Components/HdsAccesSsh.py
msgid "Ai dat o cheie privată. Pune cheia publică (fișierul .pub). Cheia privată rămâne numai la tine."
msgstr "You gave a private key. Give the public key (the .pub file). The private key stays only with you."

#: lib/python/Components/HdsAccesSsh.py
msgid "Cheia nu mai era pe receptor."
msgstr "The key was no longer on the receiver."

#: lib/python/Components/HdsAccesSsh.py
msgid "Pe stick nu am găsit dosarul hdsatelit/ssh cu chei. Pune în el fișierul authorized_keys sau cheile tale .pub."
msgstr "The folder hdsatelit/ssh with keys was not found on the USB stick. Put the authorized_keys file or your .pub keys in it."

#: lib/python/Components/HdsAccesSsh.py
msgid "Pe stick e o cheie privată. Lasă pe stick numai cheile publice (.pub). Cheia privată rămâne numai la tine."
msgstr "There is a private key on the USB stick. Leave only public keys (.pub) on it. The private key stays only with you."

#: lib/python/Components/HdsAccesSsh.py
msgid "Lipsește programul care face parola (hds-ssh-parola)."
msgstr "The program that creates the password (hds-ssh-parola) is missing."

#: lib/python/Components/HdsAccesSsh.py
msgid "Am făcut o parolă nouă. Cea veche nu mai merge."
msgstr "A new password was created. The old one no longer works."

#: lib/python/Components/HdsAccesSsh.py
msgid "Parola nouă nu s-a putut face. Parola de dinainte rămâne."
msgstr "The new password could not be created. The previous password stays."

#: lib/python/Components/HdsAccesSsh.py
msgid "Nu am putut ascunde parola."
msgstr "Could not hide the password."

#: lib/python/Components/HdsAccesSsh.py
msgid "Setarea nu s-a putut salva."
msgstr "The setting could not be saved."

#: lib/python/Components/HdsAccesSsh.py
msgid "Pornit: din rețeaua ta de acasă se intră pe receptor fără parolă."
msgstr "On: from your home network the receiver can be accessed without a password."

#: lib/python/Components/HdsAccesSsh.py
msgid "Notează parola, apoi alege „Am notat parola”: după aceea nu se mai arată."
msgstr "Write down the password, then choose \"I wrote down the password\": after that it is no longer shown."

#: lib/python/Components/HdsAccesSsh.py
msgid "Pornirea serverului SSH"
msgstr "SSH server startup"

#: lib/python/Components/HdsAccesSsh.py
msgid "Verificarea parolei (PAM)"
msgstr "Password check (PAM)"

#: lib/python/Components/HdsAccesSsh.py
msgid "Regula „Fără parolă în rețeaua locală”"
msgstr "The \"No password on the local network\" rule"

#: lib/python/Components/HdsAccesSsh.py
#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Cheile SSH"
msgstr "SSH keys"

#: lib/python/Components/HdsAccesSsh.py
msgid "Jurnalul parolei"
msgstr "Password log"

#: lib/python/Components/HdsAccesSsh.py
msgid "(fișierul nu există)"
msgstr "(the file does not exist)"

#: lib/python/Components/HdsAccesSsh.py
msgid "Tipul scris în fața cheii nu se potrivește cu cheia."
msgstr "The type written before the key does not match the key."

#: lib/python/Components/HdsAccesSsh.py
msgid "Cheile DSA nu mai sunt primite: sunt prea slabe. Fă o cheie Ed25519."
msgstr "DSA keys are no longer accepted: they are too weak. Create an Ed25519 key."

#: lib/python/Components/HdsAccesSsh.py
msgid "Rândul are opțiuni în fața cheii. Pune numai cheia publică, așa cum e în fișierul .pub."
msgstr "The line has options before the key. Give only the public key, as it is in the .pub file."

#: lib/python/Components/HdsAccesSsh.py
msgid "Programul parolei nu a terminat la timp."
msgstr "The password program did not finish in time."

#: lib/python/Components/HdsAccesSsh.py
msgid "Se face o parolă nouă..."
msgstr "Creating a new password..."

#: lib/python/Components/HdsAccesSsh.py
msgid "Se ascunde parola..."
msgstr "Hiding the password..."

#: lib/python/Components/HdsAccesSsh.py
msgid "Se adaugă cheile..."
msgstr "Adding the keys..."

#: lib/python/Components/HdsAccesSsh.py
msgid "Se citesc cheile de pe stick..."
msgstr "Reading the keys from the USB stick..."

#: lib/python/Components/HdsAccesSsh.py
msgid "Se șterge cheia..."
msgstr "Deleting the key..."

#: lib/python/Components/HdsAccesSsh.py
msgid "Se salvează setarea..."
msgstr "Saving the setting..."

#: lib/python/Components/HdsAccesSsh.py
#, python-format
msgid "De pe stick, fișiere citite: %d."
msgstr "Files read from the USB stick: %d."

#: lib/python/Components/HdsAccesSsh.py
msgid "Blocul cheii SSH2 nu e întreg."
msgstr "The SSH2 key block is incomplete."

#: lib/python/Components/HdsAccesSsh.py
#, python-format
msgid "Receptorul are deja %d de chei, cât primește cel mult."
msgstr "The receiver already has %d keys, the maximum it accepts."

#: lib/python/Components/HdsAccesSsh.py
msgid "Chei SSH pe receptor: niciuna."
msgstr "SSH keys on the receiver: none."

#: lib/python/Screens/HdsAccesSsh.py
#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Adaugă cheile de pe stick"
msgstr "Add keys from USB stick"

#: lib/python/Screens/HdsAccesSsh.py
msgid "Pune pe stick dosarul hdsatelit/ssh cu fișierul authorized_keys sau cu cheile tale .pub, apoi apasă OK."
msgstr "Put the folder hdsatelit/ssh with the authorized_keys file or your .pub keys on the USB stick, then press OK."

#: lib/python/Components/HdsAccesSsh.py
#, python-format
msgid "Chei SSH pe receptor: %d. Calculatoarele cu aceste chei intră fără parolă."
msgstr "SSH keys on the receiver: %d. Computers with these keys log in without a password."

#: lib/python/Screens/HdsAccesSsh.py
#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Am notat parola, ascunde-o"
msgstr "I wrote down the password, hide it"

#: lib/python/Screens/HdsAccesSsh.py
msgid "Parola rămâne pusă, dar nu se mai arată aici și nici în interfața web. Dacă o uiți, faci una nouă."
msgstr "The password stays set, but is no longer shown here or in the web interface. If you forget it, create a new one."

#: lib/python/Screens/HdsAccesSsh.py
#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Fă o parolă nouă"
msgstr "Create a new password"

#: lib/python/Screens/HdsAccesSsh.py
msgid "Receptorul face o parolă la întâmplare și o arată aici. Cea veche nu mai merge."
msgstr "The receiver creates a random password and shows it here. The old one no longer works."

#: lib/python/Screens/HdsAccesSsh.py
#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Fă o parolă"
msgstr "Create a password"

#: lib/python/Screens/HdsAccesSsh.py
msgid "Receptorul face o parolă la întâmplare și o arată aici."
msgstr "The receiver creates a random password and shows it here."

#: lib/python/Screens/HdsAccesSsh.py
msgid "Fără parolă în rețeaua locală: pornit"
msgstr "No password on the local network: on"

#: lib/python/Screens/HdsAccesSsh.py
msgid "OK oprește. Oricine din rețeaua ta de acasă intră acum pe receptor fără parolă."
msgstr "OK turns it off. Anyone on your home network now gets into the receiver without a password."

#: lib/python/Screens/HdsAccesSsh.py
msgid "Fără parolă în rețeaua locală: oprit"
msgstr "No password on the local network: off"

#: lib/python/Screens/HdsAccesSsh.py
#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Rămâne oprit dacă nu ai un motiv anume. Pornit, oricine din rețeaua ta de acasă intră pe receptor fără parolă."
msgstr "Keep it off unless you have a specific reason. When on, anyone on your home network gets into the receiver without a password."

#: lib/python/Screens/HdsAccesSsh.py
msgid "Așteaptă să se termine ce ai pornit înainte."
msgstr "Wait for what you started before to finish."

#: lib/python/Screens/HdsAccesSsh.py
#, python-format
msgid "Șterge cheia: %s"
msgstr "Delete key: %s"

#: lib/python/Screens/HdsAccesSsh.py
msgid "OK șterge cheia. Calculatorul cu această cheie intră apoi numai cu parola."
msgstr "OK deletes the key. The computer with this key then logs in only with the password."

#: lib/python/Screens/HdsAccesSsh.py
#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Faci o parolă nouă? Cea de acum nu mai merge."
msgstr "Create a new password? The current one will no longer work."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Așteaptă să se termine ce ai pornit înainte (pe televizor sau aici)."
msgstr "Wait for what you started before to finish (on the TV or here)."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Confirmă parola nouă: cea de acum nu mai merge după aceea."
msgstr "Confirm the new password: the current one no longer works afterwards."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Lipsește amprenta cheii."
msgstr "The key fingerprint is missing."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Confirmă ștergerea cheii."
msgstr "Confirm deleting the key."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Alege pornit sau oprit."
msgstr "Choose on or off."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Confirmă: oricine din rețeaua ta de acasă va intra pe receptor fără parolă."
msgstr "Confirm: anyone on your home network will get into the receiver without a password."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Parola nu se mai arată. Dacă ai uitat-o, fă una nouă."
msgstr "The password is no longer shown. If you forgot it, create a new one."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Parola și cheile se văd și se schimbă numai dintr-un browser conectat cu codul de pe televizor."
msgstr "The password and keys can be seen and changed only from a browser connected with the code from the TV."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "(cu opțiuni)"
msgstr "(with options)"

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
#, python-format
msgid "Aceleași lucruri sunt pe televizor, în %s."
msgstr "The same is on the TV, in %s."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Adaugă cheia"
msgstr "Add key"

#: lib/python/Components/HdsAccesSsh.py
msgid "Adresa receptorului în rețea nu e cunoscută."
msgstr "The receiver's network address is not known."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Ai lipit o cheie privată. Nu a plecat din pagină. Pune cheia publică (fișierul .pub); cheia privată rămâne numai la tine."
msgstr "You pasted a private key. It did not leave the page. Paste the public key (the .pub file); the private key stays only with you."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Ai notat parola? După aceea nu se mai arată nici aici, nici pe televizor."
msgstr "Have you written down the password? After that it is shown neither here nor on the TV."

#: lib/python/Screens/HdsAccesSsh.py
msgid "Ai notat parola? După aceea nu se mai arată nici aici, nici în interfața web."
msgstr "Have you written down the password? After that it is shown neither here nor in the web interface."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Arată codul pe televizor"
msgstr "Show the code on the TV"

#: lib/python/Components/HdsAccesSsh.py
msgid "Atenție: root nu are parolă și oricine din rețea intră pe receptor."
msgstr "Warning: root has no password and anyone on the network gets into the receiver."

#: lib/python/Components/HdsAccesSsh.py
msgid "Atenție: serverul SSH e pornit cu -B și primește conturi fără parolă."
msgstr "Warning: the SSH server runs with -B and accepts accounts without a password."

#: lib/python/Components/HdsAccesSsh.py
msgid "Atenție: „Fără parolă în rețeaua locală” e pornit. Oricine din rețeaua ta de acasă intră pe receptor."
msgstr "Warning: “No password on the local network” is on. Anyone on your home network gets into the receiver."

#: lib/python/Components/HdsAccesSsh.py
#, python-format
msgid "Cheia RSA are %d de biți. Receptorul primește numai chei RSA de cel puțin %d de biți."
msgstr "The RSA key has %d bits. The receiver accepts only RSA keys of at least %d bits."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Codul are 6 cifre."
msgstr "The code has 6 digits."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Codul de pe televizor"
msgstr "Code from the TV"

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Codul e pe televizor."
msgstr "The code is on the TV."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Codul nu a mers."
msgstr "The code did not work."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Codul nu s-a putut cere."
msgstr "The code could not be requested."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Conectat."
msgstr "Connected."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Conectează"
msgstr "Connect"

