msgstr "Last extension in the log"

#: lib/python/Components/HdsModSigur.py
msgid "A scris în jurnal chiar înainte de cădere."
msgstr "It wrote to the log just before the crash."

#: lib/python/Components/HdsModSigur.py
msgid "nu s-a putut (copia lipsea)"
msgstr "not possible (the copy was missing)"

#: lib/python/Components/HdsModSigur.py
msgid "nu s-a putut (memoria plină?)"
msgstr "not possible (memory full?)"

#: lib/python/Components/HdsModSigur.py
msgid "se pun înapoi singure setările de dinainte"
msgstr "the previous settings are put back automatically"

#: lib/python/Components/HdsModSigur.py
#, python-format
msgid "o extensie"
msgid_plural "%d extensii"
msgstr[0] "%d extension"
msgstr[1] "%d extensions"

#: lib/python/Components/HdsModSigur.py
msgid "Fiecare rând: secunde de la pornirea receptorului și codul opririi."
msgstr "Each line: seconds since the receiver started and the stop code."

