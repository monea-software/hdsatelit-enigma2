msgstr "Text rádia (RDS)"

msgid "Textul se trimite numai dintr-un browser asociat."
msgstr "Text sa odosiela len z pridruženého prehliadača."

msgid "Textul se trimite numai prin POST, din pagina „Navigator web”."
msgstr "Text sa odosiela len metódou POST, zo stránky „Webový prehliadač“."

msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor spre serverul de la adresa pe care o scrii. Dacă serverul e în casa "
"ta, nimic nu iese din casă."
msgstr ""
"Text titulkov (iba text, bez obrazu a bez zvuku) ide z prijímača na server "
"na adrese, ktorú zadáš. Ak je server u teba doma, nič neopustí domov."

#, python-format
msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor, prin internet, spre %s, care îl traduce. Cheia ta rămâne pe "
"receptor."
msgstr ""
"Text titulkov (len text, bez obrazu a bez zvuku) odchádza z prijímača cez "
"internet do služby %s, ktorá ho preloží. Tvoj kľúč zostáva v prijímači."

#, python-format
msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor, prin internet, spre serverul de la adresa scrisă de tine (%s), "
"care îl traduce."
msgstr ""
"Text titulkov (len text, bez obrazu a bez zvuku) odchádza z prijímača cez "
"internet na server na adrese, ktorú si zadal (%s), ktorý ho preloží."

#, python-format
msgid ""
"Textul subtitrărilor merge la serverul din casa ta (%s). Nimic nu iese din "
"casă."
msgstr "Text titulkov ide na server u teba doma (%s). Nič neopustí domov."

msgid "Textul tradus"
msgstr "Preložený text"

msgid "Textul tău"
msgstr "Tvoj text"

msgid "Textul tău pe afișaj (derulat dacă e lung)"
msgstr "Tvoj text na displeji (posúvaný, ak je dlhý)"

msgid "Thai"
msgstr "Thajčina"

msgid "Thailanda"
msgstr "Thajsko"

msgid ""
"Thank you for using the wizard. Your box is now ready to use.\n"
"Please press OK to start using your receiver."
msgstr ""
"Ďakujeme, že si použil sprievodcu. Prijímač je teraz pripravený na "
"použitie.\n"
"Stlač OK a začni používať prijímač."

msgid ""
"The NetworkWizard extension is not installed!\n"
"Please install it."
msgstr ""
"Rozšírenie NetworkWizard nie je nainštalované!\n"
"Nainštaluj ho."

msgid "The PIN code has been changed successfully."
msgstr "Kód PIN bol úspešne zmenený."

msgid "The PIN codes you entered are different."
msgstr "Zadané kódy PIN sa líšia."

msgid ""
"The Softwaremanagement extension is not installed!\n"
"Please install it."
msgstr ""
"Rozšírenie Softwaremanagement nie je nainštalované!\n"
"Nainštaluj ho."

msgid "The WiFi adapter could not be started."
msgstr "Wi-Fi adaptér sa nepodarilo spustiť."

msgid "The WiFi screen could not be opened."
msgstr "Wi-Fi obrazovku sa nepodarilo otvoriť."

msgid "The WiFi settings could not be saved."
msgstr "Wi-Fi nastavenia sa nepodarilo uložiť."

#, python-format
msgid ""
"The directory %s is not writable.\n"
"Make sure you select a writable directory instead."
msgstr ""
"Do adresára %s sa nedá zapisovať.\n"
"Vyber namiesto neho adresár, do ktorého sa dá zapisovať."

msgid "The following files were found..."
msgstr "Našli sa tieto súbory..."

msgid "The installation of the default services lists is finished."
msgstr "Inštalácia predvolených zoznamov staníc je dokončená."

msgid ""
"The installation of the default settings is finished. You can now continue "
"configuring your receiver by pressing the OK button on the remote control."
msgstr ""
"Inštalácia predvolených nastavení je dokončená. Teraz môžeš pokračovať v "
"nastavovaní prijímača stlačením tlačidla OK na diaľkovom ovládaní."

msgid ""
"The name cannot contain / or \\, cannot start with a dot and must fit in 255 "
"characters."
msgstr ""
"Názov nemôže obsahovať / ani \\, nemôže začínať bodkou a musí sa zmestiť do "
"255 znakov."

msgid "The network settings could not be saved."
msgstr "Sieťové nastavenia sa nepodarilo uložiť."

msgid ""
"The new mode is used when a channel starts. Keep it?\n"
"Without an answer the previous setting comes back."
msgstr ""
"Nový režim sa použije pri spustení kanála. Ponechať ho?\n"
"Bez odpovede sa vráti predchádzajúce nastavenie."

msgid "The new video setting was not confirmed. The previous setting is back."
msgstr ""
"Nové nastavenie obrazu nebolo potvrdené. Obnovilo sa predchádzajúce "
"nastavenie."

msgid "The package doesn't contain anything."
msgstr "Balíček neobsahuje nič."

msgid "The password may have at most 63 characters"
msgstr "Heslo môže mať najviac 63 znakov."

msgid "The password may only contain letters, digits and the usual signs"
msgstr "Heslo môže obsahovať iba písmená, číslice a bežné znaky."

msgid "The password must have at least 8 characters"
msgstr "Heslo musí mať aspoň 8 znakov."

#, python-format
msgid "The path %s already exists."
msgstr "Cesta %s už existuje."

msgid "The pin code you entered is wrong."
msgstr "Zadaný kód PIN je nesprávny."

msgid "The playlist is empty"
msgstr "Zoznam skladieb je prázdny"

msgid "The previous settings are back."
msgstr "Obnovili sa predchádzajúce nastavenia."

msgid "The previous settings could not be written back completely."
msgstr "Predchádzajúce nastavenia sa nepodarilo úplne obnoviť."

msgid ""
"The receiver did not accept the new video mode. The previous setting is back."
msgstr "Prijímač neprijal nový režim videa. Predchádzajúce nastavenie je späť."

#, python-format
msgid "The results have been written to %s."
msgstr "Výsledky boli zapísané do %s."

msgid "The skin has errors, the receiver keeps working:\n"
msgstr "Vzhľad má chyby, prijímač naďalej funguje:\n"

msgid "The sleep timer has been activated."
msgstr "Časovač vypnutia bol aktivovaný."

msgid "The sleep timer has been disabled."
msgstr "Časovač vypnutia bol deaktivovaný."

msgid "The timer file (timers.xml) is corrupt and could not be loaded."
msgstr "Súbor časovačov (timers.xml) je poškodený a nepodarilo sa ho načítať."

msgid "The transponders had a signal, but did not send any channels."
msgstr "Transpondéry mali signál, ale neposlali žiadne kanály."

msgid ""
"The transponders had a signal, but no free channels (the scan was for free "
"channels only)."
msgstr ""
"Transpondéry mali signál, ale žiadne voľné kanály (vyhľadávanie bolo len pre "
"voľné kanály)."

msgid ""
"The tuner could not be used. It may be busy with a recording or not "
"configured."
msgstr ""
