msgid "Metoda"
msgstr "Metóda"

#, python-brace-format
msgid ""
"Metoda GET trimite totul în adresă, deci {text} trebuie să fie în adresă. "
"Metoda POST trimite și un corp, cu aceleași locuri: JSON (pune locurile "
"între ghilimele, de exemplu \"q\": \"{text}\") sau formular (de exemplu "
"q={text}&target={tinta})."
msgstr ""
"Metóda GET posiela všetko v adrese, takže {text} musí byť v adrese. Metóda "
"POST posiela aj telo, s rovnakými značkami: JSON (značky daj do úvodzoviek, "
"napríklad \"q\": \"{text}\") alebo formulár (napríklad q={text}"
"&target={tinta})."

msgid "Micșorează pagina"
msgstr "Zmenšiť stránku"

msgid ""
"Micșorează întâi volumul televizorului. Automat: AC3 și DTS pleacă "
"neschimbate (5.1) numai spre un televizor care le primește. Manual: după "
"rândurile de mai jos."
msgstr ""
"Najprv stíš televízor. Automaticky: AC3 a DTS odchádzajú nezmenené (5.1) iba "
"do televízora, ktorý ich prijíma. Manuálne: podľa riadkov nižšie."

msgid ""
"Micșorează întâi volumul televizorului: când sunetul pleacă neschimbat, "
"volumul receptorului nu mai lucrează, iar sunetul poate fi mai tare."
msgstr ""
"Najprv zníž hlasitosť televízora: keď zvuk odchádza nezmenený, hlasitosť "
"prijímača už nefunguje a zvuk môže byť hlasnejší."

