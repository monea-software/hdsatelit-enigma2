"Stânga și dreapta schimbă valoarea, OK deschide lista. Fraza de jos arată "
"subtitrările text așa cum vor fi."
msgstr ""
"Vľavo a vpravo menia hodnotu, OK otvorí zoznam. Veta dole ukazuje textové "
"titulky tak, ako budú vyzerať."

msgid "Stânga și dreapta: alegi. OK: da sau nu. EXIT: ieși."
msgstr "Doľava a doprava: vyberáš. OK: áno alebo nie. EXIT: odídeš."

msgid "Stânga și dreapta: alegi. OK: pornești sau oprești. EXIT: ieși."
msgstr "Doľava a doprava: vyberáš. OK: zapneš alebo vypneš. EXIT: odídeš."

msgid "Stânga și dreapta: alegi. Sus și jos: schimbi. OK: păstrezi și închizi."
msgstr "Doľava a doprava: vyberáš. Hore a dole: meníš. OK: ponecháš a zavrieš."

msgid ""
"Stânga și dreapta: alegi. Sus, jos sau OK: presetarea următoare. EXIT: ieși."
msgstr ""
"Doľava a doprava: vyberáš. Hore, dole alebo OK: ďalšia predvoľba. EXIT: "
"odídeš."

msgid ""
"Stânga/Dreapta alegi sau treci în cealaltă coloană · OK pornești sau oprești"
msgstr ""
"Vľavo/Vpravo vyberáš alebo prejdeš do druhého stĺpca · OK zapína alebo vypína"

msgid "Stânga/Dreapta alegi · OK pornești sau oprești · Jos mai departe"
msgstr "Vľavo/Vpravo vyberáš · OK zapína alebo vypína · Dole ďalej"

msgid "Stânga/Dreapta: alt fișier · Sus/Jos: derulare · OK sau EXIT: înapoi"
msgstr "Vľavo/Vpravo: iný súbor · Hore/Dole: posúvanie · OK alebo EXIT: späť"

msgid ""
"Stânga/Dreapta: alt fișier · Sus/Jos: derulare · OK: pe scurt · EXIT: înapoi"
msgstr ""
"Vľavo/Vpravo: iný súbor · Hore/Dole: posúvanie · OK: v skratke · EXIT: späť"

msgid ""
"Stânga/Dreapta: un pas   Sus/Jos: mărimea pasului   4/6: mișcare fără "
"oprire   OK: oprire   EXIT: ieșire"
msgstr ""
"Vľavo/Vpravo: jeden krok   Hore/Dole: veľkosť kroku   4/6: plynulý pohyb   "
"OK: zastaviť   EXIT: odísť"

msgid ""
