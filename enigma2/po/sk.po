msgid ""
"Receptorul nu răspunde. Verifică dacă telefonul e în aceeași rețea cu "
"receptorul."
msgstr ""
"Prijímač neodpovedá. Skontroluj, či je telefón v rovnakej sieti ako prijímač."

msgid "Receptorul nu răspunde. Verifică să fie pornit și în aceeași rețea."
msgstr "Prijímač neodpovedá. Skontroluj, či je zapnutý a v rovnakej sieti."

msgid "Receptorul nu s-a putut lega la rețeaua Wi-Fi din copie."
msgstr "Prijímač sa nemohol pripojiť k sieti Wi-Fi zo zálohy."

msgid "Receptorul nu spune ce canal e pe televizor."
msgstr "Prijímač nepovie, aký kanál je na televízore."

msgid "Receptorul pornește din memoria internă."
msgstr "Prijímač sa spúšťa z vnútornej pamäte."

msgid "Receptorul pornește din nou programul."
msgstr "Prijímač znova spúšťa program."

msgid "Receptorul pornește din nou programul. Încearcă peste câteva secunde."
msgstr "Prijímač znova spúšťa kanál. Skús to o niekoľko sekúnd."

msgid ""
"Receptorul pornește imaginea din memoria lui internă în locul celei de acum. "
"Pe televizor: __DRUM_FLASH__."
msgstr ""
"Prijímač spustí image z vnútornej pamäte namiesto aktuálneho. Na televízore: "
"__DRUM_FLASH__."

msgid ""
"Receptorul pornește pe rând fiecare canal din listă și notează ce se află "
"numai când canalul chiar rulează: rezoluția, cadrele pe secundă, codarea "
"imaginii, accesul (liber sau criptat), PID-urile și pistele de sunet și "
"subtitrare. Cât merge, televizorul e ocupat: imaginea se schimbă singură. "
"Orice tastă de pe telecomandă oprește scanarea detaliată, iar receptorul "
"revine la canalul de dinainte. Data viitoare scanarea detaliată continuă de "
"unde a rămas."
msgstr ""
"Prijímač postupne spustí každý kanál zo zoznamu a zapíše, čo sa dá zistiť "
"len keď kanál naozaj beží: rozlíšenie, snímky za sekundu, kódovanie obrazu, "
"prístup (voľný alebo kódovaný), PID a zvukové a titulkové stopy. Kým to "
"beží, televízor je obsadený: obraz sa mení sám. Ktorýkoľvek kláves na "
"diaľkovom ovládaní zastaví podrobné vyhľadávanie a prijímač sa vráti na "
"predchádzajúci kanál. Nabudúce podrobné vyhľadávanie pokračuje tam, kde "
"skončilo."

msgid "Receptorul pornește și trece pe canal."
msgstr "Prijímač sa zapne a prepne na kanál."

msgid "Receptorul pornește."
msgstr "Prijímač sa spúšťa."

msgid "Receptorul potrivește singur contrastul după fiecare scenă."
msgstr "Prijímač sám prispôsobí kontrast každej scéne."

msgid "Receptorul pregătește deja o poză. Încearcă din nou peste câteva clipe."
msgstr "Prijímač už pripravuje obrázok. Skús to znova o chvíľu."

msgid ""
"Receptorul primește semnalul unei telecomenzi cu infraroșu, dar nu îl poate "
"folosi încă."
msgstr ""
"Prijímač prijíma signál infračerveného diaľkového ovládania, ale zatiaľ ho "
"nevie použiť."

msgid "Receptorul pune deja un ecran. Încearcă din nou peste câteva clipe."
msgstr "Prijímač už nastavuje obrazovku. Skús to znova o chvíľu."

msgid "Receptorul repornește o dată acum, ca să intre rețeaua din copie."
msgstr "Prijímač sa teraz raz reštartuje, aby sa použila sieť z kópie."

msgid "Receptorul repornește. Pagina merge din nou după pornire."
msgstr "Prijímač sa reštartuje. Stránka bude fungovať znova po štarte."

msgid "Receptorul repornește. Pagina se poate reîncărca după două minute."
msgstr ""
"Prijímač sa reštartuje. Stránka sa môže znova načítať po dvoch minútach."

msgid ""
"Receptorul s-a oprit neașteptat de două ori cu procesorul accelerat. Am "
"trecut înapoi pe modul Normal."
msgstr ""
"Prijímač sa neočakávane zastavil dvakrát so zrýchleným procesorom. Vrátili "
"sme sa späť na režim Normálny."

msgid "Receptorul s-a răcit. Procesorul lucrează din nou la viteza obișnuită."
msgstr "Prijímač vychladol. Procesor opäť pracuje obvyklou rýchlosťou."

#, python-format
msgid ""
"Receptorul s-a încălzit (%d °C). Procesorul lucrează mai încet până se "
"răcește."
msgstr ""
"Prijímač sa zahrial (%d °C). Procesor pracuje pomalšie, kým nevychladne."

msgid "Receptorul s-a încălzit și își încetinește singur procesorul."
msgstr "Prijímač sa zahrial a sám spomaľuje procesor."

msgid "Receptorul s-a încălzit. Procesorul lucrează mai încet până se răcește."
msgstr "Prijímač sa zahrial. Procesor pracuje pomalšie, kým nevychladne."

#, python-format
msgid "Receptorul s-a întors pe %s: internetul merge din nou acolo."
msgstr "Prijímač sa vrátil na %s: internet tam opäť funguje."

msgid ""
"Receptorul sau televizorul nu e gata. „Ca la televizor” se aplică singur "
"când e gata."
msgstr ""
"Prijímač alebo televízor nie je pripravený. „Ako televízor“ sa použije sám, "
"keď bude."

msgid "Receptorul scrie încă bucata de dinainte. Încearcă din nou."
msgstr "Prijímač ešte zapisuje predchádzajúcu časť. Skús to znova."

#, python-format
msgid "Receptorul se apără singur de căldură: încetinește la %d °C."
msgstr "Prijímač sa sám chráni pred teplom: spomalí pri %d °C."

msgid ""
"Receptorul se oprește de tot și se pornește din nou din butonul de pornire "
"al telecomenzii. Pe televizor: __DRUM_OPRIRE__."
msgstr ""
"Prijímač sa úplne vypne a znova sa zapne tlačidlom napájania na diaľkovom "
"ovládaní. Na televízore: __DRUM_OPRIRE__."

msgid "Receptorul se oprește."
msgstr "Prijímač sa vypína."

msgid "Receptorul se pornește din nou din butonul de pornire al telecomenzii."
msgstr "Prijímač sa znova zapne tlačidlom napájania na diaľkovom ovládaní."

msgid ""
"Receptorul se repornește. Pagina se reîncarcă singură când răspunde din nou."
msgstr ""
"Prijímač sa reštartuje. Stránka sa sama znova načíta, keď znova odpovie."

#, python-format
msgid ""
"Receptorul se răcește (%d °C). Procesorul revine la viteza obișnuită după %s."
msgstr ""
"Prijímač sa ochladzuje (%d °C). Procesor sa vráti k obvyklej rýchlosti po %s."

#, python-format
msgid "Receptorul se răcește. Procesorul revine la viteza obișnuită după %s."
msgstr "Prijímač sa ochladzuje. Procesor sa vráti k obvyklej rýchlosti po %s."

#, python-format
msgid ""
"Receptorul transmite deja spre %s. Oprește acea transmisie din pagina TV în "
"browser sau de pe televizor."
msgstr ""
"Prijímač už vysiela do %s. Zastav tento prenos na stránke TV v prehliadači "
"alebo na televízore."

msgid ""
"Receptorul trebuie repornit din meniu pentru ca imaginea sa ramana stabila."
msgstr "Prijímač treba reštartovať z menu, aby image zostal stabilný."

msgid "Receptorul trebuie repornit din meniu."
msgstr "Prijímač treba reštartovať z menu."

msgid "Receptorul trece în standby."
msgstr "Prijímač prechádza do pohotovosti."

#, python-format
msgid ""
"Receptorul trimite deja cât poate deodată: %d înregistrări aceluiași aparat, "
"%d în total. Încearcă din nou după ce se oprește una."
msgstr ""
"Prijímač už posiela toľko, koľko môže naraz: %d nahrávok do toho istého "
"zariadenia, %d celkovo. Skús to znova, keď sa jedna zastaví."

msgid ""
"Receptorul trimite și o amprentă calculată din placa lui, ca să fie numărat "
"o singură dată chiar dacă e instalat în mai multe sloturi sau reinstalat. "
"Din amprentă nu se pot afla adresa MAC sau seria, iar acestea nu pleacă de "
"pe receptor."
msgstr ""
"Prijímač posiela aj odtlačok vypočítaný z jeho dosky, aby bol započítaný iba "
"raz, aj keď je nainštalovaný vo viacerých slotoch alebo preinštalovaný. Z "
"odtlačku sa nedá zistiť adresa MAC ani sériové číslo a tieto údaje "
"neopúšťajú prijímač."

#, python-format
msgid "Receptorul tău: %(model)s, placa %(hw)s, procesor %(cip)s."
msgstr "Tvoj prijímač: %(model)s, doska %(hw)s, procesor %(cip)s."

msgid ""
"Receptorul verifică singur, în fundal, dacă are internet: trimite o "
"întrebare DNS mică spre serverele publice 1.1.1.1, 9.9.9.9 și 8.8.8.8, fără "
"date despre tine. La orice schimbare a rețelei (cablul, Wi-Fi, adresa) "
"verifică pe loc. Aceeași setare pe televizor: Meniu &gt; Setări &gt; Rețea "
"și Internet &gt; Verificarea internetului."
msgstr ""
"Prijímač sám na pozadí overuje, či má internet: posiela malý DNS dotaz na "
"verejné servery 1.1.1.1, 9.9.9.9 a 8.8.8.8, bez údajov o tebe. Pri každej "
"zmene siete (kábel, Wi-Fi, adresa) overí ihneď. Rovnaké nastavenie na "
"televízore: Ponuka &gt; Nastavenia &gt; Sieť a internet &gt; Overenie "
"internetu."

msgid ""
"Receptorul verifică singur, în fundal, dacă are internet: trimite o "
"întrebare DNS mică spre serverele publice 1.1.1.1, 9.9.9.9 și 8.8.8.8, fără "
"date despre tine. La orice schimbare a rețelei (cablul, Wi-Fi, adresa) "
"verifică pe loc. Pictograma din bară arată rezultatul."
msgstr ""
"Prijímač sám na pozadí kontroluje, či má internet: posiela malú DNS "
"požiadavku na verejné servery 1.1.1.1, 9.9.9.9 a 8.8.8.8, bez údajov o tebe. "
"Pri každej zmene siete (kábel, Wi-Fi, adresa) skontroluje hneď. Ikona v "
"lište ukazuje výsledok."

msgid ""
"Receptorul încă lucrează. Reîncarcă pagina peste puțin timp ca să vezi "
"rezultatul."
msgstr ""
"Prijímač stále pracuje. Načítaj stránku znova o chvíľu, aby si videl "
"výsledok."

msgid ""
"Receptorul întreabă scurt aparatele din rețeaua ta: servere media, "
"calculatoare cu Windows, NAS-uri. Nimic nu pleacă în afara rețelei.\n"
"Un calculator care nu apare se adaugă de mână, cu adresa lui."
msgstr ""
"Prijímač sa krátko opýta zariadení v tvojej sieti: mediálne servery, "
"počítače s Windows, NAS. Nič neodchádza mimo siete.\n"
"Počítač, ktorý sa nezobrazí, pridáš ručne, s jeho adresou."

msgid ""
"Receptorul întreabă scurt aparatele din rețeaua ta: serverele media (DLNA), "
"calculatoarele cu Windows și NAS-urile cu dosare partajate, serverele care "
"se anunță (NFS, WebDAV, FTP). Nimic nu pleacă în afara rețelei tale și nimic "
"nu se caută singur."
msgstr ""
"Prijímač sa krátko opýta zariadení v tvojej sieti: mediálne servery (DLNA), "
"počítače s Windows a NAS so zdieľanými priečinkami, servery, ktoré sa "
"ohlasujú (NFS, WebDAV, FTP). Nič neodchádza mimo tvojej siete a nič sa "
"nehľadá samo."

msgid ""
"Receptorul întreabă serverul HD Satelit ce oraș arată adresa lui de "
"internet. Locul se schimbă numai după ce îl confirmi."
msgstr ""
"Prijímač sa pýta servera HD Satelit, aké mesto ukazuje jeho internetová "
"adresa. Miesto sa zmení až po tom, čo ho potvrdíš."

