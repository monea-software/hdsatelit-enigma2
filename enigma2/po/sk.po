msgid ""
"<code>GET /api/acces-canal</code>: accesul canalului care rulează (criptat "
"sau liber), sistemele, CAID-urile și ce decriptează modulul acum"
msgstr ""
"<code>GET /api/acces-canal</code>: prístup k bežiacemu kanálu (zakódovaný "
"alebo voľný), systémy, CAID a čo modul teraz dekóduje"

msgid ""
"<code>GET /api/acces-conditionat</code>: modulele de acces condiționat pe "
"feluri (câmpul <code>fel</code>: numele felului, așa cum îl are receptorul; "
"întâi modulele obișnuite, apoi serverele de carduri), cel ales la pornirea "
"receptorului, cele care rulează, procesul care lucrează și memoria lui, "
"comanda în curs sau ultimul rezultat, dacă receptorul decriptează acum"
msgstr ""
"<code>GET /api/acces-conditionat</code>: moduly podmieneného prístupu podľa "
"druhov (pole <code>fel</code>: názov druhu, ako ho má prijímač; najprv bežné "
"moduly, potom kartové servery), modul zvolený pri spustení prijímača, "
"bežiace moduly, pracujúci proces a jeho pamäť, prebiehajúci príkaz alebo "
"posledný výsledok, či prijímač teraz dekóduje"

msgid ""
"<code>GET /api/acces-ssh</code>: intrarea pe receptor prin SSH: felul "
"parolei de administrator (fără parola însăși), cheile SSH (tipul, amprenta, "
"comentariul), „Fără parolă în rețeaua locală”, stările periculoase "
"(<code>alarme</code>), lucrarea în curs și rezultatul ultimei comenzi"
msgstr ""
"<code>GET /api/acces-ssh</code>: prístup do prijímača cez SSH: druh hesla "
"správcu (bez samotného hesla), kľúče SSH (typ, odtlačok, komentár), „Bez "
"hesla v miestnej sieti“, nebezpečné stavy (<code>alarme</code>), "
"prebiehajúca úloha a výsledok posledného príkazu"

msgid ""
"<code>GET /api/acces-ssh</code>: parola receptorului (FTP, SSH și SFTP): "
"felul parolei lui root (fără parola însăși), dacă merge FTP (<code>ftp</"
"code>), cheile SSH (tipul, amprenta, comentariul), opțiunea Fără parolă în "
"rețeaua locală, stările periculoase (<code>alarme</code>), lucrarea în curs "
"și rezultatul ultimei comenzi"
msgstr ""
"<code>GET /api/acces-ssh</code>: heslo prijímača (FTP, SSH a SFTP): druh "
"hesla používateľa root (bez samotného hesla), či funguje FTP (<code>ftp</"
"code>), kľúče SSH (typ, odtlačok, komentár), možnosť „Bez hesla v miestnej "
"sieti“, nebezpečné stavy (<code>alarme</code>), prebiehajúca úloha a "
"výsledok posledného príkazu"

msgid ""
"<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, "
"<code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, "
"<code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/"
"actualizari-reporneste</code>: actualizările prin pachete de pe stb."
"hdsatelit.com (starea, căutarea, instalarea, verificarea zilnică, repornirea "
"interfeței după instalare)"
msgstr ""
"<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, "
"<code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, "
"<code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/"
"actualizari-reporneste</code>: aktualizácie cez balíčky z stb.hdsatelit.com "
"(stav, vyhľadávanie, inštalácia, denná kontrola, reštart rozhrania po "
"inštalácii)"

msgid ""
"<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;"
"orase=1]</code>: afișajul din față: ce arată acum (măștile celor 4 cifre și "
"textul), lista de rotire, mesajele scurte, așteptarea, setările, minutarul "
"și cronometrul; cu <code>grupa</code> alegerile grupei cu desenul valorii de "
"acum, cu <code>catalog=1</code> toate alegerile (căutarea), cu "
"<code>orase=1</code> fusurile pentru ora din alt oraș"
msgstr ""
"<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;"
"orase=1]</code>: predný displej: čo teraz ukazuje (masky 4 číslic a text), "
"zoznam striedania, krátke správy, čakanie, nastavenia, časovač a stopky; s "
"<code>grupa</code> voľby skupiny s vykreslením aktuálnej hodnoty, s "
"<code>catalog=1</code> všetky voľby (vyhľadávanie), s <code>orase=1</code> "
"časové pásma pre čas v inom meste"

msgid ""
"<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: "
"tunerele, LNB-ul, semnalul canalului curent și unghiurile antenei spre "
"fiecare satelit (numai citire)"
msgstr ""
"<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: "
"tunery, LNB, signál aktuálneho kanála a uhly antény ku každému satelitu (iba "
"na čítanie)"

msgid ""
"<code>GET /api/calitate-imagine</code>: calitatea imaginii: „Reglajele după "
"canal”, profilul canalului de acum, cele 9 profiluri (SD, HD, 4K x SDR, "
"HDR10, HLG) cu reglajele lor, ieșirea HDR (alegerile primite de televizor, "
"ce e scris acum, întrebarea în curs) și textul brut al blocului de calitate"
msgstr ""
"<code>GET /api/calitate-imagine</code>: kvalita obrazu: „Nastavenia podľa "
"kanála“, profil aktuálneho kanála, 9 profilov (SD, HD, 4K x SDR, HDR10, HLG) "
"s ich nastaveniami, výstup HDR (voľby prijaté televízorom, čo je teraz "
"zapísané, prebiehajúca otázka) a surový text bloku kvality"

msgid "<code>GET /api/canale-acum</code>: canalul de pe televizor"
msgstr "<code>GET /api/canale-acum</code>: kanál na televízore"

msgid ""
"<code>GET /api/canale-buchete?fila=tv|radio</code>: listele de ales și lista "
"pe care stă televizorul"
msgstr ""
"<code>GET /api/canale-buchete?fila=tv|radio</code>: zoznamy na výber a "
"zoznam, na ktorom je televízor"

msgid ""
"<code>GET /api/canale-epg?refs=r1,r2</code>: emisiunea de acum și cea "
"următoare, cel mult 50 de canale"
msgstr ""
"<code>GET /api/canale-epg?refs=r1,r2</code>: aktuálna a nasledujúca relácia, "
"najviac 50 kanálov"

msgid ""
"<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,"
"v2&amp;de_la=&amp;cate=</code>: rândurile, pe pagini de cel mult 200, cu "
"grupele de filtre și numerele lor"
msgstr ""
"<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,"
"v2&amp;de_la=&amp;cate=</code>: riadky, po stránkach najviac 200, so "
"skupinami filtrov a ich počtami"

msgid ""
"<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: sigla canalului; la "
"listele de canale, 503 când receptorul are prea multe cereri în lucru și 504 "
"când nu termină în 10 s"
msgstr ""
"<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: logo kanála; pri "
"zoznamoch kanálov, 503, keď má prijímač príliš veľa rozpracovaných "
"požiadaviek, a 504, keď nedokončí do 10 s"

msgid ""
"<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Caută setări”: meniurile "
"și setările care au textul în nume (fără diacritice), cu drumul din meniu, "
"valoarea de acum și pagina web"
msgstr ""
"<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Hľadať nastavenia“: "
"ponuky a nastavenia, ktoré majú text v názve (bez diakritiky), s cestou v "
"ponuke, aktuálnou hodnotou a webovou stránkou"

msgid ""
"<code>GET /api/cautare-actualizeaza-stare</code>: cât a citit "
"(transponderul, canalele) sau rezultatul"
msgstr ""
"<code>GET /api/cautare-actualizeaza-stare</code>: koľko načítal "
"(transpondér, kanály) alebo výsledok"

msgid ""
"<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;"
"acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,"
"hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code>: căutarea de "
"canale, cu aceleași rânduri de filtre ca pe televizor și pistele știute ale "
"fiecărui canal"
msgstr ""
"<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;"
"acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,"
"hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code>: vyhľadávanie "
"kanálov s rovnakými riadkami filtrov ako na televízore a známymi stopami "
"každého kanála"

msgid ""
"<code>GET /api/ceas</code>: ora receptorului, fusul orar, sursa orei "
"(<code>auto</code>: Internet, apoi transponder; <code>ntp</code>; <code>dvb</"
"code>), serverul NTP, alegerile lor și ultima sincronizare"
msgstr ""
"<code>GET /api/ceas</code>: čas prijímača, časové pásmo, zdroj času "
"(<code>auto</code>: Internet, potom transpondér; <code>ntp</code>; "
"<code>dvb</code>), server NTP, ich voľby a posledná synchronizácia"

msgid ""
"<code>GET /api/copie-setari[?cauta=1]</code>: copia setărilor: stickurile și "
"discurile (<code>implicit</code> = stickul de actualizare), copiile găsite "
"(data, versiunea imaginii, acest receptor sau altul), copia automată, "
"ultimul rezultat; niciodată conținutul copiei"
msgstr ""
"<code>GET /api/copie-setari[?cauta=1]</code>: kópia nastavení: USB kľúče a "
"disky (<code>implicit</code> = aktualizačný kľúč), nájdené kópie (dátum, "
"verzia image, tento prijímač alebo iný), automatická kópia, posledný "
"výsledok; nikdy obsah kópie"

msgid ""
"<code>GET /api/dabt2?fel=dab|t2</code>: fereastra „Fluxuri și setări” a "
"DAB+ / DVB-T2 din satelit: fluxurile cu poziția, numele, numărul de posturi "
"și starea, setările, Despre, lucrul în curs și <code>repunere</code> "
"(canalul de dinainte, pornit din nou după „Învață posturile”: starea și "
"mesajul)"
msgstr ""
"<code>GET /api/dabt2?fel=dab|t2</code>: okno „Toky a nastavenia“ pre DAB+ / "
"DVB-T2 zo satelitu: toky s pozíciou, názvom, počtom staníc a stavom, "
"nastavenia, O aplikácii, prebiehajúca úloha a <code>repunere</code> "
"(predchádzajúci kanál, znovu spustený po „Naučiť stanice“: stav a správa)"

msgid ""
"<code>GET /api/descarcare-subtitrari</code> și <code>POST /api/descarcare-"
"subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, "
"<code>-verifica</code>, <code>-conturi</code>: descărcarea subtitrărilor "
"(numele, parolele și cheile numai în corpul cererii); pe un canal TV sau la "
"o înregistrare și <code>-film</code> (<code>fapta=identifica|alege|titlu|"
"local</code>: filmul din ghid, identificat în Wikidata) și <code>-potrivire</"
"code> (<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|"
"opreste</code>: potrivirea subtitrării pe canal)"
msgstr ""
"<code>GET /api/descarcare-subtitrari</code> a <code>POST /api/descarcare-"
"subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, "
"<code>-verifica</code>, <code>-conturi</code>: sťahovanie titulkov (mená, "
"heslá a kľúče iba v tele požiadavky); na TV kanáli alebo pri nahrávke a "
"<code>-film</code> (<code>fapta=identifica|alege|titlu|local</code>: film z "
"programu, identifikovaný vo Wikidata) a <code>-potrivire</code> "
"(<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|opreste</"
"code>: prispôsobenie titulkov na kanáli)"

msgid ""
"<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: "
"mesajul de pe ecranul negru (de ce nu se vede imaginea) și analiza fluxului "
"canalului"
msgstr ""
"<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: "
"správa na čiernej obrazovke (prečo nie je vidieť obraz) a analýza toku kanála"

msgid ""
"<code>GET /api/egalizator</code>: egalizatorul posturilor de radio: pornit "
"sau oprit, benzile, presetarea, modul de noapte, reglajele postului de acum "
"și dacă merge la acest post; <code>POST /api/egalizator-seteaza</code>: "
"schimbă și aplică pe loc"
msgstr ""
"<code>GET /api/egalizator</code>: ekvalizér rozhlasových staníc: zapnutý "
"alebo vypnutý, pásma, predvoľba, nočný režim, nastavenia aktuálnej stanice a "
"či funguje na tejto stanici; <code>POST /api/egalizator-seteaza</code>: "
"zmení a okamžite použije"

msgid ""
"<code>GET /api/filme</code>: filmul care merge (poziția, lungimea, starea, "
"locul ținut minte, mesajul de refuz) și setările filmelor; <code>GET /api/"
"filme-lista</code>: filmele din dosarul listei de filme, cu locul rămas"
msgstr ""
"<code>GET /api/filme</code>: prehrávaný film (pozícia, dĺžka, stav, "
"zapamätané miesto, správa o odmietnutí) a nastavenia filmov; <code>GET /api/"
"filme-lista</code>: filmy zo zložky zoznamu filmov, s miestom, kde sa "
"skončilo"

msgid ""
"<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: familiile libere de pe "
"Google Fonts și fonturile deja descărcate"
msgstr ""
"<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: voľné rodiny z Google "
"Fonts a už stiahnuté fonty"

msgid ""
"<code>GET /api/gasire-semnal-stare</code>: nivelul, calitatea, BER-ul și "
"verdictul măsurării"
msgstr ""
"<code>GET /api/gasire-semnal-stare</code>: úroveň, kvalita, BER a verdikt "
"merania"

msgid ""
"<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: "
"transponderele unui satelit"
msgstr ""
"<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: satelitné "
"transpondéry"

msgid ""
"<code>GET /api/gasire-semnal</code>: tunerele, sateliții, transponderul de "
"la care pornește măsurarea și starea ei"
msgstr ""
"<code>GET /api/gasire-semnal</code>: tunery, satelity, transpondér, od "
"ktorého meranie začína, a stav merania"

msgid ""
"<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-"
"emisiune?ref=&amp;id=</code>: ghidul unui canal (fără <code>ref</code>, "
"canalul de pe televizor) și o emisiune cu descrierile"
msgstr ""
"<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-"
"emisiune?ref=&amp;id=</code>: program kanála (bez <code>ref</code> kanál na "
"televízore) a relácia s popismi"

msgid ""
"<code>GET /api/import-surse?cauta=1</code>: copiile de canale și setări "
"găsite pe stick-uri și pe receptor, starea căutării și a importului"
msgstr ""
"<code>GET /api/import-surse?cauta=1</code>: kópie kanálov a nastavení "
"nájdené na USB kľúčoch a v prijímači, stav vyhľadávania a importu"

msgid ""
"<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|"
"retea|hdmi</code>: ecranele „System Information”, cu aceleași texte ca pe "
"televizor"
msgstr ""
"<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|"
"retea|hdmi</code>: obrazovky „System Information“ s rovnakými textami ako na "
"televízore"

msgid ""
"<code>GET /api/interfete-cam?reincarca=1</code>: modulele de acces "
"condiționat instalate și interfețele lor web, cu numele date de fiecare "
"modul (fără <code>reincarca</code> poate veni o căutare făcută cu câteva "
"secunde înainte)"
msgstr ""
"<code>GET /api/interfete-cam?reincarca=1</code>: nainštalované moduly "
"podmieneného prístupu a ich webové rozhrania, s názvami danými každým "
"modulom (bez <code>reincarca</code> môže prísť vyhľadávanie vykonané pred "
"niekoľkými sekundami)"

msgid ""
"<code>GET /api/jurnal</code>: jurnalul de versiuni (ce s-a schimbat la "
"fiecare actualizare)"
msgstr ""
"<code>GET /api/jurnal</code>: denník verzií (čo sa zmenilo v každej "
"aktualizácii)"

msgid ""
"<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: "
"programele din imagine cu licența fiecăruia și textul unei licențe"
msgstr ""
"<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: "
"programy v image s licenciou každého z nich a text licencie"

msgid ""
"<code>GET /api/limba-interfata</code>: limba meniurilor de acum și lista "
"limbilor, cu numele de pe televizor"
msgstr ""
"<code>GET /api/limba-interfata</code>: aktuálny jazyk ponúk a zoznam jazykov "
"s názvami z televízora"

msgid ""
"<code>GET /api/limbi</code>: limba sunetului și a subtitrărilor: cele 7 "
"setări cu alegerile lor, ce se ține minte pe canalul de acum și canalele cu "
"alegeri de mână"
msgstr ""
"<code>GET /api/limbi</code>: jazyk zvuku a titulkov: 7 nastavení s ich "
"voľbami, čo sa pamätá pre aktuálny kanál, a kanály s ručnými voľbami"

msgid ""
"<code>GET /api/liste-implicite</code>: listele de canale gata făcute și "
"drumurile spre scanare și import"
msgstr ""
"<code>GET /api/liste-implicite</code>: hotové zoznamy kanálov a cesty k "
"vyhľadávaniu a importu"

msgid ""
"<code>GET /api/lnb-stare</code>: verificarea semnalului, întrebarea și "
"secundele rămase"
msgstr ""
"<code>GET /api/lnb-stare</code>: kontrola signálu, otázka a zostávajúce "
"sekundy"

msgid ""
"<code>GET /api/lnb?slot=N</code>: LNB-urile tunerului, cu valorile, "
"alegerile și „Probă de calcul” (numai citire)"
msgstr ""
"<code>GET /api/lnb?slot=N</code>: LNB tunera s hodnotami, voľbami a "
"„Skúšobný výpočet“ (iba na čítanie)"

msgid ""
"<code>GET /api/locul[?tara=RO]</code>: locul antenei pentru motorul USALS, "
"țările și orașele unei țări (tabelul din imagine)"
msgstr ""
"<code>GET /api/locul[?tara=RO]</code>: umiestnenie antény pre motor USALS, "
"krajiny a mestá danej krajiny (tabuľka v image)"

msgid ""
"<code>GET /api/meniu</code>: tot meniul receptorului (tasta MENU), cu "
"aceleași intrări ca pe televizor pentru nivelul ales"
msgstr ""
"<code>GET /api/meniu</code>: celá ponuka prijímača (tlačidlo MENU) s "
"rovnakými položkami ako na televízore pre zvolenú úroveň"

msgid ""
"<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, "
"<code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: modul sigur (opririle "
"interfeței, alegerile de după ele) și fișierele lui ca text"
msgstr ""
"<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, "
"<code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: bezpečný režim "
"(zastavenia rozhrania, voľby po nich) a jeho súbory ako text"

msgid ""
"<code>GET /api/motor-comenzi</code>: tunerele cu motor, sateliții și starea "
"comenzilor"
msgstr ""
"<code>GET /api/motor-comenzi</code>: tunery s motorom, satelity a stav "
"príkazov"

msgid ""
"<code>GET /api/motor-comenzi?urma=N</code>: urma comenzilor trimise "
"motorului (ultimele N, implicit 100, cel mult 500, cele mai noi întâi): ora, "
"comanda, unghiul, cine a cerut-o (televizorul, ecranul sau pagina motorului, "
"Găsire semnal, reacordarea), poziția crezută de receptor; numai citire, din "
"<code>/home/root/logs/hds-motor.log</code>"
msgstr ""
"<code>GET /api/motor-comenzi?urma=N</code>: stopa príkazov odoslaných motoru "
"(posledných N, predvolene 100, najviac 500, najnovšie prvé): čas, príkaz, "
"uhol, kto ho vyžiadal (televízor, obrazovka alebo stránka motora, Hľadač "
"signálu, preladenie), pozícia predpokladaná prijímačom; iba na čítanie, z "
"<code>/home/root/logs/hds-motor.log</code>"

msgid ""
"<code>GET /api/motor</code>: starea rotirii antenei (de unde, pana unde, "
"poziția estimată, cât mai are de mers)"
msgstr ""
"<code>GET /api/motor</code>: stav otáčania antény (odkiaľ, kam, odhadovaná "
"pozícia, koľko ešte zostáva)"

msgid ""
"<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;"
"xp=&amp;yp=</code>: mouse-ul pe ecranul televizorului, ca în emulator: "
"<code>xp</code>, <code>yp</code> = locul în procente din ecran (sau <code>x</"
"code>, <code>y</code> în pixelii ecranului, 1920x1080); <code>clic</code> "
"alege rândul de sub mouse, iar pe rândul ales sau cu <code>clicuri=2</code> "
"dă OK; un buton colorat = tasta lui; <code>drag</code> (cu <code>x0p</code>, "
"<code>y0p</code> = locul apăsării, <code>nou=1</code> la prima mișcare) și "
"<code>dragend</code> = trasul pe bara de derulare; <code>rotita&amp;"
"pasi=-12..12</code> = sus/jos (3 pași sau mai mulți = o pagină); "
"<code>dreapta</code> = Meniu, <code>mijloc</code> = Ieșire. Răspunsul spune "
"ce s-a făcut (<code>facut</code>: selectie, ok, buton, bara, derulare, "
"tasta, nimic). Din browser, cu POST și antetul <code>X-HDS-CSRF</code>, ca "
"<code>remotecontrol</code>"
msgstr ""
"<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;"
"xp=&amp;yp=</code>: myš na obrazovke televízora, ako v emulátore: <code>xp</"
"code>, <code>yp</code> = miesto v percentách obrazovky (alebo <code>x</"
"code>, <code>y</code> v pixeloch obrazovky, 1920x1080); <code>clic</code> "
"vyberie riadok pod myšou a na vybranom riadku alebo s <code>clicuri=2</code> "
"dá OK; farebné tlačidlo = jeho kláves; <code>drag</code> (s <code>x0p</"
"code>, <code>y0p</code> = miesto stlačenia, <code>nou=1</code> pri prvom "
"pohybe) a <code>dragend</code> = ťahanie po posuvnej lište; <code>rotita&amp;"
"pasi=-12..12</code> = hore/dole (3 kroky alebo viac = jedna strana); "
"<code>dreapta</code> = Ponuka, <code>mijloc</code> = Ukončiť. Odpoveď "
"hovorí, čo sa vykonalo (<code>facut</code>: selectie, ok, buton, bara, "
"derulare, tasta, nimic). Z prehliadača, cez POST a hlavičku <code>X-HDS-"
"CSRF</code>, ako <code>remotecontrol</code>"

msgid ""
"<code>GET /api/navigator</code>: navigatorul web de pe televizor (deschis "
"sau nu, modul, desenul, felul câmpului ales, mărirea; fără adrese), setările "
"lui și favoritele"
msgstr ""
"<code>GET /api/navigator</code>: webový prehliadač na televízore (otvorený "
"alebo nie, režim, kresba, druh vybraného poľa, zväčšenie; bez adries), jeho "
"nastavenia a obľúbené položky"

msgid ""
"<code>GET /api/ocr-limbi</code>: limbile recunoașterii textului (în imagine, "
"descărcate, de descărcat, cu mărimea și starea fiecăreia) și locul pentru "
"modelele noi"
msgstr ""
"<code>GET /api/ocr-limbi</code>: jazyky rozpoznávania textu (v image, "
"stiahnuté, na stiahnutie, s veľkosťou a stavom každého) a miesto pre nové "
"modely"

msgid ""
"<code>GET /api/pasi-decriptare</code>: pașii decriptării canalului de pe "
"televizor (cererea către modulul de acces, răspunsurile și timpul lor, "
"imaginea decriptată, mesajele modulului CI), numai cu setarea Arată pașii "
"decriptării pornită"
msgstr ""
"<code>GET /api/pasi-decriptare</code>: kroky dešifrovania kanála na "
"televízore (požiadavka na modul prístupu, odpovede a ich čas, dešifrovaný "
"obraz, správy modulu CI), iba so zapnutým nastavením Zobraziť kroky "
"dešifrovania"

msgid ""
"<code>GET /api/paza-model</code>: paza de model (receptorul pentru care e "
"făcută imaginea și amprenta acestuia); <code>GET /api/actualizare-pachete</"
"code>: pachetele de actualizare găsite și verdictul pazei pentru fiecare"
msgstr ""
"<code>GET /api/paza-model</code>: ochrana modelu (prijímač, pre ktorý je "
"image vytvorený, a jeho odtlačok); <code>GET /api/actualizare-pachete</"
"code>: nájdené balíčky aktualizácií a verdikt ochrany pre každý z nich"

msgid ""
"<code>GET /api/paznic</code>: paznicul receptorului: starea, setările "
"(<code>interfata</code>, <code>asteptare</code> în secunde), alegerile și "
"ultimele rânduri din jurnalul lui"
msgstr ""
"<code>GET /api/paznic</code>: strážca prijímača: stav, nastavenia "
"(<code>interfata</code>, <code>asteptare</code> v sekundách), voľby a "
"posledné riadky jeho denníka"

msgid ""
"<code>GET /api/portal</code>: starea HbbTV a canalului care rulează (da, nu "
"are, încă nu se știe), cu mesajul arătat pe televizor la tasta PORTAL"
msgstr ""
"<code>GET /api/portal</code>: stav HbbTV bežiaceho kanála (áno, nemá, zatiaľ "
"sa nevie), so správou zobrazenou na televízore pri tlačidle PORTAL"

msgid ""
"<code>GET /api/procesor</code>: procesorul: modul de lucru, modurile care "
"există pe receptor, frecvența setată și cea de acum, temperatura, tensiunea, "
"procentul folosit și timpul pe fiecare treaptă"
msgstr ""
"<code>GET /api/procesor</code>: procesor: pracovný režim, režimy dostupné v "
"prijímači, nastavená a aktuálna frekvencia, teplota, napätie, percento "
"využitia a čas na každom stupni"

msgid ""
"<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: postul de "
"radio care merge, cu textele ecranului radio; barele și nivelul sunetului"
msgstr ""
"<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: hrajúca "
"rozhlasová stanica s textami obrazovky rádia; stĺpce a úroveň zvuku"

msgid ""
"<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: apasă o "
"tastă ca de pe telecomanda receptorului (coduri de tastă Linux, de exemplu "
"352 pentru OK); cu <code>lung=1</code>, apăsare lungă"
msgstr ""
"<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: stlačí "
"tlačidlo ako na diaľkovom ovládaní prijímača (kódy klávesov Linuxu, "
"napríklad 352 pre OK); s <code>lung=1</code> dlhé stlačenie"

msgid ""
"<code>GET /api/scanare-stare</code>: starea căutării (procent, canale "
"găsite, transpondere, timp rămas, rezultat)"
msgstr ""
"<code>GET /api/scanare-stare</code>: stav vyhľadávania (percento, nájdené "
"kanály, transpondéry, zostávajúci čas, výsledok)"

msgid ""
"<code>GET /api/scanare-ultima</code>: rezultatul ultimei scanări de canale, "
"ținut până la scanarea următoare: <code>inceput</code>, <code>sfarsit</"
"code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, "
"<code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, "
"<code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, "
"<code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, "
"iar când se știu <code>tsid</code>, <code>onid</code>, <code>nid</code> și, "
"la cablu, <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:"
"ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, "
"<code>caid</code>, iar când operatorul trimite numerele canalelor <code>lcn</"
"code> și <code>lcn_vizibil</code>): toate serviciile citite din SDT, vechi "
"și noi, și <code>retele</code> (<code>nid</code>, <code>nume</code>, "
"<code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, "
"<code>privati</code>): rețelele din tabela NIT; câmpurile din tabela NIT "
"(<code>nid</code>, <code>lcn</code>, <code>retele</code>) apar la căutarea "
"în rețea și la scanarea pe cablu pe o singură frecvență; numai citire, lista "
"de canale nu se schimbă; fără nicio scanare de la pornire, <code>result</"
"code> false"
msgstr ""
"<code>GET /api/scanare-ultima</code>: výsledok posledného vyhľadávania "
"kanálov, uchovávaný do ďalšieho vyhľadávania: <code>inceput</code>, "
"<code>sfarsit</code>, <code>stare</code> (in_curs, terminata, oprita), "
"<code>fel</code>, <code>pozitii</code>, <code>doar_libere</code>, "
"<code>eroare</code>, <code>transpondere</code> (<code>tp</code> ns:tsid:"
"onid, <code>poz</code>, <code>f_khz</code>, <code>pol</code>, <code>sr</"
"code>, <code>semnal</code>, a keď sú známe <code>tsid</code>, <code>onid</"
"code>, <code>nid</code> a pri kábli <code>mod</code>), <code>servicii</code> "
"(<code>cheie</code> sid:ns:tsid:onid, <code>tip</code>, <code>nume</code>, "
"<code>furnizor</code>, <code>caid</code>, a keď operátor posiela čísla "
"kanálov <code>lcn</code> a <code>lcn_vizibil</code>): všetky služby načítané "
"z SDT, staré aj nové, a <code>retele</code> (<code>nid</code>, <code>nume</"
"code>, <code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, "
"<code>privati</code>): siete z tabuľky NIT; polia z tabuľky NIT (<code>nid</"
"code>, <code>lcn</code>, <code>retele</code>) sa objavujú pri vyhľadávaní v "
"sieti a pri káblovom vyhľadávaní na jednej frekvencii; iba na čítanie, "
"zoznam kanálov sa nemení; bez akéhokoľvek vyhľadávania od spustenia, "
"<code>result</code> false"

msgid ""
"<code>GET /api/scanare</code>: secțiunile „Scanare” și „Orientarea și "
"setarea antenei”, cu felurile de scanare, în ordinea din meniul "
"receptorului; cu <code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</"
"code>, câmpurile felului și ce s-ar căuta"
msgstr ""
"<code>GET /api/scanare</code>: sekcie „Vyhľadávanie kanálov“ a „Nastavenie a "
"orientácia antény“, s druhmi vyhľadávania, v poradí z ponuky prijímača; s "
"<code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</code>, polia daného "
"druhu a čo by sa vyhľadávalo"

msgid ""
"<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;"
"mode=all|video|osd&amp;download=1</code>: imaginea de pe ecran; <code>mode</"
"code>: <code>all</code> cu afișajul OSD (implicit), <code>video</code> numai "
"imaginea canalului, <code>osd</code> numai afișajul OSD; <code>download=1</"
"code>: descărcare ca fișier, cu data și ora receptorului în nume"
msgstr ""
"<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;"
"mode=all|video|osd&amp;download=1</code>: obraz z obrazovky; <code>mode</"
"code>: <code>all</code> s OSD zobrazením (predvolene), <code>video</code> "
"iba obraz kanála, <code>osd</code> iba OSD zobrazenie; <code>download=1</"
"code>: stiahnutie ako súbor, s dátumom a časom prijímača v názve"

msgid ""
"<code>GET /api/setari-din-copie</code>: setările importate: câte așteaptă "
"repornirea interfeței (<code>asteapta</code>), proba lor (<code>garda</"
"code>), scoase după opriri neașteptate (<code>cazut</code>), textele stării"
msgstr ""
"<code>GET /api/setari-din-copie</code>: importované nastavenia: koľko čaká "
"na reštart rozhrania (<code>asteapta</code>), ich skúška (<code>garda</"
"code>), odstránené po neočakávaných zastaveniach (<code>cazut</code>), texty "
"stavu"

msgid ""
"<code>GET /api/setari</code>: ecranele de setări din meniu; cu <code>id=&lt;"
"cheie&gt;</code>, rândurile lor (aceleași ca pe televizor, cu alegerile)"
msgstr ""
"<code>GET /api/setari</code>: obrazovky nastavení z ponuky; s <code>id=&lt;"
"cheie&gt;</code>, ich riadky (rovnaké ako na televízore, s voľbami)"

msgid ""
"<code>GET /api/standby-tv</code>: ieșirea HDMI în standby (oprită sau "
"pornită, oprirea din nou după aprinderea televizorului) și starea CEC"
msgstr ""
"<code>GET /api/standby-tv</code>: výstup HDMI v pohotovostnom režime "
"(vypnutý alebo zapnutý, opätovné vypnutie po zapnutí televízora) a stav CEC"

msgid ""
"<code>GET /api/stare-retea</code>: legătura cu routerul și internetul (cablu "
"sau Wi-Fi, treptele semnalului Wi-Fi, internetul merge, routerul nu are "
"internet sau receptorul nu e conectat la router), cu desenul pictogramei și "
"textul ei, ca pictograma din bara de pe televizor"
msgstr ""
"<code>GET /api/stare-retea</code>: pripojenie k smerovaču a internetu (kábel "
"alebo Wi-Fi, úrovne signálu Wi-Fi, internet funguje, smerovač nemá internet "
"alebo prijímač nie je pripojený k smerovaču), s kresbou ikony a jej textom, "
"ako ikona na lište na televízore"

msgid "<code>GET /api/statusinfo</code>: canalul curent, volumul, standby"
msgstr ""
"<code>GET /api/statusinfo</code>: aktuálny kanál, hlasitosť, pohotovostný "
"režim"

msgid ""
"<code>GET /api/stocare</code>: locul înregistrărilor, spațiul liber și "
"discurile conectate"
msgstr ""
"<code>GET /api/stocare</code>: miesto nahrávok, voľné miesto a pripojené "
"disky"

msgid ""
"<code>GET /api/subtitrari-aspect</code>: aspectul subtitrărilor text "
"(fontul, grosimea, mărimea și culoarea literelor, conturul, umbra, fundalul, "
"înălțimea, distanța dintre rânduri) și mărirea subtitrărilor DVB, cu "
"alegerile posibile (<code>alegeri</code>), stilurile gata făcute și valorile "
"de la început"
msgstr ""
"<code>GET /api/subtitrari-aspect</code>: vzhľad textových titulkov (písmo, "
"hrúbka, veľkosť a farba písmen, obrys, tieň, pozadie, výška, vzdialenosť "
"medzi riadkami) a zväčšenie titulkov DVB, s možnými voľbami (<code>alegeri</"
"code>), hotovými štýlmi a počiatočnými hodnotami"

msgid ""
"<code>GET /api/subtitrari-film</code>: filmul care merge, subtitrările lui, "
"întârzierea, codarea și cadrele pe secundă"
msgstr ""
"<code>GET /api/subtitrari-film</code>: prehrávaný film, jeho titulky, "
"oneskorenie, kódovanie a snímky za sekundu"

msgid ""
"<code>GET /api/subtitrari-ocr</code>: contorul recunoașterii textului din "
"subtitrările DVB (pagini citite ca text, rămase imagine și de ce, timpul "
"mediu, ultimele pagini, viteza serviciului)"
msgstr ""
"<code>GET /api/subtitrari-ocr</code>: počítadlo rozpoznávania textu z "
"titulkov DVB (stránky prečítané ako text, ponechané ako obraz a prečo, "
"priemerný čas, posledné stránky, rýchlosť služby)"

msgid ""
"<code>GET /api/sunet</code>: ieșirea sunetului (Automat / Manual), AC3 și "
"DTS downmix, pista AC3, ce primește televizorul (EDID), ce se trimite acum "
"și de ce, ce arată driverul pe HDMI și optic"
msgstr ""
"<code>GET /api/sunet</code>: zvukový výstup (Automaticky / Ručne), AC3 a DTS "
"downmix, stopa AC3, čo prijíma televízor (EDID), čo sa teraz posiela a "
"prečo, čo zobrazuje ovládač na HDMI a optickom výstupe"

msgid ""
"<code>GET /api/telecomenzi-export?format=json|csv</code>: codurile "
"telecomenzii receptorului și ale celor asociate, pentru aplicații"
msgstr ""
"<code>GET /api/telecomenzi-export?format=json|csv</code>: kódy diaľkového "
"ovládania prijímača a priradených ovládačov, pre aplikácie"

msgid ""
"<code>GET /api/telecomenzi</code>: telecomenzile asociate, tastele lor și "
"captura paginii (cititorul, proba, asocierea)"
msgstr ""
"<code>GET /api/telecomenzi</code>: priradené diaľkové ovládania, ich "
"tlačidlá a zachytenie stránky (čítačka, skúška, priradenie)"

msgid ""
"<code>GET /api/teletext-copii</code> (cu <code>?canale=1</code> și canalele "
"care au teletext): copiile de teletext salvate (canalul, data, paginile, "
"mărimea), dosarul, spațiul folosit și cel ales, urmăritorul (caruselul "
"canalului de acum, reîmprospătarea în lucru) și setările"
msgstr ""
"<code>GET /api/teletext-copii</code> (s <code>?canale=1</code> a kanálmi, "
"ktoré majú teletext): uložené kópie teletextu (kanál, dátum, stránky, "
"veľkosť), priečinok, použité a zvolené miesto, sledovač (karusel aktuálneho "
"kanála, prebiehajúce obnovovanie) a nastavenia"

msgid ""
"<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> "
"(fără <code>ref</code>: canalul de acum): <code>date</code> = fișierul "
"copiei (.ttx, comprimat), <code>html</code> = o singură pagină HTML cu toate "
"paginile, care se citește fără receptor"
msgstr ""
"<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> "
"(bez <code>ref</code>: aktuálny kanál): <code>date</code> = súbor kópie (."
"ttx, komprimovaný), <code>html</code> = jedna HTML stránka so všetkými "
"stránkami, ktorá sa číta bez prijímača"

msgid ""
"<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;"
"ref&gt;</code>: o pagină de teletext, ca pe televizor la tasta TEXT: cele 25 "
"de rânduri a câte 40 de celule (litera, culoarea, fundalul, mozaicul, "
"atributele), textul paginii, subpaginile, paginile tastelor colorate, "
"paginile vecine și pagina de pe televizor; fără <code>pagina</code>, pagina "
"de pe televizor sau cea de pornire; <code>sub=-1</code> = cea mai nouă; "
"<code>ascuns=1</code> arată ce e ascuns; cu <code>copie</code>, paginile din "
"copia salvată a canalului, fără tuner (<code>sursa</code>: <code>direct</"
"code> sau <code>copie</code>); <code>hd</code> = setarea Teletext neted, "
"<code>optiuni</code> = conturul literelor, umbra literelor și formele în "
"relief (<code>contur</code>, <code>umbra</code>, <code>relief</code>, ca pe "
"televizor). Pagina lipsă: <code>gasita</code> fals și mesajul că se caută"
msgstr ""
"<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;"
"ref&gt;</code>: stránka teletextu, ako na televízore pri tlačidle TEXT: 25 "
"riadkov po 40 buniek (písmeno, farba, pozadie, mozaika, atribúty), text "
"stránky, podstránky, stránky farebných tlačidiel, susedné stránky a stránka "
"na televízore; bez <code>pagina</code> stránka na televízore alebo úvodná "
"stránka; <code>sub=-1</code> = najnovšia; <code>ascuns=1</code> zobrazí "
"skrytý obsah; s <code>copie</code> stránky z uloženej kópie kanála, bez "
"tunera (<code>sursa</code>: <code>direct</code> alebo <code>copie</code>); "
"<code>hd</code> = nastavenie Vyhladený teletext, <code>optiuni</code> = "
"obrys písmen, tieň písmen a reliéfne tvary (<code>contur</code>, "
"<code>umbra</code>, <code>relief</code>, ako na televízore). Chýbajúca "
"stránka: <code>gasita</code> nepravda a správa, že sa hľadá"

msgid ""
"<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/"
"temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: jurnalul unei "
"înregistrări, pe înțelesul oricui, cu mesajul tehnic; golirea lui"
msgstr ""
"<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/"
"temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: denník nahrávky, "
"zrozumiteľný pre každého, s technickou správou; jeho vyprázdnenie"

msgid ""
"<code>GET /api/temporizatoare</code>: înregistrările programate (aceeași "
"ordine, stare și detalii ca pe televizor), locul înregistrărilor și spațiul "
"liber"
msgstr ""
"<code>GET /api/temporizatoare</code>: naplánované nahrávky (rovnaké poradie, "
"stav a podrobnosti ako na televízore), miesto nahrávok a voľné miesto"

msgid ""
"<code>GET /api/traducere-configurare</code>: configurarea pas cu pas a "
"traducerii: ce e pus acum (<code>acum</code>: serviciul, dacă are cheie, "
"pornită sau nu, ultima probă, <code>chei_din_nou</code>), lucrarea "
"configurării (<code>configurare</code>: starea, pasul, proba, modelul și "
"modelele, mesajul și ce să faci), căutarea serverelor din casă "
"(<code>cautare</code>: progresul și serverele găsite), instrucțiunile și "
"pagina cheii fiecărui serviciu, regiunile Azure; niciodată o cheie"
msgstr ""
"<code>GET /api/traducere-configurare</code>: nastavenie prekladu krok za "
"krokom: čo je nastavené teraz (<code>acum</code>: služba, či má kľúč, "
"zapnutá alebo nie, posledná skúška, <code>chei_din_nou</code>), priebeh "
"nastavenia (<code>configurare</code>: stav, krok, skúška, model a modely, "
"správa a čo robiť), vyhľadávanie serverov v domácnosti (<code>cautare</"
"code>: priebeh a nájdené servery), pokyny a stránka kľúča každej služby, "
"regióny Azure; nikdy kľúč"

msgid ""
"<code>GET /api/traducere-subtitrari</code>: traducerea automată a "
"subtitrărilor text: valorile (<code>pornit</code>, <code>serviciu</code>, "
"<code>limba</code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</"
"code>, <code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</"
"code>, <code>adresa_libre</code>, <code>adresa_openai</code>, "
"<code>model_gemini</code>, <code>model_openai</code>, <code>model_groq</"
"code>, <code>model_cloudflare</code>, <code>cont_cloudflare</code> și, "
"pentru adresa proprie, <code>propriu_adresa</code>, <code>propriu_metoda</"
"code>, <code>propriu_corp</code>, <code>propriu_tip_corp</code>, "
"<code>propriu_antet</code>, <code>propriu_raspuns</code>, "
"<code>propriu_cale</code>), alegerile posibile (<code>alegeri</code>), ce "
"cere fiecare serviciu (<code>cere</code>), care serviciu are cheie "
"(<code>chei</code>, niciodată cheia), dacă cheile trebuie puse din nou "
"(<code>chei_din_nou</code>, textul notei, gol când nu e cazul), starea cheii "
"serviciului ales, ca pe televizor (<code>cheie_fel</code> și "
"<code>cheie_text</code>: pusă, pusă pentru alt server, lipsă), textele "
"paginii în limba receptorului (<code>texte</code>), ce lipsește, "
"confidențialitatea, instrucțiunile pas cu pas (cu <code>pagina_cheie</code>, "
"adresa oficială pentru codul QR) și starea (contorul, proba, pauza după "
"erori)"
msgstr ""
"<code>GET /api/traducere-subtitrari</code>: automatický preklad textových "
"titulkov: hodnoty (<code>pornit</code>, <code>serviciu</code>, <code>limba</"
"code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</code>, "
"<code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</code>, "
"<code>adresa_libre</code>, <code>adresa_openai</code>, <code>model_gemini</"
"code>, <code>model_openai</code>, <code>model_groq</code>, "
"<code>model_cloudflare</code>, <code>cont_cloudflare</code> a pre vlastnú "
"adresu <code>propriu_adresa</code>, <code>propriu_metoda</code>, "
"<code>propriu_corp</code>, <code>propriu_tip_corp</code>, "
"<code>propriu_antet</code>, <code>propriu_raspuns</code>, "
"<code>propriu_cale</code>), možné voľby (<code>alegeri</code>), čo vyžaduje "
"každá služba (<code>cere</code>), ktorá služba má kľúč (<code>chei</code>, "
"nikdy samotný kľúč), či je potrebné kľúče zadať znova (<code>chei_din_nou</"
"code>, text poznámky, prázdny, keď to nie je potrebné), stav kľúča vybranej "
"služby, ako na televízore (<code>cheie_fel</code> a <code>cheie_text</code>: "
"nastavený, nastavený pre iný server, chýba), texty stránky v jazyku "
"prijímača (<code>texte</code>), čo chýba, dôvernosť, pokyny krok za krokom "
"(s <code>pagina_cheie</code>, oficiálnou adresou pre QR kód) a stav "
"(počítadlo, skúška, prestávka po chybách)"

msgid ""
"<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: canalele "
"de pe frecvența televizorului și din lista lui, fiecare cu merge acum sau "
"motivul, codecul imaginii și felul sunetului; cu <code>wasm=1</code> "
"(browserul are playerul MPEG-2) merg și canalele cu imagine MPEG-2; "
"<code>ac3=1</code>: pagina redă sunetul AC-3, cu decodorul browserului sau "
"cu decodorul wasm al paginii"
msgstr ""
"<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: kanály na "
"frekvencii televízora a z jeho zoznamu, pri každom, či teraz funguje alebo "
"dôvod, kodek obrazu a druh zvuku; s <code>wasm=1</code> (prehliadač má "
"prehrávač MPEG-2) fungujú aj kanály s obrazom MPEG-2; <code>ac3=1</code>: "
"stránka prehráva zvuk AC-3 dekodérom prehliadača alebo wasm dekodérom stránky"

msgid ""
"<code>GET /api/tv-stare</code>: TV în browser: transmisiile de acum (canal, "
"browser, de când, octeți), setările, memoria driverului video (câte canale "
"noi se mai pot deschide până la repornire), transmisia acestui browser și "
"motivul ultimei opriri"
msgstr ""
"<code>GET /api/tv-stare</code>: TV v prehliadači: aktuálne prenosy (kanál, "
"prehliadač, odkedy, bajty), nastavenia, pamäť ovládača videa (koľko nových "
"kanálov sa ešte dá otvoriť do reštartu), prenos tohto prehliadača a dôvod "
"posledného zastavenia"

msgid ""
"<code>GET /api/video</code>: setările video ca în Setări &gt; Video: "
"rezoluțiile, frecvențele fiecărei rezoluții (cu <code>auto</code> = automat "
"după canal), culorile HDMI, <code>zapmode</code> (ce se vede la schimbarea "
"canalului) și încercarea în curs"
msgstr ""
"<code>GET /api/video</code>: nastavenia videa ako v Nastavenia &gt; Video: "
"rozlíšenia, frekvencie každého rozlíšenia (s <code>auto</code> = automaticky "
"podľa kanála), farby HDMI, <code>zapmode</code> (čo sa zobrazí pri prepnutí "
"kanála) a prebiehajúci pokus"

msgid "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: schimbă canalul"
msgstr "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: prepne kanál"

msgid "<code>POST /api/accel-reporneste</code>: repornește interfața (enigma2)"
msgstr ""
"<code>POST /api/accel-reporneste</code>: reštartuje rozhranie (enigma2)"

msgid ""
"<code>POST /api/accel-seteaza?pornita=0|1</code>: pornește sau oprește "
"accelerarea de la următoarea pornire a interfeței (refuzat pe un receptor "
"fără accelerarea 2D)"
msgstr ""
"<code>POST /api/accel-seteaza?pornita=0|1</code>: zapne alebo vypne "
"akceleráciu od nasledujúceho spustenia rozhrania (odmietnuté na prijímači "
"bez 2D akcelerácie)"

msgid ""
"<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|"
"reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</"
"code> ca în <code>GET /api/acces-conditionat</code>): pornește comanda prin "
"scriptul modulului, pe rând, una singură deodată (și cu televizorul); "
"rezultatul vine prin <code>GET /api/acces-conditionat</code>"
msgstr ""
"<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|"
"reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</"
"code> ako v <code>GET /api/acces-conditionat</code>): spustí príkaz skriptom "
"modulu, postupne, vždy len jeden (aj s televízorom); výsledok prichádza cez "
"<code>GET /api/acces-conditionat</code>"

msgid ""
"<code>POST /api/acces-ssh-adauga</code> (corp: <code>cheie=</code>), "
"<code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?"
"amprenta=SHA256:..&amp;confirmat=1</code>: cheile publice lipite, cele din "
"dosarul hdsatelit/ssh de pe stick, ștergerea unei chei"
msgstr ""
"<code>POST /api/acces-ssh-adauga</code> (telo: <code>cheie=</code>), "
"<code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?"
"amprenta=SHA256:..&amp;confirmat=1</code>: vložené verejné kľúče, tie z "
"priečinka hdsatelit/ssh na USB kľúči, odstránenie kľúča"

msgid ""
"<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</"
"code> cere și <code>confirmat=1</code>): opțiunea Fără parolă în rețeaua "
"locală. Parola, textul brut și toate schimbările merg numai dintr-un browser "
"conectat cu codul de pe televizor (altfel 403 cu <code>trebuie_cod</code>), "
"niciodată cu <code>?token=</code>; cât ecranul Parola receptorului e deschis "
"pe receptor, la fel <code>/api/remotecontrol</code> și <code>/api/"
"screenshot</code>"
msgstr ""
"<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</"
"code> vyžaduje aj <code>confirmat=1</code>): možnosť „Bez hesla v miestnej "
"sieti“. Heslo, surový text a všetky zmeny fungujú iba z prehliadača "
"pripojeného kódom z televízora (inak 403 s <code>trebuie_cod</code>), nikdy "
"s <code>?token=</code>; kým je na prijímači otvorená obrazovka „Heslo "
"prijímača“, rovnako <code>/api/remotecontrol</code> a <code>/api/screenshot</"
"code>"

msgid ""
"<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</"
"code> cere și <code>confirmat=1</code>): „Fără parolă în rețeaua locală”. "
"Parola, textul brut și toate schimbările merg numai dintr-un browser "
"conectat cu codul de pe televizor (altfel 403 cu <code>trebuie_cod</code>), "
"niciodată cu <code>?token=</code>; cât ecranul „Acces SSH” e deschis pe "
"televizor, la fel <code>/api/remotecontrol</code> și <code>/api/screenshot</"
"code>"
msgstr ""
"<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</"
"code> vyžaduje aj <code>confirmat=1</code>): „Bez hesla v miestnej sieti“. "
"Heslo, nespracovaný text a všetky zmeny fungujú len z prehliadača "
"pripojeného kódom z televízora (inak 403 s <code>trebuie_cod</code>), nikdy "
"s <code>?token=</code>; kým je na televízore otvorená obrazovka „Prístup "
"SSH“, platí to isté pre <code>/api/remotecontrol</code> a <code>/api/"
"screenshot</code>"

msgid ""
"<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/"
"acces-ssh-ascunde</code>: o parolă nouă; „Am notat parola” (textul parolei "
"se șterge de pe receptor, parola rămâne)"
msgstr ""
"<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/"
"acces-ssh-ascunde</code>: nové heslo; „Heslo som si zapísal“ (text hesla sa "
"z prijímača odstráni, heslo zostane)"

msgid ""
"<code>POST /api/acces-ssh-parola</code>: textul parolei (se vede oricând); "
"<code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: fișierele serverelor "
"SSH și FTP ca text (fără /etc/shadow)"
msgstr ""
"<code>POST /api/acces-ssh-parola</code>: text hesla (viditeľný kedykoľvek); "
"<code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: súbory serverov SSH a "
"FTP ako text (bez /etc/shadow)"

msgid ""
"<code>POST /api/acces-ssh-parola</code>: textul parolei, cât timp nu a fost "
"ascunsă; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: fișierele "
"serverului SSH ca text (fără /etc/shadow)"
msgstr ""
"<code>POST /api/acces-ssh-parola</code>: text hesla, kým nebolo skryté; "
"<code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: súbory servera SSH "
"ako text (bez /etc/shadow)"

msgid ""
"<code>POST /api/acces-ssh-pune</code> (corp: <code>parola=</code>): parola "
"aleasă (4-64 de semne: litere fără diacritice, cifre și semne, fără spații); "
"<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>: o parolă nouă la "
"întâmplare"
msgstr ""
"<code>POST /api/acces-ssh-pune</code> (telo: <code>parola=</code>): zvolené "
"heslo (4-64 znakov: písmená bez diakritiky, číslice a znaky, bez medzier); "
"<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>: nové náhodné heslo"

msgid ""
"<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;"
"evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;"
"viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;"
"luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;"
"noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: salvează și "
"aplică pe loc (oricare dintre ele); <code>previzualizare=1&amp;lista=...</"
"code> arată lista pe afișaj fără salvare (cel mult 2 minute fără o cerere "
"nouă), <code>previzualizare=0</code> revine; <code>minutar=0|1..120</code> "
"și <code>cronometru=porneste|opreste|zero</code> pornesc ceasurile "
"afișajului pe loc; <code>functionare=ora|canal|stins</code> merge ca înainte"
msgstr ""
"<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;"
"evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;"
"viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;"
"luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;"
"noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: uloží a ihneď "
"použije (ktorýkoľvek z nich); <code>previzualizare=1&amp;lista=...</code> "
"zobrazí zoznam na displeji bez uloženia (najviac 2 minúty bez novej "
"požiadavky), <code>previzualizare=0</code> sa vráti; <code>minutar=0|1..120</"
"code> a <code>cronometru=porneste|opreste|zero</code> ihneď spustia hodiny "
"displeja; <code>functionare=ora|canal|stins</code> funguje ako predtým"

msgid ""
"<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;"
"claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</"
"code>: salvează reglajele unui profil (multipli de 5); cu <code>incearca=1</"
"code> se văd pe loc fără să se salveze, <code>renunta=1</code> pune înapoi "
"ce e salvat; <code>POST /api/calitate-imagine-implicite?profil=&lt;"
"profil&gt;|toate</code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|"
"hdr10|hlg|none</code> (canalul pornește din nou, întrebarea apare pe "
"televizor); <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;"
"&amp;pornit=0|1</code> (jumătate de ecran, 60 s)"
msgstr ""
"<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;"
"claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</"
"code>: uloží nastavenia profilu (násobky 5); s <code>incearca=1</code> sa "
"hneď prejavia bez uloženia, <code>renunta=1</code> vráti to, čo je uložené; "
"<code>POST /api/calitate-imagine-implicite?profil=&lt;profil&gt;|toate</"
"code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|hdr10|hlg|none</"
"code> (kanál sa spustí znova, otázka sa zobrazí na televízore); <code>POST /"
"api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;&amp;pornit=0|1</code> "
"(polovica obrazovky, 60 s)"

msgid ""
"<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: pornește "
"canalul prin lista de pe televizor"
msgstr ""
"<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: spustí "
"kanál cez zoznam na televízore"

msgid ""
"<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: deschide "
"pe televizor un rezultat al căutării, cu rândul găsit ales"
msgstr ""
"<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: otvorí na "
"televízore výsledok vyhľadávania s vybraným nájdeným riadkom"

msgid ""
"<code>POST /api/cautare-actualizeaza-opreste</code>: oprește citirea și "
"revine la canalul de dinainte"
msgstr ""
"<code>POST /api/cautare-actualizeaza-opreste</code>: zastaví čítanie a vráti "
"sa na predchádzajúci kanál"

msgid ""
"<code>POST /api/cautare-actualizeaza-sari</code>: sare peste satelitul pe "
"care e antena acum și trece la următorul (tasta GALBEN de pe televizor)"
msgstr ""
"<code>POST /api/cautare-actualizeaza-sari</code>: preskočí satelit, na ktorý "
"je teraz nasmerovaná anténa, a prejde na ďalší (tlačidlo ŽLTÉ na televízore)"

msgid ""
"<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: "
"întrebarea (durata, motorul); cu <code>confirmat=1</code> pornește pe "
"televizor citirea pistelor, transponder cu transponder"
msgstr ""
"<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: otázka "
"(trvanie, motor); s <code>confirmat=1</code> spustí na televízore čítanie "
"stôp, transpondér po transpondéri"

msgid ""
"<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: "
"citirea pistelor în timpul vizionării (oprită, numai canalul privit, tot "
"transponderul), aceeași setare ca pe televizor"
msgstr ""
"<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: "
"čítanie stôp počas sledovania (vypnuté, len sledovaný kanál, celý "
"transpondér), rovnaké nastavenie ako na televízore"

msgid ""
"<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;"
"&amp;fus=&lt;fus orar&gt;</code>: schimbă și salvează oricare dintre ele "
"(valorile exacte sunt în <code>/api/ceas</code>)"
msgstr ""
"<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;"
"&amp;fus=&lt;fus orar&gt;</code>: zmení a uloží ktorýkoľvek z nich (presné "
"hodnoty sú v <code>/api/ceas</code>)"

msgid ""
"<code>POST /api/ceas-sincronizeaza</code>: o sincronizare a orei prin "
"Internet, acum"
msgstr ""
"<code>POST /api/ceas-sincronizeaza</code>: jedna synchronizácia času cez "
"internet, teraz"

msgid ""
"<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/"
"copie-setari-pune?copie=&lt;id&gt;</code> (repornește interfața; copia se "
"pune la loc înainte să pornească), <code>POST /api/copie-setari-sterge?"
"copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|"
"zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"
msgstr ""
"<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/"
"copie-setari-pune?copie=&lt;id&gt;</code> (reštartuje rozhranie; kópia sa "
"obnoví pred jeho spustením), <code>POST /api/copie-setari-sterge?copie=&lt;"
"id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|"
"zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"

msgid ""
"<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|"
"invata|sterge&amp;flux=..</code>: actualizează lista, reface buchetele, "
"învață posturile unui flux, șterge un flux adăugat de mână"
msgstr ""
"<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|"
"invata|sterge&amp;flux=..</code>: aktualizuje zoznam, obnoví bukety, naučí "
"sa stanice toku, odstráni ručne pridaný tok"

msgid ""
"<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;"
"emisfera=E|V&amp;frecventa=..&amp;...</code>: un flux adăugat de mână, cu "
