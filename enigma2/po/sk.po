msgstr "ATSC 3.0 (USA - nová generácia)"

msgid "ATSC 3.0 (SUA, nouă generație)"
msgstr "ATSC 3.0 (USA, nová generácia)"

msgid ""
"ATSC 3.0: Next-gen american (NextGen TV). SUA din 2020+.\n"
"IP-based, Ultra HD, HDR, audio imersiv."
msgstr ""
"ATSC 3.0: Americký štandard novej generácie (NextGen TV). USA od roku "
"2020+.\n"
"Založený na IP, Ultra HD, HDR, priestorový zvuk."

msgid ""
"ATSC 3.0: standardul nou din SUA, folosit din 2020.\n"
"Ultra HD, HDR, sunet cu efect de spațiu."
msgstr ""
"ATSC 3.0: nový štandard v USA, používaný od roku 2020.\n"
"Ultra HD, HDR, priestorový zvuk."

msgid "ATSC: gestionat de BDA pe PC. Folosește aplicația ATSC dedicată."
msgstr "ATSC: na PC spravované cez BDA. Použi vyhradenú aplikáciu ATSC."

