msgstr "Názov kanála (akákoľvek časť názvu)"

msgid "Numele canalului căutat"
msgstr "Názov hľadaného kanála"

msgid "Numele contului VPN"
msgstr "Meno účtu VPN"

msgid ""
"Numele cu care apare în listă și în fișierul înregistrării. OK deschide "
"tastatura."
msgstr ""
"Názov, pod ktorým sa zobrazí v zozname a v súbore nahrávky. OK otvorí "
"klávesnicu."

msgid "Numele cu care apari pe forum și pe site."
msgstr "Meno, pod ktorým vystupuješ na fóre a na webe."

msgid ""
"Numele de utilizator al contului tău OpenSubtitles.com (nu adresa de e-"
"mail). Un cont gratuit dă 20 de descărcări pe zi."
msgstr ""
"Používateľské meno tvojho účtu OpenSubtitles.com (nie e-mailová adresa). "
"Bezplatný účet dáva 20 stiahnutí denne."

msgid "Numele de utilizator nu poate conține virgule sau rânduri noi."
msgstr "Meno používateľa nemôže obsahovať čiarky ani nové riadky."

msgid ""
"Numele de utilizator sau parola nu sunt bune, ori utilizatorul nu are voie "
"în acest dosar."
msgstr ""
"Meno používateľa alebo heslo nie je správne, alebo používateľ nemá prístup "
"do tohto priečinka."

msgid "Numele dosarului nou"
msgstr "Názov nového priečinka"

msgid "Numele e cel al programului care rulează."
msgstr "Názov je podľa bežiaceho programu."

msgid "Numele e cel din cererea lui de parolă."
msgstr "Názov je podľa jeho žiadosti o heslo."

msgid "Numele e cel din pachetul lui."
msgstr "Názov je podľa jeho balíčka."

msgid "Numele e cel din scriptul lui de pornire."
msgstr "Názov je podľa jeho spúšťacieho skriptu."

msgid "Numele e cel trimis de serverul lui."
msgstr "Názov je ten, ktorý posiela jeho server."

msgid "Numele e deja folosit. Alege altul."
msgstr "Meno sa už používa. Zvoľ si iné."

msgid ""
"Numele e gol sau are numai semne (punct, liniuță, spații). Unele pot fi "
"fluxuri care pornesc numai uneori: uită-te la frecvență și la imagine / "
"sunet."
msgstr ""
"Názov je prázdny alebo obsahuje len znaky (bodka, pomlčka, medzery). "
"Niektoré môžu byť kanály, ktoré vysielajú len občas: pozri sa na frekvenciu "
"a na obraz / zvuk."

msgid "Numele e salvat."
msgstr "Meno je uložené."

msgid "Numele e titlul paginii lui."
msgstr "Názov je titulok jeho stránky."

msgid "Numele filmului"
msgstr "Názov filmu"

msgid ""
"Numele fișierului nu e bun sau playerul nu cunoaște acest fel de fișier."
msgstr ""
"Názov súboru nie je v poriadku alebo prehrávač tento druh súboru nepozná."

msgid "Numele fișierului nu se poate citi"
msgstr "Názov súboru sa nedá prečítať"

msgid ""
"Numele fișierului nu se poate citi pe receptor. Redenumește-l fără "
"diacritice."
msgstr ""
"Názov súboru sa na prijímači nedá prečítať. Premenuj ho bez diakritiky."

msgid "Numele fluxului"
msgstr "Názov streamu"

msgid "Numele fontului"
msgstr "Názov fontu"

msgid "Numele fontului, de exemplu Roboto"
msgstr "Názov písma, napríklad Roboto"

msgid "Numele marcajului"
msgstr "Názov značky"

msgid "Numele modelului de pe server, de exemplu gemma3:4b sau qwen2.5:7b."
msgstr "Názov modelu na serveri, napríklad gemma3:4b alebo qwen2.5:7b."

msgid ""
"Numele modelului e prea lung sau are caractere nepermise. Nu s-a pornit "
"nimic."
msgstr ""
"Názov modelu je príliš dlhý alebo obsahuje nepovolené znaky. Nič sa "
"nespustilo."

msgid "Numele modelului nu e bun."
msgstr "Názov modelu nie je správny."

msgid "Numele modulelor: %s"
msgstr "Názvy modulov: %s"

msgid "Numele nou"
msgstr "Nový názov"

#, python-format
msgid "Numele nu este bun (cel mult %d semne, pe un singur rând)."
msgstr "Meno nie je platné (najviac %d znakov, na jednom riadku)."

msgid "Numele nu poate fi gol."
msgstr "Meno nemôže byť prázdne."

msgid "Numele nu se poate schimba încă de aici."
msgstr "Meno sa odtiaľto zatiaľ nedá zmeniť."

msgid "Numele pachetului nu este valid. Nu se instalează."
msgstr "Názov balíčka nie je platný. Neinštaluje sa."

msgid "Numele pachetului nu este valid. Nu se șterge."
msgstr "Názov balíčka nie je platný. Nemaže sa."

msgid "Numele paginii (dacă vrei)"
msgstr "Názov stránky (nepovinné)"

#, python-format
msgid "Numele pe televizor: %s, cerut de televizor la %s."
msgstr "Názov na televízore: %s, televízor si ho vyžiadal o %s."

#, python-format
msgid "Numele pe televizor: %s."
msgstr "Názov na televízore: %s."

msgid "Numele plăcii de sunet are numai litere, cifre și : , _ - ."
msgstr "Názov zvukového zariadenia obsahuje len písmená, číslice a : , _ - ."

msgid ""
"Numele poate avea doar litere mici, cifre și semnele - _ . (cel mult 32)."
msgstr ""
"Názov môže obsahovať iba malé písmená, číslice a znaky - _ . (najviac 32)."

msgid "Numele postului de radio"
msgstr "Názov rozhlasovej stanice"

msgid "Numele public"
msgstr "Verejné meno"

msgid "Numele public are 2-40 de semne: litere, cifre, spațiu, punct, liniuță."
msgstr ""
"Verejné meno má 2-40 znakov: písmená, číslice, medzera, bodka, spojovník."

msgid "Numele public e deja folosit de alt tester. Alege altul."
msgstr "Verejné meno už používa iný tester. Zvoľ si iné."

msgid "Numele receptorului"
msgstr "Názov prijímača"

msgid "Numele receptorului pe televizor"
msgstr "Názov prijímača na televízore"

msgid "Numele rețelei ascunse"
msgstr "Názov skrytej siete"

msgid "Numele satelitului"
msgstr "Názov satelita"

msgid "Numele satelitului are un caracter care nu se poate scrie în listă."
msgstr "Názov satelitu obsahuje znak, ktorý sa nedá zapísať do zoznamu."

msgid "Numele satelitului e prea lung: cel mult %d de caractere."
msgstr "Názov satelitu je príliš dlhý: najviac %d znakov."

msgid "Numele sau parola nu sunt bune. VPN-ul nu mai încearcă singur."
msgstr "Meno alebo heslo nie sú správne. VPN to už sám neskúša."

msgid "Numele serverului NTP nu este valid."
msgstr "Názov servera NTP nie je platný."

msgid ""
"Numele serverului nu se găsește în rețea. Scrie adresa lui, de pildă "
"192.168.1.20."
msgstr ""
"Názov servera sa v sieti nenájde. Napíš jeho adresu, napríklad 192.168.1.20."

msgid "Numele setării, cu tastele 0-9"
msgstr "Názov nastavenia, klávesmi 0-9"

msgid ""
"Numele spune HD sau 4K, dar emițătorul îl anunță ca SD: filtrul „HD și 4K” "
"nu-l prinde. Filtrul „HD în nume, tip SD” din „Adaugă canale” le arată pe "
"toate, cu bife."
msgstr ""
"Názov hovorí HD alebo 4K, ale vysielateľ ohlasuje kanál ako SD: filter „HD a "
"4K“ ho nezachytí. Filter „HD v názve, typ SD“ v časti „Pridať kanály“ ich "
"zobrazí všetky, so začiarknutím."

msgid "Numele sursei (litere mici, cifre și -)"
msgstr "Názov zdroja (malé písmená, číslice a -)"

msgid "Numele sursei nu poate fi gol."
msgstr "Názov zdroja nemôže byť prázdny."

msgid "Numele sursei: litere mici, cifre și -"
msgstr "Názov zdroja: malé písmená, číslice a -"

msgid "Numele telecomenzii"
msgstr "Názov diaľkového ovládania"

msgid "Numele telecomenzii nu poate fi gol."
msgstr "Názov diaľkového ovládača nemôže byť prázdny."

msgid "Numele tău pe forum"
msgstr "Tvoje meno na fóre"

msgid "Numele tău pe forum e acum „%s”."
msgstr "Tvoje meno na fóre je teraz „%s“."

msgid "Numele și parola au fost șterse de pe receptor."
msgstr "Meno a heslo boli z prijímača odstránené."

msgid "Numele și parola contului"
msgstr "Meno a heslo účtu"

msgid ""
"Numele și parola contului HMA. După salvare nu se mai arată nicăieri. Se "
"scriu mai ușor din telefon, în interfața web."
msgstr ""
"Meno a heslo účtu HMA. Po uložení sa už nikde nezobrazia. Ľahšie sa píšu z "
"telefónu, vo webovom rozhraní."

msgid "Numele și parola de serviciu"
msgstr "Servisné meno a heslo"

msgid "Numele și parola din fișier nu se folosesc: se scriu pe receptor."
msgstr "Meno a heslo zo súboru sa nepoužívajú: zapisujú sa na prijímači."

msgid "Numele și parola sunt salvate. Nu se mai arată nicăieri."
msgstr "Meno a heslo sú uložené. Už sa nikde nezobrazujú."

msgid "Numele, cu tastatura de pe ecran"
msgstr "Názov, klávesnicou na obrazovke"

msgid "Numele, cu tastele 0-9"
msgstr "Názov, tlačidlami 0-9"

msgid ""
"Numerele DVB ale fluxului (pentru siglă): SID, TSID, ONID, namespace (hex)"
msgstr "Čísla DVB streamu (pre logo): SID, TSID, ONID, namespace (hex)"

msgid "Număr de fișiere"
msgstr "Počet súborov"

msgid "Numărate de la ora"
msgstr "Počítané od"

msgid "Numărul canalului"
msgstr "Číslo kanála"

msgid "Numărul canalului din lista de canale."
msgstr "Číslo kanála zo zoznamu kanálov."

#, python-format
msgid "Numărul copiilor păstrate trebuie să fie între 1 și %d."
msgstr "Počet uchovávaných kópií musí byť od 1 do %d."

msgid "Numărul de bare"
msgstr "Počet stĺpcov"

msgid "Numărul de secunde nu este bun."
msgstr "Počet sekúnd nie je platný."

msgid "Numărul din lista de canale, cel la care duc cifrele telecomenzii."
msgstr "Číslo zo zoznamu kanálov, na ktoré vedú číslice ovládača."

msgid ""
"Numărul mare nu înseamnă procesor ocupat: include firele driverelor care "
"așteaptă."
msgstr ""
"Vysoké číslo neznamená vyťažený procesor: zahŕňa aj čakajúce vlákna "
"ovládačov."

msgid "Numărul operatorului"
msgstr "Číslo operátora"

msgid "Numărul poziției (1-255)"
msgstr "Číslo pozície (1-255)"

#, python-format
msgid "Numărul procesului (PID): %s"
msgstr "Číslo procesu (PID): %s"

msgid "Numărul rețelei (ONID)"
msgstr "Číslo siete (ONID)"

msgid "Numărul transponderului (TSID)"
msgstr "Číslo transpondéra (TSID)"

msgid "Numărul și numele"
msgstr "Číslo a názov"

msgid "Numărătoarea opririlor"
msgstr "Počítadlo zastavení"

msgid ""
"O adresă http:// merge numai pentru un server din rețeaua de acasă (de "
"exemplu 192.168.1.50); pentru un server de pe internet scrie https://."
msgstr ""
"Adresa http:// funguje len pre server v domácej sieti (napríklad "
"192.168.1.50); pre server na internete napíš https://."

msgid ""
"O altă placă e deja configurată. Pe televizor, aceeași întrebare apare la OK."
msgstr ""
"Iná karta je už nakonfigurovaná. Na televízore sa rovnaká otázka objaví po "
"OK."

msgid "O altă schimbare a rețelei încă lucrează. Așteaptă să se termine."
msgstr "Iná zmena siete ešte prebieha. Počkaj, kým sa skončí."

msgid "O altă schimbare de LNB așteaptă confirmarea."
msgstr "Iná zmena LNB čaká na potvrdenie."

msgid "O altă valoare a receptorului nu se potrivește."
msgstr "Iná hodnota prijímača nesúhlasí."

msgid "O captură aleasă nu mai există. Alege din nou."
msgstr "Vybraná snímka už neexistuje. Vyber znova."

msgid ""
"O cheie pleacă numai pe https:// sau spre un server din rețeaua de acasă. "
"Scrie adresa cu https://. Cheia nu a plecat nicăieri."
msgstr ""
"Kľúč sa posiela len cez https:// alebo na server v domácej sieti. Napíš "
"adresu s https://. Kľúč nebol nikam odoslaný."

msgid "O conectare Wi-Fi încă lucrează. Așteaptă să se termine sau oprește-o."
msgstr ""
"Pripájanie k Wi-Fi ešte prebieha. Počkaj, kým sa skončí, alebo ho zastav."

msgid "O copie așteaptă să fie pusă la loc la repornirea interfeței."
msgstr "Kópia čaká na obnovenie pri reštarte rozhrania."

msgid "O copie se face deja. Așteaptă să se termine."
msgstr "Kópia sa už vytvára. Počkaj, kým sa dokončí."

msgid ""
"O copie se face singură înainte de fiecare salvare, aici și în interfața "
"web. Întoarcerea pune întâi lista de acum într-o copie nouă."
msgstr ""
"Kópia sa vytvorí sama pred každým uložením, tu aj vo webovom rozhraní. "
"Návrat najprv uloží aktuálny zoznam do novej kópie."

msgid "O cutie pentru toate rândurile"
msgstr "Jeden rámček pre všetky riadky"

msgid ""
"O căutare e deja în curs pe receptor. Așteaptă să se termine sau oprește-o."
msgstr ""
"V prijímači už prebieha vyhľadávanie. Počkaj, kým sa skončí, alebo ho zastav."

msgid "O căutare e deja în curs."
msgstr "Vyhľadávanie už prebieha."

msgid "O căutare sau o descărcare merge deja; așteaptă să se termine."
msgstr "Vyhľadávanie alebo sťahovanie už prebieha; počkaj, kým sa skončí."

msgid ""
"O data pe zi, in fundal, receptorul ia de pe stb.hdsatelit.com frecventele "
"si numele posturilor. Butonul Actualizeaza lista merge oricand."
msgstr ""
"Raz denne, na pozadí, prijímač stiahne zo stb.hdsatelit.com frekvencie a "
"názvy staníc. Tlačidlo Aktualizovať zoznam funguje kedykoľvek."

msgid "O dată pe minut"
msgstr "Raz za minútu"

msgid "O dată pe săptămână"
msgstr "Raz týždenne"

msgid ""
"O dată pe zi, noaptea, numai felurile bifate, și imediat după o oprire "
"neașteptată a interfeței sau o actualizare care nu a reușit. Fără bifă "
"pleacă numai ce trimiți tu cu „Trimite acum”."
msgstr ""
"Raz denne, v noci, len zaškrtnuté druhy, a hneď po neočakávanom zastavení "
"rozhrania alebo neúspešnej aktualizácii. Bez zaškrtnutia odíde len to, čo "
"pošleš ty cez „Poslať teraz“."

msgid ""
"O dată pe zi, în fundal, receptorul ia de pe stb.hdsatelit.com frecvențele "
"și numele posturilor. Butonul „Actualizează lista” merge oricând. <span "
"id=\"ultimaZilnica\"></span>"
msgstr ""
"Raz denne, na pozadí, prijímač stiahne z stb.hdsatelit.com frekvencie a "
"názvy staníc. Tlačidlo „Aktualizovať zoznam“ funguje kedykoľvek. <span "
"id=\"ultimaZilnica\"></span>"

msgid "O eroare pe receptor."
msgstr "Chyba na prijímači."

msgid "O greșeală, o idee sau o întrebare, direct echipei."
msgstr "Chyba, nápad alebo otázka, priamo tímu."

msgid "O lipești, iar receptorul recunoaște singur serviciul."
msgstr "Vložíš ho a prijímač sám rozpozná službu."

msgid ""
"O listă de redare de pe disc nu se poate șterge din player, nici pe "
"televizor."
msgstr "Playlist na disku sa nedá odstrániť z prehrávača, ani na televízore."

msgid "O margine e între 0 și 5 la sută din latura ei."
msgstr "Okraj je medzi 0 a 5 percentami svojej strany."

msgid "O notă despre emisiune. OK deschide tastatura."
msgstr "Poznámka o relácii. OK otvorí klávesnicu."

msgid "O pagină mai jos"
msgstr "O stránku nižšie"

msgid "O pagină mai sus"
msgstr "O stránku vyššie"

msgid "O pagină în jos"
msgstr "O stránku nadol"

msgid "O pagină în sus"
msgstr "O stránku nahor"

msgid ""
"O poză nu a putut fi urcată: trebuie să fie JPG sau PNG, de cel mult 4 MB."
msgstr "Obrázok sa nepodarilo nahrať: musí byť JPG alebo PNG, najviac 4 MB."

msgid "O poți instala din nou oricând, din aceeași sursă."
msgstr "Môžeš ho kedykoľvek znova nainštalovať z toho istého zdroja."

msgid "O probă DiSEqC e deja deschisă pe televizor. Închide-o întâi."
msgstr "Na televízore je už otvorený test DiSEqC. Najprv ho zavri."

msgid "O reîmprospătare e deja în lucru."
msgstr "Obnova už prebieha."

msgid "O reîncărcare e deja în curs."
msgstr "Opätovné načítanie už prebieha."

msgid ""
"O scanare DAB+ sau DVB-T2 e deschisă pe televizor. Așteaptă să se termine "
"sau oprește-o."
msgstr ""
"Na televízore je otvorené vyhľadávanie DAB+ alebo DVB-T2. Počkaj, kým sa "
"skončí, alebo ho zastav."

msgid "O singură dată"
msgstr "Raz"

msgid ""
"O singură dată sau repetat: în fiecare zi, o dată pe săptămână, de luni până "
"vineri sau în zilele alese."
msgstr ""
"Raz alebo opakovane: každý deň, raz týždenne, od pondelka do piatka alebo vo "
"vybraných dňoch."

msgid "O singură limbă: forumul traduce singur."
msgstr "Jeden jazyk: fórum prekladá samo."

msgid ""
"O telecomandă USB (sau o tastatură) se bagă în receptor înainte; se vede "
"imediat."
msgstr ""
"USB diaľkové ovládanie (alebo klávesnicu) najprv pripoj do prijímača; hneď "
"sa rozpozná."

msgid ""
"O telecomandă cu infraroșu, alta decât a receptorului, nu se poate asocia "
"încă."
msgstr ""
"Infračervené diaľkové ovládanie iné ako od prijímača sa zatiaľ nedá spárovať."

msgid "O valoare a transponderului nu e bună: %s."
msgstr "Niektorá hodnota transpondéra nie je správna: %s."

msgid "O înregistrare e în curs."
msgstr "Prebieha nahrávanie."

msgid "O înregistrare e în curs: se oprește la revenire."
msgstr "Prebieha nahrávanie: pri návrate sa zastaví."

msgid ""
"O înregistrare folosește acum antena. Comenzile pornesc după ce se termină."
msgstr "Anténu teraz používa nahrávanie. Príkazy pôjdu po jeho skončení."

msgid ""
"O înregistrare folosește acum tunerul. Locul se schimbă după ce se termină."
msgstr "Nahrávanie teraz používa tuner. Umiestnenie sa zmení, keď sa skončí."

msgid "O înregistrare programată nu poate porni: nu am unde să înregistrez."
msgstr "Naplánované nahrávanie nemôže začať: nemám kam nahrávať."

#, python-format
msgid "O înregistrare scrie acum pe acest disc: %s."
msgstr "Na tento disk teraz nahráva: %s."

msgid "O înregistrare începe în curând. Pornește scanarea detaliată după ea."
msgstr "Čoskoro začne nahrávanie. Spusti podrobné vyhľadávanie až po ňom."

#, python-format
msgid "O înregistrare începe în mai puțin de %d minute."
msgstr "Nahrávanie sa začne za menej ako %d minút."

msgid "O înregistrare începe în mai puțin de 6 minute."
msgstr "Nahrávanie začne o menej ako 6 minút."

msgid "OK"
msgstr "OK"

msgid "OK = da, EXIT = nu"
msgstr "OK = áno, EXIT = nie"

msgid "OK actualizează · Roșu șterge"
msgstr "OK aktualizuje · Červené vymaže"

msgid "OK adaugă"
msgstr "OK pridá"

msgid ""
"OK adaugă canalul în buchetul din dreapta · cifrele scriu numele · HELP "
"ajutor"
msgstr "OK pridá kanál do buketu vpravo · číslice píšu názov · HELP nápoveda"

msgid "OK add to playlist, MENU options, CH+ / CH- switch list"
msgstr "OK pridať do zoznamu, MENU možnosti, CH+ / CH- prepnúť zoznam"

msgid "OK alege"
msgstr "OK vyberie"

msgid "OK alege capturile, Verde le pune în mesaj."
msgstr "OK vyberá snímky, Zelená ich vloží do správy."

msgid "OK alege feedul pachetelor arătate."
msgstr "OK vyberie feed zobrazených balíčkov."

msgid "OK alege feedul sau felul pachetelor arătate."
msgstr "OK vyberie feed alebo druh zobrazených balíčkov."

msgid ""
"OK alege latura: toate, sus, dreapta, jos sau stânga. Săgeata spre margine "
"duce latura aleasă spre marginea ecranului, săgeata opusă o aduce spre "
"mijloc. La toate laturile, Sus și Dreapta măresc cadrul, Jos și Stânga îl "
"micșorează. Potrivește cadrul până se vede întreg pe televizor."
msgstr ""
"OK vyberá stranu: všetky, hore, vpravo, dole alebo vľavo. Šípka k okraju "
"posunie vybranú stranu k okraju obrazovky, opačná šípka ju vráti k stredu. "
"Pri všetkých stranách Hore a Vpravo rám zväčšia, Dole a Vľavo ho zmenšia. "
"Prispôsob rám, kým ho na televízore neuvidíš celý."

msgid ""
"OK alege orașul. Ora lui apare când „Ora din alt oraș” e în lista de rotire."
msgstr ""
"OK vyberie mesto. Jeho čas sa zobrazí, keď je „Čas v inom meste“ v zozname "
"striedania."

msgid "OK alege valoarea."
msgstr "OK vyberie hodnotu."

msgid "OK alege valoarea. Luminozitatea se aplică după salvare."
msgstr "OK vyberie hodnotu. Jas sa použije po uložení."

