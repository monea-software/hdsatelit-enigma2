msgstr ""
"<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code>: odpoveď na "
"„Ponecháš nové nastavenia?“"

msgid ""
"<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</"
"code>: locul antenei aflat după adresa de internet a receptorului, de "
"serverul HD Satelit, numai la cerere și numai din browserul conectat; se "
"scrie abia după confirmare, cu <code>POST /api/locul-seteaza</code> și "
"<code>internet=&lt;semn&gt;</code>"
msgstr ""
"<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</"
"code>: umiestnenie antény zistené podľa internetovej adresy prijímača "
"serverom HD Satelit, len na požiadanie a len z pripojeného prehliadača; "
"zapíše sa až po potvrdení, pomocou <code>POST /api/locul-seteaza</code> a "
"<code>internet=&lt;semn&gt;</code>"

msgid ""
"<code>POST /api/locul-seteaza</code>: locul antenei din tabel (<code>tara</"
"code>, <code>oras</code>) sau scris (<code>lat</code>, <code>lon</code>, "
"grade, nord și est pozitive)"
msgstr ""
"<code>POST /api/locul-seteaza</code>: umiestnenie antény z tabuľky "
"(<code>tara</code>, <code>oras</code>) alebo zadané (<code>lat</code>, "
"<code>lon</code>, stupne, sever a východ kladné)"

msgid ""
"<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: deschide pe "
"televizor ecranul unei intrări (nu oprirea sau repornirea)"
msgstr ""
"<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: otvorí na "
"televízore obrazovku položky (nie vypnutie ani reštart)"

msgid ""
