msgstr "Pauza. Zvuk sa vráti s ekvalizérom, keď znova spustíš prehrávanie."

msgid "Paza de model"
msgstr "Ochrana modelu"

msgid "Paza de model nu se aplică aici"
msgstr "Ochrana modelu sa tu neuplatňuje"

msgid "Paznic anti-blocaj"
msgstr "Strážca proti zamrznutiu"

msgid ""
"Paznicul a gasit data trecuta enigma2 blocat in driver. Receptorul a fost "
"repornit."
msgstr ""
"Strážca naposledy zistil zablokovanú enigma2 v ovládači. Prijímač bol "
"reštartovaný."

msgid ""
"Paznicul a gasit enigma2 blocat de prea multe ori. Vezi jurnalul paznicului."
msgstr ""
"Strážca zistil, že enigma2 bola zablokovaná príliš veľakrát. Pozri denník "
"strážcu."

msgid "Paznicul a repornit interfata: enigma2 nu mai raspundea."
msgstr "Strážca reštartoval rozhranie: enigma2 prestala reagovať."

msgid "Paznicul așteaptă primul semn de viață al interfeței."
msgstr "Strážca čaká na prvý znak života rozhrania."

msgid ""
"Paznicul nu a verificat încă serviciile de sistem (o face la 3 minute după "
"pornire)."
msgstr ""
"Strážca ešte neskontroloval systémové služby (urobí to 3 minúty po spustení)."

msgid "Paznicul nu rulează acum (fără stare nouă de peste un minut)."
msgstr "Strážca teraz nebeží (žiadny nový stav viac ako minútu)."

msgid ""
"Paznicul nu rulează sau nu a scris încă nicio stare (imagine fără el, sau "
"pornirea abia a început)."
msgstr ""
"Strážca nebeží alebo ešte nezapísal žiadny stav (image bez neho alebo "
"spúšťanie sa práve začalo)."

#, python-format
msgid "Paznicul plăcii: pornit, %d secunde."
msgstr "Strážca dosky: zapnutý, %d sekúnd."

msgid "Paznicul plăcii: pornit."
msgstr "Strážca dosky: zapnutý."

msgid "Paznicul receptorului"
msgstr "Strážca prijímača"

msgid ""
"Paznicul repornește interfața numai când nu mai dă semn de viață și nici "
"interfața web nu răspunde. În timpul unei scanări, al citirii pistelor sau "
"al unei rotiri de antenă așteaptă. Paznicul plăcii rămâne mereu pornit."
msgstr ""
"Strážca reštartuje rozhranie len vtedy, keď už nedáva znaky života a "
"neodpovedá ani webové rozhranie. Počas vyhľadávania, čítania stôp alebo "
"otáčania antény čaká. Strážca dosky zostáva vždy zapnutý."

msgid ""
"Paznicul repornește interfața numai când nu mai dă semn de viață și nici "
"interfața web nu răspunde. În timpul unei scanări, al citirii pistelor sau "
"al unei rotiri de antenă așteaptă. Paznicul plăcii rămâne mereu pornit. Când "
"memoria decodorului nu mai ajunge, receptorul o eliberează singur după "
"câteva minute de standby, fără înregistrări în curs sau în următoarele 30 de "
"minute: se repornește fără să aprindă televizorul și rămâne în standby. "
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__."
msgstr ""
"Strážca reštartuje rozhranie len vtedy, keď už nedáva známky života a "
"neodpovedá ani webové rozhranie. Počas vyhľadávania, čítania stôp alebo "
"otáčania antény čaká. Strážca dosky zostáva stále zapnutý. Keď pamäť "
"dekodéra prestane stačiť, prijímač ju sám uvoľní po niekoľkých minútach v "
"pohotovostnom režime, bez prebiehajúcich nahrávok ani nahrávok v "
"nasledujúcich 30 minútach: reštartuje sa bez zapnutia televízora a zostane v "
"pohotovostnom režime. Rovnaké nastavenia sú na televízore, v __DRUM_MENIU__."

msgid ""
"Paznicul repornește interfața numai când nu mai dă semn de viață și nici "
"interfața web nu răspunde. În timpul unei scanări, al citirii pistelor sau "
"al unei rotiri de antenă așteaptă. Paznicul plăcii rămâne mereu pornit. "
"Repornirea de noapte se face între 3 și 5, numai în standby, numai cu "
"memoria decodorului fărâmițată și fără înregistrări în curs sau în "
"următoarele 30 de minute; receptorul rămâne în standby. Aceleași setări sunt "
"pe televizor, în __DRUM_MENIU__."
msgstr ""
"Strážca reštartuje rozhranie, len keď už nejaví známky života a neodpovedá "
"ani webové rozhranie. Počas vyhľadávania, čítania stôp alebo otáčania antény "
"čaká. Strážca dosky zostáva vždy zapnutý. Nočný reštart prebieha medzi 3. a "
"5. hodinou, len v pohotovostnom režime, len pri fragmentovanej pamäti "
"dekodéra a bez prebiehajúcich nahrávok ani nahrávok v nasledujúcich 30 "
"minútach; prijímač zostáva v pohotovostnom režime. Rovnaké nastavenia sú na "
"televízore, v __DRUM_MENIU__."

msgid "Paznicul supraveghează interfața."
msgstr "Strážca dohliada na rozhranie."

msgid "Pașii decriptării"
msgstr "Kroky dešifrovania"

msgid "Paște"
msgstr "Veľká noc"

#, python-format
