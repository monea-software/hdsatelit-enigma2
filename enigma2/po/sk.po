msgid ""
"Aceasta e telecomanda receptorului. Apasă un buton pe cealaltă telecomandă."
msgstr ""
"Toto je diaľkové ovládanie prijímača. Stlač tlačidlo na druhom diaľkovom "
"ovládaní."

msgid ""
"Această acțiune se face numai din browserul conectat, nu cu cheia din adresă."
msgstr ""
"Táto akcia sa dá vykonať iba z pripojeného prehliadača, nie kľúčom v adrese."

msgid ""
"Această imagine nu are încă liste de canale gata făcute. Canalele se găsesc "
"cu o scanare, pe satelit, prin cablu sau terestru, sau se aduc dintr-o copie "
"de pe stick."
msgstr ""
"Tento image zatiaľ nemá hotové zoznamy kanálov. Kanály sa nájdu "
"vyhľadávaním, cez satelit, kábel alebo terestriálne, alebo sa prenesú z "
"kópie na USB kľúči."

msgid "Această intrare se deschide numai din telecomandă."
msgstr "Táto položka sa otvára len z diaľkového ovládača."

msgid "Această pistă audio nu se aude în browser."
msgstr "Túto zvukovú stopu v prehliadači nepočuť."

msgid "Aceeași alegere este pe televizor, în __DRUM_MENIU__."
msgstr "Rovnaká voľba je na televízore, v __DRUM_MENIU__."

msgid "Aceeași listă este pe televizor, la tasta TIMER sau în __DRUM_MENIU__."
msgstr ""
"Rovnaký zoznam je na televízore, pod tlačidlom TIMER alebo v __DRUM_MENIU__."

msgid ""
"Aceeași probă e pe televizor, în __DRUM_MENIU__. Proba pornită din "
"telecomandă se vede și aici."
msgstr ""
"Rovnaký test je na televízore, v __DRUM_MENIU__. Test spustený z diaľkového "
"ovládača vidno aj tu."

msgid "Acel rând e o explicație și nu se poate alege."
msgstr "Ten riadok je iba vysvetlenie a nedá sa vybrať."

msgid "Acela e un titlu de grupă. Alege un rând de sub el."
msgstr "To je nadpis skupiny. Zvoľ riadok pod ním."

msgid ""
"Același SID pe același transponder, scris de două ori cu alt tip de serviciu."
msgstr ""
"Rovnaké SID na rovnakom transpondéri, zapísané dvakrát s iným typom služby."

msgid ""
"Același canal de două ori în același buchet. Același nume pe alt satelit nu "
"e dublură."
msgstr ""
"Ten istý kanál dvakrát v tom istom bukete. Rovnaký názov na inom satelite "
"nie je duplicita."

msgid "Același canal de două ori în listă"
msgstr "Ten istý kanál dvakrát v zozname"

msgid "Același canal, cu alt nume decât în copie."
msgstr "Ten istý kanál s iným názvom než v kópii."

msgid "Același ecran e pe televizor, în %s."
msgstr "Rovnaká obrazovka je na televízore, v %s."

msgid "Același ecran e pe televizor, în __DRUM_MENIU__."
msgstr "Rovnaká obrazovka je na televízore, v __DRUM_MENIU__."

msgid "Același ecran este pe televizor, în __DRUM_MENIU__."
msgstr "Rovnaká obrazovka je na televízore, v __DRUM_MENIU__."

msgid "Același forum e pe televizor: __DRUM_MENIU__, Forumul receptorului."
msgstr "To isté fórum je na televízore: __DRUM_MENIU__, Fórum prijímača."

msgid ""
"Același meniu ca la tasta MENU, cu aceleași intrări pentru nivelul ales pe "
"receptor. La fiecare intrare: pagina ei din interfața web, dacă are, pagina "
"de setări sau „Deschide pe televizor”."
msgstr ""
"Rovnaké menu ako pod tlačidlom MENU, s rovnakými položkami pre úroveň "
"zvolenú na prijímači. Pri každej položke: jej stránka vo webovom rozhraní, "
"ak ju má, stránka nastavení alebo „Otvoriť na televízore“."

msgid ""
"Același mesaj apare și în interfața web a receptorului, la pagina /paza-"
"model."
msgstr ""
"Rovnaká správa sa zobrazuje aj vo webovom rozhraní prijímača, na stránke /"
"paza-model."

#, python-format
msgid "Același mesaj apare și în interfața web a receptorului: %s"
msgstr "Rovnaká správa sa zobrazuje aj vo webovom rozhraní prijímača: %s"

msgid "Același nume pe aceeași poziție"
msgstr "Rovnaký názov na rovnakej pozícii"

msgid "Același program e pe televizor, în __DRUM_MENIU__."
msgstr "Rovnaký program je na televízore, v __DRUM_MENIU__."

msgid "Același rând e pe televizor, în"
msgstr "Rovnaký riadok je na televízore, v"

#, python-format
msgid "Același satelit e pe două porturi (%s). Schimbă întâi din Setări tuner."
msgstr ""
"Rovnaký satelit je na dvoch portoch (%s). Najprv to zmeň v Nastavení tunera."

msgid "Același utilitar e pe televizor, în __DRUM_MENIU__."
msgstr "Rovnaký nástroj je na televízore, v __DRUM_MENIU__."

msgid ""
"Același utilitar e pe televizor, în __DRUM_MENIU__. Cât ascultă pagina, "
"tastele merg și pe televizor, cel mult 2 minute, iar pe televizor apare un "
"anunț. Din standby adânc receptorul pornește numai cu telecomanda lui."
msgstr ""
"Rovnaký nástroj je na televízore, v __DRUM_MENIU__. Kým stránka počúva, "
"tlačidlá fungujú aj na televízore, najviac 2 minúty, a na televízore sa "
"objaví oznámenie. Z hlbokého pohotovostného režimu sa prijímač zapne len "
"svojím diaľkovým ovládačom."

msgid ""
"Același utilitar e pe televizor, în __DRUM_MENIU__. Placa Wi-Fi a "
"receptorului recepționează numai rețelele de 2,4 GHz. Căutarea e aceeași ca "
"la lista rețelelor Wi-Fi: nu trimite nimic altceva."
msgstr ""
"Rovnaký nástroj je na televízore, v __DRUM_MENIU__. Wi-Fi karta prijímača "
"prijíma len siete 2,4 GHz. Vyhľadávanie je rovnaké ako pri zozname Wi-Fi "
"sietí: neposiela nič iné."

msgid "Aceleași alegeri sunt și în interfața web, la pagina /mod-sigur."
msgstr "Rovnaké voľby sú aj vo webovom rozhraní, na stránke /mod-sigur."

#, python-format
msgid "Aceleași alegeri sunt și în interfața web: %s"
msgstr "Rovnaké voľby sú aj vo webovom rozhraní: %s"

msgid "Aceleași comenzi sunt pe televizor, în __DRUM_MENIU__."
msgstr "Rovnaké príkazy sú na televízore, v __DRUM_MENIU__."

msgid ""
"Aceleași culori sunt pe televizor, în __DRUM_MENIU__ › Culori pe roluri, "
"unde le alegi pe o grilă. Paleta, opacitatea panourilor și pagina tehnică se "
"aleg tot acolo."
msgstr ""
"Rovnaké farby sú na televízore, v __DRUM_MENIU__ › Farby podľa rolí, kde ich "
"vyberáš na mriežke. Paleta, nepriehľadnosť panelov a technická stránka sa "
"vyberajú tiež tam."

msgid "Aceleași ecrane sunt pe televizor, în __DRUM_MENIU__."
msgstr "Rovnaké obrazovky sú na televízore, v __DRUM_MENIU__."

msgid ""
"Aceleași ecrane sunt pe televizor, în __DRUM_MENIU__; tasta albastră arată "
"acolo textul brut."
msgstr ""
"Rovnaké obrazovky sú na televízore, v __DRUM_MENIU__; modré tlačidlo tam "
"zobrazí surový text."

msgid "Aceleași extensii și acțiuni sunt pe televizor, în __DRUM_MENIU__."
msgstr "Rovnaké rozšírenia a akcie sú na televízore, v __DRUM_MENIU__."

msgid "Aceleași filme ca în lista de filme de pe televizor."
msgstr "Rovnaké filmy ako v zozname filmov na televízore."

#, python-format
msgid "Aceleași lucruri sunt pe televizor, în %s."
msgstr "To isté je na televízore, v %s."

msgid "Aceleași lucruri sunt și în meniul receptorului, în %s."
msgstr "To isté je aj v ponuke prijímača, v %s."

#, python-format
msgid ""
"Aceleași reglaje sunt pe televizor, în %s. Luminozitatea, contrastul, "
"saturația și nuanța schimbă și meniurile. Ce se vede cu adevărat se judecă "
"pe televizor: capturile de ecran nu arată prelucrarea plăcii."
msgstr ""
"Rovnaké nastavenia sú na televízore, v %s. Jas, kontrast, sýtosť a odtieň "
"menia aj ponuky. Čo sa skutočne zobrazuje, posúď na televízore: snímky "
"obrazovky neukazujú spracovanie dosky."

msgid "Aceleași reglaje sunt pe televizor, în __DRUM_MENIU__."
msgstr "Rovnaké nastavenia sú na televízore, v __DRUM_MENIU__."

msgid ""
"Aceleași rezultate ca pe televizor, în Meniu, „Setări”, „Caută setări” (sau "
"tasta TEXT în orice meniu): meniurile și setările pe care le arată acum "
"receptorul. Literele mari și diacriticele nu contează. La fiecare rezultat: "
"pagina lui din interfața web, dacă are, sau „Deschide pe televizor”, cu "
"rândul găsit deja ales."
msgstr ""
"Rovnaké výsledky ako na televízore, v Menu, „Nastavenia“, „Hľadať "
"nastavenia“ (alebo tlačidlo TEXT v ktoromkoľvek menu): menu a nastavenia, "
"ktoré prijímač práve zobrazuje. Veľké písmená a diakritika nehrajú rolu. Pri "
"každom výsledku: jeho stránka vo webovom rozhraní, ak ju má, alebo „Otvoriť "
"na televízore“, s už vybraným nájdeným riadkom."

msgid ""
"Aceleași rânduri, cu aceleași alegeri, sunt pe televizor în ecranul cu "
"același nume. Rândurile care se văd depind de „__NIVEL__”, ales pe televizor "
"în __DRUM_MENIU__. Setările fără listă de alegeri se schimbă de pe televizor."
msgstr ""
"Rovnaké riadky, s rovnakými voľbami, sú na televízore na obrazovke s "
"rovnakým názvom. Ktoré riadky vidno, závisí od „__NIVEL__“, zvoleného na "
"televízore v __DRUM_MENIU__. Nastavenia bez zoznamu volieb sa menia z "
"televízora."

#, python-format
msgid "Aceleași setări sunt pe televizor, în %s."
msgstr "Rovnaké nastavenia sú na televízore, v %s."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__ (cu nivelul de meniu "
"Expert). Locul unde ai rămas se ține minte lângă film, în fișierul cu "
"același nume și terminația .cuts, numai după primul minut și dacă stick-ul "
"sau discul se poate scrie."
msgstr ""
"Rovnaké nastavenia sú na televízore, v __DRUM_MENIU__ (s úrovňou menu "
"Expert). Miesto, kde si skončil, sa pamätá vedľa filmu, v súbore s rovnakým "
"názvom a príponou .cuts, až po prvej minúte a ak sa dá na USB kľúč alebo "
"disk zapisovať."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__ (tasta albastră). "
"Miniaturile le face browserul din poze; din pagină se văd numai stick-urile "
"și discurile, nu memoria internă a receptorului."
msgstr ""
"Rovnaké nastavenia sú na televízore, v __DRUM_MENIU__ (modré tlačidlo). "
"Miniatúry vytvára prehliadač z fotiek; zo stránky vidno len USB kľúče a "
"disky, nie vnútornú pamäť prijímača."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__ (în meniul playerului, "
"tasta Menu), unde sunt și aceleași comenzi. Din pagină se văd numai stick-"
"urile și discurile, nu memoria internă a receptorului."
msgstr ""
"Rovnaké nastavenia sú na televízore, v __DRUM_MENIU__ (v menu prehrávača, "
"tlačidlo Menu), kde sú aj rovnaké príkazy. Zo stránky vidno len USB kľúče a "
"disky, nie vnútornú pamäť prijímača."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__, și cu OK ținut apăsat "
"pe ecranul radio."
msgstr ""
"Rovnaké nastavenia sú na televízore, v __DRUM_MENIU__, a tiež podržaním OK "
"na obrazovke rádia."

msgid "Aceleași setări sunt pe televizor, în __DRUM_MENIU__."
msgstr "Rovnaké nastavenia sú na televízore, v __DRUM_MENIU__."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Redarea folosește "
"biblioteca mpegts.js (Apache-2.0), venită cu imaginea: <a href=\"/tv/mpegts-"
"licenta.txt\">licența</a>. Canalele cu imagine MPEG-2 și sunetul AC-3 (unde "
"browserul nu îl redă singur) se decodează în browser, pe procesorul "
"calculatorului, cu decodorul FFmpeg (LGPL-2.1) venit tot cu imaginea: <a "
"href=\"/tv/tv-wasm/ffmpeg-licenta.txt\">licența și sursa</a>; toate "
"licențele sunt în <a href=\"/licente\">Licențe</a>."
msgstr ""
"Rovnaké nastavenia sú na televízore, v __DRUM_MENIU__. Prehrávanie používa "
"knižnicu mpegts.js (Apache-2.0), dodanú s image: <a href=\"/tv/mpegts-"
"licenta.txt\">licencia</a>. Kanály s obrazom MPEG-2 a zvukom AC-3 (ktorý "
"prehliadač sám neprehrá) sa dekódujú v prehliadači, na procesore počítača, "
"dekodérom FFmpeg (LGPL-2.1), dodaným tiež s image: <a href=\"/tv/tv-wasm/"
"ffmpeg-licenta.txt\">licencia a zdrojový kód</a>; všetky licencie sú v <a "
"href=\"/licente\">Licencie</a>."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Serverele DNS au "
"pagina lor: <a href=\"/dns\" id=\"legaturaDns\">Servere DNS</a>."
msgstr ""
"Rovnaké nastavenia sú na televízore, v __DRUM_MENIU__. DNS servery majú "
"vlastnú stránku: <a href=\"/dns\" id=\"legaturaDns\">DNS servery</a>."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Tema și culorile "
"paginilor web sunt în pagina Setări."
msgstr ""
"Rovnaké nastavenia sú na televízore, v __DRUM_MENIU__. Téma a farby webových "
"stránok sú na stránke Nastavenia."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Întârzierea pistei e "
"și în ecranul tastei AUDIO."
msgstr ""
"Rovnaké nastavenia sú na televízore, v __DRUM_MENIU__. Oneskorenie stopy je "
"aj na obrazovke tlačidla AUDIO."

msgid ""
"Aceleași setări sunt pe televizor, în „Fluxuri și setări”, pe tasta MENU."
msgstr ""
"Rovnaké nastavenia sú na televízore, v „Toky a nastavenia“, na tlačidle MENU."

msgid ""
"Acest browser nu poate decoda imaginea HEVC (H.265) a acestui canal, de "
"pildă 4K pe 10 biți. Deschide-l într-un player din casă cu playlistul de mai "
"jos."
msgstr ""
"Tento prehliadač nedokáže dekódovať obraz HEVC (H.265) tohto kanála, "
"napríklad 4K s 10 bitmi. Otvor ho v prehrávači v domácnosti pomocou "
"playlistu nižšie."

msgid ""
"Acest browser nu poate decoda imaginea HEVC (H.265) a acestui canal, de "
"pildă 4K pe 10 biți. Încearcă alt browser sau un player din casă."
msgstr ""
"Tento prehliadač nedokáže dekódovať obraz HEVC (H.265) tohto kanála, "
"napríklad 4K s 10 bitmi. Skús iný prehliadač alebo prehrávač v domácnosti."

msgid ""
"Acest browser nu poate reda fluxul (îi lipsește MediaSource). Încearcă "
"Chrome, Edge, Firefox sau Safari nou."
msgstr ""
"Tento prehliadač nedokáže prehrať stream (chýba mu MediaSource). Skús novší "
"Chrome, Edge, Firefox alebo Safari."

msgid ""
"Acest browser rămâne conectat. Scripturile care folosesc cheia veche nu mai "
"merg până primesc cheia nouă."
msgstr ""
"Tento prehliadač zostane pripojený. Skripty, ktoré používajú starý kľúč, "
"nebudú fungovať, kým nedostanú nový."

msgid "Acest browser:"
msgstr "Prehliadač:"

msgid "Acest canal nu poate fi pus pe pauză."
msgstr "Tento kanál nemožno pozastaviť."

msgid "Acest canal nu poate fi înregistrat."
msgstr "Tento kanál sa nedá nahrávať."

msgid ""
"Acest canal trimite imaginea în HEVC, iar acest browser nu o poate reda. "
"Încearcă Chrome sau Edge pe un calculator cu placă video nouă, sau Safari."
msgstr ""
"Tento kanál posiela obraz v HEVC a tento prehliadač ho nedokáže prehrať. "
"Skús Chrome alebo Edge na počítači s novou grafickou kartou alebo Safari."

msgid ""
"Acest canal trimite imaginea în MPEG-2, iar acest browser nu o poate reda "
"(îi lipsește WebAssembly sau WebGL). Încearcă Chrome, Edge, Firefox sau "
"Safari nou."
msgstr ""
"Tento kanál posiela obraz v MPEG-2 a tento prehliadač ho nedokáže prehrať "
"(chýba mu WebAssembly alebo WebGL). Skús nový Chrome, Edge, Firefox alebo "
"Safari."

msgid ""
"Acest canal trimite imaginea într-un format pe care browserele nu îl redau."
msgstr "Tento kanál posiela obraz vo formáte, ktorý prehliadače neprehrávajú."

#, python-format
msgid ""
"Acest ecran nu are marcaje: serviciul curent nu suportă tăieri (de exemplu, "
"televiziune live)."
msgstr ""
"Táto obrazovka nemá značky: aktuálna služba nepodporuje strihy (napríklad "
"živé vysielanie)."

msgid "Acest ecran nu are poză mică de previzualizare."
msgstr "Táto obrazovka nemá malý náhľad."

msgid "Acest ecran se folosește pe televizor."
