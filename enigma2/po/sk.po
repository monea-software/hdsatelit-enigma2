msgid ""
"Pe televizor apare apoi aceeași întrebare: se face numai după ce răspunzi Da "
"acolo sau, la o înregistrare, singur, după ce se termină."
msgstr ""
"Na televízore sa potom zobrazí rovnaká otázka: vykoná sa až po odpovedi Áno "
"tam alebo, pri nahrávaní, samo po jeho skončení."

msgid ""
"Pe televizor așteaptă deja o întrebare de oprire sau de repornire. Răspunde "
"acolo."
msgstr "Na televízore už čaká otázka o vypnutí alebo reštarte. Odpovedz tam."

msgid "Pe televizor așteaptă deja o întrebare."
msgstr "Na televízore už čaká otázka."

msgid "Pe televizor e ales un câmp de parolă: textul nu se vede pe ecran."
msgstr ""
"Na televízore je vybrané pole pre heslo: text sa na obrazovke nezobrazí."

msgid ""
"Pe televizor e deschis alt ecran. Închide-l, apoi pornește din nou filmul."
msgstr ""
"Na televízore je otvorená iná obrazovka. Zavri ju a potom znova spusti film."

msgid "Pe televizor e deschis alt ecran. Închide-l, apoi încearcă din nou."
msgstr ""
"Na televízore je otvorená iná obrazovka. Zavri ju a potom to skús znova."

msgid ""
"Pe televizor e deschis ecranul Calitatea imaginii. Închide-l, apoi încearcă "
"din nou."
msgstr ""
"Na televízore je otvorená obrazovka Kvalita obrazu. Zavri ju a skús to znova."

msgid ""
"Pe televizor e deschis ecranul Video sau asistentul de pornire. Închide-l, "
"apoi încearcă din nou."
msgstr ""
"Na televízore je otvorená obrazovka Video alebo sprievodca prvým spustením. "
"Zavri ho a potom to skús znova."

#, python-format
msgid "Pe televizor e deschis ecranul „%s”. Închide-l, apoi încearcă din nou."
msgstr "Na televízore je otvorená obrazovka „%s“. Zavri ju a skús to znova."

msgid ""
"Pe televizor e deschis rezultatul scanării DAB+ sau DVB-T2. Alege acolo sau "
"în pagină ce pornești sau întoarce-te la canalul tău, apoi pornește căutarea "
"nouă."
msgstr ""
"Na televízore je otvorený výsledok vyhľadávania DAB+ alebo DVB-T2. Vyber tam "
"alebo na stránke, čo spustíš, alebo sa vráť na svoj kanál, potom spusti nové "
"vyhľadávanie."

msgid ""
"Pe televizor e deschis un ecran cu setările sunetului. Închide-l, apoi "
"încearcă din nou."
msgstr ""
"Na televízore je otvorená obrazovka s nastaveniami zvuku. Zavri ju a potom "
"to skús znova."

msgid ""
"Pe televizor e deschis un mesaj peste probă. Închide-l cu OK, apoi încearcă "
"din nou."
msgstr ""
"Na televízore je cez test otvorená správa. Zavri ju tlačidlom OK a potom "
"skús znova."

msgid ""
"Pe televizor e deschisă altă fereastră peste căutare. Închide-o întâi (tasta "
"Exit), apoi încearcă din nou."
msgstr ""
"Na televízore je cez vyhľadávanie otvorené iné okno. Najprv ho zavri "
"(tlačidlo Exit), potom to skús znova."

msgid ""
"Pe televizor e deschisă altă fereastră peste scanare. Închide-o întâi (tasta "
"EXIT), apoi încearcă din nou."
msgstr ""
"Na televízore je cez vyhľadávanie kanálov otvorené iné okno. Najprv ho zavri "
"(tlačidlo EXIT), potom to skús znova."

msgid "Pe televizor e deschisă interfața camului. Închide-o întâi."
msgstr "Na televízore je otvorené rozhranie CAM. Najprv ho zatvor."

msgid "Pe televizor e deschisă interfața web a modulului. Închide-o întâi."
msgstr "Na televízore je otvorené webové rozhranie modulu. Najprv ho zavri."

msgid "Pe televizor e deschisă o fereastră peste navigator."
msgstr "Na televízore je nad prehliadačom otvorené okno."

msgid ""
"Pe televizor e încă deschis rezultatul căutării de dinainte. Închide-l "
"(butonul din pagină sau tasta Exit), apoi pornește căutarea nouă."
msgstr ""
"Na televízore je stále otvorený výsledok predchádzajúceho vyhľadávania. "
"Zavri ho (tlačidlo na stránke alebo tlačidlo Exit), potom spusti nové "
"vyhľadávanie."

msgid "Pe televizor este deschis alt ecran. Închide-l și încearcă încă o dată."
msgstr "Na televízore je otvorená iná obrazovka. Zavri ju a skús to znova."

msgid "Pe televizor merge acum ceva ce nu se poate transmite în browser."
msgstr "Na televízore teraz hrá niečo, čo nemožno preniesť do prehliadača."

msgid "Pe televizor nu e deschis niciun câmp de text."
msgstr "Na televízore nie je otvorené žiadne textové pole."

msgid "Pe televizor nu merge acum niciun canal."
msgstr "Na televízore teraz nehrá žiadny kanál."

msgid "Pe televizor nu se arată nicio poză."
msgstr "Na televízore sa nezobrazuje žiadny obrázok."

msgid ""
"Pe televizor nu se arată nicio poză. Alege o poză mai jos și apasă Arată pe "
"televizor."
msgstr ""
"Na televízore sa nezobrazuje žiadna fotografia. Vyber nižšie fotografiu a "
"stlač Zobraziť na televízore."

msgid ""
"Pe televizor poți alege și direct o emisiune din ghidul TV: acolo marginile "
"de dinainte și de după se pun singure."
msgstr ""
"Na televízore si môžeš vybrať reláciu aj priamo z televízneho programu: tam "
"sa okraje pred a po nastavia samy."

msgid ""
"Pe televizor s-a deschis Asistența de la distanță: citește și apasă Verde "
"acolo."
msgstr ""
"Na televízore sa otvorila Vzdialená pomoc: prečítaj si text a stlač tam "
"Zelené."

msgid ""
"Pe televizor se cere o confirmare: o înregistrare e în curs sau începe "
"curând, sau lucrează ceva în fundal. Se face numai dacă răspunzi Da acolo."
msgstr ""
"Televízor žiada potvrdenie: prebieha nahrávanie alebo čoskoro začne, alebo "
"niečo beží na pozadí. Vykoná sa len vtedy, ak tam odpovieš Áno."

msgid ""
"Pe televizor se cere o confirmare: o înregistrare e în curs sau începe "
"curând. Alegerea se face numai dacă răspunzi Da acolo."
msgstr ""
"Na televízore sa žiada potvrdenie: prebieha nahrávanie alebo sa čoskoro "
"začne. Voľba sa vykoná len ak tam odpovieš Áno."

msgid ""
"Pe televizor se cere o confirmare: o înregistrare e în curs sau începe "
"curând. Repornirea se face numai dacă răspunzi Da acolo."
msgstr ""
"Televízor žiada potvrdenie: prebieha nahrávanie alebo čoskoro začne. Reštart "
"sa vykoná len vtedy, ak tam odpovieš Áno."

msgid ""
"Pe televizor se deschide ecranul probei. Îl închizi de acolo cu EXIT sau din "
"pagină."
msgstr ""
"Na televízore sa otvorí obrazovka testu. Zavrieš ju tam tlačidlom EXIT alebo "
"zo stránky."

msgid ""
"Pe televizor, același mesaj apare singur la pornire, în modul sigur, și din "
"Meniu > Informații despre sistem > Mod sigur."
msgstr ""
"Na televízore sa rovnaká správa zobrazí sama pri spustení v núdzovom režime "
"a tiež z Menu > Informácie o systéme > Núdzový režim."

msgid ""
"Pe televizor, asta se poate numai cu nivelul de meniu Intermediar sau Expert."
msgstr "Na televízore je to možné len s úrovňou ponuky Stredná alebo Expert."

msgid ""
"Pe televizor, ecranul diagnosticului apare singur numai când pornirea nu "
"reușește; altfel se deschide din MENU > Informații despre sistem > "
"Diagnosticul pornirii."
msgstr ""
"Na televízore sa obrazovka diagnostiky objaví sama, len keď sa spustenie "
"nepodarí; inak ju otvoríš z MENU > Informácie o systéme > Diagnostika "
"spúšťania."

msgid ""
"Pe televizor, pe ecranul radio: tasta galbenă trece la altă vizualizare, "
"tasta albastră la alte culori. Alegerea se ține minte."
msgstr ""
"Na televízore, na rozhlasovej obrazovke: žlté tlačidlo prepne na inú "
"vizualizáciu, modré na iné farby. Voľba sa zapamätá."

msgid ""
"Pe televizor, pe ecranul radio: tasta galbenă trece la altă vizualizare, "
"tasta albastră la alte culori. Alegerea se ține minte. Tasta verde deschide "
"egalizatorul."
msgstr ""
"Na televízore, na obrazovke rádia: žlté tlačidlo prepne na iné zobrazenie, "
"modré tlačidlo na iné farby. Voľba sa zapamätá. Zelené tlačidlo otvorí "
"ekvalizér."

msgid ""
"Pe televizor, setările playerului apar numai cu nivelul de meniu Intermediar "
"sau Expert."
msgstr ""
"Na televízore sa nastavenia prehrávača zobrazia len pri úrovni ponuky "
"Stredne pokročilý alebo Expert."

msgid "Pe televizor:"
msgstr "Na televízore:"

#, python-format
msgid "Pe televizor: %s. Mai sunt %s s până revine ieșirea de dinainte."
msgstr "Na televízore: %s. Zostáva %s s, kým sa vráti predchádzajúci výstup."

msgid ""
"Pe televizor: <span id=\"drumDab\">__DRUM_DAB__</span><span "
"id=\"drumT2\">__DRUM_T2__</span> &gt; Fluxuri și setări."
msgstr ""
"Na televízore: <span id=\"drumDab\">__DRUM_DAB__</span><span "
"id=\"drumT2\">__DRUM_T2__</span> &gt; Toky a nastavenia."

msgid "Pe televizor: Meniu, Setări, Software &amp; Firmware, Copia setărilor."
msgstr ""
"Na televízore: Ponuka, Nastavenia, Software &amp; Firmware, Kópia nastavení."

msgid ""
"Pe televizor: apasă OK de două ori pe un canal; prima pagină a barei este "
"ghidul canalului."
msgstr ""
"Na televízore: stlač dvakrát OK na kanáli; prvá stránka lišty je sprievodca "
"kanála."

msgid ""
"Pe televizor: pe alt receptor, mesajul de mai sus apare singur, în locul "
"interfeței."
msgstr ""
"Na televízore: na inom prijímači sa správa vyššie zobrazí sama, namiesto "
"rozhrania."

msgid ""
"Pe televizor: tasta SUB în timpul filmului. Setările implicite sunt în "
"__DRUM_MENIU__."
msgstr ""
"Na televízore: tlačidlo SUB počas filmu. Predvolené nastavenia sú v "
"__DRUM_MENIU__."

msgid "Pe televizor: tasta TEXT."
msgstr "Na televízore: tlačidlo TEXT."

#, python-format
msgid ""
"Pe televizor: în dreapta cu reglajul, în stânga fără. Se oprește singură "
"după %d de secunde."
msgstr ""
"Na televízore: vpravo s nastavením, vľavo bez. Samo sa vypne po %d sekundách."

msgid "Pe transpondere"
msgstr "Podľa transpondérov"

#, python-format
msgid ""
"Pe tunerul %s nu e legat niciun satelit. Alege sateliții din Setări tuner."
msgstr ""
"K tuneru %s nie je pripojený žiadny satelit. Vyber satelity v Nastavení "
"tunera."

msgid ""
"Pe un calculator din casă instalează Docker Desktop (docs.docker.com) și "
"pornește-l."
msgstr ""
"Na domácom počítači nainštaluj Docker Desktop (docs.docker.com) a spusti ho."

msgid ""
"Pe un calculator din casă rulează LibreTranslate sau Ollama. Receptorul îl "
"caută în rețeaua de acasă, alege singur modelul și face proba."
msgstr ""
"Na počítači doma beží LibreTranslate alebo Ollama. Prijímač ho vyhľadá v "
"domácej sieti, sám vyberie model a vykoná test."

msgid "Pe un canal cu subcanale, VERDE scurt arată întâi lista lor."
msgstr ""
"Na kanáli s podkanálmi krátke stlačenie ZELENÉHO najprv zobrazí ich zoznam."

msgid "Pe „%s” lipsește dosarul %s, în care se salvează timeshift-ul."
msgstr "Na „%s“ chýba priečinok %s, do ktorého sa ukladá timeshift."

msgid "Pe „%s” lipsește dosarul %s, în care se salvează înregistrările."
msgstr "Na „%s“ chýba priečinok %s, do ktorého sa ukladajú nahrávky."

msgid "Peisaje"
msgstr "Krajiny"

#, python-format
msgid "Pentru %s lipsește: %s."
msgstr "Pre %s chýba: %s."

msgid ""
"Pentru Cloudflare Workers scrie și ID-ul contului (32 de litere și cifre, de "
"la „Account ID”). Cheia nu a plecat nicăieri."
msgstr ""
"Pre Cloudflare Workers napíš aj ID účtu (32 písmen a číslic, z „Account "
"ID”). Kľúč nikam neodišiel."

msgid "Pentru Gemini lipsește cheia. Pune întâi cheia."
msgstr "Pri Gemini chýba kľúč. Najprv zadaj kľúč."

msgid "Pentru Python 3 există %s, în feedul %s."
msgstr "Pre Python 3 existuje %s, vo feede %s."

msgid "Pentru SubDL scrie în setări cheia ta API (din panoul contului SubDL)."
msgstr "Pre SubDL zadaj v nastaveniach svoj kľúč API (z panela účtu SubDL)."

msgid ""
"Pentru Uniunea Europeană, Google spune că nici la nivelul gratuit nu "
"folosește textele trimise ca să-și îmbunătățească produsele."
msgstr ""
"Pre Európsku úniu Google uvádza, že ani v bezplatnom režime nepoužíva "
"odoslané texty na zlepšovanie svojich produktov."

msgid ""
"Pentru a face loc pe disc fără să pierzi setările, folosește curățenia "
"discului. Același ecran e pe televizor, în __DRUM_MENIU__."
msgstr ""
"Ak chceš uvoľniť miesto na disku bez straty nastavení, použi čistenie disku. "
"Rovnaká obrazovka je na televízore, v __DRUM_MENIU__."

msgid "Pentru această actualizare trebuie pusă imaginea nouă."
msgstr "Pre túto aktualizáciu treba nainštalovať nový image."

msgid "Pentru acest post"
msgstr "Pre túto stanicu"

msgid "Pentru acest post (nu merge niciun post)"
msgstr "Pre túto stanicu (nefunguje žiadna stanica)"

msgid ""
"Pentru aceste limbi ai ales să nu te mai întreb când apare o subtitrare fără "
"model:"
msgstr ""
"Pre tieto jazyky si si zvolil, aby som sa už nepýtal, keď sa objavia titulky "
"bez modelu:"

msgid "Pentru daltonism"
msgstr "Pre farboslepých"

msgid ""
"Pentru descărcări de pe OpenSubtitles scrie în setări contul tău (gratuit)."
msgstr ""
"Pre sťahovanie z OpenSubtitles zadaj v nastaveniach svoj (bezplatný) účet."

msgid ""
"Pentru fișierele de subtitrare care nu sunt UTF-8 și pentru textul din "
"filmele MKV scris altfel. Europa Centrală citește corect fișierele românești "
"vechi. La pistele din film se aplică de la filmul următor."
msgstr ""
"Pre súbory titulkov, ktoré nie sú v UTF-8, a pre text vo filmoch MKV "
"zapísaný inak. Stredná Európa správne číta staré rumunské súbory. Pri "
"stopách vo filme platí od nasledujúceho filmu."

msgid ""
"Pentru limbile acestea ai ales „Nu mai întreba pentru limba asta”. OK: te "
"întreb din nou când apare o subtitrare în ele."
msgstr ""
"Pre tieto jazyky si zvolil „Už sa pre tento jazyk nepýtať“. OK: opýtam sa "
"znova, keď sa v nich objavia titulky."

msgid ""
"Pentru o bară de sunet legată la ieșirea optică a receptorului alege Manual "
"și pune Downmix AC3 pe Nu. Schimbarea se aude sigur de la următorul canal."
msgstr ""
"Pre soundbar pripojený k optickému výstupu prijímača vyber Ručne a nastav "
"Downmix AC3 na Nie. Zmenu bude určite počuť od ďalšieho kanála."

msgid "Pentru pasionați."
msgstr "Pre nadšencov."

msgid "Pentru probe și potriviri"
msgstr "Na testy a doladenie"

msgid "Pentru programatori"
msgstr "Pre programátorov"

#, python-format
msgid ""
"Pentru recuperare, Maintenance Mode caută imaginea pe stick în dosarul %s."
msgstr "Na obnovu hľadá Maintenance Mode image na kľúči v priečinku %s."

msgid ""
"Pentru satelitul ales nu există niciun transponder în lista de sateliți, "
"deci receptorul nu are ce acorda."
msgstr ""
"Pre zvolený satelit nie je v zozname satelitov žiadny transpondér, takže "
"prijímač nemá čo naladiť."

msgid "Pentru serverul compatibil OpenAI lipsește adresa. Pune întâi adresa."
msgstr "Pri serveri kompatibilnom s OpenAI chýba adresa. Najprv zadaj adresu."

msgid ""
"Pentru subs.ro scrie în setări cheia ta API (din profilul de pe subs.ro)."
msgstr "Pre subs.ro zadaj v nastaveniach svoj kľúč API (z profilu na subs.ro)."

msgid ""
"Pentru subtitrări multe (filme întregi, zilnic) e recomandat Azure "
"Translator, planul Free F0: 2 milioane de caractere pe lună; cardul se cere "
"numai la înscriere, iar pe F0 nu se plătește nimic. Gemini e gratuit pentru "
"folosire ocazională, dar la subtitrări continue poate da „prea multe cereri” "
"după câteva minute."
msgstr ""
"Pre veľa titulkov (celé filmy, denne) sa odporúča Azure Translator, plán "
"Free F0: 2 milióny znakov mesačne; karta sa vyžaduje len pri registrácii a "
"na F0 sa nič neplatí. Gemini je zadarmo na občasné použitie, ale pri "
"nepretržitých titulkoch môže po niekoľkých minútach hlásiť „príliš veľa "
"požiadaviek“."

msgid ""
"Pentru subtitrări multe (filme întregi, în fiecare zi) pune în setări și "
"servicii de rezervă, de exemplu Azure Translator: când Gemini dă eroarea "
"429, receptorul trece singur la următorul. Lista se face din servicii "
"diferite: limita Gemini e pe proiect, iar mai multe conturi făcute ca să "
"aduni limitele gratuite înseamnă ocolirea limitelor, pe care termenii Google "
"o interzic."
msgstr ""
"Pre veľa titulkov (celé filmy, každý deň) pridaj do nastavení aj záložné "
"služby, napríklad Azure Translator: keď Gemini vráti chybu 429, prijímač sám "
"prejde na ďalšiu. Zoznam sa tvorí z rôznych služieb: limit Gemini je na "
"projekt a viacero účtov vytvorených na sčítanie bezplatných limitov znamená "
"obchádzanie limitov, čo podmienky Google zakazujú."

msgid ""
"Pentru subtitrări multe pune în setări și servicii de rezervă, de exemplu "
"Azure Translator: când Groq dă eroarea 429, receptorul trece singur la "
"următorul."
msgstr ""
"Pre veľa titulkov nastav v nastaveniach aj záložné služby, napríklad Azure "
"Translator: keď Groq vráti chybu 429, prijímač sám prejde na ďalšiu."

msgid "Pentru timeshift:"
msgstr "Pre timeshift:"

msgid ""
"Pentru un canal de satelit, pornește întâi pe televizor un canal de pe "
"același satelit. Antena nu se rotește din browser."
msgstr ""
"Pri satelitnom kanáli najprv spusti na televízore kanál z toho istého "
"satelitu. Anténa sa z prehliadača neotáča."

msgid ""
"Pentru un server din casă scrie întâi adresa lui (pasul cu adresa "
"serverului)."
msgstr ""
"Pre server u teba doma najprv napíš jeho adresu (krok s adresou servera)."

#, python-format
msgid "Pentru întrebări: %s"
msgstr "S otázkami: %s"

msgid "Performanță"
msgstr "Výkon"

msgid "Permite transmisia în browser"
msgstr "Povoliť prenos do prehliadača"

msgid "Permite transmisia în standby"
msgstr "Povoliť prenos v pohotovostnom režime"

msgid "Persian"
msgstr "Perzština"

msgid "Persian (Farsi)"
msgstr "Perzština (farsí)"

msgid "Personaj"
msgstr "Postavička"

#, python-format
msgid "Personajul (%s)"
msgstr "Postavička (%s)"

msgid "Personajul pe afișaj"
msgstr "Postavička na displeji"

msgid "Personalizat"
msgstr "Vlastný"

msgid "Personalizat (Custom)"
msgstr "Vlastné (Custom)"

#, python-format
msgid ""
"Peste %d minute pornește o înregistrare. Comenzile se opresc atunci singure."
msgstr "O %d min sa začne nahrávanie. Príkazy sa potom samy zastavia."

msgid ""
"Peste această frecvență, receptorul folosește oscilatorul de sus și pornește "
"tonul de 22 kHz."
msgstr ""
"Nad touto frekvenciou prijímač používa horný oscilátor a zapína tón 22 kHz."

msgid ""
"Peste cotă se plătește automat (20 de dolari pe milion de caractere), dacă "
"nu ai coborât cota pe zi. Cu cota coborâtă, traducerea se oprește până a "
"doua zi."
msgstr ""
"Nad kvótu sa platí automaticky (20 dolárov za milión znakov), ak si neznížil "
"dennú kvótu. So zníženou kvótou sa preklad zastaví do ďalšieho dňa."

msgid ""
"Peste limita pe minut, cererile primesc eroarea 429 câteva secunde: "
"receptorul așteaptă cât spune Google și trece între timp la serviciul de "
"rezervă, dacă ai pus unul. Peste limita pe zi, până a doua zi (în jurul orei "
"10, ora României). Fără card nu se plătește nimic."
msgstr ""
"Nad limit za minútu dostávajú požiadavky na niekoľko sekúnd chybu 429: "
"prijímač čaká tak dlho, ako hovorí Google, a medzitým prejde na záložnú "
"službu, ak si ju nastavil. Nad denný limit až do ďalšieho dňa (okolo 10. "
"hodiny rumunského času). Bez karty sa nič neplatí."

msgid ""
