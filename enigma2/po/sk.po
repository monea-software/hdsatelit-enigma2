"descărcate."
msgstr ""
"Zoznam je pripravený. Žlté = hľadať, Zelené = stiahnuť, Modré = stiahnuté "
"fonty."

msgid "Lista e goală"
msgstr "Zoznam je prázdny"

msgid "Lista e goală."
msgstr "Zoznam je prázdny."

msgid ""
"Lista e goală. Actualizează lista de pe hdsatelit.com sau adaugă un flux de "
"mână."
msgstr ""
"Zoznam je prázdny. Aktualizuj zoznam z hdsatelit.com alebo pridaj stream "
"ručne."

msgid "Lista e goală: afișajul arată ora."
msgstr "Zoznam je prázdny: displej ukazuje čas."

msgid "Lista e goală: fișierul cu frecvențe lipsește de pe receptor."
msgstr "Zoznam je prázdny: na prijímači chýba súbor s frekvenciami."

msgid ""
"Lista e scrisă și citită din nou, ca la salvare. Când grupa e goală, lista "
"se scrie exact cum o vezi."
msgstr ""
"Zoznam sa zapíše a znovu načíta, ako pri ukladaní. Keď je skupina prázdna, "
"zoznam sa zapíše presne tak, ako ho vidíš."

msgid "Lista e în ordine."
msgstr "Zoznam je v poriadku."

msgid "Lista extensiilor s-a schimbat. Reîncarcă pagina."
msgstr "Zoznam rozšírení sa zmenil. Načítaj stránku znova."

msgid "Lista extensiilor și dacă acest canal are HbbTV"
msgstr "Zoznam rozšírení a či tento kanál má HbbTV"

msgid "Lista fluxurilor, adăugarea de mână și setările:"
msgstr "Zoznam streamov, ručné pridávanie a nastavenia:"

msgid "Lista inițială de sateliți/cablu/terestru (transpondere) provine din"
msgstr "Zoznam satelitov/kábla/pozemného vysielania (transp.) pochádza z"

msgid "Lista licențelor din această imagine nu se poate citi."
msgstr "Zoznam licencií v tomto image sa nedá prečítať."

msgid "Lista licențelor lipsește din această imagine."
msgstr "V tomto image chýba zoznam licencií."

msgid "Lista modelelor nu are adresa de descărcare."
msgstr "Zoznam modelov nemá adresu na stiahnutie."

msgid ""
"Lista neagră: bifat înseamnă că cere PIN. Lista se salvează pe receptor la "
"fiecare bifă."
msgstr ""
"Čierna listina: zaškrtnuté znamená, že vyžaduje PIN. Zoznam sa uloží do "
"prijímača pri každom zaškrtnutí."

msgid ""
"Lista neagră: cer PIN numai canalele din listă. Lista albă: cer PIN toate "
"canalele, în afară de cele din listă."
msgstr ""
"Čierna listina: PIN vyžadujú len kanály zo zoznamu. Biela listina: PIN "
"vyžadujú všetky kanály okrem tých zo zoznamu."

msgid "Lista nedescărcată"
msgstr "Zoznam nestiahnutý"

msgid ""
"Lista nouă a sateliților nu a ieșit bine, așa că nu s-a scris. Fișierul "
"vechi a rămas cum era."
msgstr ""
"Nový zoznam satelitov nevyšiel správne, preto sa nezapísal. Starý súbor "
"zostal bez zmeny."

msgid "Lista nu a fost descărcată"
msgstr "Zoznam nebol stiahnutý"

msgid "Lista nu are niciun canal."
msgstr "Zoznam neobsahuje žiadny kanál."

msgid "Lista nu s-a putut citi."
msgstr "Zoznam sa nepodarilo prečítať."

#, python-format
msgid "Lista nu s-a putut citi: %s"
msgstr "Zoznam sa nepodarilo prečítať: %s"

msgid "Lista nu s-a salvat. Schimbările au rămas aici: încearcă din nou."
msgstr "Zoznam sa neuložil. Zmeny tu zostali: skús to znova."

msgid "Lista nu s-a întors la copie. Lista de acum a rămas neatinsă."
msgstr "Zoznam sa nevrátil ku kópii. Aktuálny zoznam zostal nezmenený."

msgid "Lista nu se poate citi."
msgstr "Zoznam sa nedá prečítať."

#, python-format
msgid "Lista operatorului %s nu are nicio frecvență."
msgstr "Zoznam operátora %s nemá žiadnu frekvenciu."

msgid "Lista pachetelor"
msgstr "Zoznam balíčkov"

#, python-format
msgid "Lista pachetelor nu s-a putut citi: %s"
msgstr "Zoznam balíčkov sa nepodarilo prečítať: %s"

msgid "Lista pachetelor nu s-a putut descărca."
msgstr "Zoznam balíkov sa nepodarilo stiahnuť."

msgid "Lista pachetelor s-a descărcat."
msgstr "Zoznam balíčkov bol stiahnutý."

msgid ""
"Lista pachetelor și starea de pe server nu sunt din aceeași publicare. Caută "
"din nou."
msgstr ""
"Zoznam balíkov a stav na serveri nie sú z rovnakého zverejnenia. Hľadaj "
"znova."

msgid "Lista predefinită aleasă nu există."
msgstr "Vybraný prednastavený zoznam neexistuje."

msgid "Lista radio"
msgstr "Zoznam rádií"

msgid "Lista rezervelor are un serviciu necunoscut."
msgstr "Zoznam záloh obsahuje neznámu službu."

msgid "Lista rezervelor, în toate setările"
msgstr "Zoznam záloh vo všetkých nastaveniach"

msgid "Lista s-a schimbat între timp. Reîncarcă pagina."
msgstr "Zoznam sa medzitým zmenil. Znova načítaj stránku."

msgid "Lista s-a scris, dar nu s-a putut reîncărca. Repornește interfața."
msgstr ""
"Zoznam sa zapísal, ale nepodarilo sa ho znova načítať. Reštartuj rozhranie."

msgid "Lista s-a întors la copia aleasă."
msgstr "Zoznam sa vrátil k vybranej zálohe."

msgid "Lista salvată nu există."
msgstr "Uložený zoznam neexistuje."

msgid "Lista salvată s-a șters."
msgstr "Uložený zoznam bol odstránený."

msgid "Lista sateliților (%s) e goală sau nu are forma unui satellites.xml."
msgstr "Zoznam satelitov (%s) je prázdny alebo nemá tvar satellites.xml."

msgid "Lista sateliților (%s) nu se poate citi: e stricată pe rândul %d."
msgstr "Zoznam satelitov (%s) sa nedá prečítať: je poškodený na riadku %d."

msgid ""
"Lista sateliților nu s-a putut scrie (%s). Fișierul vechi a rămas cum era."
msgstr ""
"Zoznam satelitov sa nepodarilo zapísať (%s). Starý súbor zostal bez zmeny."

msgid ""
"Lista sateliților s-a schimbat între timp pe receptor. Deschide-o din nou, "
"ca să nu pierzi schimbările de acolo."
msgstr ""
"Zoznam satelitov sa medzitým zmenil na prijímači. Otvor ho znova, aby si "
"nestratil zmeny."

msgid "Lista se actualizează singură de pe internet, din oră în oră."
msgstr "Zoznam sa sám aktualizuje z internetu každú hodinu."

msgid ""
"Lista se completează când cauți din nou în Meniu > Scanare > Satelit > DAB+ "
"prin satelit."
msgstr ""
"Zoznam sa doplní, keď znova spustíš vyhľadávanie v Menu > Vyhľadávanie "
"kanálov > Satelit > DAB+ cez satelit."

msgid ""
"Lista se completează când cauți din nou în Meniu > Scanare > Satelit > DVB-"
"T2 prin satelit."
msgstr ""
"Zoznam sa doplní, keď znova spustíš vyhľadávanie v Menu > Vyhľadávanie "
"kanálov > Satelit > DVB-T2 cez satelit."

msgid "Lista se descarcă deja. Încearcă din nou peste un minut."
msgstr "Zoznam sa už sťahuje. Skús to znova o minútu."

msgid "Lista se poate folosi între timp."
msgstr "Zoznam možno medzitým používať."

msgid ""
"Lista serviciilor de rezervă nu e bună (un serviciu necunoscut, unul de două "
"ori sau chiar cel principal). Nu s-a schimbat nimic."
msgstr ""
"Zoznam záložných služieb nie je platný (neznáma služba, jedna dvakrát alebo "
"dokonca hlavná). Nič sa nezmenilo."

msgid "Lista setărilor s-a schimbat. Pagina se încarcă din nou."
msgstr "Zoznam nastavení sa zmenil. Stránka sa znova načíta."

msgid ""
"Lista skinurilor se citește deja. Încearcă din nou peste câteva secunde."
msgstr "Zoznam vzhľadov sa už načítava. Skús to znova o pár sekúnd."

msgid "Lista sursei %s este la zi"
msgstr "Zoznam zdroja %s je aktuálny"

msgid ""
"Lista surselor de pachete nu e descărcată încă: o descarci din Meniu, "
"Extensii și aplicații."
msgstr ""
"Zoznam zdrojov balíčkov ešte nie je stiahnutý: stiahneš ho z Ponuka, "
"Rozšírenia a aplikácie."

msgid "Lista tastelor"
msgstr "Zoznam tlačidiel"

msgid "Lista transponderelor s-a schimbat. Alege din nou."
msgstr "Zoznam transpondérov sa zmenil. Vyber znova."

msgid "Lista tunerelor nu se poate citi."
msgstr "Zoznam tunerov sa nedá prečítať."

msgid "Lista tuturor sateliților (include și Cablu/Terestru)"
msgstr "Zoznam všetkých satelitov (zahŕňa aj kábel/terestriál)"

msgid "Lista în ordinea numerelor: %s"
msgstr "Zoznam podľa čísel: %s"

