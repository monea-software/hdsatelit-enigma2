msgstr "Në kohë, në pritje (pa origjinal në ekran): %d."

msgid "OK: un cod QR pentru telefon. Pe telefon îți faci cheia și o lipești; receptorul o probează pe loc."
msgstr "OK: një kod QR për telefonin. Në telefon merr çelësin dhe ngjite; marrësi e provon menjëherë."

msgid "OK: alegi regiunea din listă. O găsești în portal, la resursa Translator: Overview › Location. Global pentru o resursă Global."
msgstr "OK: zgjidh rajonin nga lista. E gjen në portal, te resursi Translator: Overview › Location. Global për një resurs Global."

msgid "Când serviciul principal nu răspunde (prea multe cereri, cota terminată, cheie refuzată, prea lent), receptorul trece singur la următorul din listă, fără mesaj. Fiecare serviciu cu cheia lui. OK schimbă lista."
msgstr "Kur shërbimi kryesor nuk përgjigjet (shumë kërkesa, kuota e përfunduar, çelësi i refuzuar, tepër i ngadaltë), marrësi kalon vetë te tjetri në listë, pa mesazh. Çdo shërbim me çelësin e vet. OK ndryshon listën."

msgid "OK caută singur serverul din casă (LibreTranslate sau Ollama) și îl probează. Adresa se poate scrie și de mână, mai jos."
msgstr "OK kërkon vetë serverin në shtëpi (LibreTranslate ose Ollama) dhe e provon. Adresa mund të shkruhet edhe me dorë, më poshtë."

msgid "Chei și indici despărțiți prin punct, de exemplu translatedText sau data.0.text; * ia toate elementele, lipite în ordine. Albastru: exemplul."
msgstr "Çelësat dhe indeksat të ndarë me pikë, për shembull translatedText ose data.0.text; * merr të gjitha elementet, të bashkuara në rend. Blu: shembulli."

#, python-brace-format
msgid "Locurile {text}, {sursa} și {tinta} se înlocuiesc la fiecare cerere. Albastru: exemplul. Se scrie mai ușor din pagina web."
msgstr "Vendet {text}, {sursa} dhe {tinta} zëvendësohen në çdo kërkesë. Blu: shembulli. Shkruhet më lehtë nga faqja ueb."

msgid "Global"
msgstr "Global"

msgid "Regiunea resursei Azure: o găsești în portal, la resursa Translator, Overview › Location."
msgstr "Rajoni i resursit Azure: e gjen në portal, te resursi Translator, Overview › Location."

msgid "niciunul (OK adaugă)"
msgstr "asnjë (OK shton)"

#, python-format
msgid "Adaugă: %s"
msgstr "Shto: %s"

#, python-format
msgid "Mută mai sus: %s"
msgstr "Zhvendos më lart: %s"

#, python-format
msgid "Scoate: %s"
msgstr "Hiq: %s"

#, python-format
msgid "Fă-l principal: %s"
msgstr "Bëje kryesor: %s"

#, python-format
msgid "Serviciul principal: %s. Din OK îl poți schimba cu alt serviciu gata de folosit („Fă-l principal”)."
msgstr "Shërbimi kryesor: %s. Me OK mund ta ndryshosh me një shërbim tjetër të gatshëm për përdorim („Bëje kryesor“)."

msgid "Serviciile de rezervă: când serviciul principal nu răspunde, receptorul trece singur la următorul din listă."
msgstr "Shërbimet rezervë: kur shërbimi kryesor nuk përgjigjet, marrësi kalon automatikisht te tjetri në listë."

msgid "Căutarea nu e în această imagine."
msgstr "Kërkimi nuk është i disponueshëm në këtë imazh."

msgid "Se caută în rețeaua de acasă..."
msgstr "Po kërkohet në rrjetin shtëpiak..."

msgid "Nu am găsit niciun server în rețeaua de acasă."
msgstr "Nuk u gjet asnjë server në rrjetin shtëpiak."

#, python-format
msgid "Ollama la %s, modelul %s"
msgstr "Ollama në %s, modeli %s"

#, python-format
msgid "LibreTranslate la %s"
msgstr "LibreTranslate në %s"

#, python-format
msgid "Am găsit %d. Alege serverul."
msgstr "U gjetën %d. Zgjidh serverin."

msgid "Se probează serverul..."
msgstr "Po testohet serveri..."

#, python-format
msgid "Se caută în rețeaua de acasă... %d din %d"
msgstr "Po kërkohet në rrjetin shtëpiak... %d nga %d"

msgid "Fără limită, mai lent pe calculatoarele obișnuite"
msgstr "Pa kufi, më i ngadaltë në kompjuterë të zakonshëm"

msgid "Recomandat pentru subtitrări zilnice"
msgstr "I rekomanduar për titrat e përditshme"

msgid "Cel mai simplu de pornit, fără card; se poate opri dacă te uiți mult"
msgstr "Më i thjeshti për t'u nisur, pa kartë; mund të ndalojë nëse shikon shumë"

msgid "Formular"
msgstr "Formular"

msgid "Text simplu"
msgstr "Text i thjeshtë"

msgid "Lista serviciilor de rezervă nu e bună (un serviciu necunoscut, unul de două ori sau chiar cel principal). Nu s-a schimbat nimic."
msgstr "Lista e kanaleve të rezervës nuk është e vlefshme (një kanal i panjohur, një i listuar dy herë ose madje ai kryesori). Nuk u ndryshua asgjë."

#, python-format
msgid "%s e deja serviciul principal."
msgstr "%s është tashmë kanali kryesor."

#, python-format
msgid "%s e acum serviciul principal; %s e primul la rezerve."
msgstr "%s është tani kanali kryesor; %s është i pari ndër rezervat."

msgid "Adresă proprie"
msgstr "Adresë e personalizuar"

#, python-brace-format
msgid "locul {text} în adresă (sau, la POST, în corp)"
msgstr "vendi {text} në adresë (ose, te POST, në trup)"

msgid "o adresă https:// (http:// merge numai pentru un server din rețeaua de acasă)"
msgstr "një adresë https:// (http:// punon vetëm për një server në rrjetin e shtëpisë)"

#, python-brace-format
msgid "un corp JSON bun (pune locurile între ghilimele, de exemplu \"q\": \"{text}\")"
msgstr "një trup JSON i vlefshëm (vendosi vendet mes thonjëzave, për shembull \"q\": \"{text}\")"

msgid "un nume de antet bun (litere, cifre și - _ ., de exemplu Authorization)"
msgstr "një emër antete i vlefshëm (shkronja, shifra dhe - _ ., për shembull Authorization)"

msgid "calea traducerii în răspunsul JSON (chei și numere despărțite prin punct, de exemplu translatedText)"
msgstr "shtegu i përkthimit në përgjigjen JSON (çelësat dhe numrat të ndarë me pika, për shembull translatedText)"

msgid "Lipsește regiunea resursei Azure: o găsești în portal, la resursa Translator, Overview › Location (de exemplu Germany West Central = germanywestcentral)."
msgstr "Mungon rajoni i burimit Azure: e gjen në portal, te burimi Translator, Overview › Location (për shembull Germany West Central = germanywestcentral)."

msgid "Cheia sau regiunea nu se potrivesc: verifică amândouă în portal (Keys and Endpoint)."
msgstr "Çelësi dhe rajoni nuk përputhen: kontrolloi të dyja në portal (Keys and Endpoint)."

#, python-format
msgid "Serverul de la adresa ta a răspuns cu eroarea HTTP %d. Începutul răspunsului: „%s”"
msgstr "Serveri në adresën tënde u përgjigj me gabimin HTTP %d. Fillimi i përgjigjes: “%s”"

#, python-format
msgid "Răspunsul serverului nu e JSON (dacă serverul dă numai traducerea, alege „Text simplu” la răspuns). Începutul răspunsului: „%s”"
msgstr "Përgjigja e serverit nuk është JSON (nëse serveri jep vetëm përkthimin, zgjidh “Tekst i thjeshtë” te përgjigja). Fillimi i përgjigjes: “%s”"

#, python-format
msgid "Calea „%s” nu găsește nicio traducere în răspunsul serverului. Începutul răspunsului: „%s”"
msgstr "Shtegu “%s” nuk gjen asnjë përkthim në përgjigjen e serverit. Fillimi i përgjigjes: “%s”"

#, python-format
msgid "Serverul nu a dat nicio traducere. Începutul răspunsului: „%s”"
msgstr "Serveri nuk dha asnjë përkthim. Fillimi i përgjigjes: “%s”"

#, python-format
msgid "Traducerea subtitrărilor vine prea târziu: serverul răspunde în %s, în medie. Alege un serviciu din internet (Gemini, gratuit, fără card) sau un model mai mic."
msgstr "Përkthimi i titrave vjen shumë vonë: serveri përgjigjet në %s mesatarisht. Zgjidh një shërbim nga interneti (Gemini, falas, pa kartë) ose një model më të vogël."

#, python-format
msgid "%s a ajuns la limita gratuită pe zi (sau pe lună)."
msgstr "%s ka arritur limitin falas për ditë (ose për muaj)."

msgid "Traducerea s-a oprit până se reînnoiește limita. Ca să meargă și atunci, pune servicii de rezervă în Meniu › Setări › Sunet și subtitrări › Traducerea subtitrărilor."
msgstr "Përkthimi është ndalur derisa të rinovohet limiti. Që të vazhdojë të punojë edhe atëherë, shto shërbime rezerve te Menyja › Cilësimet › Zëri dhe titrat › Përkthimi i titrave."

msgid "De exemplu Azure Translator: Free F0, 2.000.000 de caractere pe lună, gratuit."
msgstr "Për shembull Azure Translator: Free F0, 2.000.000 karaktere në muaj, falas."

#, python-format
msgid "Traducerea subtitrărilor s-a oprit până schimbi setările: %s"
msgstr "Përkthimi i titrave është ndalur derisa të ndryshosh cilësimet: %s"

#, python-format
msgid "Am găsit regiunea: %s (%s)."
msgstr "U gjet rajoni: %s (%s)."

msgid "Cel mai simplu: pornește serverul pe calculator (pașii de mai jos), apoi apasă „Caută în rețeaua de acasă”, pe televizor sau pe telefon. Receptorul găsește singur serverul; nu mai trebuie să scrii adresa."
msgstr "Mënyra më e thjeshtë: nis serverin në kompjuter (hapat më poshtë), pastaj shtyp “Kërko në rrjetin e shtëpisë”, në TV ose në telefon. Marrësi e gjen vetë serverin; nuk ka më nevojë të shkruash adresën."

msgid "Prima dată, Windows poate întreba dacă lași programul să primească conexiuni din rețea: apasă „Allow access”. Dacă receptorul tot nu găsește serverul: Windows Security, Firewall & network protection, „Allow an app through firewall”, „Change settings” și bifează programul (Ollama, LM Studio sau Docker) la „Private”. Rețeaua de acasă trebuie să fie „Private network” (Settings, Network & internet, rețeaua ta, „Network profile type”)."
msgstr "Herën e parë, Windows mund të të pyesë nëse e lejon programin të marrë lidhje nga rrjeti: shtyp “Allow access”. Nëse marrësi ende nuk e gjen serverin: Windows Security, Firewall & network protection, “Allow an app through firewall”, “Change settings” dhe shëno programin (Ollama, LM Studio ose Docker) te “Private”. Rrjeti i shtëpisë duhet të jetë “Private network” (Settings, Network & internet, rrjeti yt, “Network profile type”)."

msgid "2.000.000 de caractere pe lună, gratuit (Free F0). E alegerea recomandată pentru subtitrări multe (filme întregi, în fiecare zi), ca serviciu principal sau de rezervă. Cardul se cere la înscriere numai pentru verificare; pe Free F0 nu se plătește nimic. După 30 de zile contul trebuie trecut pe „Pay as you go”, tot fără cost cât resursa rămâne Free F0."
msgstr "2.000.000 karaktere në muaj, falas (Free F0). Është zgjedhja e rekomanduar për shumë titra (filma të plotë, çdo ditë), si shërbim kryesor ose rezervë. Karta kërkohet gjatë regjistrimit vetëm për verifikim; në Free F0 nuk paguhet asgjë. Pas 30 ditësh llogaria duhet të kalojë në “Pay as you go”, përsëri pa kosto për sa kohë që burimi mbetet Free F0."

msgid "Pentru subtitrări multe (filme întregi, în fiecare zi) pune în setări și servicii de rezervă, de exemplu Azure Translator: când Gemini dă eroarea 429, receptorul trece singur la următorul. Lista se face din servicii diferite: limita Gemini e pe proiect, iar mai multe conturi făcute ca să aduni limitele gratuite înseamnă ocolirea limitelor, pe care termenii Google o interzic."
msgstr "Për shumë titra (filma të plotë, çdo ditë), shto në cilësime edhe shërbime rezerve, për shembull Azure Translator: kur Gemini jep gabimin 429, marrësi kalon vetë te tjetri. Lista duhet të bëhet me shërbime të ndryshme: limiti i Gemini është për projekt, dhe hapja e disa llogarive për të mbledhur limitet falas do të thotë anashkalim i limiteve, gjë që kushtet e Google e ndalojnë."

msgid "Gratuit pentru folosire ocazională, cu un număr limitat de cereri pe minut și pe zi; Google arată cifrele numai în contul tău. La subtitrări fără pauză poate da eroarea 429 după câteva minute, iar limita pe zi se poate termina."
msgstr "Falas për përdorim të rastësishëm, me një numër të kufizuar kërkesash në minutë dhe në ditë; Google i shfaq shifrat vetëm në llogarinë tënde. Me titra pa ndërprerje mund të japë gabimin 429 pas pak minutash, dhe limiti ditor mund të mbarojë."

msgid "Peste limita pe minut, cererile primesc eroarea 429 câteva secunde: receptorul așteaptă cât spune Google și trece între timp la serviciul de rezervă, dacă ai pus unul. Peste limita pe zi, până a doua zi (în jurul orei 10, ora României). Fără card nu se plătește nimic."
msgstr "Mbi limitin për minutë, kërkesat marrin gabimin 429 për pak sekonda: marrësi pret aq sa thotë Google dhe ndërkohë kalon te shërbimi rezervë, nëse ke caktuar një të tillë. Mbi limitin ditor, deri të nesërmen (rreth orës 10, sipas orës së Rumanisë). Pa kartë nuk tarifohet asgjë."

msgid "În casă: instalează Ollama de pe ollama.com pe un calculator și pornește-l."
msgstr "Në shtëpi: instalo Ollama nga ollama.com në një kompjuter dhe nise atë."

msgid "În PowerShell scrie: ollama pull gemma3:4b (3,3 GB). gemma3:12b traduce mai bine, dar e mai lent (8,1 GB); pentru un calculator slab, gemma3:1b (815 MB). Modelele qwen2.5 traduc slab în română."
msgstr "Në PowerShell shkruaj: ollama pull gemma3:4b (3,3 GB). gemma3:12b përkthen më mirë, por është më i ngadaltë (8,1 GB); për një kompjuter të dobët, gemma3:1b (815 MB). Modelet qwen2.5 përkthejnë dobët në shqip."

msgid "Ca să-l vadă receptorul: deschide Ollama, intră în Settings și pornește „Expose Ollama to the network” (Ollama 0.9.5 sau mai nou; numele poate fi puțin altul). Dacă nu găsești setarea: închide Ollama de lângă ceas („Quit”), caută în Start „environment variables” („variabile de mediu”), adaugă la contul tău OLLAMA_HOST cu valoarea 0.0.0.0:11434, apasă OK și pornește din nou Ollama."
msgstr "Që ta shohë marrësi: hap Ollama, shko te Settings dhe aktivizo “Expose Ollama to the network” (Ollama 0.9.5 ose më i ri; emri mund të jetë pak ndryshe). Nëse nuk e gjen cilësimin: mbyll Ollama te ora (“Quit”), kërko në Start “environment variables” (“variablat e mjedisit”), shto te llogaria jote OLLAMA_HOST me vlerën 0.0.0.0:11434, shtyp OK dhe nis përsëri Ollama."

msgid "Fără căutare: scrie aici adresa http://IP-UL-CALCULATORULUI:11434 și modelul gemma3:4b. Cheie nu trebuie."
msgstr "Pa kërkim: shkruaj këtu adresën http://IP-E-KOMPJUTERIT:11434 dhe modelin gemma3:4b. Çelësi nuk nevojitet."

msgid "LM Studio merge la fel: fila „Developer”, „Start server”, apoi în setările serverului „Serve on Local Network”, cu „Require Authentication” oprit; adresa http://IP-UL-CALCULATORULUI:1234 și numele modelului din LM Studio."
msgstr "LM Studio punon në të njëjtën mënyrë: skeda “Developer”, “Start server”, pastaj te cilësimet e serverit “Serve on Local Network”, me “Require Authentication” të çaktivizuar; adresa http://IP-E-KOMPJUTERIT:1234 dhe emri i modelit nga LM Studio."

msgid "„Adresă proprie” e pentru un server de traducere ales de tine, de exemplu un LibreTranslate pornit pe un calculator din casă. Receptorul trimite fiecare rând de subtitrare într-o cerere separată."
msgstr "“Adresë e personalizuar” është për një server përkthimi të zgjedhur nga ti, për shembull një LibreTranslate që punon në një kompjuter në shtëpi. Marrësi dërgon çdo rresht titrash në një kërkesë të veçantë."

#, python-brace-format
msgid "Adresa e un șablon: scrii adresa serverului și pui în ea locurile {text} (textul de tradus), {sursa} (limba subtitrării, sau auto când nu se știe) și {tinta} (limba traducerii, de exemplu ro). Receptorul le înlocuiește la fiecare cerere."
msgstr "Adresa është një shabllon: shkruaj adresën e serverit dhe vendos në të vendet {text} (teksti për t'u përkthyer), {sursa} (gjuha e titrave, ose auto kur nuk dihet) dhe {tinta} (gjuha e përkthimit, për shembull sq). Marrësi i zëvendëson ato në çdo kërkesë."

msgid "Adresa începe cu https://. O adresă http:// merge numai pentru un server din rețeaua de acasă (de exemplu 192.168.1.50). Nume și parolă nu se scriu în adresă."
msgstr "Adresa fillon me https://. Një adresë http:// punon vetëm për një server në rrjetin e shtëpisë (për shembull 192.168.1.50). Emri i përdoruesit dhe fjalëkalimi nuk shkruhen në adresë."

#, python-brace-format
msgid "Metoda GET trimite totul în adresă, deci {text} trebuie să fie în adresă. Metoda POST trimite și un corp, cu aceleași locuri: JSON (pune locurile între ghilimele, de exemplu \"q\": \"{text}\") sau formular (de exemplu q={text}&target={tinta})."
msgstr "Metoda GET dërgon gjithçka në adresë, prandaj {text} duhet të jetë në adresë. Metoda POST dërgon edhe një trup, me të njëjtat vende: JSON (vendosi vendet mes thonjëzave, për shembull \"q\": \"{text}\") ose formular (për shembull q={text}&target={tinta})."

msgid "Antetul e opțional: dacă serverul cere o cheie, scrie numele antetului (de exemplu Authorization) și, la valoare, ce cere serverul (de exemplu Bearer, un spațiu și cheia). Valoarea se păstrează criptată pe receptor și nu se mai arată."
msgstr "Antena është opsionale: nëse serveri kërkon një çelës, shkruaj emrin e antenës (për shembull Authorization) dhe, si vlerë, atë që kërkon serveri (për shembull Bearer, një hapësirë dhe çelësi). Vlera ruhet e koduar në marrës dhe nuk shfaqet më."

msgid "Răspunsul: alege „Text simplu” dacă serverul dă numai traducerea. Pentru JSON scrie calea până la traducere: numele cheilor și numerele pozițiilor (de la 0), despărțite prin punct, de exemplu translatedText sau data.translations.0.translatedText. Cu * iei toate elementele, lipite în ordine, de exemplu 0.*.0."
msgstr "Përgjigja: zgjidh “Tekst i thjeshtë” nëse serveri jep vetëm përkthimin. Për JSON shkruaj shtegun deri te përkthimi: emrat e çelësave dhe numrat e pozicioneve (duke filluar nga 0), të ndarë me pika, për shembull translatedText ose data.translations.0.translatedText. Me * merr të gjithë elementet, të bashkuar sipas radhës, për shembull 0.*.0."

msgid "Exemplu, un LibreTranslate al tău din casă: adresa http://192.168.1.50:5000/translate, metoda POST, corpul JSON {\"q\": \"{text}\", \"source\": \"{sursa}\", \"target\": \"{tinta}\", \"format\": \"text\"}, răspunsul JSON, calea translatedText."
msgstr "Shembull, një LibreTranslate i yti në shtëpi: adresa http://192.168.1.50:5000/translate, metoda POST, trupi JSON {\"q\": \"{text}\", \"source\": \"{sursa}\", \"target\": \"{tinta}\", \"format\": \"text\"}, përgjigja JSON, shtegu translatedText."

#, python-brace-format
msgid "Exemplu cu GET: adresa https://example.com/translate?q={text}&from={sursa}&to={tinta} și răspunsul „Text simplu” (example.com ține locul serverului tău)."
msgstr "Shembull me GET: adresa https://example.com/translate?q={text}&from={sursa}&to={tinta} dhe përgjigjja “Tekst i thjeshtë” (example.com zëvendëson serverin tënd)."

msgid "Apasă „Probează traducerea”. Dacă nu merge, mesajul arată începutul răspunsului serverului, ca să vezi unde e traducerea și ce cale să scrii."
msgstr "Shtyp “Provo përkthimin”. Nëse nuk funksionon, mesazhi tregon fillimin e përgjigjes së serverit, që të shohësh ku është përkthimi dhe cilën rrugë të shkruash."

msgid "Depinde de server. Un server al tău din casă nu are cotă."
msgstr "Varet nga serveri. Serveri yt personal në shtëpi nuk ka kufizim (kuotë)."

msgid "Depinde de server."
msgstr "Varet nga serveri."

msgid "Cum folosești o adresă proprie"
msgstr "Si të përdorësh një adresë personale"

#, python-format
msgid "Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din receptor, prin internet, spre serverul de la adresa scrisă de tine (%s), care îl traduce."
msgstr "Teksti i titrave (vetëm teksti, pa figurë dhe pa zë) dërgohet nga marrësi, përmes internetit, te serveri në adresën e shkruar nga ti (%s), i cili e përkthen atë."

msgid "Ollama ascultă din fabrică numai pe calculatorul lui. În Ollama 0.9.5 sau mai nou: Settings, pornește „Expose Ollama to the network”."
msgstr "Si parazgjedhje, Ollama dëgjon vetëm në kompjuterin e vet. Në Ollama 0.9.5 ose më të ri: Settings, aktivizo “Expose Ollama to the network”."

msgid "Sau: închide Ollama de lângă ceas, pune variabila de mediu OLLAMA_HOST cu valoarea 0.0.0.0:11434 și pornește din nou Ollama."
msgstr "Ose: mbyll Ollama pranë orës, vendos variablën e mjedisit OLLAMA_HOST me vlerën 0.0.0.0:11434 dhe rinis Ollama."

msgid "LM Studio: fila „Developer”, „Start server” și „Serve on Local Network”. Căutarea nu-l găsește: scrie adresa de mână (portul 1234), ca server compatibil OpenAI."
msgstr "LM Studio: skeda “Developer”, “Start server” dhe “Serve on Local Network”. Nëse kërkimi nuk e gjen: shkruaj adresën me dorë (porta 1234), si server i përputhshëm me OpenAI."

msgid "Windows: la întrebarea paravanului apasă „Allow access”. Altfel: Windows Security, „Allow an app through firewall”, bifează Ollama la „Private”."
msgstr "Windows: te pyetja e firewall-it shtyp “Allow access”. Përndryshe: Windows Security, “Allow an app through firewall”, shëno Ollama te “Private”."

msgid "Rețeaua de acasă pe calculator trebuie să fie „Private network” (Settings › Network & internet), iar receptorul și calculatorul în același router."
msgstr "Rrjeti i shtëpisë në kompjuter duhet të jetë “Private network” (Settings › Network & internet), kurse marrësi dhe kompjuteri duhet të jenë në të njëjtin router."

#, python-format
