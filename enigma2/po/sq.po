msgstr "Kërkimi në të gjithë satelitin %s: %d transponderë nga lista e marrësit, plus ata të njoftuar në sinjal."

#, python-format
msgid "Satelitul %s nu are în lista receptorului niciun transponder pe care tunerul să-l primească. Caută cu date introduse manual."
msgstr "Sateliti %s nuk ka në listën e marrësit asnjë transponder që pranohet nga sintonizuesi. Kërko me të dhëna të dhëna manualisht."

msgid "Se adaugă și transponderele anunțate în semnal."
msgstr "Shtohen edhe transponderët e njoftuar në sinjal."

#, python-format
msgid "%s: la DVB-S2 FEC-ul nu poate fi Auto, iar transponderul nu e în lista receptorului. Alege modulația și FEC-ul."
msgstr "%s: te DVB-S2 FEC nuk mund të jetë Auto dhe transponderi nuk është në listën e marrësit. Zgjidh modulimin dhe FEC-un."

#, python-format
msgid "Căutare după operator: %s, pe %s. Se pornește de la transponderul %s, restul vin din ce anunță operatorul în semnal."
msgstr "Kërkimi sipas operatorit: %s, në %s. Nis nga transponderi %s, pjesa tjetër vjen nga ajo që njofton operatori në sinjal."

#, python-format
msgid "Fluxurile găsite nu s-au putut pune în listă (%s). Încearcă din nou."
msgstr "Flukset e gjetura nuk u futën dot në listë (%s). Provo përsëri."

msgid "Factorul de rotunjire (roll-off)"
msgstr "Faktori i rrumbullakimit (roll-off)"

#, python-format
msgid "%s: niciun operator de acest fel. Pentru operatorii din alte țări apasă OK pe rândul „Operator”."
msgstr "%s: asnjë operator i këtij lloji. Për operatorët nga shtetet e tjera shtyp OK në rreshtin „Operatori”."

msgid ""
"DVB-T2: standardul nou din Europa și Asia.\n"
"Poate duce mai multe multiplexuri pe aceeași frecvență.\n"
"Banda: 8 MHz (Europa), 7/6 MHz (alte regiuni)."
msgstr ""
"DVB-T2: standardi i ri në Evropë dhe Azi.\n"
"Mund të transmetojë disa multiplekse në të njëjtën frekuencë.\n"
"Brezi: 8 MHz (Evropë), 7/6 MHz (rajone të tjera)."

msgid ""
"ATSC 3.0: standardul nou din SUA, folosit din 2020.\n"
"Ultra HD, HDR, sunet cu efect de spațiu."
msgstr ""
"ATSC 3.0: standardi i ri në SHBA, në përdorim që nga viti 2020.\n"
"Ultra HD, HDR, zë hapësinor."

msgid "Lățimea de bandă aleasă nu e primită: imaginea știe numai 8, 7, 6 MHz și Auto. Alege alta."
msgstr "Brezi i zgjedhur nuk pranohet: imazhi njeh vetëm 8, 7, 6 MHz dhe Auto. Zgjidh një tjetër."

msgid "Modulația aleasă (256QAM) e numai la DVB-T2, pe care imaginea nu îl recepționează încă. Alege QPSK, 16QAM, 64QAM sau Auto."
msgstr "Modulimi i zgjedhur (256QAM) ekziston vetëm te DVB-T2, të cilin imazhi nuk e merr ende. Zgjidh QPSK, 16QAM, 64QAM ose Auto."

msgid "Limba sunetului și a subtitrărilor"
msgstr "Gjuha e zërit dhe e titrave"

msgid "Aspectul subtitrărilor"
msgstr "Pamja e titrave"

msgid "Telecomenzi"
msgstr "Telekomandat"

msgid "Paznicul receptorului"
msgstr "Rojtari i marrësit"

msgid "fișierul nu există"
msgstr "skedari nuk ekziston"

