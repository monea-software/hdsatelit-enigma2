msgstr "Kërkimi i stacioneve u ndërpre."

msgid "Cautarea programelor s-a oprit."
msgstr "Kërkimi i kanaleve u ndërpre."

msgid "Copia are parolele Wi-Fi și setările modulelor de acces condiționat: ține stickul la tine."
msgstr "Kopja përmban fjalëkalimet e Wi-Fi dhe cilësimet e moduleve të qasjes me kusht: mbaje USB-në me vete."

msgid "acest receptor"
msgstr "ky marrës"

msgid "alt receptor (se pun la loc numai canalele)"
msgstr "marrës tjetër (rikthehen vetëm kanalet)"

msgid "automată"
msgstr "automatike"

msgid "făcută de mână"
msgstr "e krijuar manualisht"

#, python-format
