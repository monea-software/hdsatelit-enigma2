msgstr "Leximi i pistave gjatë shikimit"

msgid "Citit din ce anunță televizorul prin HDMI. O bară de sunet legată la televizor se vede aici numai prin ce anunță televizorul."
msgstr "Lexohet nga ajo që njofton televizori përmes HDMI. Një soundbar i lidhur me televizorin shihet këtu vetëm përmes asaj që njofton televizori."

msgid "Cod greșit. Mai ai %s."
msgstr "Kodi i gabuar. Të kanë mbetur %s."

msgid "Codarea citită acum:"
msgstr "Kodimi i lexuar tani:"

msgid "Codarea fișierului"
msgstr "Kodimi i skedarit"

msgid "Codul QR a expirat sau a fost deja folosit. Deschide din nou codul pe televizor și scanează-l."
msgstr "Kodi QR ka skaduar ose është përdorur tashmë. Hape përsëri kodin në TV dhe skano."

msgid "Codul QR nu e bun. Deschide din nou codul pe televizor și scanează-l."
msgstr "Kodi QR nuk është i vlefshëm. Hape përsëri kodin në TV dhe skano."

msgid "Codul a expirat sau a fost deja folosit. Apasă Afișează din nou codul pe televizor."
msgstr "Kodi ka skaduar ose është përdorur tashmë. Shtyp “Shfaq përsëri kodin” në TV."

msgid "Codul a fost cerut de prea multe ori. Încearcă din nou peste %s. %s"
msgstr "Kodi është kërkuar tepër herë. Provo përsëri pas %s. %s"

msgid "Codul apare pe televizor când receptorul arată un canal, nu în meniu și nu în standby. Este valabil o oră. După conectare, acest browser rămâne conectat un an."
msgstr "Kodi shfaqet në TV kur marrësi tregon një kanal, jo në meny dhe jo në gatishmëri. Është i vlefshëm për një orë. Pas lidhjes, ky shfletues mbetet i lidhur për një vit."

msgid "Codul apare pe televizor după ce închizi meniul sau fereastra deschisă pe receptor (tasta Exit)."
msgstr "Kodi shfaqet në TV pasi të mbyllësh menynë ose dritaren e hapur në marrës (butoni EXIT)."

msgid "Codul este afișat pe televizor."
msgstr "Kodi është shfaqur në TV."

msgid "Codul nu a fost primit."
msgstr "Kodi nuk u mor."

msgid "Codurile tastelor, proba tastelor și folosirea altei telecomenzi au pagina lor."
msgstr "Kodet e butonave, testi i butonave dhe përdorimi i një telekomande tjetër kanë faqen e tyre."

msgid "Comanda se trimite cu POST, din pagina receptorului."
msgstr "Komanda dërgohet me POST, nga faqja e marrësit."

msgid "Comandă necunoscută."
msgstr "Komandë e panjohur."

msgid "Comenzi"
msgstr "Komandat"

msgid "Comenzile acestea se dau numai din pagina receptorului, dintr-un browser conectat cu codul de pe televizor."
msgstr "Këto komanda jepen vetëm nga faqja e marrësit, nga një shfletues i lidhur me kodin nga TV-ja."

msgid "Comenzile care mișcă motorul, pornesc măsurarea semnalului sau schimbă LNB-ul (<code>lnb-aplica</code>, <code>lnb-raspuns</code>, <code>gasire-semnal-porneste</code>, <code>-reacordeaza</code>, <code>-opreste</code>, <code>motor-comanda</code>) se dau numai din paginile receptorului, cu browserul conectat: cu POST, cu antetul <code>X-HDS-CSRF</code>, fără cheia pentru scripturi."
msgstr "Komandat që lëvizin motorin, nisin matjen e sinjalit ose ndryshojnë LNB-në (<code>lnb-aplica</code>, <code>lnb-raspuns</code>, <code>gasire-semnal-porneste</code>, <code>-reacordeaza</code>, <code>-opreste</code>, <code>motor-comanda</code>) jepen vetëm nga faqet e marrësit, me shfletuesin e lidhur: me POST, me kokën <code>X-HDS-CSRF</code>, pa çelësin për skriptet."

msgid "Comenzile de mai jos se trimit motorului; starea de deasupra se schimbă după ce pleacă."
msgstr "Komandat e mëposhtme i dërgohen motorit; gjendja më sipër ndryshon pasi të nisen."

msgid "Comenzile motorului se dau numai dintr-un browser conectat cu codul de pe televizor. Aici se vede numai rotirea."
msgstr "Komandat e motorit jepen vetëm nga një shfletues i lidhur me kodin nga TV-ja. Këtu shihet vetëm rrotullimi."

