msgid "Cheia"
msgstr "Çelësi"

msgid "Cheia cere regiunea resursei Azure."
msgstr "Çelësi kërkon rajonin e burimit Azure."

msgid "Cheia e opțională: numai dacă serverul cere cheie."
msgstr "Çelësi është opsional: vetëm nëse serveri kërkon çelës."

msgid "Cheia e prea lungă. Nu s-a pornit nimic."
msgstr "Çelësi është tepër i gjatë. Nuk u nis asgjë."

msgid "Cheia e prea lungă. Nu s-a schimbat nimic."
msgstr "Çelësi është tepër i gjatë. Nuk u ndryshua asgjë."

msgid "Cheia nu se trimite în adresă: adresa rămâne în istoricul browserului și în jurnale. Lipește-o în pagină. Nu s-a salvat și nu s-a pornit nimic."
msgstr "Çelësi nuk dërgohet në adresë: adresa mbetet në historikun e shfletuesit dhe në regjistrime. Ngjite në faqen përkatëse. Nuk u ruajt dhe nuk u nis asgjë."

msgid "Cheia nu se trimite în adresă: adresa rămâne în istoricul browserului și în jurnale. Trimite-o în corpul cererii POST. Nu s-a salvat nimic."
msgstr "Çelësi nuk dërgohet në adresë: adresa mbetet në historikun e shfletuesit dhe në regjistrime. Dërgoje në trupin e kërkesës POST. Nuk u ruajt asgjë."

msgid "Cheia o faci cu contul tău Google. La subtitrări continue poate da „prea multe cereri”."
msgstr "Çelësin e krijon me llogarinë tënde Google. Me titra të vazhdueshme mund të nxjerrë “tepër kërkesa”."

msgid "Cheia pentru scripturi"
msgstr "Çelësi për skriptet"

msgid "Cheia pleacă numai spre receptor, se păstrează criptată și nu se mai arată niciodată."
msgstr "Çelësi shkon vetëm te marrësi, ruhet i koduar dhe nuk shfaqet më kurrë."

msgid "Cheia se păstrează pe receptor, criptată; nu se mai arată niciodată."
msgstr "Çelësi ruhet në marrës, i koduar; nuk shfaqet më kurrë."

msgid "Cheia se trimite numai cu POST, din pagină. Nu s-a salvat nimic."
msgstr "Çelësi dërgohet vetëm me POST, nga faqja. Nuk u ruajt asgjë."

msgid "Cheia se trimite numai cu POST, în corpul cererii. Nu s-a salvat nimic."
msgstr "Çelësi dërgohet vetëm me POST, në trupin e kërkesës. Nuk u ruajt asgjë."

msgid "Cheia, adresa sau modelul unei rezerve se pun alegând-o pe rând la „Serviciul” (sau din configurarea pas cu pas)."
msgstr "Çelësi, adresa ose modeli i një kopjeje rezervë vendosen duke e zgjedhur me radhë te “Shërbimi” (ose nga konfigurimi hap pas hapi)."

msgid "Citește lista din nou"
msgstr "Lexo përsëri listën"

msgid "Citirea listelor a durat prea mult."
msgstr "Leximi i listave zgjati tepër."

