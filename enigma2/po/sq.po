msgstr "Çelësi u vendos"

msgid "Fără cheie"
msgstr "Pa çelës"

msgid "Cheie pusă pentru alt server (%s): nu pleacă spre adresa de acum. Pune-o din nou."
msgstr "Çelësi u vendos për një server tjetër (%s): nuk dërgohet te adresa e tanishme. Fute sërish."

