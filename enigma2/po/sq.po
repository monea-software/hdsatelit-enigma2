msgstr "Për sa kohë ekrani „Fjalëkalimi i marrësit” është i hapur në marrës, telekomanda dhe kapja e ekranit funksionojnë vetëm nga një shfletues i lidhur me kodin nga televizori."

msgid "Aceleași lucruri sunt și în meniul receptorului, în %s."
msgstr "Të njëjtat gjëra janë edhe në menynë e marrësit, në %s."

msgid "Parola nouă"
msgstr "Fjalëkalimi i ri"

msgid "4-64 de semne: litere fără diacritice, cifre și semne, fără spații. Cea veche nu mai merge."
msgstr "4-64 karaktere: shkronja pa diakritikë, shifra dhe simbole, pa hapësira. I vjetri nuk funksionon më."

msgid "FTP sau SFTP (de exemplu FileZilla sau WinSCP), utilizatorul root și parola de sus:"
msgstr "FTP ose SFTP (për shembull FileZilla ose WinSCP), përdoruesi root dhe fjalëkalimi më lart:"

msgid "Cu parola se intră numai din rețeaua ta de acasă. Cu o cheie SSH pusă mai jos, calculatorul intră fără parolă."
msgstr "Me fjalëkalim hyn vetëm nga rrjeti yt i shtëpisë. Me një çelës SSH të shtuar më poshtë, kompjuteri hyn pa fjalëkalim."

msgid "Scrie întâi parola nouă."
msgstr "Shkruaj së pari fjalëkalimin e ri."

msgid "__T_CUM_FTP__ <span class=\"cod\" id=\"comandaFtp\">ftp://receptor</span>"
msgstr "__T_CUM_FTP__ <span class=\"cod\" id=\"comandaFtp\">ftp://receptor</span>"

msgid "<code>GET /api/acces-ssh</code>: parola receptorului (FTP, SSH și SFTP): felul parolei lui root (fără parola însăși), dacă merge FTP (<code>ftp</code>), cheile SSH (tipul, amprenta, comentariul), opțiunea Fără parolă în rețeaua locală, stările periculoase (<code>alarme</code>), lucrarea în curs și rezultatul ultimei comenzi"
msgstr "<code>GET /api/acces-ssh</code>: fjalëkalimi i marrësit (FTP, SSH dhe SFTP): lloji i fjalëkalimit të root (pa vetë fjalëkalimin), nëse FTP funksionon (<code>ftp</code>), çelësat SSH (lloji, gjurma, komenti), opsioni Pa fjalëkalim në rrjetin lokal, gjendjet e rrezikshme (<code>alarme</code>), puna në vazhdim dhe rezultati i komandës së fundit"

msgid "<code>POST /api/acces-ssh-parola</code>: textul parolei (se vede oricând); <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: fișierele serverelor SSH și FTP ca text (fără /etc/shadow)"
msgstr "<code>POST /api/acces-ssh-parola</code>: teksti i fjalëkalimit (shihet në çdo kohë); <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: skedarët e serverëve SSH dhe FTP si tekst (pa /etc/shadow)"

msgid "<code>POST /api/acces-ssh-pune</code> (corp: <code>parola=</code>): parola aleasă (4-64 de semne: litere fără diacritice, cifre și semne, fără spații); <code>POST /api/acces-ssh-parola-noua?confirmat=1</code>: o parolă nouă la întâmplare"
msgstr "<code>POST /api/acces-ssh-pune</code> (trup: <code>parola=</code>): fjalëkalimi i zgjedhur (4-64 shenja: shkronja pa diakritikë, shifra dhe shenja, pa hapësira); <code>POST /api/acces-ssh-parola-noua?confirmat=1</code>: një fjalëkalim i ri i rastësishëm"

msgid "<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</code> cere și <code>confirmat=1</code>): opțiunea Fără parolă în rețeaua locală. Parola, textul brut și toate schimbările merg numai dintr-un browser conectat cu codul de pe televizor (altfel 403 cu <code>trebuie_cod</code>), niciodată cu <code>?token=</code>; cât ecranul Parola receptorului e deschis pe receptor, la fel <code>/api/remotecontrol</code> și <code>/api/screenshot</code>"
msgstr "<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</code> kërkon edhe <code>confirmat=1</code>): opsioni “Pa fjalëkalim në rrjetin lokal”. Fjalëkalimi, teksti i papërpunuar dhe të gjitha ndryshimet funksionojnë vetëm nga një shfletues i lidhur me kodin nga televizori (përndryshe 403 me <code>trebuie_cod</code>), kurrë me <code>?token=</code>; për sa kohë ekrani “Fjalëkalimi i marrësit” është i hapur në marrës, e njëjta gjë vlen për <code>/api/remotecontrol</code> dhe <code>/api/screenshot</code>"

msgid "Raportează canalul ăsta"
