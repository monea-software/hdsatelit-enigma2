msgstr "Modeli i pllakës nuk mund të lexohej."

#, python-format
msgid "Imaginea pentru receptorul tău și pașii de instalare: %s"
msgstr "Imazhi për marrësin tënd dhe hapat e instalimit: %s"

msgid "Pagina receptorului tău"
msgstr "Faqja e marrësit tënd"

#, python-format
msgid "Tema %s are elemente pe care receptorul nu le poate afișa încă. Receptorul merge mai departe."
msgstr "Tema %s ka elemente që marrësi nuk mund t'i shfaqë ende. Marrësi vazhdon punën."

msgid "alegerea nu se poate ține minte pe receptor: discul e plin sau nu se poate scrie"
msgstr "zgjedhja nuk mund të mbahet mend në marrës: disku është plot ose nuk mund të shkruhet"

msgid "ecranele au dat erori de mai multe ori la rând; cauza exactă nu a fost stabilită"
msgstr "ekranet dhanë gabime disa herë radhazi; shkaku i saktë nuk u përcaktua"

#, python-format
msgid "lipsește sau e stricată o parte a temei: %s"
msgstr "mungon ose është dëmtuar një pjesë e temës: %s"

#, python-format
msgid "rezoluția temei nu e bună: %s"
msgstr "rezolucioni i temës nuk është i duhuri: %s"

msgid "Instalez actualizarea. Canalele, setările și pluginurile rămân. Interfața repornește singură când receptorul e liber."
msgstr "Po instaloj përditësimin. Kanalet, cilësimet dhe shtojcat mbeten. Ndërfaqja riniset vetë kur marrësi është i lirë."

msgid "Setările din copia făcută înainte de instalare se pun la loc acum. Interfața repornește o dată, când receptorul e liber."
msgstr "Cilësimet nga kopja rezervë e bërë para instalimit po rikthehen tani. Ndërfaqja riniset një herë, kur marrësi është i lirë."

msgid "Introdu stickul folosit la instalare. Setările se vor pune singure la loc."
msgstr "Fut USB-në e përdorur gjatë instalimit. Cilësimet do të rikthehen automatikisht."

msgid "Nu pot verifica versiunea instalată. Nu s-a instalat nimic. Detaliile sunt în jurnalul actualizărilor."
msgstr "Nuk mund të verifikoj versionin e instaluar. Nuk u instalua asgjë. Detajet janë në ditarin e përditësimeve."

msgid "Bagă un stick sau un disc și apasă din nou „Fă copia”."
msgstr "Fut një USB ose disk dhe shtyp sërish „Bëj kopje rezervë”."

#, python-format
msgid "VERDE: instalează versiunea %s. Interfața repornește apoi singură, când receptorul e liber."
msgstr "E GJELBËR: instalo versionin %s. Ndërfaqja riniset pastaj vetë, kur marrësi është i lirë."

msgid "OK sau GALBEN: pune la loc. ALBASTRU: șterge."
msgstr "OK ose E VERDHË: rikthe. BLU: fshi."

msgid "Bagă un stick USB sau un disc în receptor, apoi apasă „Fă copia”."
msgstr "Fut një USB ose disk në marrës, pastaj shtyp „Bëj kopje rezervë”."

#, python-format
msgid "Extensia %s nu se poate configura pe această imagine; nu ține de actualizare."
msgstr "Shtesa %s nuk mund të konfigurohet në këtë imazh; nuk ka lidhje me përditësimin."

msgid "Oprit din fabrică. Lucrează numai la posturile cu sunet MPEG (MP2), radio și TV. Pe unele receptoare poate produce distorsiuni sau întreruperi; atunci oprește-l."
msgstr "I çaktivizuar si parazgjedhje. Punon vetëm në kanalet me audio MPEG (MP2), radio dhe TV. Në disa marrës mund të shkaktojë shtrembërime ose ndërprerje; në atë rast çaktivizoje."

msgid "%d reglaje ascunse schimbate"
msgstr "%d cilësime të fshehura të ndryshuara"

msgid "Adresa serverului s-a schimbat. Scrie din nou toate cheile lui sau șterge cheile rămase înainte de salvare."
msgstr "Adresa e serverit ka ndryshuar. Shkruaj sërish të gjitha çelësat e tij ose fshi çelësat e mbetur para ruajtjes."

msgid "Cheia nu s-a putut pregăti. Încearcă din nou."
msgstr "Çelësi nuk mund të përgatitej. Provo sërish."

msgid "Cheie nouă"
msgstr "Çelës i ri"

msgid "Cheie pregătită. VERDE salvează; EXIT renunță."
msgstr "Çelës i përgatitur. E GJELBËR ruan; EXIT anulo."

msgid "Cheie schimbată, încă nesalvată"
msgstr "Çelës i ndryshuar, ende i paruajtur"

msgid "Cheile se trimit numai cu POST, în corpul cererii. Nu s-a salvat nimic."
msgstr "Çelësat dërgohen vetëm me POST, në trupin e kërkesës. Nuk u ruajt asgjë."

msgid "Cheile trimise nu sunt valide. Nu s-a schimbat nimic."
msgstr "Çelësat e dërguar nuk janë të vlefshëm. Nuk ndryshoi asgjë."

msgid "Lista schimbărilor de chei nu este bună."
msgstr "Lista e ndryshimeve të çelësave nuk është e saktë."

msgid "Modificate: %d"
msgstr "Të ndryshuara: %d"

msgid "Nu este pornită nicio pistă de subtitrare. Alege o pistă; textul scris direct în imaginea filmului nu poate fi tradus."
msgstr "Nuk është aktivizuar asnjë pistë titrash. Zgjidh një pistë; teksti i shkruar drejtpërdrejt në figurën e filmit nuk mund të përkthehet."

msgid "OK schimbă vederea. Reglajele ascunse se păstrează. VERDE salvează tot; EXIT renunță."
msgstr "OK ndryshon pamjen. Cilësimet e fshehura ruhen. E GJELBËR ruan gjithçka; EXIT anulo."

msgid "Pista aleasă este o imagine, dar OCR este oprit după erori. Alege din nou pista sau verifică OCR."
msgstr "Pista e zgjedhur është një figurë, por OCR është i çaktivizuar pas gabimeve. Zgjidh sërish pistën ose kontrollo OCR."

msgid "Pista aleasă este o imagine, dar lipsește modelul OCR pentru limba ei. Descarcă modelul sau alege o pistă text."
msgstr "Pista e zgjedhur është një figurë, por mungon modeli OCR për gjuhën e saj. Shkarko modelin ose zgjidh një pistë teksti."

msgid "Pista aleasă este o imagine, dar nucleul nu oferă legătura OCR. Alege o pistă text."
msgstr "Pista e zgjedhur është një figurë, por kerneli nuk ofron lidhjen OCR. Zgjidh një pistë teksti."

msgid "Pista aleasă este o imagine, dar programul OCR nu este instalat. Instalează hds-ocr sau alege o pistă text."
msgstr "Pista e zgjedhur është një figurë, por programi OCR nuk është i instaluar. Instalo hds-ocr ose zgjidh një pistë teksti."

msgid "Pista aleasă este o imagine. Pornește traducerea subtitrărilor DVB pentru a folosi OCR."
msgstr "Pista e zgjedhur është një figurë. Aktivizo përkthimin e titrave DVB për të përdorur OCR."

msgid "Pista aleasă este o imagine: OCR citește textul, apoi textul se traduce."
msgstr "Pista e zgjedhur është një imazh: OCR lexon tekstin, pastaj teksti përkthehet."

msgid "Pista aleasă este subtitrare teletext: textul se traduce direct, fără OCR."
msgstr "Pista e zgjedhur është titër teleteksti: teksti përkthehet drejtpërdrejt, pa OCR."

msgid "Pista aleasă oferă text: subtitrarea din fișier sau flux se traduce direct, fără OCR."
msgstr "Pista e zgjedhur ofron tekst: titrat nga skedari ose transmetimi përkthehen drejtpërdrejt, pa OCR."

msgid "Regiunea, adresa, modelul și cheile se salvează împreună cu celelalte setări."
msgstr "Rajoni, adresa, modeli dhe çelësat ruhen së bashku me cilësimet e tjera."

msgid "Reglaje ascunse diferite de fabrică:"
msgstr "Cilësime të fshehura të ndryshme nga ato të fabrikës:"

msgid "Reglaje ascunse diferite de valorile implicite: %d"
msgstr "Cilësime të fshehura të ndryshme nga vlerat e parazgjedhura: %d"

msgid "Reglajele uzuale"
msgstr "Cilësimet e zakonshme"

msgid "Schimbarea vederii păstrează toate valorile."
msgstr "Ndryshimi i pamjes ruan të gjitha vlerat."

msgid "Schimbări nesalvate."
msgstr "Ndryshime të paruajtura."

msgid "Schimbările au fost anulate."
msgstr "Ndryshimet u anuluan."

msgid "Setările nu s-au putut salva. Încearcă din nou."
msgstr "Cilësimet nuk mund të ruheshin. Provo përsëri."

msgid "Setările salvate:"
msgstr "Cilësimet e ruajtura:"

msgid "Setările și cheile se păstrează numai când apeși Salvează. Renunță anulează toate schimbările tale."
msgstr "Cilësimet dhe çelësat ruhen vetëm kur shtyp Ruaj. Anulo i anulon të gjitha ndryshimet e tua."

msgid "Starea OCR nu se poate verifica acum. Verifică OCR sau alege o pistă text."
msgstr "Gjendja e OCR nuk mund të kontrollohet tani. Kontrollo OCR ose zgjidh një pistë teksti."

msgid "Subtitrarea este deja în limba aleasă pentru traducere."
msgstr "Titrat janë tashmë në gjuhën e zgjedhur për përkthim."

msgid "Sunt prea multe cereri de traducere. Reîncerc automat după pauza cerută de serviciu."
msgstr "Ka shumë kërkesa për përkthim. Po riprovoj automatikisht pas pushimit të kërkuar nga shërbimi."

msgid "Tastatura nu s-a putut deschide. Încearcă din nou."
msgstr "Tastatura nuk mund të hapej. Provo përsëri."

msgid "Toate reglajele"
msgstr "Të gjitha cilësimet"

msgid "Traducerea nu a reușit: %s Reîncerc automat."
msgstr "Përkthimi dështoi: %s Po riprovoj automatikisht."

msgid "Traducerea subtitrărilor este oprită."
msgstr "Përkthimi i titrave është i çaktivizuar."

msgid "Vedere scurtă"
msgstr "Pamje e shkurtër"

msgid "pregătită (VERDE salvează)"
msgstr "gati (E GJELBËR ruan)"

msgid "Ștergere pregătită. VERDE salvează; EXIT renunță."
msgstr "Fshirja gati. E GJELBËR ruan; EXIT anulo."

#, python-format
msgid "%s este conectat, dar receptorul nu îl poate citi."
msgstr "%s është i lidhur, por marrësi nuk mund ta lexojë."

#, python-format
msgid "%s nu poate fi citit de receptor. Îl poți formata aici sau pe un calculator, ca FAT32. Formatarea șterge tot de pe el."
msgstr "%s nuk mund të lexohet nga marrësi. Mund ta formatosh këtu ose në një kompjuter, si FAT32. Formatimi fshin gjithçka në të."

msgid "Alege partiția"
msgstr "Zgjidh particionin"

msgid "Discul este montat numai pentru citire."
msgstr "Disku është montuar vetëm për lexim."

msgid "Discul nu a putut fi montat."
msgstr "Disku nuk mund të montohej."

msgid "Discul nu răspunde la timp. Încearcă din nou."
msgstr "Disku nuk përgjigjet në kohë. Provo përsëri."

msgid "Discul nu răspunde."
msgstr "Disku nuk përgjigjet."

msgid "FAT32 nu poate salva o înregistrare mai mare de 4 GB. Receptorul nu o împarte în fișiere. Pentru înregistrări lungi, alege un disc ext4."
msgstr "FAT32 nuk mund të ruajë një regjistrim më të madh se 4 GB. Marrësi nuk e ndan atë në skedarë. Për regjistrime të gjata, zgjidh një disk ext4."

msgid "Galben: punct de montare"
msgstr "E verdhë: pikë montimi"

#, python-format
msgid "Locul %s este conectat."
msgstr "Vendndodhja %s është e lidhur."

msgid "Locul din rețea nu este pregătit pentru înregistrări."
msgstr "Vendndodhja në rrjet nuk është gati për regjistrime."

msgid "Locul este folosit pentru redare, timeshift sau înregistrări. Oprește folosirea lui, apoi salvează din nou."
msgstr "Vendndodhja po përdoret për luajtje, timeshift ose regjistrime. Ndalo përdorimin e saj, pastaj ruaj përsëri."

#, python-format
msgid "Locul s-a salvat, dar nu s-a conectat: %s"
msgstr "Vendndodhja u ruajt, por nuk u lidh: %s"

msgid "Locurile SMB și NFS se montează pe receptor: apar și în Player media, ca un disc. Folosește pt. înregistrări verifică scrierea și viteza, apoi alege locul pentru înregistrări. Parolele stau criptate pe receptor și nu se arată nicăieri."
msgstr "Vendndodhjet SMB dhe NFS montohen në marrës: shfaqen edhe në Player-in e medias, si një disk. Përdor për regjistrime kontrollon shkrimin dhe shpejtësinë, pastaj zgjedh vendndodhjen për regjistrime. Fjalëkalimet qëndrojnë të koduara në marrës dhe nuk shfaqen askund."

msgid "Numele ales în /media se aplică la următoarea montare a discului."
msgstr "Emri i zgjedhur në /media zbatohet në montimin tjetër të diskut."

msgid "Punct de montare la următoarea montare"
msgstr "Pikë montimi në montimin tjetër"

msgid "Punctul de montare a fost salvat. Se folosește la următoarea montare a discului."
msgstr "Pika e montimit u ruajt. Do të përdoret në montimin tjetër të diskut."

msgid "Receptorul caută serverele la prima intrare cu lista goală. Nimic nu pleacă în afara rețelei tale. Alegi serverul și salvezi locul ca să îl conectezi."
msgstr "Marrësi kërkon serverët në hyrjen e parë me listë bosh. Asgjë nuk del jashtë rrjetit tënd. Zgjidh serverin dhe ruaj vendndodhjen për ta lidhur."

msgid "Se citesc datele discului..."
msgstr "Po lexohen të dhënat e diskut..."

msgid "Se pregătește locul înregistrărilor..."
msgstr "Po përgatitet vendndodhja e regjistrimeve..."

msgid "Se salvează alegerea..."
msgstr "Po ruhet zgjedhja..."

msgid "Se salvează și se conectează locul..."
msgstr "Po ruhet dhe po lidhet vendndodhja..."

msgid "Verifică mai întâi mesajul discului. Pentru un disc fără sistem de fișiere, poți folosi Formatează din pagina Discurile. Formatarea șterge tot de pe el."
msgstr "Kontrollo fillimisht mesazhin e diskut. Për një disk pa sistem skedarësh, mund të përdorësh Formato nga faqja Disqet. Formatimi fshin gjithçka në të."

msgid "Încearcă din nou după ce verifici conexiunea discului."
msgstr "Provo përsëri pasi të kontrollosh lidhjen e diskut."

msgid "Proba de viteză nu pornește în timpul redării unui fișier, al timeshift-ului sau al înregistrărilor, nici înaintea unei înregistrări apropiate."
msgstr "Testi i shpejtësisë nuk fillon gjatë luajtjes së një skedari, timeshift-it ose regjistrimeve, as përpara një regjistrimi të afërt."

msgid "ALBASTRU"
msgstr "BLU"

msgid "Adaugă sau scoate canalul din Favorite"
msgstr "Shto ose hiq kanalin nga Të preferuarat"

msgid "Adaugă sau șterge programarea"
msgstr "Shto ose fshi kohëmatësin"

msgid "Alege buchetul pentru canal"
msgstr "Zgjidh buqetën për kanalin"

msgid "Alege canalul de sub cursor"
msgstr "Zgjidh kanalin nën kursor"

msgid "Alege dosarul de destinație"
msgstr "Zgjidh dosjen e destinacionit"

msgid "Alege o funcție sau un plugin instalat pentru fiecare tastă, cât te uiți la televizor. Funcția obișnuită urmează profilul curent. Cifrele lungi se alocă în afara timeshiftului."
msgstr "Zgjidh një funksion ose shtojcë të instaluar për çdo buton, ndërsa shikon televizor. Funksioni i zakonshëm ndjek profilin aktual. Shifrat me shtypje të gjatë caktohen jashtë timeshift-it."

msgid "Alege tipul de ghid"
msgstr "Zgjidh llojin e udhëzuesit"

msgid "Alege un dosar de pe același disc pentru mutare."
msgstr "Zgjidh një dosje në të njëjtin disk për zhvendosje."

msgid "Alegerea tipului de ghid (EPG)"
msgstr "Zgjedhja e llojit të udhëzuesit (EPG)"

msgid "Alegi funcția tastelor și pluginurile instalate. VERDE salvează, ROȘU sau EXIT anulează."
msgstr "Zgjidh funksionet e butonave dhe shtojcat e instaluara. E GJELBËR ruan, E KUQE ose EXIT anulo."

msgid "Ascunde bara de informații"
msgstr "Fshih shiritin e informacionit"

msgid "Buchete / Favorite"
msgstr "Buqetat / Të preferuarat"

msgid "Buchetul anterior"
msgstr "Buqeta e mëparshme"

msgid "Buchetul următor"
msgstr "Buqeta tjetër"

msgid "CH+ și CH- la privit"
msgstr "CH+ dhe CH- gjatë shikimit"

msgid "Canalul anterior"
msgstr "Kanali i mëparshëm"

msgid "Canalul următor"
msgstr "Kanali tjetër"

msgid "Cele mai noi"
msgstr "Më të rejat"

msgid "Context"
msgstr "Konteksti"

msgid "Cu Da, verde deschide egalizatorul, galben schimbă vizualizatorul și albastru paleta. Cu Nu, culorile păstrează comenzile comune de vizionare. Ecranul radio poate rămâne vizibil."
msgstr "Me Po, e gjelbër hap equalizer-in, e verdhë ndryshon vizualizuesin dhe blu paletën. Me Jo, ngjyrat ruajnë komandat e zakonshme të shikimit. Ekrani i radios mund të mbetet i dukshëm."

msgid "Culorile barelor. Albastru trece la următoarele numai dacă ai activat comenzile colorate ale radioului. Alegerea skin folosește culorile meniurilor."
msgstr "Ngjyrat e shiritave. Blu kalon te të tjerat vetëm nëse ke aktivizuar komandat me ngjyra të radios. Zgjedhja e temës (skin) përdor ngjyrat e menysë."

msgid "Culorile comandă ecranul radio"
msgstr "Ngjyrat kontrollojnë ekranin e radios"

msgid "Culorile urmează comenzile comune de vizionare. Preluarea lor de ecranul radio este opțională."
msgstr "Ngjyrat ndjekin komandat e zakonshme të shikimit. Marrja e tyre nga ekrani i radios është opsionale."

msgid "Culorile următoare"
