msgstr "Server i përputhshëm me OpenAI"

msgid "Serviciul ales nu are adresă de server."
msgstr "Shërbimi i zgjedhur nuk ka adresë serveri."

#, python-format
msgid "Scrie adresa serverului, de exemplu http://192.168.1.50:%d."
msgstr "Shkruaj adresën e serverit, për shembull http://192.168.1.50:%d."

msgid "Adresa are spații sau caractere care nu pot fi într-o adresă."
msgstr "Adresa përmban hapësira ose karaktere që nuk lejohen në një adresë."

msgid "Portul din adresă nu e bun: trebuie un număr între 1 și 65535."
msgstr "Porta në adresë nuk është e saktë: duhet të jetë një numër ndërmjet 1 dhe 65535."

msgid "Adresa trebuie să înceapă cu http:// sau https://."
msgstr "Adresa duhet të fillojë me http:// ose https://."

msgid "Adresa nu poate avea nume de utilizator sau parolă. Scrie numai adresa serverului; cheia, dacă serverul cere una, se pune separat."
msgstr "Adresa nuk mund të përmbajë emër përdoruesi ose fjalëkalim. Shkruaj vetëm adresën e serverit; çelësi, nëse serveri kërkon një të tillë, vendoset veçmas."

msgid "Adresa nu are numele sau IP-ul serverului."
msgstr "Adresa nuk përmban emrin ose IP-në e serverit."

#, python-format
msgid "Serverul de la %s cere o cheie. Scrie cheia serverului, sau pornește serverul fără cheie."
msgstr "Serveri në %s kërkon një çelës. Shkruaj çelësin e serverit, ose nise serverin pa çelës."

msgid "adresa scrisă"
msgstr "adresa e shkruar"

msgid "Copiaz-o întreagă din pagina cheii, fără spații. Cheia pentru Gemini se face pe aistudio.google.com/apikey."
msgstr "Kopjoje të gjithin nga faqja e çelësit, pa hapësira. Çelësi për Gemini krijohet në aistudio.google.com/apikey."

msgid "Cheia e bună, dar în proiectul ei nu e pornit „Cloud Translation API”. În Google Cloud (console.cloud.google.com) mergi la „APIs & Services”, caută „Cloud Translation API”, apasă „Enable”, așteaptă câteva minute și încearcă din nou."
msgstr "Çelësi është i saktë, por në projektin e tij nuk është aktivizuar “Cloud Translation API”. Në Google Cloud (console.cloud.google.com) shko te “APIs & Services”, kërko “Cloud Translation API”, shtyp “Enable”, prit disa minuta dhe provo përsëri."

msgid "Copiaz-o întreagă din pagina cheii (console.cloud.google.com/apis/credentials), fără spații. În proiectul cheii pornește „Cloud Translation API” și verifică să nu fie cheia restrânsă la alt API."
msgstr "Kopjoje të gjithin nga faqja e çelësit (console.cloud.google.com/apis/credentials), pa hapësira. Në projektin e çelësit aktivizo “Cloud Translation API” dhe kontrollo që çelësi të mos jetë i kufizuar për një API tjetër."

msgid "Copiaz-o întreagă din portal (resursa Translator, „Keys and Endpoint”, KEY 1), fără spații, și verifică regiunea: scrisă exact ca în portal (de exemplu westeurope), sau Global dacă resursa e globală."
msgstr "Kopjoje të gjithin nga portali (resursi Translator, “Keys and Endpoint”, KEY 1), pa hapësira, dhe kontrollo rajonin: i shkruar saktësisht si në portal (për shembull westeurope), ose Global nëse resursi është global."

msgid "Copiaz-o întreagă din pagina cheilor DeepL (www.deepl.com/en/your-account/keys), fără spații. Trebuie o cheie de la DeepL API, nu de la traducătorul obișnuit."
msgstr "Kopjoje të gjithin nga faqja e çelësave të DeepL (www.deepl.com/en/your-account/keys), pa hapësira. Duhet një çelës nga DeepL API, jo nga përkthyesi i zakonshëm."

#, python-format
msgid "Copiaz-o întreagă din pagina cheilor (%s), fără spații."
msgstr "Kopjoje të gjithin nga faqja e çelësave (%s), pa hapësira."

msgid "Copiaz-o întreagă din pagina cheii, fără spații, și încearcă din nou."
msgstr "Kopjoje të gjithin nga faqja e çelësit, pa hapësira, dhe provo përsëri."

msgid "Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se reface cota (la Gemini, de obicei a doua zi, în jurul orei 10, ora României)."
msgstr "Çelësi është i saktë, por kuota ka përfunduar. Përkthimi do të funksionojë përsëri pasi të rivendoset kuota (te Gemini, zakonisht të nesërmen, rreth orës 10, sipas orës së Rumanisë)."

msgid "Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se reface cota (la Azure, luna următoare)."
msgstr "Çelësi është i saktë, por kuota ka përfunduar. Përkthimi do të funksionojë përsëri pasi të rivendoset kuota (te Azure, muajin e ardhshëm)."

msgid "Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se reface cota."
msgstr "Çelësi është i saktë, por kuota ka përfunduar. Përkthimi do të funksionojë përsëri pasi të rivendoset kuota."

msgid "Serverul a răspuns prea încet."
msgstr "Serveri u përgjigj tepër ngadalë."

#, python-format
msgid "Verifică dacă serverul de la %s e pornit și dacă receptorul îl vede (același router)."
msgstr "Kontrollo nëse serveri në %s është i ndezur dhe nëse marrësi mund ta shohë atë (në të njëjtin router)."

msgid "La Ollama, pe calculator trebuie OLLAMA_HOST=0.0.0.0:11434 (vezi instrucțiunile)."
msgstr "Për Ollama, në kompjuter nevojitet OLLAMA_HOST=0.0.0.0:11434 (shih udhëzimet)."

msgid "Verifică internetul receptorului (Meniu › Setări › Rețea) și încearcă din nou."
msgstr "Kontrollo lidhjen e internetit të marrësit (Menyja › Cilësimet › Rrjeti) dhe provo përsëri."

#, python-format
msgid "Pornește serverul LibreTranslate și cu limba „%s” (de exemplu --load-only en,ro,de,fr,it,es,hu)."
msgstr "Nise serverin LibreTranslate edhe me gjuhën “%s” (për shembull --load-only en,ro,de,fr,it,es,hu)."

msgid "Serviciul nu traduce în limba aleasă. Alege altă limbă în setările traducerii."
msgstr "Shërbimi nuk përkthen në gjuhën e zgjedhur. Zgjidh një gjuhë tjetër te cilësimet e përkthimit."

msgid "La adresa asta nu răspunde LibreTranslate. Verifică adresa și portul (de obicei 5000)."
msgstr "Në këtë adresë nuk përgjigjet asnjë server LibreTranslate. Kontrollo adresën dhe portën (zakonisht 5000)."

msgid "Modelul nu e pe server. Alege alt model din listă."
msgstr "Modeli nuk ndodhet në server. Zgjidh një model tjetër nga lista."

msgid "Contul nu are credit pentru acest model. Cumpără credit sau alege alt model."
msgstr "Llogaria nuk ka kredit për këtë model. Bli kredit ose zgjidh një model tjetër."

msgid "Serverul a răspuns neașteptat. Verifică adresa și portul și încearcă din nou."
msgstr "Serveri dha një përgjigje të papritur. Kontrollo adresën dhe portën dhe provo përsëri."

msgid "Serviciul a răspuns neașteptat. Încearcă din nou peste câteva minute."
msgstr "Shërbimi dha një përgjigje të papritur. Provo përsëri pas disa minutash."

#, python-format
msgid "Proba a durat %s secunde: serverul e prea lent ca subtitrările traduse să apară la timp; vor veni târziu, după original."
msgstr "Prova zgjati %s sekonda: serveri është tepër i ngadaltë që titrat e përkthyera të shfaqen me kohë; ato do të arrijnë me vonesë, pas origjinalit."

msgid "Folosește un serviciu din internet (Gemini, gratuit, fără card) sau un model mai mic (de exemplu gemma3:4b)."
msgstr "Përdor një shërbim nga interneti (Gemini, falas, pa kartë) ose një model më të vogël (për shembull gemma3:4b)."

msgid "Folosește un serviciu din internet (Gemini, gratuit, fără card)."
msgstr "Përdor një shërbim nga interneti (Gemini, falas, pa kartë)."

msgid "Încearcă un model mai mic sau alt serviciu (Gemini, gratuit, fără card)."
msgstr "Provo një model më të vogël ose një shërbim tjetër (Gemini, falas, pa kartë)."

msgid "Configurarea s-a oprit neașteptat."
msgstr "Konfigurimi u ndërpre papritur."

msgid "Lipește cheia."
msgstr "Ngjit çelësin."

msgid "Cheia are caractere care nu pot fi într-o cheie, sau e prea lungă. Copiaz-o din nou, întreagă."
msgstr "Çelësi përmban karaktere që nuk lejohen në një çelës, ose është tepër i gjatë. Kopjoje përsëri, të gjithin."

msgid "Nu recunosc cheia după formă. Alege serviciul din listă și încearcă din nou; cheia nu a plecat nicăieri."
msgstr "Çelësi nuk identifikohet nga forma e tij. Zgjidh shërbimin nga lista dhe provo përsëri; çelësi nuk është dërguar asgjëkund."

msgid "Regiunea nu e bună: scrie-o exact ca în portalul Azure, de exemplu westeurope."
msgstr "Rajoni nuk është i saktë: shkruaje saktësisht si në portalin Azure, për shembull westeurope."

msgid "Pentru un server din casă scrie întâi adresa lui (pasul cu adresa serverului)."
msgstr "Për një server lokal në shtëpi, shkruaj së pari adresën e tij (hapi i adresës së serverit)."

msgid "Merge deja o configurare. Așteaptă să se termine."
msgstr "Një konfigurim është tashmë në vijim. Prit të përfundojë."

