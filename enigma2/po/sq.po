#, python-format
msgid "Nu am găsit niciun server Ollama sau LibreTranslate în rețeaua %s. Ollama ascultă din fabrică numai pe calculatorul lui, așa că receptorul nu-l vede până nu-l pornești pentru rețea."
msgstr "Nuk u gjet asnjë server Ollama ose LibreTranslate në rrjetin %s. Ollama punon fillimisht vetëm në kompjuterin ku është instaluar, kështu që marrësi nuk e sheh derisa ta aktivizosh për rrjetin."

msgid "Nu am găsit niciun server Ollama sau LibreTranslate. Ollama ascultă din fabrică numai pe calculatorul lui, așa că receptorul nu-l vede până nu-l pornești pentru rețea."
msgstr "Nuk u gjet asnjë server Ollama ose LibreTranslate. Ollama punon fillimisht vetëm në kompjuterin ku është instaluar, kështu që marrësi nuk e sheh derisa ta aktivizosh për rrjetin."

#, python-format
msgid "Căutarea s-a oprit după %d secunde."
msgstr "Kërkimi ndaloi pas %d sekondash."

#, python-format
msgid "Tradu EPG"
msgstr "Përkthe EPG"

msgid "Ce s-a tradus din EPG"
msgstr "Çfarë u përkthye nga EPG"

#, python-format
msgid "%d texte, %d semne"
msgstr "%d tekste, %d shenja"

#, python-format
msgid "Ghidul: texte traduse %d (%d semne trimise, din cota serviciului), cereri %d, deja în limba ta %d, sărite %d."
msgstr "EPG: tekste të përkthyera %d (%d shenja të dërguara, nga kuota e shërbimit), kërkesa %d, tashmë në gjuhën tënde %d, të anashkaluara %d."

#, python-format
msgid "Traduceri ținute minte: %d (%s)."
msgstr "Përkthime të ruajtura: %d (%s)."

msgid "și pe stick sau disc"
msgstr "edhe në USB ose disk"

msgid "numai până la repornire; cu un stick sau un disc se păstrează"
msgstr "vetëm deri në rinisje; me një USB ose disk ato ruhen"

msgid "Traduce automat titlurile și descrierile emisiunilor care sunt pe ecran (bara de jos, a doua bară, ghidul, detaliile emisiunii) în limba traducerii, cu aceleași servicii și chei. Consumă din cota serviciului, de aceea din fabrică e oprită. Textul deja în limba ta nu se trimite, iar o traducere ținută minte nu se mai cere. În detaliile emisiunii, INFO arată textul original."
msgstr "Përkthe automatikisht titujt dhe përshkrimet e emisioneve që janë në ekran (shiriti i poshtëm, shiriti i dytë, udhëzuesi, detajet e emisionit) në gjuhën e përkthimit, me të njëjtat shërbime dhe çelësa. Konsumon nga kuota e shërbimit, prandaj fillimisht është i çaktivizuar. Teksti që është tashmë në gjuhën tënde nuk dërgohet, dhe një përkthim i ruajtur nuk kërkohet sërish. Te detajet e emisionit, INFO tregon tekstin origjinal."

msgid "Cu „Tradu EPG” pornită pleacă la același serviciu și titlurile și descrierile emisiunilor de pe ecran."
msgstr "Me “Tradu EPG” të aktivizuar, dërgohen te i njëjti shërbim edhe titujt dhe përshkrimet e emisioneve në ekran."

msgid "Tradus automat. INFO: textul original."
msgstr "Përkthyer automatikisht. INFO: teksti origjinal."

msgid "Textul original, netradus. INFO: închide."
msgstr "Teksti origjinal, i papërkthyer. INFO: mbyll."

msgid "Tradu automat din orice subtitrare disponibilă"
msgstr "Përkthe automatikisht nga çdo titër i disponueshëm"

msgid "Cu traducerea subtitrărilor pornită, „Tradu automat din orice subtitrare disponibilă” alege singură și o subtitrare în altă limbă, ca să fie tradusă."
msgstr "Me përkthimin e titrave të aktivizuar, “Përkthe automatikisht nga çdo titër i disponueshëm” zgjedh vetë edhe një titër në gjuhë tjetër për ta përkthyer."

msgid "Traducerea subtitrărilor e pornită (în %s): dacă nu există subtitrare în limba aceasta, se alege singură una în altă limbă, întâi teletextul, apoi DVB citită ca text, și se traduce."
msgstr "Përkthimi i titrave është aktiv (në %s): nëse nuk ka titra në këtë gjuhë, zgjidhet automatikisht një në gjuhë tjetër, fillimisht teleteksti, pastaj DVB e lexuar si tekst, dhe përkthehet."

msgid "Traducerea subtitrărilor e pornită (în %s): se alege numai o subtitrare în limba aceasta, apoi preferințele de mai sus."
msgstr "Përkthimi i titrave është aktiv (në %s): zgjidhet vetëm një titër në këtë gjuhë, pastaj preferencat e mësipërme."

msgid "în limba traducerii"
msgstr "në gjuhën e përkthimit"

msgid "teletext tradus automat"
msgstr "teletekst i përkthyer automatikisht"

msgid "DVB citită ca text și tradusă automat"
msgstr "DVB e lexuar si tekst dhe e përkthyer automatikisht"

msgid "Canalul nu a pornit: tunerul e inca ocupat. Alege-l din nou."
msgstr "Kanali nuk nisi: sintonizuesi është ende i zënë. Zgjidhe sërish."

#, python-format
msgid "Pornesc din nou canalul de dinainte (%s)..."
msgstr "Po rinis kanalin e mëparshëm (%s)..."

#, python-format
msgid "Canalul de dinainte (%s) a pornit din nou."
msgstr "Kanali i mëparshëm (%s) nisi sërish."

#, python-format
msgid "Canalul de dinainte (%s) a pornit, dar nu da imagine."
msgstr "Kanali i mëparshëm (%s) nisi, por nuk jep figurë."

#, python-format
msgid "Canalul de dinainte (%s) nu a pornit: tunerul e inca ocupat. Alege-l din nou."
msgstr "Kanali i mëparshëm (%s) nuk nisi: sintonizuesi është ende i zënë. Zgjidhe sërish."

msgid "Tunerul e ocupat (inregistrare sau alt canal). Alege mai tarziu."
msgstr "Sintonizuesi është i zënë (regjistrim ose kanal tjetër). Zgjidh më vonë."

#, python-format
msgid "Nu au venit date de la %s. Tunerul a fost eliberat."
msgstr "Nuk erdhën të dhëna nga %s. Sintonizuesi u lirua."

msgid "Scanarea s-a oprit inainte de sfarsit si nu a salvat nimic. Incearca din nou."
msgstr "Kërkimi ndaloi para përfundimit dhe nuk ruajti asgjë. Provo sërish."

#, python-format
msgid "Detectorul s-a oprit cu codul %s, fara un raspuns care sa se poata citi."
msgstr "Detektori ndaloi me kodin %s, pa një përgjigje që mund të lexohet."

msgid "Raspunsul detectorului nu s-a putut prelucra (detalii in jurnal)."
msgstr "Përgjigjja e detektorit nuk mund të përpunohej (detajet në ditar)."

msgid "În lucru: scanarea salvează posturile DAB+ în lista de canale, dar ascultarea lor nu merge încă pe acest receptor."
msgstr "Në punë e sipër: kërkimi i ruan stacionet DAB+ në listën e kanaleve, por dëgjimi i tyre nuk funksionon ende në këtë marrës."

msgid "Detectorul nu a dat niciun răspuns."
msgstr "Detektori nuk dha asnjë përgjigje."

msgid "Ultimele rânduri de eroare ale detectorului:"
msgstr "Rreshtat e fundit të gabimit nga detektori:"

msgid "Începutul ieșirii care nu s-a putut citi:"
msgstr "Fillimi i rezultatit që nuk mund të lexohej:"

msgid "Ascultarea lor nu merge încă pe acest receptor (în lucru)."
msgstr "Dëgjimi i tyre nuk funksionon ende në këtë marrës (në punë e sipër)."

msgid "Adresa %s e pe internet, iar receptorul trimite pe http:// (necriptat) numai în rețeaua de acasă. Scrie adresa cu https://."
msgstr "Adresa %s është në internet, ndërsa marrësi dërgon në http:// (pa kodim) vetëm brenda rrjetit të shtëpisë. Shkruaj adresën me https://."

msgid "Adresa %s duce chiar la receptor. Receptorul nu are server de traducere: scrie adresa calculatorului din casă sau a serverului din internet (127.0.0.1, localhost, 0.0.0.0, 169.254.x și IP-ul receptorului nu merg)."
msgstr "Adresa %s të çon te vetë marrësi. Marrësi nuk ka server përkthimi: shkruaj adresën e kompjuterit në shtëpi ose të serverit në internet (127.0.0.1, localhost, 0.0.0.0, 169.254.x dhe IP-ja e marrësit nuk funksionojnë)."

msgid "adresa altui aparat, nu a receptorului (127.0.0.1, localhost, 0.0.0.0, 169.254.x și IP-ul receptorului nu merg)"
msgstr "adresa e një pajisjeje tjetër, jo e marrësit (127.0.0.1, localhost, 0.0.0.0, 169.254.x dhe IP-ja e marrësit nuk funksionojnë)"

msgid "Cheia pleacă numai spre adresa serverului de acum: scrie întâi adresa, apoi pune cheia."
msgstr "Çelësi dërgohet vetëm drejt adresës së serverit aktual: shkruaj fillimisht adresën, pastaj vendos çelësin."

msgid "Cheia salvată a fost pusă pentru alt server (%s), deci nu pleacă spre adresa de acum. Dacă serverul cere cheie, pune-o din nou."
msgstr "Çelësi i ruajtur është vendosur për një server tjetër (%s), prandaj nuk dërgohet te adresa aktuale. Nëse serveri kërkon çelës, vendose sërish."

msgid "Cheia salvată nu e legată de adresa de acum, deci nu pleacă nicăieri. Dacă serverul cere cheie, pune-o din nou."
msgstr "Çelësi i ruajtur nuk është i lidhur me adresën aktuale, prandaj nuk dërgohet asgjëkundi. Nëse serveri kërkon çelës, vendose sërish."

msgid "Cheia nu pleacă pe http:// spre internet. Scrie adresa cu https://."
msgstr "Çelësi nuk dërgohet përmes http:// drejt internetit. Shkruaj adresën me https://."

msgid "Atenție: cheia pleacă necriptată (http://) spre serverul din casă. Pune o cheie numai dacă serverul o cere."
msgstr "Kujdes: çelësi dërgohet i pakoduar (http://) drejt serverit në shtëpi. Vendos një çelës vetëm nëse serveri e kërkon."

msgid "Scrie adresa calculatorului din casă (de exemplu http://192.168.1.50:11434) sau a serverului din internet, cu https://."
msgstr "Shkruaj adresën e kompjuterit në shtëpi (për shembull http://192.168.1.50:11434) ose të serverit në internet, me https://."

msgid "O cheie pleacă numai pe https:// sau spre un server din rețeaua de acasă. Scrie adresa cu https://. Cheia nu a plecat nicăieri."
msgstr "Një çelës dërgohet vetëm përmes https:// ose drejt një serveri në rrjetin e shtëpisë. Shkruaj adresën me https://. Çelësi nuk u dërgua asgjëkundi."

msgid "pusă pentru alt server (OK o pune din nou)"
msgstr "vendosur për një server tjetër (OK e vendos sërish)"

msgid "Cheile de traducere trebuie puse din nou: cele salvate înainte nu se mai pot citi pe acest receptor."
msgstr "Çelësat e përkthimit duhen vendosur sërish: ata të ruajtur më parë nuk mund të lexohen më në këtë marrës."

msgid "Cheile de traducere trebuie puse din nou: cele salvate înainte nu se mai pot citi pe acest receptor. Le pui în Meniu › Setări › Sunet și subtitrări › Traducerea subtitrărilor sau de pe telefon, cu codul QR de acolo."
msgstr "Çelësat e përkthimit duhen vendosur sërish: ato të ruajtura më parë nuk mund të lexohen më në këtë marrës. Mund t'i vendosësh te Menyja › Cilësimet › Zëri dhe titrat › Përkthimi i titrave ose nga telefoni, me kodin QR që gjendet aty."

msgid "trebuie pusă din nou (OK o scrie)"
msgstr "duhet vendosur sërish (OK për ta shkruar)"

msgid "Tradu bara de jos"
msgstr "Përkthe shiritin e poshtëm"

msgid "Traduce titlurile emisiunii de acum și ale celei următoare de pe bara de jos, cu aceleași servicii și chei. Merge când traducerea subtitrărilor e pornită și folosește foarte puțin din cotă: fiecare titlu se cere o singură dată. INFO de pe bară arată textul original. Cu „Tradu EPG” pornită, bara se traduce oricum."
msgstr "Përkthen titujt e emisionit të tanishëm dhe të ardhshëm në shiritin e poshtëm, me të njëjtat shërbime dhe çelësa. Funksionon kur është i aktivizuar përkthimi i titrave dhe përdor shumë pak nga kuota: çdo titull kërkohet vetëm një herë. Butoni INFO në shirit shfaq tekstin origjinal. Me „Përkthe EPG” të aktivizuar, shiriti përkthehet gjithsesi."

msgid "Cu „Tradu bara de jos” pornită pleacă la același serviciu și titlurile emisiunilor de pe bara de jos."
msgstr "Me „Përkthe shiritin e poshtëm” të aktivizuar, edhe titujt e emisioneve në shiritin e poshtëm shkojnë te i njëjti shërbim."

msgid "Textul original. Pe bara de jos, titlul e tradus automat."
msgstr "Teksti origjinal. Në shiritin e poshtëm, titulli është i përkthyer automatikisht."

msgid "Ai schimbat setările traducerii. Le salvezi?"
msgstr "I ndryshove cilësimet e përkthimit. Dëshiron t'i ruash?"

msgid "OK probează"
msgstr "OK e teston"

msgid "OK le deschide"
msgstr "OK i hap ato"

msgid "OK trimite o frază de probă serviciului ales. Răspunsul apare aici, iar originalul și traducerea se văd jos, ca subtitrările."
msgstr "OK i dërgon një frazë provuese shërbimit të zgjedhur. Përgjigjja shfaqet këtu, ndërsa origjinali dhe përkthimi shihen poshtë, si titrat."

msgid "OK deschide pașii pentru serviciul ales: contul, cheia gratuită, cota și ce se întâmplă la depășire."
msgstr "OK hap hapat për shërbimin e zgjedhur: llogarinë, çelësin pa pagesë, kuotën dhe çfarë ndodh nëse e tejkalon."

msgid "lipsește (OK îl scrie)"
msgstr "mungon (shtyp OK për ta shkruar)"

msgid "fără cheie"
msgstr "pa çelës"

msgid "fără adresă"
msgstr "pa adresë"

msgid "fără model"
msgstr "pa model"

msgid "de completat"
msgstr "për t'u plotësuar"

msgid "Dacă foloseai o cheie pentru acest server, pune-o din nou."
msgstr "Nëse përdorje një çelës për këtë server, fute sërish."

