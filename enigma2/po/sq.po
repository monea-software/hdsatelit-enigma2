msgstr "Sintonizuesi B (Kabllor/Tokësor DVB-C/T2)"

msgid "Cauți și adaugi canale de satelit, de cablu sau de antenă terestră."
msgstr "Kërkon dhe shton kanale satelitore, kabllore ose tokësore."

msgid "Alegi cum cauți canalele recepționate cu antena de satelit."
msgstr "Zgjedh se si t'i kërkosh kanalet e marra me antenën satelitore."

msgid "Cauți canalele de pe o singură frecvență de satelit."
msgstr "Kërkon kanalet në një frekuencë të vetme satelitore."

msgid "Cauți canalele disponibile pe un satelit ales de tine."
msgstr "Kërkon kanalet e disponueshme në një satelit të zgjedhur nga ti."

msgid "Bifezi sateliții pe care vrei să cauți canale."
msgstr "Zgjedh satelitët në të cilët dëshiron të kërkosh kanale."

msgid "Cauți frecvențe și canale fără o listă de frecvențe cunoscute."
msgstr "Kërkon frekuenca dhe kanale pa një listë të njohur frekuencash."

msgid "Cauți canalele furnizorului de televiziune prin satelit ales."
msgstr "Kërkon kanalet e ofruesit të zgjedhur të televizionit satelitor."

msgid "Introduci datele de recepție pentru a căuta canale prin satelit."
msgstr "Fut të dhënat e marrjes për të kërkuar kanale satelitore."

msgid "Cauți canalele terestre retransmise prin satelit."
msgstr "Kërkon kanalet tokësore të ritransmetuara përmes satelitit."

msgid "Cauți posturile de radio digital retransmise prin satelit."
msgstr "Kërkon stacionet e radios dixhitale të ritransmetuara përmes satelitit."

msgid "Alegi cum cauți canalele primite prin cablul de televiziune."
msgstr "Zgjedh se si t'i kërkosh kanalet e marra përmes kabllit televiziv."

msgid "Cauți canalele de cablu pe o frecvență aleasă de tine."
msgstr "Kërkon kanalet kabllore në një frekuencë të zgjedhur nga ti."

msgid "Cauți canale pe întregul interval de frecvențe al televiziunii prin cablu."
msgstr "Kërkon kanale në të gjithë intervalin e frekuencave të televizionit kabllor."

msgid "Cauți canalele furnizorului tău de televiziune prin cablu."
msgstr "Kërkon kanalet e ofruesit tënd të televizionit kabllor."

msgid "Introduci datele de recepție pentru a căuta canale pe cablu."
msgstr "Fut të dhënat e marrjes për të kërkuar kanale kabllore."

msgid "Pornești căutarea automată a canalelor de televiziune prin cablu."
msgstr "Nis kërkimin automatik të kanaleve të televizionit kabllor."

msgid "Alegi cum cauți canalele primite cu o antenă terestră."
msgstr "Zgjedh se si t'i kërkosh kanalet e marra me një antenë tokësore."

msgid "Cauți posturile TV de pe un singur canal de emisie terestră."
msgstr "Kërkon kanale TV në një multiplex të vetëm tokësor."

msgid "Cauți posturi TV pe toate frecvențele de emisie terestră."
msgstr "Kërkon kanale TV në të gjitha frekuencat e transmetimit tokësor."

msgid "Cauți posturile TV terestre pentru zona sau furnizorul ales."
msgstr "Kërkon kanale TV tokësore për zonën ose ofruesin e zgjedhur."

msgid "Introduci datele de recepție pentru a căuta posturi TV terestre."
msgstr "Fut të dhënat e marrjes për të kërkuar kanale TV tokësore."

msgid "Pornești căutarea automată a posturilor TV prin antena terestră."
msgstr "Fillon kërkimin automatik të kanaleve TV përmes antenës tokësore."

msgid "Asculți radio digital DAB+ cu un stick USB de recepție radio."
msgstr "Dëgjon radio dixhitale DAB+ me një stik USB për marrjen e radios."

msgid "Receptorul trece singur prin canale și notează imaginea, sunetul și codarea fiecăruia."
msgstr "Marrësi kontrollon automatikisht çdo kanal, duke regjistruar statusin e figurës, zërit dhe kodimit të tij."

msgid "Aranjezi canalele și grupurile lor cu telecomanda sau tastatura."
msgstr "Rendit kanalet dhe grupet e tyre me telekomandë ose tastierë."

msgid "Aduci canalele și setările salvate pe un stick sau din alt receptor."
msgstr "Importon kanalet dhe cilësimet e ruajtura nga një USB ose nga një marrës tjetër."

msgid "Găsești liste gata făcute, dacă există, sau mergi la căutare și import."
msgstr "Gjen lista të gatshme, nëse janë të disponueshme, ose kalon te kërkimi dhe importimi."

msgid "Reglezi recepția și direcția antenei pentru a obține semnal."
msgstr "Rregullon marrjen dhe drejtimin e antenës për të marrë sinjal."

msgid "Alegi cum sunt conectate și folosite intrările de semnal ale receptorului."
msgstr "Zgjedh se si lidhen dhe përdoren hyrjet e sinjalit të marrësit."

msgid "Alegi tipul convertorului de pe brațul antenei și frecvențele lui."
msgstr "Zgjedh llojin e LNB-së në krahun e antenës dhe frekuencat e tij."

msgid "Miști antena cu motor spre satelitul pe care vrei să îl recepționezi."
msgstr "Lëviz antenën me motor drejt satelitit që dëshiron të marrësh."

msgid "Introduci poziția geografică a locului unde este instalată antena."
msgstr "Fut pozicionin gjeografik të vendit ku është instaluar antena."

msgid "Afli unghiurile necesare pentru a îndrepta antena spre satelitul ales."
msgstr "Gjen këndet e nevojshme për të drejtuar antenën drejt satelitit të zgjedhur."

msgid "Urmărești nivelul și calitatea recepției în timp ce reglezi antena."
msgstr "Monitoron nivelin dhe cilësinë e marrjes ndërsa rregullon antenën."

msgid "Verifici comutarea între sursele de semnal ale instalației de satelit."
msgstr "Verifikon kalimin midis burimeve të sinjalit të instalimit satelitor."

msgid "Programezi înregistrarea emisiunilor și verifici programările existente."
msgstr "Programon regjistrimin e emisioneve dhe kontrollon kohëmatësit ekzistues."

msgid "Vezi date despre receptor, recepție, memorie, discuri și rețea."
msgstr "Shikon të dhëna rreth marrësit, marrjes, memories, disqeve dhe rrjetit."

msgid "Vezi de ce interfața a pornit în modul sigur, după opriri neașteptate repetate."
msgstr "Shikon pse ndërfaqja filloi në modalitetin e sigurt, pas ndalimeve të papritura të përsëritura."

msgid "Vezi versiunea și detaliile imaginii instalate pe receptor."
msgstr "Shikon versionin dhe detajet e imazhit të instaluar në marrës."

msgid "Citești condițiile de folosire ale programelor și afli unde este codul sursă."
msgstr "Lexon kushtet e përdorimit të programeve dhe zbulon se ku ndodhet kodi burimor."

msgid "Citești noutățile și schimbările aduse de fiecare versiune a imaginii."
msgstr "Lexon të rejat dhe ndryshimet e sjella nga çdo version i imazhit."

msgid "Vezi modelul receptorului și date despre componentele sale."
msgstr "Shikon modelin e marrësit dhe të dhënat për komponentët e tij."

msgid "Vezi ce componente de recepție are receptorul și detaliile lor."
msgstr "Shikon cilët sintonizues ka marrësi dhe detajet e tyre."

msgid "Vezi câtă memorie este folosită și câtă mai este disponibilă."
msgstr "Shikon sa memorie është përdorur dhe sa është ende e disponueshme."

msgid "Vezi discurile conectate și spațiul disponibil pentru fișiere."
msgstr "Shikon disqet e lidhura dhe hapësirën e disponueshme për skedarët."

msgid "Vezi starea conexiunilor receptorului și adresele din rețea."
msgstr "Shikon statusin e lidhjeve të marrësit dhe adresat në rrjet."

msgid "Vezi starea legăturii video și ce formate acceptă televizorul conectat."
msgstr "Shikon statusin e lidhjes video dhe cilat formate pranon televizori i lidhur."

msgid "Vezi datele de recepție, imagine și sunet ale canalului urmărit."
msgstr "Shikon të dhënat e marrjes, figurës dhe zërit të kanalit që po ndjek."

msgid "Citești și cauți instrucțiuni de folosire chiar și fără internet."
msgstr "Lexon dhe kërkon udhëzime përdorimi edhe pa internet."

msgid "Vezi verificările de la pornire și codurile problemelor găsite."
msgstr "Shikon verifikimet gjatë nisjes dhe kodet e problemeve të gjetura."

msgid "Găsești programele suplimentare disponibile pe receptor."
msgstr "Gjen programet shtesë të disponueshme në marrës."

msgid "Toate setările receptorului, grupate pe teme."
msgstr "Të gjitha cilësimet e marrësit, të grupuara sipas temave."

msgid "Cauți o opțiune după cuvinte și deschizi direct ecranul găsit."
msgstr "Kërkon një opsion sipas fjalëve dhe hap direkt ekranin e gjetur."

msgid "Reglezi accesul la televiziune, radio și alte servicii prin internet."
msgstr "Rregullon aksesin në televizion, radio dhe shërbime të tjera përmes internetit."

msgid "Găsești și asculți posturi de radio transmise prin internet."
msgstr "Gjen dhe dëgjon stacione radioje të transmetuara përmes internetit."

msgid "Configurezi sursele de canale TV prin internet în format DVB-I."
msgstr "Konfiguron burimet e kanaleve TV përmes internetit në formatin DVB-I."

msgid "Reîncarci acum lista de canale TV din sursele DVB-I configurate."
msgstr "Ringarkon tani listën e kanaleve TV nga burimet DVB-I të konfiguruara."

msgid "Reglezi recepția TV prin fluxuri trimise simultan mai multor aparate."
msgstr "Rregullon marrjen TV përmes flukseve të dërguara njëkohësisht në disa pajisje."

msgid "Adaugi liste sau conturi pentru a primi canale TV prin internet."
msgstr "Shton lista ose llogari për të marrë kanale TV përmes internetit."

msgid "Pornești sau oprești funcțiile pentru canalele primite prin internet."
msgstr "Aktivizon ose çaktivizon funksionet për kanalet e marra përmes internetit."

msgid "Verifici ce canale prin internet transmit cu adevărat la rezoluție 4K."
msgstr "Verifikon cilat kanale përmes internetit transmetojnë vërtet në rezolucion 4K."

msgid "Alegi ce vrei să urmărești din catalogul contului tău de televiziune prin internet."
msgstr "Zgjedh çfarë dëshiron të ndjekësh nga katalogu i llogarisë sate të televizionit përmes internetit."

msgid "Reglezi interfața web, prin care comanzi receptorul din browser."
msgstr "Rregullon ndërfaqen web, përmes së cilës komandon marrësin nga shfletuesi."

msgid "Alegi pagina de pornire, mărimea textului și preferințele de navigare."
msgstr "Zgjedh faqen e fillimit, madhësinë e tekstit dhe preferencat e shfletimit."

msgid "Găsești reglajele pentru imaginea trimisă de receptor la televizor."
msgstr "Gjen rregullimet për figurën e dërguar nga marrësi në televizor."

msgid "Alegi rezoluția, frecvența și culorile imaginii trimise la televizor."
msgstr "Zgjedh rezolucionin, frekuencën dhe ngjyrat e figurës së dërguar në televizor."

msgid "Reglezi proporțiile și claritatea imaginii afișate pe televizor."
msgstr "Rregullon raportin e pamjes dhe mprehtësinë e figurës në televizor."

msgid "Alegi profilurile de prelucrare a imaginii și redarea cu luminozitate extinsă."
msgstr "Zgjedh profilet e përpunimit të figurës dhe cilësimet e riprodhimit HDR."

msgid "Găsești reglajele de sunet și preferințele pentru limbi și subtitrări."
msgstr "Gjen cilësimet e zërit dhe preferencat për gjuhët dhe titrat."

msgid "Alegi cum ajunge sunetul la televizor sau la sistemul audio."
msgstr "Zgjedh se si arrin zëri te televizori ose te sistemi audio."

msgid "Reglezi nivelul sonor și sincronizarea sunetului cu imaginea."
msgstr "Rregullon volumin dhe sinkronizimin e zërit me figurën."

msgid "Reglezi tonurile sunetului pe 10 benzi, cu presetări și modul de noapte."
msgstr "Rregullon tonet e zërit në 10 breza, me paracaktime dhe modalitetin e natës."

msgid "Alegi limbile preferate pentru ce auzi și pentru textul de pe ecran."
msgstr "Zgjedh gjuhët e preferuara për atë që dëgjon dhe për tekstin në ekran."

msgid "Schimbi mărimea, culorile și poziția textului afișat peste imagine."
msgstr "Ndryshon madhësinë, ngjyrat dhe pozicionin e tekstit të shfaqur mbi figurë."

msgid "Alegi serviciul care traduce automat textul subtitrărilor."
msgstr "Zgjedh shërbimin që përkthen automatikisht tekstin e titrave."

msgid "Alegi cum sunt citite și preferate fișierele cu text de lângă film."
msgstr "Zgjedh se si lexohen dhe preferohen skedarët me tekst pranë filmit."

msgid "Cauți pe internet fișiere cu textul dialogurilor și configurezi accesul."
msgstr "Kërkon në internet skedarë me tekstin e dialogëve dhe konfiguron qasjen."

msgid "Alegi ce apare pe televizor când asculți un post de radio."
msgstr "Zgjedh se çfarë shfaqet në televizor kur dëgjon një stacion radioje."

msgid "Găsești reglajele pentru salvarea emisiunilor și folosirea discurilor."
msgstr "Gjen cilësimet për regjistrimin e emisioneve dhe përdorimin e disqeve."

msgid "Alegi discul pe care salvezi emisiunile și verifici spațiul liber."
msgstr "Zgjedh diskun ku ruan emisionet dhe kontrollon hapësirën e lirë."

msgid "Alegi dosarele folosite pentru salvarea emisiunilor înregistrate."
msgstr "Zgjedh dosjet e përdorura për ruajtjen e emisioneve të regjistruara."

msgid "Alegi numele fiecărui disc în /media și îl demontezi ca să-l scoți în siguranță."
msgstr "Zgjedh emrin e çdo disku në /media dhe e çmonton për ta hequr në mënyrë të sigurt."

msgid "Pregătești discul pentru folosire, ștergând toate datele de pe el."
msgstr "Përgatit diskun për përdorim, duke fshirë të gjitha të dhënat në të."

msgid "Verifici discul pentru a găsi eventuale probleme de stocare."
msgstr "Kontrollon diskun për të gjetur probleme të mundshme të ruajtjes."

msgid "Alegi după cât timp se oprește singur discul când nu e folosit."
msgstr "Zgjedh pas sa kohësh ndalet vetë disku kur nuk përdoret."

msgid "Configurezi un fișier pe disc folosit ca memorie suplimentară."
msgstr "Konfiguron një skedar në disk që përdoret si memorie shtesë."

msgid "Schimbi felul în care arată meniurile și textele de pe ecran."
msgstr "Ndryshon mënyrën se si duken menytë dhe tekstet në ekran."

msgid "Alegi o temă completă pentru meniurile și ferestrele receptorului."
msgstr "Zgjedh një temë të plotë për menytë dhe dritaret e marrësit."

msgid "Alegi varianta Clasic sau Pro pentru meniurile de pe televizor."
msgstr "Zgjedh variantin Klasik ose Pro për menytë në televizor."

msgid "Alegi imaginea din spatele meniurilor când folosești varianta Pro."
msgstr "Zgjedh figurën prapa menyve kur përdor variantin Pro."

msgid "Adaugi siglele canalelor de pe un stick sau de pe internet."
msgstr "Shton logot e kanaleve nga një USB ose nga interneti."

msgid "Alegi cât de detaliat sunt desenate meniurile pe televizor."
msgstr "Zgjedh sa të detajuara janë vizatuar menytë në televizor."

msgid "Alegi paleta de culori a meniurilor și pagina tehnică a temei."
msgstr "Zgjedh paletën e ngjyrave të menyve dhe faqen teknike të temës."

msgid "Alegi limba în care apar meniurile și mesajele receptorului."
msgstr "Zgjedh gjuhën në të cilën shfaqen menytë dhe mesazhet e marrësit."

msgid "Reglezi felul în care sunt afișate informațiile și meniurile pe televizor."
msgstr "Rregullon mënyrën se si shfaqen informacionet dhe menytë në televizor."

msgid "Schimbi felul în care sunt afișate posturile în lista de selecție."
msgstr "Ndryshon mënyrën se si shfaqen kanalet në listën e përzgjedhjes."

msgid "Alegi ce apare pe micul ecran de pe panoul frontal al receptorului."
msgstr "Zgjedh se çfarë shfaqet në ekranin e vogël në panelin e përparmë të marrësit."

msgid "Alegi ce apare pe ecranul color de pe panoul frontal al receptorului."
msgstr "Zgjedh se çfarë shfaqet në ekranin me ngjyra në panelin e përparmë të marrësit."

msgid "Reglezi ecranul frontal și luminile de semnalizare ale receptorului."
msgstr "Rregullon ekranin e përparmë dhe dritat treguese të marrësit."

msgid "Mărești sau micșorezi literele afișate în meniurile receptorului."
msgstr "Zmadhon ose zvogëlon shkronjat e shfaqura në menytë e marrësit."

msgid "Alegi forma literelor din meniuri dintre variantele deja instalate."
msgstr "Zgjedh formën e shkronjave në meny nga variantet e instaluara tashmë."

msgid "Potrivești marginile meniurilor astfel încât să încapă pe televizor."
msgstr "Përshtat skajet e menyve në mënyrë që të shfaqen siç duhet në televizor."

msgid "Alegi alte forme de litere pentru textele afișate pe ecran."
msgstr "Zgjedh forma të tjera shkronjash për tekstet e shfaqura në ekran."

msgid "Alegi imaginea afișată când pornește receptorul, inclusiv o fotografie proprie."
msgstr "Zgjedh figurën që shfaqet kur ndizet marrësi, duke përfshirë një fotografi tuajën."

msgid "Alegi și probezi imaginea de odihnă a ecranului."
msgstr "Zgjedh dhe provon pamjen e pushimit të ekranit (screensaver)."

msgid "Găsești reglajele de recepție, căutarea canalelor și orientarea antenei."
msgstr "Gjen cilësimet e marrjes, kërkimin e kanaleve dhe orientimin e antenës."

msgid "Găsești reglajele și starea modulelor care deschid canalele codate."
msgstr "Gjen cilësimet dhe gjendjen e moduleve që hapin kanalet e koduara."

msgid "Pornești, oprești și configurezi programele care deschid canalele codate."
msgstr "Nis, ndalon dhe konfiguron programet që hapin kanalet e koduara."

msgid "Vezi detalii despre deschiderea canalelor codate."
msgstr "Shiko detajet rreth dekriptimit të kanaleve."

msgid "Reglezi releul prin care trec canalele alese din lista de canale."
msgstr "Konfiguro Stream Relay për kanalet e zgjedhura në listën e kanaleve."

msgid "Vezi și reglezi modulele CI puse în sloturile receptorului."
msgstr "Shiko dhe konfiguro modulet CI të vendosura në slotet e marrësit."

msgid "Limitezi printr-un cod accesul la canale și la opțiunile receptorului."
msgstr "Kufizo aksesin në kanale dhe opsionet e marrësit me një kod PIN."

msgid "Găsești actualizările și copiile de siguranță ale imaginii și setărilor."
msgstr "Gjej përditësimet dhe kopjet rezervë të imazhit dhe cilësimeve."

msgid "Cauți versiuni noi ale programelor, vezi schimbările și alegi instalarea."
msgstr "Kërko për përditësime softueri, shiko ndryshimet dhe zgjidh instalimin e tyre."

msgid "Instalezi imaginea receptorului dintr-un fișier de pe stick."
msgstr "Instalo imazhin e marrësit nga një skedar në USB."

msgid "Descarci pe stick o imagine completă de pe internet, gata de instalat."
msgstr "Shkarko një imazh të plotë nga interneti në USB, gati për instalim."

msgid "Salvezi setările pe stick sau pe disc și le poți pune la loc."
msgstr "Ruaj cilësimet në USB ose disk dhe mund t'i rikthesh ato."

msgid "Salvezi toată imaginea pe stick sau pe disc, ca s-o poți pune din nou."
msgstr "Ruaj të gjithë imazhin në USB ose disk, në mënyrë që ta rikthesh atë."

msgid "Găsești opțiunile de conectare, partajare și acces la receptor prin rețea."
msgstr "Gjej opsionet për lidhjen, ndarjen dhe aksesin në marrës përmes rrjetit."

msgid "Conectezi receptorul la rețeaua de acasă prin cablu sau fără fir."
msgstr "Lidh marrësin me rrjetin e shtëpisë përmes kabllit ose Wi-Fi."

msgid "Alegi cât de des verifică receptorul legătura la internet."
msgstr "Zgjidh sa shpesh marrësi kontrollon lidhjen në internet."

msgid "Alegi trecerea automată la altă conexiune când cea folosită nu mai merge."
msgstr "Zgjidh kalimin automatik në një lidhje tjetër kur ajo në përdorim ndalon së funksionuari."

msgid "Vezi ce frecvențe sunt folosite de rețelele fără fir din apropiere."
msgstr "Shiko cilat frekuenca përdoren nga rrjetet pa tel në afërsi."

msgid "Vezi dispozitivele găsite în aceeași rețea cu receptorul."
msgstr "Shiko pajisjet e gjetura në të njëjtin rrjet me marrësin."

msgid "Activezi sau oprești folosirea adreselor de rețea în format nou."
msgstr "Aktivizo ose çaktivizo përdorimin e formatit të ri të adresave të rrjetit."

msgid "Alegi dosarul receptorului pe care îl faci accesibil altor aparate din rețea."
msgstr "Zgjidh dosjen e marrësit që dëshiron ta ndash me pajisje të tjera në rrjet."

msgid "Alegi serverele care transformă numele paginilor de internet în adrese."
msgstr "Zgjidh serverët që përkthejnë emrat e faqeve të internetit në adresa."

msgid "Pui o parolă pentru accesul din rețea și alegi unde este cerută."
msgstr "Vendos një fjalëkalim për aksesin në rrjet dhe zgjidh ku kërkohet ai."

msgid "Configurezi o conexiune privată și alegi ce trafic trece prin ea."
msgstr "Konfiguro një lidhje private dhe zgjidh se cili trafik kalon përmes saj."

msgid "Vezi și oprești redările canalelor în interfața web și reglezi transmisia."
msgstr "Shiko dhe ndalo transmetimet e kanaleve në ndërfaqen web dhe rregullo cilësimet e transmetimit."

msgid "Găsești reglajele receptorului, ale comenzilor și ale dispozitivelor conectate."
msgstr "Gjej cilësimet për marrësin, komandat e tij dhe pajisjet e lidhura."

msgid "Pui pe un stick limbile și completările care nu încap în memoria receptorului."
msgstr "Ruaj në një USB gjuhët dhe shtesat që nuk zënë vend në memorien e marrësit."

msgid "Potrivești ceasul receptorului și alegi de unde se actualizează."
msgstr "Rregullo orën e marrësit dhe zgjidh burimin e saj të përditësimit."

msgid "Vezi și reglezi paza care repornește receptorul când se blochează."
msgstr "Shiko dhe rregullo mekanizmin e mbrojtjes që rinis marrësin kur ai bllokohet."

msgid "Alegi modul de lucru și protecția împotriva încălzirii excesive."
msgstr "Zgjidh mënyrën e punës së procesorit dhe mbrojtjen nga mbinxehja."

msgid "Alegi datele și mesajele care se succed pe cele patru cifre ale receptorului."
msgstr "Zgjidh të dhënat dhe mesazhet që shfaqen me radhë në ekranin me katër shifra të marrësit."

msgid "Reglezi felul în care receptorul răspunde la apăsarea tastelor telecomenzii."
msgstr "Rregullo mënyrën se si marrësi përgjigjet ndaj shtypjes së butonave të telekomandës."

msgid "Alegi codul prin care receptorul recunoaște comenzile de la telecomandă."
msgstr "Zgjidh kodin me të cilin marrësi njeh komandat nga telekomanda."

msgid "Probezi tastele, citești codurile și asociezi alt dispozitiv de comandă."
msgstr "Testo butonat, lexo kodet e tyre dhe çifto një pajisje tjetër komanduese."

msgid "Alegi aranjarea tastelor pentru tastatura conectată la receptor."
