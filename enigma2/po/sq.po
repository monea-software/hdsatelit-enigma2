msgstr "Hyr në portal.azure.com, kërko “Translator” në shiritin e sipërm dhe nis një burim të ri (“Create”)."

msgid "La „Resource group” apasă „Create new” și scrie orice nume. La „Region” alege „Global”, la „Name” scrie un nume al tău, iar la „Pricing tier” alege „Free F0”."
msgstr "Te “Resource group” shtyp “Create new” dhe shkruaj çfarëdo emri. Te “Region” zgjidh “Global”, te “Name” shkruaj një emër tëndin dhe te “Pricing tier” zgjidh “Free F0”."

msgid "Apasă „Review + create”, apoi „Create”. Când e gata, apasă „Go to resource”."
msgstr "Shtyp “Review + create”, pastaj “Create”. Kur të jetë gati, shtyp “Go to resource”."

msgid "În stânga alege „Keys and Endpoint” și copiază „KEY 1”. Dacă nu ai ales „Global”, notează și regiunea (de exemplu westeurope)."
msgstr "Në të majtë zgjidh “Keys and Endpoint” dhe kopjo “KEY 1”. Nëse nuk ke zgjedhur “Global”, shëno edhe rajonin (për shembull westeurope)."

msgid "Pune cheia aici (și regiunea, dacă resursa nu e „Global”)."
msgstr "Vendose çelësin këtu (dhe rajonin, nëse burimi nuk është “Global”)."

msgid "În primele 30 de zile trece abonamentul pe „Pay as you go”, altfel Microsoft oprește contul gratuit. Resursa „Free F0” rămâne gratuită."
msgstr "Brenda 30 ditëve të para kaloje pajtimin në “Pay as you go”, përndryshe Microsoft e ndalon llogarinë falas. Burimi “Free F0” mbetet falas."

msgid "2.000.000 de caractere pe lună, gratuit."
msgstr "2.000.000 karaktere në muaj, falas."

msgid "Traducerea se oprește (eroarea 403) până luna următoare. Pe „Free F0” nu se plătește nimic."
msgstr "Përkthimi ndalet (gabimi 403) deri në muajin tjetër. Te “Free F0” nuk paguan asgjë."

msgid "Intră pe console.cloud.google.com cu contul tău Google și fă un proiect nou."
msgstr "Hyr në console.cloud.google.com me llogarinë tënde Google dhe krijo një projekt të ri."

msgid "Activează facturarea: Google cere un card la înscriere (90 de zile de probă)."
msgstr "Aktivizo faturimin: Google kërkon një kartë gjatë regjistrimit (90 ditë provë)."

msgid "Caută „Cloud Translation API” în bara de sus și apasă „Enable”."
msgstr "Kërko “Cloud Translation API” në shiritin e sipërm dhe shtyp “Enable”."

msgid "Mergi la „APIs & Services”, „Credentials”, „Create credentials”, „API key” și copiază cheia."
msgstr "Shko te “APIs & Services”, “Credentials”, “Create credentials”, “API key” dhe kopjo çelësin."

msgid "Apasă pe cheie, la „API restrictions” alege „Restrict key”, bifează „Cloud Translation API” și apasă „Save”."
msgstr "Shtyp mbi çelësin, te “API restrictions” zgjidh “Restrict key”, shëno “Cloud Translation API” dhe shtyp “Save”."

msgid "Ca să nu plătești: „APIs & Services”, „Cloud Translation API”, fila „Quotas”, cota de caractere pe zi, „Edit quotas”, scrie 15000. O alertă de buget NU oprește plata."
msgstr "Që të mos paguash: “APIs & Services”, “Cloud Translation API”, skeda “Quotas”, kuota e karaktereve në ditë, “Edit quotas”, shkruaj 15000. Një paralajmërim buxheti NUK e ndalon pagesën."

msgid "Pune cheia aici."
msgstr "Vendose çelësin këtu."

msgid "Primele 500.000 de caractere pe lună sunt gratuite."
msgstr "500.000 karakteret e para në muaj janë falas."

msgid "Peste cotă se plătește automat (20 de dolari pe milion de caractere), dacă nu ai coborât cota pe zi. Cu cota coborâtă, traducerea se oprește până a doua zi."
msgstr "Mbi kuotën paguhet automatikisht (20 dollarë për milion karaktere), nëse nuk e ke ulur kuotën ditore. Me kuotën e ulur, përkthimi ndalet deri të nesërmen."

msgid "Intră pe deepl.com/en/developers și apasă „Get a free API key”. DeepL nu cere card."
msgstr "Hyr në deepl.com/en/developers dhe shtyp “Get a free API key”. DeepL nuk kërkon kartë."

msgid "Dacă ai deja cont la traducătorul DeepL, ieși din el și fă un cont nou, separat, pentru API."
msgstr "Nëse ke tashmë një llogari te përkthyesi DeepL, dil prej saj dhe krijo një llogari të re, të veçantë, për API."

msgid "Alege planul gratuit „DeepL API Developer” și termină înscrierea."
msgstr "Zgjidh planin falas “DeepL API Developer” dhe përfundo regjistrimin."

msgid "În cont mergi la „API Keys” („API Keys & Limits”). Dacă nu ai nicio cheie, apasă „Create key”, scrie un nume și apasă din nou „Create key”."
msgstr "Në llogari shko te “API Keys” (“API Keys & Limits”). Nëse nuk ke asnjë çelës, shtyp “Create key”, shkruaj një emër dhe shtyp përsëri “Create key”."

msgid "Copiază cheia cu iconița de lângă ea și pune-o aici."
msgstr "Kopjo çelësin me ikonën përbri dhe vendose këtu."

msgid "Cont nou: 1.000.000 de caractere în total, o singură dată, nu în fiecare lună. O cheie veche „DeepL API Free” (se termină cu :fx) are 500.000 de caractere pe lună."
msgstr "Llogari e re: 1.000.000 karaktere në total, vetëm një herë, jo çdo muaj. Një çelës i vjetër “DeepL API Free” (përfundon me :fx) ka 500.000 karaktere në muaj."

msgid "Traducerea se oprește (eroarea 456). Nu se plătește nimic singur; pentru mai mult trebuie un plan plătit."
msgstr "Përkthimi ndalet (gabimi 456). Nuk paguhet asgjë automatikisht; për më shumë duhet një plan me pagesë."

msgid "Pe un calculator din casă instalează Docker Desktop (docs.docker.com) și pornește-l."
msgstr "Në një kompjuter në shtëpi instalo Docker Desktop (docs.docker.com) dhe nise."

msgid "În PowerShell scrie o singură comandă: docker run -d --restart unless-stopped --name libretranslate -p 5000:5000 -v lt-local:/home/libretranslate/.local libretranslate/libretranslate --load-only en,ro,de,fr,it,es,hu"
msgstr "Në PowerShell shkruaj një komandë të vetme: docker run -d --restart unless-stopped --name libretranslate -p 5000:5000 -v lt-local:/home/libretranslate/.local libretranslate/libretranslate --load-only en,ro,de,fr,it,es,hu"

msgid "La prima pornire așteaptă câteva minute (descarcă limbile). Deschide http://localhost:5000 în browser: dacă apare pagina de traducere, merge."
msgstr "Në nisjen e parë prit pak minuta (shkarkon gjuhët). Hap http://localhost:5000 në shfletues: nëse shfaqet faqja e përkthimit, funksionon."

msgid "Află adresa calculatorului în rețea (de exemplu 192.168.1.50) și scrie aici http://192.168.1.50:5000. Cheie nu trebuie."
msgstr "Gjej adresën e kompjuterit në rrjet (për shembull 192.168.1.50) dhe shkruaj këtu http://192.168.1.50:5000. Çelësi nuk nevojitet."

msgid "Calculatorul trebuie să fie pornit când vrei traducere."
msgstr "Kompjuteri duhet të jetë i ndezur kur dëshiron përkthim."

msgid "Nu are cotă: e gratuit și fără limită; viteza depinde de calculator. Serviciul de pe libretranslate.com nu are variantă gratuită."
msgstr "Nuk ka kuotë: është falas dhe pa kufizim; shpejtësia varet nga kompjuteri. Shërbimi në libretranslate.com nuk ka variant falas."

msgid "Nu e cazul."
msgstr "Nuk aplikohet."

msgid "Intră pe aistudio.google.com cu contul tău Google (de la 18 ani) și acceptă termenii."
msgstr "Hyr në aistudio.google.com me llogarinë tënde Google (mbi 18 vjeç) dhe prano kushtet."

msgid "Deschide pagina „API Keys” din meniul din stânga și apasă „Create API key”."
msgstr "Hap faqen “API Keys” nga menyja në të majtë dhe shtyp “Create API key”."

msgid "Copiază cheia și pune-o aici. Nu adăuga card (facturare) la proiect: așa rămâi pe gratuit."
msgstr "Kopjo çelësin dhe vendose këtu. Mos shto kartë (faturim) te projekti: kështu mbetesh te niveli falas."

msgid "Modelul recomandat e gemini-3.5-flash-lite; e scris deja."
msgstr "Modeli i rekomanduar është gemini-3.5-flash-lite; është shkruar tashmë."

msgid "Câte cereri ai pe zi vezi la aistudio.google.com/rate-limit."
msgstr "Se sa kërkesa ke në ditë mund ta shohësh te aistudio.google.com/rate-limit."

msgid "Gratuit, cu un număr limitat de cereri pe minut și pe zi; Google arată cifrele numai în contul tău."
msgstr "Falas, me një numër të kufizuar kërkesash në minutë dhe në ditë; Google i shfaq shifrat vetëm në llogarinë tënde."

msgid "Cererile primesc eroarea 429 până a doua zi (în jurul orei 10, ora României). Fără card nu se plătește nimic."
msgstr "Kërkesat marrin gabimin 429 deri të nesërmen (rreth orës 10, sipas orës rumune). Pa kartë nuk paguhet asgjë."

msgid "Cel mai simplu, în casă: instalează Ollama de pe ollama.com pe un calculator și pornește-l."
msgstr "Më e thjeshta, në shtëpi: instalo Ollama nga ollama.com në një kompjuter dhe nise."

msgid "În PowerShell scrie: ollama pull gemma3:4b (3,3 GB; pentru un calculator slab, gemma3:1b, 815 MB)."
msgstr "Në PowerShell shkruaj: ollama pull gemma3:4b (3,3 GB; për një kompjuter të dobët, gemma3:1b, 815 MB)."

msgid "Ca să-l vadă receptorul: închide Ollama de lângă ceas („Quit”). În Setări caută „environment variables”, alege „Edit environment variables for your account”, apasă „New”, scrie OLLAMA_HOST cu valoarea 0.0.0.0:11434, apoi OK, și pornește din nou Ollama."
msgstr "Që ta shohë marrësi: mbyll Ollama te ora (“Quit”). Te Cilësimet kërko “environment variables”, zgjidh “Edit environment variables for your account”, shtyp “New”, shkruaj OLLAMA_HOST me vlerën 0.0.0.0:11434, pastaj OK, dhe nis përsëri Ollama."

msgid "Aici scrie adresa http://IP-UL-CALCULATORULUI:11434 și modelul gemma3:4b. Cheie nu trebuie."
msgstr "Këtu shkruaj adresën http://IP-E-KOMPJUTERIT:11434 dhe modelin gemma3:4b. Çelësi nuk nevojitet."

msgid "LM Studio merge la fel: fila „Developer”, „Start server”, apoi „Serve on Local Network”; adresa http://IP-UL-CALCULATORULUI:1234 și numele modelului din LM Studio."
msgstr "LM Studio funksionon njësoj: skeda “Developer”, “Start server”, pastaj “Serve on Local Network”; adresa http://IP-E-KOMPJUTERIT:1234 dhe emri i modelit nga LM Studio."

msgid "Pe internet, Groq are un plan gratuit: adresa https://api.groq.com/openai/v1, un model din planul gratuit (de exemplu openai/gpt-oss-20b) și cheia din console.groq.com."
msgstr "Në internet, Groq ka një plan falas: adresa https://api.groq.com/openai/v1, një model nga plani falas (p.sh. openai/gpt-oss-20b) dhe çelësi nga console.groq.com."

msgid "În casă nu are cotă: e gratuit, fără limită, și nimic nu iese din casă. La Groq, gratuit: de exemplu 30 de cereri pe minut și 1.000 pe zi."
msgstr "Në shtëpi nuk ka kuotë: është falas, pa kufizim dhe asgjë nuk del jashtë shtëpisë. Te Groq, falas: për shembull 30 kërkesa në minutë dhe 1.000 në ditë."

msgid "În casă nu e cazul. La Groq, peste limită vine eroarea 429; planul gratuit nu se plătește."
msgstr "Në shtëpi nuk aplikohet. Te Groq, mbi kufirin vjen gabimi 429; plani falas nuk paguhet."

msgid "Cum pornești LibreTranslate"
msgstr "Si të nisësh LibreTranslate"

msgid "Cum pornești un server compatibil OpenAI"
msgstr "Si të nisësh një server të pajtueshëm me OpenAI"

#, python-format
msgid "Cum îți faci cheia pentru %s"
msgstr "Si të krijosh çelësin tënd për %s"

#, python-format
msgid "Verificat pe pagina oficială la %s."
msgstr "Verifikuar në faqen zyrtare në %s."

#, python-format
msgid "Textul subtitrărilor merge la serverul din casa ta (%s). Nimic nu iese din casă."
msgstr "Teksti i titrave shkon te serveri në shtëpinë tënde (%s). Asgjë nuk del nga shtëpia."

msgid "Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din receptor spre serverul de la adresa pe care o scrii. Dacă serverul e în casa ta, nimic nu iese din casă."
msgstr "Teksti i titrave (vetëm teksti, pa figurë dhe pa zë) shkon nga marrësi te serveri në adresën që shkruan. Nëse serveri është në shtëpinë tënde, asgjë nuk del nga shtëpia."

#, python-format
msgid "Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din receptor, prin internet, spre %s, care îl traduce. Cheia ta rămâne pe receptor."
msgstr "Teksti i titrave (vetëm teksti, pa figurë dhe pa zë) shkon nga marrësi, përmes internetit, te %s, i cili e përkthen. Çelësi yt mbetet në marrës."

msgid "Pentru Uniunea Europeană, Google spune că nici la nivelul gratuit nu folosește textele trimise ca să-și îmbunătățească produsele."
msgstr "Për Bashkimin Evropian, Google thotë se edhe në nivelin pa pagesë nuk i përdor tekstet e dërguara për të përmirësuar produktet e veta."

#, python-format
msgid "Cota gratuită: %s"
msgstr "Kuota pa pagesë: %s"

#, python-format
msgid "La depășire: %s"
msgstr "Në rast tejkalimi: %s"

msgid "Sus și jos derulează. Stânga și dreapta: alt serviciu. OK sau Ieșire închide."
msgstr "Lart dhe poshtë: shfleto. Majtas dhe djathtas: kanal tjetër. OK ose EXIT mbyll."

msgid "Traducerea subtitrărilor"
msgstr "Përkthimi i titrave"

msgid "Probează traducerea"
msgstr "Provo përkthimin"

