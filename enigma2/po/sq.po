msgstr "Përkthimi i titrave është gati, me %s. Prova: %s"

#, python-format
msgid "Traducerea subtitrărilor e pornită, cu %s, dar cota gratuită s-a terminat. Merge din nou după ce se reface cota."
msgstr "Përkthimi i titrave është aktivizuar me %s, por kuota falas ka përfunduar. Do të funksionojë përsëri pasi të rivendoset kuota."

#, python-format
msgid "Traducerea subtitrărilor e pornită, cu %s (fără probă)."
msgstr "Përkthimi i titrave është aktivizuar me %s (pa provë)."

