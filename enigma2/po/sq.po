msgstr "Faqe: %d. Nga memoria: %d. Të përkthyera pas shfaqjes: %d. Të anashkaluara: %d. Kërkesa: %d."

#, python-format
msgid "Timp mediu: %s."
msgstr "Koha mesatare: %s."

