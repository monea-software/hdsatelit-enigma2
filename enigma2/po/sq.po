msgstr ": moduli aktual ndalon, kurse"

msgid ": recepționat"
msgstr ": u mor"

msgid ": recepționat, calitate"
msgstr ": u pranua, cilësia"

msgid ": se recepționează"
msgstr ": po pranohet"

msgid ": se verifică alt transponder al satelitului ("
msgstr ": po kontrollohet një transponder tjetër i satelitit ("

msgid ": transparență"
msgstr ": transparenca"

msgid ": ștergi modelul ("
msgstr ": fshin modelin ("

msgid "; %s rânduri pierdute înainte"
msgstr "; %s rreshta të humbur më parë"

msgid "; 18 V ținut %s, apoi 13 V pentru transponder"
msgstr "; 18 V u mbajt %s, pastaj 13 V për transponderin"

msgid "; antena crezută pe %s"
msgstr "; antena besohet të jetë në %s"

msgid "; antena se întoarce pe"
msgstr "; antena po kthehet në"

msgid "; fără încercarea cu antena pe loc: lista transponderelor nu era încă în receptor"
msgstr "; pa provuar me antenën në vend: lista e transponderëve nuk ishte ende në marrës"

msgid "; fără încercarea cu antena pe loc: transponderul are un geamăn pe alt satelit al motorului"
msgstr "; pa provuar me antenën në vend: transponderi ka një binjak në një satelit tjetër të motorit"

msgid "; motorul pe 13 V (mutare de 0 grade)"
msgstr "; motori në 13 V (lëvizje 0 gradë)"

msgid "; motorul pe 18 V, %s grade %s"
msgstr "; motori në 18 V, %s gradë %s"

msgid "; transponderul e tot pe 18 V"
msgstr "; transponderi është ende në 18 V"

msgid "; următoarea verificare peste"
msgstr "; kontrolli tjetër pas"

msgid "; următoarea încercare peste %s"
msgstr "; prova tjetër pas %s"

msgid "; înainte, cu antena pe loc, transponderul nu a dat semnal"
msgstr "; më parë, me antenën në vend, transponderi nuk dha sinjal"

msgid "; încercări de readucere a antenei:"
msgstr "; përpjekjet për rikthimin e antenës:"

msgid "; încă %s la fel nescrise"
msgstr "; edhe %s të tjerë të pashkruar"

msgid "< Dosarul de deasupra >"
msgstr "< Dosja më lart >"

msgid "< Lista discurilor >"
msgstr "< Lista e disqeve >"

msgid "<a href=\"/dvb-i\">Înapoi la canalele de pe internet</a>. Aceleași setări sunt pe televizor, în __DRUM_MENIU__."
msgstr "<a href=\"/dvb-i\">Kthehu te kanalet e internetit</a>. Të njëjtat cilësime janë në TV, te __DRUM_MENIU__."

msgid "<a href=\"/setari-din-copie\">Setările importate</a>: starea lor și repornirea interfeței."
msgstr "<a href=\"/setari-din-copie\">Cilësimet e importuara</a>: gjendja e tyre dhe rinisja e ndërfaqes."

msgid "<a id=\"spreInternet\" href=\"/descarcare-subtitrari\">Caută subtitrări pe internet</a> pentru filmul acesta."
msgstr "<a id=\"spreInternet\" href=\"/descarcare-subtitrari\">Kërko titra në internet</a> për këtë film."

msgid "<code>GET /api/accel</code>: accelerarea 2D pe placa video: dacă receptorul o are (<code>disponibila</code>), setarea pentru următoarea pornire (implicit pornită) și ce s-a hotărât la pornirea de acum"
msgstr "<code>GET /api/accel</code>: përshpejtimi 2D në kartën video: nëse marrësi e ka (<code>disponibila</code>), cilësimi për nisjen e ardhshme (aktiv si parazgjedhje) dhe çfarë u vendos në nisjen aktuale"

msgid "<code>GET /api/acces-canal</code>: accesul canalului care rulează (criptat sau liber), sistemele, CAID-urile și ce decriptează modulul acum"
msgstr "<code>GET /api/acces-canal</code>: aksesi i kanalit që po luhet (i koduar ose i lirë), sistemet, CAID-et dhe çfarë po dekodon moduli tani"

msgid "<code>GET /api/acces-conditionat</code>: modulele de acces condiționat pe feluri (câmpul <code>fel</code>: numele felului, așa cum îl are receptorul; întâi modulele obișnuite, apoi serverele de carduri), cel ales la pornirea receptorului, cele care rulează, procesul care lucrează și memoria lui, comanda în curs sau ultimul rezultat, dacă receptorul decriptează acum"
msgstr "<code>GET /api/acces-conditionat</code>: modulet e aksesit të kushtëzuar sipas llojit (fusha <code>fel</code>: emri i llojit, siç e ka marrësi; fillimisht modulet e zakonshme, pastaj serverët e kartave), ai i zgjedhur në nisje të marrësit, ata që janë në punë, procesi që po punon dhe memoria e tij, komanda në vijim ose rezultati i fundit, nëse marrësi po dekodon tani"

msgid "<code>GET /api/acces-ssh</code>: intrarea pe receptor prin SSH: felul parolei de administrator (fără parola însăși), cheile SSH (tipul, amprenta, comentariul), „Fără parolă în rețeaua locală”, stările periculoase (<code>alarme</code>), lucrarea în curs și rezultatul ultimei comenzi"
msgstr "<code>GET /api/acces-ssh</code>: hyrja në marrës përmes SSH: lloji i fjalëkalimit të administratorit (pa fjalëkalimin vetë), çelësat SSH (lloji, gjurma, komenti), “Pa fjalëkalim në rrjetin lokal”, gjendjet e rrezikshme (<code>alarme</code>), puna në vijim dhe rezultati i komandës së fundit"

msgid "<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, <code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, <code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/actualizari-reporneste</code>: actualizările prin pachete de pe stb.hdsatelit.com (starea, căutarea, instalarea, verificarea zilnică, repornirea interfeței după instalare)"
msgstr "<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, <code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, <code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/actualizari-reporneste</code>: përditësimet përmes paketave nga stb.hdsatelit.com (gjendja, kërkimi, instalimi, kontrolli ditor, rinisja e ndërfaqes pas instalimit)"

msgid "<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;orase=1]</code>: afișajul din față: ce arată acum (măștile celor 4 cifre și textul), lista de rotire, mesajele scurte, așteptarea, setările, minutarul și cronometrul; cu <code>grupa</code> alegerile grupei cu desenul valorii de acum, cu <code>catalog=1</code> toate alegerile (căutarea), cu <code>orase=1</code> fusurile pentru ora din alt oraș"
msgstr "<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;orase=1]</code>: ekrani i përparmë: çfarë tregon tani (maskat e 4 shifrave dhe teksti), lista e rrotullimit, mesazhet e shkurtra, pritja, cilësimet, numërimi mbrapsht dhe kronometri; me <code>grupa</code> zgjedhjet e grupit me figurën e vlerës aktuale, me <code>catalog=1</code> të gjitha zgjedhjet (kërkimi), me <code>orase=1</code> zonat kohore për orën në një qytet tjetër"

msgid "<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: tunerele, LNB-ul, semnalul canalului curent și unghiurile antenei spre fiecare satelit (numai citire)"
msgstr "<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: sintonizuesit, LNB, sinjali i kanalit aktual dhe këndet e antenës drejt çdo sateliti (vetëm lexim)"

msgid "<code>GET /api/calitate-imagine</code>: calitatea imaginii: „Reglajele după canal”, profilul canalului de acum, cele 9 profiluri (SD, HD, 4K x SDR, HDR10, HLG) cu reglajele lor, ieșirea HDR (alegerile primite de televizor, ce e scris acum, întrebarea în curs) și textul brut al blocului de calitate"
msgstr "<code>GET /api/calitate-imagine</code>: cilësia e figurës: “Rregullimet sipas kanalit”, profili i kanalit aktual, 9 profilet (SD, HD, 4K x SDR, HDR10, HLG) me rregullimet e tyre, dalja HDR (zgjedhjet e marra nga TV, çfarë është shkruar tani, pyetja në vijim) dhe teksti i papërpunuar i bllokut të cilësisë"

msgid "<code>GET /api/canale-acum</code>: canalul de pe televizor"
msgstr "<code>GET /api/canale-acum</code>: kanali në TV"

msgid "<code>GET /api/canale-buchete?fila=tv|radio</code>: listele de ales și lista pe care stă televizorul"
msgstr "<code>GET /api/canale-buchete?fila=tv|radio</code>: listat për t'u zgjedhur dhe lista ku ndodhet TV"

msgid "<code>GET /api/canale-epg?refs=r1,r2</code>: emisiunea de acum și cea următoare, cel mult 50 de canale"
msgstr "<code>GET /api/canale-epg?refs=r1,r2</code>: emisioni aktual dhe ai i radhës, maksimumi 50 kanale"

msgid "<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,v2&amp;de_la=&amp;cate=</code>: rândurile, pe pagini de cel mult 200, cu grupele de filtre și numerele lor"
msgstr "<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grup&gt;=v1,v2&amp;de_la=&amp;cate=</code>: rreshtat, në faqe me maksimumi 200, me grupet e filtrave dhe numrat e tyre"

msgid "<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: sigla canalului; la listele de canale, 503 când receptorul are prea multe cereri în lucru și 504 când nu termină în 10 s"
msgstr "<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: logoja e kanalit; te listat e kanaleve, 503 kur marrësi ka shumë kërkesa në proces dhe 504 kur nuk përfundon brenda 10 s"

msgid "<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Caută setări”: meniurile și setările care au textul în nume (fără diacritice), cu drumul din meniu, valoarea de acum și pagina web"
msgstr "<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Kërko cilësimet”: menytë dhe cilësimet që kanë tekstin në emër (pa diakritikë), me rrugën në meny, vlerën aktuale dhe faqen web"

msgid "<code>GET /api/cautare-actualizeaza-stare</code>: cât a citit (transponderul, canalele) sau rezultatul"
msgstr "<code>GET /api/cautare-actualizeaza-stare</code>: sa ka lexuar (transponderi, kanalet) ose rezultati"

msgid "<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code>: căutarea de canale, cu aceleași rânduri de filtre ca pe televizor și pistele știute ale fiecărui canal"
msgstr "<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,hbbtv&amp;lsunet=&lt;gjuhe&gt;&amp;lsub=&lt;gjuhe&gt;</code>: kërkimi i kanaleve, me të njëjtat rreshta filtrash si në TV dhe pistat e njohura të çdo kanali"

msgid "<code>GET /api/ceas</code>: ora receptorului, fusul orar, sursa orei (<code>auto</code>: Internet, apoi transponder; <code>ntp</code>; <code>dvb</code>), serverul NTP, alegerile lor și ultima sincronizare"
msgstr "<code>GET /api/ceas</code>: ora e marrësit, zona kohore, burimi i orës (<code>auto</code>: internet, pastaj transponder; <code>ntp</code>; <code>dvb</code>), serveri NTP, zgjedhjet e tyre dhe sinkronizimi i fundit"

msgid "<code>GET /api/copie-setari[?cauta=1]</code>: copia setărilor: stickurile și discurile (<code>implicit</code> = stickul de actualizare), copiile găsite (data, versiunea imaginii, acest receptor sau altul), copia automată, ultimul rezultat; niciodată conținutul copiei"
msgstr "<code>GET /api/copie-setari[?cauta=1]</code>: kopja e cilësimeve: USB-të dhe disqet (<code>implicit</code> = USB-ja e përditësimit), kopjet e gjetura (data, versioni i imazhit, ky marrës ose një tjetër), kopja automatike, rezultati i fundit; asnjëherë përmbajtja e kopjes"

msgid "<code>GET /api/dabt2?fel=dab|t2</code>: fereastra „Fluxuri și setări” a DAB+ / DVB-T2 din satelit: fluxurile cu poziția, numele, numărul de posturi și starea, setările, Despre, lucrul în curs și <code>repunere</code> (canalul de dinainte, pornit din nou după „Învață posturile”: starea și mesajul)"
msgstr "<code>GET /api/dabt2?fel=dab|t2</code>: dritarja “Flukset dhe cilësimet” e DAB+ / DVB-T2 nga sateliti: flukset me pozicionin, emrin, numrin e stacioneve dhe gjendjen, cilësimet, Rreth, puna në vijim dhe <code>repunere</code> (kanali i mëparshëm, i rinisur pas “Mëso stacionet”: gjendja dhe mesazhi)"

msgid "<code>GET /api/descarcare-subtitrari</code> și <code>POST /api/descarcare-subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, <code>-verifica</code>, <code>-conturi</code>: descărcarea subtitrărilor (numele, parolele și cheile numai în corpul cererii); pe un canal TV sau la o înregistrare și <code>-film</code> (<code>fapta=identifica|alege|titlu|local</code>: filmul din ghid, identificat în Wikidata) și <code>-potrivire</code> (<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|opreste</code>: potrivirea subtitrării pe canal)"
msgstr "<code>GET /api/descarcare-subtitrari</code> dhe <code>POST /api/descarcare-subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, <code>-verifica</code>, <code>-conturi</code>: shkarkimi i titrave (emrat e përdoruesve, fjalëkalimet dhe çelësat vetëm në trupin e kërkesës); në një kanal TV ose te një regjistrim dhe <code>-film</code> (<code>fapta=identifica|alege|titlu|local</code>: filmi nga udhëzuesi, i identifikuar në Wikidata) dhe <code>-potrivire</code> (<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|opreste</code>: përshtatja e titrave në kanal)"

msgid "<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: mesajul de pe ecranul negru (de ce nu se vede imaginea) și analiza fluxului canalului"
msgstr "<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: mesazhi në ekranin e zi (pse nuk shihet figura) dhe analiza e fluksit të kanalit"

msgid "<code>GET /api/egalizator</code>: egalizatorul posturilor de radio: pornit sau oprit, benzile, presetarea, modul de noapte, reglajele postului de acum și dacă merge la acest post; <code>POST /api/egalizator-seteaza</code>: schimbă și aplică pe loc"
msgstr "<code>GET /api/egalizator</code>: barazuesi i stacioneve radio: aktiv ose joaktiv, brezat, parazgjedhja, mënyra e natës, rregullimet e stacionit aktual dhe nëse punon në këtë stacion; <code>POST /api/egalizator-seteaza</code>: ndryshon dhe zbaton menjëherë"

msgid "<code>GET /api/filme</code>: filmul care merge (poziția, lungimea, starea, locul ținut minte, mesajul de refuz) și setările filmelor; <code>GET /api/filme-lista</code>: filmele din dosarul listei de filme, cu locul rămas"
msgstr "<code>GET /api/filme</code>: filmi që po luhet (pozicioni, gjatësia, gjendja, vendi i mbajtur mend, mesazhi i refuzimit) dhe cilësimet e filmave; <code>GET /api/filme-lista</code>: filmat në dosjen e listës së filmave, me vendin ku është ndaluar"

msgid "<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: familiile libere de pe Google Fonts și fonturile deja descărcate"
msgstr "<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: familjet e lira nga Google Fonts dhe shkronjat e shkarkuara tashmë"

msgid "<code>GET /api/gasire-semnal-stare</code>: nivelul, calitatea, BER-ul și verdictul măsurării"
msgstr "<code>GET /api/gasire-semnal-stare</code>: niveli, cilësia, BER dhe vendimi i matjes"

msgid "<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: transponderele unui satelit"
msgstr "<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: transponderët e një sateliti"

msgid "<code>GET /api/gasire-semnal</code>: tunerele, sateliții, transponderul de la care pornește măsurarea și starea ei"
msgstr "<code>GET /api/gasire-semnal</code>: sintonizuesit, satelitët, transponderi nga ku fillon matja dhe gjendja e saj"

msgid "<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-emisiune?ref=&amp;id=</code>: ghidul unui canal (fără <code>ref</code>, canalul de pe televizor) și o emisiune cu descrierile"
msgstr "<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-emisiune?ref=&amp;id=</code>: udhëzuesi i një kanali (pa <code>ref</code>, kanali në TV) dhe një emision me përshkrimet"

msgid "<code>GET /api/import-surse?cauta=1</code>: copiile de canale și setări găsite pe stick-uri și pe receptor, starea căutării și a importului"
msgstr "<code>GET /api/import-surse?cauta=1</code>: kopjet e kanaleve dhe cilësimeve të gjetura në USB dhe në marrës, gjendja e kërkimit dhe e importit"

msgid "<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|retea|hdmi</code>: ecranele „System Information”, cu aceleași texte ca pe televizor"
msgstr "<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|retea|hdmi</code>: ekranet „Informacioni i sistemit”, me të njëjtat tekste si në TV"

msgid "<code>GET /api/interfete-cam?reincarca=1</code>: modulele de acces condiționat instalate și interfețele lor web, cu numele date de fiecare modul (fără <code>reincarca</code> poate veni o căutare făcută cu câteva secunde înainte)"
msgstr "<code>GET /api/interfete-cam?reincarca=1</code>: modulet e instaluara të qasjes me kusht dhe ndërfaqet e tyre web, me emrat e dhënë nga secili modul (pa <code>reincarca</code> mund të kthehet një kërkim i bërë disa sekonda më parë)"

msgid "<code>GET /api/jurnal</code>: jurnalul de versiuni (ce s-a schimbat la fiecare actualizare)"
msgstr "<code>GET /api/jurnal</code>: ditari i versioneve (çfarë ka ndryshuar në çdo përditësim)"

msgid "<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: programele din imagine cu licența fiecăruia și textul unei licențe"
msgstr "<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: programet në imazh me licencën e secilit dhe tekstin e një licence"

msgid "<code>GET /api/limba-interfata</code>: limba meniurilor de acum și lista limbilor, cu numele de pe televizor"
msgstr "<code>GET /api/limba-interfata</code>: gjuha e tanishme e menyve dhe lista e gjuhëve, me emrat si në TV"

msgid "<code>GET /api/limbi</code>: limba sunetului și a subtitrărilor: cele 7 setări cu alegerile lor, ce se ține minte pe canalul de acum și canalele cu alegeri de mână"
msgstr "<code>GET /api/limbi</code>: gjuha e zërit dhe e titrave: 7 cilësimet me zgjedhjet e tyre, çfarë mbahet mend në kanalin e tanishëm dhe kanalet me zgjedhje manuale"

msgid "<code>GET /api/liste-implicite</code>: listele de canale gata făcute și drumurile spre scanare și import"
msgstr "<code>GET /api/liste-implicite</code>: listat e gatshme të kanaleve dhe shtigjet për kërkim dhe import"

msgid "<code>GET /api/lnb-stare</code>: verificarea semnalului, întrebarea și secundele rămase"
msgstr "<code>GET /api/lnb-stare</code>: verifikimi i sinjalit, pyetja dhe sekondat e mbetura"

msgid "<code>GET /api/lnb?slot=N</code>: LNB-urile tunerului, cu valorile, alegerile și „Probă de calcul” (numai citire)"
msgstr "<code>GET /api/lnb?slot=N</code>: LNB-të e sintonizuesit, me vlerat, zgjedhjet dhe „Provë llogaritjeje” (vetëm lexim)"

msgid "<code>GET /api/locul[?tara=RO]</code>: locul antenei pentru motorul USALS, țările și orașele unei țări (tabelul din imagine)"
msgstr "<code>GET /api/locul[?tara=RO]</code>: vendndodhja e antenës për motorin USALS, shtetet dhe qytetet e një shteti (tabela në imazh)"

msgid "<code>GET /api/meniu</code>: tot meniul receptorului (tasta MENU), cu aceleași intrări ca pe televizor pentru nivelul ales"
msgstr "<code>GET /api/meniu</code>: e gjithë menyja e marrësit (butoni MENU), me të njëjtat hyrje si në TV për nivelin e zgjedhur"

msgid "<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, <code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: modul sigur (opririle interfeței, alegerile de după ele) și fișierele lui ca text"
msgstr "<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, <code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: mënyra e sigurt (ndalimet e ndërfaqes, zgjedhjet pas tyre) dhe skedarët e saj si tekst"

msgid "<code>GET /api/motor-comenzi</code>: tunerele cu motor, sateliții și starea comenzilor"
msgstr "<code>GET /api/motor-comenzi</code>: sintonizuesit me motor, satelitët dhe gjendja e komandave"

msgid "<code>GET /api/motor-comenzi?urma=N</code>: urma comenzilor trimise motorului (ultimele N, implicit 100, cel mult 500, cele mai noi întâi): ora, comanda, unghiul, cine a cerut-o (televizorul, ecranul sau pagina motorului, Găsire semnal, reacordarea), poziția crezută de receptor; numai citire, din <code>/home/root/logs/hds-motor.log</code>"
msgstr "<code>GET /api/motor-comenzi?urma=N</code>: gjurma e komandave të dërguara te motori (N të fundit, i paracaktuar 100, më së shumti 500, më të rejat së pari): ora, komanda, këndi, kush e kërkoi (TV, ekrani ose faqja e motorit, Gjetja e sinjalit, risintonizimi), pozicioni i supozuar nga marrësi; vetëm lexim, nga <code>/home/root/logs/hds-motor.log</code>"

msgid "<code>GET /api/motor</code>: starea rotirii antenei (de unde, pana unde, poziția estimată, cât mai are de mers)"
msgstr "<code>GET /api/motor</code>: gjendja e rrotullimit të antenës (nga ku, deri ku, pozicioni i parashikuar, sa ka ende për të ecur)"

msgid "<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;xp=&amp;yp=</code>: mouse-ul pe ecranul televizorului, ca în emulator: <code>xp</code>, <code>yp</code> = locul în procente din ecran (sau <code>x</code>, <code>y</code> în pixelii ecranului, 1920x1080); <code>clic</code> alege rândul de sub mouse, iar pe rândul ales sau cu <code>clicuri=2</code> dă OK; un buton colorat = tasta lui; <code>drag</code> (cu <code>x0p</code>, <code>y0p</code> = locul apăsării, <code>nou=1</code> la prima mișcare) și <code>dragend</code> = trasul pe bara de derulare; <code>rotita&amp;pasi=-12..12</code> = sus/jos (3 pași sau mai mulți = o pagină); <code>dreapta</code> = Meniu, <code>mijloc</code> = Ieșire. Răspunsul spune ce s-a făcut (<code>facut</code>: selectie, ok, buton, bara, derulare, tasta, nimic). Din browser, cu POST și antetul <code>X-HDS-CSRF</code>, ca <code>remotecontrol</code>"
msgstr "<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;xp=&amp;yp=</code>: mausi në ekranin e TV, si në emulator: <code>xp</code>, <code>yp</code> = vendi në përqindje të ekranit (ose <code>x</code>, <code>y</code> në pikselët e ekranit, 1920x1080); <code>clic</code> zgjedh rreshtin nën maus, ndërsa në rreshtin e zgjedhur ose me <code>clicuri=2</code> jep OK; një buton me ngjyrë = butoni i tij; <code>drag</code> (me <code>x0p</code>, <code>y0p</code> = vendi i shtypjes, <code>nou=1</code> në lëvizjen e parë) dhe <code>dragend</code> = tërheqja në shiritin e derulimit; <code>rotita&amp;pasi=-12..12</code> = lart/poshtë (3 hapa ose më shumë = një faqe); <code>dreapta</code> = Menyja, <code>mijloc</code> = Dalja. Përgjigjja thotë çfarë u bë (<code>facut</code>: selectie, ok, buton, bara, derulare, tasta, nimic). Nga shfletuesi, me POST dhe kryetitullin <code>X-HDS-CSRF</code>, si <code>remotecontrol</code>"

msgid "<code>GET /api/navigator</code>: navigatorul web de pe televizor (deschis sau nu, modul, desenul, felul câmpului ales, mărirea; fără adrese), setările lui și favoritele"
msgstr "<code>GET /api/navigator</code>: shfletuesi web në TV (i hapur apo jo, mënyra, pamja, lloji i fushës së zgjedhur, zmadhimi; pa adresa), cilësimet e tij dhe të preferuarat"

msgid "<code>GET /api/ocr-limbi</code>: limbile recunoașterii textului (în imagine, descărcate, de descărcat, cu mărimea și starea fiecăreia) și locul pentru modelele noi"
msgstr "<code>GET /api/ocr-limbi</code>: gjuhët e njohjes së tekstit (në imazh, të shkarkuara, për t'u shkarkuar, me madhësinë dhe gjendjen e secilës) dhe vendi për modelet e reja"

msgid "<code>GET /api/pasi-decriptare</code>: pașii decriptării canalului de pe televizor (cererea către modulul de acces, răspunsurile și timpul lor, imaginea decriptată, mesajele modulului CI), numai cu setarea Arată pașii decriptării pornită"
msgstr "<code>GET /api/pasi-decriptare</code>: hapat e çkodimit të kanalit në TV (kërkesa ndaj modulit të qasjes, përgjigjet dhe koha e tyre, pamja e çkoduar, mesazhet e modulit CI), vetëm me cilësimin Shfaq hapat e çkodimit të aktivizuar"

msgid "<code>GET /api/paza-model</code>: paza de model (receptorul pentru care e făcută imaginea și amprenta acestuia); <code>GET /api/actualizare-pachete</code>: pachetele de actualizare găsite și verdictul pazei pentru fiecare"
msgstr "<code>GET /api/paza-model</code>: mbrojtja e modelit (marrësi për të cilin është bërë imazhi dhe gjurma e tij); <code>GET /api/actualizare-pachete</code>: paketat e përditësimit të gjetura dhe vendimi i mbrojtjes për secilën"

msgid "<code>GET /api/paznic</code>: paznicul receptorului: starea, setările (<code>interfata</code>, <code>asteptare</code> în secunde), alegerile și ultimele rânduri din jurnalul lui"
msgstr "<code>GET /api/paznic</code>: roja i marrësit (watchdog): gjendja, cilësimet (<code>interfata</code>, <code>asteptare</code> në sekonda), zgjedhjet dhe rreshtat e fundit nga ditari i tij"

msgid "<code>GET /api/portal</code>: starea HbbTV a canalului care rulează (da, nu are, încă nu se știe), cu mesajul arătat pe televizor la tasta PORTAL"
msgstr "<code>GET /api/portal</code>: gjendja HbbTV e kanalit që po luan (po, nuk ka, nuk dihet ende), me mesazhin e shfaqur në TV te butoni PORTAL"

msgid "<code>GET /api/procesor</code>: procesorul: modul de lucru, modurile care există pe receptor, frecvența setată și cea de acum, temperatura, tensiunea, procentul folosit și timpul pe fiecare treaptă"
msgstr "<code>GET /api/procesor</code>: procesori: mënyra e punës, mënyrat që ekzistojnë në marrës, frekuenca e caktuar dhe ajo e tanishme, temperatura, tensioni, përqindja e përdorur dhe koha në çdo nivel"

msgid "<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: postul de radio care merge, cu textele ecranului radio; barele și nivelul sunetului"
msgstr "<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: stacioni radio që po luan, me tekstet e ekranit radio; shiritat dhe niveli i zërit"

msgid "<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: apasă o tastă ca de pe telecomanda receptorului (coduri de tastă Linux, de exemplu 352 pentru OK); cu <code>lung=1</code>, apăsare lungă"
msgstr "<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: shtyp një buton si nga telekomanda e marrësit (kodet e butonave Linux, për shembull 352 për OK); me <code>lung=1</code>, shtypje e gjatë"

msgid "<code>GET /api/scanare-stare</code>: starea căutării (procent, canale găsite, transpondere, timp rămas, rezultat)"
msgstr "<code>GET /api/scanare-stare</code>: gjendja e kërkimit (përqindja, kanalet e gjetura, transponderët, koha e mbetur, rezultati)"

msgid "<code>GET /api/scanare-ultima</code>: rezultatul ultimei scanări de canale, ținut până la scanarea următoare: <code>inceput</code>, <code>sfarsit</code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, <code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, <code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, <code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, iar când se știu <code>tsid</code>, <code>onid</code>, <code>nid</code> și, la cablu, <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, <code>caid</code>, iar când operatorul trimite numerele canalelor <code>lcn</code> și <code>lcn_vizibil</code>): toate serviciile citite din SDT, vechi și noi, și <code>retele</code> (<code>nid</code>, <code>nume</code>, <code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, <code>privati</code>): rețelele din tabela NIT; câmpurile din tabela NIT (<code>nid</code>, <code>lcn</code>, <code>retele</code>) apar la căutarea în rețea și la scanarea pe cablu pe o singură frecvență; numai citire, lista de canale nu se schimbă; fără nicio scanare de la pornire, <code>result</code> false"
msgstr "<code>GET /api/scanare-ultima</code>: rezultati i kërkimit të fundit të kanaleve, i ruajtur deri në kërkimin tjetër: <code>inceput</code>, <code>sfarsit</code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, <code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, <code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, <code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, dhe kur dihen <code>tsid</code>, <code>onid</code>, <code>nid</code> dhe, në kabllor, <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, <code>caid</code>, dhe kur operatori dërgon numrat e kanaleve <code>lcn</code> dhe <code>lcn_vizibil</code>): të gjitha shërbimet e lexuara nga SDT, të vjetra dhe të reja, dhe <code>retele</code> (<code>nid</code>, <code>nume</code>, <code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, <code>privati</code>): rrjetet nga tabela NIT; fushat nga tabela NIT (<code>nid</code>, <code>lcn</code>, <code>retele</code>) shfaqen te kërkimi në rrjet dhe te kërkimi kabllor në një frekuencë të vetme; vetëm lexim, lista e kanaleve nuk ndryshon; pa asnjë kërkim që nga nisja, <code>result</code> false"

msgid "<code>GET /api/scanare</code>: secțiunile „Scanare” și „Orientarea și setarea antenei”, cu felurile de scanare, în ordinea din meniul receptorului; cu <code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</code>, câmpurile felului și ce s-ar căuta"
msgstr "<code>GET /api/scanare</code>: seksionet “Kërkimi i kanaleve” dhe “Orientimi dhe konfigurimi i antenës”, me llojet e kërkimit, në rendin e menysë së marrësit; me <code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</code>, fushat e llojit dhe çfarë do të kërkohej"

msgid "<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;mode=all|video|osd&amp;download=1</code>: imaginea de pe ecran; <code>mode</code>: <code>all</code> cu afișajul OSD (implicit), <code>video</code> numai imaginea canalului, <code>osd</code> numai afișajul OSD; <code>download=1</code>: descărcare ca fișier, cu data și ora receptorului în nume"
msgstr "<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;mode=all|video|osd&amp;download=1</code>: pamja e ekranit; <code>mode</code>: <code>all</code> me ekranin OSD (i paracaktuar), <code>video</code> vetëm pamja e kanalit, <code>osd</code> vetëm ekrani OSD; <code>download=1</code>: shkarkimi si skedar, me datën dhe orën e marrësit në emër"

msgid "<code>GET /api/setari-din-copie</code>: setările importate: câte așteaptă repornirea interfeței (<code>asteapta</code>), proba lor (<code>garda</code>), scoase după opriri neașteptate (<code>cazut</code>), textele stării"
msgstr "<code>GET /api/setari-din-copie</code>: cilësimet e importuara: sa po presin rinisjen e ndërfaqes (<code>asteapta</code>), prova e tyre (<code>garda</code>), ato të hequra pas ndalimeve të papritura (<code>cazut</code>), me tekstet e gjendjes"

msgid "<code>GET /api/setari</code>: ecranele de setări din meniu; cu <code>id=&lt;cheie&gt;</code>, rândurile lor (aceleași ca pe televizor, cu alegerile)"
msgstr "<code>GET /api/setari</code>: ekranet e cilësimeve nga menyja; me <code>id=&lt;cheie&gt;</code>, rreshtat e tyre (të njëjtët si në TV, me zgjedhjet)"

msgid "<code>GET /api/standby-tv</code>: ieșirea HDMI în standby (oprită sau pornită, oprirea din nou după aprinderea televizorului) și starea CEC"
msgstr "<code>GET /api/standby-tv</code>: dalja HDMI në gatishmëri (joaktive apo aktive, fikja përsëri pas ndezjes së TV-së) dhe gjendja CEC"

msgid "<code>GET /api/stare-retea</code>: legătura cu routerul și internetul (cablu sau Wi-Fi, treptele semnalului Wi-Fi, internetul merge, routerul nu are internet sau receptorul nu e conectat la router), cu desenul pictogramei și textul ei, ca pictograma din bara de pe televizor"
msgstr "<code>GET /api/stare-retea</code>: lidhja me ruterin dhe internetin (kabëll ose Wi-Fi, nivelet e sinjalit Wi-Fi, interneti punon, ruteri nuk ka internet ose marrësi nuk është i lidhur me ruterin), me ikonën dhe tekstin e saj, si ikona në shiritin në TV"

msgid "<code>GET /api/statusinfo</code>: canalul curent, volumul, standby"
msgstr "<code>GET /api/statusinfo</code>: kanali aktual, volumi, gatishmëria"

msgid "<code>GET /api/stocare</code>: locul înregistrărilor, spațiul liber și discurile conectate"
msgstr "<code>GET /api/stocare</code>: vendndodhja e regjistrimeve, hapësira e lirë dhe disqet e lidhura"

msgid "<code>GET /api/subtitrari-aspect</code>: aspectul subtitrărilor text (fontul, grosimea, mărimea și culoarea literelor, conturul, umbra, fundalul, înălțimea, distanța dintre rânduri) și mărirea subtitrărilor DVB, cu alegerile posibile (<code>alegeri</code>), stilurile gata făcute și valorile de la început"
msgstr "<code>GET /api/subtitrari-aspect</code>: pamja e titrave tekst (shkronja, trashësia, madhësia dhe ngjyra e shkronjave, konturi, ombra, sfondi, lartësia, hapësira mes rreshtave) dhe zmadhimi i titrave DVB, me zgjedhjet e mundshme (<code>alegeri</code>), stilet e gatshme dhe vlerat fillestare"

msgid "<code>GET /api/subtitrari-film</code>: filmul care merge, subtitrările lui, întârzierea, codarea și cadrele pe secundă"
msgstr "<code>GET /api/subtitrari-film</code>: filmi që po luhet, titrat e tij, vonesa, kodimi dhe kuadrot për sekondë"

msgid "<code>GET /api/subtitrari-ocr</code>: contorul recunoașterii textului din subtitrările DVB (pagini citite ca text, rămase imagine și de ce, timpul mediu, ultimele pagini, viteza serviciului)"
msgstr "<code>GET /api/subtitrari-ocr</code>: numëruesi i njohjes së tekstit për titrat DVB (faqet e lexuara si tekst, të mbetura si pamje dhe pse, koha mesatare, faqet e fundit, shpejtësia e shërbimit)"

msgid "<code>GET /api/sunet</code>: ieșirea sunetului (Automat / Manual), AC3 și DTS downmix, pista AC3, ce primește televizorul (EDID), ce se trimite acum și de ce, ce arată driverul pe HDMI și optic"
msgstr "<code>GET /api/sunet</code>: dalja e zërit (Automatik / Manual), AC3 dhe DTS downmix, pista AC3, çfarë merr TV-ja (EDID), çfarë po dërgohet tani dhe pse, çfarë tregon drajveri në HDMI dhe optike"

msgid "<code>GET /api/telecomenzi-export?format=json|csv</code>: codurile telecomenzii receptorului și ale celor asociate, pentru aplicații"
msgstr "<code>GET /api/telecomenzi-export?format=json|csv</code>: kodet e telekomandës së marrësit dhe ato të çiftuara, për aplikacionet"

msgid "<code>GET /api/telecomenzi</code>: telecomenzile asociate, tastele lor și captura paginii (cititorul, proba, asocierea)"
msgstr "<code>GET /api/telecomenzi</code>: telekomandat e çiftuara, butonat e tyre dhe marrja e faqes (lexuesi, prova, çiftimi)"

msgid "<code>GET /api/teletext-copii</code> (cu <code>?canale=1</code> și canalele care au teletext): copiile de teletext salvate (canalul, data, paginile, mărimea), dosarul, spațiul folosit și cel ales, urmăritorul (caruselul canalului de acum, reîmprospătarea în lucru) și setările"
msgstr "<code>GET /api/teletext-copii</code> (me <code>?canale=1</code> dhe kanalet që kanë teletekst): kopjet e ruajtura të teletekstit (kanali, data, faqet, madhësia), dosja, hapësira e përdorur dhe ajo e zgjedhur, ndjekësi (karuseli i kanalit aktual, rifreskimi në proces) dhe cilësimet"

msgid "<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> (fără <code>ref</code>: canalul de acum): <code>date</code> = fișierul copiei (.ttx, comprimat), <code>html</code> = o singură pagină HTML cu toate paginile, care se citește fără receptor"
msgstr "<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> (pa <code>ref</code>: kanali aktual): <code>date</code> = skedari i kopjes (.ttx, i ngjeshur), <code>html</code> = një faqe e vetme HTML me të gjitha faqet, që mund të lexohet pa marrësin"

msgid "<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;ref&gt;</code>: o pagină de teletext, ca pe televizor la tasta TEXT: cele 25 de rânduri a câte 40 de celule (litera, culoarea, fundalul, mozaicul, atributele), textul paginii, subpaginile, paginile tastelor colorate, paginile vecine și pagina de pe televizor; fără <code>pagina</code>, pagina de pe televizor sau cea de pornire; <code>sub=-1</code> = cea mai nouă; <code>ascuns=1</code> arată ce e ascuns; cu <code>copie</code>, paginile din copia salvată a canalului, fără tuner (<code>sursa</code>: <code>direct</code> sau <code>copie</code>); <code>hd</code> = setarea Teletext neted, <code>optiuni</code> = conturul literelor, umbra literelor și formele în relief (<code>contur</code>, <code>umbra</code>, <code>relief</code>, ca pe televizor). Pagina lipsă: <code>gasita</code> fals și mesajul că se caută"
msgstr "<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;ref&gt;</code>: një faqe teleteksti, si në TV te butoni TEXT: 25 rreshtat prej 40 qelizash secili (shkronja, ngjyra, sfondi, mozaiku, vetitë), teksti i faqes, nënfaqet, faqet e butonave me ngjyra, faqet fqinje dhe faqja në TV; pa <code>pagina</code>, faqja në TV ose faqja kryesore; <code>sub=-1</code> = më e reja; <code>ascuns=1</code> tregon çfarë është e fshehur; me <code>copie</code>, faqet nga kopja e ruajtur e kanalit, pa sintonizues (<code>sursa</code>: <code>direct</code> ose <code>copie</code>); <code>hd</code> = cilësimi Teletekst i lëmuar, <code>optiuni</code> = konturi i shkronjave, ombra e shkronjave dhe format në relief (<code>contur</code>, <code>umbra</code>, <code>relief</code>, si në TV). Faqja mungon: <code>gasita</code> false dhe mesazhi që po kërkohet"

msgid "<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: jurnalul unei înregistrări, pe înțelesul oricui, cu mesajul tehnic; golirea lui"
msgstr "<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: ditari i një regjistrimi, me fjalë të thjeshta, me mesazhin teknik; zbrazja e tij"

msgid "<code>GET /api/temporizatoare</code>: înregistrările programate (aceeași ordine, stare și detalii ca pe televizor), locul înregistrărilor și spațiul liber"
msgstr "<code>GET /api/temporizatoare</code>: regjistrimet e programuara (i njëjti rend, gjendje dhe detaje si në TV), vendndodhja e regjistrimeve dhe hapësira e lirë"

msgid "<code>GET /api/traducere-configurare</code>: configurarea pas cu pas a traducerii: ce e pus acum (<code>acum</code>: serviciul, dacă are cheie, pornită sau nu, ultima probă, <code>chei_din_nou</code>), lucrarea configurării (<code>configurare</code>: starea, pasul, proba, modelul și modelele, mesajul și ce să faci), căutarea serverelor din casă (<code>cautare</code>: progresul și serverele găsite), instrucțiunile și pagina cheii fiecărui serviciu, regiunile Azure; niciodată o cheie"
msgstr "<code>GET /api/traducere-configurare</code>: konfigurimi hap pas hapi i përkthimit: çfarë është caktuar tani (<code>acum</code>: shërbimi, nëse ka çelës, aktiv apo jo, prova e fundit, <code>chei_din_nou</code>), puna e konfigurimit (<code>configurare</code>: gjendja, hapi, prova, modeli dhe modelet, mesazhi dhe çfarë të bësh), kërkimi i serverëve në shtëpi (<code>cautare</code>: ecuria dhe serverët e gjetur), udhëzimet dhe faqja e çelësit të çdo shërbimi, rajonet Azure; kurrë një çelës"

msgid "<code>GET /api/traducere-subtitrari</code>: traducerea automată a subtitrărilor text: valorile (<code>pornit</code>, <code>serviciu</code>, <code>limba</code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</code>, <code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</code>, <code>adresa_libre</code>, <code>adresa_openai</code>, <code>model_gemini</code>, <code>model_openai</code>, <code>model_groq</code>, <code>model_cloudflare</code>, <code>cont_cloudflare</code> și, pentru adresa proprie, <code>propriu_adresa</code>, <code>propriu_metoda</code>, <code>propriu_corp</code>, <code>propriu_tip_corp</code>, <code>propriu_antet</code>, <code>propriu_raspuns</code>, <code>propriu_cale</code>), alegerile posibile (<code>alegeri</code>), ce cere fiecare serviciu (<code>cere</code>), care serviciu are cheie (<code>chei</code>, niciodată cheia), dacă cheile trebuie puse din nou (<code>chei_din_nou</code>, textul notei, gol când nu e cazul), starea cheii serviciului ales, ca pe televizor (<code>cheie_fel</code> și <code>cheie_text</code>: pusă, pusă pentru alt server, lipsă), textele paginii în limba receptorului (<code>texte</code>), ce lipsește, confidențialitatea, instrucțiunile pas cu pas (cu <code>pagina_cheie</code>, adresa oficială pentru codul QR) și starea (contorul, proba, pauza după erori)"
msgstr "<code>GET /api/traducere-subtitrari</code>: përkthimi automatik i titrave tekst: vlerat (<code>pornit</code>, <code>serviciu</code>, <code>limba</code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</code>, <code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</code>, <code>adresa_libre</code>, <code>adresa_openai</code>, <code>model_gemini</code>, <code>model_openai</code>, <code>model_groq</code>, <code>model_cloudflare</code>, <code>cont_cloudflare</code> dhe, për adresën vetjake, <code>propriu_adresa</code>, <code>propriu_metoda</code>, <code>propriu_corp</code>, <code>propriu_tip_corp</code>, <code>propriu_antet</code>, <code>propriu_raspuns</code>, <code>propriu_cale</code>), zgjedhjet e mundshme (<code>alegeri</code>), çfarë kërkon çdo shërbim (<code>cere</code>), cili shërbim ka çelës (<code>chei</code>, kurrë çelësi), nëse çelësat duhet të futen përsëri (<code>chei_din_nou</code>, teksti i shënimit, bosh kur nuk nevojitet), gjendja e çelësit të shërbimit të zgjedhur, si në TV (<code>cheie_fel</code> dhe <code>cheie_text</code>: i caktuar, i caktuar për një server tjetër, mungon), tekstet e faqes në gjuhën e marrësit (<code>texte</code>), çfarë mungon, privatësia, udhëzimet hap pas hapi (me <code>pagina_cheie</code>, adresa zyrtare për kodin QR) dhe gjendja (numëruesi, prova, pauza pas gabimeve)"

msgid "<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: canalele de pe frecvența televizorului și din lista lui, fiecare cu merge acum sau motivul, codecul imaginii și felul sunetului; cu <code>wasm=1</code> (browserul are playerul MPEG-2) merg și canalele cu imagine MPEG-2; <code>ac3=1</code>: pagina redă sunetul AC-3, cu decodorul browserului sau cu decodorul wasm al paginii"
msgstr "<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: kanalet në frekuencën e TV-së dhe në listën e tij, secili me treguesin nëse funksionon tani apo arsyen, kodekun e figurës dhe llojin e zërit; me <code>wasm=1</code> (shfletuesi ka luajtësin MPEG-2) funksionojnë edhe kanalet me figurë MPEG-2; <code>ac3=1</code>: faqja luan zërin AC-3, me dekoderin e shfletuesit ose me dekoderin wasm të faqes"

msgid "<code>GET /api/tv-stare</code>: TV în browser: transmisiile de acum (canal, browser, de când, octeți), setările, memoria driverului video (câte canale noi se mai pot deschide până la repornire), transmisia acestui browser și motivul ultimei opriri"
msgstr "<code>GET /api/tv-stare</code>: TV në shfletues: transmetimet aktuale (kanali, shfletuesi, që kur, bajtet), cilësimet, memoria e drajverit video (sa kanale të reja mund të hapen ende deri në rinisje), transmetimi i këtij shfletuesi dhe arsyeja e ndalimit të fundit"

msgid "<code>GET /api/video</code>: setările video ca în Setări &gt; Video: rezoluțiile, frecvențele fiecărei rezoluții (cu <code>auto</code> = automat după canal), culorile HDMI, <code>zapmode</code> (ce se vede la schimbarea canalului) și încercarea în curs"
msgstr "<code>GET /api/video</code>: cilësimet video si te Cilësimet &gt; Video: rezolucionet, frekuencat e secilit rezolucion (me <code>auto</code> = automatik sipas kanalit), ngjyrat HDMI, <code>zapmode</code> (çfarë shfaqet gjatë ndryshimit të kanalit) dhe përpjekja në vazhdim"

msgid "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: schimbă canalul"
msgstr "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: ndryshon kanalin"

msgid "<code>POST /api/accel-reporneste</code>: repornește interfața (enigma2)"
msgstr "<code>POST /api/accel-reporneste</code>: rinis ndërfaqen (enigma2)"

msgid "<code>POST /api/accel-seteaza?pornita=0|1</code>: pornește sau oprește accelerarea de la următoarea pornire a interfeței (refuzat pe un receptor fără accelerarea 2D)"
msgstr "<code>POST /api/accel-seteaza?pornita=0|1</code>: aktivizon ose çaktivizon përshpejtimin që nga nisja e ardhshme e ndërfaqes (refuzohet në një marrës pa përshpejtim 2D)"

msgid "<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</code> ca în <code>GET /api/acces-conditionat</code>): pornește comanda prin scriptul modulului, pe rând, una singură deodată (și cu televizorul); rezultatul vine prin <code>GET /api/acces-conditionat</code>"
msgstr "<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</code> si në <code>GET /api/acces-conditionat</code>): nis komandën përmes skriptit të modulit, me radhë, vetëm një në të njëjtën kohë (përfshirë edhe me televizorin); rezultati vjen përmes <code>GET /api/acces-conditionat</code>"

msgid "<code>POST /api/acces-ssh-adauga</code> (corp: <code>cheie=</code>), <code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?amprenta=SHA256:..&amp;confirmat=1</code>: cheile publice lipite, cele din dosarul hdsatelit/ssh de pe stick, ștergerea unei chei"
msgstr "<code>POST /api/acces-ssh-adauga</code> (trupi: <code>cheie=</code>), <code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?amprenta=SHA256:..&amp;confirmat=1</code>: çelësat publikë të ngjitur, ata nga dosja hdsatelit/ssh në USB, fshirja e një çelësi"

msgid "<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</code> cere și <code>confirmat=1</code>): „Fără parolă în rețeaua locală”. Parola, textul brut și toate schimbările merg numai dintr-un browser conectat cu codul de pe televizor (altfel 403 cu <code>trebuie_cod</code>), niciodată cu <code>?token=</code>; cât ecranul „Acces SSH” e deschis pe televizor, la fel <code>/api/remotecontrol</code> și <code>/api/screenshot</code>"
msgstr "<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</code> kërkon gjithashtu <code>confirmat=1</code>): “Pa fjalëkalim në rrjetin lokal”. Fjalëkalimi, teksti i papërpunuar dhe të gjitha ndryshimet funksionojnë vetëm nga një shfletues i lidhur me kodin nga televizori (përndryshe 403 me <code>trebuie_cod</code>), kurrë me <code>?token=</code>; për sa kohë ekrani “Qasja SSH” është i hapur në TV, e njëjta gjë vlen për <code>/api/remotecontrol</code> dhe <code>/api/screenshot</code>"

msgid "<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/acces-ssh-ascunde</code>: o parolă nouă; „Am notat parola” (textul parolei se șterge de pe receptor, parola rămâne)"
msgstr "<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/acces-ssh-ascunde</code>: një fjalëkalim i ri; “E shkrova fjalëkalimin” (teksti i fjalëkalimit fshihet nga marrësi, fjalëkalimi mbetet)"

msgid "<code>POST /api/acces-ssh-parola</code>: textul parolei, cât timp nu a fost ascunsă; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: fișierele serverului SSH ca text (fără /etc/shadow)"
msgstr "<code>POST /api/acces-ssh-parola</code>: teksti i fjalëkalimit, për sa kohë nuk është fshehur; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: skedarët e serverit SSH si tekst (pa /etc/shadow)"

msgid "<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: salvează și aplică pe loc (oricare dintre ele); <code>previzualizare=1&amp;lista=...</code> arată lista pe afișaj fără salvare (cel mult 2 minute fără o cerere nouă), <code>previzualizare=0</code> revine; <code>minutar=0|1..120</code> și <code>cronometru=porneste|opreste|zero</code> pornesc ceasurile afișajului pe loc; <code>functionare=ora|canal|stins</code> merge ca înainte"
msgstr "<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: ruan dhe zbaton menjëherë (cilëndo prej tyre); <code>previzualizare=1&amp;lista=...</code> shfaq listën në ekran pa e ruajtur (më së shumti 2 minuta pa një kërkesë të re), <code>previzualizare=0</code> kthehet mbrapa; <code>minutar=0|1..120</code> dhe <code>cronometru=porneste|opreste|zero</code> nisin menjëherë orët e ekranit; <code>functionare=ora|canal|stins</code> funksionon si më parë"

msgid "<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</code>: salvează reglajele unui profil (multipli de 5); cu <code>incearca=1</code> se văd pe loc fără să se salveze, <code>renunta=1</code> pune înapoi ce e salvat; <code>POST /api/calitate-imagine-implicite?profil=&lt;profil&gt;|toate</code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|hdr10|hlg|none</code> (canalul pornește din nou, întrebarea apare pe televizor); <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;&amp;pornit=0|1</code> (jumătate de ecran, 60 s)"
msgstr "<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</code>: ruan rregullimet e një profili (multiplë të 5-ës); me <code>incearca=1</code> shihen menjëherë pa u ruajtur, <code>renunta=1</code> kthen mbrapsht atë që është ruajtur; <code>POST /api/calitate-imagine-implicite?profil=&lt;profil&gt;|toate</code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|hdr10|hlg|none</code> (kanali riniset, pyetja shfaqet në TV); <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;&amp;pornit=0|1</code> (gjysma e ekranit, 60 s)"

msgid "<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: pornește canalul prin lista de pe televizor"
msgstr "<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: nis kanalin përmes listës në TV"

msgid "<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: deschide pe televizor un rezultat al căutării, cu rândul găsit ales"
msgstr "<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: hap në TV një rezultat kërkimi, me rreshtin e gjetur të zgjedhur"

msgid "<code>POST /api/cautare-actualizeaza-opreste</code>: oprește citirea și revine la canalul de dinainte"
msgstr "<code>POST /api/cautare-actualizeaza-opreste</code>: ndalon leximin dhe kthehet te kanali i mëparshëm"

msgid "<code>POST /api/cautare-actualizeaza-sari</code>: sare peste satelitul pe care e antena acum și trece la următorul (tasta GALBEN de pe televizor)"
msgstr "<code>POST /api/cautare-actualizeaza-sari</code>: kapërcen satelitin ku ndodhet antena tani dhe kalon te tjetri (butoni i verdhë në TV)"

msgid "<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: întrebarea (durata, motorul); cu <code>confirmat=1</code> pornește pe televizor citirea pistelor, transponder cu transponder"
msgstr "<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: pyetja (kohëzgjatja, motori); me <code>confirmat=1</code> nis leximin e pistave në TV, transponder pas transponderi"

msgid "<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: citirea pistelor în timpul vizionării (oprită, numai canalul privit, tot transponderul), aceeași setare ca pe televizor"
msgstr "<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: leximi i pistave gjatë shikimit (joaktiv, vetëm kanali që po shikohet, i gjithë transponderi), i njëjti cilësim si në TV"

msgid "<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;&amp;fus=&lt;fus orar&gt;</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>/api/ceas</code>)"
msgstr "<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;&amp;fus=&lt;fus orar&gt;</code>: ndryshon dhe ruan cilëndo prej tyre (vlerat e sakta janë në <code>/api/ceas</code>)"

msgid "<code>POST /api/ceas-sincronizeaza</code>: o sincronizare a orei prin Internet, acum"
msgstr "<code>POST /api/ceas-sincronizeaza</code>: një sinkronizim i orës përmes internetit, tani"

msgid "<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/copie-setari-pune?copie=&lt;id&gt;</code> (repornește interfața; copia se pune la loc înainte să pornească), <code>POST /api/copie-setari-sterge?copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"
msgstr "<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/copie-setari-pune?copie=&lt;id&gt;</code> (rinis ndërfaqen; kopja vendoset përsëri para se të nisë), <code>POST /api/copie-setari-sterge?copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"

msgid "<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|invata|sterge&amp;flux=..</code>: actualizează lista, reface buchetele, învață posturile unui flux, șterge un flux adăugat de mână"
msgstr "<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|invata|sterge&amp;flux=..</code>: përditëson listën, rindërton buqetat, mëson stacionet e një transmetimi, fshin një transmetim të shtuar manualisht"

msgid "<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;emisfera=E|V&amp;frecventa=..&amp;...</code>: un flux adăugat de mână, cu aceleași câmpuri și limite ca „Adaugă manual”"
msgstr "<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;emisfera=E|V&amp;frecventa=..&amp;...</code>: një transmetim i shtuar manualisht, me të njëjtat fusha dhe kufij si “Shto manualisht”"

msgid "<code>POST /api/dabt2-seteaza?cheie=tasta|dosar|latime|nedecodabile&amp;valoare=..</code>: setările ferestrei, aceleași ca pe televizor"
msgstr "<code>POST /api/dabt2-seteaza?cheie=tasta|dosar|latime|nedecodabile&amp;valoare=..</code>: cilësimet e dritares, të njëjtat si në TV"

msgid "<code>POST /api/dabt2-televizor?fel=dab|t2</code>: deschide fereastra pe televizor"
msgstr "<code>POST /api/dabt2-televizor?fel=dab|t2</code>: hap dritaren në TV"

msgid "<code>POST /api/ecran-negru-fapta?fapta=&lt;id&gt;|ascunde</code>: fapta mesajului de acum, pe televizor, sau ascunderea lui"
msgstr "<code>POST /api/ecran-negru-fapta?fapta=&lt;id&gt;|ascunde</code>: veprimi i mesazhit aktual në TV, ose fshehja e tij"

msgid "<code>POST /api/ecran-sterge?sursa=galerie|propriu&amp;id=..</code>, <code>POST /api/ecran-la-loc</code>: șterge un ecran de pornire din galerie (nu cel din fabrică și nici cel pus) sau pune la loc ecranele șterse"
msgstr "<code>POST /api/ecran-sterge?sursa=galerie|propriu&amp;id=..</code>, <code>POST /api/ecran-la-loc</code>: fshin një ekran nisjeje nga galeria (jo atë të fabrikës dhe as atë në përdorim) ose rikthen ekranet e fshira"

msgid "<code>POST /api/filme-comanda?fa=pauza|redare|inainte|inapoi</code>, <code>?fa=salt&amp;secunde=-60</code>, <code>?fa=la&amp;secunde=N</code>, <code>POST /api/filme-seteaza?pornire=&amp;oprire=&amp;sfarsit=</code>, <code>POST /api/filme-porneste?cale=..&amp;de_la=loc|inceput</code>: aceleași comenzi ca pe telecomandă în player și în lista de filme"
msgstr "<code>POST /api/filme-comanda?fa=pauza|redare|inainte|inapoi</code>, <code>?fa=salt&amp;secunde=-60</code>, <code>?fa=la&amp;secunde=N</code>, <code>POST /api/filme-seteaza?pornire=&amp;oprire=&amp;sfarsit=</code>, <code>POST /api/filme-porneste?cale=..&amp;de_la=loc|inceput</code>: të njëjtat komanda si në telekomandë në luajtës dhe në listën e filmave"

msgid "<code>POST /api/fonturi-descarca?familie=&lt;Familia&gt;&amp;mare=1</code>: descarcă, verifică și înregistrează un font"
msgstr "<code>POST /api/fonturi-descarca?familie=&lt;Familia&gt;&amp;mare=1</code>: shkarkon, verifikon dhe regjistron një shkronjë (font)"

msgid "<code>POST /api/fonturi-sterge?alias=&lt;NumeInSkin&gt;</code>: șterge un font descărcat"
msgstr "<code>POST /api/fonturi-sterge?alias=&lt;NumeInSkin&gt;</code>: fshin një shkronjë të shkarkuar"

msgid "<code>POST /api/gasire-semnal-porneste</code>, <code>-reacordeaza</code>, <code>-opreste</code>: pornește, acordează din nou sau oprește măsurarea"
msgstr "<code>POST /api/gasire-semnal-porneste</code>, <code>-reacordeaza</code>, <code>-opreste</code>: nis, risintonizon ose ndalon matjen"

msgid "<code>POST /api/ghid-temporizator?ref=&amp;id=&amp;fel=inregistrare|comutare|scoate</code>: pune sau scoate înregistrarea unei emisiuni (409 la suprapunere)"
msgstr "<code>POST /api/ghid-temporizator?ref=&amp;id=&amp;fel=inregistrare|comutare|scoate</code>: cakton ose heq regjistrimin e një emisioni (409 në rast mbivendosjeje)"

msgid "<code>POST /api/import-alta-imagine?raspuns=da|nu|ascunde</code>: răspunsul la întrebarea de la prima pornire (canalele și setările din altă imagine, găsite pe stick sau disc); starea în <code>/api/import-surse</code> (<code>alta_imagine</code>)"
msgstr "<code>POST /api/import-alta-imagine?raspuns=da|nu|ascunde</code>: përgjigjja ndaj pyetjes në nisjen e parë (kanalet dhe cilësimet nga një imazh tjetër, i gjetur në USB ose disk); gjendja në <code>/api/import-surse</code> (<code>alta_imagine</code>)"

msgid "<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;temporizatoare=0&amp;generale=0</code>: pornește importul (întâi copia de siguranță)"
msgstr "<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;temporizatoare=0&amp;generale=0</code>: nis importimin (së pari kopjen rezervë)"

msgid "<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: schimbă limba meniurilor și o salvează, ca OK în ecranul limbii de pe televizor"
msgstr "<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: ndryshon gjuhën e menusë dhe e ruan atë, si butoni OK në ekranin e gjuhës në TV"

msgid "<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>/api/limbi</code>; <code>tradu_orice</code> = „Tradu automat din orice subtitrare disponibilă”, contează cu traducerea subtitrărilor pornită) și le aplică pe canalul de acum"
msgstr "<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</code>: ndryshon dhe ruan cilindo prej tyre (vlerat e sakta janë në <code>/api/limbi</code>; <code>tradu_orice</code> = “Përkthe automatikisht nga çdo titër i disponueshëm”, vlen kur përkthimi i titrave është aktiv) dhe i zbaton në kanalin aktual"

msgid "<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /api/limbi-uita-toate?confirmat=1</code>: uită alegerile de mână ale unui canal sau ale tuturor"
msgstr "<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /api/limbi-uita-toate?confirmat=1</code>: harron zgjedhjet manuale të një kanali ose të të gjithëve"

msgid "<code>POST /api/lnb-aplica</code>: aplică planul văzut (<code>semn=</code>), verifică semnalul și așteaptă răspunsul 60 de secunde"
msgstr "<code>POST /api/lnb-aplica</code>: zbaton planin e shfaqur (<code>semn=</code>), kontrollon sinjalin dhe pret 60 sekonda për përgjigjen"

msgid "<code>POST /api/lnb-plan</code>: ce s-ar schimba pentru câmpurile trimise (<code>l_&lt;lnb&gt;_&lt;câmp&gt;</code>), sau pentru „Ce era înainte” cu <code>fel=inainte</code>; nu scrie nimic"
msgstr "<code>POST /api/lnb-plan</code>: çfarë do të ndryshonte për fushat e dërguara (<code>l_&lt;lnb&gt;_&lt;câmp&gt;</code>), ose për “Siç ishte më parë” me <code>fel=inainte</code>; nuk shkruan asgjë"

msgid "<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code>: răspunsul la „Păstrezi noile setări?”"
msgstr "<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code>: përgjigjja ndaj “Të ruhen cilësimet e reja?”"

msgid "<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</code>: locul antenei aflat după adresa de internet a receptorului, de serverul HD Satelit, numai la cerere și numai din browserul conectat; se scrie abia după confirmare, cu <code>POST /api/locul-seteaza</code> și <code>internet=&lt;semn&gt;</code>"
msgstr "<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</code>: vendndodhja e antenës e gjetur përmes adresës së internetit të marrësit, nga serveri HD Satelit, vetëm me kërkesë dhe vetëm nga shfletuesi i lidhur; shkruhet vetëm pas konfirmimit, me <code>POST /api/locul-seteaza</code> dhe <code>internet=&lt;semn&gt;</code>"

msgid "<code>POST /api/locul-seteaza</code>: locul antenei din tabel (<code>tara</code>, <code>oras</code>) sau scris (<code>lat</code>, <code>lon</code>, grade, nord și est pozitive)"
msgstr "<code>POST /api/locul-seteaza</code>: vendndodhja e antenës nga tabela (<code>tara</code>, <code>oras</code>) ose e shkruar (<code>lat</code>, <code>lon</code>, gradë, veri dhe lindje pozitive)"

msgid "<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: deschide pe televizor ecranul unei intrări (nu oprirea sau repornirea)"
msgstr "<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: hap në TV ekranin e një hyrjeje (jo fikjen ose rinisjen)"

msgid "<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code>: pas, mișcare fără oprire, poziții memorate, mergi la satelit, limite, oprire"
msgstr "<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code>: hap, lëvizje pa ndalesë, pozicionet e memorizuara, shko te sateliti, limitet, ndalo"

msgid "<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-inchide</code>: navigatorul pe televizor"
msgstr "<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-inchide</code>: shfletuesi në TV"

msgid "<code>POST /api/navigator-text</code>: text trimis în câmpul ales pe televizor; numai din browserul asociat, cu textul în corpul cererii (cu <code>?token=</code> se refuză)"
msgstr "<code>POST /api/navigator-text</code>: tekst i dërguar në fushën e zgjedhur në TV; vetëm nga shfletuesi i çiftuar, me tekstin në trupin e kërkesës (me <code>?token=</code> refuzohet)"

msgid "<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: descarcă modelul unei limbi (pe stick sau disc; în memoria internă numai cu intern=1)"
msgstr "<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: shkarkon modelin e një gjuhe (në USB ose disk; në memorien e brendshme vetëm me intern=1)"

msgid "<code>POST /api/ocr-limbi-intreaba</code>: receptorul întreabă din nou pentru limbile cu \"Nu mai întreba\""
msgstr "<code>POST /api/ocr-limbi-intreaba</code>: marrësi pyet përsëri për gjuhët me “Mos pyet më”"

msgid "<code>POST /api/ocr-limbi-opreste?model=slk</code>: oprește descărcarea"
msgstr "<code>POST /api/ocr-limbi-opreste?model=slk</code>: ndalon shkarkimin"

msgid "<code>POST /api/ocr-limbi-sterge?model=slk</code>: șterge un model descărcat (sau îl scoate din listă când stickul lui nu e pus)"
msgstr "<code>POST /api/ocr-limbi-sterge?model=slk</code>: fshin një model të shkarkuar (ose e heq nga lista kur USB-ja e tij nuk është e vendosur)"

msgid "<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</code>: repornirea interfeței când nu mai răspunde și așteptarea dinaintea ei"
msgstr "<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</code>: rinisja e ndërfaqes kur nuk përgjigjet më dhe pritja para saj"

msgid "<code>POST /api/procesor-seteaza?mod=automat|racoros|normal|performanta</code>: salvează modul și îl aplică pe loc"
msgstr "<code>POST /api/procesor-seteaza?mod=automat|racoros|normal|performanta</code>: ruan modalitetin dhe e zbaton menjëherë"

msgid "<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=..&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</code>: setările ecranului radio"
msgstr "<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=..&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</code>: cilësimet e ekranit të radios"

msgid "<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: vizualizarea sau culorile următoare (ca tastele galbenă și albastră pe ecranul radio)"
msgstr "<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: vizualizuesi ose ngjyrat e radhës (si butonat e verdhë dhe blu në ekranin e radios)"

msgid "<code>POST /api/scanare-fluxuri</code>: alegerea de la sfârșitul scanării DAB+ / DVB-T2 de pe televizor (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"
msgstr "<code>POST /api/scanare-fluxuri</code>: zgjedhja në fund të kërkimit DAB+ / DVB-T2 në TV (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"

msgid "<code>POST /api/scanare-opreste</code>: oprește căutarea sau închide rezultatul rămas pe televizor"
msgstr "<code>POST /api/scanare-opreste</code>: ndalon kërkimin ose mbyll rezultatin e mbetur në TV"

msgid "<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;&amp;...</code>: pornește căutarea pe televizor (cu <code>confirmat=1</code> după o întrebare)"
msgstr "<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;&amp;...</code>: nis kërkimin në TV (me <code>confirmat=1</code> pas një pyetjeje)"

msgid "<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: deschide pe televizor ecranul unei intrări din cele două secțiuni"
msgstr "<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: hap në TV ekranin e një hyrjeje nga dy seksionet"

msgid "<code>POST /api/setari-din-copie-reporneste</code>: repornește interfața, ca setările importate să se unească"
msgstr "<code>POST /api/setari-din-copie-reporneste</code>: rinis ndërfaqen në mënyrë që cilësimet e importuara të bashkohen"

msgid "<code>POST /api/setari-seteaza?id=&lt;cheie&gt;&amp;r&lt;N&gt;=&lt;valoare&gt;</code>: schimbă și salvează rândurile trimise (o valoare greșită nu schimbă nimic; la o alegere multiplă, ca vitezele de derulare, alegerile despărțite prin virgulă, de pildă <code>r20=2,8,16</code>; gol = nicio alegere)"
msgstr "<code>POST /api/setari-seteaza?id=&lt;cheie&gt;&amp;r&lt;N&gt;=&lt;valoare&gt;</code>: ndryshon dhe ruan rreshtat e dërguar (një vlerë e gabuar nuk ndryshon asgjë; për zgjedhje të shumëfishta, si shpejtësitë e lëvizjes, zgjedhjet ndahen me presje, për shembull <code>r20=2,8,16</code>; bosh = asnjë zgjedhje)"

msgid "<code>POST /api/stocare-foloseste?punct=/media/usb</code>: folosește discul pentru înregistrări (face dosarul movie, fără formatare)"
msgstr "<code>POST /api/stocare-foloseste?punct=/media/usb</code>: përdor diskun për regjistrime (krijon dosjen movie, pa formatim)"

msgid "<code>POST /api/subtitrari-aspect-implicite</code>: toate înapoi la valorile de la început"
msgstr "<code>POST /api/subtitrari-aspect-implicite</code>: gjithçka kthehet në vlerat fillestare"

msgid "<code>POST /api/subtitrari-aspect-seteaza?stil_font=&lt;skin|ingust|tiresias_info|tiresias_pc|google:Alias&gt;&amp;grosime=&lt;automata|normala|ingrosata|foarte_ingrosata&gt;&amp;marime=&lt;60..200&gt;&amp;culoare=&lt;emisiune|%23rrggbb&gt;&amp;contur=&lt;fara|subtire|normal|gros|foarte_gros&gt;&amp;culoare_contur=&lt;%23rrggbb&gt;&amp;umbra=0|1&amp;culoare_umbra=&lt;%23rrggbb&gt;&amp;directie_umbra=&lt;sus|sus_dreapta|dreapta|jos_dreapta|jos|jos_stanga|stanga|sus_stanga&gt;&amp;distanta_umbra=&lt;50|100|150|200|300&gt;&amp;umbra_moale=&lt;tare|moale|foarte_moale&gt;&amp;fundal=&lt;niciunul|rand|cutie&gt;&amp;culoare_fundal=&lt;%23rrggbb&gt;&amp;opacitate_fundal=&lt;10..100&gt;&amp;jos=&lt;2..25&gt;&amp;spatiere=&lt;80|90|100|110|125|150&gt;&amp;marire_dvb=&lt;clara|ocr&gt;</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>alegeri</code>; o valoare greșită nu schimbă nimic); sau <code>stil=&lt;cheie&gt;</code>, un stil gata făcut"
msgstr "<code>POST /api/subtitrari-aspect-seteaza?stil_font=&lt;skin|ingust|tiresias_info|tiresias_pc|google:Alias&gt;&amp;grosime=&lt;automata|normala|ingrosata|foarte_ingrosata&gt;&amp;marime=&lt;60..200&gt;&amp;culoare=&lt;emisiune|%23rrggbb&gt;&amp;contur=&lt;fara|subtire|normal|gros|foarte_gros&gt;&amp;culoare_contur=&lt;%23rrggbb&gt;&amp;umbra=0|1&amp;culoare_umbra=&lt;%23rrggbb&gt;&amp;directie_umbra=&lt;sus|sus_dreapta|dreapta|jos_dreapta|jos|jos_stanga|stanga|sus_stanga&gt;&amp;distanta_umbra=&lt;50|100|150|200|300&gt;&amp;umbra_moale=&lt;tare|moale|foarte_moale&gt;&amp;fundal=&lt;niciunul|rand|cutie&gt;&amp;culoare_fundal=&lt;%23rrggbb&gt;&amp;opacitate_fundal=&lt;10..100&gt;&amp;jos=&lt;2..25&gt;&amp;spatiere=&lt;80|90|100|110|125|150&gt;&amp;marire_dvb=&lt;clara|ocr&gt;</code>: ndrysho dhe ruaj cilëndo prej tyre (vlerat e sakta janë te <code>alegeri</code>; një vlerë e gabuar nuk ndryshon asgjë); ose <code>stil=&lt;cheie&gt;</code>, një stil i gatshëm"

msgid "<code>POST /api/subtitrari-film-alege?id=&lt;id&gt;|oprit</code>, <code>POST /api/subtitrari-film-intarziere?ms=N</code> (sau <code>pas=</code>), <code>POST /api/subtitrari-film-codare?cod=..</code>, <code>POST /api/subtitrari-film-fps?fps=..</code>: aceleași alegeri ca tasta SUB la un film din fișier"
msgstr "<code>POST /api/subtitrari-film-alege?id=&lt;id&gt;|oprit</code>, <code>POST /api/subtitrari-film-intarziere?ms=N</code> (ose <code>pas=</code>), <code>POST /api/subtitrari-film-codare?cod=..</code>, <code>POST /api/subtitrari-film-fps?fps=..</code>: të njëjtat zgjedhje si me butonin SUB për një film nga një skedar"

msgid "<code>POST /api/subtitrari-ocr-zero</code>: contorul recunoașterii textului pus la zero"
msgstr "<code>POST /api/subtitrari-ocr-zero</code>: numëruesi i njohjes së tekstit rivendoset në zero"

msgid "<code>POST /api/sunet-seteaza?iesire=&lt;auto|manual&gt;&amp;ac3=&lt;da|nu&gt;&amp;dts=&lt;da|nu&gt;&amp;pista=&lt;da|nu&gt;</code>: oricare dintre ele, salvate; ac3 / dts sunt setările pentru Manual"
msgstr "<code>POST /api/sunet-seteaza?iesire=&lt;auto|manual&gt;&amp;ac3=&lt;da|nu&gt;&amp;dts=&lt;da|nu&gt;&amp;pista=&lt;da|nu&gt;</code>: secila prej tyre ruhet; ac3 / dts janë cilësimet për Manual"

msgid "<code>POST /api/telecomenzi-asociere?pas=inapoi|sari|gata|continua|anuleaza|proba|inchide&amp;pastreaza=0|1</code>: pașii asocierii unei telecomenzi noi"
msgstr "<code>POST /api/telecomenzi-asociere?pas=inapoi|sari|gata|continua|anuleaza|proba|inchide&amp;pastreaza=0|1</code>: hapat e çiftimit të një telekomande të re"

msgid "<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|oprit</code>: pornește sau oprește captura paginii (cititorul și proba numai ascultă, cel mult 2 minute)"
msgstr "<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|oprit</code>: nis ose ndalo kapjen e faqes (lexuesi dhe prova vetëm dëgjojnë, më së shumti 2 minuta)"

msgid "<code>POST /api/telecomenzi-schimba?actiune=activa|neasociate|redenumeste|sterge-tasta|sterge|sterge-tot&amp;id=..&amp;cod=..&amp;nume=..&amp;confirmat=1</code>: aceleași schimbări ca în lista de pe televizor"
msgstr "<code>POST /api/telecomenzi-schimba?actiune=activa|neasociate|redenumeste|sterge-tasta|sterge|sterge-tot&amp;id=..&amp;cod=..&amp;nume=..&amp;confirmat=1</code>: të njëjtat ndryshime si në listën në TV"

msgid "<code>POST /api/teletext-salveaza</code>, <code>POST /api/teletext-sterge?ref=</code>, <code>POST /api/teletext-reimprospateaza?ref=</code> (receptorul trece pe canal, așteaptă o trecere completă a teletextului, face copia și se întoarce la canalul de dinainte; răspunde pe loc), <code>POST /api/teletext-setari?hd=0|1&amp;contur=0|1&amp;umbra=0|1&amp;relief=0|1&amp;copie_automata=0|1&amp;spatiu=5|10|20|50|100</code> (<code>hd</code> = Teletext neted): aceleași alegeri ca meniul teletextului de pe televizor"
msgstr "<code>POST /api/teletext-salveaza</code>, <code>POST /api/teletext-sterge?ref=</code>, <code>POST /api/teletext-reimprospateaza?ref=</code> (marrësi kalon te kanali, pret një kalim të plotë të teletekstit, bën kopjen dhe kthehet te kanali i mëparshëm; përgjigjet menjëherë), <code>POST /api/teletext-setari?hd=0|1&amp;contur=0|1&amp;umbra=0|1&amp;relief=0|1&amp;copie_automata=0|1&amp;spatiu=5|10|20|50|100</code> (<code>hd</code> = Teletekst i lëmuar): të njëjtat zgjedhje si menuja e teletekstit në TV"

msgid "<code>POST /api/temporizatoare-adauga?ref=&lt;canal&gt;&amp;zi=AAAA-LL-ZZ&amp;inceput=HH:MM&amp;sfarsit=HH:MM&amp;nume=..&amp;doar_comuta=0|1</code>: pune o înregistrare (sau doar schimbarea canalului); la suprapunere nu pune nimic și spune cu ce se suprapune"
msgstr "<code>POST /api/temporizatoare-adauga?ref=&lt;canal&gt;&amp;zi=AAAA-LL-ZZ&amp;inceput=HH:MM&amp;sfarsit=HH:MM&amp;nume=..&amp;doar_comuta=0|1</code>: vendos një regjistrim (ose vetëm ndryshimin e kanalit); në rast mbivendosjeje nuk vendos asgjë dhe tregon me se mbivendoset"

msgid "<code>POST /api/temporizatoare-modifica?id=..&amp;zi=..&amp;inceput=..&amp;sfarsit=..&amp;repetare=o_data|zilnic|luni_vineri|zile&amp;zile=0,1,..&amp;dupa=nimic|asteptare|oprire|automat&amp;loc=..</code>: aceleași câmpuri ca fereastra de pe televizor, cu aceeași verificare a suprapunerii; <code>POST /api/temporizatoare-opreste?id=..&amp;alegere=stoponlycurrent|stopall|stoponlycoming</code>: una repetată care merge acum"
msgstr "<code>POST /api/temporizatoare-modifica?id=..&amp;zi=..&amp;inceput=..&amp;sfarsit=..&amp;repetare=o_data|zilnic|luni_vineri|zile&amp;zile=0,1,..&amp;dupa=nimic|asteptare|oprire|automat&amp;loc=..</code>: të njëjtat fusha si dritarja në TV, me të njëjtin kontroll mbivendosjeje; <code>POST /api/temporizatoare-opreste?id=..&amp;alegere=stoponlycurrent|stopall|stoponlycoming</code>: një kohëmatës i përsëritur që është duke u ekzekutuar tani"

msgid "<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, <code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, <code>POST /api/temporizatoare-curata?confirmat=1</code>: șterge una, o oprește sau o pornește din nou, șterge cele terminate"
msgstr "<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, <code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, <code>POST /api/temporizatoare-curata?confirmat=1</code>: fshi një kohëmatës, e ndalo ose e nis përsëri, fshi ata të përfunduar"

msgid "<code>POST /api/traducere-configurare-cauta</code>: caută în rețeaua de acasă serverele Ollama (11434) și LibreTranslate (5000); rezultatul vine în <code>cautare</code>"
msgstr "<code>POST /api/traducere-configurare-cauta</code>: kërko në rrjetin shtëpiak serverët Ollama (11434) și LibreTranslate (5000); rezultati vjen në <code>cautare</code>"

msgid "<code>POST /api/traducere-configurare-cheie</code>, corpul <code>cheie=&lt;cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: probează cheia pe loc și, dacă merge, o salvează și pornește traducerea; numai în corpul cererii, niciodată în adresă; rezultatul vine în <code>configurare</code> din <code>GET /api/traducere-configurare</code>"
msgstr "<code>POST /api/traducere-configurare-cheie</code>, trupi <code>cheie=&lt;cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: testo çelësin menjëherë dhe, nëse funksionon, ruaje dhe nis përkthimin; vetëm në trupin e kërkesës, kurrë në adresë; rezultati vjen në <code>configurare</code> nga <code>GET /api/traducere-configurare</code>"

msgid "<code>POST /api/traducere-configurare-model?model=..</code>: alt model pentru serviciul ales acum, cu probă"
msgstr "<code>POST /api/traducere-configurare-model?model=..</code>: një model tjetër për shërbimin e zgjedhur tani, me provë"

msgid "<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;&amp;adresa=..&amp;model=..</code>: folosește serverul din casă (adresa completată de receptor, modelul ales singur dacă lipsește) și îl probează"
msgstr "<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;&amp;adresa=..&amp;model=..</code>: përdor serverin nga shtëpia (adresa e plotësuar nga marrësi, modeli i zgjedhur vetvetiu nëse mungon) dhe testoje"

msgid "<code>POST /api/traducere-subtitrari-cheie</code>, corpul <code>serviciu=&lt;cod&gt;&amp;cheie=&lt;cheia&gt;</code>: pune cheia unui serviciu (goală = o șterge); la <code>serviciu=propriu</code> cheia este valoarea antetului adresei proprii (de exemplu <code>Bearer</code> și cheia); numai în corpul cererii, niciodată în adresă; răspunsul spune doar care serviciu are cheie"
msgstr "<code>POST /api/traducere-subtitrari-cheie</code>, trupi <code>serviciu=&lt;cod&gt;&amp;cheie=&lt;cheia&gt;</code>: vendos çelësin e një shërbimi (bosh = fshije); te <code>serviciu=propriu</code> çelësi është vlera e kokës së adresës vetjake (për shembull <code>Bearer</code> dhe çelësi); vetëm në trupin e kërkesës, kurrë në adresë; përgjigjja thotë vetëm se cili shërbim ka çelës"

msgid "<code>POST /api/traducere-subtitrari-proba</code>: probează traducerea cu serviciul ales; rezultatul vine în <code>stare.proba</code> din <code>GET /api/traducere-subtitrari</code>"
msgstr "<code>POST /api/traducere-subtitrari-proba</code>: testo përkthimin me shërbimin e zgjedhur; rezultati vjen në <code>stare.proba</code> nga <code>GET /api/traducere-subtitrari</code>"

msgid "<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=..&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;propriu_cale=..</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>alegeri</code>); o valoare greșită refuză tot. Adresa proprie: adresa e un șablon cu <code>{text}</code>, <code>{sursa}</code>, <code>{tinta}</code> (http:// numai pentru un server din rețeaua de acasă); adresa receptorului însuși (127.0.0.1, localhost, IP-ul lui) e refuzată, și la <code>adresa_libre</code> și <code>adresa_openai</code>; calea în JSON are chei și numere despărțite prin punct, <code>*</code> = toate elementele"
msgstr "<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=..&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;propriu_cale=..</code>: ndrysho dhe ruaj cilëndo prej tyre (vlerat e sakta janë te <code>alegeri</code>); një vlerë e gabuar refuzon gjithçka. Adresa vetjake: adresa është një shabllon me <code>{text}</code>, <code>{sursa}</code>, <code>{tinta}</code> (http:// vetëm për një server në rrjetin shtëpiak); adresa e vetë marrësit (127.0.0.1, localhost, IP-ja e tij) refuzohet, edhe te <code>adresa_libre</code> dhe <code>adresa_openai</code>; shtegu në JSON ka çelësa dhe numra të ndarë me pikë, <code>*</code> = të gjitha elementet"

msgid "<code>POST /api/traducere-subtitrari-zero</code>: contorul traducerii pus la zero"
msgstr "<code>POST /api/traducere-subtitrari-zero</code>: numëruesi i përkthimit u kthye në zero"

msgid "<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: fluxul TS al transmisiei acestui browser. Pornirea și fluxul merg numai din browserul conectat, cu antetul <code>X-HDS-CSRF</code>, niciodată cu <code>?token=</code>"
msgstr "<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: fluxi TS i transmetimit të këtij shfletuesi. Nisja dhe transmetimi funksionojnë vetëm nga shfletuesi i lidhur, me kokën <code>X-HDS-CSRF</code>, asnjëherë me <code>?token=</code>"

msgid "<code>POST /api/video-confirma</code> și <code>POST /api/video-revino</code>: păstrează modul încercat sau revine la cel de dinainte"
msgstr "<code>POST /api/video-confirma</code> dhe <code>POST /api/video-revino</code>: ruan mënyrën e provuar ose kthehet te e mëparshmja"

msgid "<code>POST /api/video-reporneste</code>: repornește receptorul (culorile „Ca la calculator” se aplică numai după o repornire); cu o înregistrare în curs, întrebarea apare pe televizor"
msgstr "<code>POST /api/video-reporneste</code>: rinis marrësin (ngjyrat „Si në kompjuter” zbatohen vetëm pas një rinisjeje); me një regjistrim në vazhdim, pyetja shfaqet në TV"

msgid "<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=..&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;ycbcr|rgb&gt;</code>: un mod nou se încearcă (aceeași întrebare pe televizor, 20 s, fără răspuns revine); zapmode se salvează direct; culori_hdmi=ycbcr se încearcă la fel (aceeași întrebare), rgb se salvează și se aplică după o repornire"
msgstr "<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=..&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;ycbcr|rgb&gt;</code>: provohet një mënyrë e re (e njëjta pyetje në TV, 20 s, pa përgjigje kthehet mbrapa); zapmode ruhet direkt; culori_hdmi=ycbcr provohet po ashtu (e njëjta pyetje), rgb ruhet dhe zbatohet pas një rinisjeje"

msgid "<p class=\"gol\">Niciun font descărcat încă.</p>"
msgstr "<p class=\"gol\">Ende nuk është shkarkuar asnjë font.</p>"

msgid "<p class=\"gol\">Nimic găsit.</p>"
msgstr "<p class=\"gol\">Nuk u gjet asgjë.</p>"

msgid "<span aria-hidden=\"true\">&#8595;</span> Descarcă playlist (M3U)"
msgstr "<span aria-hidden=\"true\">&#8595;</span> Shkarko listën e dëgjimit (M3U)"

msgid "<span aria-hidden=\"true\">&#9632;</span> Oprește live (înapoi la captură)"
msgstr "<span aria-hidden=\"true\">&#9632;</span> Ndalo transmetimin direkt (kthehu te kapja e ekranit)"

msgid "<span aria-hidden=\"true\">&#9654;</span> Privește live aici"
msgstr "<span aria-hidden=\"true\">&#9654;</span> Shiko drejtpërdrejt këtu"

msgid "<span class=\"mic\">descărcat</span>"
msgstr "<span class=\"mic\">i shkarkuar</span>"

msgid "<table><tr><th>Familia</th><th>Categorie</th><th>Diacritice</th><th>Familia întreagă</th><th></th></tr>"
msgstr "<table><tr><th>Familja</th><th>Kategoria</th><th>Shenjat diakritike</th><th>E gjithë familja</th><th></th></tr>"

msgid "<table><tr><th>Familia</th><th>Nume in skin</th><th>Mărime</th><th>Diacritice</th><th>Verificare</th><th></th></tr>"
msgstr "<table><tr><th>Familja</th><th>Emri në temë</th><th>Madhësia</th><th>Shenjat diakritike</th><th>Verifikimi</th><th></th></tr>"

msgid "? Playerele care îl folosesc nu mai primesc canalele, iar adresa nu mai merge niciodată. Dacă îl vrei din nou, descarci alt playlist."
msgstr "? Lexuesit (playere) që e përdorin nuk i marrin më kanalet dhe adresa nuk funksionon më kurrë. Nëse e dëshiron përsëri, shkarko një listë tjetër dëgjimi."

msgid "? Un skin care îl folosește va rămâne fără el."
msgstr "? Një temë që e përdor do të mbetet pa të."

msgid "A durat"
msgstr "Zgjati"

msgid "Accelerare 2D pe placa video"
msgstr "Përshpejtimi 2D në kartën videografike"

msgid "Accelerarea 2D nu există pe acest receptor."
msgstr "Përshpejtimi 2D nuk ekziston në këtë marrës."

msgid "Această intrare se deschide numai din telecomandă."
msgstr "Kjo hyrje hapet vetëm nga telekomanda."

msgid "Aceeași alegere este pe televizor, în __DRUM_MENIU__."
msgstr "E njëjta zgjedhje është në TV, te __DRUM_MENIU__."

msgid "Aceeași listă este pe televizor, la tasta TIMER sau în __DRUM_MENIU__."
msgstr "E njëjta listë është në TV, te butoni TIMER ose te __DRUM_MENIU__."

msgid "Aceeași probă e pe televizor, în __DRUM_MENIU__. Proba pornită din telecomandă se vede și aici."
msgstr "E njëjta provë është në TV, te __DRUM_MENIU__. Prova e nisur nga telekomanda shihet edhe këtu."

msgid "Același ecran e pe televizor, în __DRUM_MENIU__."
msgstr "I njëjti ekran është në TV, te __DRUM_MENIU__."

msgid "Același ecran este pe televizor, în __DRUM_MENIU__."
msgstr "I njëjti ekran është në TV, te __DRUM_MENIU__."

msgid "Același meniu ca la tasta MENU, cu aceleași intrări pentru nivelul ales pe receptor. La fiecare intrare: pagina ei din interfața web, dacă are, pagina de setări sau „Deschide pe televizor”."
msgstr "E njëjta meny si te butoni MENU, me të njëjtat hyrje për nivelin e zgjedhur në marrës. Për çdo hyrje: faqja e saj në ndërfaqen web, nëse ka, faqja e cilësimeve ose „Hap në TV”."

msgid "Același rând e pe televizor, în"
msgstr "I njëjti rresht është në TV, në"

msgid "Același utilitar e pe televizor, în __DRUM_MENIU__."
msgstr "I njëjti mjet është në TV, te __DRUM_MENIU__."

msgid "Același utilitar e pe televizor, în __DRUM_MENIU__. Cât ascultă pagina, tastele merg și pe televizor, cel mult 2 minute, iar pe televizor apare un anunț. Din Deep standby receptorul pornește numai cu telecomanda lui."
msgstr "I njëjti mjet është në TV, te __DRUM_MENIU__. Për sa kohë faqja dëgjon, butonat funksionojnë edhe në TV, më së shumti për 2 minuta, dhe në TV shfaqet një njoftim. Nga gatishmëria e thellë (Deep standby) marrësi ndizet vetëm me telekomandën e tij."

msgid "Același utilitar e pe televizor, în __DRUM_MENIU__. Placa Wi-Fi a receptorului recepționează numai rețelele de 2,4 GHz. Căutarea e aceeași ca la lista rețelelor Wi-Fi: nu trimite nimic altceva."
msgstr "I njëjti mjet është në TV, te __DRUM_MENIU__. Karta Wi-Fi e marrësit merr vetëm rrjetet 2.4 GHz. Kërkimi është i njëjtë si te lista e rrjeteve Wi-Fi: nuk dërgon asgjë tjetër."

msgid "Aceleași comenzi sunt pe televizor, în __DRUM_MENIU__."
msgstr "Të njëjtat komanda janë në TV, te __DRUM_MENIU__."

msgid "Aceleași culori sunt pe televizor, în __DRUM_MENIU__ › Culori pe roluri, unde le alegi pe o grilă. Paleta, opacitatea panourilor și pagina tehnică se aleg tot acolo."
msgstr "Të njëjtat ngjyra janë në TV, te __DRUM_MENIU__ › Ngjyrat sipas roleve, ku i zgjedh në një rrjetë. Paleta, opaciteti i paneleve dhe faqja teknike zgjidhen po aty."

msgid "Aceleași ecrane sunt pe televizor, în __DRUM_MENIU__."
msgstr "Të njëjtët ekrane janë në TV, te __DRUM_MENIU__."

msgid "Aceleași ecrane sunt pe televizor, în __DRUM_MENIU__; tasta albastră arată acolo textul brut."
msgstr "Të njëjtët ekrane janë në TV, te __DRUM_MENIU__; butoni i kaltër tregon tekstin e papërpunuar atje."

msgid "Aceleași extensii și acțiuni sunt pe televizor, în __DRUM_MENIU__."
msgstr "Të njëjtat shtesa dhe veprime janë në TV, te __DRUM_MENIU__."

msgid "Aceleași filme ca în lista de filme de pe televizor."
msgstr "Të njëjtët filma si në listën e filmave në TV."

msgid "Aceleași reglaje sunt pe televizor, în __DRUM_MENIU__."
msgstr "Të njëjtat rregullime janë në TV, te __DRUM_MENIU__."

msgid "Aceleași rezultate ca pe televizor, în Meniu, „Setări”, „Caută setări” (sau tasta TEXT în orice meniu): meniurile și setările pe care le arată acum receptorul. Literele mari și diacriticele nu contează. La fiecare rezultat: pagina lui din interfața web, dacă are, sau „Deschide pe televizor”, cu rândul găsit deja ales."
msgstr "Të njëjtat rezultate si në TV, te Menyja, „Cilësimet”, „Kërko cilësimet” (ose butoni TEXT në çdo meny): menytë dhe cilësimet që tregon tani marrësi. Shkronjat e mëdha dhe diakritiket nuk kanë rëndësi. Për çdo rezultat: faqja e tij në ndërfaqen web, nëse ka, ose „Hap në TV”, me rreshtin e gjetur tashmë të zgjedhur."

msgid "Aceleași rânduri, cu aceleași alegeri, sunt pe televizor în ecranul cu același nume. Rândurile care se văd depind de „__NIVEL__”, ales pe televizor în __DRUM_MENIU__. Setările fără listă de alegeri se schimbă de pe televizor."
msgstr "Të njëjtët rreshta, me të njëjtat zgjedhje, janë në TV në ekranin me të njëjtin emër. Rreshtat që shihen varen nga „__NIVEL__”, i zgjedhur në TV te __DRUM_MENIU__. Cilësimet pa listë zgjedhjesh ndryshohen nga TV."

msgid "Aceleași setări sunt pe televizor, în __DRUM_MENIU__ (cu nivelul de meniu Expert). Locul unde ai rămas se ține minte lângă film, în fișierul cu același nume și terminația .cuts, numai după primul minut și dacă stick-ul sau discul se poate scrie."
msgstr "Të njëjtat cilësime janë në TV, te __DRUM_MENIU__ (me nivelin e menysë Ekspert). Vendi ku ke mbetur mbahet mend pranë filmit, në skedarin me të njëjtin emër dhe me prapashtesën .cuts, vetëm pas minutës së parë dhe nëse në USB apo disk mund të shkruhet."

msgid "Aceleași setări sunt pe televizor, în __DRUM_MENIU__ (tasta albastră). Miniaturile le face browserul din poze; din pagină se văd numai stick-urile și discurile, nu memoria internă a receptorului."
msgstr "Të njëjtat cilësime janë në TV, te __DRUM_MENIU__ (butoni i kaltër). Miniaturat i bën shfletuesi nga fotot; nga faqja shihen vetëm USB-të dhe disqet, jo memoria e brendshme e marrësit."

msgid "Aceleași setări sunt pe televizor, în __DRUM_MENIU__ (în meniul playerului, tasta Menu), unde sunt și aceleași comenzi. Din pagină se văd numai stick-urile și discurile, nu memoria internă a receptorului."
msgstr "Të njëjtat cilësime janë në TV, te __DRUM_MENIU__ (në menynë e riprodhuesit, butoni Menu), ku janë edhe të njëjtat komanda. Nga faqja shihen vetëm USB-të dhe disqet, jo memoria e brendshme e marrësit."

msgid "Aceleași setări sunt pe televizor, în __DRUM_MENIU__, și cu OK ținut apăsat pe ecranul radio."
msgstr "Të njëjtat cilësime janë në TV, te __DRUM_MENIU__, si dhe me OK të mbajtur shtypur në ekranin e radios."

msgid "Aceleași setări sunt pe televizor, în __DRUM_MENIU__."
msgstr "Të njëjtat cilësime janë në TV, te __DRUM_MENIU__."

msgid "Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Redarea folosește biblioteca mpegts.js (Apache-2.0), venită cu imaginea: <a href=\"/tv/mpegts-licenta.txt\">licența</a>. Canalele cu imagine MPEG-2 și sunetul AC-3 (unde browserul nu îl redă singur) se decodează în browser, pe procesorul calculatorului, cu decodorul FFmpeg (LGPL-2.1) venit tot cu imaginea: <a href=\"/tv/tv-wasm/ffmpeg-licenta.txt\">licența și sursa</a>; toate licențele sunt în <a href=\"/licente\">Licențe</a>."
msgstr "Të njëjtat cilësime janë në TV, te __DRUM_MENIU__. Luajtja përdor bibliotekën mpegts.js (Apache-2.0), e ardhur me imazhin: <a href=\"/tv/mpegts-licenta.txt\">licenca</a>. Kanalet me figurë MPEG-2 dhe zë AC-3 (ku shfletuesi nuk e luan vetë) dekodohen në shfletues, në procesorin e kompjuterit, me dekoderin FFmpeg (LGPL-2.1) po ashtu të ardhur me imazhin: <a href=\"/tv/tv-wasm/ffmpeg-licenta.txt\">licenca dhe burimi</a>; të gjitha licencat janë te <a href=\"/licente\">Licencat</a>."

msgid "Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Serverele DNS au pagina lor: <a href=\"/dns\" id=\"legaturaDns\">Servere DNS</a>."
msgstr "Të njëjtat cilësime janë në TV, te __DRUM_MENIU__. Serverët DNS kanë faqen e tyre: <a href=\"/dns\" id=\"legaturaDns\">Serverët DNS</a>."

msgid "Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Tema și culorile paginilor web sunt în pagina Setări."
msgstr "Të njëjtat cilësime janë në TV, te __DRUM_MENIU__. Tema dhe ngjyrat e faqeve web janë në faqen Cilësimet."

msgid "Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Întârzierea pistei e și în ecranul tastei AUDIO."
msgstr "Të njëjtat cilësime janë në TV, te __DRUM_MENIU__. Vonesa e pistës është gjithashtu në ekranin e butonit AUDIO."

msgid "Aceleași setări sunt pe televizor, în „Fluxuri și setări”, pe tasta MENU."
msgstr "Të njëjtat cilësime janë në TV, te „Transmetimet dhe cilësimet”, te butoni MENU."

msgid "Acest browser:"
msgstr "Ky shfletues:"

msgid "Acest ecran se folosește pe televizor."
msgstr "Ky ekran përdoret në TV."

msgid "Acest receptor nu are încă unealta care face ecranul dintr-o poză."
msgstr "Ky marrës nuk e ka ende mjetin që krijon ekranin nga një foto."

msgid "Acesta e"
msgstr "Ky është"

msgid "Aceste două opțiuni sunt citite direct de codul care scrie jurnalul de cădere (bsod.cpp), chiar și la o prăbușire completă. Parola Wi-Fi nu intră niciodată în jurnal, oricare ar fi setările."
