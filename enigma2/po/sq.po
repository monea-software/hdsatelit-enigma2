msgstr "Skedari ngarkohet vetëm duke përdorur POST."

msgid "Fișierul trebuie trimis ca date binare."
msgstr "Skedari duhet të dërgohet si të dhëna binare."

msgid "Instalează de pe stick"
msgstr "Instalo nga USB"

msgid "Nu este suficient spațiu liber în /tmp pentru fișier."
msgstr "Nuk ka hapësirë të mjaftueshme të lirë në /tmp për skedarin."

msgid "Pune fișierul .ipk pe stick sau în /tmp prin FTP. Lista se reface singură când introduci stickul."
msgstr "Vendos skedarin .ipk në USB ose në /tmp përmes FTP. Lista përditësohet automatikisht kur fut USB-në."

msgid "Se încarcă deja un fișier. Așteaptă să se termine."
msgstr "Një skedar po ngarkohet tashmë. Prit derisa të përfundojë."

msgid "Se încarcă fișierul..."
msgstr "Po ngarkohet skedari..."

msgid "Încarcă un fișier .ipk din browser"
msgstr "Ngarko një skedar .ipk nga shfletuesi"

msgid "Pluginul are o parte făcută pentru altă versiune de Python și nu poate rula pe această imagine."
msgstr "Shtojca ka një pjesë të bërë për një version tjetër të Python dhe nuk mund të ekzekutohet në këtë imazh."

#, python-format
msgid "făcut pentru Python %s, imaginea are Python %s"
msgstr "bërë për Python %s, imazhi ka Python %s"

msgid "Radio DAB+ prin USB"
msgstr "Radio DAB+ përmes USB"

msgid "Modelul plăcii"
msgstr "Modeli i pllakës"

