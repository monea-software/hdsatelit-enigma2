msgid "Se alege cu captura_interval de la 0 (oprită) la 10."
msgstr "Zgjidhet me captura_interval nga 0 (e fikur) në 10."

msgid "La câte secunde se actualizează imaginea"
msgstr "Pas sa sekondash përditësohet figura"

msgid "Caută în meniu: scrie un cuvânt, de exemplu subtitrări"
msgstr "Kërko në meny: shkruaj një fjalë, për shembull titrat"

msgid "<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Caută în meniu”: meniurile și setările care au textul în nume (fără diacritice), cu drumul din meniu, valoarea de acum și pagina web"
msgstr "<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Kërko në meny”: menytë dhe cilësimet që kanë tekstin në emër (pa shenja diakritike), me rrugën në meny, vlerën aktuale dhe faqen web"

