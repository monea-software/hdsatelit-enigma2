msgid "Niciun aparat adăugat."
msgstr "Asnjë pajisje e shtuar."

msgid "Niciun aparat din casă nu are adrese fixe. Le adaugi din interfața web, în pagina TV în browser."
msgstr "Asnjë pajisje në shtëpi nuk ka adresa fikse. Shtoja ato nga ndërfaqja web, në faqen TV në shfletues."

msgid "Numai canalele TV se pot da unui aparat. Alege fila TV."
msgstr "Vetëm kanalet TV mund t'i jepen një pajisjeje. Zgjidh skedën TV."

msgid "Numele aparatului"
msgstr "Emri i pajisjes"

#, python-format
msgid "Revoci aparatul %s? Nu mai primește canalele și ghidul TV, iar adresele lui nu mai merg niciodată. Dacă îl vrei din nou, îl adaugi din nou."
msgstr "Revokon pajisjen %s? Ajo nuk do të marrë më kanalet dhe udhëzuesin TV, dhe adresat e saj nuk do të funksionojnë kurrë më. Nëse e do përsëri, shtoje atë përsëri."

msgid "Revocă"
msgstr "Revoko"

msgid "Scrie un nume pentru aparat."
msgstr "Shkruaj një emër për pajisjen."

msgid "Se adaugă aparatul..."
msgstr "Po shtohet pajisja..."

