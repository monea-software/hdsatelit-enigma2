msgid "În acest dosar nu e o listă de canale. Intră în dosarul care are fișierele lamedb și bouquets.tv, sau alege o arhivă."
msgstr "Në këtë dosje nuk ka listë kanalesh. Hyn në dosjen që përmban skedarët lamedb dhe bouquets.tv, ose zgjidh një arkivë."

msgid "Intră întâi într-un dosar (de pildă pe stick)."
msgstr "Hyn fillimisht në një dosje (për shembull në USB)."

msgid "În acest dosar nu se poate scrie. Alege altul."
msgstr "Në këtë dosje nuk mund të shkruhet. Zgjidh një tjetër."

msgid "Nu e nimic de șters."
msgstr "Nuk ka asgjë për të fshirë."

msgid "Un satelit păstrat, restul șterse"
msgid_plural "%d sateliți păstrați, restul șterse"
msgstr[0] "%d satelit i ruajtur, të tjerët të fshirë"
msgstr[1] "%d satelitë të ruajtur, të tjerët të fshirë"

msgid "Un satelit șters din receptor"
msgid_plural "%d sateliți șterși din receptor"
msgstr[0] "%d satelit i fshirë nga marrësi"
msgstr[1] "%d satelitë të fshirë nga marrësi"

msgid "Frecvența trebuie dată în MHz, între 2000 și 30000."
msgstr "Frekuenca duhet të jepet në MHz, midis 2000 dhe 30000."

msgid "Rata de simbol trebuie dată în kS/s, între 50 și 70000."
msgstr "Shpejtësia e simboleve duhet të jepet në kS/s, midis 50 dhe 70000."

msgid "O valoare a transponderului nu e bună: %s."
msgstr "Një vlerë e transponderit nuk është e saktë: %s."

msgid "Numai transponderele de satelit se pot schimba aici."
msgstr "Këtu mund të ndryshohen vetëm transponderët satelitorë."

msgid "Transponder schimbat: %s"
msgstr "Transponderi u ndryshua: %s"

msgid "Poziția satelitului nu e bună."
msgstr "Pozicioni i satelitit nuk është i saktë."

msgid "Transponderul nou cere frecvența, rata de simbol și polarizarea."
msgstr "Transponderi i ri kërkon frekuencën, shpejtësinë e simboleve dhe polarizimin."

msgid "TSID și ONID trebuie să fie între 0 și 65535."
msgstr "TSID dhe ONID duhet të jenë midis 0 dhe 65535."

msgid "Transponderul există deja (aceeași poziție, TSID și ONID)."
msgstr "Transponderi ekziston tashmë (i njëjti pozicion, TSID dhe ONID)."

msgid "Transponder nou: %s"
msgstr "Transponder i ri: %s"

msgid "Semnul „nou” scos de pe un canal"
msgid_plural "Semnul „nou” scos de pe %d canale"
msgstr[0] "Shenja “e re” u hoq nga %d kanal"
msgstr[1] "Shenja “e re” u hoq nga %d kanale"

msgid "Un PID nu e bun."
msgstr "Një PID nuk është i saktë."

msgid "Detalii schimbate: %s"
msgstr "Detajet u ndryshuan: %s"

msgid "Rândul ales nu e un flux."
msgstr "Rreshti i zgjedhur nuk është një transmetim."

msgid "Tipul fluxului nu e cunoscut."
msgstr "Lloji i transmetimit nuk njihet."

msgid "Un număr DVB al fluxului nu e bun."
msgstr "Një numër DVB i transmetimit nuk është i saktë."

msgid "Flux schimbat: %s"
msgstr "Transmetimi u ndryshua: %s"

msgid "Un buchet sortat"
msgid_plural "%d buchete sortate"
msgstr[0] "%d buqetë e renditur"
msgstr[1] "%d buqeta të renditura"

msgid "Aranjat după: %s"
msgstr "Renditur sipas: %s"

msgid "Scrie textul de căutat."
msgstr "Shkruaj tekstin për të kërkuar."

msgid "Un nume înlocuit"
msgid_plural "%d nume înlocuite"
msgstr[0] "%d emër i zëvendësuar"
msgstr[1] "%d emra të zëvendësuar"

msgid "Un canal adus înapoi din copie"
msgid_plural "%d canale aduse înapoi din copie"
msgstr[0] "%d kanal i rikthyer nga kopja"
msgstr[1] "%d kanale të rikthyera nga kopja"

msgid "Canale care vin din arhivă"
msgstr "Kanale që vijnë nga arkiva"

msgid "Sunt în arhivă, dar nu în lista de acum."
msgstr "Ato janë në arkivë, por jo në listën aktuale."

msgid "Canale care dispar"
msgstr "Kanale që zhduken"

msgid "Sunt în lista de acum, dar nu în arhivă: la „Înlocuiește lista de acum” pleacă; la „Adaugă numai ce lipsește” rămân."
msgstr "Ato janë në listën aktuale, por jo në arkivë: me “Zëvendëso listën aktuale” ato largohen; me “Shto vetëm ato që mungojnë” ato mbeten."

msgid "Canale cu alt nume în arhivă"
msgstr "Kanale me emër tjetër në arkivë"

msgid "Buchete care vin din arhivă"
msgstr "Buqeta që vijnë nga arkiva"

msgid "Buchete care dispar"
msgstr "Buqeta që zhduken"

msgid "La „Înlocuiește lista de acum” pleacă."
msgstr "Me “Zëvendëso listën aktuale” ato largohen."

msgid "Buchete schimbate de arhivă"
msgstr "Buqeta të ndryshuara nga arkiva"

msgid "Rânduri puse sau scoase față de lista de acum, sau altă ordine."
msgstr "Rreshta të shtuar ose të hequr krahasuar me listën aktuale, ose një renditje tjetër."

msgid "Lista canalelor (lamedb)"
msgstr "Lista e kanaleve (lamedb)"

msgid "nu se citește la fel"
msgstr "nuk lexohet njësoj"

msgid "Lista e scrisă și citită din nou, ca la salvare. Când grupa e goală, lista se scrie exact cum o vezi."
msgstr "Lista shkruhet dhe lexohet përsëri, si gjatë ruajtjes. Kur grupi është bosh, lista shkruhet saktësisht siç e sheh."

msgid "Rânduri care nu s-ar scrie la fel"
msgstr "Rreshta që nuk do të shkruheshin njësoj"

msgid "Nume prea lungi"
msgstr "Emra shumë të gjatë"

msgid "Receptorul citește cel mult 250 de octeți pe rând: la salvare numele acestea se scurtează."
msgstr "Marrësi lexon maksimumi 250 bajt për rresht: gjatë ruajtjes, këta emra shkurtohen."

msgid "Canale de pe sateliți care nu sunt în satellites.xml"
msgstr "Kanale nga satelitë që nuk janë në satellites.xml"

msgid "Receptorul nu are setările acestor sateliți: canalele nu pornesc până nu pui satelitul în setările antenei. Nimic nu e bifat; le ștergi numai dacă vrei."
msgstr "Marrësi nuk i ka cilësimet e këtyre satelitëve: kanalet nuk do të nisin derisa të shtosh satelitin në cilësimet e antenës. Asgjë nuk është e zgjedhur; fshiji vetëm nëse dëshiron."

msgid "Marcaje fără canale sub ele"
msgstr "Shënues pa kanale poshtë tyre"

msgid "Marcajul e urmat de alt marcaj sau e la sfârșitul buchetului."
msgstr "Shënuesi pasohet nga një shënues tjetër ose është në fund të buqetës."

msgid "HD în nume, tip SD în listă"
msgstr "HD në emër, lloji SD në listë"

msgid "Numele spune HD sau 4K, dar emițătorul îl anunță ca SD: filtrul „HD și 4K” nu-l prinde. Filtrul „HD în nume, tip SD” din „Adaugă canale” le arată pe toate, cu bife."
msgstr "Emri thotë HD ose 4K, por transmetuesi e njofton kanalin si SD: filtri “HD dhe 4K” nuk e kap atë. Filtri “HD në emër, lloji SD” te “Shto kanale” i shfaq të gjitha, me shenja zgjedhjeje."

msgid "Nu se pot porni pe televizor (ghid de programe, actualizări, date ale operatorului). Le poți șterge, dar unele le folosește receptorul."
msgstr "Ato nuk mund të luhen në televizor (udhëzuesi i programeve, përditësimet, të dhënat e operatorit). Mund t'i fshish, por disa përdoren nga marrësi."

msgid "răspunde cu eroarea %d"
msgstr "përgjigjet me gabimin %d"

msgid "Am încercat %d adrese de fluxuri din buchete: acestea nu răspund acum. Un flux poate merge din nou mai târziu; scoate-l numai dacă știi că nu mai există."
msgstr "U provuan %d adresa transmetimi nga buqetat: këto nuk përgjigjen tani. Një transmetim mund të funksionojë përsëri më vonë; hiqeni vetëm nëse e dini se nuk ekziston më."

msgid "Fluxuri care nu răspund"
msgstr "Transmetime që nuk përgjigjen"

msgid "Sigle nefolosite"
msgstr "Logo të papërdorura"

msgid "Siglele din dosarele de sigle care nu se potrivesc cu niciun canal din listă (nici după referință, nici după nume). Nimic nu e bifat."
msgstr "Logot në dosjet e logove që nuk përputhen me asnjë kanal në listë (as sipas referencës, as sipas emrit). Asgjë nuk është e zgjedhur."

msgid "HD în nume, tip SD"
msgstr "HD në emër, lloji SD"

msgid "Noi"
msgstr "Të reja"

msgid "Blocate"
msgstr "Të bllokuara"

msgid "internet"
msgstr "internet"

msgid "Scoate dintr-un buchet..."
msgstr "Hiq nga një buqetë..."

msgid "Din ce buchet îl scoți?"
msgstr "Nga cila buqetë po e heq?"

msgid "Pune siglă..."
msgstr "Vendos logon..."

msgid "Copiază sigla de la alt canal..."
msgstr "Kopjo logon nga një kanal tjetër..."

msgid "Șterge sigla"
msgstr "Fshi logon"

msgid "Sigla e pusă."
msgstr "Logoja është vendosur."

msgid "Alege o imagine (PNG, JPG): se micșorează la 220 x 132 și se pune ca siglă."
msgstr "Zgjidh një imazh (PNG, JPG): zvogëlohet në 220 x 132 dhe vendoset si logo."

msgid "Scoate semnul „nou”"
msgstr "Hiq shenjën „e re”"

msgid "Editează fluxul"
msgstr "Edito fluxin"

msgid "Tipul fluxului"
msgstr "Lloji i fluxit"

msgid "Numerele DVB ale fluxului (pentru siglă): SID, TSID, ONID, namespace (hex)"
msgstr "Numrat DVB të fluxit (për logon): SID, TSID, ONID, namespace (hex)"

msgid "Aranjează după alt buchet..."
msgstr "Rendit sipas një buqete tjetër..."

msgid "Scoate marcajele din buchet"
msgstr "Hiq shënuesit nga buqeta"

msgid "Descarcă tabelul (CSV)"
msgstr "Shkarko tabelën (CSV)"

msgid "Lipește o listă de nume..."
msgstr "Ngjit një listë emrash..."

msgid "Câte un nume de canal pe rând. Cele găsite se adaugă în buchet, în ordinea din listă."
msgstr "Nga një emër kanali për rresht. Ato që gjenden shtohen në buqetë, sipas renditjes në listë."

msgid "Găsite / negăsite:"
msgstr "Të gjetura / të pagjetura:"

msgid "Satelit, apoi nume"
msgstr "Satelit, pastaj emër"

msgid "Furnizor, apoi nume"
msgstr "Ofrues, pastaj emër"

msgid "Sortează buchetele alese"
msgstr "Rendit buqetat e zgjedhura"

msgid "Păstrează numai cei bifați"
msgstr "Mbaj vetëm ato të shënuara"

msgid "Toate canalele și transponderele sateliților bifați se șterg din receptor și din buchete. Poți anula până la salvare."
msgstr "Të gjitha kanalet dhe transponderët e satelitëve të shënuar fshihen nga marrësi dhe nga buqetat. Mund ta anulosh deri në ruajtje."

msgid "Se șterg din receptor toate canalele celorlalți sateliți (și din buchete). Poți anula până la salvare."
msgstr "Fshihen nga marrësi të gjitha kanalet e satelitëve të tjerë (dhe nga buqetat). Mund ta anulosh deri në ruajtje."

msgid "Sateliți:"
msgstr "Satelitë:"

msgid "Verifică lista"
msgstr "Kontrollo listën"

msgid "Curățenie"
msgstr "Pastrim"

msgid "Arată toate canalele ascunse"
msgstr "Shfaq të gjitha kanalet e fshehura"

msgid "Deblochează toate canalele"
msgstr "Zhblloko të gjitha kanalet"

msgid "Scoate semnul „nou” de pe toate canalele"
msgstr "Hiq shenjën „i ri” nga të gjitha kanalet"

msgid "Sigle"
msgstr "Logo"

msgid "Redenumește siglele după referință"
msgstr "Riemërto logot sipas referencës"

msgid "Redenumește siglele după nume"
msgstr "Riemërto logot sipas emrit"

msgid "Înlocuiește în nume..."
msgstr "Zëvendëso në emra..."

msgid "Înlocuiește cu"
msgstr "Zëvendëso me"

msgid "Și în numele buchetelor"
msgstr "Edhe në emrat e buqetave"

msgid "Se schimbă:"
msgstr "Ndryshohet:"

msgid "Înlocuiește"
msgstr "Zëvendëso"

msgid "Mai mari"
msgstr "Më të mëdha"

msgid "Mai mici"
msgstr "Më të vogla"

msgid "Mod avansat: pornit"
msgstr "Modaliteti i avancuar: aktiv"

msgid "Mod avansat: oprit"
msgstr "Modaliteti i avancuar: joaktiv"

msgid "Modul avansat arată și editarea transponderelor, a fișierului satellites.xml și a detaliilor canalelor. Greșelile de acolo pot opri canalele."
msgstr "Modaliteti i avancuar shfaq gjithashtu editimin e transponderëve, të skedarit satellites.xml dhe detajeve të kanaleve. Gabimet aty mund të bëjnë që kanalet të mos funksionojnë."

msgid "Sateliți și transpondere (satellites.xml)"
msgstr "Satelitë dhe transponderë (satellites.xml)"

msgid "Satelit nou"
msgstr "Satelit i ri"

msgid "Salvează satellites.xml"
msgstr "Ruaj satellites.xml"

msgid "Schimbările se scriu în satellites.xml numai la „Salvează satellites.xml”, cu o copie înainte. Nu intră în „Anulează”."
msgstr "Ndryshimet shkruhen në satellites.xml vetëm te „Ruaj satellites.xml”, me një kopje përpara. Nuk përfshihen te „Anulo”."

msgid "satellites.xml e salvat și receptorul îl folosește."
msgstr "satellites.xml është ruajtur dhe marrësi po e përdor."

msgid "satellites.xml e salvat; se vede după repornirea interfeței."
msgstr "satellites.xml është ruajtur; do të jetë i dukshëm pas rinisjes së ndërfaqes."

msgid "Transponder nou"
msgstr "Transponder i ri"

msgid "Poziția (de pildă 19.2E sau 30W)"
msgstr "Pozicioni (për shembull 19.2E ose 30W)"

msgid "Editează transponderul"
msgstr "Ndrysho transponderin"

msgid "Transponder nou în lista de canale"
msgstr "Transponder i ri në listën e kanaleve"

msgid "Transponderul nou n-are canale: o căutare pe el le aduce."
msgstr "Transponderi i ri nuk ka kanale: një kërkim në të do t'i gjejë ato."

msgid "Rata de simbol (kS/s)"
msgstr "Shpejtësia e simboleve (kS/s)"

msgid "Steagurile"
msgstr "Flamujt"

msgid "PID-uri ținute minte (cod:valoare hex)"
msgstr "PID-të e ruajtura (kodi:vlera hex)"

msgid "Ascuns în listă"
msgstr "I fshehur në listë"

msgid "Păstrează numele la scanare"
msgstr "Ruaj emrin gjatë kërkimit"

msgid "Nou găsit"
msgstr "Sapo u gjet"

msgid "Fără SDT"
msgstr "Pa SDT"

msgid "Fără DVB"
msgstr "Pa DVB"

msgid "Buchet nou din cele bifate"
msgstr "Buqetë e re nga ato të zgjedhura"

msgid "Adu înapoi cele bifate"
msgstr "Ktheji ato të zgjedhura"

msgid "Șterge marcajele bifate"
msgstr "Fshi shënuesit e zgjedhur"

msgid "Scoate din buchete cele bifate"
msgstr "Hiq nga buqetat ato të zgjedhura"

msgid "Șterge siglele bifate"
msgstr "Fshi logot e zgjedhura"

msgid "Înapoi la import"
msgstr "Mbrapa te importimi"

msgid "Sfat: bifează rândurile, apoi folosește butoanele de jos. Nimic nu se scrie în receptor până la „Salvează”."
msgstr "Këshillë: zgjidh rreshtat, pastaj përdor butonat më poshtë. Asgjë nuk shkruhet në marrës derisa të shtypësh “Ruaj”."

msgid "În buchetele"
msgstr "Në buqetat"

msgid "MIS (is_id)"
msgstr "MIS (is_id)"

msgid "Modul PLS"
msgstr "Modaliteti PLS"

msgid "Root"
msgstr "Root"

msgid "Gold"
msgstr "Gold"

msgid "Combo"
msgstr "Combo"

msgid "Copia de siguranță a listei sateliților nu s-a putut face (%s). Nu s-a scris nimic."
msgstr "Kopja rezervë e listës së satelitëve nuk mund të bëhej (%s). Asgjë nuk u shkrua."

msgid "Câmpul flags trebuie să fie un număr între 0 și 255."
msgstr "Fusha e flamujve duhet të jetë një numër midis 0 dhe 255."

msgid "Frecvența pare scrisă în MHz. Scrie-o în kHz: %d."
msgstr "Frekuenca duket se është shkruar në MHz. Shkruaje në kHz: %d."

msgid "Frecvența trebuie să fie în kHz, între %d și %d."
msgstr "Frekuenca duhet të jetë në kHz, midis %d dhe %d."

msgid "La DVB-S FEC-ul e Auto (0), 1/2, 2/3, 3/4, 5/6 sau 7/8 (1-5)."
msgstr "Te DVB-S, FEC-i është Auto (0), 1/2, 2/3, 3/4, 5/6 ose 7/8 (1-5)."

msgid "La DVB-S modulația e numai QPSK (1) sau Auto (0)."
msgstr "Te DVB-S, modulimi është vetëm QPSK (1) ose Auto (0)."

msgid "Lista nouă a sateliților nu a ieșit bine, așa că nu s-a scris. Fișierul vechi a rămas cum era."
msgstr "Lista e re e satelitëve nuk doli mirë, kështu që nuk u shkrua. Skedari i vjetër mbeti siç ishte."

msgid "Lista sateliților (%s) e goală sau nu are forma unui satellites.xml."
msgstr "Lista e satelitëve (%s) është bosh ose nuk ka formën e një satellites.xml."

msgid "Lista sateliților (%s) nu se poate citi: e stricată pe rândul %d."
msgstr "Lista e satelitëve (%s) nuk mund të lexohet: është e dëmtuar në rreshtin %d."

msgid "Lista sateliților nu s-a putut scrie (%s). Fișierul vechi a rămas cum era."
msgstr "Lista e satelitëve nuk mund të shkruhej (%s). Skedari i vjetër mbeti siç ishte."

msgid "Lista sateliților s-a schimbat între timp pe receptor. Deschide-o din nou, ca să nu pierzi schimbările de acolo."
msgstr "Lista e satelitëve ka ndryshuar ndërkohë në marrës. Hape përsëri, që të mos humbësh ndryshimet e bëra atje."

msgid "Nu e loc destul în memoria receptorului pentru lista sateliților."
msgstr "Nuk ka hapësirë të mjaftueshme në memorien e marrësit për listën e satelitëve."

msgid "Nu există niciun satelit pe %s."
msgstr "Nuk ekziston asnjë satelit në %s."

msgid "Nu pot citi lista sateliților (%s)."
msgstr "Nuk mund ta lexoj listën e satelitëve (%s)."

msgid "Numele atributului „%s” nu e bun."
msgstr "Emri i atributit “%s” nuk është i vlefshëm."

msgid "Numele satelitului are un caracter care nu se poate scrie în listă."
msgstr "Emri i satelitit ka një karakter që nuk mund të shkruhet në listë."

msgid "Numele satelitului e prea lung: cel mult %d de caractere."
msgstr "Emri i satelitit është shumë i gjatë: maksimumi %d karaktere."

msgid "Pe %s există deja satelitul %s."
msgstr "Në %s ekziston tashmë sateliti %s."

msgid "Pe %s există deja transponderul %s, cu aceeași polarizare, la cel mult 2 MHz."
msgstr "Në %s ekziston tashmë transponderi %s, me të njëjtin polarizim, maksimumi 2 MHz larg."

msgid "Polarizarea trebuie să fie H, V, L sau R (0, 1, 2 sau 3)."
msgstr "Polarizimi duhet të jetë H, V, L ose R (0, 1, 2 ose 3)."

msgid "Poziția trebuie să fie între 180,0W și 180,0E."
msgstr "Pozicioni duhet të jetë midis 180.0W dhe 180.0E."

msgid "Poziția „%s” nu e bună. Scrie-o ca 19,2E sau 30,0W."
msgstr "Pozicioni “%s” nuk është i vlefshëm. Shkruaje si 19.2E ose 30.0W."

msgid "Rata de simbol pare scrisă în kS/s. Scrie-o în simboluri pe secundă: %d."
msgstr "Shpejtësia e simboleve duket se është shkruar në kS/s. Shkruaje në simbole për sekondë: %d."

msgid "Rata de simbol trebuie să fie în simboluri pe secundă, între %d și %d."
msgstr "Shpejtësia e simboleve duhet të jetë në simbole për sekondë, midis %d dhe %d."

msgid "Scrie numele satelitului."
msgstr "Shkruaj emrin e satelitit."

msgid "Sistemul trebuie să fie DVB-S sau DVB-S2 (0 sau 1)."
msgstr "Sistemi duhet të jetë DVB-S ose DVB-S2 (0 ose 1)."

msgid "Transponderul are nevoie de frecvență, rată de simbol și polarizare."
msgstr "Transponderi ka nevojë për frekuencë, shpejtësi simbolesh dhe polarizim."

msgid "Transponderul nu mai există pe %s. Deschide din nou lista."
msgstr "Transponderi nuk ekziston më në %s. Hape listën përsëri."

msgid "Valoarea atributului %s are un caracter care nu se poate scrie în listă."
msgstr "Vlera e atributit %s ka një karakter që nuk mund të shkruhet në listë."

msgid "Valoarea pentru %s trebuie să fie un număr întreg."
msgstr "Vlera për %s duhet të jetë një numër i plotë."

msgid "Valoarea pentru %s trebuie să fie între %d și %d."
msgstr "Vlera për %s duhet të jetë midis %d dhe %d."

msgid "Nu s-a putut lucra cu siglele din %s."
msgstr "Nuk mund të punohej me logot në %s."

msgid "Rândul ales nu e un canal, deci nu poate avea siglă."
msgstr "Rreshti i zgjedhur nuk është kanal, prandaj nuk mund të ketë logo."

msgid "Referința canalului nu are numerele DVB: sigla s-ar vedea la mai multe canale."
msgstr "Referenca e kanalit nuk ka numra DVB: logoja do të shfaqej në disa kanale."

msgid "Nu e niciun dosar de sigle în care să se poată scrie."
msgstr "Nuk ka asnjë dosje logosh në të cilën mund të shkruhet."

msgid "Fișierul nu e o imagine PNG bună. Alege o siglă în format PNG."
msgstr "Skedari nuk është një imazh i vlefshëm PNG. Zgjidh një logo në formatin PNG."

msgid "Fișierul are %d KB. O siglă poate avea cel mult %d KB."
msgstr "Skedari është %d KB. Një logo mund të jetë maksimumi %d KB."

msgid "Imaginea are %d x %d pixeli. O siglă poate avea cel mult %d x %d pixeli."
msgstr "Imazhi është %d x %d pikselë. Një logo mund të jetë maksimumi %d x %d pikselë."

msgid "Nu e destul loc liber pentru siglă în %s."
msgstr "Nuk ka hapësirë të mjaftueshme për logon në %s."

msgid "Canalul are deja o siglă într-un dosar în care nu se poate scrie: %s"
msgstr "Kanali tashmë ka një logo në një dosje në të cilën nuk mund të shkruhet: %s"

msgid "Canalul de la care copiezi nu are siglă."
msgstr "Kanali nga i cili po kopjon nuk ka logo."

msgid "Televizorul caută siglele numai după referință. După redenumirea după nume, nu le mai arată."
msgstr "Televizori kërkon logot vetëm sipas referencës. Pas riemërtimit sipas emrit, nuk i shfaq më ato."

msgid "Redenumirea se face după referință sau după nume."
msgstr "Riemërtimi bëhet sipas referencës ose sipas emrit."

msgid "Pe poziția nouă sunt deja aceleași transpondere."
msgstr "Në pozicionin e ri janë tashmë të njëjtët transponderë."

msgid "Satelit copiat: %s -> %s"
msgstr "Sateliti u kopjua: %s -> %s"

msgid "Satelit mutat: %s -> %s"
msgstr "Sateliti u zhvendos: %s -> %s"

msgid "Mută satelitul pe altă poziție..."
msgstr "Zhvendos satelitin në një pozicion tjetër..."

msgid "Copiază satelitul pe altă poziție..."
msgstr "Kopjo satelitin në një pozicion tjetër..."

msgid "Releele receptorului (adresele 127.0.0.1) nu se încearcă: merg numai când sunt pornite. Rânduri sărite: %d."
msgstr "Reletë e marrësit (adresat 127.0.0.1) nuk provohen: ato funksionojnë vetëm kur janë të ndezura. Rreshta të kapërcyer: %d."

msgid "Sfaturi: în stânga sunt canalele, în dreapta buchetul; Stânga / Dreapta trec dintr-o parte în alta. OK adaugă canalul sau ia rândul ca să-l muți, galben bifează mai multe. Jos scrie ce face fiecare tastă colorată, MENU are restul. Nimic nu se scrie până nu salvezi, iar tasta < anulează. HELP: ajutorul."
msgstr "Këshilla: në të majtë janë kanalet, në të djathtë buqeta; Majtas / Djathtas kalojnë nga njëra anë në tjetrën. OK shton kanalin ose merr rreshtin për ta zhvendosur, e verdha shënon disa. Në fund shkruhet se çfarë bën çdo buton me ngjyrë, MENU ka pjesën tjetër. Asgjë nuk shkruhet derisa të ruash, dhe butoni < anulon. HELP: ndihma."

msgid "Nicio schimbare de la ultima salvare."
msgstr "Asnjë ndryshim që nga ruajtja e fundit."

msgid "Ștergi %d transponder din receptor, cu canalele lui? Dispar și din buchete."
msgid_plural "Ștergi %d transpondere din receptor, cu canalele lor? Dispar și din buchete."
msgstr[0] "A dëshiron të fshish %d transponder nga marrësi, së bashku me kanalet e tij? Ato do të zhduken edhe nga buqetat."
msgstr[1] "A dëshiron të fshish %d transponderë nga marrësi, së bashku me kanalet e tyre? Ato do të zhduken edhe nga buqetat."

msgid "%d buchet ales: canalele lui care lipsesc intră în listă, restul listei rămâne."
msgid_plural "%d buchete alese: canalele lor care lipsesc intră în listă, restul listei rămâne."
msgstr[0] "%d buqetë e zgjedhur: kanalet e saj që mungojnë hyjnë në listë, pjesa tjetër e listës mbetet."
msgstr[1] "%d buqeta të zgjedhura: kanalet e tyre që mungojnë hyjnë në listë, pjesa tjetër e listës mbetet."

msgid "%d canal fără nume"
msgid_plural "%d canale fără nume"
msgstr[0] "%d kanal pa emër"
msgstr[1] "%d kanale pa emër"

msgid "%d canal cu nume de test"
msgid_plural "%d canale cu nume de test"
msgstr[0] "%d kanal me emër testimi"
msgstr[1] "%d kanale me emër testimi"

msgid "%d rând dublat"
msgid_plural "%d rânduri dublate"
msgstr[0] "%d rresht i dubluar"
msgstr[1] "%d rreshta të dubluar"

msgid "%d canal care nu mai există"
msgid_plural "%d canale care nu mai există"
msgstr[0] "%d kanal që nuk ekziston më"
msgstr[1] "%d kanale që nuk ekzistojnë më"

msgid "%d buchet gol"
msgid_plural "%d buchete goale"
msgstr[0] "%d buqetë bosh"
msgstr[1] "%d buqeta bosh"

msgid "%d buchet găsit pe disc"
msgid_plural "%d buchete găsite pe disc"
msgstr[0] "%d buqetë e gjetur në disk"
msgstr[1] "%d buqeta të gjetura në disk"

msgid "refăcut automat"
msgstr "rindërtuar automatikisht"

msgid "Buchetele erau deja în această ordine."
msgstr "Buqetat ishin tashmë në këtë renditje."

msgid "Buchetul era deja în această ordine."
msgstr "Buqeta ishte tashmë në këtë renditje."

msgid "Păstrezi numai %d satelit? Canalele și transponderele tuturor celorlalți (și cablul, terestrul) dispar din receptor și din buchete."
msgid_plural "Păstrezi numai %d sateliți? Canalele și transponderele tuturor celorlalți (și cablul, terestrul) dispar din receptor și din buchete."
msgstr[0] "A dëshiron të mbash vetëm %d satelit? Kanalet dhe transponderët e të gjithë të tjerëve (përfshirë kabllorin dhe tokësorin) do të zhduken nga marrësi dhe nga buqetat."
msgstr[1] "A dëshiron të mbash vetëm %d satelitë? Kanalet dhe transponderët e të gjithë të tjerëve (përfshirë kabllorin dhe tokësorin) do të zhduken nga marrësi dhe nga buqetat."

msgid "Ștergi %d satelit din receptor, cu toate canalele lui (TV, radio, date) și transponderele? Dispar și din buchete."
msgid_plural "Ștergi %d sateliți din receptor, cu toate canalele lor (TV, radio, date) și transponderele? Dispar și din buchete."
msgstr[0] "A dëshiron të fshish %d satelit nga marrësi, me të gjitha kanalet e tij (TV, radio, të dhëna) dhe transponderët? Ato do të zhduken edhe nga buqetat."
msgstr[1] "A dëshiron të fshish %d satelitë nga marrësi, me të gjitha kanalet e tyre (TV, radio, të dhëna) dhe transponderët? Ato do të zhduken edhe nga buqetat."

msgid "Ștergi %d canal (TV, radio și date) și transponderele satelitului? Dispar și din buchete."
msgid_plural "Ștergi %d canale (TV, radio și date) și transponderele satelitului? Dispar și din buchete."
msgstr[0] "A dëshiron të fshish %d kanal (TV, radio dhe të dhëna) dhe transponderët e satelitit? Ato do të zhduken edhe nga buqetat."
msgstr[1] "A dëshiron të fshish %d kanale (TV, radio dhe të dhëna) dhe transponderët e satelitit? Ato do të zhduken edhe nga buqetat."

msgid "%d canal nou în receptor"
msgid_plural "%d canale noi în receptor"
msgstr[0] "%d kanal i ri në marrës"
msgstr[1] "%d kanale të reja në marrës"

msgid "%d canal schimbat în receptor"
msgid_plural "%d canale schimbate în receptor"
msgstr[0] "%d kanal i ndryshuar në marrës"
msgstr[1] "%d kanale të ndryshuara në marrës"

msgid "Din ce buchet le scoți?"
msgstr "Nga cila buqetë i heq ato?"

msgid "Ștergi transponderul și %d canal de pe el? Dispare și din buchete."
msgid_plural "Ștergi transponderul și cele %d canale de pe el? Dispar și din buchete."
msgstr[0] "A dëshiron të fshish transponderin dhe %d kanal që ndodhet në të? Ai do të zhduket edhe nga buqetat."
msgstr[1] "A dëshiron të fshish transponderin dhe %d kanalet që ndodhen në të? Ato do të zhduken edhe nga buqetat."

msgid "Alege buchetele…"
msgstr "Zgjidh buqetat…"

msgid "Le vezi în MENU."
msgstr "I sheh ato në MENU."

msgid "Adaugă înaintea rândului ales din buchet"
msgstr "Shto përpara rreshtit të zgjedhur të buqetës"

msgid "Adaugă la începutul buchetului"
msgstr "Shto në fillim të buqetës"

msgid "Leagă de canalul ales în stânga (siglă și ghid): %s"
msgstr "Lidh me kanalin e zgjedhur në të majtë (logo dhe udhëzues): %s"

msgid "Înlocuiește aceste buchete"
msgstr "Zëvendëso këto buqeta"

msgid "Pune în alternativele din dreapta"
msgstr "Vendos në alternativat në të djathtë"

msgid "Ce s-ar scrie altfel decât se vede, canalele fără satelit în setări, marcajele goale, HD în nume cu tip SD, serviciile de date. Nimic nu se schimbă fără bifa ta."
msgstr "Çfarë do të shkruhej ndryshe nga ajo që sheh, kanalet sateliti i të cilëve nuk është në cilësime, shënuesit bosh, HD në emër me tip SD, shërbimet e të dhënave. Asgjë nuk ndryshon pa shenjën tënde."

msgid "Lista e în ordine."
msgstr "Lista është në rregull."

msgid "Niciun buchet gol."
msgstr "Asnjë buqetë bosh."

msgid "Niciun transponder fără canale."
msgstr "Asnjë transponder pa kanale."

msgid "Adresele fluxurilor din buchete se încearcă acum, câteva secunde fiecare."
msgstr "Adresat e transmetimeve në buqeta po provohen tani, nga pak sekonda secila."

msgid "Toate fluxurile încercate răspund."
msgstr "Të gjitha transmetimet e provuara përgjigjen."

msgid "Toate siglele sunt folosite."
msgstr "Të gjitha logot janë në përdorim."

msgid "Ce e altfel în lista de acum față de copie. Din canalele noi faci un buchet; pe cele care nu mai sunt le aduci înapoi."
msgstr "Çfarë është ndryshe në listën aktuale krahasuar me kopjen. Nga kanalet e reja bën një buqetë; ato që nuk janë më i kthen mbrapsht."

msgid "Lista de acum e la fel ca în copie."
msgstr "Lista aktuale është e njëjtë me kopjen."

msgid "Ce s-ar schimba dacă lista din arhivă ar înlocui lista de acum."
msgstr "Çfarë do të ndryshonte nëse lista nga arkivi do të zëvendësonte listën aktuale."

msgid "Lista din arhivă e la fel ca lista de acum."
msgstr "Lista në arkiv është e njëjtë me listën aktuale."

msgid "Alege buchetele"
msgstr "Zgjidh buqetat"

msgid "Bifează buchetele din arhivă pe care le iei. Canalele lor se adaugă în listă; celelalte buchete ale tale rămân cum sunt."
msgstr "Zgjidh buqetat nga arkivi që dëshiron të marrësh. Kanalet e tyre shtohen në listë; buqetat e tua të tjera mbeten siç janë."

msgid "În arhivă nu e niciun buchet."
msgstr "Në arkiv nuk ka asnjë buqetë."

msgid "Alte unelte"
msgstr "Mjete të tjera"

msgid "MENU > Verifică lista, Buchete goale, Transpondere fără canale, Fluxuri care nu răspund, Sigle nefolosite și Curățenie (ascunse, blocate, semnul „nou”). În lista sateliților sau a furnizorilor, galben bifează mai mulți: MENU face câte un buchet din fiecare sau îi șterge din receptor. Copii de siguranță > galben compară o copie cu lista de acum: din canalele noi faci un buchet, pe cele dispărute le aduci înapoi."
msgstr "MENU > Kontrollo listën, Buqeta bosh, Transponderë pa kanale, Transmetime që nuk përgjigjen, Logo të papërdorura dhe Pastrim (të fshehura, të bllokuara, shenja „e re”). Në listën e satelitëve ose ofruesve, e verdha zgjedh disa: MENU bën një buqetë nga secili ose i fshin nga marrësi. Kopje rezervë > e verdha krahason një kopje me listën aktuale: nga kanalet e reja bën një buqetë, ato që janë zhdukur i kthen mbrapsht."

msgid "Căutarea și filtrele"
msgstr "Kërkimi dhe filtrat"

msgid "Căutarea găsește după nume, furnizor, SID, frecvență sau referință; „*” și „?” se potrivesc pe tot numele („*sport” se termină cu sport); o literă greșită se iartă când nu găsește altceva. Albastru: filtrele, și cele ale listei (noi, blocate, ascunse, în niciun buchet, fără siglă, HD în nume cu tip SD)."
msgstr "Kërkimi gjen sipas emrit, ofruesit, SID, frekuencës ose referencës; „*” dhe „?” përputhen me të gjithë emrin („*sport” mbaron me sport); një shkronjë e gabuar falet kur nuk gjendet gjë tjetër. Blu: filtrat, përfshirë ato të listës (të reja, të bllokuara, të fshehura, në asnjë buqetë, pa logo, HD në emër me tip SD)."

msgid "Șterge buchetele bifate"
msgstr "Fshi buqetat e zgjedhura"

msgid "Importă buchetele bifate"
msgstr "Importo buqetat e zgjedhura"

msgid "În listă"
msgstr "Në listë"

msgid "Tipul serviciului"
msgstr "Tipi i shërbimit"

msgid "Sfaturile, din nou la deschidere"
msgstr "Këshillat, përsëri gjatë hapjes"

msgid "Ștergi %d marcaj? Canalele rămân în buchet."
msgid_plural "Ștergi %d marcaje? Canalele rămân în buchete."
msgstr[0] "Fshi %d shënues? Kanalet mbeten në buqetë."
msgstr[1] "Fshi %d shënues? Kanalet mbeten në buqeta."

msgid "Ștergi %d flux din buchete?"
msgid_plural "Ștergi %d fluxuri din buchete?"
msgstr[0] "Fshi %d transmetim nga buqetat?"
msgstr[1] "Fshi %d transmetime nga buqetat?"

msgid "Ștergi %d buchet gol?"
msgid_plural "Ștergi %d buchete goale?"
msgstr[0] "Fshi %d buqetë bosh?"
msgstr[1] "Fshi %d buqeta bosh?"

msgid "Ștergi %d transponder fără canale?"
msgid_plural "Ștergi %d transpondere fără canale?"
msgstr[0] "Fshi %d transponder pa kanale?"
msgstr[1] "Fshi %d transponderë pa kanale?"

msgid "Ștergi %d siglă de pe disc? Se șterge acum, nu la salvare, și nu se poate anula."
msgid_plural "Ștergi %d sigle de pe disc? Se șterg acum, nu la salvare, și nu se pot anula."
msgstr[0] "Fshi %d logo nga disku? Fshihet tani, jo gjatë ruajtjes, dhe nuk mund të anulohet."
msgstr[1] "Fshi %d logo nga disku? Fshihen tani, jo gjatë ruajtjes, dhe nuk mund të anulohen."

#, python-format
msgid ""
"Găsite: %d. Ca beta tester (Setări > Beta tester), jurnalele noi pleacă singure, numai cu acordul tău. Altfel, un jurnal găsit aici se poate trimite prin formularul de contact de pe hdsatelit.com.\n"
"Se caută în „%s”, în /tmp și în orice alt folder montat sub /media, /run/media, /home/root."
msgstr ""
"Të gjetura: %d. Si beta testues (Cilësimet > Beta testues), regjistrat e rinj dërgohen vetë, vetëm me pëlqimin tënd. Përndryshe, një regjistër i gjetur këtu mund të dërgohet përmes formularit të kontaktit në hdsatelit.com.\n"
"U kërkua në “%s”, në /tmp dhe në çdo dosje tjetër të montuar nën /media, /run/media, /home/root."

msgid "Ca beta tester (în Setări, la Beta tester), jurnalele noi pleacă singure, numai cu acordul tău. Altfel, un jurnal găsit aici se poate trimite prin formularul de contact de pe hdsatelit.com. Se caută în <span id=\"principal\"></span>, în /tmp și în orice alt dosar montat sub /media, /run/media, /home/root."
msgstr "Si testues beta (në Cilësimet, te Testues beta), regjistrat e rinj dërgohen vetë, vetëm me pëlqimin tënd. Përndryshe, një regjistër i gjetur këtu mund të dërgohet përmes formularit të kontaktit në hdsatelit.com. Kërkimi mbulon <span id=\"principal\"></span>, /tmp dhe çdo dosje tjetër të montuar nën /media, /run/media, /home/root."

