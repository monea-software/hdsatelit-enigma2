msgid "Uniunea Europeană"
msgstr "Bashkimi Evropian"

#, python-format
msgid "Din locul antenei (%(loc)s), satelitul %(sat)s e sub orizont, deci motorul nu rotește antena spre el. Verifică Locul antenei: emisfera (Nord sau Sud) și partea față de Greenwich (Est sau Vest)."
msgstr "Nga vendndodhja e antenës (%(loc)s), sateliti %(sat)s është nën horizont, prandaj motori nuk e rrotullon antenën drejt tij. Kontrollo “Vendndodhja e antenës”: hemisferën (Veri ose Jug) dhe anën në raport me Greenwich (Lindje ose Perëndim)."

#, python-format
msgid "Locul scris (%(scris)s) e departe de %(tara)s. Probabil emisfera (Nord sau Sud) ori partea față de Greenwich (Est sau Vest) e aleasă greșit. Salvez %(propus)s?"
msgstr "Vendndodhja e shkruar (%(scris)s) është larg nga %(tara)s. Me gjasë hemisfera (Veri ose Jug) ose ana në raport me Greenwich (Lindje ose Perëndim) është zgjedhur gabim. Të ruaj %(propus)s?"

msgid "Modulul de acces a găsit cheia canalului, dar imaginea a rămas criptată în browser. Apasă \"Pornește din nou\"."
msgstr "Moduli i aksesit gjeti çelësin e kanalit, por figura mbeti e koduar në shfletues. Shtyp „Rinis”."

msgid "Față de ecuator"
msgstr "Në raport me ekuatorin"

