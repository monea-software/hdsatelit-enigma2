msgstr "Controle van het pakket"

#: lib/python/Screens/HdsSoftwareUpdate.py
msgid "Da, verifică pachetul"
msgstr "Ja, pakket controleren"

#: lib/python/Screens/HdsSoftwareUpdate.py
msgid "Scrierea este oprită"
msgstr "Het schrijven is gestopt"

#: lib/python/Screens/HdsSoftwareUpdate.py
