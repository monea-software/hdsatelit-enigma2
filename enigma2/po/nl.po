#: data/setup.xml lib/python/Components/Converter/HdsLang.py lib/python/Components/Converter/HdsLang_et.py lib/python/Components/Converter/HdsLang_tr.py lib/python/Screens/AudioSelection.py
msgid "DTS downmix"
msgstr "DTS-downmix"

#: data/setup.xml
msgid "Delay of the AC3 sound against the picture, on all channels. It is used from the next channel change."
msgstr "Vertraging van het AC3-geluid ten opzichte van het beeld, op alle zenders. Geldt vanaf de volgende zenderwissel."

#: data/setup.xml
msgid "Delay of the stereo sound against the picture, on all channels. It is used from the next channel change."
msgstr "Vertraging van het stereogeluid ten opzichte van het beeld, op alle zenders. Geldt vanaf de volgende zenderwissel."

#: data/setup.xml
msgid "Yes: on channels with several sound tracks the first track that is not MPEG starts (usually AC3 or DD+). No: the first track of the channel starts, or the one chosen last time."
msgstr "Ja: op zenders met meerdere geluidssporen start het eerste spoor dat geen MPEG is (meestal AC3 of DD+). Nee: het eerste spoor van de zender start, of het laatst gekozen spoor."

#: data/setup.xml
msgid "Yes: the receiver turns AC3 sound into stereo. No: AC3 sound goes unchanged to the TV or sound system (5.1 sound), which must know AC3, otherwise there is no sound."
msgstr "Ja: de ontvanger zet het AC3-geluid om naar stereo. Nee: het AC3-geluid gaat ongewijzigd naar de tv of de geluidsinstallatie (5.1-geluid), die AC3 moet kennen, anders is er geen geluid."

#: data/setup.xml
msgid "Yes: the receiver turns DTS sound into stereo. No: DTS sound goes unchanged to the TV or sound system; if it does not know DTS, there is no sound. Many TVs do not know DTS."
msgstr "Ja: de ontvanger zet het DTS-geluid om naar stereo. Nee: het DTS-geluid gaat ongewijzigd naar de tv of de geluidsinstallatie; kent die geen DTS, dan is er geen geluid. Veel tv's kennen geen DTS."

