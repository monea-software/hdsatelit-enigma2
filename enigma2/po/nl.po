msgstr "De code is nog %d:%02d geldig; daarna komt er een nieuwe."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Telefon conectat: %s. Continuă pe telefon."
msgstr "Telefoon verbonden: %s. Ga verder op de telefoon."

