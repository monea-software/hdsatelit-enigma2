#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Tradu EPG"
msgstr "EPG vertalen"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Ce s-a tradus din EPG"
msgstr "Wat er uit de EPG vertaald is"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "%d texte, %d semne"
msgstr "%d teksten, %d tekens"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Ghidul: texte traduse %d (%d semne trimise, din cota serviciului), cereri %d, deja în limba ta %d, sărite %d."
msgstr "EPG: vertaalde teksten %d (%d verzonden tekens, van het tegoed van de dienst), verzoeken %d, al in jouw taal %d, overgeslagen %d."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Traduceri ținute minte: %d (%s)."
msgstr "Onthouden vertalingen: %d (%s)."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "și pe stick sau disc"
msgstr "ook op de USB-stick of schijf"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "numai până la repornire; cu un stick sau un disc se păstrează"
msgstr "alleen tot de herstart; met een USB-stick of schijf blijven ze bewaard"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Traduce automat titlurile și descrierile emisiunilor care sunt pe ecran (bara de jos, a doua bară, ghidul, detaliile emisiunii) în limba traducerii, cu aceleași servicii și chei. Consumă din cota serviciului, de aceea din fabrică e oprită. Textul deja în limba ta nu se trimite, iar o traducere ținută minte nu se mai cere. În detaliile emisiunii, INFO arată textul original."
msgstr "Vertaalt automatisch de titels en beschrijvingen van de programma's op het scherm (onderste balk, tweede balk, gids, programmadetails) naar de vertaaltaal, met dezelfde diensten en sleutels. Het verbruikt tegoed van de dienst, daarom staat het standaard uit. Tekst die al in jouw taal is, wordt niet verzonden, en een onthouden vertaling wordt niet opnieuw gevraagd. In de programmadetails toont INFO de oorspronkelijke tekst."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cu „Tradu EPG” pornită pleacă la același serviciu și titlurile și descrierile emisiunilor de pe ecran."
msgstr "Met „EPG vertalen” aan gaan ook de titels en beschrijvingen van de programma's op het scherm naar dezelfde dienst."

#: lib/python/Screens/EventView.py lib/python/Screens/SecondInfoBar.py
msgid "Tradus automat. INFO: textul original."
msgstr "Automatisch vertaald. INFO: de oorspronkelijke tekst."

#: lib/python/Screens/EventView.py lib/python/Screens/SecondInfoBar.py
msgid "Textul original, netradus. INFO: închide."
msgstr "Oorspronkelijke tekst, niet vertaald. INFO: sluiten."

msgid "Tradu automat din orice subtitrare disponibilă"
msgstr "Automatisch vertalen vanuit elke beschikbare ondertitel"

msgid "Cu traducerea subtitrărilor pornită, „Tradu automat din orice subtitrare disponibilă” alege singură și o subtitrare în altă limbă, ca să fie tradusă."
msgstr "Met ondertitelvertaling aan kiest “Automatisch vertalen vanuit elke beschikbare ondertitel” zelf ook een ondertitel in een andere taal, zodat die vertaald wordt."

msgid "Traducerea subtitrărilor e pornită (în %s): dacă nu există subtitrare în limba aceasta, se alege singură una în altă limbă, întâi teletextul, apoi DVB citită ca text, și se traduce."
msgstr "Ondertitelvertaling staat aan (doeltaal: %s): als er geen ondertitel in deze taal is, wordt automatisch een ondertitel in een andere taal gekozen, eerst teletekst, dan DVB als tekst gelezen, en vertaald."

msgid "Traducerea subtitrărilor e pornită (în %s): se alege numai o subtitrare în limba aceasta, apoi preferințele de mai sus."
msgstr "Ondertitelvertaling staat aan (doeltaal: %s): alleen een ondertitel in deze taal wordt gekozen, daarna je voorkeuren hierboven."

msgid "în limba traducerii"
msgstr "in de vertaaltaal"

msgid "teletext tradus automat"
msgstr "teletekst, automatisch vertaald"

msgid "DVB citită ca text și tradusă automat"
msgstr "DVB als tekst gelezen en automatisch vertaald"

#: lib/python/Hds/DabT2/pornire.py
msgid "Canalul nu a pornit: tunerul e inca ocupat. Alege-l din nou."
msgstr "Zender niet gestart: tuner nog bezet. Kies hem opnieuw."

#: lib/python/Hds/DabT2/pornire.py
#, python-format
msgid "Pornesc din nou canalul de dinainte (%s)..."
msgstr "Vorige zender (%s) wordt opnieuw gestart..."

#: lib/python/Hds/DabT2/pornire.py
#, python-format
msgid "Canalul de dinainte (%s) a pornit din nou."
msgstr "De vorige zender (%s) speelt weer."

#: lib/python/Hds/DabT2/pornire.py
#, python-format
msgid "Canalul de dinainte (%s) a pornit, dar nu da imagine."
msgstr "De vorige zender (%s) is gestart, maar geeft geen beeld."

#: lib/python/Hds/DabT2/pornire.py
#, python-format
msgid "Canalul de dinainte (%s) nu a pornit: tunerul e inca ocupat. Alege-l din nou."
msgstr "De vorige zender (%s) is niet gestart: tuner nog bezet. Kies hem opnieuw."

#: lib/python/Hds/DabT2/pornire.py
msgid "Tunerul e ocupat (inregistrare sau alt canal). Alege mai tarziu."
msgstr "Tuner bezet (opname of andere zender). Kies later opnieuw."

#: lib/python/Hds/DabT2/pornire.py
#, python-format
msgid "Nu au venit date de la %s. Tunerul a fost eliberat."
msgstr "Er zijn geen gegevens binnengekomen van %s. De tuner is vrijgegeven."

#: lib/python/Hds/DabT2/scanare.py
msgid "Scanarea s-a oprit inainte de sfarsit si nu a salvat nimic. Incearca din nou."
msgstr "Het zoeken stopte voor het einde en heeft niets bewaard. Probeer het opnieuw."

#: lib/python/Hds/DabT2/scanare.py
#, python-format
msgid "Detectorul s-a oprit cu codul %s, fara un raspuns care sa se poata citi."
msgstr "De detector stopte met code %s zonder leesbaar antwoord."

#: lib/python/Hds/DabT2/scanare.py
msgid "Raspunsul detectorului nu s-a putut prelucra (detalii in jurnal)."
msgstr "Het antwoord van de detector kon niet worden verwerkt (details in het logboek)."

#: lib/python/Screens/ScanerSatelit.py
msgid "În lucru: scanarea salvează posturile DAB+ în lista de canale, dar ascultarea lor nu merge încă pe acest receptor."
msgstr "In ontwikkeling: het zoeken bewaart de DAB+-zenders in de zenderlijst, maar luisteren werkt op deze ontvanger nog niet."

#: lib/python/Screens/ScanerSatelit.py
msgid "Detectorul nu a dat niciun răspuns."
msgstr "De detector heeft niet geantwoord."

#: lib/python/Screens/ScanerSatelit.py
msgid "Ultimele rânduri de eroare ale detectorului:"
msgstr "Laatste foutregels van de detector:"

#: lib/python/Screens/ScanerSatelit.py
msgid "Începutul ieșirii care nu s-a putut citi:"
msgstr "Begin van de uitvoer die niet gelezen kon worden:"

#: lib/python/Screens/HdsScanareFluxuri.py
msgid "Ascultarea lor nu merge încă pe acest receptor (în lucru)."
msgstr "Luisteren werkt op deze ontvanger nog niet (in ontwikkeling)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Adresa %s e pe internet, iar receptorul trimite pe http:// (necriptat) numai în rețeaua de acasă. Scrie adresa cu https://."
msgstr "Het adres %s staat op internet, en de ontvanger stuurt via http:// (onversleuteld) alleen binnen het thuisnetwerk. Schrijf het adres met https://."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Adresa %s duce chiar la receptor. Receptorul nu are server de traducere: scrie adresa calculatorului din casă sau a serverului din internet (127.0.0.1, localhost, 0.0.0.0, 169.254.x și IP-ul receptorului nu merg)."
msgstr "Het adres %s leidt naar de ontvanger zelf. De ontvanger heeft geen vertaalserver: schrijf het adres van de computer thuis of van de server op internet (127.0.0.1, localhost, 0.0.0.0, 169.254.x en het IP van de ontvanger werken niet)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "adresa altui aparat, nu a receptorului (127.0.0.1, localhost, 0.0.0.0, 169.254.x și IP-ul receptorului nu merg)"
msgstr "het adres van een ander apparaat, niet van de ontvanger (127.0.0.1, localhost, 0.0.0.0, 169.254.x en het IP van de ontvanger werken niet)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheia pleacă numai spre adresa serverului de acum: scrie întâi adresa, apoi pune cheia."
msgstr "De sleutel gaat alleen naar het huidige serveradres: schrijf eerst het adres en voer daarna de sleutel in."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheia salvată a fost pusă pentru alt server (%s), deci nu pleacă spre adresa de acum. Dacă serverul cere cheie, pune-o din nou."
msgstr "De opgeslagen sleutel is ingevoerd voor een andere server (%s) en gaat dus niet naar het huidige adres. Als de server een sleutel vraagt, voer hem opnieuw in."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheia salvată nu e legată de adresa de acum, deci nu pleacă nicăieri. Dacă serverul cere cheie, pune-o din nou."
msgstr "De opgeslagen sleutel hoort niet bij het huidige adres en wordt dus nergens heen gestuurd. Als de server een sleutel vraagt, voer hem opnieuw in."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheia nu pleacă pe http:// spre internet. Scrie adresa cu https://."
msgstr "De sleutel wordt niet via http:// naar internet gestuurd. Schrijf het adres met https://."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Atenție: cheia pleacă necriptată (http://) spre serverul din casă. Pune o cheie numai dacă serverul o cere."
msgstr "Let op: de sleutel gaat onversleuteld (http://) naar de server thuis. Voer alleen een sleutel in als de server erom vraagt."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Scrie adresa calculatorului din casă (de exemplu http://192.168.1.50:11434) sau a serverului din internet, cu https://."
msgstr "Schrijf het adres van de computer thuis (bijvoorbeeld http://192.168.1.50:11434) of van de server op internet, met https://."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "O cheie pleacă numai pe https:// sau spre un server din rețeaua de acasă. Scrie adresa cu https://. Cheia nu a plecat nicăieri."
msgstr "Een sleutel gaat alleen via https:// of naar een server in het thuisnetwerk. Schrijf het adres met https://. De sleutel is nergens heen gestuurd."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "pusă pentru alt server (OK o pune din nou)"
msgstr "ingesteld voor een andere server (OK voert hem opnieuw in)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheile de traducere trebuie puse din nou: cele salvate înainte nu se mai pot citi pe acest receptor."
msgstr "De vertaalsleutels moeten opnieuw worden ingevoerd: de eerder opgeslagen sleutels kan deze ontvanger niet meer lezen."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheile de traducere trebuie puse din nou: cele salvate înainte nu se mai pot citi pe acest receptor. Le pui în Meniu › Setări › Sunet și subtitrări › Traducerea subtitrărilor sau de pe telefon, cu codul QR de acolo."
msgstr "De vertaalsleutels moeten opnieuw worden ingevoerd: de eerder opgeslagen sleutels kan deze ontvanger niet meer lezen. Je voert ze in via Menu › Instellingen › Audio & geluidssporen › Ondertitelvertaling of vanaf je telefoon, met de QR-code daar."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "trebuie pusă din nou (OK o scrie)"
msgstr "moet opnieuw worden ingevoerd (OK om in te vullen)"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Tradu bara de jos"
msgstr "Onderste balk vertalen"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Traduce titlurile emisiunii de acum și ale celei următoare de pe bara de jos, cu aceleași servicii și chei. Merge când traducerea subtitrărilor e pornită și folosește foarte puțin din cotă: fiecare titlu se cere o singură dată. INFO de pe bară arată textul original. Cu „Tradu EPG” pornită, bara se traduce oricum."
msgstr "Vertaalt de titels van het huidige en het volgende programma op de onderste balk, met dezelfde diensten en sleutels. Werkt als ondertitelvertaling aan staat en verbruikt heel weinig tegoed: elke titel wordt maar één keer gevraagd. INFO op de balk toont de oorspronkelijke tekst. Met „EPG vertalen” aan wordt de balk hoe dan ook vertaald."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cu „Tradu bara de jos” pornită pleacă la același serviciu și titlurile emisiunilor de pe bara de jos."
msgstr "Met „Onderste balk vertalen” aan gaan ook de titels van de programma's op de onderste balk naar dezelfde dienst."

#: lib/python/Screens/EventView.py
msgid "Textul original. Pe bara de jos, titlul e tradus automat."
msgstr "Oorspronkelijke tekst. Op de onderste balk is de titel automatisch vertaald."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Ai schimbat setările traducerii. Le salvezi?"
msgstr "Je hebt de vertaalinstellingen gewijzigd. Opslaan?"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK probează"
msgstr "OK test"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK le deschide"
msgstr "OK opent ze"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK trimite o frază de probă serviciului ales. Răspunsul apare aici, iar originalul și traducerea se văd jos, ca subtitrările."
msgstr "OK stuurt een testzin naar de gekozen dienst. Het antwoord verschijnt hier, het origineel en de vertaling zie je onderaan, zoals ondertitels."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK deschide pașii pentru serviciul ales: contul, cheia gratuită, cota și ce se întâmplă la depășire."
msgstr "OK opent de stappen voor de gekozen dienst: het account, de gratis sleutel, het quotum en wat er gebeurt als je erover gaat."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "lipsește (OK îl scrie)"
msgstr "ontbreekt (OK om in te vullen)"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "fără cheie"
msgstr "zonder sleutel"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "fără adresă"
msgstr "zonder adres"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "fără model"
msgstr "zonder model"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "de completat"
msgstr "nog in te vullen"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Dacă foloseai o cheie pentru acest server, pune-o din nou."
msgstr "Als je een sleutel voor deze server gebruikte, voer hem opnieuw in."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheie pusă"
msgstr "Sleutel ingesteld"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Fără cheie"
msgstr "Geen sleutel"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheie pusă pentru alt server (%s): nu pleacă spre adresa de acum. Pune-o din nou."
msgstr "Sleutel ingesteld voor een andere server (%s): hij gaat niet naar het huidige adres. Voer hem opnieuw in."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheie pusă, dar nelegată de adresa de acum: nu pleacă nicăieri. Pune-o din nou."
msgstr "Sleutel ingesteld, maar niet gekoppeld aan het huidige adres: hij gaat nergens heen. Voer hem opnieuw in."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cheie pusă, dar nu pleacă pe http:// spre internet. Scrie adresa cu https://."
msgstr "Sleutel ingesteld, maar hij wordt niet via http:// naar internet gestuurd. Schrijf het adres met https://."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "se traduce prin „Tradu EPG”"
msgstr "wordt vertaald via „EPG vertalen”"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "pornită, dar traducerea automată e oprită"
msgstr "aan, maar de automatische vertaling staat uit"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "pornită, dar serviciul nu e completat"
msgstr "aan, maar de dienst is niet ingevuld"

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Valoare greșită pentru: %s."
msgstr "Verkeerde waarde voor: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Nu s-a trimis nicio alegere."
msgstr "Er is geen keuze verstuurd."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Adresa începe cu http:// sau https://, fără nume și parolă în ea."
msgstr "Het adres begint met http:// of https://, zonder naam en wachtwoord erin."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Nu s-a schimbat nimic."
msgstr "Er is niets gewijzigd."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Lista rezervelor are un serviciu necunoscut."
msgstr "De lijst met reserves bevat een onbekende dienst."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Un serviciu apare de două ori în lista rezervelor."
msgstr "Een dienst staat twee keer in de lijst met reserves."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Serviciul ales nu intră și în lista rezervelor."
msgstr "De gekozen dienst hoort niet ook in de lijst met reserves."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Adresa-șablon începe cu https:// (sau http:// pentru un server din rețeaua de acasă), fără spații, fără nume și parolă și fără locuri în numele serverului."
msgstr "Het sjabloonadres begint met https:// (of http:// voor een server in het thuisnetwerk), zonder spaties, zonder naam en wachtwoord en zonder plaatsaanduidingen in de servernaam."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "O adresă http:// merge numai pentru un server din rețeaua de acasă (de exemplu 192.168.1.50); pentru un server de pe internet scrie https://."
msgstr "Een http://-adres werkt alleen voor een server in het thuisnetwerk (bijvoorbeeld 192.168.1.50); voor een server op internet schrijf je https://."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Numele antetului are numai litere, cifre și - _ . (de exemplu Authorization); Host, Content-Type și Content-Length nu se pot alege."
msgstr "De naam van de header heeft alleen letters, cijfers en - _ . (bijvoorbeeld Authorization); Host, Content-Type en Content-Length kun je niet kiezen."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
msgid "Calea are chei și numere despărțite prin punct, fără spații (de exemplu data.translations.0.translatedText)."
msgstr "Het pad heeft sleutels en getallen gescheiden door punten, zonder spaties (bijvoorbeeld data.translations.0.translatedText)."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_subtitrari_web.py
