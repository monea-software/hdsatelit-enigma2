#: data/setup.xml
msgid "Volum și întârziere"
msgstr "Volume en vertraging"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Pasul volumului"
msgstr "Volumestap"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Cât crește sau scade volumul la o apăsare pe tastele de volum (volumul merge de la 0 la 100)."
msgstr "Hoeveel het volume stijgt of daalt bij één druk op de volumetoetsen (het volume loopt van 0 tot 100)."

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Volumul ținut minte pe canal"
msgstr "Volume per zender onthouden"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Da: fiecare canal pornește cu volumul la care l-ai lăsat. Un canal la care nu ai schimbat volumul îl păstrează pe cel de acum."
msgstr "Ja: elke zender start met het volume waarop je hem hebt achtergelaten. Een zender waarvan je het volume niet hebt veranderd, houdt het huidige."

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Volum egal între canale"
msgstr "Gelijk volume tussen zenders"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Placa de sunet apropie singură volumul: canalele și reclamele tari se aud mai încet, cele încete mai tare. Puternic micșorează și diferența dintre tare și încet (bun noaptea). Nu lucrează când sunetul pleacă neschimbat spre televizor."
msgstr "De geluidschip maakt het volume zelf gelijk: luide zenders en reclames klinken zachter, zachte luider. Sterk verkleint ook het verschil tussen luid en zacht (goed voor 's nachts). Werkt niet als het geluid ongewijzigd naar de tv gaat."

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Întârzierea sunetului pe HDMI"
msgstr "Geluidsvertraging op HDMI"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Când buzele se mișcă după sunet, întârzie sunetul spre televizor. Sunetul se poate numai întârzia, nu grăbi."
msgstr "Als de lippen na het geluid bewegen, vertraag dan het geluid naar de tv. Het geluid kan alleen vertraagd worden, niet vervroegd."

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Întârzierea sunetului pe optic"
msgstr "Geluidsvertraging op de optische uitgang"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "La fel, pentru bara de sunet sau amplificatorul legat la ieșirea optică a receptorului."
msgstr "Hetzelfde, voor de soundbar of versterker op de optische uitgang van de ontvanger."

#: lib/python/Components/HdsSetariSunet.py
msgid "Ușor"
msgstr "Licht"

#: lib/python/Components/HdsSetariSunet.py
msgid "Puternic"
msgstr "Sterk"

#: lib/python/Components/HdsSetariSunet.py
msgid "Întârzierea pistei pe acest canal"
msgstr "Vertraging van het spoor op deze zender"

#: lib/python/Components/HdsSetariSunet.py
msgid "Se adună la întârzierea ieșirii, numai pentru pista de sunet de acum a canalului de acum. Se ține minte."
msgstr "Wordt opgeteld bij de vertraging van de uitgang, alleen voor het huidige geluidsspoor van de huidige zender. Wordt onthouden."

#: lib/python/Plugins/Extensions/HdsWebControl/setari_sunet_web.py
msgid "Setările sunetului nu sunt încă gata. Încearcă din nou peste câteva secunde."
msgstr "De geluidsinstellingen zijn nog niet klaar. Probeer het over een paar seconden opnieuw."

#: lib/python/Plugins/Extensions/HdsWebControl/setari_sunet_web.py
msgid "Nu merge acum un canal cu o pistă de sunet."
msgstr "Er speelt nu geen zender met een geluidsspoor."

#: lib/python/Components/HdsEgalizator.py
msgid "La canalele TV egalizatorul e oprit din setări. Sunetul merge prin placa de sunet."
