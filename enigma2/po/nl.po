msgstr "Het pakket kon niet van de USB-stick worden gelezen (%s)."

#: lib/python/Screens/HdsSoftwareUpdate.py
msgid "Se face simularea scrierii (ofgwrite -n): nu se scrie nimic…"
msgstr "Het schrijven wordt gesimuleerd (ofgwrite -n): er wordt niets geschreven…"

