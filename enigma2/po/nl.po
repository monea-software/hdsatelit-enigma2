msgstr "Nieuwe sleutel typen"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Șterge cheia"
msgstr "Sleutel wissen"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Se probează traducerea cu %s..."
msgstr "Vertaling wordt getest met %s..."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Proba a mers (%s, %s): %s"
msgstr "De test is gelukt (%s, %s): %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Proba nu a mers: %s"
msgstr "De test is mislukt: %s"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Atenție: la Google Cloud facturarea e obligatorie, Google îți cere cardul la înscriere. Peste cota gratuită plătești automat, din card."
msgstr "Let op: bij Google Cloud is facturering verplicht, Google vraagt bij de aanmelding je kaart. Boven het gratis quotum betaal je automatisch, van de kaart."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Sub original, traducerea se scrie cu galben deschis, ca s-o deosebești de original."
msgstr "Onder het origineel wordt de vertaling lichtgeel geschreven, zodat je haar van het origineel onderscheidt."

#: lib/python/Screens/HdsSubtitrariAspect.py
msgid "Recunoașterea textului lucrează și acum: o cere traducerea subtitrărilor."
msgstr "Tekstherkenning werkt nu ook: de ondertitelvertaling heeft haar nodig."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Se probează pe receptor: %s"
msgstr "Test op de ontvanger: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Gata: %s merge. Proba: %s"
msgstr "Klaar: %s werkt. Test: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Serverul e prea lent pentru subtitrări la timp. Alege un serviciu din "
"internet (Gemini, gratuit, fără card) sau un model mai mic."
msgstr "De server is te traag voor ondertitels op tijd. Kies een dienst op internet (Gemini, gratis, zonder kaart) of een kleiner model."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Nu a mers: %s"
msgstr "Niet gelukt: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Scanează cu telefonul: pagina oficială"
msgstr "Scan met je telefoon: de officiële pagina"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Configurează de pe telefon"
msgstr "Instellen vanaf je telefoon"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Scanează codul cu camera telefonului. Se deschide pagina receptorului, deja "
"conectată: alegi serviciul, îți faci cheia și o lipești. Receptorul o "
"probează pe loc."
msgstr "Scan de code met de camera van je telefoon. De pagina van de ontvanger opent, al verbonden: je kiest de dienst, maakt je sleutel en plakt hem. De ontvanger test hem meteen."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK sau Ieșire închide."
msgstr "OK of EXIT sluit."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Receptorul nu are legătură în rețea, deci pagina nu se poate deschide pe "
"telefon."
msgstr "De ontvanger heeft geen netwerkverbinding, dus de pagina kan niet op de telefoon worden geopend."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
