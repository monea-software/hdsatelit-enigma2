msgid "nimic încă"
msgstr "nog niets"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "%d pagini, %d din memorie"
msgstr "%d pagina's, %d uit het geheugen"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Pagini: %d. Din memorie: %d. Traduse după afișare: %d. Sărite: %d. Cereri: "
"%d."
msgstr "Pagina's: %d. Uit het geheugen: %d. Vertaald na weergave: %d. Overgeslagen: %d. Verzoeken: %d."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Timp mediu: %s."
msgstr "Gemiddelde tijd: %s."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Erori: %d."
msgstr "Fouten: %d."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Ultima eroare (%s): %s"
msgstr "Laatste fout (%s): %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"OK: scrii o cheie nouă sau o ștergi. Cheia se păstrează pe receptor, "
"criptată, și nu se mai arată niciodată. Albastru: cum îți faci cheia "
"gratuită."
msgstr "OK: je typt een nieuwe sleutel of wist hem. De sleutel wordt versleuteld op de ontvanger bewaard en nooit meer getoond. Blauw: zo maak je je gratis sleutel."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK deschide tastatura."
msgstr "OK opent het toetsenbord."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "De exemplu http://192.168.1.50:5000"
msgstr "Bijvoorbeeld http://192.168.1.50:5000"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"De exemplu http://192.168.1.50:11434 (Ollama) sau http://192.168.1.50:1234 "
"(LM Studio)."
msgstr "Bijvoorbeeld http://192.168.1.50:11434 (Ollama) of http://192.168.1.50:1234 (LM Studio)."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "De exemplu westeurope. Gol pentru o resursă Global."
msgstr "Bijvoorbeeld westeurope. Leeg voor een resource met Global."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "De exemplu gemma3:4b"
msgstr "Bijvoorbeeld gemma3:4b"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Subtitrările DVB sunt imagini: textul lor se citește întâi cu recunoașterea "
"textului (OCR), apoi se traduce."
msgstr "DVB-ondertitels zijn beelden: hun tekst wordt eerst gelezen met tekstherkenning (OCR) en daarna vertaald."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Când traducerea nu e gata la timp, se vede originalul. „Se pune când vine”: "
"traducerea îi ia locul cât rândul e pe ecran. „Rămâne originalul”: rândul "
"rămâne netradus."
msgstr "Als de vertaling niet op tijd klaar is, zie je het origineel. “Tonen zodra ze er is”: de vertaling neemt de plaats ervan in zolang de regel op het scherm staat. “Het origineel blijft”: de regel blijft onvertaald."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Implicit limba meniului. O subtitrare care e deja în limba aleasă nu se "
"trimite."
msgstr "Standaard de menutaal. Een ondertitel die al in de gekozen taal is, wordt niet verstuurd."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Traducerea apare în locul originalului sau sub el, cu aspectul din «Aspectul "
"subtitrărilor»."
msgstr "De vertaling verschijnt in plaats van het origineel of eronder, met de weergave uit “Weergave van ondertitels”."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Traducere automată pentru teletext, subtitrările din fișiere și subtitrările "
"DVB."
msgstr "Automatische vertaling voor teletekst, ondertitels uit bestanden en DVB-ondertitels."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Cheia API pentru %s"
msgstr "API-sleutel voor %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
