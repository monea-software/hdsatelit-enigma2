msgid "Nu merge niciun post acum, deci reglajele se păstrează pentru toate posturile."
msgstr "Er speelt nu geen zender, dus de instellingen gelden voor alle zenders."

#: lib/python/Screens/HdsEgalizator.py
msgid "Nivel: potrivești tăria sunetului cu egalizator față de sunetul obișnuit, între −12 și +12 dB."
msgstr "Niveau: stem de luidheid met equalizer af op het gewone geluid, van −12 tot +12 dB."

#: lib/python/Screens/HdsEgalizator.py
#, python-format
msgid "%s, %s. Sus și jos: cu 1 dB mai mult sau mai puțin, între −12 și +12 dB."
msgstr "%s, %s. Omhoog en omlaag: 1 dB meer of minder, van −12 tot +12 dB."

#: lib/python/Screens/HdsEgalizator.py
msgid "acest post"
msgstr "deze zender"

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Păstrat. Se aude și pe televizor."
msgstr "Bewaard. Het is ook op de televisie te horen."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Volumul se alege cu auto, aici sau placa."
msgstr "Het volume kies je met auto, aici of placa."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Numele plăcii de sunet are numai litere, cifre și : , _ - ."
msgstr "De naam van het geluidsapparaat bevat alleen letters, cijfers en : , _ - ."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Am pus înapoi reglajele păstrate."
msgstr "De bewaarde instellingen zijn terug."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Se aude acum. Apasă „Păstrează” ca să rămână."
msgstr "Nu te horen. Druk op „Bewaren” om het te behouden."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Presetarea „%s” nu există."
msgstr "De voorinstelling „%s” bestaat niet."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Benzile se dau ca %d numere între %d și %d, cu virgulă între ele."
msgstr "De banden worden opgegeven als %d getallen tussen %d en %d, gescheiden door komma's."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Nivelul se dă ca număr între %d și %d."
msgstr "Het niveau wordt opgegeven als een getal tussen %d en %d."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "„%s” se alege cu 1 (da) sau 0 (nu)."
msgstr "„%s” kies je met 1 (ja) of 0 (nee)."

#: lib/python/Components/HdsEgalizator.py
msgid "Pauză. Sunetul revine cu egalizator când pornești din nou."
msgstr "Pauze. Het geluid komt terug met de equalizer als je het afspelen hervat."

#: lib/python/Components/HdsEgalizator.py
msgid "La canalele TV egalizatorul nu merge încă: sunetul trebuie să rămână potrivit cu ce vezi pe ecran, deci merge prin placa de sunet. Egalizatorul lucrează la posturile de radio."
msgstr "Bij tv-zenders werkt de equalizer nog niet: het geluid moet passen bij wat je op het scherm ziet en gaat daarom via de geluidschip. De equalizer werkt bij radiozenders."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul nu poate porni: receptorul nu are decodorul MPEG audio."
msgstr "De equalizer kan niet starten: de ontvanger heeft geen MPEG-audiodecoder."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul nu poate porni: lipsește decodarea sunetului în procesor (GStreamer)."
msgstr "De equalizer kan niet starten: het decoderen van geluid in de processor ontbreekt (GStreamer)."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul lipsește din programul acestui receptor. Setările se păstrează, dar nu se aud."
msgstr "De equalizer ontbreekt in de software van deze ontvanger. De instellingen blijven bewaard, maar zijn niet te horen."

#: lib/python/Components/HdsEgalizator.py
msgid "ieșirea plăcii de sunet pentru procesor e oprită"
msgstr "de uitgang van de geluidschip voor de processor staat uit"

#: lib/python/Components/HdsEgalizator.py
msgid "receptorul nu are decodor AAC"
msgstr "de ontvanger heeft geen AAC-decoder"

#: lib/python/Components/HdsEgalizator.py
msgid "receptorul nu are decodorul MPEG audio"
msgstr "de ontvanger heeft geen MPEG-audiodecoder"

#: lib/python/Components/HdsEgalizator.py
msgid "lipsește decodarea sunetului în procesor"
msgstr "het decoderen van geluid in de processor ontbreekt"

#: lib/python/Components/HdsEgalizator.py
msgid "placa de sunet nu se poate folosi din procesor"
msgstr "de geluidschip is vanuit de processor niet te gebruiken"

#: lib/python/Components/HdsEgalizator.py
msgid "felul acesta de AAC nu se poate decoda încă"
msgstr "dit soort AAC kan nog niet gedecodeerd worden"

#: lib/python/Components/HdsEgalizator.py
msgid "fișierul probei nu există"
msgstr "het testbestand bestaat niet"

#: lib/python/Components/HdsEgalizator.py
msgid "fișierul probei nu s-a putut scrie"
msgstr "het testbestand kon niet worden geschreven"

#: lib/python/Components/HdsEgalizator.py
msgid "o eroare neașteptată"
msgstr "een onverwachte fout"

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Probă din fișier, cu egalizator: %s. Proba merge și cu egalizatorul oprit."
msgstr "Test uit bestand, met equalizer: %s. De test werkt ook als de equalizer uit staat."

#: lib/python/Components/HdsEgalizator.py
msgid "decodat în procesor"
msgstr "gedecodeerd in de processor"

#: lib/python/Screens/HdsEgalizator.py
msgid "Păstrezi schimbările?"
msgstr "Wijzigingen bewaren?"

#: lib/python/Screens/HdsEgalizator.py
msgid "Pornit, sunetul posturilor de radio trece prin procesor și se aude cu reglajele de mai jos."
msgstr "Aan: het geluid van radiozenders gaat via de processor en klinkt met de instellingen hieronder."

#: lib/python/Screens/HdsEgalizator.py
msgid "Presetarea pune singură toate benzile; apoi le poți potrivi una câte una. Barele din spate: cât de tare se aude acum fiecare bandă."
msgstr "De voorinstelling zet alle banden zelf; daarna kun je ze één voor één aanpassen. De balken erachter: hoe luid elke band nu klinkt."

#: lib/python/Screens/HdsEgalizator.py
msgid "Modul de noapte: sunetele tari devin mai încete, cele încete mai tari. Potrivit seara, când asculți încet."
msgstr "Nachtmodus: harde geluiden worden zachter, zachte harder. Handig 's avonds, als je zacht luistert."

#: lib/python/Screens/HdsEgalizator.py
#, python-format
msgid "Da: reglajele de aici se țin minte numai pentru %s. Nu: postul folosește reglajele obișnuite, ale tuturor posturilor, pe care le vezi aici."
msgstr "Ja: de instellingen hier gelden alleen voor %s. Nee: de zender gebruikt de gewone instellingen van alle zenders, die je hier ziet."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. OK: pornești sau oprești. EXIT: ieși."
msgstr "Links en rechts: kiezen. OK: aan of uit. EXIT: verlaten."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. Sus, jos sau OK: presetarea următoare. EXIT: ieși."
msgstr "Links en rechts: kiezen. Omhoog, omlaag of OK: volgende voorinstelling. EXIT: verlaten."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. OK: da sau nu. EXIT: ieși."
msgstr "Links en rechts: kiezen. OK: ja of nee. EXIT: verlaten."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. Sus și jos: schimbi. OK: păstrezi și închizi."
msgstr "Links en rechts: kiezen. Omhoog en omlaag: wijzigen. OK: bewaren en sluiten."

#: lib/python/Components/HdsEgalizator.py
msgid "La acest post (AAC) egalizatorul nu e disponibil din motive de licențiere a brevetelor AAC."
msgstr "Bij deze zender (AAC) is de equalizer niet beschikbaar vanwege de licenties op AAC-patenten."

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Postul acesta are sunet %s. Egalizatorul lucrează la posturile cu sunet MPEG (MP2)."
msgstr "Deze zender heeft %s-geluid. De equalizer werkt bij zenders met MPEG-geluid (MP2)."

