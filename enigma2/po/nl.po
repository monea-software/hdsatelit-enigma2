msgstr "Reservediensten"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Caută în rețeaua de acasă"
msgstr "Zoek in het thuisnetwerk"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Valoarea antetului (cheia)"
msgstr "Waarde van de header (de sleutel)"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Adresa (șablon)"
msgstr "Adres (sjabloon)"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Metoda"
msgstr "Methode"

#: lib/python/Screens/HdsTraducereSubtitrari.py
