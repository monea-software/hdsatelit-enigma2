msgstr "Vertaling die te laat komt"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Și subtitrările DVB (imagini)"
msgstr "Ook DVB-ondertitels (beelden)"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Ce s-a tradus"
msgstr "Wat is vertaald"

#: lib/python/Screens/HdsTraducereSubtitrari.py
