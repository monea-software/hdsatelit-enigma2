#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/accel</code>: accelerarea 2D pe placa video: dacă receptorul o are (<code>disponibila</code>), setarea pentru următoarea pornire (implicit pornită) și ce s-a hotărât la pornirea de acum"
msgstr "<code>GET /api/accel</code>: 2D-versnelling op de videokaart: of de ontvanger die heeft (<code>disponibila</code>), de instelling voor de volgende start (standaard aan) en wat bij de huidige start is besloten"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-canal</code>: accesul canalului care rulează (criptat sau liber), sistemele, CAID-urile și ce decriptează modulul acum"
msgstr "<code>GET /api/acces-canal</code>: de toegang van de zender die nu speelt (gecodeerd of vrij), de systemen, de CAID's en wat de module nu decodeert"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-conditionat</code>: modulele de acces condiționat pe feluri (câmpul <code>fel</code>: numele felului, așa cum îl are receptorul; întâi modulele obișnuite, apoi serverele de carduri), cel ales la pornirea receptorului, cele care rulează, procesul care lucrează și memoria lui, comanda în curs sau ultimul rezultat, dacă receptorul decriptează acum"
msgstr "<code>GET /api/acces-conditionat</code>: de modules voor voorwaardelijke toegang per soort (veld <code>fel</code>: naam van de soort, zoals de ontvanger die heeft; eerst de gewone modules, daarna de kaartservers), de module gekozen bij het opstarten van de ontvanger, de modules die draaien, het proces dat werkt en zijn geheugen, de lopende opdracht of het laatste resultaat, of de ontvanger nu decodeert"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-ssh</code>: intrarea pe receptor prin SSH: felul parolei de administrator (fără parola însăși), cheile SSH (tipul, amprenta, comentariul), „Fără parolă în rețeaua locală”, stările periculoase (<code>alarme</code>), lucrarea în curs și rezultatul ultimei comenzi"
msgstr "<code>GET /api/acces-ssh</code>: toegang tot de ontvanger via SSH: het soort beheerderswachtwoord (zonder het wachtwoord zelf), de SSH-sleutels (type, vingerafdruk, commentaar), “Geen wachtwoord in het lokale netwerk”, de gevaarlijke toestanden (<code>alarme</code>), de lopende taak en het resultaat van de laatste opdracht"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, <code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, <code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/actualizari-reporneste</code>: actualizările prin pachete de pe stb.hdsatelit.com (starea, căutarea, instalarea, verificarea zilnică, repornirea interfeței după instalare)"
msgstr "<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, <code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, <code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/actualizari-reporneste</code>: de updates via pakketten van stb.hdsatelit.com (status, zoeken, installeren, dagelijkse controle, herstarten van de interface na installatie)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;orase=1]</code>: afișajul din față: ce arată acum (măștile celor 4 cifre și textul), lista de rotire, mesajele scurte, așteptarea, setările, minutarul și cronometrul; cu <code>grupa</code> alegerile grupei cu desenul valorii de acum, cu <code>catalog=1</code> toate alegerile (căutarea), cu <code>orase=1</code> fusurile pentru ora din alt oraș"
msgstr "<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;orase=1]</code>: het display aan de voorkant: wat het nu toont (de maskers van de 4 cijfers en de tekst), de rotatielijst, de korte berichten, de wachtstand, de instellingen, de timer en de stopwatch; met <code>grupa</code> de keuzes van de groep met de tekening van de huidige waarde, met <code>catalog=1</code> alle keuzes (het zoeken), met <code>orase=1</code> de tijdzones voor de tijd in een andere stad"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: tunerele, LNB-ul, semnalul canalului curent și unghiurile antenei spre fiecare satelit (numai citire)"
msgstr "<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: de tuners, de LNB, het signaal van de huidige zender en de hoeken van de schotel naar elke satelliet (alleen lezen)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/calitate-imagine</code>: calitatea imaginii: „Reglajele după canal”, profilul canalului de acum, cele 9 profiluri (SD, HD, 4K x SDR, HDR10, HLG) cu reglajele lor, ieșirea HDR (alegerile primite de televizor, ce e scris acum, întrebarea în curs) și textul brut al blocului de calitate"
msgstr "<code>GET /api/calitate-imagine</code>: beeldkwaliteit: “Instellingen per zender”, het profiel van de huidige zender, de 9 profielen (SD, HD, 4K x SDR, HDR10, HLG) met hun instellingen, de HDR-uitgang (de keuzes die de tv ontvangt, wat nu geschreven is, de lopende vraag) en de ruwe tekst van het kwaliteitsblok"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-acum</code>: canalul de pe televizor"
msgstr "<code>GET /api/canale-acum</code>: de zender op de tv"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-buchete?fila=tv|radio</code>: listele de ales și lista pe care stă televizorul"
msgstr "<code>GET /api/canale-buchete?fila=tv|radio</code>: de lijsten om uit te kiezen en de lijst waarop de tv staat"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-epg?refs=r1,r2</code>: emisiunea de acum și cea următoare, cel mult 50 de canale"
msgstr "<code>GET /api/canale-epg?refs=r1,r2</code>: het huidige en het volgende programma, maximaal 50 zenders"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,v2&amp;de_la=&amp;cate=</code>: rândurile, pe pagini de cel mult 200, cu grupele de filtre și numerele lor"
msgstr "<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,v2&amp;de_la=&amp;cate=</code>: de rijen, in pagina's van maximaal 200, met de filtergroepen en hun aantallen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: sigla canalului; la listele de canale, 503 când receptorul are prea multe cereri în lucru și 504 când nu termină în 10 s"
msgstr "<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: het logo van de zender; bij de zenderlijsten 503 wanneer de ontvanger te veel verzoeken in behandeling heeft en 504 wanneer hij niet binnen 10 s klaar is"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Caută setări”: meniurile și setările care au textul în nume (fără diacritice), cu drumul din meniu, valoarea de acum și pagina web"
msgstr "<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: “Instellingen zoeken”: de menu's en instellingen met de tekst in de naam (zonder diakritische tekens), met het menupad, de huidige waarde en de webpagina"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cautare-actualizeaza-stare</code>: cât a citit (transponderul, canalele) sau rezultatul"
msgstr "<code>GET /api/cautare-actualizeaza-stare</code>: hoeveel er is gelezen (de transponder, de zenders) of het resultaat"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code>: căutarea de canale, cu aceleași rânduri de filtre ca pe televizor și pistele știute ale fiecărui canal"
msgstr "<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code>: het zoeken naar zenders, met dezelfde filterrijen als op de tv en de bekende sporen van elke zender"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ceas</code>: ora receptorului, fusul orar, sursa orei (<code>auto</code>: Internet, apoi transponder; <code>ntp</code>; <code>dvb</code>), serverul NTP, alegerile lor și ultima sincronizare"
msgstr "<code>GET /api/ceas</code>: de tijd van de ontvanger, de tijdzone, de tijdbron (<code>auto</code>: internet, daarna transponder; <code>ntp</code>; <code>dvb</code>), de NTP-server, hun keuzes en de laatste synchronisatie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/copie-setari[?cauta=1]</code>: copia setărilor: stickurile și discurile (<code>implicit</code> = stickul de actualizare), copiile găsite (data, versiunea imaginii, acest receptor sau altul), copia automată, ultimul rezultat; niciodată conținutul copiei"
msgstr "<code>GET /api/copie-setari[?cauta=1]</code>: kopie van de instellingen: de sticks en schijven (<code>implicit</code> = de updatestick), de gevonden kopieën (datum, versie van het image, deze ontvanger of een andere), de automatische kopie, het laatste resultaat; nooit de inhoud van de kopie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/dabt2?fel=dab|t2</code>: fereastra „Fluxuri și setări” a DAB+ / DVB-T2 din satelit: fluxurile cu poziția, numele, numărul de posturi și starea, setările, Despre, lucrul în curs și <code>repunere</code> (canalul de dinainte, pornit din nou după „Învață posturile”: starea și mesajul)"
msgstr "<code>GET /api/dabt2?fel=dab|t2</code>: het venster “Streams en instellingen” van DAB+ / DVB-T2 via satelliet: de streams met positie, naam, aantal zenders en status, de instellingen, Over, het lopende werk en <code>repunere</code> (de vorige zender, opnieuw gestart na “Zenders leren”: de status en het bericht)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/descarcare-subtitrari</code> și <code>POST /api/descarcare-subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, <code>-verifica</code>, <code>-conturi</code>: descărcarea subtitrărilor (numele, parolele și cheile numai în corpul cererii); pe un canal TV sau la o înregistrare și <code>-film</code> (<code>fapta=identifica|alege|titlu|local</code>: filmul din ghid, identificat în Wikidata) și <code>-potrivire</code> (<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|opreste</code>: potrivirea subtitrării pe canal)"
msgstr "<code>GET /api/descarcare-subtitrari</code> en <code>POST /api/descarcare-subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, <code>-verifica</code>, <code>-conturi</code>: ondertitels downloaden (namen, wachtwoorden en sleutels alleen in de body van het verzoek); op een tv-zender of bij een opname en <code>-film</code> (<code>fapta=identifica|alege|titlu|local</code>: de film uit de gids, geïdentificeerd in Wikidata) en <code>-potrivire</code> (<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|opreste</code>: de ondertitel afstemmen op de zender)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: mesajul de pe ecranul negru (de ce nu se vede imaginea) și analiza fluxului canalului"
msgstr "<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: het bericht op het zwarte scherm (waarom er geen beeld is) en de stroomanalyse van de zender"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/egalizator</code>: egalizatorul posturilor de radio: pornit sau oprit, benzile, presetarea, modul de noapte, reglajele postului de acum și dacă merge la acest post; <code>POST /api/egalizator-seteaza</code>: schimbă și aplică pe loc"
msgstr "<code>GET /api/egalizator</code>: de equalizer van de radiozenders: aan of uit, de banden, de voorinstelling, de nachtmodus, de instellingen van de huidige zender en of hij bij deze zender werkt; <code>POST /api/egalizator-seteaza</code>: wijzigt en past direct toe"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/filme</code>: filmul care merge (poziția, lungimea, starea, locul ținut minte, mesajul de refuz) și setările filmelor; <code>GET /api/filme-lista</code>: filmele din dosarul listei de filme, cu locul rămas"
msgstr "<code>GET /api/filme</code>: de film die speelt (positie, lengte, status, onthouden plek, weigeringsbericht) en de filminstellingen; <code>GET /api/filme-lista</code>: de films uit de map van de filmlijst, met de plek waar ze gebleven zijn"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: familiile libere de pe Google Fonts și fonturile deja descărcate"
msgstr "<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: de vrije families van Google Fonts en de al gedownloade lettertypen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal-stare</code>: nivelul, calitatea, BER-ul și verdictul măsurării"
msgstr "<code>GET /api/gasire-semnal-stare</code>: het niveau, de kwaliteit, de BER en het oordeel van de meting"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: transponderele unui satelit"
msgstr "<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: de transponders van een satelliet"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal</code>: tunerele, sateliții, transponderul de la care pornește măsurarea și starea ei"
msgstr "<code>GET /api/gasire-semnal</code>: de tuners, de satellieten, de transponder waarmee de meting begint en de status ervan"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-emisiune?ref=&amp;id=</code>: ghidul unui canal (fără <code>ref</code>, canalul de pe televizor) și o emisiune cu descrierile"
msgstr "<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-emisiune?ref=&amp;id=</code>: de gids van een zender (zonder <code>ref</code>, de zender op de tv) en een uitzending met de beschrijvingen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/import-surse?cauta=1</code>: copiile de canale și setări găsite pe stick-uri și pe receptor, starea căutării și a importului"
msgstr "<code>GET /api/import-surse?cauta=1</code>: de kopieën van zenders en instellingen gevonden op sticks en op de ontvanger, de status van het zoeken en van de import"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|retea|hdmi</code>: ecranele „System Information”, cu aceleași texte ca pe televizor"
msgstr "<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|retea|hdmi</code>: de schermen “System Information”, met dezelfde teksten als op de tv"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/interfete-cam?reincarca=1</code>: modulele de acces condiționat instalate și interfețele lor web, cu numele date de fiecare modul (fără <code>reincarca</code> poate veni o căutare făcută cu câteva secunde înainte)"
msgstr "<code>GET /api/interfete-cam?reincarca=1</code>: de geïnstalleerde modules voor voorwaardelijke toegang en hun webinterfaces, met de namen die elke module geeft (zonder <code>reincarca</code> kan een zoekopdracht van enkele seconden eerder terugkomen)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/jurnal</code>: jurnalul de versiuni (ce s-a schimbat la fiecare actualizare)"
msgstr "<code>GET /api/jurnal</code>: het versielogboek (wat er bij elke update is veranderd)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: programele din imagine cu licența fiecăruia și textul unei licențe"
msgstr "<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: de programma's in het image met de licentie van elk en de tekst van een licentie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/limba-interfata</code>: limba meniurilor de acum și lista limbilor, cu numele de pe televizor"
msgstr "<code>GET /api/limba-interfata</code>: de huidige menutaal en de lijst met talen, met de namen zoals op de tv"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/limbi</code>: limba sunetului și a subtitrărilor: cele 7 setări cu alegerile lor, ce se ține minte pe canalul de acum și canalele cu alegeri de mână"
msgstr "<code>GET /api/limbi</code>: de taal van het geluid en van de ondertitels: de 7 instellingen met hun keuzes, wat er op de huidige zender wordt onthouden en de zenders met handmatige keuzes"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/liste-implicite</code>: listele de canale gata făcute și drumurile spre scanare și import"
msgstr "<code>GET /api/liste-implicite</code>: de kant-en-klare kanalenlijsten en de wegen naar zoeken en importeren"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/lnb-stare</code>: verificarea semnalului, întrebarea și secundele rămase"
msgstr "<code>GET /api/lnb-stare</code>: de signaalcontrole, de vraag en de resterende seconden"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/lnb?slot=N</code>: LNB-urile tunerului, cu valorile, alegerile și „Probă de calcul” (numai citire)"
msgstr "<code>GET /api/lnb?slot=N</code>: de LNB's van de tuner, met de waarden, de keuzes en “Rekenproef” (alleen lezen)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/locul[?tara=RO]</code>: locul antenei pentru motorul USALS, țările și orașele unei țări (tabelul din imagine)"
msgstr "<code>GET /api/locul[?tara=RO]</code>: de locatie van de schotel voor de USALS-motor, de landen en de steden van een land (de tabel in het image)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/meniu</code>: tot meniul receptorului (tasta MENU), cu aceleași intrări ca pe televizor pentru nivelul ales"
msgstr "<code>GET /api/meniu</code>: het hele menu van de ontvanger (MENU-toets), met dezelfde items als op de tv voor het gekozen niveau"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, <code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: modul sigur (opririle interfeței, alegerile de după ele) și fișierele lui ca text"
msgstr "<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, <code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: de veilige modus (de crashes van de interface, de keuzes daarna) en de bestanden ervan als tekst"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor-comenzi</code>: tunerele cu motor, sateliții și starea comenzilor"
msgstr "<code>GET /api/motor-comenzi</code>: de tuners met motor, de satellieten en de status van de commando's"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor-comenzi?urma=N</code>: urma comenzilor trimise motorului (ultimele N, implicit 100, cel mult 500, cele mai noi întâi): ora, comanda, unghiul, cine a cerut-o (televizorul, ecranul sau pagina motorului, Găsire semnal, reacordarea), poziția crezută de receptor; numai citire, din <code>/home/root/logs/hds-motor.log</code>"
msgstr "<code>GET /api/motor-comenzi?urma=N</code>: het spoor van de commando's naar de motor (de laatste N, standaard 100, hoogstens 500, nieuwste eerst): tijd, commando, hoek, wie erom vroeg (de tv, het scherm of de motorpagina, Signaalzoeker, het opnieuw afstemmen), de positie volgens de ontvanger; alleen lezen, uit <code>/home/root/logs/hds-motor.log</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor</code>: starea rotirii antenei (de unde, pana unde, poziția estimată, cât mai are de mers)"
msgstr "<code>GET /api/motor</code>: de status van het draaien van de schotel (vanaf waar, tot waar, de geschatte positie, hoeveel hij nog moet draaien)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;xp=&amp;yp=</code>: mouse-ul pe ecranul televizorului, ca în emulator: <code>xp</code>, <code>yp</code> = locul în procente din ecran (sau <code>x</code>, <code>y</code> în pixelii ecranului, 1920x1080); <code>clic</code> alege rândul de sub mouse, iar pe rândul ales sau cu <code>clicuri=2</code> dă OK; un buton colorat = tasta lui; <code>drag</code> (cu <code>x0p</code>, <code>y0p</code> = locul apăsării, <code>nou=1</code> la prima mișcare) și <code>dragend</code> = trasul pe bara de derulare; <code>rotita&amp;pasi=-12..12</code> = sus/jos (3 pași sau mai mulți = o pagină); <code>dreapta</code> = Meniu, <code>mijloc</code> = Ieșire. Răspunsul spune ce s-a făcut (<code>facut</code>: selectie, ok, buton, bara, derulare, tasta, nimic). Din browser, cu POST și antetul <code>X-HDS-CSRF</code>, ca <code>remotecontrol</code>"
msgstr "<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;xp=&amp;yp=</code>: de muis op het tv-scherm, zoals in de emulator: <code>xp</code>, <code>yp</code> = de plek in procenten van het scherm (of <code>x</code>, <code>y</code> in pixels van het scherm, 1920x1080); <code>clic</code> kiest de rij onder de muis, en op de gekozen rij of met <code>clicuri=2</code> geeft hij OK; een gekleurde knop = de bijbehorende toets; <code>drag</code> (met <code>x0p</code>, <code>y0p</code> = de plek van het indrukken, <code>nou=1</code> bij de eerste beweging) en <code>dragend</code> = slepen op de schuifbalk; <code>rotita&amp;pasi=-12..12</code> = omhoog/omlaag (3 stappen of meer = een pagina); <code>dreapta</code> = Menu, <code>mijloc</code> = Afsluiten. Het antwoord zegt wat er is gedaan (<code>facut</code>: selectie, ok, buton, bara, derulare, tasta, nimic). Vanuit de browser, met POST en de header <code>X-HDS-CSRF</code>, zoals <code>remotecontrol</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/navigator</code>: navigatorul web de pe televizor (deschis sau nu, modul, desenul, felul câmpului ales, mărirea; fără adrese), setările lui și favoritele"
msgstr "<code>GET /api/navigator</code>: de webbrowser op de tv (open of niet, de modus, de weergave, het soort gekozen veld, de zoom; zonder adressen), de instellingen ervan en de favorieten"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ocr-limbi</code>: limbile recunoașterii textului (în imagine, descărcate, de descărcat, cu mărimea și starea fiecăreia) și locul pentru modelele noi"
msgstr "<code>GET /api/ocr-limbi</code>: de talen van de tekstherkenning (in het image, gedownload, nog te downloaden, met de grootte en status van elke taal) en de locatie voor nieuwe modellen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/pasi-decriptare</code>: pașii decriptării canalului de pe televizor (cererea către modulul de acces, răspunsurile și timpul lor, imaginea decriptată, mesajele modulului CI), numai cu setarea Arată pașii decriptării pornită"
msgstr "<code>GET /api/pasi-decriptare</code>: de stappen van het decoderen van de zender op de tv (het verzoek aan de toegangsmodule, de antwoorden en hun tijd, het gedecodeerde beeld, de berichten van de CI-module), alleen met de instelling Stappen van het decoderen tonen ingeschakeld"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/paza-model</code>: paza de model (receptorul pentru care e făcută imaginea și amprenta acestuia); <code>GET /api/actualizare-pachete</code>: pachetele de actualizare găsite și verdictul pazei pentru fiecare"
msgstr "<code>GET /api/paza-model</code>: de modelbewaking (de ontvanger waarvoor het image is gemaakt en de vingerafdruk ervan); <code>GET /api/actualizare-pachete</code>: de gevonden updatepakketten en het oordeel van de bewaking voor elk pakket"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/paznic</code>: paznicul receptorului: starea, setările (<code>interfata</code>, <code>asteptare</code> în secunde), alegerile și ultimele rânduri din jurnalul lui"
msgstr "<code>GET /api/paznic</code>: de bewaker van de ontvanger: de status, de instellingen (<code>interfata</code>, <code>asteptare</code> in seconden), de keuzes en de laatste regels uit zijn logboek"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/portal</code>: starea HbbTV a canalului care rulează (da, nu are, încă nu se știe), cu mesajul arătat pe televizor la tasta PORTAL"
msgstr "<code>GET /api/portal</code>: de HbbTV-status van de zender die nu speelt (ja, heeft het niet, nog onbekend), met het bericht dat op de tv wordt getoond bij de toets PORTAL"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/procesor</code>: procesorul: modul de lucru, modurile care există pe receptor, frecvența setată și cea de acum, temperatura, tensiunea, procentul folosit și timpul pe fiecare treaptă"
msgstr "<code>GET /api/procesor</code>: de processor: de werkmodus, de modi die op de ontvanger bestaan, de ingestelde en de huidige frequentie, de temperatuur, de spanning, het gebruikte percentage en de tijd op elke stap"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: postul de radio care merge, cu textele ecranului radio; barele și nivelul sunetului"
msgstr "<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: de radiozender die speelt, met de teksten van het radioscherm; de balken en het geluidsniveau"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: apasă o tastă ca de pe telecomanda receptorului (coduri de tastă Linux, de exemplu 352 pentru OK); cu <code>lung=1</code>, apăsare lungă"
msgstr "<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: drukt een toets in zoals op de afstandsbediening van de ontvanger (Linux-toetscodes, bijvoorbeeld 352 voor OK); met <code>lung=1</code>, lang indrukken"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare-stare</code>: starea căutării (procent, canale găsite, transpondere, timp rămas, rezultat)"
msgstr "<code>GET /api/scanare-stare</code>: de status van het zoeken (percentage, gevonden zenders, transponders, resterende tijd, resultaat)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare-ultima</code>: rezultatul ultimei scanări de canale, ținut până la scanarea următoare: <code>inceput</code>, <code>sfarsit</code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, <code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, <code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, <code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, iar când se știu <code>tsid</code>, <code>onid</code>, <code>nid</code> și, la cablu, <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, <code>caid</code>, iar când operatorul trimite numerele canalelor <code>lcn</code> și <code>lcn_vizibil</code>): toate serviciile citite din SDT, vechi și noi, și <code>retele</code> (<code>nid</code>, <code>nume</code>, <code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, <code>privati</code>): rețelele din tabela NIT; câmpurile din tabela NIT (<code>nid</code>, <code>lcn</code>, <code>retele</code>) apar la căutarea în rețea și la scanarea pe cablu pe o singură frecvență; numai citire, lista de canale nu se schimbă; fără nicio scanare de la pornire, <code>result</code> false"
msgstr "<code>GET /api/scanare-ultima</code>: het resultaat van de laatste zenderzoekactie, bewaard tot de volgende zoekactie: <code>inceput</code>, <code>sfarsit</code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, <code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, <code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, <code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, en indien bekend <code>tsid</code>, <code>onid</code>, <code>nid</code> en, bij kabel, <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, <code>caid</code>, en als de aanbieder zendernummers meestuurt <code>lcn</code> en <code>lcn_vizibil</code>): alle diensten gelezen uit de SDT, oud en nieuw, en <code>retele</code> (<code>nid</code>, <code>nume</code>, <code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, <code>privati</code>): de netwerken uit de NIT-tabel; de NIT-velden (<code>nid</code>, <code>lcn</code>, <code>retele</code>) verschijnen bij het zoeken in het netwerk en bij het zoeken op kabel op één frequentie; alleen lezen, de kanalenlijst verandert niet; zonder enige zoekactie sinds het opstarten, <code>result</code> false"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare</code>: secțiunile „Scanare” și „Orientarea și setarea antenei”, cu felurile de scanare, în ordinea din meniul receptorului; cu <code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</code>, câmpurile felului și ce s-ar căuta"
msgstr "<code>GET /api/scanare</code>: de secties “Kanalen zoeken” en “Uitrichten en instellen van de schotel”, met de soorten zoeken, in de volgorde van het menu van de ontvanger; met <code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</code>, de velden van die soort en wat er gezocht zou worden"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;mode=all|video|osd&amp;download=1</code>: imaginea de pe ecran; <code>mode</code>: <code>all</code> cu afișajul OSD (implicit), <code>video</code> numai imaginea canalului, <code>osd</code> numai afișajul OSD; <code>download=1</code>: descărcare ca fișier, cu data și ora receptorului în nume"
msgstr "<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;mode=all|video|osd&amp;download=1</code>: het beeld op het scherm; <code>mode</code>: <code>all</code> met de OSD-weergave (standaard), <code>video</code> alleen het beeld van de zender, <code>osd</code> alleen de OSD-weergave; <code>download=1</code>: downloaden als bestand, met de datum en tijd van de ontvanger in de naam"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/setari-din-copie</code>: setările importate: câte așteaptă repornirea interfeței (<code>asteapta</code>), proba lor (<code>garda</code>), scoase după opriri neașteptate (<code>cazut</code>), textele stării"
msgstr "<code>GET /api/setari-din-copie</code>: de geïmporteerde instellingen: hoeveel er wachten op het herstarten van de interface (<code>asteapta</code>), hun test (<code>garda</code>), verwijderd na onverwachte stops (<code>cazut</code>), de statusteksten"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/setari</code>: ecranele de setări din meniu; cu <code>id=&lt;cheie&gt;</code>, rândurile lor (aceleași ca pe televizor, cu alegerile)"
msgstr "<code>GET /api/setari</code>: de instellingenschermen uit het menu; met <code>id=&lt;cheie&gt;</code>, hun regels (dezelfde als op de tv, met de keuzes)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/standby-tv</code>: ieșirea HDMI în standby (oprită sau pornită, oprirea din nou după aprinderea televizorului) și starea CEC"
msgstr "<code>GET /api/standby-tv</code>: de HDMI-uitgang in standby (uit of aan, opnieuw uitschakelen na het aanzetten van de tv) en de CEC-status"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/stare-retea</code>: legătura cu routerul și internetul (cablu sau Wi-Fi, treptele semnalului Wi-Fi, internetul merge, routerul nu are internet sau receptorul nu e conectat la router), cu desenul pictogramei și textul ei, ca pictograma din bara de pe televizor"
msgstr "<code>GET /api/stare-retea</code>: de verbinding met de router en het internet (kabel of Wi-Fi, de niveaus van het Wi-Fi-signaal, internet werkt, de router heeft geen internet of de ontvanger is niet verbonden met de router), met de tekening van het pictogram en de tekst ervan, zoals het pictogram in de balk op de tv"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/statusinfo</code>: canalul curent, volumul, standby"
msgstr "<code>GET /api/statusinfo</code>: de huidige zender, het volume, standby"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/stocare</code>: locul înregistrărilor, spațiul liber și discurile conectate"
msgstr "<code>GET /api/stocare</code>: de locatie van de opnames, de vrije ruimte en de aangesloten schijven"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-aspect</code>: aspectul subtitrărilor text (fontul, grosimea, mărimea și culoarea literelor, conturul, umbra, fundalul, înălțimea, distanța dintre rânduri) și mărirea subtitrărilor DVB, cu alegerile posibile (<code>alegeri</code>), stilurile gata făcute și valorile de la început"
msgstr "<code>GET /api/subtitrari-aspect</code>: het uiterlijk van de tekstondertitels (het lettertype, de dikte, de grootte en kleur van de letters, de omlijning, de schaduw, de achtergrond, de hoogte, de afstand tussen de regels) en de vergroting van de DVB-ondertitels, met de mogelijke keuzes (<code>alegeri</code>), de kant-en-klare stijlen en de beginwaarden"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-film</code>: filmul care merge, subtitrările lui, întârzierea, codarea și cadrele pe secundă"
msgstr "<code>GET /api/subtitrari-film</code>: de film die speelt, de ondertitels ervan, de vertraging, de codering en de beelden per seconde"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-ocr</code>: contorul recunoașterii textului din subtitrările DVB (pagini citite ca text, rămase imagine și de ce, timpul mediu, ultimele pagini, viteza serviciului)"
msgstr "<code>GET /api/subtitrari-ocr</code>: de teller van de tekstherkenning van de DVB-ondertitels (pagina's gelezen als tekst, pagina's die afbeelding bleven en waarom, de gemiddelde tijd, de laatste pagina's, de snelheid van de dienst)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/sunet</code>: ieșirea sunetului (Automat / Manual), AC3 și DTS downmix, pista AC3, ce primește televizorul (EDID), ce se trimite acum și de ce, ce arată driverul pe HDMI și optic"
msgstr "<code>GET /api/sunet</code>: de geluidsuitgang (Automatisch / Handmatig), AC3- en DTS-downmix, het AC3-spoor, wat de tv ontvangt (EDID), wat er nu wordt verzonden en waarom, wat de driver toont op HDMI en optisch"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/telecomenzi-export?format=json|csv</code>: codurile telecomenzii receptorului și ale celor asociate, pentru aplicații"
msgstr "<code>GET /api/telecomenzi-export?format=json|csv</code>: de codes van de afstandsbediening van de ontvanger en van de gekoppelde afstandsbedieningen, voor apps"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/telecomenzi</code>: telecomenzile asociate, tastele lor și captura paginii (cititorul, proba, asocierea)"
msgstr "<code>GET /api/telecomenzi</code>: de gekoppelde afstandsbedieningen, hun toetsen en de vastlegging van de pagina (de lezer, de test, het koppelen)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext-copii</code> (cu <code>?canale=1</code> și canalele care au teletext): copiile de teletext salvate (canalul, data, paginile, mărimea), dosarul, spațiul folosit și cel ales, urmăritorul (caruselul canalului de acum, reîmprospătarea în lucru) și setările"
msgstr "<code>GET /api/teletext-copii</code> (met <code>?canale=1</code> ook de zenders die teletekst hebben): de opgeslagen teletekstkopieën (de zender, de datum, de pagina's, de grootte), de map, de gebruikte en de gekozen ruimte, de volger (de carrousel van de huidige zender, de verversing die bezig is) en de instellingen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> (fără <code>ref</code>: canalul de acum): <code>date</code> = fișierul copiei (.ttx, comprimat), <code>html</code> = o singură pagină HTML cu toate paginile, care se citește fără receptor"
msgstr "<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> (zonder <code>ref</code>: de huidige zender): <code>date</code> = het bestand van de kopie (.ttx, gecomprimeerd), <code>html</code> = één enkele HTML-pagina met alle pagina's, die je zonder ontvanger kunt lezen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;ref&gt;</code>: o pagină de teletext, ca pe televizor la tasta TEXT: cele 25 de rânduri a câte 40 de celule (litera, culoarea, fundalul, mozaicul, atributele), textul paginii, subpaginile, paginile tastelor colorate, paginile vecine și pagina de pe televizor; fără <code>pagina</code>, pagina de pe televizor sau cea de pornire; <code>sub=-1</code> = cea mai nouă; <code>ascuns=1</code> arată ce e ascuns; cu <code>copie</code>, paginile din copia salvată a canalului, fără tuner (<code>sursa</code>: <code>direct</code> sau <code>copie</code>); <code>hd</code> = setarea Teletext neted, <code>optiuni</code> = conturul literelor, umbra literelor și formele în relief (<code>contur</code>, <code>umbra</code>, <code>relief</code>, ca pe televizor). Pagina lipsă: <code>gasita</code> fals și mesajul că se caută"
msgstr "<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;ref&gt;</code>: een teletekstpagina, zoals op de tv met de TEXT-toets: de 25 regels van elk 40 cellen (letter, kleur, achtergrond, mozaïek, attributen), de tekst van de pagina, de subpagina's, de pagina's van de kleurtoetsen, de naburige pagina's en de pagina op de tv; zonder <code>pagina</code>, de pagina op de tv of de startpagina; <code>sub=-1</code> = de nieuwste; <code>ascuns=1</code> toont wat verborgen is; met <code>copie</code>, de pagina's uit de opgeslagen kopie van de zender, zonder tuner (<code>sursa</code>: <code>direct</code> of <code>copie</code>); <code>hd</code> = de instelling Gladde teletekst, <code>optiuni</code> = de omlijning van de letters, de schaduw van de letters en de reliëfvormen (<code>contur</code>, <code>umbra</code>, <code>relief</code>, zoals op de tv). Ontbrekende pagina: <code>gasita</code> onwaar en de melding dat ernaar gezocht wordt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: jurnalul unei înregistrări, pe înțelesul oricui, cu mesajul tehnic; golirea lui"
msgstr "<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: het logboek van een opname, begrijpelijk voor iedereen, met de technische melding; het wissen ervan"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/temporizatoare</code>: înregistrările programate (aceeași ordine, stare și detalii ca pe televizor), locul înregistrărilor și spațiul liber"
msgstr "<code>GET /api/temporizatoare</code>: de geplande opnames (dezelfde volgorde, status en details als op de tv), de opnamelocatie en de vrije ruimte"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/traducere-configurare</code>: configurarea pas cu pas a traducerii: ce e pus acum (<code>acum</code>: serviciul, dacă are cheie, pornită sau nu, ultima probă, <code>chei_din_nou</code>), lucrarea configurării (<code>configurare</code>: starea, pasul, proba, modelul și modelele, mesajul și ce să faci), căutarea serverelor din casă (<code>cautare</code>: progresul și serverele găsite), instrucțiunile și pagina cheii fiecărui serviciu, regiunile Azure; niciodată o cheie"
msgstr "<code>GET /api/traducere-configurare</code>: de stapsgewijze configuratie van de vertaling: wat nu is ingesteld (<code>acum</code>: de dienst, of er een sleutel is, aan of uit, de laatste test, <code>chei_din_nou</code>), het configuratiewerk (<code>configurare</code>: de status, de stap, de test, het model en de modellen, de melding en wat je moet doen), het zoeken naar servers in huis (<code>cautare</code>: de voortgang en de gevonden servers), de instructies en de sleutelpagina van elke dienst, de Azure-regio's; nooit een sleutel"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/traducere-subtitrari</code>: traducerea automată a subtitrărilor text: valorile (<code>pornit</code>, <code>serviciu</code>, <code>limba</code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</code>, <code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</code>, <code>adresa_libre</code>, <code>adresa_openai</code>, <code>model_gemini</code>, <code>model_openai</code>, <code>model_groq</code>, <code>model_cloudflare</code>, <code>cont_cloudflare</code> și, pentru adresa proprie, <code>propriu_adresa</code>, <code>propriu_metoda</code>, <code>propriu_corp</code>, <code>propriu_tip_corp</code>, <code>propriu_antet</code>, <code>propriu_raspuns</code>, <code>propriu_cale</code>), alegerile posibile (<code>alegeri</code>), ce cere fiecare serviciu (<code>cere</code>), care serviciu are cheie (<code>chei</code>, niciodată cheia), dacă cheile trebuie puse din nou (<code>chei_din_nou</code>, textul notei, gol când nu e cazul), starea cheii serviciului ales, ca pe televizor (<code>cheie_fel</code> și <code>cheie_text</code>: pusă, pusă pentru alt server, lipsă), textele paginii în limba receptorului (<code>texte</code>), ce lipsește, confidențialitatea, instrucțiunile pas cu pas (cu <code>pagina_cheie</code>, adresa oficială pentru codul QR) și starea (contorul, proba, pauza după erori)"
msgstr "<code>GET /api/traducere-subtitrari</code>: de automatische vertaling van tekstondertitels: de waarden (<code>pornit</code>, <code>serviciu</code>, <code>limba</code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</code>, <code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</code>, <code>adresa_libre</code>, <code>adresa_openai</code>, <code>model_gemini</code>, <code>model_openai</code>, <code>model_groq</code>, <code>model_cloudflare</code>, <code>cont_cloudflare</code> en, voor het eigen adres, <code>propriu_adresa</code>, <code>propriu_metoda</code>, <code>propriu_corp</code>, <code>propriu_tip_corp</code>, <code>propriu_antet</code>, <code>propriu_raspuns</code>, <code>propriu_cale</code>), de mogelijke keuzes (<code>alegeri</code>), wat elke dienst vraagt (<code>cere</code>), welke dienst een sleutel heeft (<code>chei</code>, nooit de sleutel), of de sleutels opnieuw moeten worden ingevoerd (<code>chei_din_nou</code>, de tekst van de opmerking, leeg als dat niet zo is), de status van de sleutel van de gekozen dienst, zoals op de tv (<code>cheie_fel</code> en <code>cheie_text</code>: ingesteld, ingesteld voor een andere server, ontbreekt), de teksten van de pagina in de taal van de ontvanger (<code>texte</code>), wat ontbreekt, de privacy, de stapsgewijze instructies (met <code>pagina_cheie</code>, het officiële adres voor de QR-code) en de status (de teller, de test, de pauze na fouten)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: canalele de pe frecvența televizorului și din lista lui, fiecare cu merge acum sau motivul, codecul imaginii și felul sunetului; cu <code>wasm=1</code> (browserul are playerul MPEG-2) merg și canalele cu imagine MPEG-2; <code>ac3=1</code>: pagina redă sunetul AC-3, cu decodorul browserului sau cu decodorul wasm al paginii"
msgstr "<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: de zenders op de frequentie van de tv en uit zijn lijst, elk met of het nu werkt of de reden, de beeldcodec en het soort geluid; met <code>wasm=1</code> (de browser heeft de MPEG-2-speler) werken ook de zenders met MPEG-2-beeld; <code>ac3=1</code>: de pagina speelt AC-3-geluid af, met de decoder van de browser of met de wasm-decoder van de pagina"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/tv-stare</code>: TV în browser: transmisiile de acum (canal, browser, de când, octeți), setările, memoria driverului video (câte canale noi se mai pot deschide până la repornire), transmisia acestui browser și motivul ultimei opriri"
msgstr "<code>GET /api/tv-stare</code>: tv in de browser: de huidige uitzendingen (zender, browser, sinds wanneer, bytes), de instellingen, het geheugen van de videodriver (hoeveel nieuwe zenders nog geopend kunnen worden tot de herstart), de uitzending van deze browser en de reden van de laatste stop"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/video</code>: setările video ca în Setări &gt; Video: rezoluțiile, frecvențele fiecărei rezoluții (cu <code>auto</code> = automat după canal), culorile HDMI, <code>zapmode</code> (ce se vede la schimbarea canalului) și încercarea în curs"
msgstr "<code>GET /api/video</code>: de video-instellingen zoals in Instellingen &gt; Video: de resoluties, de frequenties van elke resolutie (met <code>auto</code> = automatisch per zender), de HDMI-kleuren, <code>zapmode</code> (wat je ziet bij het wisselen van zender) en de lopende poging"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: schimbă canalul"
msgstr "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: wisselt van zender"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/accel-reporneste</code>: repornește interfața (enigma2)"
msgstr "<code>POST /api/accel-reporneste</code>: herstart de interface (enigma2)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/accel-seteaza?pornita=0|1</code>: pornește sau oprește accelerarea de la următoarea pornire a interfeței (refuzat pe un receptor fără accelerarea 2D)"
msgstr "<code>POST /api/accel-seteaza?pornita=0|1</code>: zet de versnelling aan of uit vanaf de volgende start van de interface (geweigerd op een ontvanger zonder 2D-versnelling)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</code> ca în <code>GET /api/acces-conditionat</code>): pornește comanda prin scriptul modulului, pe rând, una singură deodată (și cu televizorul); rezultatul vine prin <code>GET /api/acces-conditionat</code>"
msgstr "<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</code> zoals in <code>GET /api/acces-conditionat</code>): start de opdracht via het script van de module, op volgorde, maar één tegelijk (ook met de tv); het resultaat komt via <code>GET /api/acces-conditionat</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-adauga</code> (corp: <code>cheie=</code>), <code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?amprenta=SHA256:..&amp;confirmat=1</code>: cheile publice lipite, cele din dosarul hdsatelit/ssh de pe stick, ștergerea unei chei"
msgstr "<code>POST /api/acces-ssh-adauga</code> (body: <code>cheie=</code>), <code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?amprenta=SHA256:..&amp;confirmat=1</code>: de geplakte publieke sleutels, die uit de map hdsatelit/ssh op de stick, het wissen van een sleutel"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</code> cere și <code>confirmat=1</code>): „Fără parolă în rețeaua locală”. Parola, textul brut și toate schimbările merg numai dintr-un browser conectat cu codul de pe televizor (altfel 403 cu <code>trebuie_cod</code>), niciodată cu <code>?token=</code>; cât ecranul „Acces SSH” e deschis pe televizor, la fel <code>/api/remotecontrol</code> și <code>/api/screenshot</code>"
msgstr "<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</code> vraagt ook <code>confirmat=1</code>): “Zonder wachtwoord in het lokale netwerk”. Het wachtwoord, de ruwe tekst en alle wijzigingen werken alleen vanuit een browser die verbonden is met de code op de tv (anders 403 met <code>trebuie_cod</code>), nooit met <code>?token=</code>; zolang het scherm “SSH-toegang” open is op de tv, geldt hetzelfde voor <code>/api/remotecontrol</code> en <code>/api/screenshot</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/acces-ssh-ascunde</code>: o parolă nouă; „Am notat parola” (textul parolei se șterge de pe receptor, parola rămâne)"
msgstr "<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/acces-ssh-ascunde</code>: een nieuw wachtwoord; “Ik heb het wachtwoord genoteerd” (de tekst van het wachtwoord wordt van de ontvanger gewist, het wachtwoord blijft)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-parola</code>: textul parolei, cât timp nu a fost ascunsă; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: fișierele serverului SSH ca text (fără /etc/shadow)"
msgstr "<code>POST /api/acces-ssh-parola</code>: de tekst van het wachtwoord, zolang die niet verborgen is; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: de bestanden van de SSH-server als tekst (zonder /etc/shadow)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: salvează și aplică pe loc (oricare dintre ele); <code>previzualizare=1&amp;lista=...</code> arată lista pe afișaj fără salvare (cel mult 2 minute fără o cerere nouă), <code>previzualizare=0</code> revine; <code>minutar=0|1..120</code> și <code>cronometru=porneste|opreste|zero</code> pornesc ceasurile afișajului pe loc; <code>functionare=ora|canal|stins</code> merge ca înainte"
msgstr "<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: slaat op en past direct toe (elk ervan); <code>previzualizare=1&amp;lista=...</code> toont de lijst op het display zonder op te slaan (maximaal 2 minuten zonder nieuw verzoek), <code>previzualizare=0</code> keert terug; <code>minutar=0|1..120</code> en <code>cronometru=porneste|opreste|zero</code> starten de klokken van het display direct; <code>functionare=ora|canal|stins</code> werkt zoals voorheen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</code>: salvează reglajele unui profil (multipli de 5); cu <code>incearca=1</code> se văd pe loc fără să se salveze, <code>renunta=1</code> pune înapoi ce e salvat; <code>POST /api/calitate-imagine-implicite?profil=&lt;profil&gt;|toate</code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|hdr10|hlg|none</code> (canalul pornește din nou, întrebarea apare pe televizor); <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;&amp;pornit=0|1</code> (jumătate de ecran, 60 s)"
msgstr "<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</code>: slaat de instellingen van een profiel op (veelvouden van 5); met <code>incearca=1</code> zie je ze direct zonder op te slaan, <code>renunta=1</code> zet terug wat is opgeslagen; <code>POST /api/calitate-imagine-implicite?profil=&lt;profil&gt;|toate</code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|hdr10|hlg|none</code> (de zender start opnieuw, de vraag verschijnt op de tv); <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;&amp;pornit=0|1</code> (half scherm, 60 s)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: pornește canalul prin lista de pe televizor"
msgstr "<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: start de zender via de lijst op de tv"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: deschide pe televizor un rezultat al căutării, cu rândul găsit ales"
msgstr "<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: opent op de tv een zoekresultaat, met de gevonden regel geselecteerd"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza-opreste</code>: oprește citirea și revine la canalul de dinainte"
msgstr "<code>POST /api/cautare-actualizeaza-opreste</code>: stopt het lezen en keert terug naar de vorige zender"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza-sari</code>: sare peste satelitul pe care e antena acum și trece la următorul (tasta GALBEN de pe televizor)"
msgstr "<code>POST /api/cautare-actualizeaza-sari</code>: slaat de satelliet over waar de schotel nu op staat en gaat naar de volgende (GELE toets op de tv)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: întrebarea (durata, motorul); cu <code>confirmat=1</code> pornește pe televizor citirea pistelor, transponder cu transponder"
msgstr "<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: de vraag (duur, motor); met <code>confirmat=1</code> start op de tv het lezen van de sporen, transponder voor transponder"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: citirea pistelor în timpul vizionării (oprită, numai canalul privit, tot transponderul), aceeași setare ca pe televizor"
msgstr "<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: het lezen van de sporen tijdens het kijken (uit, alleen de bekeken zender, de hele transponder), dezelfde instelling als op de tv"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;&amp;fus=&lt;fus orar&gt;</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>/api/ceas</code>)"
msgstr "<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;&amp;fus=&lt;fus orar&gt;</code>: wijzigt en slaat elk ervan op (de exacte waarden staan in <code>/api/ceas</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ceas-sincronizeaza</code>: o sincronizare a orei prin Internet, acum"
msgstr "<code>POST /api/ceas-sincronizeaza</code>: een tijdsynchronisatie via internet, nu"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/copie-setari-pune?copie=&lt;id&gt;</code> (repornește interfața; copia se pune la loc înainte să pornească), <code>POST /api/copie-setari-sterge?copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"
msgstr "<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/copie-setari-pune?copie=&lt;id&gt;</code> (herstart de interface; de kopie wordt teruggezet voordat deze start), <code>POST /api/copie-setari-sterge?copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|invata|sterge&amp;flux=..</code>: actualizează lista, reface buchetele, învață posturile unui flux, șterge un flux adăugat de mână"
msgstr "<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|invata|sterge&amp;flux=..</code>: werkt de lijst bij, bouwt de boeketten opnieuw op, leert de zenders van een stream, verwijdert een handmatig toegevoegde stream"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;emisfera=E|V&amp;frecventa=..&amp;...</code>: un flux adăugat de mână, cu aceleași câmpuri și limite ca „Adaugă manual”"
msgstr "<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;emisfera=E|V&amp;frecventa=..&amp;...</code>: een handmatig toegevoegde stream, met dezelfde velden en limieten als “Handmatig toevoegen”"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-seteaza?cheie=tasta|dosar|latime|nedecodabile&amp;valoare=..</code>: setările ferestrei, aceleași ca pe televizor"
msgstr "<code>POST /api/dabt2-seteaza?cheie=tasta|dosar|latime|nedecodabile&amp;valoare=..</code>: de instellingen van het venster, dezelfde als op de tv"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-televizor?fel=dab|t2</code>: deschide fereastra pe televizor"
msgstr "<code>POST /api/dabt2-televizor?fel=dab|t2</code>: opent het venster op de tv"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ecran-negru-fapta?fapta=&lt;id&gt;|ascunde</code>: fapta mesajului de acum, pe televizor, sau ascunderea lui"
msgstr "<code>POST /api/ecran-negru-fapta?fapta=&lt;id&gt;|ascunde</code>: de actie van het huidige bericht, op de tv, of het verbergen ervan"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ecran-sterge?sursa=galerie|propriu&amp;id=..</code>, <code>POST /api/ecran-la-loc</code>: șterge un ecran de pornire din galerie (nu cel din fabrică și nici cel pus) sau pune la loc ecranele șterse"
msgstr "<code>POST /api/ecran-sterge?sursa=galerie|propriu&amp;id=..</code>, <code>POST /api/ecran-la-loc</code>: verwijdert een opstartscherm uit de galerij (niet dat uit de fabriek en ook niet het ingestelde) of zet de verwijderde schermen terug"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/filme-comanda?fa=pauza|redare|inainte|inapoi</code>, <code>?fa=salt&amp;secunde=-60</code>, <code>?fa=la&amp;secunde=N</code>, <code>POST /api/filme-seteaza?pornire=&amp;oprire=&amp;sfarsit=</code>, <code>POST /api/filme-porneste?cale=..&amp;de_la=loc|inceput</code>: aceleași comenzi ca pe telecomandă în player și în lista de filme"
msgstr "<code>POST /api/filme-comanda?fa=pauza|redare|inainte|inapoi</code>, <code>?fa=salt&amp;secunde=-60</code>, <code>?fa=la&amp;secunde=N</code>, <code>POST /api/filme-seteaza?pornire=&amp;oprire=&amp;sfarsit=</code>, <code>POST /api/filme-porneste?cale=..&amp;de_la=loc|inceput</code>: dezelfde opdrachten als met de afstandsbediening in de player en in de filmlijst"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/fonturi-descarca?familie=&lt;Familia&gt;&amp;mare=1</code>: descarcă, verifică și înregistrează un font"
msgstr "<code>POST /api/fonturi-descarca?familie=&lt;Familia&gt;&amp;mare=1</code>: downloadt, controleert en registreert een lettertype"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/fonturi-sterge?alias=&lt;NumeInSkin&gt;</code>: șterge un font descărcat"
msgstr "<code>POST /api/fonturi-sterge?alias=&lt;NumeInSkin&gt;</code>: verwijdert een gedownload lettertype"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/gasire-semnal-porneste</code>, <code>-reacordeaza</code>, <code>-opreste</code>: pornește, acordează din nou sau oprește măsurarea"
msgstr "<code>POST /api/gasire-semnal-porneste</code>, <code>-reacordeaza</code>, <code>-opreste</code>: start, stemt opnieuw af of stopt de meting"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ghid-temporizator?ref=&amp;id=&amp;fel=inregistrare|comutare|scoate</code>: pune sau scoate înregistrarea unei emisiuni (409 la suprapunere)"
msgstr "<code>POST /api/ghid-temporizator?ref=&amp;id=&amp;fel=inregistrare|comutare|scoate</code>: plaatst of verwijdert de opname van een programma (409 bij overlapping)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/import-alta-imagine?raspuns=da|nu|ascunde</code>: răspunsul la întrebarea de la prima pornire (canalele și setările din altă imagine, găsite pe stick sau disc); starea în <code>/api/import-surse</code> (<code>alta_imagine</code>)"
msgstr "<code>POST /api/import-alta-imagine?raspuns=da|nu|ascunde</code>: het antwoord op de vraag bij de eerste start (de zenders en instellingen uit een ander image, gevonden op stick of schijf); de status in <code>/api/import-surse</code> (<code>alta_imagine</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;temporizatoare=0&amp;generale=0</code>: pornește importul (întâi copia de siguranță)"
msgstr "<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;temporizatoare=0&amp;generale=0</code>: start de import (eerst de back-up)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: schimbă limba meniurilor și o salvează, ca OK în ecranul limbii de pe televizor"
msgstr "<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: wijzigt de menutaal en slaat deze op, zoals OK in het taalscherm op de tv"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>/api/limbi</code>; <code>tradu_orice</code> = „Tradu automat din orice subtitrare disponibilă”, contează cu traducerea subtitrărilor pornită) și le aplică pe canalul de acum"
msgstr "<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</code>: wijzigt en slaat elk ervan op (de exacte waarden staan in <code>/api/limbi</code>; <code>tradu_orice</code> = “Automatisch vertalen vanuit elke beschikbare ondertitel”, telt mee als de vertaling van ondertitels aan staat) en past ze toe op de huidige zender"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /api/limbi-uita-toate?confirmat=1</code>: uită alegerile de mână ale unui canal sau ale tuturor"
msgstr "<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /api/limbi-uita-toate?confirmat=1</code>: vergeet de handmatige keuzes van een zender of van alle zenders"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-aplica</code>: aplică planul văzut (<code>semn=</code>), verifică semnalul și așteaptă răspunsul 60 de secunde"
msgstr "<code>POST /api/lnb-aplica</code>: past het getoonde plan toe (<code>semn=</code>), controleert het signaal en wacht 60 seconden op antwoord"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-plan</code>: ce s-ar schimba pentru câmpurile trimise (<code>l_&lt;lnb&gt;_&lt;câmp&gt;</code>), sau pentru „Ce era înainte” cu <code>fel=inainte</code>; nu scrie nimic"
msgstr "<code>POST /api/lnb-plan</code>: wat er zou veranderen voor de verzonden velden (<code>l_&lt;lnb&gt;_&lt;câmp&gt;</code>), of voor “Wat er eerder was” met <code>fel=inainte</code>; schrijft niets"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code>: răspunsul la „Păstrezi noile setări?”"
msgstr "<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code>: het antwoord op “Behoud je de nieuwe instellingen?”"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</code>: locul antenei aflat după adresa de internet a receptorului, de serverul HD Satelit, numai la cerere și numai din browserul conectat; se scrie abia după confirmare, cu <code>POST /api/locul-seteaza</code> și <code>internet=&lt;semn&gt;</code>"
msgstr "<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</code>: de locatie van de schotel, bepaald aan de hand van het internetadres van de ontvanger door de HD Satelit-server, alleen op verzoek en alleen vanuit de verbonden browser; wordt pas na bevestiging opgeslagen, met <code>POST /api/locul-seteaza</code> en <code>internet=&lt;semn&gt;</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/locul-seteaza</code>: locul antenei din tabel (<code>tara</code>, <code>oras</code>) sau scris (<code>lat</code>, <code>lon</code>, grade, nord și est pozitive)"
msgstr "<code>POST /api/locul-seteaza</code>: de locatie van de schotel uit de tabel (<code>tara</code>, <code>oras</code>) of ingevoerd (<code>lat</code>, <code>lon</code>, graden, noord en oost positief)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: deschide pe televizor ecranul unei intrări (nu oprirea sau repornirea)"
msgstr "<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: opent op de tv het scherm van een item (niet uitschakelen of herstarten)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code>: pas, mișcare fără oprire, poziții memorate, mergi la satelit, limite, oprire"
msgstr "<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code>: stap, beweging zonder stoppen, opgeslagen posities, naar satelliet gaan, limieten, stoppen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-inchide</code>: navigatorul pe televizor"
msgstr "<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-inchide</code>: de browser op de tv"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/navigator-text</code>: text trimis în câmpul ales pe televizor; numai din browserul asociat, cu textul în corpul cererii (cu <code>?token=</code> se refuză)"
msgstr "<code>POST /api/navigator-text</code>: tekst verzonden naar het gekozen veld op de tv; alleen vanuit de gekoppelde browser, met de tekst in de body van het verzoek (met <code>?token=</code> wordt het geweigerd)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: descarcă modelul unei limbi (pe stick sau disc; în memoria internă numai cu intern=1)"
msgstr "<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: downloadt het model van een taal (op stick of schijf; in het interne geheugen alleen met intern=1)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-intreaba</code>: receptorul întreabă din nou pentru limbile cu \"Nu mai întreba\""
msgstr "<code>POST /api/ocr-limbi-intreaba</code>: de ontvanger vraagt opnieuw voor de talen met “Niet meer vragen”"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-opreste?model=slk</code>: oprește descărcarea"
msgstr "<code>POST /api/ocr-limbi-opreste?model=slk</code>: stopt het downloaden"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-sterge?model=slk</code>: șterge un model descărcat (sau îl scoate din listă când stickul lui nu e pus)"
msgstr "<code>POST /api/ocr-limbi-sterge?model=slk</code>: verwijdert een gedownload model (of haalt het uit de lijst als de bijbehorende stick niet is aangesloten)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</code>: repornirea interfeței când nu mai răspunde și așteptarea dinaintea ei"
msgstr "<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</code>: het herstarten van de interface wanneer die niet meer reageert en de wachttijd daarvoor"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/procesor-seteaza?mod=automat|racoros|normal|performanta</code>: salvează modul și îl aplică pe loc"
msgstr "<code>POST /api/procesor-seteaza?mod=automat|racoros|normal|performanta</code>: slaat de modus op en past die meteen toe"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=..&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</code>: setările ecranului radio"
msgstr "<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=..&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</code>: de instellingen van het radioscherm"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: vizualizarea sau culorile următoare (ca tastele galbenă și albastră pe ecranul radio)"
msgstr "<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: de volgende visualisatie of kleuren (zoals de gele en blauwe toets op het radioscherm)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-fluxuri</code>: alegerea de la sfârșitul scanării DAB+ / DVB-T2 de pe televizor (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"
msgstr "<code>POST /api/scanare-fluxuri</code>: de keuze aan het einde van het zoeken naar DAB+ / DVB-T2 op de tv (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-opreste</code>: oprește căutarea sau închide rezultatul rămas pe televizor"
msgstr "<code>POST /api/scanare-opreste</code>: stopt het zoeken of sluit het resultaat dat op de tv is blijven staan"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;&amp;...</code>: pornește căutarea pe televizor (cu <code>confirmat=1</code> după o întrebare)"
msgstr "<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;&amp;...</code>: start het zoeken op de tv (met <code>confirmat=1</code> na een vraag)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: deschide pe televizor ecranul unei intrări din cele două secțiuni"
msgstr "<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: opent op de tv het scherm van een item uit de twee secties"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/setari-din-copie-reporneste</code>: repornește interfața, ca setările importate să se unească"
msgstr "<code>POST /api/setari-din-copie-reporneste</code>: herstart de interface, zodat de geïmporteerde instellingen worden samengevoegd"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/setari-seteaza?id=&lt;cheie&gt;&amp;r&lt;N&gt;=&lt;valoare&gt;</code>: schimbă și salvează rândurile trimise (o valoare greșită nu schimbă nimic; la o alegere multiplă, ca vitezele de derulare, alegerile despărțite prin virgulă, de pildă <code>r20=2,8,16</code>; gol = nicio alegere)"
msgstr "<code>POST /api/setari-seteaza?id=&lt;cheie&gt;&amp;r&lt;N&gt;=&lt;valoare&gt;</code>: wijzigt de verzonden rijen en slaat ze op (een foute waarde verandert niets; bij een meervoudige keuze, zoals de scrollsnelheden, de keuzes gescheiden door komma's, bijvoorbeeld <code>r20=2,8,16</code>; leeg = geen keuze)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/stocare-foloseste?punct=/media/usb</code>: folosește discul pentru înregistrări (face dosarul movie, fără formatare)"
msgstr "<code>POST /api/stocare-foloseste?punct=/media/usb</code>: gebruikt de schijf voor opnames (maakt de map movie aan, zonder formatteren)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-aspect-implicite</code>: toate înapoi la valorile de la început"
msgstr "<code>POST /api/subtitrari-aspect-implicite</code>: alles terug naar de beginwaarden"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-aspect-seteaza?stil_font=&lt;skin|ingust|tiresias_info|tiresias_pc|google:Alias&gt;&amp;grosime=&lt;automata|normala|ingrosata|foarte_ingrosata&gt;&amp;marime=&lt;60..200&gt;&amp;culoare=&lt;emisiune|%23rrggbb&gt;&amp;contur=&lt;fara|subtire|normal|gros|foarte_gros&gt;&amp;culoare_contur=&lt;%23rrggbb&gt;&amp;umbra=0|1&amp;culoare_umbra=&lt;%23rrggbb&gt;&amp;directie_umbra=&lt;sus|sus_dreapta|dreapta|jos_dreapta|jos|jos_stanga|stanga|sus_stanga&gt;&amp;distanta_umbra=&lt;50|100|150|200|300&gt;&amp;umbra_moale=&lt;tare|moale|foarte_moale&gt;&amp;fundal=&lt;niciunul|rand|cutie&gt;&amp;culoare_fundal=&lt;%23rrggbb&gt;&amp;opacitate_fundal=&lt;10..100&gt;&amp;jos=&lt;2..25&gt;&amp;spatiere=&lt;80|90|100|110|125|150&gt;&amp;marire_dvb=&lt;clara|ocr&gt;</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>alegeri</code>; o valoare greșită nu schimbă nimic); sau <code>stil=&lt;cheie&gt;</code>, un stil gata făcut"
msgstr "<code>POST /api/subtitrari-aspect-seteaza?stil_font=&lt;skin|ingust|tiresias_info|tiresias_pc|google:Alias&gt;&amp;grosime=&lt;automata|normala|ingrosata|foarte_ingrosata&gt;&amp;marime=&lt;60..200&gt;&amp;culoare=&lt;emisiune|%23rrggbb&gt;&amp;contur=&lt;fara|subtire|normal|gros|foarte_gros&gt;&amp;culoare_contur=&lt;%23rrggbb&gt;&amp;umbra=0|1&amp;culoare_umbra=&lt;%23rrggbb&gt;&amp;directie_umbra=&lt;sus|sus_dreapta|dreapta|jos_dreapta|jos|jos_stanga|stanga|sus_stanga&gt;&amp;distanta_umbra=&lt;50|100|150|200|300&gt;&amp;umbra_moale=&lt;tare|moale|foarte_moale&gt;&amp;fundal=&lt;niciunul|rand|cutie&gt;&amp;culoare_fundal=&lt;%23rrggbb&gt;&amp;opacitate_fundal=&lt;10..100&gt;&amp;jos=&lt;2..25&gt;&amp;spatiere=&lt;80|90|100|110|125|150&gt;&amp;marire_dvb=&lt;clara|ocr&gt;</code>: wijzigt en slaat elk ervan op (de exacte waarden staan in <code>alegeri</code>; een foute waarde verandert niets); of <code>stil=&lt;cheie&gt;</code>, een kant-en-klare stijl"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-film-alege?id=&lt;id&gt;|oprit</code>, <code>POST /api/subtitrari-film-intarziere?ms=N</code> (sau <code>pas=</code>), <code>POST /api/subtitrari-film-codare?cod=..</code>, <code>POST /api/subtitrari-film-fps?fps=..</code>: aceleași alegeri ca tasta SUB la un film din fișier"
msgstr "<code>POST /api/subtitrari-film-alege?id=&lt;id&gt;|oprit</code>, <code>POST /api/subtitrari-film-intarziere?ms=N</code> (of <code>pas=</code>), <code>POST /api/subtitrari-film-codare?cod=..</code>, <code>POST /api/subtitrari-film-fps?fps=..</code>: dezelfde keuzes als de SUB-toets bij een film uit een bestand"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-ocr-zero</code>: contorul recunoașterii textului pus la zero"
msgstr "<code>POST /api/subtitrari-ocr-zero</code>: de teller van de tekstherkenning op nul gezet"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/sunet-seteaza?iesire=&lt;auto|manual&gt;&amp;ac3=&lt;da|nu&gt;&amp;dts=&lt;da|nu&gt;&amp;pista=&lt;da|nu&gt;</code>: oricare dintre ele, salvate; ac3 / dts sunt setările pentru Manual"
msgstr "<code>POST /api/sunet-seteaza?iesire=&lt;auto|manual&gt;&amp;ac3=&lt;da|nu&gt;&amp;dts=&lt;da|nu&gt;&amp;pista=&lt;da|nu&gt;</code>: elk ervan, opgeslagen; ac3 / dts zijn de instellingen voor Manual"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-asociere?pas=inapoi|sari|gata|continua|anuleaza|proba|inchide&amp;pastreaza=0|1</code>: pașii asocierii unei telecomenzi noi"
msgstr "<code>POST /api/telecomenzi-asociere?pas=inapoi|sari|gata|continua|anuleaza|proba|inchide&amp;pastreaza=0|1</code>: de stappen voor het koppelen van een nieuwe afstandsbediening"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|oprit</code>: pornește sau oprește captura paginii (cititorul și proba numai ascultă, cel mult 2 minute)"
msgstr "<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|oprit</code>: start of stopt het vastleggen door de pagina (de lezer en de test luisteren alleen, maximaal 2 minuten)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-schimba?actiune=activa|neasociate|redenumeste|sterge-tasta|sterge|sterge-tot&amp;id=..&amp;cod=..&amp;nume=..&amp;confirmat=1</code>: aceleași schimbări ca în lista de pe televizor"
msgstr "<code>POST /api/telecomenzi-schimba?actiune=activa|neasociate|redenumeste|sterge-tasta|sterge|sterge-tot&amp;id=..&amp;cod=..&amp;nume=..&amp;confirmat=1</code>: dezelfde wijzigingen als in de lijst op de tv"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/teletext-salveaza</code>, <code>POST /api/teletext-sterge?ref=</code>, <code>POST /api/teletext-reimprospateaza?ref=</code> (receptorul trece pe canal, așteaptă o trecere completă a teletextului, face copia și se întoarce la canalul de dinainte; răspunde pe loc), <code>POST /api/teletext-setari?hd=0|1&amp;contur=0|1&amp;umbra=0|1&amp;relief=0|1&amp;copie_automata=0|1&amp;spatiu=5|10|20|50|100</code> (<code>hd</code> = Teletext neted): aceleași alegeri ca meniul teletextului de pe televizor"
msgstr "<code>POST /api/teletext-salveaza</code>, <code>POST /api/teletext-sterge?ref=</code>, <code>POST /api/teletext-reimprospateaza?ref=</code> (de ontvanger schakelt naar de zender, wacht op een volledige doorloop van de teletekst, maakt de kopie en keert terug naar de vorige zender; antwoordt meteen), <code>POST /api/teletext-setari?hd=0|1&amp;contur=0|1&amp;umbra=0|1&amp;relief=0|1&amp;copie_automata=0|1&amp;spatiu=5|10|20|50|100</code> (<code>hd</code> = Gladde teletekst): dezelfde keuzes als het teletekstmenu op de tv"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-adauga?ref=&lt;canal&gt;&amp;zi=AAAA-LL-ZZ&amp;inceput=HH:MM&amp;sfarsit=HH:MM&amp;nume=..&amp;doar_comuta=0|1</code>: pune o înregistrare (sau doar schimbarea canalului); la suprapunere nu pune nimic și spune cu ce se suprapune"
msgstr "<code>POST /api/temporizatoare-adauga?ref=&lt;canal&gt;&amp;zi=AAAA-LL-ZZ&amp;inceput=HH:MM&amp;sfarsit=HH:MM&amp;nume=..&amp;doar_comuta=0|1</code>: stelt een opname in (of alleen het wisselen van zender); bij overlapping stelt het niets in en zegt waarmee het overlapt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-modifica?id=..&amp;zi=..&amp;inceput=..&amp;sfarsit=..&amp;repetare=o_data|zilnic|luni_vineri|zile&amp;zile=0,1,..&amp;dupa=nimic|asteptare|oprire|automat&amp;loc=..</code>: aceleași câmpuri ca fereastra de pe televizor, cu aceeași verificare a suprapunerii; <code>POST /api/temporizatoare-opreste?id=..&amp;alegere=stoponlycurrent|stopall|stoponlycoming</code>: una repetată care merge acum"
msgstr "<code>POST /api/temporizatoare-modifica?id=..&amp;zi=..&amp;inceput=..&amp;sfarsit=..&amp;repetare=o_data|zilnic|luni_vineri|zile&amp;zile=0,1,..&amp;dupa=nimic|asteptare|oprire|automat&amp;loc=..</code>: dezelfde velden als het venster op de tv, met dezelfde controle op overlapping; <code>POST /api/temporizatoare-opreste?id=..&amp;alegere=stoponlycurrent|stopall|stoponlycoming</code>: een herhaalde die nu loopt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, <code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, <code>POST /api/temporizatoare-curata?confirmat=1</code>: șterge una, o oprește sau o pornește din nou, șterge cele terminate"
msgstr "<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, <code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, <code>POST /api/temporizatoare-curata?confirmat=1</code>: verwijdert er een, schakelt er een uit of weer in, verwijdert de voltooide"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-cauta</code>: caută în rețeaua de acasă serverele Ollama (11434) și LibreTranslate (5000); rezultatul vine în <code>cautare</code>"
msgstr "<code>POST /api/traducere-configurare-cauta</code>: zoekt in het thuisnetwerk naar Ollama-servers (11434) en LibreTranslate-servers (5000); het resultaat komt in <code>cautare</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-cheie</code>, corpul <code>cheie=&lt;cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: probează cheia pe loc și, dacă merge, o salvează și pornește traducerea; numai în corpul cererii, niciodată în adresă; rezultatul vine în <code>configurare</code> din <code>GET /api/traducere-configurare</code>"
msgstr "<code>POST /api/traducere-configurare-cheie</code>, body <code>cheie=&lt;cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: test de sleutel meteen en, als het werkt, slaat hem op en start de vertaling; alleen in de body van het verzoek, nooit in het adres; het resultaat komt in <code>configurare</code> van <code>GET /api/traducere-configurare</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-model?model=..</code>: alt model pentru serviciul ales acum, cu probă"
msgstr "<code>POST /api/traducere-configurare-model?model=..</code>: ander model voor de nu gekozen dienst, met test"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;&amp;adresa=..&amp;model=..</code>: folosește serverul din casă (adresa completată de receptor, modelul ales singur dacă lipsește) și îl probează"
msgstr "<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;&amp;adresa=..&amp;model=..</code>: gebruikt de server thuis (adres ingevuld door de ontvanger, model zelf gekozen als het ontbreekt) en test hem"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-cheie</code>, corpul <code>serviciu=&lt;cod&gt;&amp;cheie=&lt;cheia&gt;</code>: pune cheia unui serviciu (goală = o șterge); la <code>serviciu=propriu</code> cheia este valoarea antetului adresei proprii (de exemplu <code>Bearer</code> și cheia); numai în corpul cererii, niciodată în adresă; răspunsul spune doar care serviciu are cheie"
msgstr "<code>POST /api/traducere-subtitrari-cheie</code>, body <code>serviciu=&lt;cod&gt;&amp;cheie=&lt;cheia&gt;</code>: stelt de sleutel van een dienst in (leeg = verwijdert hem); bij <code>serviciu=propriu</code> is de sleutel de waarde van de header van het eigen adres (bijvoorbeeld <code>Bearer</code> en de sleutel); alleen in de body van het verzoek, nooit in het adres; het antwoord zegt alleen welke dienst een sleutel heeft"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-proba</code>: probează traducerea cu serviciul ales; rezultatul vine în <code>stare.proba</code> din <code>GET /api/traducere-subtitrari</code>"
msgstr "<code>POST /api/traducere-subtitrari-proba</code>: test de vertaling met de gekozen dienst; het resultaat komt in <code>stare.proba</code> van <code>GET /api/traducere-subtitrari</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=..&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;propriu_cale=..</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>alegeri</code>); o valoare greșită refuză tot. Adresa proprie: adresa e un șablon cu <code>{text}</code>, <code>{sursa}</code>, <code>{tinta}</code> (http:// numai pentru un server din rețeaua de acasă); adresa receptorului însuși (127.0.0.1, localhost, IP-ul lui) e refuzată, și la <code>adresa_libre</code> și <code>adresa_openai</code>; calea în JSON are chei și numere despărțite prin punct, <code>*</code> = toate elementele"
msgstr "<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=..&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;propriu_cale=..</code>: wijzigt en slaat elk ervan op (de exacte waarden staan in <code>alegeri</code>); één foute waarde weigert alles. Eigen adres: het adres is een sjabloon met <code>{text}</code>, <code>{sursa}</code>, <code>{tinta}</code> (http:// alleen voor een server in het thuisnetwerk); het adres van de ontvanger zelf (127.0.0.1, localhost, zijn IP) wordt geweigerd, ook bij <code>adresa_libre</code> en <code>adresa_openai</code>; het pad in JSON heeft sleutels en getallen gescheiden door een punt, <code>*</code> = alle elementen"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-zero</code>: contorul traducerii pus la zero"
msgstr "<code>POST /api/traducere-subtitrari-zero</code>: vertaalteller op nul gezet"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: fluxul TS al transmisiei acestui browser. Pornirea și fluxul merg numai din browserul conectat, cu antetul <code>X-HDS-CSRF</code>, niciodată cu <code>?token=</code>"
msgstr "<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: de TS-stroom van de uitzending van deze browser. Starten en de stroom werken alleen vanuit de verbonden browser, met de header <code>X-HDS-CSRF</code>, nooit met <code>?token=</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-confirma</code> și <code>POST /api/video-revino</code>: păstrează modul încercat sau revine la cel de dinainte"
msgstr "<code>POST /api/video-confirma</code> en <code>POST /api/video-revino</code>: behoudt de geprobeerde modus of keert terug naar de vorige"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-reporneste</code>: repornește receptorul (culorile „Ca la calculator” se aplică numai după o repornire); cu o înregistrare în curs, întrebarea apare pe televizor"
msgstr "<code>POST /api/video-reporneste</code>: herstart de ontvanger (de kleuren “Zoals op de computer” worden pas na een herstart toegepast); met een lopende opname verschijnt de vraag op de tv"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=..&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;ycbcr|rgb&gt;</code>: un mod nou se încearcă (aceeași întrebare pe televizor, 20 s, fără răspuns revine); zapmode se salvează direct; culori_hdmi=ycbcr se încearcă la fel (aceeași întrebare), rgb se salvează și se aplică după o repornire"
msgstr "<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=..&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;ycbcr|rgb&gt;</code>: een nieuwe modus wordt geprobeerd (dezelfde vraag op de tv, 20 s, zonder antwoord keert hij terug); zapmode wordt direct opgeslagen; culori_hdmi=ycbcr wordt op dezelfde manier geprobeerd (dezelfde vraag), rgb wordt opgeslagen en na een herstart toegepast"

