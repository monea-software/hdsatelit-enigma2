msgstr "Kaldır: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Serviciile de rezervă: când serviciul principal nu răspunde, receptorul "
"trece singur la următorul din listă."
msgstr "Yedek hizmetler: ana hizmet yanıt vermediğinde alıcı kendiliğinden listedeki bir sonrakine geçer."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Căutarea nu e în această imagine."
msgstr "Arama bu imajda yok."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Se caută în rețeaua de acasă..."
msgstr "Ev ağında aranıyor..."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Nu am găsit niciun server în rețeaua de acasă."
msgstr "Ev ağında hiçbir sunucu bulunamadı."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Ollama la %s, modelul %s"
msgstr "Ollama: %s, model %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "LibreTranslate la %s"
msgstr "LibreTranslate: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Am găsit %d. Alege serverul."
msgstr "Bulunan: %d. Sunucuyu seç."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Se probează serverul..."
msgstr "Sunucu deneniyor..."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Se caută în rețeaua de acasă... %d din %d"
msgstr "Ev ağında aranıyor... %d / %d"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Fără limită, mai lent pe calculatoarele obișnuite"
msgstr "Sınırsız, sıradan bilgisayarlarda daha yavaş"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Recomandat pentru subtitrări zilnice"
msgstr "Günlük altyazılar için önerilir"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cel mai simplu de pornit, fără card; se poate opri dacă te uiți mult"
msgstr "Başlatması en kolay, kart gerekmez; çok izlersen durabilir"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Formular"
msgstr "Form"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Text simplu"
msgstr "Düz metin"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Lista serviciilor de rezervă nu e bună (un serviciu necunoscut, unul de două "
"ori sau chiar cel principal). Nu s-a schimbat nimic."
msgstr "Yedek hizmetler listesi geçerli değil (bilinmeyen bir hizmet, iki kez yazılmış bir hizmet ya da ana hizmetin kendisi). Hiçbir şey değiştirilmedi."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Adresă proprie"
msgstr "Kendi adresin"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid "locul {text} în adresă (sau, la POST, în corp)"
msgstr "adresteki {text} yer tutucusu (ya da POST ile gövdede)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"o adresă https:// (http:// merge numai pentru un server din rețeaua de acasă)"
msgstr "bir https:// adresi (http:// yalnızca ev ağındaki bir sunucu için çalışır)"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"un corp JSON bun (pune locurile între ghilimele, de exemplu \"q\": "
"\"{text}\")"
msgstr "geçerli bir JSON gövdesi (yer tutucuları tırnak içine al, örneğin \"q\": \"{text}\")"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "un nume de antet bun (litere, cifre și - _ ., de exemplu Authorization)"
msgstr "geçerli bir başlık adı (harfler, rakamlar ve - _ ., örneğin Authorization)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"calea traducerii în răspunsul JSON (chei și numere despărțite prin punct, de "
"exemplu translatedText)"
msgstr "JSON yanıtında çevirinin yolu (noktayla ayrılmış anahtarlar ve sayılar, örneğin translatedText)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Lipsește regiunea resursei Azure: o găsești în portal, la resursa "
"Translator, Overview › Location (de exemplu Germany West Central = "
"germanywestcentral)."
msgstr "Azure kaynağının bölgesi eksik: onu portalda, Translator kaynağında, Overview › Location altında bulursun (örneğin Germany West Central = germanywestcentral)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Cheia sau regiunea nu se potrivesc: verifică amândouă în portal (Keys and "
"Endpoint)."
msgstr "Anahtar ile bölge uyuşmuyor: ikisini de portalda kontrol et (Keys and Endpoint)."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Serverul de la adresa ta a răspuns cu eroarea HTTP %d. Începutul "
"răspunsului: „%s”"
msgstr "Adresindeki sunucu HTTP %d hatasıyla yanıt verdi. Yanıtın başı: “%s”"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Răspunsul serverului nu e JSON (dacă serverul dă numai traducerea, alege "
"„Text simplu” la răspuns). Începutul răspunsului: „%s”"
msgstr "Sunucunun yanıtı JSON değil (sunucu yalnızca çeviriyi veriyorsa yanıt için “Düz metin” seç). Yanıtın başı: “%s”"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Calea „%s” nu găsește nicio traducere în răspunsul serverului. Începutul "
"răspunsului: „%s”"
msgstr "“%s” yolu sunucunun yanıtında hiçbir çeviri bulamıyor. Yanıtın başı: “%s”"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Serverul nu a dat nicio traducere. Începutul răspunsului: „%s”"
msgstr "Sunucu hiçbir çeviri vermedi. Yanıtın başı: “%s”"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Traducerea subtitrărilor vine prea târziu: serverul răspunde în %s, în "
"medie. Alege un serviciu din internet (Gemini, gratuit, fără card) sau un "
"model mai mic."
msgstr "Altyazı çevirisi çok geç geliyor: sunucu ortalama %s içinde yanıt veriyor. İnternetten bir hizmet (Gemini, ücretsiz, kart gerekmez) veya daha küçük bir model seç."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "%s a ajuns la limita gratuită pe zi (sau pe lună)."
msgstr "%s günlük (veya aylık) ücretsiz sınıra ulaştı."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Traducerea s-a oprit până se reînnoiește limita. Ca să meargă și atunci, "
"pune servicii de rezervă în Meniu › Setări › Sunet și subtitrări › "
"Traducerea subtitrărilor."
msgstr "Çeviri, sınır yenilenene kadar durdu. O zaman da çalışması için yedek hizmetleri Menü › Ayarlar › Ses ve Ses Parçaları › Altyazı çevirisi bölümüne koy."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"De exemplu Azure Translator: Free F0, 2.000.000 de caractere pe lună, "
"gratuit."
msgstr "Örneğin Azure Translator: Free F0, ayda 2.000.000 karakter, ücretsiz."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Traducerea subtitrărilor s-a oprit până schimbi setările: %s"
msgstr "Altyazı çevirisi, sen ayarları değiştirene kadar durdu: %s"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Am găsit regiunea: %s (%s)."
msgstr "Bölge bulundu: %s (%s)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Cel mai simplu: pornește serverul pe calculator (pașii de mai jos), apoi "
"apasă „Caută în rețeaua de acasă”, pe televizor sau pe telefon. Receptorul "
"găsește singur serverul; nu mai trebuie să scrii adresa."
msgstr "En basiti: sunucuyu bilgisayarda başlat (aşağıdaki adımlar), sonra televizyonda veya telefonda “Ev ağında ara” düğmesine bas. Alıcı sunucuyu kendisi bulur; adresi yazman artık gerekmez."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Prima dată, Windows poate întreba dacă lași programul să primească conexiuni "
"din rețea: apasă „Allow access”. Dacă receptorul tot nu găsește serverul: "
"Windows Security, Firewall & network protection, „Allow an app through "
"firewall”, „Change settings” și bifează programul (Ollama, LM Studio sau "
"Docker) la „Private”. Rețeaua de acasă trebuie să fie „Private network” "
"(Settings, Network & internet, rețeaua ta, „Network profile type”)."
msgstr "İlk seferde Windows, programın ağdan bağlantı almasına izin verip vermediğini sorabilir: “Allow access” düğmesine bas. Alıcı sunucuyu hâlâ bulamıyorsa: Windows Security, Firewall & network protection, “Allow an app through firewall”, “Change settings” ve programı (Ollama, LM Studio veya Docker) “Private” altında işaretle. Ev ağı “Private network” olmalı (Settings, Network & internet, ağın, “Network profile type”)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"2.000.000 de caractere pe lună, gratuit (Free F0). E alegerea recomandată "
"pentru subtitrări multe (filme întregi, în fiecare zi), ca serviciu "
"principal sau de rezervă. Cardul se cere la înscriere numai pentru "
"verificare; pe Free F0 nu se plătește nimic. După 30 de zile contul trebuie "
"trecut pe „Pay as you go”, tot fără cost cât resursa rămâne Free F0."
msgstr "Ayda 2.000.000 karakter, ücretsiz (Free F0). Çok altyazı için (bütün filmler, her gün), ana veya yedek hizmet olarak önerilen seçimdir. Kart kayıtta yalnızca doğrulama için istenir; Free F0'da hiçbir şey ödenmez. 30 gün sonra hesap “Pay as you go” planına geçirilmelidir; kaynak Free F0 kaldığı sürece yine ücretsizdir."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Pentru subtitrări multe (filme întregi, în fiecare zi) pune în setări și "
"servicii de rezervă, de exemplu Azure Translator: când Gemini dă eroarea "
"429, receptorul trece singur la următorul. Lista se face din servicii "
"diferite: limita Gemini e pe proiect, iar mai multe conturi făcute ca să "
"aduni limitele gratuite înseamnă ocolirea limitelor, pe care termenii Google "
"o interzic."
msgstr "Çok altyazı için (bütün filmler, her gün) ayarlara yedek hizmetler de koy, örneğin Azure Translator: Gemini 429 hatası verdiğinde alıcı kendiliğinden bir sonrakine geçer. Liste farklı hizmetlerden oluşur: Gemini sınırı proje başınadır ve ücretsiz sınırları toplamak için açılan birden çok hesap, sınırları aşmak demektir; Google'ın koşulları bunu yasaklar."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Gratuit pentru folosire ocazională, cu un număr limitat de cereri pe minut "
"și pe zi; Google arată cifrele numai în contul tău. La subtitrări fără pauză "
"poate da eroarea 429 după câteva minute, iar limita pe zi se poate termina."
msgstr "Ara sıra kullanım için ücretsiz, dakika ve gün başına sınırlı sayıda istekle; Google rakamları yalnızca senin hesabında gösterir. Aralıksız altyazılarda birkaç dakika sonra 429 hatası verebilir ve günlük sınır bitebilir."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Peste limita pe minut, cererile primesc eroarea 429 câteva secunde: "
"receptorul așteaptă cât spune Google și trece între timp la serviciul de "
"rezervă, dacă ai pus unul. Peste limita pe zi, până a doua zi (în jurul orei "
"10, ora României). Fără card nu se plătește nimic."
msgstr "Dakikalık sınırın üstünde istekler birkaç saniye 429 hatası alır: alıcı Google'ın söylediği kadar bekler ve bu arada, koyduysan, yedek hizmete geçer. Günlük sınırın üstünde ertesi güne kadar (Romanya saatiyle 10 civarında). Kart olmadan hiçbir şey ödenmez."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În casă: instalează Ollama de pe ollama.com pe un calculator și pornește-l."
msgstr "Evde: ollama.com'dan Ollama'yı bir bilgisayara kur ve başlat."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În PowerShell scrie: ollama pull gemma3:4b (3,3 GB). gemma3:12b traduce mai "
"bine, dar e mai lent (8,1 GB); pentru un calculator slab, gemma3:1b (815 "
"MB). Modelele qwen2.5 traduc slab în română."
msgstr "PowerShell'de şunu yaz: ollama pull gemma3:4b (3,3 GB). gemma3:12b daha iyi çevirir ama daha yavaştır (8,1 GB); zayıf bir bilgisayar için gemma3:1b (815 MB). qwen2.5 modelleri Rumenceye kötü çevirir."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Ca să-l vadă receptorul: deschide Ollama, intră în Settings și pornește "
"„Expose Ollama to the network” (Ollama 0.9.5 sau mai nou; numele poate fi "
"puțin altul). Dacă nu găsești setarea: închide Ollama de lângă ceas "
"(„Quit”), caută în Start „environment variables” („variabile de mediu”), "
"adaugă la contul tău OLLAMA_HOST cu valoarea 0.0.0.0:11434, apasă OK și "
"pornește din nou Ollama."
msgstr "Alıcının görebilmesi için: Ollama'yı aç, Settings'e gir ve “Expose Ollama to the network” seçeneğini aç (Ollama 0.9.5 veya daha yeni; adı biraz farklı olabilir). Ayarı bulamazsan: saatin yanındaki Ollama'yı kapat (“Quit”), Başlat'ta “environment variables” (“ortam değişkenleri”) ara, hesabına 0.0.0.0:11434 değeriyle OLLAMA_HOST ekle, OK düğmesine bas ve Ollama'yı yeniden başlat."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Fără căutare: scrie aici adresa http://IP-UL-CALCULATORULUI:11434 și modelul "
"gemma3:4b. Cheie nu trebuie."
msgstr "Arama olmadan: buraya http://BİLGİSAYAR-IP:11434 adresini ve gemma3:4b modelini yaz. Anahtar gerekmez."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"LM Studio merge la fel: fila „Developer”, „Start server”, apoi în setările "
"serverului „Serve on Local Network”, cu „Require Authentication” oprit; "
"adresa http://IP-UL-CALCULATORULUI:1234 și numele modelului din LM Studio."
msgstr "LM Studio da aynı şekilde çalışır: “Developer” sekmesi, “Start server”, sonra sunucu ayarlarında “Serve on Local Network”, “Require Authentication” kapalı; adres http://BİLGİSAYAR-IP:1234 ve LM Studio'daki model adı."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"„Adresă proprie” e pentru un server de traducere ales de tine, de exemplu un "
"LibreTranslate pornit pe un calculator din casă. Receptorul trimite fiecare "
"rând de subtitrare într-o cerere separată."
msgstr "“Kendi adresin”, senin seçtiğin bir çeviri sunucusu içindir, örneğin evdeki bir bilgisayarda çalışan bir LibreTranslate. Alıcı her altyazı satırını ayrı bir istekte gönderir."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Adresa e un șablon: scrii adresa serverului și pui în ea locurile {text} "
"(textul de tradus), {sursa} (limba subtitrării, sau auto când nu se știe) și "
"{tinta} (limba traducerii, de exemplu ro). Receptorul le înlocuiește la "
"fiecare cerere."
msgstr "Adres bir şablondur: sunucunun adresini yazar ve içine {text} (çevrilecek metin), {sursa} (altyazının dili ya da bilinmiyorsa auto) ve {tinta} (çevirinin dili, örneğin ro) yer tutucularını koyarsın. Alıcı bunları her istekte değiştirir."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Adresa începe cu https://. O adresă http:// merge numai pentru un server din "
"rețeaua de acasă (de exemplu 192.168.1.50). Nume și parolă nu se scriu în "
"adresă."
msgstr "Adres https:// ile başlar. Bir http:// adresi yalnızca ev ağındaki bir sunucu için çalışır (örneğin 192.168.1.50). Kullanıcı adı ve parola adrese yazılmaz."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Metoda GET trimite totul în adresă, deci {text} trebuie să fie în adresă. "
"Metoda POST trimite și un corp, cu aceleași locuri: JSON (pune locurile "
"între ghilimele, de exemplu \"q\": \"{text}\") sau formular (de exemplu "
"q={text}&target={tinta})."
msgstr "GET yöntemi her şeyi adreste gönderir, bu yüzden {text} adreste olmalı. POST yöntemi aynı yer tutucularla bir gövde de gönderir: JSON (yer tutucuları tırnak içine al, örneğin \"q\": \"{text}\") veya form (örneğin q={text}&target={tinta})."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Antetul e opțional: dacă serverul cere o cheie, scrie numele antetului (de "
"exemplu Authorization) și, la valoare, ce cere serverul (de exemplu Bearer, "
"un spațiu și cheia). Valoarea se păstrează criptată pe receptor și nu se mai "
"arată."
msgstr "Başlık isteğe bağlıdır: sunucu bir anahtar istiyorsa başlığın adını (örneğin Authorization) ve değer olarak sunucunun istediğini (örneğin Bearer, bir boşluk ve anahtar) yaz. Değer alıcıda şifreli olarak saklanır ve bir daha gösterilmez."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Răspunsul: alege „Text simplu” dacă serverul dă numai traducerea. Pentru "
"JSON scrie calea până la traducere: numele cheilor și numerele pozițiilor "
"(de la 0), despărțite prin punct, de exemplu translatedText sau "
"data.translations.0.translatedText. Cu * iei toate elementele, lipite în "
"ordine, de exemplu 0.*.0."
msgstr "Yanıt: sunucu yalnızca çeviriyi veriyorsa “Düz metin” seç. JSON için çeviriye giden yolu yaz: anahtarların adları ve konumların numaraları (0'dan başlayarak), noktayla ayrılmış, örneğin translatedText veya data.translations.0.translatedText. * ile tüm öğeleri alırsın, sırayla birleştirilmiş, örneğin 0.*.0."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Exemplu, un LibreTranslate al tău din casă: adresa "
"http://192.168.1.50:5000/translate, metoda POST, corpul JSON {\"q\": "
"\"{text}\", \"source\": \"{sursa}\", \"target\": \"{tinta}\", \"format\": "
"\"text\"}, răspunsul JSON, calea translatedText."
msgstr "Örnek, evdeki kendi LibreTranslate'in: adres http://192.168.1.50:5000/translate, yöntem POST, JSON gövdesi {\"q\": \"{text}\", \"source\": \"{sursa}\", \"target\": \"{tinta}\", \"format\": \"text\"}, yanıt JSON, yol translatedText."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Exemplu cu GET: adresa "
"https://example.com/translate?q={text}&from={sursa}&to={tinta} și răspunsul "
"„Text simplu” (example.com ține locul serverului tău)."
msgstr "GET ile örnek: adres https://example.com/translate?q={text}&from={sursa}&to={tinta} ve yanıt “Düz metin” (example.com senin sunucunun yerini tutar)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Apasă „Probează traducerea”. Dacă nu merge, mesajul arată începutul "
"răspunsului serverului, ca să vezi unde e traducerea și ce cale să scrii."
msgstr "“Çeviriyi dene” düğmesine bas. Çalışmazsa mesaj sunucunun yanıtının başını gösterir; böylece çevirinin nerede olduğunu ve hangi yolu yazacağını görürsün."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Depinde de server. Un server al tău din casă nu are cotă."
msgstr "Sunucuya bağlı. Evdeki kendi sunucunun kotası yoktur."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Depinde de server."
msgstr "Sunucuya bağlı."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cum folosești o adresă proprie"
msgstr "Kendi adresini nasıl kullanırsın"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor, prin internet, spre serverul de la adresa scrisă de tine (%s), "
"care îl traduce."
msgstr "Altyazı metni (yalnızca metin, görüntü ve ses olmadan) alıcıdan internet üzerinden yazdığın adresteki sunucuya (%s) gider ve orada çevrilir."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Ollama ascultă din fabrică numai pe calculatorul lui. În Ollama 0.9.5 sau "
"mai nou: Settings, pornește „Expose Ollama to the network”."
msgstr "Ollama fabrika ayarında yalnızca kendi bilgisayarında dinler. Ollama 0.9.5 veya daha yenisinde: Settings, “Expose Ollama to the network” seçeneğini aç."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Sau: închide Ollama de lângă ceas, pune variabila de mediu OLLAMA_HOST cu "
"valoarea 0.0.0.0:11434 și pornește din nou Ollama."
msgstr "Ya da: saatin yanındaki Ollama'yı kapat, OLLAMA_HOST ortam değişkenini 0.0.0.0:11434 değerine ayarla ve Ollama'yı yeniden başlat."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"LM Studio: fila „Developer”, „Start server” și „Serve on Local Network”. "
"Căutarea nu-l găsește: scrie adresa de mână (portul 1234), ca server "
"compatibil OpenAI."
msgstr "LM Studio: “Developer” sekmesi, “Start server” ve “Serve on Local Network”. Arama onu bulmaz: adresi elle yaz (port 1234), OpenAI uyumlu sunucu olarak."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Windows: la întrebarea paravanului apasă „Allow access”. Altfel: Windows "
"Security, „Allow an app through firewall”, bifează Ollama la „Private”."
msgstr "Windows: güvenlik duvarı sorduğunda “Allow access” düğmesine bas. Aksi halde: Windows Security, “Allow an app through firewall”, Ollama'yı “Private” altında işaretle."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Rețeaua de acasă pe calculator trebuie să fie „Private network” (Settings › "
"Network & internet), iar receptorul și calculatorul în același router."
msgstr "Bilgisayarda ev ağı “Private network” olmalı (Settings › Network & internet), alıcı ve bilgisayar da aynı yönlendiriciye bağlı olmalı."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Traducerea subtitrărilor e gata, cu %s. Proba: %s"
msgstr "Altyazı çevirisi hazır, %s ile. Deneme: %s"

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Traducerea subtitrărilor e pornită, cu %s, dar cota gratuită s-a terminat. "
"Merge din nou după ce se reface cota."
msgstr "Altyazı çevirisi açık, %s ile, ama ücretsiz kota bitti. Kota yenilenince yeniden çalışır."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Traducerea subtitrărilor e pornită, cu %s (fără probă)."
msgstr "Altyazı çevirisi açık, %s ile (deneme yapılmadan)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Server compatibil OpenAI"
msgstr "OpenAI uyumlu sunucu"

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Serviciul ales nu are adresă de server."
msgstr "Seçilen hizmetin sunucu adresi yok."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Scrie adresa serverului, de exemplu http://192.168.1.50:%d."
msgstr "Sunucunun adresini yaz, örneğin http://192.168.1.50:%d."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Adresa are spații sau caractere care nu pot fi într-o adresă."
msgstr "Adreste boşluk veya bir adreste olamayacak karakterler var."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Portul din adresă nu e bun: trebuie un număr între 1 și 65535."
msgstr "Adresteki bağlantı noktası doğru değil: 1 ile 65535 arasında bir sayı olmalı."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Adresa trebuie să înceapă cu http:// sau https://."
msgstr "Adres http:// veya https:// ile başlamalı."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Adresa nu poate avea nume de utilizator sau parolă. Scrie numai adresa "
"serverului; cheia, dacă serverul cere una, se pune separat."
msgstr "Adreste kullanıcı adı veya parola olamaz. Yalnızca sunucunun adresini yaz; sunucu anahtar istiyorsa anahtar ayrıca girilir."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Adresa nu are numele sau IP-ul serverului."
msgstr "Adreste sunucunun adı veya IP'si yok."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Serverul de la %s cere o cheie. Scrie cheia serverului, sau pornește "
"serverul fără cheie."
msgstr "Sunucu (%s) bir anahtar istiyor. Sunucunun anahtarını yaz veya sunucuyu anahtarsız başlat."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "adresa scrisă"
msgstr "yazdığın adres"

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Copiaz-o întreagă din pagina cheii, fără spații. Cheia pentru Gemini se face "
"pe aistudio.google.com/apikey."
msgstr "Anahtar sayfasından tamamını boşluksuz kopyala. Gemini anahtarı aistudio.google.com/apikey adresinde oluşturulur."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Cheia e bună, dar în proiectul ei nu e pornit „Cloud Translation API”. În "
"Google Cloud (console.cloud.google.com) mergi la „APIs & Services”, caută "
"„Cloud Translation API”, apasă „Enable”, așteaptă câteva minute și încearcă "
"din nou."
msgstr "Anahtar doğru, ama projesinde “Cloud Translation API” açık değil. Google Cloud'da (console.cloud.google.com) “APIs & Services” bölümüne git, “Cloud Translation API” ara, “Enable” düğmesine bas, birkaç dakika bekle ve yeniden dene."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Copiaz-o întreagă din pagina cheii "
"(console.cloud.google.com/apis/credentials), fără spații. În proiectul cheii "
"pornește „Cloud Translation API” și verifică să nu fie cheia restrânsă la "
"alt API."
msgstr "Anahtar sayfasından (console.cloud.google.com/apis/credentials) tamamını boşluksuz kopyala. Anahtarın projesinde “Cloud Translation API” özelliğini aç ve anahtarın başka bir API ile sınırlı olmadığını kontrol et."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Copiaz-o întreagă din portal (resursa Translator, „Keys and Endpoint”, KEY "
"1), fără spații, și verifică regiunea: scrisă exact ca în portal (de exemplu "
"westeurope), sau Global dacă resursa e globală."
msgstr "Portaldan tamamını boşluksuz kopyala (Translator kaynağı, “Keys and Endpoint”, KEY 1) ve bölgeyi kontrol et: portaldaki gibi tam yazılmış (örneğin westeurope) veya kaynak küreselse Global."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Copiaz-o întreagă din pagina cheilor DeepL "
"(www.deepl.com/your-account/keys), fără spații. Trebuie o cheie de la DeepL "
"API, nu de la traducătorul obișnuit."
msgstr "DeepL anahtar sayfasından (www.deepl.com/your-account/keys) tamamını boşluksuz kopyala. Anahtar normal çeviriciden değil, DeepL API'den olmalı."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Copiaz-o întreagă din pagina cheilor (%s), fără spații."
msgstr "Anahtar sayfasından (%s) tamamını boşluksuz kopyala."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Copiaz-o întreagă din pagina cheii, fără spații, și încearcă din nou."
msgstr "Anahtar sayfasından tamamını boşluksuz kopyala ve yeniden dene."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota (la Gemini, de obicei a doua zi, în jurul orei 10, ora României)."
msgstr "Anahtar doğru, ama kota bitti. Kota yenilenince çeviri yeniden çalışır (Gemini'de genellikle ertesi gün, Romanya saatiyle 10 civarında)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota (la Azure, luna următoare)."
msgstr "Anahtar doğru, ama kota bitti. Kota yenilenince çeviri yeniden çalışır (Azure'da bir sonraki ay)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota."
msgstr "Anahtar doğru, ama kota bitti. Kota yenilenince çeviri yeniden çalışır."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Serverul a răspuns prea încet."
msgstr "Sunucu çok yavaş yanıt verdi."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Verifică dacă serverul de la %s e pornit și dacă receptorul îl vede (același "
"router)."
msgstr "Sunucunun (%s) açık olduğunu ve alıcının onu gördüğünü kontrol et (aynı yönlendirici)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"La Ollama, pe calculator trebuie OLLAMA_HOST=0.0.0.0:11434 (vezi "
"instrucțiunile)."
msgstr "Ollama için bilgisayarda OLLAMA_HOST=0.0.0.0:11434 gerekir (talimatlara bak)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Verifică internetul receptorului (Meniu › Setări › Rețea) și încearcă din "
"nou."
msgstr "Alıcının internetini kontrol et (Menü › Ayarlar › Ağ ve İnternet) ve yeniden dene."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Pornește serverul LibreTranslate și cu limba „%s” (de exemplu --load-only "
"en,ro,de,fr,it,es,hu)."
msgstr "LibreTranslate sunucusunu “%s” diliyle de başlat (örneğin --load-only en,ro,de,fr,it,es,hu)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Serviciul nu traduce în limba aleasă. Alege altă limbă în setările "
"traducerii."
msgstr "Hizmet seçilen dile çevirmiyor. Çeviri ayarlarında başka bir dil seç."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"La adresa asta nu răspunde LibreTranslate. Verifică adresa și portul (de "
