msgstr "Bu adreste hiçbir LibreTranslate sunucusu yanıt vermiyor."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Probez traducerea cu %s..."
msgstr "Çeviri %s ile deneniyor..."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
