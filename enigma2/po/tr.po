msgstr "Başlık adı (isteğe bağlı)"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Felul răspunsului"
msgstr "Yanıt türü"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Calea traducerii în răspuns"
msgstr "Yanıtta çevirinin yolu"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "La timp, în așteptare (fără original pe ecran): %d."
msgstr "Zamanında, beklerken (ekranda orijinal olmadan): %d."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"OK: un cod QR pentru telefon. Pe telefon îți faci cheia și o lipești; "
"receptorul o probează pe loc."
msgstr "OK: telefon için bir QR kodu. Telefonda anahtarını alır ve yapıştırırsın; alıcı onu hemen dener."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"OK: alegi regiunea din listă. O găsești în portal, la resursa Translator: "
"Overview › Location. Global pentru o resursă Global."
msgstr "OK: bölgeyi listeden seçersin. Onu portalda, Translator kaynağında bulursun: Overview › Location. Global bir kaynak için Global."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Când serviciul principal nu răspunde (prea multe cereri, cota terminată, "
"cheie refuzată, prea lent), receptorul trece singur la următorul din listă, "
"fără mesaj. Fiecare serviciu cu cheia lui. OK schimbă lista."
msgstr "Ana hizmet yanıt vermediğinde (çok fazla istek, kota bitti, anahtar reddedildi, çok yavaş) alıcı mesaj göstermeden kendiliğinden listedeki bir sonrakine geçer. Her hizmet kendi anahtarıyla. OK listeyi değiştirir."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"OK caută singur serverul din casă (LibreTranslate sau Ollama) și îl "
"probează. Adresa se poate scrie și de mână, mai jos."
msgstr "OK evdeki sunucuyu (LibreTranslate veya Ollama) kendisi bulur ve dener. Adres aşağıda elle de yazılabilir."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Chei și indici despărțiți prin punct, de exemplu translatedText sau "
"data.0.text; * ia toate elementele, lipite în ordine. Albastru: exemplul."
msgstr "Noktayla ayrılmış anahtarlar ve indisler, örneğin translatedText veya data.0.text; * tüm öğeleri alır, sırayla birleştirir. Mavi: örnek."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Locurile {text}, {sursa} și {tinta} se înlocuiesc la fiecare cerere. "
"Albastru: exemplul. Se scrie mai ușor din pagina web."
msgstr "{text}, {sursa} ve {tinta} yer tutucuları her istekte değiştirilir. Mavi: örnek. Web sayfasından yazmak daha kolay."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Global"
msgstr "Global"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Regiunea resursei Azure: o găsești în portal, la resursa Translator, "
"Overview › Location."
msgstr "Azure kaynağının bölgesi: onu portalda, Translator kaynağında, Overview › Location altında bulursun."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "niciunul (OK adaugă)"
msgstr "hiçbiri (OK ekler)"

