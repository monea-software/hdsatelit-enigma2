#, python-format
msgid "Revoci aparatul %s? Nu mai primește canalele și ghidul TV, iar adresele lui nu mai merg niciodată. Dacă îl vrei din nou, îl adaugi din nou."
msgstr "%s cihazı iptal edilsin mi? Artık kanalları ve TV rehberini almaz, adresleri de bir daha asla çalışmaz. Yeniden istersen yeniden ekle."

#: lib/python/Plugins/Extensions/HdsWebControl/aparate_web.py
msgid "Revocă"
msgstr "İptal et"

#: lib/python/Plugins/Extensions/HdsWebControl/acces_extern.py
msgid "Scrie un nume pentru aparat."
msgstr "Cihaz için bir ad yaz."

#: lib/python/Plugins/Extensions/HdsWebControl/aparate_web.py
msgid "Se adaugă aparatul..."
msgstr "Cihaz ekleniyor..."

#: lib/python/Plugins/Extensions/HdsWebControl/aparate_web.py
