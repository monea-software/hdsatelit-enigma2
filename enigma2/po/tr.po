#: lib/python/Components/HdsHbbtvPornire.py
msgid "Aplicația HbbTV a acestui canal vine din semnalul altui canal și receptorul nu o poate încărca de aici."
msgstr "Bu kanalın HbbTV uygulaması başka bir kanalın sinyalinde gelir ve alıcı onu buradan yükleyemez."

#: lib/python/Components/HdsHbbtvPornire.py
msgid "HbbTV: se încarcă aplicația din satelit..."
msgstr "HbbTV: uygulama uydudan yükleniyor..."

#: lib/python/Components/HdsHbbtvPornire.py
#, python-format
msgid "HbbTV: se încarcă aplicația din satelit (%(gata)d din %(toate)d părți)..."
msgstr "HbbTV: uygulama uydudan yükleniyor (%(toate)d parçadan %(gata)d)..."

#: lib/python/Components/HdsHbbtvPornire.py
msgid "Aplicația HbbTV a acestui canal nu vine din satelit: pista ei e criptată sau semnalul lipsește."
msgstr "Bu kanalın HbbTV uygulaması uydudan gelmiyor: akışı şifreli veya sinyal yok."

#: lib/python/Components/HdsHbbtvPornire.py
msgid "Aplicația HbbTV a acestui canal nu s-a încărcat întreagă din satelit: semnalul e prea slab."
msgstr "Bu kanalın HbbTV uygulaması uydudan tam yüklenemedi: sinyal çok zayıf."

#: lib/python/Components/HdsHbbtvPornire.py
msgid "Aplicația HbbTV a acestui canal e prea mare pentru memoria receptorului."
msgstr "Bu kanalın HbbTV uygulaması alıcının belleği için çok büyük."

#: lib/python/Components/HdsHbbtvPornire.py
msgid "Aplicația HbbTV din satelit nu are pagina de pornire anunțată de canal."
msgstr "Uydudan gelen HbbTV uygulamasında kanalın bildirdiği başlangıç sayfası yok."

#: lib/python/Components/HdsHbbtvPornire.py
msgid "Aplicația HbbTV din satelit nu se poate citi acum din semnalul canalului."
msgstr "Uydudan gelen HbbTV uygulaması şu anda kanal sinyalinden okunamıyor."

#: lib/python/Components/HdsLocInregistrari.py
#, python-format
msgid "„%s” nu poate fi citit de receptor. Îl poți formata aici sau pe un calculator, ca FAT32. Formatarea șterge tot de pe el."
