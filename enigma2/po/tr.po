#: lib/python/Screens/HdsLocul.py
msgid "Află locul după internet"
msgstr "Konumu internetten bul"

#: lib/python/Screens/HdsLocul.py
msgid "Caut locul după adresa de internet a receptorului..."
msgstr "Konum, alıcının internet adresine göre aranıyor..."

#: lib/python/Screens/HdsLocul.py
msgid "Receptorul nu are internet acum, deci locul nu se poate afla singur. Alege țara și orașul din listă."
msgstr "Alıcının şu anda interneti yok, bu yüzden konum kendiliğinden bulunamıyor. Listeden ülkeyi ve şehri seç."

#: lib/python/Screens/HdsLocul.py
msgid "Serverul HD Satelit nu a răspuns sau nu poate da locul acum. Alege țara și orașul din listă."
msgstr "HD Satelit sunucusu yanıt vermedi ya da şu anda konumu veremiyor. Listeden ülkeyi ve şehri seç."

#: lib/python/Screens/HdsLocul.py
msgid "Răspunsul serverului HD Satelit nu se poate folosi. Alege țara și orașul din listă."
msgstr "HD Satelit sunucusunun yanıtı kullanılamıyor. Listeden ülkeyi ve şehri seç."

#: lib/python/Screens/HdsLocul.py
msgid "După adresa de internet a receptorului nu se știe orașul. Alege țara și orașul din listă."
msgstr "Alıcının internet adresinden şehir bilinmiyor. Listeden ülkeyi ve şehri seç."

#: lib/python/Screens/HdsLocul.py
msgid "Locul s-a cerut de prea multe ori de la această adresă de internet. Încearcă peste un minut sau alege țara și orașul din listă."
msgstr "Konum bu internet adresinden çok fazla istendi. Bir dakika sonra yeniden dene ya da listeden ülkeyi ve şehri seç."

#: lib/python/Screens/HdsLocul.py
msgid "Locul găsit nu mai este cel arătat. Caută din nou sau alege țara și orașul din listă."
msgstr "Bulunan konum artık gösterilen konum değil. Yeniden ara ya da listeden ülkeyi ve şehri seç."

#: lib/python/Screens/HdsLocul.py
#, python-format
msgid ""
"Locul găsit după adresa de internet a receptorului:\n"
"\n"
"%(loc)s\n"
"%(coordonate)s\n"
"Sursa: %(sursa)s\n"
"\n"
"De obicei este orașul tău, dar uneori este orașul furnizorului de internet. Folosești acest loc? (Nu: alegi țara și orașul din listă.)"
msgstr ""
"Alıcının internet adresine göre bulunan konum:\n"
"\n"
"%(loc)s\n"
"%(coordonate)s\n"
"Kaynak: %(sursa)s\n"
"\n"
"Genellikle senin şehrindir, ama bazen internet sağlayıcısının şehridir. Bu konum kullanılsın mı? (Hayır: listeden ülkeyi ve şehri seçersin.)"

#: lib/python/Screens/HdsLocul.py
#, python-format
msgid "Coordonatele orașelor din listă: %s. Receptorul întreabă serverul HD Satelit numai când alegi „Află locul după internet”, iar serverul nu păstrează adresa de internet."
msgstr "Listedeki şehirlerin koordinatları: %s. Alıcı, HD Satelit sunucusuna yalnızca “Konumu internetten bul” seçeneğini seçtiğinde sorar ve sunucu internet adresini saklamaz."

#: lib/python/Screens/HdsLocul.py
msgid "prin serverul HD Satelit"
msgstr "HD Satelit sunucusu üzerinden"

