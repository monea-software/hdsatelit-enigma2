msgid "Nivel: potrivești tăria sunetului cu egalizator față de sunetul obișnuit, între −12 și +12 dB."
msgstr "Seviye: ekolayzırlı sesin gücünü normal sese göre ayarlar, −12 ile +12 dB arasında."

#: lib/python/Screens/HdsEgalizator.py
#, python-format
msgid "%s, %s. Sus și jos: cu 1 dB mai mult sau mai puțin, între −12 și +12 dB."
msgstr "%s, %s. Yukarı ve aşağı: 1 dB fazla veya az, −12 ile +12 dB arasında."

#: lib/python/Screens/HdsEgalizator.py
msgid "acest post"
msgstr "bu istasyon"

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Păstrat. Se aude și pe televizor."
msgstr "Kaydedildi. Televizyonda da duyulur."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Volumul se alege cu auto, aici sau placa."
msgstr "Ses seviyesi auto, aici veya placa ile seçilir."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Numele plăcii de sunet are numai litere, cifre și : , _ - ."
msgstr "Ses aygıtının adında yalnızca harf, rakam ve : , _ - . bulunur."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Am pus înapoi reglajele păstrate."
msgstr "Kaydedilen ayarlar geri yüklendi."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Se aude acum. Apasă „Păstrează” ca să rămână."
msgstr "Şimdi duyuluyor. Kalması için „Kaydet” düğmesine bas."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Presetarea „%s” nu există."
msgstr "„%s” ön ayarı yok."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Benzile se dau ca %d numere între %d și %d, cu virgulă între ele."
msgstr "Bantlar %d sayı olarak, %d ile %d arasında, virgülle ayrılarak verilir."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Nivelul se dă ca număr între %d și %d."
msgstr "Seviye %d ile %d arasında bir sayı olarak verilir."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "„%s” se alege cu 1 (da) sau 0 (nu)."
msgstr "„%s” 1 (evet) veya 0 (hayır) ile seçilir."

#: lib/python/Components/HdsEgalizator.py
msgid "Pauză. Sunetul revine cu egalizator când pornești din nou."
msgstr "Duraklatıldı. Oynatmayı sürdürdüğünde ses ekolayzırla geri gelir."

#: lib/python/Components/HdsEgalizator.py
msgid "La canalele TV egalizatorul nu merge încă: sunetul trebuie să rămână potrivit cu ce vezi pe ecran, deci merge prin placa de sunet. Egalizatorul lucrează la posturile de radio."
msgstr "TV kanallarında ekolayzır henüz çalışmıyor: sesin ekranda gördüklerinle uyumlu kalması gerekir, bu yüzden ses yongası üzerinden gider. Ekolayzır radyo istasyonlarında çalışır."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul nu poate porni: receptorul nu are decodorul MPEG audio."
msgstr "Ekolayzır başlatılamıyor: alıcıda MPEG ses kod çözücü yok."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul nu poate porni: lipsește decodarea sunetului în procesor (GStreamer)."
msgstr "Ekolayzır başlatılamıyor: işlemcide ses kod çözme eksik (GStreamer)."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul lipsește din programul acestui receptor. Setările se păstrează, dar nu se aud."
msgstr "Ekolayzır bu alıcının yazılımında yok. Ayarlar saklanır ama duyulmaz."

#: lib/python/Components/HdsEgalizator.py
msgid "ieșirea plăcii de sunet pentru procesor e oprită"
msgstr "ses yongasının işlemci için çıkışı kapalı"

#: lib/python/Components/HdsEgalizator.py
msgid "receptorul nu are decodor AAC"
msgstr "alıcıda AAC kod çözücü yok"

#: lib/python/Components/HdsEgalizator.py
msgid "receptorul nu are decodorul MPEG audio"
msgstr "alıcıda MPEG ses kod çözücü yok"

#: lib/python/Components/HdsEgalizator.py
msgid "lipsește decodarea sunetului în procesor"
msgstr "işlemcide ses kod çözme eksik"

#: lib/python/Components/HdsEgalizator.py
msgid "placa de sunet nu se poate folosi din procesor"
msgstr "ses yongası işlemciden kullanılamıyor"

#: lib/python/Components/HdsEgalizator.py
msgid "felul acesta de AAC nu se poate decoda încă"
msgstr "bu tür AAC henüz çözülemiyor"

#: lib/python/Components/HdsEgalizator.py
msgid "fișierul probei nu există"
msgstr "deneme dosyası yok"

#: lib/python/Components/HdsEgalizator.py
msgid "fișierul probei nu s-a putut scrie"
msgstr "deneme dosyası yazılamadı"

#: lib/python/Components/HdsEgalizator.py
msgid "o eroare neașteptată"
msgstr "beklenmeyen bir hata"

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Probă din fișier, cu egalizator: %s. Proba merge și cu egalizatorul oprit."
msgstr "Dosyadan deneme, ekolayzırla: %s. Deneme ekolayzır kapalıyken de çalışır."

#: lib/python/Components/HdsEgalizator.py
msgid "decodat în procesor"
msgstr "işlemcide çözüldü"

#: lib/python/Screens/HdsEgalizator.py
msgid "Păstrezi schimbările?"
msgstr "Değişiklikler kaydedilsin mi?"

#: lib/python/Screens/HdsEgalizator.py
msgid "Pornit, sunetul posturilor de radio trece prin procesor și se aude cu reglajele de mai jos."
msgstr "Açıkken radyo istasyonlarının sesi işlemciden geçer ve aşağıdaki ayarlarla duyulur."

#: lib/python/Screens/HdsEgalizator.py
msgid "Presetarea pune singură toate benzile; apoi le poți potrivi una câte una. Barele din spate: cât de tare se aude acum fiecare bandă."
msgstr "Ön ayar tüm bantları kendisi ayarlar; sonra bunları tek tek düzeltebilirsin. Arkadaki çubuklar: her bandın şu anda ne kadar yüksek duyulduğu."

#: lib/python/Screens/HdsEgalizator.py
msgid "Modul de noapte: sunetele tari devin mai încete, cele încete mai tari. Potrivit seara, când asculți încet."
msgstr "Gece modu: yüksek sesler kısılır, alçak sesler yükselir. Akşamları, kısık sesle dinlerken iyidir."

#: lib/python/Screens/HdsEgalizator.py
#, python-format
msgid "Da: reglajele de aici se țin minte numai pentru %s. Nu: postul folosește reglajele obișnuite, ale tuturor posturilor, pe care le vezi aici."
msgstr "Evet: buradaki ayarlar yalnızca %s için saklanır. Hayır: istasyon, burada gördüğün tüm istasyonların normal ayarlarını kullanır."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. OK: pornești sau oprești. EXIT: ieși."
msgstr "Sol ve sağ: seç. OK: aç veya kapat. EXIT: çık."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. Sus, jos sau OK: presetarea următoare. EXIT: ieși."
msgstr "Sol ve sağ: seç. Yukarı, aşağı veya OK: sonraki ön ayar. EXIT: çık."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. OK: da sau nu. EXIT: ieși."
msgstr "Sol ve sağ: seç. OK: evet veya hayır. EXIT: çık."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. Sus și jos: schimbi. OK: păstrezi și închizi."
msgstr "Sol ve sağ: seç. Yukarı ve aşağı: değiştir. OK: kaydedip kapat."

#: lib/python/Components/HdsEgalizator.py
msgid "La acest post (AAC) egalizatorul nu e disponibil din motive de licențiere a brevetelor AAC."
msgstr "Bu istasyonda (AAC) ekolayzır, AAC patent lisanslaması nedeniyle kullanılamıyor."

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Postul acesta are sunet %s. Egalizatorul lucrează la posturile cu sunet MPEG (MP2)."
msgstr "Bu istasyonun sesi %s. Ekolayzır MPEG (MP2) sesli istasyonlarda çalışır."

