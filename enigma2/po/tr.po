msgstr "Listedeki kanallar: %s (toplam %s). Bir uydu veya bir liste seç."

#: data/menu.xml
#: data/setup.xml
msgid "Volum și întârziere"
msgstr "Ses düzeyi ve gecikme"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Pasul volumului"
msgstr "Ses düzeyi adımı"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Cât crește sau scade volumul la o apăsare pe tastele de volum (volumul merge de la 0 la 100)."
msgstr "Ses tuşlarına bir kez basınca ses düzeyinin ne kadar artıp azaldığı (ses düzeyi 0 ile 100 arasındadır)."

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Volumul ținut minte pe canal"
msgstr "Kanal başına hatırlanan ses düzeyi"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Da: fiecare canal pornește cu volumul la care l-ai lăsat. Un canal la care nu ai schimbat volumul îl păstrează pe cel de acum."
msgstr "Evet: her kanal, bıraktığın ses düzeyiyle başlar. Ses düzeyini değiştirmediğin bir kanal şu anki düzeyi korur."

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Volum egal între canale"
msgstr "Kanallar arasında eşit ses düzeyi"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Placa de sunet apropie singură volumul: canalele și reclamele tari se aud mai încet, cele încete mai tare. Puternic micșorează și diferența dintre tare și încet (bun noaptea). Nu lucrează când sunetul pleacă neschimbat spre televizor."
msgstr "Ses yongası ses düzeyini kendisi eşitler: yüksek kanallar ve reklamlar daha alçak, alçak olanlar daha yüksek duyulur. Güçlü, yüksek ile alçak arasındaki farkı da azaltır (gece için iyi). Ses televizyona değiştirilmeden giderken çalışmaz."

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Întârzierea sunetului pe HDMI"
msgstr "HDMI'da ses gecikmesi"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Când buzele se mișcă după sunet, întârzie sunetul spre televizor. Sunetul se poate numai întârzia, nu grăbi."
msgstr "Dudaklar sesten sonra kıpırdıyorsa televizyona giden sesi geciktir. Ses yalnızca geciktirilebilir, öne alınamaz."

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Întârzierea sunetului pe optic"
msgstr "Optik çıkışta ses gecikmesi"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "La fel, pentru bara de sunet sau amplificatorul legat la ieșirea optică a receptorului."
msgstr "Aynısı, alıcının optik çıkışına bağlı ses çubuğu veya amfi için."

#: lib/python/Components/HdsSetariSunet.py
msgid "Ușor"
msgstr "Hafif"

#: lib/python/Components/HdsSetariSunet.py
msgid "Puternic"
msgstr "Güçlü"

#: lib/python/Components/HdsSetariSunet.py
msgid "Întârzierea pistei pe acest canal"
msgstr "Bu kanalda ses parçası gecikmesi"

#: lib/python/Components/HdsSetariSunet.py
msgid "Se adună la întârzierea ieșirii, numai pentru pista de sunet de acum a canalului de acum. Se ține minte."
msgstr "Çıkış gecikmesine eklenir, yalnızca şu anki kanalın şu anki ses parçası için. Hatırlanır."

#: lib/python/Plugins/Extensions/HdsWebControl/setari_sunet_web.py
msgid "Setările sunetului nu sunt încă gata. Încearcă din nou peste câteva secunde."
msgstr "Ses ayarları henüz hazır değil. Birkaç saniye sonra yeniden dene."

#: lib/python/Plugins/Extensions/HdsWebControl/setari_sunet_web.py
msgid "Nu merge acum un canal cu o pistă de sunet."
