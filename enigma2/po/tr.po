msgstr "Bu alıcı bu kanalı oynatamıyor."

#: lib/python/Components/HdsFilmRedare.py
msgid "Canalul merge fără sunet."
msgstr "Kanal sessiz oynatılıyor."

#: lib/python/Components/HdsFilmRedare.py
