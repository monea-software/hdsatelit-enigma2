msgstr ""
"Ista podešavanja su na televizoru, u __DRUM_MENIU__ (u meniju plejera, "
"taster Menu), gde su i iste komande. Sa stranice se vide samo USB memorije i "
"diskovi, ne unutrašnja memorija prijemnika."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__, și cu OK ținut apăsat "
"pe ecranul radio."
msgstr ""
"Ista podešavanja su na televizoru, u __DRUM_MENIU__, a i držanjem OK na "
"ekranu radija."

msgid "Aceleași setări sunt pe televizor, în __DRUM_MENIU__."
msgstr "Ista podešavanja su na televizoru, u __DRUM_MENIU__."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Redarea folosește "
"biblioteca mpegts.js (Apache-2.0), venită cu imaginea: <a href=\"/tv/mpegts-"
"licenta.txt\">licența</a>. Canalele cu imagine MPEG-2 și sunetul AC-3 (unde "
"browserul nu îl redă singur) se decodează în browser, pe procesorul "
"calculatorului, cu decodorul FFmpeg (LGPL-2.1) venit tot cu imaginea: <a "
"href=\"/tv/tv-wasm/ffmpeg-licenta.txt\">licența și sursa</a>; toate "
"licențele sunt în <a href=\"/licente\">Licențe</a>."
msgstr ""
"Ista podešavanja su na televizoru, u __DRUM_MENIU__. Reprodukcija koristi "
"biblioteku mpegts.js (Apache-2.0), koja dolazi uz image: <a href=\"/tv/"
"mpegts-licenta.txt\">licenca</a>. Kanali sa slikom MPEG-2 i zvukom AC-3 (gde "
"ih pregledač ne reprodukuje sam) dekodiraju se u pregledaču, na procesoru "
"računara, dekoderom FFmpeg (LGPL-2.1) koji takođe dolazi uz image: <a "
"href=\"/tv/tv-wasm/ffmpeg-licenta.txt\">licenca i izvorni kod</a>; sve "
"licence su u <a href=\"/licente\">Licence</a>."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Serverele DNS au "
"pagina lor: <a href=\"/dns\" id=\"legaturaDns\">Servere DNS</a>."
msgstr ""
"Ista podešavanja su na televizoru, u __DRUM_MENIU__. DNS serveri imaju svoju "
"stranicu: <a href=\"/dns\" id=\"legaturaDns\">DNS serveri</a>."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Tema și culorile "
"paginilor web sunt în pagina Setări."
msgstr ""
"Ista podešavanja su na televizoru, u __DRUM_MENIU__. Tema i boje web "
"stranica su na stranici Podešavanja."

msgid ""
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__. Întârzierea pistei e "
"și în ecranul tastei AUDIO."
msgstr ""
"Ista podešavanja su na televizoru, u __DRUM_MENIU__. Kašnjenje zapisa je i "
"na ekranu tastera AUDIO."

msgid ""
"Aceleași setări sunt pe televizor, în „Fluxuri și setări”, pe tasta MENU."
msgstr ""
