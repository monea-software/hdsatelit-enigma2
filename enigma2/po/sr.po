msgstr ""
"Isti alat je na televizoru, u __DRUM_MENIU__. Dok stranica sluša, tasteri "
"rade i na televizoru, najviše 2 minuta, a na televizoru se pojavljuje "
"obaveštenje. Iz dubokog stanja pripravnosti prijemnik se uključuje samo "
"svojim daljinskim upravljačem."

msgid ""
"Același utilitar e pe televizor, în __DRUM_MENIU__. Placa Wi-Fi a "
"receptorului recepționează numai rețelele de 2,4 GHz. Căutarea e aceeași ca "
"la lista rețelelor Wi-Fi: nu trimite nimic altceva."
msgstr ""
"Isti alat je na televizoru, u __DRUM_MENIU__. Wi-Fi kartica prijemnika prima "
"samo mreže od 2,4 GHz. Pretraga je ista kao kod liste Wi-Fi mreža: ne šalje "
"ništa drugo."

msgid "Aceleași alegeri sunt și în interfața web, la pagina /mod-sigur."
msgstr "Isti izbori su i u web interfejsu, na stranici /mod-sigur."

#, python-format
