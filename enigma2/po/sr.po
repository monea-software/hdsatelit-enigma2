msgstr "Server ne daje listu modela (HTTP %s)."

msgid "Serverul nu dă lista modelelor."
msgstr "Server ne daje listu modela."

msgid "Serverul nu este al acestui furnizor."
msgstr "Server ne pripada ovom provajderu."

msgid ""
