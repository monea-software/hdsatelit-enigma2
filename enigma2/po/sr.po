msgstr "Na prijemniku"

msgid "Pe receptor a apărut o eroare: %s"
msgstr "Na prijemniku se pojavila greška: %s"

msgid "Pe receptor nu era nicio extensie instalată de tine."
msgstr "Na prijemniku nije bilo nijedno proširenje koje si ti instalirao."

msgid "Pe receptor:"
msgstr "Na prijemniku:"

#, python-format
msgid "Pe receptor: %s"
msgstr "Na prijemniku: %s"

msgid "Pe rezervă"
msgstr "Na rezervi"

msgid "Pe sateliți"
msgstr "Po satelitima"

msgid "Pe scurt"
msgstr "Ukratko"

msgid "Pe server"
msgstr "Na serveru"

msgid "Pe server nu mai este loc."
msgstr "Na serveru nema više mesta."

msgid ""
"Pe stick e o cheie privată. Lasă pe stick numai cheile publice (.pub). Cheia "
"privată rămâne numai la tine."
msgstr ""
"Na USB flešu je privatni ključ. Ostavi na flešu samo javne ključeve (.pub). "
"Privatni ključ ostaje samo kod tebe."

msgid ""
"Pe stick nu am găsit dosarul hdsatelit/ssh cu chei. Pune în el fișierul "
"authorized_keys sau cheile tale .pub."
msgstr ""
"Na USB flešu nije pronađen folder hdsatelit/ssh sa ključevima. Stavi u njega "
"datoteku authorized_keys ili svoje .pub ključeve."

msgid ""
"Pe stick nu am găsit dosarul hdsatelit/vpn. Pune în el fișierele .ovpn, ."
"conf sau arhiva .zip."
msgstr ""
"Na USB flešu nisam pronašao folder hdsatelit/vpn. Stavi u njega .ovpn, .conf "
"datoteke ili .zip arhivu."

msgid "Pe telecomanda nouă: ține apăsat 2 secunde = Sari."
msgstr "Na novom daljinskom: drži pritisnuto 2 sekunde = Preskoči."

msgid ""
"Pe telecomanda nouă: ține apăsat 2 secunde = Sari. Gata merge după MENU."
msgstr ""
"Na novom daljinskom upravljaču: drži pritisnuto 2 sekunde = Preskoči. Gotovo "
"radi posle MENU."

msgid ""
"Pe telecomanda nouă: ține apăsat 2 secunde = Sari; ține apăsat EXIT = Gata."
msgstr ""
"Na novom daljinskom upravljaču: drži pritisnuto 2 sekunde = Preskoči; drži "
"pritisnuto EXIT = Gotovo."

msgid "Pe telecomanda televizorului"
msgstr "Na daljinskom upravljaču televizora"

msgid "Pe televizor"
msgstr "Na televizoru"

msgid ""
"Pe televizor apare apoi aceeași întrebare: se face numai după ce răspunzi Da "
"acolo sau, la o înregistrare, singur, după ce se termină."
msgstr ""
"Na televizoru se zatim pojavljuje isto pitanje: izvršava se tek nakon što "
"tamo odgovoriš Da ili, kod snimanja, samo pošto se završi."

msgid ""
"Pe televizor așteaptă deja o întrebare de oprire sau de repornire. Răspunde "
"acolo."
msgstr ""
"Na televizoru već čeka pitanje o isključivanju ili ponovnom pokretanju. "
"Odgovori tamo."

msgid "Pe televizor așteaptă deja o întrebare."
msgstr "Na televizoru već čeka pitanje."

msgid "Pe televizor e ales un câmp de parolă: textul nu se vede pe ecran."
msgstr ""
"Na televizoru je odabrano polje za lozinku: tekst se ne vidi na ekranu."

msgid ""
"Pe televizor e deschis alt ecran. Închide-l, apoi pornește din nou filmul."
msgstr ""
"Na televizoru je otvoren drugi ekran. Zatvori ga, pa ponovo pokreni film."

msgid "Pe televizor e deschis alt ecran. Închide-l, apoi încearcă din nou."
msgstr "Na televizoru je otvoren drugi ekran. Zatvori ga, pa pokušaj ponovo."

msgid ""
"Pe televizor e deschis ecranul Calitatea imaginii. Închide-l, apoi încearcă "
"din nou."
msgstr ""
"Na televizoru je otvoren ekran Kvalitet slike. Zatvori ga, pa pokušaj ponovo."

msgid ""
"Pe televizor e deschis ecranul Video sau asistentul de pornire. Închide-l, "
"apoi încearcă din nou."
msgstr ""
"Na televizoru je otvoren ekran Video ili asistent za pokretanje. Zatvori ga, "
"pa pokušaj ponovo."

#, python-format
msgid "Pe televizor e deschis ecranul „%s”. Închide-l, apoi încearcă din nou."
msgstr "Na televizoru je otvoren ekran „%s”. Zatvori ga, pa pokušaj ponovo."

msgid ""
"Pe televizor e deschis rezultatul scanării DAB+ sau DVB-T2. Alege acolo sau "
"în pagină ce pornești sau întoarce-te la canalul tău, apoi pornește căutarea "
"nouă."
msgstr ""
"Na televizoru je otvoren rezultat pretrage DAB+ ili DVB-T2. Izaberi tamo ili "
"na stranici šta pokrećeš ili se vrati na svoj kanal, zatim pokreni novu "
"pretragu."

msgid ""
"Pe televizor e deschis un ecran cu setările sunetului. Închide-l, apoi "
"încearcă din nou."
msgstr ""
"Na televizoru je otvoren ekran sa podešavanjima zvuka. Zatvori ga, pa "
"pokušaj ponovo."

msgid ""
"Pe televizor e deschis un mesaj peste probă. Închide-l cu OK, apoi încearcă "
"din nou."
msgstr ""
"Na televizoru je preko testa otvorena poruka. Zatvori je tasterom OK, zatim "
"pokušaj ponovo."

msgid ""
"Pe televizor e deschisă altă fereastră peste căutare. Închide-o întâi (tasta "
"Exit), apoi încearcă din nou."
msgstr ""
"Na televizoru je preko pretrage otvoren drugi prozor. Prvo ga zatvori "
"(taster Exit), pa pokušaj ponovo."

msgid ""
"Pe televizor e deschisă altă fereastră peste scanare. Închide-o întâi (tasta "
"EXIT), apoi încearcă din nou."
msgstr ""
"Na televizoru je preko skeniranja otvoren drugi prozor. Prvo ga zatvori "
"(taster EXIT), pa pokušaj ponovo."

msgid "Pe televizor e deschisă interfața camului. Închide-o întâi."
msgstr "Na televizoru je otvoren interfejs CAM-a. Prvo ga zatvori."

msgid "Pe televizor e deschisă interfața web a modulului. Închide-o întâi."
msgstr "Na televizoru je otvoren web interfejs modula. Prvo ga zatvori."

msgid "Pe televizor e deschisă o fereastră peste navigator."
msgstr "Na televizoru je otvoren prozor preko pregledača."

msgid ""
"Pe televizor e încă deschis rezultatul căutării de dinainte. Închide-l "
"(butonul din pagină sau tasta Exit), apoi pornește căutarea nouă."
msgstr ""
"Na televizoru je još uvek otvoren rezultat prethodne pretrage. Zatvori ga "
"(dugme na stranici ili taster Exit), zatim pokreni novu pretragu."

msgid "Pe televizor este deschis alt ecran. Închide-l și încearcă încă o dată."
msgstr "Na televizoru je otvoren drugi ekran. Zatvori ga i pokušaj ponovo."

msgid "Pe televizor merge acum ceva ce nu se poate transmite în browser."
msgstr "Na televizoru sada radi nešto što se ne može preneti u pregledač."

msgid "Pe televizor nu e deschis niciun câmp de text."
msgstr "Na televizoru nije otvoreno nijedno tekstualno polje."

msgid "Pe televizor nu merge acum niciun canal."
msgstr "Na televizoru sada ne radi nijedan kanal."

msgid "Pe televizor nu se arată nicio poză."
msgstr "Na televizoru se ne prikazuje nijedna slika."

msgid ""
"Pe televizor nu se arată nicio poză. Alege o poză mai jos și apasă Arată pe "
"televizor."
msgstr ""
"Na televizoru se ne prikazuje nijedna fotografija. Izaberi fotografiju ispod "
"i pritisni Prikaži na televizoru."

msgid ""
"Pe televizor poți alege și direct o emisiune din ghidul TV: acolo marginile "
"de dinainte și de după se pun singure."
msgstr ""
"Na televizoru možeš i direktno da izabereš emisiju iz TV vodiča: tamo se "
"margine pre i posle postavljaju same."

msgid ""
"Pe televizor s-a deschis Asistența de la distanță: citește și apasă Verde "
"acolo."
msgstr ""
"Na televizoru se otvorila Daljinska pomoć: pročitaj tekst i tamo pritisni "
"Zeleno."

msgid ""
"Pe televizor se cere o confirmare: o înregistrare e în curs sau începe "
"curând, sau lucrează ceva în fundal. Se face numai dacă răspunzi Da acolo."
msgstr ""
"Na televizoru se traži potvrda: snimanje je u toku ili uskoro počinje, ili "
"nešto radi u pozadini. Izvršava se samo ako tamo odgovoriš Da."

msgid ""
"Pe televizor se cere o confirmare: o înregistrare e în curs sau începe "
"curând. Alegerea se face numai dacă răspunzi Da acolo."
msgstr ""
"Na televizoru se traži potvrda: snimanje je u toku ili uskoro počinje. Izbor "
"se vrši samo ako tamo odgovoriš Da."

msgid ""
"Pe televizor se cere o confirmare: o înregistrare e în curs sau începe "
"curând. Repornirea se face numai dacă răspunzi Da acolo."
msgstr ""
"Na televizoru se traži potvrda: snimanje je u toku ili uskoro počinje. "
"Ponovno pokretanje se izvršava samo ako tamo odgovoriš Da."

msgid ""
"Pe televizor se deschide ecranul probei. Îl închizi de acolo cu EXIT sau din "
"pagină."
msgstr ""
"Na televizoru se otvara ekran testa. Zatvaraš ga tamo tasterom EXIT ili sa "
"stranice."

msgid ""
"Pe televizor, același mesaj apare singur la pornire, în modul sigur, și din "
"Meniu > Informații despre sistem > Mod sigur."
msgstr ""
"Na televizoru, ista poruka se pojavljuje sama pri pokretanju, u bezbednom "
"režimu, i iz Meni > Informacije o sistemu > Bezbedni režim."

msgid ""
"Pe televizor, asta se poate numai cu nivelul de meniu Intermediar sau Expert."
msgstr ""
"Na televizoru je to moguće samo sa srednjim ili stručnim nivoom menija."

msgid ""
"Pe televizor, ecranul diagnosticului apare singur numai când pornirea nu "
"reușește; altfel se deschide din MENU > Informații despre sistem > "
"Diagnosticul pornirii."
msgstr ""
"Na televizoru, ekran dijagnostike se pojavljuje sam samo kada pokretanje ne "
"uspe; inače se otvara iz MENI > Informacije o sistemu > Dijagnostika "
"pokretanja."

msgid ""
"Pe televizor, pe ecranul radio: tasta galbenă trece la altă vizualizare, "
"tasta albastră la alte culori. Alegerea se ține minte."
msgstr ""
"Na televizoru, na radio ekranu: žuti taster prelazi na drugu vizualizaciju, "
"plavi taster na druge boje. Izbor se pamti."

msgid ""
"Pe televizor, pe ecranul radio: tasta galbenă trece la altă vizualizare, "
"tasta albastră la alte culori. Alegerea se ține minte. Tasta verde deschide "
"egalizatorul."
msgstr ""
"Na televizoru, na ekranu radija: žuti taster prelazi na drugi prikaz, plavi "
"taster na druge boje. Izbor se pamti. Zeleni taster otvara ekvilajzer."

msgid ""
"Pe televizor, setările playerului apar numai cu nivelul de meniu Intermediar "
"sau Expert."
msgstr ""
"Na televizoru, podešavanja plejera se pojavljuju samo sa nivoom menija "
"Srednji ili Ekspert."

msgid "Pe televizor:"
msgstr "Na televizoru:"

#, python-format
msgid "Pe televizor: %s. Mai sunt %s s până revine ieșirea de dinainte."
msgstr "Na televizoru: %s. Ostalo je još %s s do povratka prethodnog izlaza."

msgid ""
"Pe televizor: <span id=\"drumDab\">__DRUM_DAB__</span><span "
"id=\"drumT2\">__DRUM_T2__</span> &gt; Fluxuri și setări."
msgstr ""
"Na televizoru: <span id=\"drumDab\">__DRUM_DAB__</span><span "
"id=\"drumT2\">__DRUM_T2__</span> &gt; Tokovi i podešavanja."

msgid "Pe televizor: Meniu, Setări, Software &amp; Firmware, Copia setărilor."
msgstr ""
"Na televizoru: Meni, Podešavanja, Software &amp; Firmware, Kopija "
"podešavanja."

msgid ""
"Pe televizor: apasă OK de două ori pe un canal; prima pagină a barei este "
"ghidul canalului."
msgstr ""
"Na televizoru: pritisni OK dvaput na kanalu; prva stranica trake je vodič "
"kanala."

msgid ""
"Pe televizor: pe alt receptor, mesajul de mai sus apare singur, în locul "
"interfeței."
msgstr ""
"Na televizoru: na drugom prijemniku, gornja poruka se pojavljuje sama, "
"umesto interfejsa."

msgid ""
"Pe televizor: tasta SUB în timpul filmului. Setările implicite sunt în "
"__DRUM_MENIU__."
msgstr ""
"Na televizoru: taster SUB tokom filma. Podrazumevana podešavanja su u "
"__DRUM_MENIU__."

msgid "Pe televizor: tasta TEXT."
msgstr "Na televizoru: taster TEXT."

#, python-format
msgid ""
"Pe televizor: în dreapta cu reglajul, în stânga fără. Se oprește singură "
"după %d de secunde."
msgstr ""
"Na televizoru: desno sa podešavanjem, levo bez. Samo se isključuje nakon %d "
"sekundi."

msgid "Pe transpondere"
msgstr "Po transponderima"

#, python-format
msgid ""
"Pe tunerul %s nu e legat niciun satelit. Alege sateliții din Setări tuner."
msgstr ""
"Na tjuner %s nije povezan nijedan satelit. Izaberi satelite u Podešavanjima "
"tjunera."

msgid ""
"Pe un calculator din casă instalează Docker Desktop (docs.docker.com) și "
"pornește-l."
msgstr ""
"Na računaru kod kuće instaliraj Docker Desktop (docs.docker.com) i pokreni "
"ga."

msgid ""
"Pe un calculator din casă rulează LibreTranslate sau Ollama. Receptorul îl "
"caută în rețeaua de acasă, alege singur modelul și face proba."
msgstr ""
"Na računaru kod kuće radi LibreTranslate ili Ollama. Prijemnik ga traži u "
"kućnoj mreži, sam bira model i vrši proveru."

msgid "Pe un canal cu subcanale, VERDE scurt arată întâi lista lor."
msgstr "Na kanalu sa podkanalima, kratko ZELENO prvo prikazuje njihovu listu."

msgid "Pe „%s” lipsește dosarul %s, în care se salvează timeshift-ul."
msgstr "Na „%s” nedostaje fascikla %s u kojoj se čuva timeshift."

msgid "Pe „%s” lipsește dosarul %s, în care se salvează înregistrările."
msgstr "Na „%s” nedostaje fascikla %s u kojoj se čuvaju snimci."

msgid "Peisaje"
msgstr "Pejzaži"

#, python-format
msgid "Pentru %s lipsește: %s."
msgstr "Za %s nedostaje: %s."

msgid ""
"Pentru Cloudflare Workers scrie și ID-ul contului (32 de litere și cifre, de "
"la „Account ID”). Cheia nu a plecat nicăieri."
msgstr ""
"Za Cloudflare Workers upiši i ID naloga (32 slova i cifre, pod „Account "
"ID“). Ključ nije nigde poslat."

msgid "Pentru Gemini lipsește cheia. Pune întâi cheia."
msgstr "Za Gemini nedostaje ključ. Prvo unesi ključ."

msgid "Pentru Python 3 există %s, în feedul %s."
msgstr "Za Python 3 postoji %s, u feed-u %s."

msgid "Pentru SubDL scrie în setări cheia ta API (din panoul contului SubDL)."
msgstr "Za SubDL unesi u podešavanja svoj API ključ (iz panela SubDL naloga)."

msgid ""
"Pentru Uniunea Europeană, Google spune că nici la nivelul gratuit nu "
"folosește textele trimise ca să-și îmbunătățească produsele."
msgstr ""
"Za Evropsku uniju, Google kaže da ni na besplatnom nivou ne koristi poslate "
"tekstove da bi poboljšao svoje proizvode."

msgid ""
"Pentru a face loc pe disc fără să pierzi setările, folosește curățenia "
"discului. Același ecran e pe televizor, în __DRUM_MENIU__."
msgstr ""
"Da bi napravio mesta na disku bez gubitka podešavanja, koristi čišćenje "
"diska. Isti ekran je na televizoru, u __DRUM_MENIU__."

msgid "Pentru această actualizare trebuie pusă imaginea nouă."
msgstr "Za ovo ažuriranje potrebno je instalirati novi image."

msgid "Pentru acest post"
msgstr "Za ovu stanicu"

msgid "Pentru acest post (nu merge niciun post)"
msgstr "Za ovu stanicu (ne radi nijedna stanica)"

msgid ""
"Pentru aceste limbi ai ales să nu te mai întreb când apare o subtitrare fără "
"model:"
msgstr ""
"Za ove jezike izabrao si da te više ne pitam kada se pojavi titl bez modela:"

msgid "Pentru daltonism"
msgstr "Za daltoniste"

msgid ""
"Pentru descărcări de pe OpenSubtitles scrie în setări contul tău (gratuit)."
msgstr ""
"Za preuzimanja sa OpenSubtitles unesi u podešavanja svoj (besplatan) nalog."

msgid ""
"Pentru fișierele de subtitrare care nu sunt UTF-8 și pentru textul din "
"filmele MKV scris altfel. Europa Centrală citește corect fișierele românești "
"vechi. La pistele din film se aplică de la filmul următor."
msgstr ""
"Za fajlove titlova koji nisu UTF-8 i za tekst u MKV filmovima zapisan "
"drugačije. Centralna Evropa ispravno čita stare rumunske fajlove. Za zapise "
"unutar filma primenjuje se od sledećeg filma."

msgid ""
"Pentru limbile acestea ai ales „Nu mai întreba pentru limba asta”. OK: te "
"întreb din nou când apare o subtitrare în ele."
msgstr ""
"Za ove jezike si izabrao „Ne pitaj više za ovaj jezik“. OK: ponovo ću te "
"pitati kada se pojavi titl na njima."

msgid ""
"Pentru o bară de sunet legată la ieșirea optică a receptorului alege Manual "
"și pune Downmix AC3 pe Nu. Schimbarea se aude sigur de la următorul canal."
msgstr ""
"Za zvučnu traku povezanu na optički izlaz prijemnika izaberi Ručno i postavi "
"Downmix AC3 na Ne. Promena se sigurno čuje od sledećeg kanala."

msgid "Pentru pasionați."
msgstr "Za entuzijaste."

msgid "Pentru probe și potriviri"
msgstr "Za probe i podešavanja"

msgid "Pentru programatori"
msgstr "Za programere"

#, python-format
msgid ""
"Pentru recuperare, Maintenance Mode caută imaginea pe stick în dosarul %s."
msgstr "Za oporavak, Maintenance Mode traži image na flešu u folderu %s."

msgid ""
"Pentru satelitul ales nu există niciun transponder în lista de sateliți, "
"deci receptorul nu are ce acorda."
msgstr ""
"Za izabrani satelit nema nijednog transpondera na listi satelita, pa "
"prijemnik nema šta da podesi."

msgid "Pentru serverul compatibil OpenAI lipsește adresa. Pune întâi adresa."
msgstr "Za server kompatibilan sa OpenAI nedostaje adresa. Prvo unesi adresu."

msgid ""
"Pentru subs.ro scrie în setări cheia ta API (din profilul de pe subs.ro)."
msgstr "Za subs.ro unesi u podešavanja svoj API ključ (iz profila na subs.ro)."

msgid ""
"Pentru subtitrări multe (filme întregi, zilnic) e recomandat Azure "
"Translator, planul Free F0: 2 milioane de caractere pe lună; cardul se cere "
"numai la înscriere, iar pe F0 nu se plătește nimic. Gemini e gratuit pentru "
"folosire ocazională, dar la subtitrări continue poate da „prea multe cereri” "
"după câteva minute."
msgstr ""
"Za mnogo titlova (cele filmove, svakodnevno) preporučuje se Azure "
"Translator, plan Free F0: 2 miliona karaktera mesečno; kartica se traži samo "
"pri registraciji, a na F0 se ništa ne plaća. Gemini je besplatan za "
"povremenu upotrebu, ali kod neprekidnih titlova može posle nekoliko minuta "
"da javi „previše zahteva“."

msgid ""
"Pentru subtitrări multe (filme întregi, în fiecare zi) pune în setări și "
"servicii de rezervă, de exemplu Azure Translator: când Gemini dă eroarea "
"429, receptorul trece singur la următorul. Lista se face din servicii "
"diferite: limita Gemini e pe proiect, iar mai multe conturi făcute ca să "
"aduni limitele gratuite înseamnă ocolirea limitelor, pe care termenii Google "
"o interzic."
msgstr ""
"Za mnogo titlova (celi filmovi, svaki dan) dodaj u podešavanja i rezervne "
"servise, na primer Azure Translator: kada Gemini da grešku 429, prijemnik "
"sam prelazi na sledeći. Lista se pravi od različitih servisa: Gemini limit "
"je po projektu, a više naloga napravljenih da se sabiraju besplatni limiti "
"znači zaobilaženje limita, što Google uslovi zabranjuju."

msgid ""
"Pentru subtitrări multe pune în setări și servicii de rezervă, de exemplu "
"Azure Translator: când Groq dă eroarea 429, receptorul trece singur la "
"următorul."
