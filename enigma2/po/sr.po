msgid ""
"Receptorul pornește imaginea din memoria lui internă în locul celei de acum. "
"Pe televizor: __DRUM_FLASH__."
msgstr ""
"Prijemnik pokreće image iz svoje interne memorije umesto trenutnog. Na "
"televizoru: __DRUM_FLASH__."

msgid ""
"Receptorul pornește pe rând fiecare canal din listă și notează ce se află "
"numai când canalul chiar rulează: rezoluția, cadrele pe secundă, codarea "
"imaginii, accesul (liber sau criptat), PID-urile și pistele de sunet și "
"subtitrare. Cât merge, televizorul e ocupat: imaginea se schimbă singură. "
"Orice tastă de pe telecomandă oprește scanarea detaliată, iar receptorul "
"revine la canalul de dinainte. Data viitoare scanarea detaliată continuă de "
"unde a rămas."
msgstr ""
"Prijemnik redom pokreće svaki kanal iz liste i beleži ono što se može "
"saznati samo dok kanal zaista radi: rezoluciju, slike u sekundi, kodiranje "
"slike, pristup (slobodan ili šifrovan), PID-ove i zvučne i titlovne zapise. "
"Dok to traje, televizor je zauzet: slika se menja sama. Bilo koji taster na "
"daljinskom zaustavlja detaljnu pretragu i prijemnik se vraća na prethodni "
"kanal. Sledeći put detaljna pretraga nastavlja tamo gde je stala."

msgid "Receptorul pornește și trece pe canal."
msgstr "Prijemnik se uključuje i prelazi na kanal."

msgid "Receptorul pornește."
msgstr "Prijemnik se pokreće."

msgid "Receptorul potrivește singur contrastul după fiecare scenă."
msgstr "Prijemnik sam prilagođava kontrast svakoj sceni."

msgid "Receptorul pregătește deja o poză. Încearcă din nou peste câteva clipe."
msgstr "Prijemnik već priprema sliku. Pokušaj ponovo za nekoliko trenutaka."

msgid ""
"Receptorul primește semnalul unei telecomenzi cu infraroșu, dar nu îl poate "
"folosi încă."
msgstr ""
"Prijemnik prima signal infracrvenog daljinskog upravljača, ali još ne može "
"da ga koristi."

msgid "Receptorul pune deja un ecran. Încearcă din nou peste câteva clipe."
msgstr "Prijemnik već postavlja ekran. Pokušaj ponovo za nekoliko trenutaka."

msgid "Receptorul repornește o dată acum, ca să intre rețeaua din copie."
msgstr ""
"Prijemnik se sada jednom ponovo pokreće da bi mreža iz kopije stupila na "
"snagu."

msgid "Receptorul repornește. Pagina merge din nou după pornire."
msgstr ""
"Prijemnik se ponovo pokreće. Stranica će ponovo raditi posle pokretanja."

msgid "Receptorul repornește. Pagina se poate reîncărca după două minute."
msgstr ""
"Prijemnik se ponovo pokreće. Stranica se može ponovo učitati za dva minuta."

msgid ""
"Receptorul s-a oprit neașteptat de două ori cu procesorul accelerat. Am "
"trecut înapoi pe modul Normal."
msgstr ""
"Prijemnik se neočekivano zaustavio dva puta sa ubrzanim procesorom. Vratili "
"smo se na Normalni režim."

msgid "Receptorul s-a răcit. Procesorul lucrează din nou la viteza obișnuită."
msgstr "Prijemnik se ohladio. Procesor ponovo radi uobičajenom brzinom."

#, python-format
msgid ""
"Receptorul s-a încălzit (%d °C). Procesorul lucrează mai încet până se "
"răcește."
msgstr "Prijemnik se zagrejao (%d °C). Procesor radi sporije dok se ne ohladi."

msgid "Receptorul s-a încălzit și își încetinește singur procesorul."
msgstr "Prijemnik se zagrejao i sam usporava svoj procesor."

msgid "Receptorul s-a încălzit. Procesorul lucrează mai încet până se răcește."
msgstr "Prijemnik se zagrejao. Procesor radi sporije dok se ne ohladi."

#, python-format
msgid "Receptorul s-a întors pe %s: internetul merge din nou acolo."
msgstr "Prijemnik se vratio na %s: internet tamo ponovo radi."

msgid ""
"Receptorul sau televizorul nu e gata. „Ca la televizor” se aplică singur "
"când e gata."
msgstr ""
"Prijemnik ili TV nije spreman. „Kao na televizoru“ se primenjuje sam kad "
"bude spreman."

msgid "Receptorul scrie încă bucata de dinainte. Încearcă din nou."
msgstr "Prijemnik još piše prethodni deo. Pokušaj ponovo."

#, python-format
msgid "Receptorul se apără singur de căldură: încetinește la %d °C."
msgstr "Prijemnik se sam štiti od toplote: usporava na %d °C."

msgid ""
"Receptorul se oprește de tot și se pornește din nou din butonul de pornire "
"al telecomenzii. Pe televizor: __DRUM_OPRIRE__."
msgstr ""
"Prijemnik se potpuno isključuje i ponovo uključuje dugmetom za uključivanje "
"na daljinskom upravljaču. Na televizoru: __DRUM_OPRIRE__."

msgid "Receptorul se oprește."
msgstr "Prijemnik se isključuje."

msgid "Receptorul se pornește din nou din butonul de pornire al telecomenzii."
msgstr ""
"Prijemnik se ponovo uključuje tasterom za uključivanje na daljinskom "
"upravljaču."

msgid ""
"Receptorul se repornește. Pagina se reîncarcă singură când răspunde din nou."
msgstr ""
"Prijemnik se ponovo pokreće. Stranica se sama ponovo učitava kada ponovo "
"odgovori."

#, python-format
msgid ""
"Receptorul se răcește (%d °C). Procesorul revine la viteza obișnuită după %s."
msgstr ""
"Prijemnik se hladi (%d °C). Procesor se vraća na uobičajenu brzinu za %s."

#, python-format
msgid "Receptorul se răcește. Procesorul revine la viteza obișnuită după %s."
msgstr "Prijemnik se hladi. Procesor se vraća na uobičajenu brzinu za %s."

#, python-format
msgid ""
"Receptorul transmite deja spre %s. Oprește acea transmisie din pagina TV în "
"browser sau de pe televizor."
msgstr ""
"Prijemnik već prenosi ka %s. Zaustavi taj prenos sa stranice TV u pregledaču "
"ili sa televizora."

msgid ""
"Receptorul trebuie repornit din meniu pentru ca imaginea sa ramana stabila."
msgstr ""
"Prijemnik mora biti ponovo pokrenut iz menija da bi image ostao stabilan."

msgid "Receptorul trebuie repornit din meniu."
msgstr "Prijemnik mora biti ponovo pokrenut iz menija."

msgid "Receptorul trece în standby."
msgstr "Prijemnik prelazi u stanje pripravnosti."

#, python-format
msgid ""
"Receptorul trimite deja cât poate deodată: %d înregistrări aceluiași aparat, "
"%d în total. Încearcă din nou după ce se oprește una."
msgstr ""
"Prijemnik već šalje koliko može odjednom: %d snimka istom uređaju, %d "
"ukupno. Pokušaj ponovo kada se jedan zaustavi."

msgid ""
"Receptorul trimite și o amprentă calculată din placa lui, ca să fie numărat "
"o singură dată chiar dacă e instalat în mai multe sloturi sau reinstalat. "
"Din amprentă nu se pot afla adresa MAC sau seria, iar acestea nu pleacă de "
"pe receptor."
msgstr ""
"Prijemnik takođe šalje otisak izračunat iz njegove ploče, tako da se broji "
"samo jednom čak i kada je instaliran u više slotova ili ponovo instaliran. "
"Iz otiska se ne mogu saznati MAC adresa ili serijski broj, i oni ne "
"napuštaju prijemnik."

#, python-format
msgid "Receptorul tău: %(model)s, placa %(hw)s, procesor %(cip)s."
msgstr "Tvoj prijemnik: %(model)s, ploča %(hw)s, procesor %(cip)s."

msgid ""
"Receptorul verifică singur, în fundal, dacă are internet: trimite o "
"întrebare DNS mică spre serverele publice 1.1.1.1, 9.9.9.9 și 8.8.8.8, fără "
"date despre tine. La orice schimbare a rețelei (cablul, Wi-Fi, adresa) "
"verifică pe loc. Aceeași setare pe televizor: Meniu &gt; Setări &gt; Rețea "
"și Internet &gt; Verificarea internetului."
msgstr ""
"Prijemnik sam proverava u pozadini da li ima internet: šalje mali DNS upit "
"javnim serverima 1.1.1.1, 9.9.9.9 i 8.8.8.8, bez podataka o tebi. Pri svakoj "
"promeni mreže (kabl, Wi-Fi, adresa) odmah proverava. Isto podešavanje na "
"televizoru: Meni &gt; Podešavanja &gt; Mreža i Internet &gt; Provera "
"interneta."

msgid ""
"Receptorul verifică singur, în fundal, dacă are internet: trimite o "
"întrebare DNS mică spre serverele publice 1.1.1.1, 9.9.9.9 și 8.8.8.8, fără "
"date despre tine. La orice schimbare a rețelei (cablul, Wi-Fi, adresa) "
"verifică pe loc. Pictograma din bară arată rezultatul."
msgstr ""
"Prijemnik sam, u pozadini, proverava da li ima internet: šalje mali DNS upit "
"javnim serverima 1.1.1.1, 9.9.9.9 i 8.8.8.8, bez podataka o tebi. Pri svakoj "
"promeni mreže (kabl, Wi-Fi, adresa) odmah proverava. Ikona u traci prikazuje "
"rezultat."

msgid ""
"Receptorul încă lucrează. Reîncarcă pagina peste puțin timp ca să vezi "
"rezultatul."
msgstr ""
"Prijemnik još radi. Ponovo učitaj stranicu za kratko vreme da vidiš rezultat."

msgid ""
"Receptorul întreabă scurt aparatele din rețeaua ta: servere media, "
"calculatoare cu Windows, NAS-uri. Nimic nu pleacă în afara rețelei.\n"
"Un calculator care nu apare se adaugă de mână, cu adresa lui."
msgstr ""
"Prijemnik kratko pita uređaje na tvojoj mreži: medijske servere, računare sa "
"Windows-om, NAS uređaje. Ništa ne izlazi iz mreže.\n"
"Računar koji se ne pojavi dodaje se ručno, sa njegovom adresom."

msgid ""
"Receptorul întreabă scurt aparatele din rețeaua ta: serverele media (DLNA), "
"calculatoarele cu Windows și NAS-urile cu dosare partajate, serverele care "
"se anunță (NFS, WebDAV, FTP). Nimic nu pleacă în afara rețelei tale și nimic "
"nu se caută singur."
msgstr ""
"Prijemnik kratko pita uređaje na tvojoj mreži: medijske servere (DLNA), "
"računare sa Windows-om i NAS uređaje sa deljenim fasciklama, servere koji se "
"sami oglašavaju (NFS, WebDAV, FTP). Ništa ne izlazi iz tvoje mreže i ništa "
"se ne traži samo."

msgid ""
"Receptorul întreabă serverul HD Satelit ce oraș arată adresa lui de "
"internet. Locul se schimbă numai după ce îl confirmi."
msgstr ""
"Prijemnik pita server HD Satelit koji grad pokazuje njegova internet adresa. "
"Mesto se menja tek nakon što ga potvrdiš."

