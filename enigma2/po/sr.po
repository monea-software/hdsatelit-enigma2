msgstr ""
"Server ne odgovara. Proveri da li je uključen i u istoj mreži kao prijemnik."

msgid "Serverul nu răspunde. Încearcă alt server sau TCP în loc de UDP."
msgstr "Server ne odgovara. Pokušaj drugi server ili TCP umesto UDP."

msgid "Serverul poate fi numai LibreTranslate sau compatibil OpenAI."
msgstr "Server može biti samo LibreTranslate ili kompatibilan sa OpenAI."

msgid "Serverul refuză legătura. Încearcă alt server."
msgstr "Server odbija vezu. Pokušaj drugi server."

msgid "Serverul șterge tot ce a trimis acest receptor."
msgstr "Server briše sve što je ovaj prijemnik poslao."

