msgid ""
"O dată pe zi, noaptea, numai felurile bifate, și imediat după o oprire "
"neașteptată a interfeței sau o actualizare care nu a reușit. Fără bifă "
"pleacă numai ce trimiți tu cu „Trimite acum”."
msgstr ""
"Jednom dnevno, noću, samo označene vrste, i odmah nakon neočekivanog "
"zaustavljanja interfejsa ili neuspelog ažuriranja. Bez oznake odlazi samo "
"ono što sam pošalješ pomoću „Pošalji sada“."

msgid ""
"O dată pe zi, în fundal, receptorul ia de pe stb.hdsatelit.com frecvențele "
"și numele posturilor. Butonul „Actualizează lista” merge oricând. <span "
"id=\"ultimaZilnica\"></span>"
msgstr ""
"Jednom dnevno, u pozadini, prijemnik preuzima sa stb.hdsatelit.com "
"frekvencije i imena stanica. Dugme „Ažuriraj listu” radi u svakom trenutku. "
"<span id=\"ultimaZilnica\"></span>"

msgid "O eroare pe receptor."
msgstr "Greška na prijemniku."

msgid "O greșeală, o idee sau o întrebare, direct echipei."
msgstr "Greška, ideja ili pitanje, direktno timu."

msgid "O lipești, iar receptorul recunoaște singur serviciul."
msgstr "Nalepiš je, a prijemnik sam prepoznaje servis."

msgid ""
"O listă de redare de pe disc nu se poate șterge din player, nici pe "
"televizor."
msgstr "Plejlista sa diska se ne može obrisati iz plejera, ni na televizoru."

msgid "O margine e între 0 și 5 la sută din latura ei."
msgstr "Ivica je između 0 i 5 posto svoje strane."

msgid "O notă despre emisiune. OK deschide tastatura."
msgstr "Napomena o emisiji. OK otvara tastaturu."

msgid "O pagină mai jos"
msgstr "Stranicu dole"

msgid "O pagină mai sus"
msgstr "Stranicu gore"

msgid "O pagină în jos"
msgstr "Stranica dole"

msgid "O pagină în sus"
msgstr "Stranica gore"

msgid ""
"O poză nu a putut fi urcată: trebuie să fie JPG sau PNG, de cel mult 4 MB."
msgstr ""
"Slika nije mogla biti otpremljena: mora biti JPG ili PNG, najviše 4 MB."

msgid "O poți instala din nou oricând, din aceeași sursă."
msgstr "Možeš ga ponovo instalirati bilo kada, iz istog izvora."

msgid "O probă DiSEqC e deja deschisă pe televizor. Închide-o întâi."
msgstr "DiSEqC test je već otvoren na televizoru. Prvo ga zatvori."

msgid "O reîmprospătare e deja în lucru."
msgstr "Osvežavanje je već u toku."

msgid "O reîncărcare e deja în curs."
msgstr "Ponovno učitavanje je već u toku."

msgid ""
"O scanare DAB+ sau DVB-T2 e deschisă pe televizor. Așteaptă să se termine "
"sau oprește-o."
msgstr ""
"Pretraga DAB+ ili DVB-T2 je otvorena na televizoru. Sačekaj da se završi ili "
"je zaustavi."

msgid "O singură dată"
msgstr "Jednom"

msgid ""
"O singură dată sau repetat: în fiecare zi, o dată pe săptămână, de luni până "
"vineri sau în zilele alese."
msgstr ""
"Jednom ili ponavljano: svakog dana, jednom nedeljno, od ponedeljka do petka "
"ili u izabranim danima."

msgid "O singură limbă: forumul traduce singur."
msgstr "Jedan jezik: forum prevodi sam."

msgid ""
"O telecomandă USB (sau o tastatură) se bagă în receptor înainte; se vede "
"imediat."
msgstr ""
"USB daljinski upravljač (ili tastaturu) prvo priključi u prijemnik; odmah se "
"prepoznaje."

msgid ""
"O telecomandă cu infraroșu, alta decât a receptorului, nu se poate asocia "
"încă."
msgstr ""
"Infracrveni daljinski upravljač koji nije od prijemnika još ne može da se "
"upari."

msgid "O valoare a transponderului nu e bună: %s."
msgstr "Jedna vrednost transpondera nije dobra: %s."

msgid "O înregistrare e în curs."
msgstr "Snimanje je u toku."

msgid "O înregistrare e în curs: se oprește la revenire."
msgstr "Snimanje je u toku: zaustavlja se pri povratku."

msgid ""
"O înregistrare folosește acum antena. Comenzile pornesc după ce se termină."
msgstr "Snimanje sada koristi antenu. Komande kreću kada se završi."

msgid ""
"O înregistrare folosește acum tunerul. Locul se schimbă după ce se termină."
msgstr "Snimanje sada koristi tuner. Lokacija se menja kada se završi."

msgid "O înregistrare programată nu poate porni: nu am unde să înregistrez."
msgstr "Zakazano snimanje ne može da počne: nemam gde da snimam."

#, python-format
msgid "O înregistrare scrie acum pe acest disc: %s."
msgstr "Snimanje sada piše na ovaj disk: %s."

msgid "O înregistrare începe în curând. Pornește scanarea detaliată după ea."
msgstr "Snimanje uskoro počinje. Pokreni detaljnu pretragu posle njega."

#, python-format
msgid "O înregistrare începe în mai puțin de %d minute."
msgstr "Snimanje počinje za manje od %d minuta."

msgid "O înregistrare începe în mai puțin de 6 minute."
msgstr "Snimanje počinje za manje od 6 minuta."

msgid "OK"
msgstr "OK"

msgid "OK = da, EXIT = nu"
msgstr "OK = da, EXIT = ne"

msgid "OK actualizează · Roșu șterge"
msgstr "OK ažurira · Crveno briše"

msgid "OK adaugă"
msgstr "OK dodaje"

msgid ""
"OK adaugă canalul în buchetul din dreapta · cifrele scriu numele · HELP "
"ajutor"
msgstr "OK dodaje kanal u buket sa desne strane · cifre pišu ime · HELP pomoć"

msgid "OK add to playlist, MENU options, CH+ / CH- switch list"
msgstr "OK dodaj u listu, MENU opcije, CH+ / CH− promeni listu"

msgid "OK alege"
msgstr "OK bira"

msgid "OK alege capturile, Verde le pune în mesaj."
msgstr "OK bira snimke, Zeleno ih stavlja u poruku."

msgid "OK alege feedul pachetelor arătate."
msgstr "OK bira feed prikazanih paketa."

msgid "OK alege feedul sau felul pachetelor arătate."
msgstr "OK bira feed ili vrstu prikazanih paketa."

msgid ""
"OK alege latura: toate, sus, dreapta, jos sau stânga. Săgeata spre margine "
"duce latura aleasă spre marginea ecranului, săgeata opusă o aduce spre "
"mijloc. La toate laturile, Sus și Dreapta măresc cadrul, Jos și Stânga îl "
"micșorează. Potrivește cadrul până se vede întreg pe televizor."
msgstr ""
"OK bira stranu: sve, gore, desno, dole ili levo. Strelica prema ivici pomera "
"izabranu stranu prema ivici ekrana, suprotna strelica je vraća prema "
"sredini. Kod svih strana, Gore i Desno povećavaju okvir, Dole i Levo ga "
"smanjuju. Podesi okvir dok se ceo ne vidi na televizoru."

msgid ""
"OK alege orașul. Ora lui apare când „Ora din alt oraș” e în lista de rotire."
msgstr ""
"OK bira grad. Njegovo vreme se pojavljuje kada je „Vreme u drugom gradu” u "
"rotirajućoj listi."

msgid "OK alege valoarea."
msgstr "OK bira vrednost."

msgid "OK alege valoarea. Luminozitatea se aplică după salvare."
msgstr "OK bira vrednost. Osvetljenost se primenjuje nakon čuvanja."

msgid "OK alege valoarea. Se aplică după salvare."
msgstr "OK bira vrednost. Primenjuje se posle čuvanja."

msgid "OK alege · Roșu arată tot"
msgstr "OK bira · Crveno prikazuje sve"

msgid ""
"OK alegi canalele ale căror piste se citesc acum · Stânga înapoi la nume"
msgstr "OK biraš kanale čiji se zapisi sada čitaju · Levo nazad na ime"

msgid "OK arată canalele"
msgstr "OK prikazuje kanale"

msgid "OK arată de ce"
msgstr "OK prikazuje zašto"

msgid "OK arată de ce · Verde instalează înlocuitorul"
msgstr "OK prikazuje zašto · Zeleno instalira zamenu"

msgid ""
"OK arată fișierele de setări ale serverelor SSH și FTP, așa cum sunt pe "
"receptor."
msgstr ""
"OK prikazuje fajlove podešavanja servera SSH i FTP onako kako su na "
"prijemniku."

msgid ""
"OK arată fișierele de setări ale serverului SSH, așa cum sunt pe receptor."
msgstr ""
"OK prikazuje fajlove podešavanja SSH servera, onako kako su na prijemniku."

msgid "OK ascunde canalele"
msgstr "OK sakriva kanale"

msgid "OK bifează sau debifează"
msgstr "OK označava ili uklanja oznaku"

msgid "OK bifează sau debifează · pe titlul grupei: toată grupa"
msgstr "OK označava ili uklanja oznaku · na naslovu grupe: celu grupu"

msgid ""
"OK bifează și trece mai jos · tastele colorate lucrează pe rândurile bifate"
msgstr "OK označava i ide niže · dugmad u boji rade na označenim redovima"

msgid "OK caută"
msgstr "OK traži"

msgid ""
"OK caută singur serverul din casă (LibreTranslate sau Ollama) și îl "
"probează. Adresa se poate scrie și de mână, mai jos."
msgstr ""
"OK sam traži server u kući (LibreTranslate ili Ollama) i proverava ga. "
"Adresa se može upisati i ručno, ispod."

msgid "OK caută în rețea"
msgstr "OK pretražuje mrežu"

msgid "OK deschide"
msgstr "OK otvara"

msgid ""
"OK deschide adresele puse de mână, listele predefinite și pornirea DVB-I."
msgstr ""
"OK otvara ručno dodate adrese, predefinisane liste i uključivanje DVB-I-ja."

msgid ""
"OK deschide buchetul · Stânga / Dreapta: coloana · < anulează · > refă · "
"HELP ajutor"
msgstr ""
"OK otvara buket · Levo / Desno: kolona · < poništi · > ponovi · HELP pomoć"

msgid ""
"OK deschide lista limbilor: cele din imagine, cele descărcate și cele care "
"se pot descărca, cu mărimea fiecăreia."
msgstr ""
"OK otvara listu jezika: one iz sistema, preuzete i one koje se mogu "
"preuzeti, sa veličinom svakog."

msgid "OK deschide meniul, cu „Locul înregistrărilor”."
msgstr "OK otvara meni, sa „Mesto snimanja“."

msgid ""
"OK deschide pașii pentru serviciul ales: contul, cheia gratuită, cota și ce "
"se întâmplă la depășire."
msgstr ""
"OK otvara korake za izabrani servis: nalog, besplatni ključ, kvotu i šta se "
"dešava pri prekoračenju."

msgid "OK deschide sau închide toți sateliții"
msgstr "OK otvara ili zatvara sve satelite"

msgid "OK deschide tastatura."
msgstr "OK otvara tastaturu."

msgid ""
"OK deschide tastatura. ID-ul contului are 32 de litere și cifre: în panoul "
"Cloudflare, la „Account ID”."
msgstr ""
"OK otvara tastaturu. ID naloga ima 32 slova i cifre: u Cloudflare panelu, "
"pod „Account ID“."

msgid ""
"OK deschide tastatura. Textul apare când „Textul tău” e în lista de rotire."
msgstr ""
"OK otvara tastaturu. Tekst se pojavljuje kada je „Tvoj tekst” u rotirajućoj "
"listi."

msgid ""
"OK deschide · Stânga / Dreapta: coloana · cifrele scriu numele · HELP ajutor"
msgstr "OK otvara · Levo / Desno: kolona · cifre pišu ime · HELP pomoć"

msgid "OK deschide · cifrele: poziția · < anulează · > refă · HELP ajutor"
msgstr "OK otvara · cifre: pozicija · < poništi · > ponovi · HELP pomoć"

msgid "OK full screen, INFO details, EXIT back to the list"
msgstr "OK ceo ekran, INFO detalji, EXIT nazad na listu"

msgid ""
"OK ia rândul ca să-l muți · cifrele: poziția · < anulează · > refă · HELP "
"ajutor"
msgstr ""
"OK uzima red da ga premestiš · cifre: pozicija · < poništi · > ponovi · HELP "
"pomoć"

msgid "OK instalează"
msgstr "OK instalira"

msgid "OK instalează fișierul"
msgstr "OK instalira datoteku"

msgid "OK le deschide"
msgstr "OK ih otvara"

msgid "OK o arată acum pe afișaj, o dată."
msgstr "OK ga sada prikazuje na ekranu, jednom."

msgid "OK oprește VPN-ul. Internetul merge apoi direct, prin rețeaua ta."
msgstr "OK zaustavlja VPN. Internet zatim ide direktno, kroz tvoju mrežu."

msgid ""
"OK oprește. Oricine din rețeaua ta de acasă intră acum pe receptor fără "
"parolă."
msgstr ""
"OK isključuje. Sada svako iz tvoje kućne mreže ulazi na prijemnik bez "
"lozinke."

msgid "OK pe o pagină: deschide-o sau scoate-o din favorite."
msgstr "OK na stranici: otvori je ili ukloni iz favorita."

msgid ""
"OK pe un rând deschide tastatura. Parola nu se arată: o scrii numai când "
"vrei s-o schimbi; un rând gol o lasă cum e."
msgstr ""
"OK na redu otvara tastaturu. Lozinka se ne prikazuje: upisuješ je samo kada "
"želiš da je promeniš; prazan red je ostavlja kakva jeste."

msgid "OK pornește VPN-ul cu serverul ales."
msgstr "OK pokreće VPN sa izabranim serverom."

msgid "OK pornește canalul · Stânga/Dreapta: pagina · Sus la filtre"
msgstr "OK pokreće kanal · Levo/Desno: stranica · Gore na filtere"

msgid ""
"OK pornește sau oprește, pe loc. Se vede când e în lista de rotire (grupa "
"„Ora și data”)."
msgstr ""
"OK odmah pokreće ili zaustavlja. Vidi se kada je u rotirajućoj listi (grupa "
"„Vreme i datum”)."

msgid "OK probează"
msgstr "OK proba"

msgid "OK pune contorul la zero."
msgstr "OK resetuje brojač."

#, python-format
msgid "OK pune ecranul „%s”. Se vede la următoarea pornire."
msgstr "OK postavlja ekran „%s“. Prikazaće se pri sledećem pokretanju."

msgid "OK salvează alegerile și închide ecranul."
msgstr "OK čuva izbore i zatvara ekran."

msgid "OK sau Albastru descarcă lista"
msgstr "OK ili Plavo preuzima listu"

msgid "OK sau EXIT închide fereastra și anulează codul."
msgstr "OK ili EXIT zatvara prozor i poništava kod."

msgid "OK sau EXIT închide fereastra."
msgstr "OK ili EXIT zatvara prozor."

msgid "OK sau EXIT: înapoi"
msgstr "OK ili EXIT: nazad"

msgid "OK sau EXIT: închide"
msgstr "OK ili EXIT: zatvori"

msgid "OK sau Ieșire închide."
msgstr "OK ili Izlaz zatvara."

msgid "OK sau TEXT: scrie"
msgstr "OK ili TEXT: piši"

msgid "OK sau VERDE: copia se face acum pe locul ales la „Locul copiei”."
msgstr ""
"OK ili ZELENO: kopija se pravi sada na mestu izabranom u „Mesto kopije“."

#, python-format
msgid "OK scoate sau pune lista. Furnizor: %s."
msgstr "OK uklanja ili dodaje listu. Provajder: %s."

msgid ""
"OK trimite o frază de probă serviciului ales. Răspunsul apare aici, iar "
"originalul și traducerea se văd jos, ca subtitrările."
msgstr ""
"OK šalje probnu rečenicu izabranom servisu. Odgovor se pojavljuje ovde, a "
"original i prevod se vide dole, kao titlovi."

msgid ""
"OK încearcă din nou toate canalele, din casa ta. Cele oprite pentru țara ta "
"se pot vedea cu VPN-ul receptorului pornit."
msgstr ""
"OK ponovo proverava sve kanale, iz tvog doma. Oni blokirani za tvoju zemlju "
"mogu se gledati sa uključenim VPN-om prijemnika."

msgid ""
"OK șterge cheia. Calculatorul cu această cheie intră apoi numai cu parola."
msgstr "OK briše ključ. Računar sa ovim ključem zatim ulazi samo sa lozinkom."

msgid "OK — schimba valorile cu OK/stanga/dreapta, cauta cu Verde."
msgstr "OK - menjaj vrednosti sa OK/levo/desno, traži zelenim tasterom."

msgid "OK: alege · STÂNGA/DREAPTA: schimbă"
msgstr "OK: izaberi · LEVO/DESNO: promeni"

msgid "OK: alegi modelul din listă (sau îl scrii). Cel din fabrică: %s."
msgstr "OK: biraš model sa liste (ili ga upišeš). Podrazumevani: %s."

msgid "OK: alegi poza de pe stick."
msgstr "OK: biraš sliku sa USB memorije."

msgid ""
"OK: alegi regiunea din listă. O găsești în portal, la resursa Translator: "
"Overview › Location. Global pentru o resursă Global."
msgstr ""
"OK: biraš region sa liste. Naći ćeš ga na portalu, kod resursa Translator: "
"Overview › Location. Global za Global resurs."

msgid "OK: ce faci cu copia. GALBEN: pune la loc. ALBASTRU: șterge."
msgstr "OK: šta da radiš sa kopijom. ŽUTO: vrati. PLAVO: obriši."

msgid "OK: cod QR"
msgstr "OK: QR kod"

msgid "OK: copia nu se mai pune la loc."
msgstr "OK: kopija se više ne vraća."

msgid "OK: descarci, oprești sau ștergi modelul    EXIT: închide"
msgstr "OK: preuzimaš, zaustavljaš ili brišeš model    EXIT: zatvori"

msgid ""
"OK: intri în dosar sau pornești filmul.\n"
"INAPOI: dosarul de mai sus.\n"
"Subtitrările de lângă film se iau singure; tasta SUB le arată pe toate și "
"caută pe internet."
msgstr ""
"OK: ulaziš u fasciklu ili pokrećeš film.\n"
"NAZAD: fascikla iznad.\n"
"Titlovi pored filma se preuzimaju sami; taster SUB ih prikazuje sve i traži "
"na internetu."

msgid "OK: lista paginilor favorite."
msgstr "OK: lista omiljenih stranica."

msgid "OK: lista posturilor.   OK ținut apăsat: opțiunile."
msgstr "OK: lista stanica.   Držanje OK: opcije."

#, python-format
msgid "OK: lista serverelor (%d). Fără servere, importă întâi fișierele."
msgstr "OK: lista servera (%d). Bez servera, prvo uvezi datoteke."

msgid "OK: mută, durata sau scoate."
msgstr "OK: pomeri, trajanje ili ukloni."

msgid "OK: mută, durata, eticheta sau scoate."
msgstr "OK: pomeri, trajanje, etiketa ili ukloni."

msgid "OK: mărește poza."
msgstr "OK: uvećaj sliku."

msgid "OK: mărește poza. Stânga și Dreapta: celelalte poze."
msgstr "OK: uvećaj sliku. Levo i Desno: ostale slike."

msgid "OK: pagina web a aparatului, în navigator."
msgstr "OK: veb stranica uređaja, u pregledaču."

#, python-format
msgid "OK: pui ecranul „%s” sau îl ștergi din galerie."
msgstr "OK: postavljaš ekran „%s“ ili ga brišeš iz galerije."

#, python-format
msgid "OK: pui sau ștergi poza ta „%s”."
msgstr "OK: postavljaš ili brišeš svoju sliku „%s“."

msgid "OK: salvează. EXIT: renunță."
msgstr "OK: sačuvaj. EXIT: odustani."

msgid "OK: scrie mesajul cu tastatura de pe ecran."
msgstr "OK: napiši poruku pomoću tastature na ekranu."

msgid "OK: scrie titlul."
msgstr "OK: upiši naslov."

msgid ""
"OK: scrii o cheie nouă sau o ștergi. Cheia se păstrează pe receptor, "
"criptată, și nu se mai arată niciodată. Albastru: cum îți faci cheia "
"gratuită."
msgstr ""
"OK: upisuješ novi ključ ili ga brišeš. Ključ se čuva na prijemniku, "
"šifrovan, i više se nikada ne prikazuje. Plavo: kako da napraviš svoj "
"besplatni ključ."

msgid "OK: tastatura"
msgstr "OK: tastatura"

msgid "OK: textul licenței    Stânga/Dreapta: pagina    EXIT: închide"
msgstr "OK: tekst licence    Levo/Desno: stranica    EXIT: zatvori"

msgid ""
"OK: un cod QR pentru telefon. Pe telefon îți faci cheia și o lipești; "
"receptorul o probează pe loc."
msgstr ""
"OK: QR kod za telefon. Na telefonu praviš svoj ključ i lepiš ga; prijemnik "
"ga odmah proverava."

msgid "OK: îl adaugi"
msgstr "OK: dodaješ ga"

msgid "OK: întoarce lista la copia aleasă"
msgstr "OK: vraća listu na izabranu kopiju"

msgid ""
"OK: șterge cookie-urile și datele salvate de aplicațiile HbbTV ale canalelor "
"(de exemplu alegerea din fereastra de consimțământ)."
msgstr ""
"OK: briše kolačiće i podatke koje su sačuvale HbbTV aplikacije kanala (na "
"primer izbor u prozoru saglasnosti)."

msgid ""
"OK: șterge istoricul, cookie-urile, datele site-urilor și mărirea ținută "
"minte."
msgstr "OK: briše istoriju, kolačiće, podatke sajtova i zapamćeno uvećanje."

#, python-format
msgid ""
"ON ID %d, iar în lista satelitului e %d. Antena poate fi pe alt satelit."
msgstr ""
"ON ID %d, a na listi satelita je %d. Antena je možda na drugom satelitu."

msgid "ON ID:"
msgstr "ON ID:"

msgid "ON sau OFF"
msgstr "Uključeno ili isključeno"

msgid "ONID"
msgstr "ONID"

msgid "OSD Preferences"
msgstr "Opšta podešavanja"

msgid "OSD Settings"
msgstr "OSD podešavanja"

msgid "OUI %s, modelul %s, versiunea %s"
msgstr "OUI %s, model %s, verzija %s"

msgid "OUI %s, versiunea %s"
msgstr "OUI %s, verzija %s"

msgid "Obișnuit"
msgstr "Normalno"

msgid "Occitan"
msgstr "Oksitanski"

#, python-format
msgid "Ocupat acum pe disc: %s."
msgstr "Zauzeto sada na disku: %s."

#, python-format
msgid "Ocupat: %s"
msgstr "Zauzeto: %s"

msgid "Ocupă"
msgstr "Zauzima"

msgid "Odia"
msgstr "odija"

msgid "Off"
msgstr "Isključeno"

msgid ""
"Off at first. On: the big fills of the screen are done by the video card, "
"the rest is drawn by the processor. If the card works wrong, the receiver "
"goes back to the processor by itself. Used from the next start of the "
"interface."
msgstr ""
"Na početku isključeno. Uključeno: velike popune ekrana radi grafička "
"kartica, ostalo crta procesor. Ako kartica radi pogrešno, prijemnik se sam "
"vraća na procesor. Koristi se od sledećeg pokretanja interfejsa."

msgid "Olanda"
msgstr "Holandija"

msgid "Olandeză"
msgstr "Holandski"

