msgid ""
"Televizorul nu a spus ce sunet primește (poate e stins), deci receptorul "
"trimite stereo."
msgstr ""
"Televizor nije rekao koji zvuk prima (možda je isključen), pa prijemnik "
"šalje stereo."

msgid "Televizorul nu a trecut pe acest canal."
msgstr "Televizor nije prešao na ovaj kanal."

#, python-format
msgid ""
"Televizorul nu primește %(format)s, deci receptorul îl decodează și trimite "
"stereo."
msgstr ""
"Televizor ne prima %(format)s, pa ga prijemnik dekodira i šalje stereo."

msgid ""
"Televizorul nu răspunde la CEC. Pornește SIMPLINK (sau CEC) din setările "
"televizorului."
msgstr ""
"Televizor ne odgovara na CEC. Uključi SIMPLINK (ili CEC) u podešavanjima "
"televizora."

