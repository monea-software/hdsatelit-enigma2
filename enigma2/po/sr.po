msgstr ""
"Ovaj pregledač ne može dekodirati HEVC (H.265) sliku ovog kanala, na primer "
"4K sa 10 bita. Otvori ga u kućnom plejeru sa plejlistom ispod."

msgid ""
"Acest browser nu poate decoda imaginea HEVC (H.265) a acestui canal, de "
"pildă 4K pe 10 biți. Încearcă alt browser sau un player din casă."
msgstr ""
"Ovaj pregledač ne može dekodirati HEVC (H.265) sliku ovog kanala, na primer "
"4K sa 10 bita. Pokušaj drugi pregledač ili kućni plejer."

msgid ""
"Acest browser nu poate reda fluxul (îi lipsește MediaSource). Încearcă "
"Chrome, Edge, Firefox sau Safari nou."
msgstr ""
"Ovaj pregledač ne može da reprodukuje stream (nedostaje mu MediaSource). "
"Probaj noviji Chrome, Edge, Firefox ili Safari."

msgid ""
"Acest browser rămâne conectat. Scripturile care folosesc cheia veche nu mai "
"merg până primesc cheia nouă."
msgstr ""
"Ovaj pregledač ostaje povezan. Skripte koje koriste stari ključ ne rade dok "
"ne dobiju novi."

msgid "Acest browser:"
msgstr "Ovaj pregledač:"

msgid "Acest canal nu poate fi pus pe pauză."
msgstr "Ovaj kanal se ne može pauzirati."

msgid "Acest canal nu poate fi înregistrat."
msgstr "Ovaj kanal ne može da se snima."

msgid ""
"Acest canal trimite imaginea în HEVC, iar acest browser nu o poate reda. "
"Încearcă Chrome sau Edge pe un calculator cu placă video nouă, sau Safari."
msgstr ""
"Ovaj kanal šalje sliku u HEVC, a ovaj pregledač ne može da je reprodukuje. "
"Probaj Chrome ili Edge na računaru sa novom grafičkom karticom, ili Safari."

msgid ""
"Acest canal trimite imaginea în MPEG-2, iar acest browser nu o poate reda "
"(îi lipsește WebAssembly sau WebGL). Încearcă Chrome, Edge, Firefox sau "
"Safari nou."
msgstr ""
"Ovaj kanal šalje sliku u MPEG-2, a ovaj pregledač ne može da je reprodukuje "
"(nedostaje mu WebAssembly ili WebGL). Probaj novi Chrome, Edge, Firefox ili "
"Safari."

msgid ""
"Acest canal trimite imaginea într-un format pe care browserele nu îl redau."
msgstr "Ovaj kanal šalje sliku u formatu koji pregledači ne reprodukuju."

#, python-format
msgid ""
"Acest ecran nu are marcaje: serviciul curent nu suportă tăieri (de exemplu, "
"televiziune live)."
msgstr ""
"Ovaj ekran nema oznake: trenutni servis ne podržava sečenje (na primer, TV "
"uživo)."

msgid "Acest ecran nu are poză mică de previzualizare."
msgstr "Ovaj ekran nema malu sliku za pregled."

msgid "Acest ecran se folosește pe televizor."
msgstr "Ovaj ekran se koristi na televizoru."

msgid "Acest fel de loc nu se poate monta pe receptor."
msgstr "Ova vrsta mesta ne može da se montira na prijemnik."

