#, python-format
msgid "Paznicul plăcii: pornit, %d secunde."
msgstr "Čuvar ploče: uključen, %d sekundi."

msgid "Paznicul plăcii: pornit."
msgstr "Čuvar ploče: uključen."

msgid "Paznicul receptorului"
msgstr "Čuvar prijemnika"

msgid ""
"Paznicul repornește interfața numai când nu mai dă semn de viață și nici "
"interfața web nu răspunde. În timpul unei scanări, al citirii pistelor sau "
"al unei rotiri de antenă așteaptă. Paznicul plăcii rămâne mereu pornit."
msgstr ""
"Čuvar ponovo pokreće interfejs samo kada više ne daje znak života i ni web "
"interfejs ne odgovara. Tokom pretrage, čitanja zapisa ili rotacije antene "
"čeka. Čuvar ploče uvek ostaje uključen."

msgid ""
"Paznicul repornește interfața numai când nu mai dă semn de viață și nici "
"interfața web nu răspunde. În timpul unei scanări, al citirii pistelor sau "
"al unei rotiri de antenă așteaptă. Paznicul plăcii rămâne mereu pornit. Când "
"memoria decodorului nu mai ajunge, receptorul o eliberează singur după "
"câteva minute de standby, fără înregistrări în curs sau în următoarele 30 de "
"minute: se repornește fără să aprindă televizorul și rămâne în standby. "
"Aceleași setări sunt pe televizor, în __DRUM_MENIU__."
msgstr ""
"Čuvar ponovo pokreće interfejs samo kada više ne daje znake života i ni veb "
"interfejs ne odgovara. Tokom pretrage, čitanja traka ili rotacije antene "
"čeka. Čuvar ploče ostaje uvek uključen. Kada memorija dekodera prestane da "
"bude dovoljna, prijemnik je sam oslobađa posle nekoliko minuta u stanju "
"pripravnosti, bez snimanja u toku ili u narednih 30 minuta: ponovo se "
"pokreće bez paljenja televizora i ostaje u stanju pripravnosti. Ista "
"podešavanja su na televizoru, u __DRUM_MENIU__."

msgid ""
"Paznicul repornește interfața numai când nu mai dă semn de viață și nici "
"interfața web nu răspunde. În timpul unei scanări, al citirii pistelor sau "
"al unei rotiri de antenă așteaptă. Paznicul plăcii rămâne mereu pornit. "
"Repornirea de noapte se face între 3 și 5, numai în standby, numai cu "
"memoria decodorului fărâmițată și fără înregistrări în curs sau în "
"următoarele 30 de minute; receptorul rămâne în standby. Aceleași setări sunt "
"pe televizor, în __DRUM_MENIU__."
msgstr ""
"Čuvar ponovo pokreće interfejs samo kada više ne daje znake života i ni veb "
"interfejs ne odgovara. Tokom pretrage, čitanja zapisa ili okretanja antene "
"čeka. Čuvar ploče uvek ostaje uključen. Noćno ponovno pokretanje se obavlja "
"između 3 i 5, samo u stanju pripravnosti, samo sa fragmentisanom memorijom "
"dekodera i bez snimanja u toku ili u narednih 30 minuta; prijemnik ostaje u "
"stanju pripravnosti. Ista podešavanja su na televizoru, u __DRUM_MENIU__."

msgid "Paznicul supraveghează interfața."
msgstr "Čuvar nadgleda interfejs."

