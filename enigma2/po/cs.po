#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Am găsit regiunea: %s (%s). %s"
msgstr "Oblast nalezena: %s (%s). %s"

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Caută deja. Așteaptă să se termine."
msgstr "Hledání už probíhá. Počkej, až skončí."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Receptorul nu are rețea."
msgstr "Přijímač nemá síť."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Receptorul nu e într-o rețea de acasă (adresă privată); nu caut."
msgstr "Přijímač není v domácí síti (soukromá adresa); nehledám."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Caut servere în rețeaua de acasă..."
msgstr "Hledám servery v domácí síti..."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Am pornit căutarea."
msgstr "Hledání začalo."

#: lib/python/Components/HdsConfigurareTraducere.py
