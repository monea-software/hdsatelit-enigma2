#: lib/python/Screens/HdsLocul.py
msgid "Află locul după internet"
msgstr "Zjistit umístění podle internetu"

#: lib/python/Screens/HdsLocul.py
msgid "Caut locul după adresa de internet a receptorului..."
msgstr "Hledám umístění podle internetové adresy přijímače..."

#: lib/python/Screens/HdsLocul.py
msgid "Receptorul nu are internet acum, deci locul nu se poate afla singur. Alege țara și orașul din listă."
msgstr "Přijímač teď nemá internet, takže umístění nejde zjistit samo. Vyber zemi a město ze seznamu."

#: lib/python/Screens/HdsLocul.py
msgid "Serverul HD Satelit nu a răspuns sau nu poate da locul acum. Alege țara și orașul din listă."
msgstr "Server HD Satelit neodpověděl nebo teď umístění nemůže dát. Vyber zemi a město ze seznamu."

#: lib/python/Screens/HdsLocul.py
msgid "Răspunsul serverului HD Satelit nu se poate folosi. Alege țara și orașul din listă."
msgstr "Odpověď serveru HD Satelit nejde použít. Vyber zemi a město ze seznamu."

#: lib/python/Screens/HdsLocul.py
msgid "După adresa de internet a receptorului nu se știe orașul. Alege țara și orașul din listă."
msgstr "Podle internetové adresy přijímače se město nedá určit. Vyber zemi a město ze seznamu."

#: lib/python/Screens/HdsLocul.py
msgid "Locul s-a cerut de prea multe ori de la această adresă de internet. Încearcă peste un minut sau alege țara și orașul din listă."
msgstr "Umístění se z této internetové adresy žádalo příliš často. Zkus to za minutu nebo vyber zemi a město ze seznamu."

#: lib/python/Screens/HdsLocul.py
msgid "Locul găsit nu mai este cel arătat. Caută din nou sau alege țara și orașul din listă."
msgstr "Nalezené umístění už není to zobrazené. Hledej znovu nebo vyber zemi a město ze seznamu."

#: lib/python/Screens/HdsLocul.py
#, python-format
msgid ""
"Locul găsit după adresa de internet a receptorului:\n"
"\n"
"%(loc)s\n"
"%(coordonate)s\n"
"Sursa: %(sursa)s\n"
"\n"
"De obicei este orașul tău, dar uneori este orașul furnizorului de internet. Folosești acest loc? (Nu: alegi țara și orașul din listă.)"
msgstr ""
"Umístění nalezené podle internetové adresy přijímače:\n"
"\n"
"%(loc)s\n"
"%(coordonate)s\n"
"Zdroj: %(sursa)s\n"
"\n"
"Obvykle je to tvoje město, ale někdy město poskytovatele internetu. Použít toto umístění? (Ne: vybereš zemi a město ze seznamu.)"

#: lib/python/Screens/HdsLocul.py
#, python-format
msgid "Coordonatele orașelor din listă: %s. Receptorul întreabă serverul HD Satelit numai când alegi „Află locul după internet”, iar serverul nu păstrează adresa de internet."
msgstr "Souřadnice měst v seznamu: %s. Přijímač se ptá serveru HD Satelit, jen když zvolíš „Zjistit umístění podle internetu“, a server internetovou adresu neuchovává."

#: lib/python/Screens/HdsLocul.py
