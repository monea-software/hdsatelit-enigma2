msgstr "Jazyk překladu"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Afișarea"
msgstr "Zobrazení"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Traducerea care întârzie"
msgstr "Opožděný překlad"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Și subtitrările DVB (imagini)"
msgstr "I titulky DVB (obrázky)"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Ce s-a tradus"
msgstr "Co se přeložilo"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "pusă (OK schimbă)"
msgstr "zadán (OK změní)"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "lipsește (OK o scrie)"
msgstr "chybí (OK pro zadání)"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "nu trebuie (numai dacă serverul cere)"
msgstr "není potřeba (jen pokud ho server chce)"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "nimic încă"
msgstr "zatím nic"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "%d pagini, %d din memorie"
msgstr "%d stránek, %d z paměti"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Pagini: %d. Din memorie: %d. Traduse după afișare: %d. Sărite: %d. Cereri: "
"%d."
msgstr "Stránky: %d. Z paměti: %d. Přeloženo po zobrazení: %d. Přeskočeno: %d. Požadavky: %d."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Timp mediu: %s."
msgstr "Průměrný čas: %s."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Erori: %d."
msgstr "Chyby: %d."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Ultima eroare (%s): %s"
msgstr "Poslední chyba (%s): %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"OK: scrii o cheie nouă sau o ștergi. Cheia se păstrează pe receptor, "
"criptată, și nu se mai arată niciodată. Albastru: cum îți faci cheia "
"gratuită."
msgstr "OK: zadáš nový klíč nebo ho smažeš. Klíč se uchovává v přijímači, zašifrovaný, a už se nikdy nezobrazí. Modrá: jak si udělat bezplatný klíč."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK deschide tastatura."
msgstr "OK otevře klávesnici."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "De exemplu http://192.168.1.50:5000"
msgstr "Například http://192.168.1.50:5000"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"De exemplu http://192.168.1.50:11434 (Ollama) sau http://192.168.1.50:1234 "
"(LM Studio)."
msgstr "Například http://192.168.1.50:11434 (Ollama) nebo http://192.168.1.50:1234 (LM Studio)."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "De exemplu westeurope. Gol pentru o resursă Global."
msgstr "Například westeurope. Prázdné pro prostředek Global."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "De exemplu gemma3:4b"
msgstr "Například gemma3:4b"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Subtitrările DVB sunt imagini: textul lor se citește întâi cu recunoașterea "
"textului (OCR), apoi se traduce."
msgstr "Titulky DVB jsou obrázky: jejich text se nejdřív přečte rozpoznáváním textu (OCR), potom se přeloží."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Când traducerea nu e gata la timp, se vede originalul. „Se pune când vine”: "
"traducerea îi ia locul cât rândul e pe ecran. „Rămâne originalul”: rândul "
"rămâne netradus."
msgstr "Když překlad není hotový včas, je vidět originál. „Vložit, až přijde“: překlad zaujme jeho místo, dokud je řádek na obrazovce. „Zůstane originál“: řádek zůstane nepřeložený."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Implicit limba meniului. O subtitrare care e deja în limba aleasă nu se "
"trimite."
msgstr "Výchozí je jazyk nabídky. Titulek, který už je ve zvoleném jazyce, se neposílá."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Traducerea apare în locul originalului sau sub el, cu aspectul din «Aspectul "
"subtitrărilor»."
msgstr "Překlad se objeví místo originálu nebo pod ním, se vzhledem z „Vzhled titulků“."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Traducere automată pentru teletext, subtitrările din fișiere și subtitrările "
"DVB."
msgstr "Automatický překlad pro teletext, titulky ze souborů a titulky DVB."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Cheia API pentru %s"
msgstr "Klíč API pro %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Scrie cheia nouă"
msgstr "Zadat nový klíč"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Șterge cheia"
msgstr "Smazat klíč"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Se probează traducerea cu %s..."
msgstr "Zkouší se překlad se službou %s..."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Proba a mers (%s, %s): %s"
msgstr "Zkouška se povedla (%s, %s): %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Proba nu a mers: %s"
msgstr "Zkouška se nepovedla: %s"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Atenție: la Google Cloud facturarea e obligatorie, Google îți cere cardul la înscriere. Peste cota gratuită plătești automat, din card."
msgstr "Pozor: u Google Cloud je fakturace povinná, Google po tobě při registraci chce kartu. Nad bezplatnou kvótou platíš automaticky, z karty."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Sub original, traducerea se scrie cu galben deschis, ca s-o deosebești de original."
msgstr "Pod originálem se překlad píše světle žlutě, abys ho odlišil od originálu."

#: lib/python/Screens/HdsSubtitrariAspect.py
msgid "Recunoașterea textului lucrează și acum: o cere traducerea subtitrărilor."
msgstr "Rozpoznávání textu teď běží i tak: potřebuje ho překlad titulků."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Se probează pe receptor: %s"
msgstr "Zkouška v přijímači: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Gata: %s merge. Proba: %s"
msgstr "Hotovo: %s funguje. Zkouška: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Serverul e prea lent pentru subtitrări la timp. Alege un serviciu din "
"internet (Gemini, gratuit, fără card) sau un model mai mic."
msgstr "Server je příliš pomalý na titulky včas. Vyber službu z internetu (Gemini, zdarma, bez karty) nebo menší model."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Nu a mers: %s"
msgstr "Nepovedlo se: %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Scanează cu telefonul: pagina oficială"
msgstr "Naskenuj telefonem: oficiální stránka"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Configurează de pe telefon"
msgstr "Nastavit z telefonu"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Scanează codul cu camera telefonului. Se deschide pagina receptorului, deja "
"conectată: alegi serviciul, îți faci cheia și o lipești. Receptorul o "
"probează pe loc."
msgstr "Naskenuj kód fotoaparátem telefonu. Otevře se stránka přijímače, už připojená: vybereš službu, uděláš si klíč a vložíš ho. Přijímač ho hned vyzkouší."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "OK sau Ieșire închide."
msgstr "OK nebo EXIT zavře."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid ""
"Receptorul nu are legătură în rețea, deci pagina nu se poate deschide pe "
"telefon."
msgstr "Přijímač nemá připojení k síti, takže stránku nelze otevřít v telefonu."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid ""
