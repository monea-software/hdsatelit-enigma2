msgstr "Rozdíl mezi tmavými a světlými částmi. Mění i nabídky."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Saturație"
msgstr "Sytost"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Cât de puternice sunt culorile. Schimbă și meniurile."
msgstr "Jak výrazné jsou barvy. Mění i nabídky."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Nuanță"
msgstr "Odstín"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Mută culorile spre verde sau spre roșu, pentru fețe naturale. Schimbă și meniurile."
msgstr "Posouvá barvy k zelené nebo k červené, pro přirozené tváře. Mění i nabídky."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Claritate"
msgstr "Ostrost"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Contururi mai precise după mărirea imaginii. Prea mult face margini albe în jurul obiectelor."
msgstr "Přesnější obrysy po zvětšení obrazu. Příliš mnoho dělá bílé okraje kolem předmětů."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Reducerea zgomotului"
msgstr "Potlačení šumu"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Liniștește purecii din imagine de la un cadru la altul. Prea mult lasă urme în spatele mișcării."
msgstr "Uklidňuje zrnění obrazu mezi snímky. Příliš mnoho zanechává stopy za pohybem."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Zgomotul din cadru"
msgstr "Šum ve snímku"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Netezește zonele plate ale fiecărui cadru. Prea mult face fețele și iarba ca de plastic."
msgstr "Vyhlazuje rovné plochy každého snímku. Příliš mnoho dělá tváře a trávu jako z plastu."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Pătrățelele compresiei"
msgstr "Čtverečky komprese"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Șterge marginile pătrățelelor care apar pe canalele cu debit mic."
msgstr "Maže okraje čtverečků, které se objevují na kanálech s nízkým datovým tokem."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Zgomotul de pe contururi"
msgstr "Šum na obrysech"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Șterge tremurul din jurul literelor și al marginilor ascuțite."
msgstr "Maže chvění kolem písmen a ostrých hran."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Contrast adaptiv"
msgstr "Adaptivní kontrast"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Receptorul potrivește singur contrastul după fiecare scenă."
msgstr "Přijímač sám přizpůsobí kontrast každé scéně."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Îmbunătățirea culorilor"
msgstr "Vylepšení barev"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Culori mai vii și pielea mai naturală."
msgstr "Živější barvy a přirozenější pleť."

#: lib/python/Components/HdsCalitateImagine.py
msgid "SD"
msgstr "SD"

#: lib/python/Components/HdsCalitateImagine.py
msgid "HD"
msgstr "HD"

#: lib/python/Components/HdsCalitateImagine.py
msgid "4K"
msgstr "4K"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Automat, după canal"
msgstr "Automaticky, podle kanálu"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Mereu HDR10"
msgstr "Vždy HDR10"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Mereu HLG"
msgstr "Vždy HLG"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Oprită (SDR)"
msgstr "Vypnuto (SDR)"

#: lib/python/Components/HdsCalitateImagine.py lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Reglajele după canal"
msgstr "Nastavení podle kanálu"

#: lib/python/Components/HdsCalitateImagine.py
msgid "calitate imagine profil"
msgstr "kvalita obrazu profil"

#: lib/python/Components/HdsCalitateImagine.py lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Ieșire HDR"
msgstr "Výstup HDR"

#: lib/python/Components/HdsCalitateImagine.py
msgid "claritate imagine ascuțire"
msgstr "ostrost obraz doostření"

#: lib/python/Components/HdsCalitateImagine.py
msgid "zgomot purici"
msgstr "šum zrnění"

#: lib/python/Components/HdsCalitateImagine.py
msgid "culori"
msgstr "barvy"

#: lib/python/Components/HdsCalitateImagine.py
#, python-format
msgid "Imaginea se vede corect cu ieșirea HDR „%s”?"
msgstr "Vypadá obraz s výstupem HDR „%s“ správně?"

#: lib/python/Components/HdsCalitateImagine.py
msgid "Acum nu e nicio imagine (radio sau niciun canal pornit)."
msgstr "Teď není žádný obraz (rádio nebo žádný spuštěný kanál)."

#: lib/python/Components/HdsCalitateImagine.py
#, python-format
msgid "Acum: canal %(clasa)s, %(latime)dx%(inaltime)d, imagine %(dinamica)s."
msgstr "Teď: kanál %(clasa)s, %(latime)dx%(inaltime)d, obraz %(dinamica)s."

#: lib/python/Components/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Televizorul acesta nu primește această ieșire HDR."
msgstr "Tato televize tento výstup HDR nepřijímá."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Pe televizor așteaptă deja o întrebare."
msgstr "Na televizi už čeká otázka."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Ieșirea HDR era deja aceasta."
msgstr "Výstup HDR už byl tento."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Ieșirea HDR nu a fost confirmată. A revenit cea de dinainte."
msgstr "Výstup HDR nebyl potvrzen. Vrátil se ten předchozí."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Ieșirea HDR se folosește când pornește un canal. O păstrezi?"
msgstr "Výstup HDR se použije, když se spustí kanál. Ponecháš ho?"

#: lib/python/Components/HdsCalitateImagine.py
#, python-format
msgid "Uită-te la televizor și răspunde la întrebare în %d de secunde."
msgstr "Podívej se na televizi a odpověz na otázku do %d sekund."

#: lib/python/Components/HdsCalitateImagine.py
#, python-format
msgid "Păstrat: %s."
msgstr "Uloženo: %s."

#: lib/python/Components/HdsCalitateImagine.py
msgid "Întrebarea nu s-a putut deschide pe televizor. A rămas ieșirea de dinainte."
msgstr "Otázku nešlo na televizi otevřít. Zůstal předchozí výstup."

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Ce schimbi se vede pe loc în imaginea de deasupra."
msgstr "Co změníš, uvidíš hned v obraze nahoře."

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py data/menu.xml
msgid "Calitatea imaginii"
msgstr "Kvalita obrazu"

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Da: receptorul pune singur profilul canalului, după rezoluție și după felul imaginii trimise la televizor. Nu: imaginea rămâne ca din fabrică."
msgstr "Ano: přijímač sám nastaví profil kanálu podle rozlišení a podle druhu obrazu posílaného do televize. Ne: obraz zůstane jako z výroby."

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Acum nu e nicio imagine: reglajele se văd când pornești un canal TV."
msgstr "Teď není žádný obraz: nastavení uvidíš, když spustíš televizní kanál."

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Alegi profilul pe care îl reglezi. SD, HD și 4K sunt rezoluția canalului; SDR, HDR10 și HLG sunt felul imaginii trimise la televizor."
msgstr "Vybíráš profil, který nastavuješ. SD, HD a 4K jsou rozlišení kanálu; SDR, HDR10 a HLG jsou druh obrazu posílaného do televize."

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Comparație"
msgstr "Porovnání"

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Profilul acesta nu e al canalului de acum: îl vezi când pornești un canal %s."
msgstr "Tento profil nepatří současnému kanálu: uvidíš ho, když spustíš kanál %s."

#: lib/python/Screens/HdsCalitateImagine.py
#, python-format
msgid "Comparația e pornită: în dreapta imaginea are reglajul „%s”, în stânga nu. Albastru o oprește."
msgstr "Porovnání je zapnuté: vpravo má obraz nastavení „%s“, vlevo ne. Modré ho vypne."

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Toate profilurile"
msgstr "Všechny profily"

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Pui înapoi valorile din fabrică?"
msgstr "Vrátíš hodnoty z výroby?"

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Profilul"
msgstr "Profil"

#: lib/python/Screens/HdsCalitateImagine.py
#, python-format
msgid "Numai profilul %s"
msgstr "Jen profil %s"

#: lib/python/Screens/HdsCalitateImagine.py
msgid "Automat: canalele HDR ies în HDR, celelalte în SDR. Mereu HDR10 sau HLG: și meniurile și canalele SDR ies în HDR, fără clipire la schimbarea canalului. Se aplică la tasta verde, cu o întrebare pe televizor."
msgstr "Automaticky: kanály HDR jdou ven v HDR, ostatní v SDR. Vždy HDR10 nebo HLG: i nabídky a kanály SDR jdou v HDR, bez probliknutí při přepnutí kanálu. Použije se zeleným tlačítkem, s otázkou na televizi."

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "(acum)"
msgstr "(teď)"

#: lib/python/Screens/HdsCalitateImagine.py lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Din fabrică: %s."
msgstr "Z výroby: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Aceleași reglaje sunt pe televizor, în %s. Luminozitatea, contrastul, saturația și nuanța schimbă și meniurile. Ce se vede cu adevărat se judecă pe televizor: capturile de ecran nu arată prelucrarea plăcii."
msgstr "Stejná nastavení jsou na televizi, v %s. Jas, kontrast, sytost a odstín mění i nabídky. Co je doopravdy vidět, se posuzuje na televizi: snímky obrazovky zpracování desky neukazují."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Se citesc reglajele..."
msgstr "Načítají se nastavení..."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Reglaje"
msgstr "Nastavení"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Fără bifă, imaginea rămâne ca din fabrică."
msgstr "Bez zaškrtnutí zůstane obraz jako z výroby."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Toate profilurile la implicite"
msgstr "Všechny profily na výchozí"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Automat: canalele HDR ies în HDR, celelalte în SDR. Mereu HDR10 sau HLG: și meniurile și canalele SDR ies în HDR, fără clipire la schimbarea canalului. Canalul pornește din nou și pe televizor apare o întrebare: fără răspuns în 20 de secunde revine ieșirea de dinainte."
msgstr "Automaticky: kanály HDR jdou ven v HDR, ostatní v SDR. Vždy HDR10 nebo HLG: i nabídky a kanály SDR jdou v HDR, bez probliknutí při přepnutí kanálu. Kanál se spustí znovu a na televizi se objeví otázka: bez odpovědi do 20 sekund se vrátí předchozí výstup."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Încearcă pe televizor"
msgstr "Vyzkoušet na televizi"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Ce arată acum blocul de calitate al plăcii (/proc/msp/pq)."
msgstr "Co teď ukazuje blok kvality desky (/proc/msp/pq)."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Receptorul nu a putut citi reglajele."
msgstr "Přijímač nemohl načíst nastavení."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Receptorul acesta nu are blocul de calitate a imaginii."
msgstr "Tento přijímač nemá blok kvality obrazu."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Ce schimbi se vede pe loc pe televizor."
msgstr "Co změníš, uvidíš hned na televizi."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Ieșire HDR acum: %s."
msgstr "Výstup HDR teď: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Pe televizor: %s. Mai sunt %s s până revine ieșirea de dinainte."
msgstr "Na televizi: %s. Zbývá %s s, než se vrátí předchozí výstup."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Ai schimbări nepăstrate: rămân numai după „Păstrează”."
msgstr "Máš neuložené změny: zůstanou až po „Uložit“."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Alege întâi o ieșire."
msgstr "Nejdřív vyber výstup."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Pui înapoi valorile din fabrică pentru profilul %s?"
msgstr "Vrátíš hodnoty z výroby pro profil %s?"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Pui înapoi valorile din fabrică pentru toate profilurile?"
msgstr "Vrátíš hodnoty z výroby pro všechny profily?"

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Păstrat. Se vede și pe televizor."
msgstr "Uloženo. Je to vidět i na televizi."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Toate profilurile au acum valorile din fabrică."
msgstr "Všechny profily mají teď hodnoty z výroby."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Pe televizor e deschis ecranul Calitatea imaginii. Închide-l, apoi încearcă din nou."
msgstr "Na televizi je otevřená obrazovka Kvalita obrazu. Zavři ji a zkus to znovu."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Spune și profilul (profil=hd_sdr, de exemplu)."
msgstr "Uveď i profil (například profil=hd_sdr)."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Se vede acum pe televizor. Apasă „Păstrează” ca să rămână."
msgstr "Teď je to vidět na televizi. Stiskni „Uložit“, aby to zůstalo."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Alege un profil sau „toate”."
msgstr "Vyber profil nebo „toate“."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Profilul %s are acum valorile din fabrică."
msgstr "Profil %s má teď hodnoty z výroby."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "„pornit” se alege cu 1 (da) sau 0 (nu)."
msgstr "„pornit“ se volí jako 1 (ano) nebo 0 (ne)."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Comparația e oprită."
msgstr "Porovnání je vypnuté."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Reglajul acesta nu are comparație pe canalul de acum."
msgstr "Toto nastavení nemá na současném kanálu porovnání."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Pe televizor: în dreapta cu reglajul, în stânga fără. Se oprește singură după %d de secunde."
msgstr "Na televizi: vpravo s nastavením, vlevo bez. Samo se vypne po %d sekundách."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Profilul „%s” nu există."
msgstr "Profil „%s“ neexistuje."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Interfața web nu are încă legătura cu ecranul receptorului."
msgstr "Webové rozhraní ještě nemá spojení s obrazovkou přijímače."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
msgid "Valorile se dau ca numere între 0 și 100."
msgstr "Hodnoty se zadávají jako čísla od 0 do 100."

#: lib/python/Plugins/Extensions/HdsWebControl/calitate_imagine_web.py
#, python-format
msgid "Reglajul „%s” nu e al acestui profil."
msgstr "Nastavení „%s“ nepatří k tomuto profilu."

#: lib/python/Components/HdsEcranNegru.py
#, python-format
msgid "Imagine în formatul %s"
msgstr "Obraz ve formátu %s"

#: lib/python/Components/HdsEcranNegru.py
#, python-format
msgid "Canalul trimite imaginea în formatul %s, pe care acest receptor nu îl poate reda."
msgstr "Kanál vysílá obraz ve formátu %s, který tento přijímač neumí přehrát."

#: lib/python/Screens/HdsCautareCanale.py
msgid "mai e mai puțin de un minut"
msgstr "zbývá méně než minuta"

#: lib/python/Screens/HdsCautareCanale.py
#, python-format
msgid "mai durează cam %d minut"
msgid_plural "mai durează cam %d minute"
msgstr[0] "zbývá asi %d minuta"
msgstr[1] "zbývají asi %d minuty"
msgstr[2] "zbývá asi %d minut"

#: lib/python/Screens/HdsCautareCanale.py
msgid "GALBEN: sari peste satelitul acesta"
msgstr "ŽLUTÁ: přeskoč tento satelit"

#: lib/python/Screens/HdsCautareCanale.py
#, python-format
msgid "GALBEN: sari peste %s"
msgstr "ŽLUTÁ: přeskoč %s"

#: lib/python/Components/HdsPisteCanale.py
#, python-format
msgid "Sărite la cererea ta: %s."
msgstr "Přeskočeno na tvůj pokyn: %s."

#: lib/python/Plugins/Extensions/HdsWebControl/cautare_web.py
#, python-format
msgid "Sărit peste %s. Trec la poziția următoare."
msgstr "%s přeskočen. Pokračuji další pozicí."

#: lib/python/Components/HdsModSigur.py
msgid "eroare în codul Python al interfeței"
msgstr "chyba v kódu Python rozhraní"

#: lib/python/Components/HdsModSigur.py
msgid "cădere în programul interfeței"
msgstr "pád programu rozhraní"

#: lib/python/Components/HdsModSigur.py
msgid "cădere în placa 2D (accelerarea s-a oprit singură)"
msgstr "pád ve 2D grafice (zrychlení se samo vypnulo)"

#: lib/python/Components/HdsModSigur.py
msgid "eroare fatală în programul interfeței"
msgstr "fatální chyba v programu rozhraní"

#: lib/python/Components/HdsModSigur.py
msgid "oprită la cerere, nu e o cădere"
msgstr "zastaveno na pokyn, nejde o pád"

#: lib/python/Components/HdsModSigur.py
msgid "oprită de sistem: memoria s-a terminat"
msgstr "zastaveno systémem: došla paměť"

#: lib/python/Components/HdsModSigur.py
msgid "oprită fără raport de eroare"
msgstr "zastaveno bez chybového hlášení"

#: lib/python/Components/HdsModSigur.py
#, python-format
msgid "Locul erorii: %s"
msgstr "Místo chyby: %s"

#: lib/python/Components/HdsModSigur.py
#, python-format
msgid "Locul căderii: %s"
msgstr "Místo pádu: %s"

#: lib/python/Components/HdsModSigur.py
msgid "Placa 2D lucra în acel moment, dar oprirea nu e pusă pe seama ei."
msgstr "V tu chvíli pracovala 2D grafika, ale zastavení se jí nepřičítá."

#: lib/python/Components/HdsTeletextCopie.py
#, python-format
msgid "Copia nu s-a reîmprospătat: în %(minute)d minute teletextul canalului nu s-a strâns tot. Pagini strânse: %(pagini)d."
msgstr "Kopie se neobnovila: za %(minute)d minut se teletext kanálu nenačetl celý. Načtené stránky: %(pagini)d."

#: lib/python/Components/HdsTeletextCopie.py
#, python-format
msgid "Copia nu s-a reîmprospătat: în %(secunde)d de secunde canalul nu a trimis nicio pagină de teletext (fără semnal sau fără teletext)."
msgstr "Kopie se neobnovila: za %(secunde)d sekund kanál neposlal žádnou stránku teletextu (bez signálu nebo bez teletextu)."

#: lib/python/Components/HdsTeletextCopie.py
msgid "Copia nu s-a reîmprospătat: receptorul nu a putut trece pe canal."
msgstr "Kopie se neobnovila: přijímač nemohl přepnout na kanál."

#: lib/python/Components/HdsInregistrariProgramate.py
msgid "Acest canal nu poate fi înregistrat."
msgstr "Tento kanál nelze nahrát."

#: lib/python/Components/HdsInregistrariProgramate.py
msgid "Înregistrarea programelor DVB-T2 din satelit nu e încă posibilă."
msgstr "Nahrávání programů DVB-T2 ze satelitu zatím není možné."

#: lib/python/Components/HdsInregistrariProgramate.py
msgid "Înregistrarea posturilor DAB+ din satelit nu e încă posibilă."
msgstr "Nahrávání stanic DAB+ ze satelitu zatím není možné."

#: lib/python/Screens/TimerEntry.py
msgid "Alege alt canal din listă."
