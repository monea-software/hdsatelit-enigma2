msgstr "Hledá se v domácí síti... %d z %d"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Fără limită, mai lent pe calculatoarele obișnuite"
msgstr "Bez limitu, pomalejší na běžných počítačích"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Recomandat pentru subtitrări zilnice"
msgstr "Doporučeno pro titulky každý den"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cel mai simplu de pornit, fără card; se poate opri dacă te uiți mult"
msgstr "Nejjednodušší na spuštění, bez karty; může se zastavit, když se díváš hodně"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Formular"
msgstr "Formulář"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Text simplu"
msgstr "Prostý text"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Lista serviciilor de rezervă nu e bună (un serviciu necunoscut, unul de două "
"ori sau chiar cel principal). Nu s-a schimbat nimic."
msgstr "Seznam záložních služeb není platný (neznámá služba, jedna dvakrát nebo dokonce ta hlavní). Nic se nezměnilo."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Adresă proprie"
msgstr "Vlastní adresa"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid "locul {text} în adresă (sau, la POST, în corp)"
msgstr "značka {text} v adrese (nebo, u POST, v těle)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"o adresă https:// (http:// merge numai pentru un server din rețeaua de acasă)"
msgstr "adresa https:// (http:// funguje jen pro server v domácí síti)"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"un corp JSON bun (pune locurile între ghilimele, de exemplu \"q\": "
"\"{text}\")"
msgstr "platné tělo JSON (dej značky do uvozovek, například \"q\": \"{text}\")"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "un nume de antet bun (litere, cifre și - _ ., de exemplu Authorization)"
msgstr "platný název hlavičky (písmena, číslice a - _ ., například Authorization)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"calea traducerii în răspunsul JSON (chei și numere despărțite prin punct, de "
"exemplu translatedText)"
msgstr "cesta k překladu v odpovědi JSON (klíče a čísla oddělené tečkou, například translatedText)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Lipsește regiunea resursei Azure: o găsești în portal, la resursa "
"Translator, Overview › Location (de exemplu Germany West Central = "
"germanywestcentral)."
msgstr "Chybí oblast prostředku Azure: najdeš ji na portálu, u prostředku Translator, Overview › Location (například Germany West Central = germanywestcentral)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Cheia sau regiunea nu se potrivesc: verifică amândouă în portal (Keys and "
"Endpoint)."
msgstr "Klíč a oblast k sobě nesedí: zkontroluj obojí na portálu (Keys and Endpoint)."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Serverul de la adresa ta a răspuns cu eroarea HTTP %d. Începutul "
"răspunsului: „%s”"
msgstr "Server na tvé adrese odpověděl chybou HTTP %d. Začátek odpovědi: „%s“"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Răspunsul serverului nu e JSON (dacă serverul dă numai traducerea, alege "
"„Text simplu” la răspuns). Începutul răspunsului: „%s”"
msgstr "Odpověď serveru není JSON (pokud server dává jen překlad, vyber u odpovědi „Prostý text“). Začátek odpovědi: „%s“"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Calea „%s” nu găsește nicio traducere în răspunsul serverului. Începutul "
"răspunsului: „%s”"
msgstr "Cesta „%s“ nenachází v odpovědi serveru žádný překlad. Začátek odpovědi: „%s“"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Serverul nu a dat nicio traducere. Începutul răspunsului: „%s”"
msgstr "Server nedal žádný překlad. Začátek odpovědi: „%s“"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Traducerea subtitrărilor vine prea târziu: serverul răspunde în %s, în "
"medie. Alege un serviciu din internet (Gemini, gratuit, fără card) sau un "
"model mai mic."
msgstr "Překlad titulků přichází příliš pozdě: server odpovídá v průměru za %s. Vyber službu z internetu (Gemini, zdarma, bez karty) nebo menší model."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "%s a ajuns la limita gratuită pe zi (sau pe lună)."
msgstr "Služba %s dosáhla bezplatného limitu za den (nebo za měsíc)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Traducerea s-a oprit până se reînnoiește limita. Ca să meargă și atunci, "
"pune servicii de rezervă în Meniu › Setări › Sunet și subtitrări › "
"Traducerea subtitrărilor."
msgstr "Překlad se zastavil, dokud se limit neobnoví. Aby fungoval i tehdy, dej záložní služby do Nabídka › Nastavení › Zvukové stopy › Překlad titulků."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"De exemplu Azure Translator: Free F0, 2.000.000 de caractere pe lună, "
"gratuit."
msgstr "Například Azure Translator: Free F0, 2 000 000 znaků měsíčně, zdarma."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Traducerea subtitrărilor s-a oprit până schimbi setările: %s"
msgstr "Překlad titulků se zastavil, dokud nezměníš nastavení: %s"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Am găsit regiunea: %s (%s)."
msgstr "Oblast nalezena: %s (%s)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Cel mai simplu: pornește serverul pe calculator (pașii de mai jos), apoi "
"apasă „Caută în rețeaua de acasă”, pe televizor sau pe telefon. Receptorul "
"găsește singur serverul; nu mai trebuie să scrii adresa."
msgstr "Nejjednodušší: spusť server na počítači (kroky níže), pak stiskni „Hledat v domácí síti“, na televizoru nebo v telefonu. Přijímač najde server sám; adresu už nemusíš psát."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Prima dată, Windows poate întreba dacă lași programul să primească conexiuni "
"din rețea: apasă „Allow access”. Dacă receptorul tot nu găsește serverul: "
"Windows Security, Firewall & network protection, „Allow an app through "
"firewall”, „Change settings” și bifează programul (Ollama, LM Studio sau "
"Docker) la „Private”. Rețeaua de acasă trebuie să fie „Private network” "
"(Settings, Network & internet, rețeaua ta, „Network profile type”)."
msgstr "Poprvé se Windows může zeptat, jestli dovolíš programu přijímat připojení ze sítě: stiskni „Allow access“. Pokud přijímač server pořád nenajde: Windows Security, Firewall & network protection, „Allow an app through firewall“, „Change settings“ a zaškrtni program (Ollama, LM Studio nebo Docker) u „Private“. Domácí síť musí být „Private network“ (Settings, Network & internet, tvoje síť, „Network profile type“)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"2.000.000 de caractere pe lună, gratuit (Free F0). E alegerea recomandată "
"pentru subtitrări multe (filme întregi, în fiecare zi), ca serviciu "
"principal sau de rezervă. Cardul se cere la înscriere numai pentru "
"verificare; pe Free F0 nu se plătește nimic. După 30 de zile contul trebuie "
"trecut pe „Pay as you go”, tot fără cost cât resursa rămâne Free F0."
msgstr "2 000 000 znaků měsíčně, zdarma (Free F0). Doporučená volba pro hodně titulků (celé filmy, každý den), jako hlavní nebo záložní služba. Karta se při registraci chce jen pro ověření; na Free F0 se nic neplatí. Po 30 dnech je třeba účet přepnout na „Pay as you go“, stále bez poplatků, dokud prostředek zůstane Free F0."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Pentru subtitrări multe (filme întregi, în fiecare zi) pune în setări și "
"servicii de rezervă, de exemplu Azure Translator: când Gemini dă eroarea "
"429, receptorul trece singur la următorul. Lista se face din servicii "
"diferite: limita Gemini e pe proiect, iar mai multe conturi făcute ca să "
"aduni limitele gratuite înseamnă ocolirea limitelor, pe care termenii Google "
"o interzic."
msgstr "Pro hodně titulků (celé filmy, každý den) dej do nastavení i záložní služby, například Azure Translator: když Gemini dá chybu 429, přijímač sám přejde na další. Seznam se dělá z různých služeb: limit Gemini je na projekt a víc účtů založených kvůli sčítání bezplatných limitů znamená obcházení limitů, což podmínky Google zakazují."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Gratuit pentru folosire ocazională, cu un număr limitat de cereri pe minut "
"și pe zi; Google arată cifrele numai în contul tău. La subtitrări fără pauză "
"poate da eroarea 429 după câteva minute, iar limita pe zi se poate termina."
msgstr "Zdarma pro občasné použití, s omezeným počtem požadavků za minutu a za den; Google ukazuje čísla jen v tvém účtu. U titulků bez přestávky může po pár minutách přijít chyba 429 a denní limit se může vyčerpat."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Peste limita pe minut, cererile primesc eroarea 429 câteva secunde: "
"receptorul așteaptă cât spune Google și trece între timp la serviciul de "
"rezervă, dacă ai pus unul. Peste limita pe zi, până a doua zi (în jurul orei "
"10, ora României). Fără card nu se plătește nimic."
msgstr "Nad limitem za minutu dostávají požadavky na pár sekund chybu 429: přijímač počká tak dlouho, jak Google řekne, a mezitím přejde na záložní službu, pokud nějakou máš. Nad denním limitem až do dalšího dne (kolem 10. hodiny rumunského času). Bez karty se nic neplatí."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În casă: instalează Ollama de pe ollama.com pe un calculator și pornește-l."
msgstr "Doma: nainstaluj Ollama z ollama.com na počítač a spusť ho."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În PowerShell scrie: ollama pull gemma3:4b (3,3 GB). gemma3:12b traduce mai "
"bine, dar e mai lent (8,1 GB); pentru un calculator slab, gemma3:1b (815 "
"MB). Modelele qwen2.5 traduc slab în română."
msgstr "V prostředí PowerShell napiš: ollama pull gemma3:4b (3,3 GB). gemma3:12b překládá lépe, ale je pomalejší (8,1 GB); pro slabý počítač gemma3:1b (815 MB). Modely qwen2.5 překládají do rumunštiny špatně."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Ca să-l vadă receptorul: deschide Ollama, intră în Settings și pornește "
"„Expose Ollama to the network” (Ollama 0.9.5 sau mai nou; numele poate fi "
"puțin altul). Dacă nu găsești setarea: închide Ollama de lângă ceas "
"(„Quit”), caută în Start „environment variables” („variabile de mediu”), "
"adaugă la contul tău OLLAMA_HOST cu valoarea 0.0.0.0:11434, apasă OK și "
"pornește din nou Ollama."
msgstr "Aby ho přijímač viděl: otevři Ollama, jdi do Settings a zapni „Expose Ollama to the network“ (Ollama 0.9.5 nebo novější; název může být trochu jiný). Pokud nastavení nenajdeš: ukonči Ollama u hodin („Quit“), vyhledej ve Startu „environment variables“ („proměnné prostředí“), přidej ke svému účtu OLLAMA_HOST s hodnotou 0.0.0.0:11434, stiskni OK a spusť Ollama znovu."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Fără căutare: scrie aici adresa http://IP-UL-CALCULATORULUI:11434 și modelul "
"gemma3:4b. Cheie nu trebuie."
msgstr "Bez hledání: napiš sem adresu http://IP-POČÍTAČE:11434 a model gemma3:4b. Klíč není potřeba."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"LM Studio merge la fel: fila „Developer”, „Start server”, apoi în setările "
"serverului „Serve on Local Network”, cu „Require Authentication” oprit; "
"adresa http://IP-UL-CALCULATORULUI:1234 și numele modelului din LM Studio."
msgstr "LM Studio funguje stejně: karta „Developer“, „Start server“, potom v nastavení serveru „Serve on Local Network“, s vypnutým „Require Authentication“; adresa http://IP-POČÍTAČE:1234 a název modelu z LM Studio."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"„Adresă proprie” e pentru un server de traducere ales de tine, de exemplu un "
"LibreTranslate pornit pe un calculator din casă. Receptorul trimite fiecare "
"rând de subtitrare într-o cerere separată."
msgstr "„Vlastní adresa“ je pro překladový server, který si vybereš, například LibreTranslate spuštěný na počítači doma. Přijímač posílá každý řádek titulků v samostatném požadavku."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Adresa e un șablon: scrii adresa serverului și pui în ea locurile {text} "
"(textul de tradus), {sursa} (limba subtitrării, sau auto când nu se știe) și "
"{tinta} (limba traducerii, de exemplu ro). Receptorul le înlocuiește la "
"fiecare cerere."
msgstr "Adresa je šablona: napíšeš adresu serveru a dáš do ní značky {text} (text k překladu), {sursa} (jazyk titulků, nebo auto, když se neví) a {tinta} (jazyk překladu, například ro). Přijímač je nahradí při každém požadavku."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Adresa începe cu https://. O adresă http:// merge numai pentru un server din "
"rețeaua de acasă (de exemplu 192.168.1.50). Nume și parolă nu se scriu în "
"adresă."
msgstr "Adresa začíná https://. Adresa http:// funguje jen pro server v domácí síti (například 192.168.1.50). Jméno a heslo se do adresy nepíšou."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Metoda GET trimite totul în adresă, deci {text} trebuie să fie în adresă. "
"Metoda POST trimite și un corp, cu aceleași locuri: JSON (pune locurile "
"între ghilimele, de exemplu \"q\": \"{text}\") sau formular (de exemplu "
"q={text}&target={tinta})."
msgstr "Metoda GET posílá všechno v adrese, takže {text} musí být v adrese. Metoda POST posílá i tělo, se stejnými značkami: JSON (dej značky do uvozovek, například \"q\": \"{text}\") nebo formulář (například q={text}&target={tinta})."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Antetul e opțional: dacă serverul cere o cheie, scrie numele antetului (de "
"exemplu Authorization) și, la valoare, ce cere serverul (de exemplu Bearer, "
"un spațiu și cheia). Valoarea se păstrează criptată pe receptor și nu se mai "
"arată."
msgstr "Hlavička je volitelná: pokud server chce klíč, napiš název hlavičky (například Authorization) a jako hodnotu to, co server chce (například Bearer, mezeru a klíč). Hodnota se uchovává v přijímači zašifrovaná a už se nezobrazí."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Răspunsul: alege „Text simplu” dacă serverul dă numai traducerea. Pentru "
"JSON scrie calea până la traducere: numele cheilor și numerele pozițiilor "
"(de la 0), despărțite prin punct, de exemplu translatedText sau "
"data.translations.0.translatedText. Cu * iei toate elementele, lipite în "
"ordine, de exemplu 0.*.0."
msgstr "Odpověď: vyber „Prostý text“, pokud server dává jen překlad. Pro JSON napiš cestu k překladu: názvy klíčů a čísla pozic (od 0), oddělené tečkou, například translatedText nebo data.translations.0.translatedText. S * vezmeš všechny prvky, spojené popořadě, například 0.*.0."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Exemplu, un LibreTranslate al tău din casă: adresa "
"http://192.168.1.50:5000/translate, metoda POST, corpul JSON {\"q\": "
"\"{text}\", \"source\": \"{sursa}\", \"target\": \"{tinta}\", \"format\": "
"\"text\"}, răspunsul JSON, calea translatedText."
msgstr "Příklad, tvůj vlastní LibreTranslate doma: adresa http://192.168.1.50:5000/translate, metoda POST, tělo JSON {\"q\": \"{text}\", \"source\": \"{sursa}\", \"target\": \"{tinta}\", \"format\": \"text\"}, odpověď JSON, cesta translatedText."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Exemplu cu GET: adresa "
"https://example.com/translate?q={text}&from={sursa}&to={tinta} și răspunsul "
"„Text simplu” (example.com ține locul serverului tău)."
msgstr "Příklad s GET: adresa https://example.com/translate?q={text}&from={sursa}&to={tinta} a odpověď „Prostý text“ (example.com zastupuje tvůj server)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Apasă „Probează traducerea”. Dacă nu merge, mesajul arată începutul "
"răspunsului serverului, ca să vezi unde e traducerea și ce cale să scrii."
msgstr "Stiskni „Vyzkoušet překlad“. Pokud to nefunguje, zpráva ukáže začátek odpovědi serveru, abys viděl, kde je překlad a jakou cestu napsat."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Depinde de server. Un server al tău din casă nu are cotă."
msgstr "Záleží na serveru. Tvůj vlastní server doma nemá kvótu."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Depinde de server."
msgstr "Záleží na serveru."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cum folosești o adresă proprie"
msgstr "Jak používat vlastní adresu"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor, prin internet, spre serverul de la adresa scrisă de tine (%s), "
"care îl traduce."
msgstr "Text titulků (jen text, bez obrazu a bez zvuku) jde z přijímače přes internet na server na adrese, kterou jsi zadal (%s), a ten ho přeloží."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Ollama ascultă din fabrică numai pe calculatorul lui. În Ollama 0.9.5 sau "
"mai nou: Settings, pornește „Expose Ollama to the network”."
msgstr "Z výroby Ollama poslouchá jen na svém počítači. V Ollama 0.9.5 nebo novější: Settings, zapni „Expose Ollama to the network“."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Sau: închide Ollama de lângă ceas, pune variabila de mediu OLLAMA_HOST cu "
"valoarea 0.0.0.0:11434 și pornește din nou Ollama."
msgstr "Nebo: ukonči Ollama u hodin, nastav proměnnou prostředí OLLAMA_HOST na hodnotu 0.0.0.0:11434 a spusť Ollama znovu."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"LM Studio: fila „Developer”, „Start server” și „Serve on Local Network”. "
"Căutarea nu-l găsește: scrie adresa de mână (portul 1234), ca server "
"compatibil OpenAI."
msgstr "LM Studio: karta „Developer“, „Start server“ a „Serve on Local Network“. Hledání ho nenajde: napiš adresu ručně (port 1234), jako server kompatibilní s OpenAI."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Windows: la întrebarea paravanului apasă „Allow access”. Altfel: Windows "
"Security, „Allow an app through firewall”, bifează Ollama la „Private”."
msgstr "Windows: když se brána firewall zeptá, stiskni „Allow access“. Jinak: Windows Security, „Allow an app through firewall“, zaškrtni Ollama u „Private“."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Rețeaua de acasă pe calculator trebuie să fie „Private network” (Settings › "
"Network & internet), iar receptorul și calculatorul în același router."
msgstr "Na počítači musí být domácí síť „Private network“ (Settings › Network & internet) a přijímač s počítačem musí být na stejném routeru."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Traducerea subtitrărilor e gata, cu %s. Proba: %s"
msgstr "Překlad titulků je připraven, se službou %s. Zkouška: %s"

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Traducerea subtitrărilor e pornită, cu %s, dar cota gratuită s-a terminat. "
"Merge din nou după ce se reface cota."
msgstr "Překlad titulků je zapnutý, se službou %s, ale bezplatná kvóta došla. Znovu bude fungovat, až se kvóta obnoví."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Traducerea subtitrărilor e pornită, cu %s (fără probă)."
msgstr "Překlad titulků je zapnutý, se službou %s (bez zkoušky)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Server compatibil OpenAI"
msgstr "Server kompatibilní s OpenAI"

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Serviciul ales nu are adresă de server."
msgstr "Vybraná služba nemá adresu serveru."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Scrie adresa serverului, de exemplu http://192.168.1.50:%d."
msgstr "Napiš adresu serveru, například http://192.168.1.50:%d."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Adresa are spații sau caractere care nu pot fi într-o adresă."
msgstr "Adresa obsahuje mezery nebo znaky, které v adrese být nemohou."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Portul din adresă nu e bun: trebuie un număr între 1 și 65535."
msgstr "Port v adrese není dobrý: musí to být číslo od 1 do 65535."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Adresa trebuie să înceapă cu http:// sau https://."
msgstr "Adresa musí začínat http:// nebo https://."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Adresa nu poate avea nume de utilizator sau parolă. Scrie numai adresa "
"serverului; cheia, dacă serverul cere una, se pune separat."
msgstr "Adresa nemůže obsahovat uživatelské jméno ani heslo. Napiš jen adresu serveru; klíč, pokud ho server vyžaduje, se zadává zvlášť."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Adresa nu are numele sau IP-ul serverului."
msgstr "V adrese chybí název nebo IP serveru."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Serverul de la %s cere o cheie. Scrie cheia serverului, sau pornește "
"serverul fără cheie."
msgstr "Server na %s vyžaduje klíč. Napiš klíč serveru, nebo spusť server bez klíče."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "adresa scrisă"
msgstr "zadané adrese"

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Copiaz-o întreagă din pagina cheii, fără spații. Cheia pentru Gemini se face "
"pe aistudio.google.com/apikey."
msgstr "Zkopíruj ho celý ze stránky klíče, bez mezer. Klíč pro Gemini se vytváří na aistudio.google.com/apikey."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Cheia e bună, dar în proiectul ei nu e pornit „Cloud Translation API”. În "
"Google Cloud (console.cloud.google.com) mergi la „APIs & Services”, caută "
"„Cloud Translation API”, apasă „Enable”, așteaptă câteva minute și încearcă "
"din nou."
msgstr "Klíč je dobrý, ale v jeho projektu není zapnuté „Cloud Translation API“. V Google Cloud (console.cloud.google.com) jdi do „APIs & Services“, vyhledej „Cloud Translation API“, stiskni „Enable“, počkej pár minut a zkus to znovu."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Copiaz-o întreagă din pagina cheii "
"(console.cloud.google.com/apis/credentials), fără spații. În proiectul cheii "
"pornește „Cloud Translation API” și verifică să nu fie cheia restrânsă la "
"alt API."
msgstr "Zkopíruj ho celý ze stránky klíče (console.cloud.google.com/apis/credentials), bez mezer. V projektu klíče zapni „Cloud Translation API“ a zkontroluj, že klíč není omezený na jiné API."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Copiaz-o întreagă din portal (resursa Translator, „Keys and Endpoint”, KEY "
"1), fără spații, și verifică regiunea: scrisă exact ca în portal (de exemplu "
"westeurope), sau Global dacă resursa e globală."
msgstr "Zkopíruj ho celý z portálu (prostředek Translator, „Keys and Endpoint“, KEY 1), bez mezer, a zkontroluj oblast: napsanou přesně jako na portálu (například westeurope), nebo Global, pokud je prostředek globální."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Copiaz-o întreagă din pagina cheilor DeepL "
"(www.deepl.com/your-account/keys), fără spații. Trebuie o cheie de la DeepL "
"API, nu de la traducătorul obișnuit."
msgstr "Zkopíruj ho celý ze stránky klíčů DeepL (www.deepl.com/your-account/keys), bez mezer. Musí to být klíč od DeepL API, ne od běžného překladače."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Copiaz-o întreagă din pagina cheilor (%s), fără spații."
msgstr "Zkopíruj ho celý ze stránky klíčů (%s), bez mezer."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Copiaz-o întreagă din pagina cheii, fără spații, și încearcă din nou."
msgstr "Zkopíruj ho celý ze stránky klíče, bez mezer, a zkus to znovu."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota (la Gemini, de obicei a doua zi, în jurul orei 10, ora României)."
msgstr "Klíč je dobrý, ale kvóta došla. Překlad bude znovu fungovat, až se kvóta obnoví (u Gemini obvykle další den kolem 10. hodiny rumunského času)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota (la Azure, luna următoare)."
msgstr "Klíč je dobrý, ale kvóta došla. Překlad bude znovu fungovat, až se kvóta obnoví (u Azure příští měsíc)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Cheia e bună, dar cota s-a terminat. Traducerea merge din nou după ce se "
"reface cota."
msgstr "Klíč je dobrý, ale kvóta došla. Překlad bude znovu fungovat, až se kvóta obnoví."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Serverul a răspuns prea încet."
msgstr "Server odpověděl příliš pomalu."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Verifică dacă serverul de la %s e pornit și dacă receptorul îl vede (același "
"router)."
msgstr "Zkontroluj, jestli je server na %s zapnutý a jestli ho přijímač vidí (stejný router)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"La Ollama, pe calculator trebuie OLLAMA_HOST=0.0.0.0:11434 (vezi "
"instrucțiunile)."
msgstr "Pro Ollama potřebuje počítač OLLAMA_HOST=0.0.0.0:11434 (viz návod)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Verifică internetul receptorului (Meniu › Setări › Rețea) și încearcă din "
"nou."
msgstr "Zkontroluj internet přijímače (Nabídka › Nastavení › Síť a internet) a zkus to znovu."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Pornește serverul LibreTranslate și cu limba „%s” (de exemplu --load-only "
"en,ro,de,fr,it,es,hu)."
msgstr "Spusť server LibreTranslate i s jazykem „%s“ (například --load-only en,ro,de,fr,it,es,hu)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Serviciul nu traduce în limba aleasă. Alege altă limbă în setările "
"traducerii."
msgstr "Služba nepřekládá do zvoleného jazyka. Vyber jiný jazyk v nastavení překladu."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"La adresa asta nu răspunde LibreTranslate. Verifică adresa și portul (de "
"obicei 5000)."
msgstr "Na této adrese neodpovídá LibreTranslate. Zkontroluj adresu a port (obvykle 5000)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Modelul nu e pe server. Alege alt model din listă."
msgstr "Model není na serveru. Vyber jiný model ze seznamu."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Contul nu are credit pentru acest model. Cumpără credit sau alege alt model."
msgstr "Účet nemá kredit pro tento model. Kup kredit nebo vyber jiný model."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Serverul a răspuns neașteptat. Verifică adresa și portul și încearcă din nou."
msgstr "Server odpověděl neočekávaně. Zkontroluj adresu a port a zkus to znovu."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Serviciul a răspuns neașteptat. Încearcă din nou peste câteva minute."
msgstr "Služba odpověděla neočekávaně. Zkus to znovu za pár minut."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Proba a durat %s secunde: serverul e prea lent ca subtitrările traduse să "
"apară la timp; vor veni târziu, după original."
msgstr "Zkouška trvala %s s: server je příliš pomalý, aby se přeložené titulky objevily včas; přijdou pozdě, po originálu."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Folosește un serviciu din internet (Gemini, gratuit, fără card) sau un model "
"mai mic (de exemplu gemma3:4b)."
msgstr "Použij službu z internetu (Gemini, zdarma, bez karty) nebo menší model (například gemma3:4b)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Folosește un serviciu din internet (Gemini, gratuit, fără card)."
msgstr "Použij službu z internetu (Gemini, zdarma, bez karty)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Încearcă un model mai mic sau alt serviciu (Gemini, gratuit, fără card)."
msgstr "Zkus menší model nebo jinou službu (Gemini, zdarma, bez karty)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Configurarea s-a oprit neașteptat."
msgstr "Nastavení se neočekávaně zastavilo."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Lipește cheia."
msgstr "Vlož klíč."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Cheia are caractere care nu pot fi într-o cheie, sau e prea lungă. Copiaz-o "
"din nou, întreagă."
msgstr "Klíč obsahuje znaky, které v klíči být nemohou, nebo je příliš dlouhý. Zkopíruj ho znovu, celý."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Nu recunosc cheia după formă. Alege serviciul din listă și încearcă din nou; "
"cheia nu a plecat nicăieri."
msgstr "Nepoznávám klíč podle jeho tvaru. Vyber službu ze seznamu a zkus to znovu; klíč nebyl nikam odeslán."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Regiunea nu e bună: scrie-o exact ca în portalul Azure, de exemplu "
"westeurope."
msgstr "Oblast není dobrá: napiš ji přesně jako na portálu Azure, například westeurope."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Pentru un server din casă scrie întâi adresa lui (pasul cu adresa "
"serverului)."
msgstr "Pro server u tebe doma napiš nejdřív jeho adresu (krok s adresou serveru)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Merge deja o configurare. Așteaptă să se termine."
msgstr "Nastavení už probíhá. Počkej, až skončí."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Recunosc cheia..."
msgstr "Rozpoznávám klíč..."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Am pornit verificarea cheii."
msgstr "Kontrola klíče začala."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Serverul poate fi numai LibreTranslate sau compatibil OpenAI."
msgstr "Server může být jen LibreTranslate nebo kompatibilní s OpenAI."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Numele modelului nu e bun."
msgstr "Název modelu není dobrý."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Cheia are caractere care nu pot fi într-o cheie, sau e prea lungă."
msgstr "Klíč obsahuje znaky, které v klíči být nemohou, nebo je příliš dlouhý."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Mă uit la server..."
msgstr "Dívám se na server..."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Am pornit verificarea serverului."
msgstr "Kontrola serveru začala."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Alege un model din listă."
msgstr "Vyber model ze seznamu."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Setările traducerii nu se pot citi."
msgstr "Nastavení překladu nejde přečíst."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Modelul se schimbă numai la Gemini și la serverele compatibile OpenAI."
msgstr "Model se mění jen u Gemini a u serverů kompatibilních s OpenAI."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Pentru Gemini lipsește cheia. Pune întâi cheia."
msgstr "U Gemini chybí klíč. Nejdřív zadej klíč."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Pentru serverul compatibil OpenAI lipsește adresa. Pune întâi adresa."
msgstr "U serveru kompatibilního s OpenAI chybí adresa. Nejdřív zadej adresu."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Probez modelul %s..."
msgstr "Zkouším model %s..."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Am pornit proba modelului."
msgstr "Zkouška modelu začala."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Serverul nu dă lista modelelor (HTTP %s)."
msgstr "Server nedává seznam modelů (HTTP %s)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Serverul nu dă lista modelelor."
msgstr "Server nedává seznam modelů."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Verifică adresa, sau scrie numele modelului."
msgstr "Zkontroluj adresu, nebo napiš název modelu."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "La adresa asta nu răspunde un server LibreTranslate (HTTP %s)."
msgstr "Na této adrese neodpovídá žádný server LibreTranslate (HTTP %s)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "La adresa asta nu răspunde un server LibreTranslate."
msgstr "Na této adrese neodpovídá žádný server LibreTranslate."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Probez traducerea cu %s..."
msgstr "Zkouším překlad s %s..."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
