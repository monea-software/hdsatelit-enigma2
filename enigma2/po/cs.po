msgstr "Složku se nepodařilo načíst."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Redă pe televizor"
msgstr "Přehrát na televizoru"

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Filmul nu a pornit."
msgstr "Film se nespustil."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Cererea a expirat. Încearcă încă o dată."
msgstr "Požadavku vypršel čas. Zkus to ještě jednou."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Citește din nou dosarul, apoi alege filmul."
msgstr "Načti složku znovu a pak vyber film."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
