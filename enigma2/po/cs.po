#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Locurile tale"
msgstr "Tvá umístění"

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Niciun loc încă. Adaugă unul mai jos sau caută serverele din casă."
msgstr "Zatím žádné umístění. Přidej nějaké níže nebo vyhledej domácí servery."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Subtitrările de lângă film (același nume, sau dosarul Subs) și cele date de serverul media se iau singure. Pe televizor, tasta SUB le arată pe toate, cu codarea și întârzierea."
msgstr "Titulky vedle filmu (stejný název nebo složka Subs) a titulky od mediálního serveru se načtou samy. Na televizoru tlačítko SUB ukáže všechny, s kódováním a zpožděním."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Receptorul întreabă scurt aparatele din rețeaua ta: serverele media (DLNA), calculatoarele cu Windows și NAS-urile cu dosare partajate, serverele care se anunță (NFS, WebDAV, FTP). Nimic nu pleacă în afara rețelei tale și nimic nu se caută singur."
msgstr "Přijímač se krátce zeptá zařízení ve tvé síti: mediálních serverů (DLNA), počítačů s Windows a NAS se sdílenými složkami, serverů, které se ohlašují (NFS, WebDAV, FTP). Nic neodchází mimo tvou síť a nic se nehledá samo."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Alege din lista serverului"
msgstr "Vybrat ze seznamu serveru"

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Este salvată o parolă. Lasă câmpul gol ca să rămână aceeași."
msgstr "Heslo je uložené. Nech pole prázdné, aby zůstalo stejné."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Montat și după repornire (trebuie pentru înregistrările programate pe el)"
msgstr "Připojeno i po restartu (potřeba pro nahrávky naplánované do něj)"

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Șterge parola salvată"
msgstr "Smazat uložené heslo"

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Locurile SMB și NFS se montează pe receptor: apar și în Player media, ca un disc, și pot ține înregistrări după proba de scriere și viteză. Locul înregistrărilor se alege apoi în <a data-cale=\"/stocare\" href=\"/stocare\" style=\"color:inherit\">Locul înregistrărilor</a>. Parolele stau criptate pe receptor și nu se arată nicăieri."
msgstr "Umístění SMB a NFS se připojují v přijímači: objeví se i v Přehrávači médií jako disk a po zkoušce zápisu a rychlosti mohou uchovávat nahrávky. Umístění nahrávek se pak vybírá v <a data-cale=\"/stocare\" href=\"/stocare\" style=\"color:inherit\">Umístění nahrávek</a>. Hesla jsou v přijímači uložená šifrovaně a nikde se nezobrazují."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Calculatorul cu Windows sau NAS-ul: scrie numele dosarului partajat (de pildă Filme). Pe Windows, utilizatorul este contul tău."
msgstr "Počítač s Windows nebo NAS: napiš název sdílené složky (například Filme). Ve Windows je uživatel tvůj účet."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "NAS sau Linux: dosarul exportat (de pildă volume1/filme). Fără parolă."
msgstr "NAS nebo Linux: exportovaná složka (například volume1/filme). Bez hesla."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Server FTP: dosarul de pe server (gol: tot serverul)."
msgstr "Server FTP: složka na serveru (prázdné: celý server)."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "WebDAV: dosarul de pe server, de pildă remote.php/dav/files/nume."
msgstr "WebDAV: složka na serveru, například remote.php/dav/files/nume."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Serverul media din casă: îl găsești cel mai ușor cu Caută serverele din casă."
msgstr "Domácí mediální server: nejsnáz ho najdeš pomocí Hledat domácí servery."

#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Folosește pt. înregistrări"
msgstr "Použít pro nahrávky"

#: lib/python/Screens/HdsLocuriRetea.py
