#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Pe pagina deschisă alege proiectul tău (cu facturarea pornită) și pornește „Cloud Translation API”, dacă nu e pornit."
msgstr "Na otevřené stránce vyber svůj projekt (se zapnutou fakturací) a zapni „Cloud Translation API“, pokud není zapnuté."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Pe pagina deschisă intră cu contul tău Google; prima dată accepți termenii."
msgstr "Na otevřené stránce se přihlas svým účtem Google; poprvé přijmeš podmínky."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Pe pagina deschisă intră în contul DeepL API. Dacă nu ai unul, fă-l gratuit: planul gratuit nu cere card."
msgstr "Na otevřené stránce se přihlas do účtu DeepL API. Pokud žádný nemáš, založ si ho zdarma: bezplatný plán nevyžaduje kartu."

#: lib/python/Plugins/Extensions/HdsWebControl/traducere_configurare_web.py
msgid "Pe pagina deschisă: „Resource group”, „Create new”; „Region” Global; un nume; „Pricing tier” Free F0; apoi „Review + create” și „Create”."
msgstr "Na otevřené stránce: „Resource group“, „Create new“; „Region“ Global; název; „Pricing tier“ Free F0; pak „Review + create“ a „Create“."

