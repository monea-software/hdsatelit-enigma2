msgid "Aceeași alegere este pe televizor, în __DRUM_MENIU__."
msgstr "A mesma escolha está no televisor, em __DRUM_MENIU__."

#: lib/python/Plugins/Extensions/HdsWebControl/temporizatoare_web.py
