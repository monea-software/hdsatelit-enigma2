msgid "Nu am găsit niciun server în rețeaua de acasă."
msgstr "Não foi encontrado nenhum servidor na rede de casa."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Ollama la %s, modelul %s"
msgstr "Ollama em %s, modelo %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "LibreTranslate la %s"
msgstr "LibreTranslate em %s"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Am găsit %d. Alege serverul."
msgstr "Encontrados: %d. Escolhe o servidor."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Se probează serverul..."
msgstr "A testar o servidor..."

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "Se caută în rețeaua de acasă... %d din %d"
msgstr "A procurar na rede de casa... %d de %d"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Fără limită, mai lent pe calculatoarele obișnuite"
msgstr "Sem limite, mais lento nos computadores comuns"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Recomandat pentru subtitrări zilnice"
msgstr "Recomendado para legendas todos os dias"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cel mai simplu de pornit, fără card; se poate opri dacă te uiți mult"
msgstr "O mais simples de pôr a funcionar, sem cartão; pode parar se vires muito"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Formular"
msgstr "Formulário"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Text simplu"
msgstr "Texto simples"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Lista serviciilor de rezervă nu e bună (un serviciu necunoscut, unul de două "
"ori sau chiar cel principal). Nu s-a schimbat nimic."
msgstr "A lista de serviços de reserva não é válida (um serviço desconhecido, um repetido ou até o principal). Não se mudou nada."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Adresă proprie"
msgstr "Endereço próprio"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid "locul {text} în adresă (sau, la POST, în corp)"
msgstr "o marcador {text} no endereço (ou, com POST, no corpo)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"o adresă https:// (http:// merge numai pentru un server din rețeaua de acasă)"
msgstr "um endereço https:// (http:// só funciona para um servidor da rede de casa)"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"un corp JSON bun (pune locurile între ghilimele, de exemplu \"q\": "
"\"{text}\")"
msgstr "um corpo JSON válido (põe os marcadores entre aspas, por exemplo \"q\": \"{text}\")"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "un nume de antet bun (litere, cifre și - _ ., de exemplu Authorization)"
msgstr "um nome de cabeçalho válido (letras, algarismos e - _ ., por exemplo Authorization)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"calea traducerii în răspunsul JSON (chei și numere despărțite prin punct, de "
"exemplu translatedText)"
msgstr "o caminho da tradução na resposta JSON (chaves e números separados por ponto, por exemplo translatedText)"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Lipsește regiunea resursei Azure: o găsești în portal, la resursa "
"Translator, Overview › Location (de exemplu Germany West Central = "
"germanywestcentral)."
msgstr "Falta a região do recurso Azure: encontra-la no portal, no recurso Translator, Overview › Location (por exemplo Germany West Central = germanywestcentral)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Cheia sau regiunea nu se potrivesc: verifică amândouă în portal (Keys and "
"Endpoint)."
msgstr "A chave e a região não correspondem: verifica as duas no portal (Keys and Endpoint)."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Serverul de la adresa ta a răspuns cu eroarea HTTP %d. Începutul "
"răspunsului: „%s”"
msgstr "O servidor do teu endereço respondeu com o erro HTTP %d. Início da resposta: «%s»"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Răspunsul serverului nu e JSON (dacă serverul dă numai traducerea, alege "
"„Text simplu” la răspuns). Începutul răspunsului: „%s”"
msgstr "A resposta do servidor não é JSON (se o servidor só dá a tradução, escolhe «Texto simples» na resposta). Início da resposta: «%s»"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Calea „%s” nu găsește nicio traducere în răspunsul serverului. Începutul "
"răspunsului: „%s”"
msgstr "O caminho «%s» não encontra nenhuma tradução na resposta do servidor. Início da resposta: «%s»"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Serverul nu a dat nicio traducere. Începutul răspunsului: „%s”"
msgstr "O servidor não deu nenhuma tradução. Início da resposta: «%s»"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Traducerea subtitrărilor vine prea târziu: serverul răspunde în %s, în "
"medie. Alege un serviciu din internet (Gemini, gratuit, fără card) sau un "
"model mai mic."
msgstr "A tradução das legendas chega demasiado tarde: o servidor responde em %s, em média. Escolhe um serviço da internet (Gemini, gratuito, sem cartão) ou um modelo mais pequeno."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "%s a ajuns la limita gratuită pe zi (sau pe lună)."
msgstr "%s chegou ao limite gratuito diário (ou mensal)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Traducerea s-a oprit până se reînnoiește limita. Ca să meargă și atunci, "
"pune servicii de rezervă în Meniu › Setări › Sunet și subtitrări › "
"Traducerea subtitrărilor."
msgstr "A tradução parou até o limite se renovar. Para funcionar também nessa altura, põe serviços de reserva em Menu › Definições › Áudio e Faixas de Som › Tradução das legendas."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"De exemplu Azure Translator: Free F0, 2.000.000 de caractere pe lună, "
"gratuit."
msgstr "Por exemplo Azure Translator: Free F0, 2.000.000 de carateres por mês, grátis."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Traducerea subtitrărilor s-a oprit până schimbi setările: %s"
msgstr "A tradução das legendas parou até mudares as definições: %s"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid "Am găsit regiunea: %s (%s)."
msgstr "Região encontrada: %s (%s)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Cel mai simplu: pornește serverul pe calculator (pașii de mai jos), apoi "
"apasă „Caută în rețeaua de acasă”, pe televizor sau pe telefon. Receptorul "
"găsește singur serverul; nu mai trebuie să scrii adresa."
msgstr "O mais simples: inicia o servidor no computador (os passos abaixo) e depois carrega em «Procurar na rede de casa», no televisor ou no telefone. O recetor encontra sozinho o servidor; já não precisas de escrever o endereço."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Prima dată, Windows poate întreba dacă lași programul să primească conexiuni "
"din rețea: apasă „Allow access”. Dacă receptorul tot nu găsește serverul: "
"Windows Security, Firewall & network protection, „Allow an app through "
"firewall”, „Change settings” și bifează programul (Ollama, LM Studio sau "
"Docker) la „Private”. Rețeaua de acasă trebuie să fie „Private network” "
"(Settings, Network & internet, rețeaua ta, „Network profile type”)."
msgstr "Da primeira vez, o Windows pode perguntar se deixas o programa receber ligações da rede: carrega em «Allow access». Se o recetor continuar sem encontrar o servidor: Windows Security, Firewall & network protection, «Allow an app through firewall», «Change settings» e marca o programa (Ollama, LM Studio ou Docker) em «Private». A rede de casa tem de ser «Private network» (Settings, Network & internet, a tua rede, «Network profile type»)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"2.000.000 de caractere pe lună, gratuit (Free F0). E alegerea recomandată "
"pentru subtitrări multe (filme întregi, în fiecare zi), ca serviciu "
"principal sau de rezervă. Cardul se cere la înscriere numai pentru "
"verificare; pe Free F0 nu se plătește nimic. După 30 de zile contul trebuie "
"trecut pe „Pay as you go”, tot fără cost cât resursa rămâne Free F0."
msgstr "2.000.000 de carateres por mês, grátis (Free F0). É a escolha recomendada para muitas legendas (filmes inteiros, todos os dias), como serviço principal ou de reserva. O cartão é pedido na inscrição só para verificação; no Free F0 não se paga nada. Ao fim de 30 dias a conta tem de passar para «Pay as you go», continuando sem custo enquanto o recurso ficar em Free F0."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Pentru subtitrări multe (filme întregi, în fiecare zi) pune în setări și "
"servicii de rezervă, de exemplu Azure Translator: când Gemini dă eroarea "
"429, receptorul trece singur la următorul. Lista se face din servicii "
"diferite: limita Gemini e pe proiect, iar mai multe conturi făcute ca să "
"aduni limitele gratuite înseamnă ocolirea limitelor, pe care termenii Google "
"o interzic."
msgstr "Para muitas legendas (filmes inteiros, todos os dias) põe também serviços de reserva nas definições, por exemplo Azure Translator: quando o Gemini dá o erro 429, o recetor passa sozinho para o seguinte. A lista faz-se com serviços diferentes: o limite do Gemini é por projeto, e várias contas criadas para somar os limites gratuitos significam contornar os limites, o que os termos da Google proíbem."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Gratuit pentru folosire ocazională, cu un număr limitat de cereri pe minut "
"și pe zi; Google arată cifrele numai în contul tău. La subtitrări fără pauză "
"poate da eroarea 429 după câteva minute, iar limita pe zi se poate termina."
msgstr "Grátis para uso ocasional, com um número limitado de pedidos por minuto e por dia; a Google mostra os números só na tua conta. Com legendas sem pausa pode dar o erro 429 ao fim de alguns minutos, e o limite diário pode esgotar-se."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Peste limita pe minut, cererile primesc eroarea 429 câteva secunde: "
"receptorul așteaptă cât spune Google și trece între timp la serviciul de "
"rezervă, dacă ai pus unul. Peste limita pe zi, până a doua zi (în jurul orei "
"10, ora României). Fără card nu se plătește nimic."
msgstr "Acima do limite por minuto, os pedidos recebem o erro 429 durante alguns segundos: o recetor espera o tempo que a Google indica e entretanto passa para o serviço de reserva, se puseste um. Acima do limite diário, até ao dia seguinte (por volta das 10, hora da Roménia). Sem cartão não se paga nada."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În casă: instalează Ollama de pe ollama.com pe un calculator și pornește-l."
msgstr "Em casa: instala o Ollama a partir de ollama.com num computador e inicia-o."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"În PowerShell scrie: ollama pull gemma3:4b (3,3 GB). gemma3:12b traduce mai "
"bine, dar e mai lent (8,1 GB); pentru un calculator slab, gemma3:1b (815 "
"MB). Modelele qwen2.5 traduc slab în română."
msgstr "No PowerShell escreve: ollama pull gemma3:4b (3,3 GB). gemma3:12b traduz melhor, mas é mais lento (8,1 GB); para um computador fraco, gemma3:1b (815 MB). Os modelos qwen2.5 traduzem mal para romeno."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Ca să-l vadă receptorul: deschide Ollama, intră în Settings și pornește "
"„Expose Ollama to the network” (Ollama 0.9.5 sau mai nou; numele poate fi "
"puțin altul). Dacă nu găsești setarea: închide Ollama de lângă ceas "
"(„Quit”), caută în Start „environment variables” („variabile de mediu”), "
"adaugă la contul tău OLLAMA_HOST cu valoarea 0.0.0.0:11434, apasă OK și "
"pornește din nou Ollama."
msgstr "Para o recetor o ver: abre o Ollama, entra em Settings e liga «Expose Ollama to the network» (Ollama 0.9.5 ou mais recente; o nome pode ser um pouco diferente). Se não encontrares a definição: fecha o Ollama junto ao relógio («Quit»), procura em Iniciar «environment variables» («variáveis de ambiente»), acrescenta à tua conta OLLAMA_HOST com o valor 0.0.0.0:11434, carrega em OK e inicia de novo o Ollama."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Fără căutare: scrie aici adresa http://IP-UL-CALCULATORULUI:11434 și modelul "
"gemma3:4b. Cheie nu trebuie."
msgstr "Sem pesquisa: escreve aqui o endereço http://IP-DO-COMPUTADOR:11434 e o modelo gemma3:4b. Não é preciso chave."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"LM Studio merge la fel: fila „Developer”, „Start server”, apoi în setările "
"serverului „Serve on Local Network”, cu „Require Authentication” oprit; "
"adresa http://IP-UL-CALCULATORULUI:1234 și numele modelului din LM Studio."
msgstr "O LM Studio funciona da mesma forma: separador «Developer», «Start server», depois nas definições do servidor «Serve on Local Network», com «Require Authentication» desligado; o endereço http://IP-DO-COMPUTADOR:1234 e o nome do modelo no LM Studio."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"„Adresă proprie” e pentru un server de traducere ales de tine, de exemplu un "
"LibreTranslate pornit pe un calculator din casă. Receptorul trimite fiecare "
"rând de subtitrare într-o cerere separată."
msgstr "«Endereço próprio» é para um servidor de tradução escolhido por ti, por exemplo um LibreTranslate a correr num computador de casa. O recetor envia cada linha de legenda num pedido separado."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Adresa e un șablon: scrii adresa serverului și pui în ea locurile {text} "
"(textul de tradus), {sursa} (limba subtitrării, sau auto când nu se știe) și "
"{tinta} (limba traducerii, de exemplu ro). Receptorul le înlocuiește la "
"fiecare cerere."
msgstr "O endereço é um molde: escreves o endereço do servidor e pões nele os marcadores {text} (o texto a traduzir), {sursa} (a língua da legenda, ou auto quando não se sabe) e {tinta} (a língua da tradução, por exemplo ro). O recetor substitui-os em cada pedido."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Adresa începe cu https://. O adresă http:// merge numai pentru un server din "
"rețeaua de acasă (de exemplu 192.168.1.50). Nume și parolă nu se scriu în "
"adresă."
msgstr "O endereço começa por https://. Um endereço http:// só funciona para um servidor da rede de casa (por exemplo 192.168.1.50). O nome e a palavra-passe não se escrevem no endereço."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Metoda GET trimite totul în adresă, deci {text} trebuie să fie în adresă. "
"Metoda POST trimite și un corp, cu aceleași locuri: JSON (pune locurile "
"între ghilimele, de exemplu \"q\": \"{text}\") sau formular (de exemplu "
"q={text}&target={tinta})."
msgstr "O método GET envia tudo no endereço, por isso {text} tem de estar no endereço. O método POST envia também um corpo, com os mesmos marcadores: JSON (põe os marcadores entre aspas, por exemplo \"q\": \"{text}\") ou formulário (por exemplo q={text}&target={tinta})."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Antetul e opțional: dacă serverul cere o cheie, scrie numele antetului (de "
"exemplu Authorization) și, la valoare, ce cere serverul (de exemplu Bearer, "
"un spațiu și cheia). Valoarea se păstrează criptată pe receptor și nu se mai "
"arată."
msgstr "O cabeçalho é opcional: se o servidor pedir uma chave, escreve o nome do cabeçalho (por exemplo Authorization) e, como valor, o que o servidor pede (por exemplo Bearer, um espaço e a chave). O valor fica guardado cifrado no recetor e não volta a ser mostrado."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Răspunsul: alege „Text simplu” dacă serverul dă numai traducerea. Pentru "
"JSON scrie calea până la traducere: numele cheilor și numerele pozițiilor "
"(de la 0), despărțite prin punct, de exemplu translatedText sau "
"data.translations.0.translatedText. Cu * iei toate elementele, lipite în "
"ordine, de exemplu 0.*.0."
msgstr "A resposta: escolhe «Texto simples» se o servidor só dá a tradução. Para JSON escreve o caminho até à tradução: os nomes das chaves e os números das posições (a partir de 0), separados por ponto, por exemplo translatedText ou data.translations.0.translatedText. Com * apanhas todos os elementos, juntos por ordem, por exemplo 0.*.0."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Exemplu, un LibreTranslate al tău din casă: adresa "
"http://192.168.1.50:5000/translate, metoda POST, corpul JSON {\"q\": "
"\"{text}\", \"source\": \"{sursa}\", \"target\": \"{tinta}\", \"format\": "
"\"text\"}, răspunsul JSON, calea translatedText."
msgstr "Exemplo, o teu próprio LibreTranslate em casa: o endereço http://192.168.1.50:5000/translate, o método POST, o corpo JSON {\"q\": \"{text}\", \"source\": \"{sursa}\", \"target\": \"{tinta}\", \"format\": \"text\"}, a resposta JSON, o caminho translatedText."

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-brace-format
msgid ""
"Exemplu cu GET: adresa "
"https://example.com/translate?q={text}&from={sursa}&to={tinta} și răspunsul "
"„Text simplu” (example.com ține locul serverului tău)."
msgstr "Exemplo com GET: o endereço https://example.com/translate?q={text}&from={sursa}&to={tinta} e a resposta «Texto simples» (example.com ocupa o lugar do teu servidor)."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid ""
"Apasă „Probează traducerea”. Dacă nu merge, mesajul arată începutul "
"răspunsului serverului, ca să vezi unde e traducerea și ce cale să scrii."
msgstr "Carrega em «Testar a tradução». Se não funcionar, a mensagem mostra o início da resposta do servidor, para veres onde está a tradução e que caminho escrever."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Depinde de server. Un server al tău din casă nu are cotă."
msgstr "Depende do servidor. Um servidor teu em casa não tem quota."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Depinde de server."
msgstr "Depende do servidor."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cum folosești o adresă proprie"
msgstr "Como usar um endereço próprio"

#: lib/python/Components/HdsTraducereSubtitrari.py
#, python-format
msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor, prin internet, spre serverul de la adresa scrisă de tine (%s), "
"care îl traduce."
msgstr "O texto das legendas (só o texto, sem imagem e sem som) sai do recetor, pela internet, para o servidor no endereço que escreveste (%s), que o traduz."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Ollama ascultă din fabrică numai pe calculatorul lui. În Ollama 0.9.5 sau "
"mai nou: Settings, pornește „Expose Ollama to the network”."
msgstr "De fábrica, o Ollama só escuta no próprio computador. No Ollama 0.9.5 ou mais recente: Settings, liga «Expose Ollama to the network»."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Sau: închide Ollama de lângă ceas, pune variabila de mediu OLLAMA_HOST cu "
"valoarea 0.0.0.0:11434 și pornește din nou Ollama."
msgstr "Ou: fecha o Ollama junto ao relógio, define a variável de ambiente OLLAMA_HOST com o valor 0.0.0.0:11434 e inicia de novo o Ollama."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"LM Studio: fila „Developer”, „Start server” și „Serve on Local Network”. "
"Căutarea nu-l găsește: scrie adresa de mână (portul 1234), ca server "
"compatibil OpenAI."
msgstr "LM Studio: separador «Developer», «Start server» e «Serve on Local Network». A pesquisa não o encontra: escreve o endereço à mão (porta 1234), como servidor compatível com OpenAI."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Windows: la întrebarea paravanului apasă „Allow access”. Altfel: Windows "
"Security, „Allow an app through firewall”, bifează Ollama la „Private”."
msgstr "Windows: quando a firewall perguntar, carrega em «Allow access». Senão: Windows Security, «Allow an app through firewall», marca o Ollama em «Private»."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid ""
"Rețeaua de acasă pe calculator trebuie să fie „Private network” (Settings › "
"Network & internet), iar receptorul și calculatorul în același router."
msgstr "No computador, a rede de casa tem de ser «Private network» (Settings › Network & internet), e o recetor e o computador no mesmo router."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Traducerea subtitrărilor e gata, cu %s. Proba: %s"
msgstr "A tradução das legendas está pronta, com %s. Teste: %s"

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid ""
"Traducerea subtitrărilor e pornită, cu %s, dar cota gratuită s-a terminat. "
"Merge din nou după ce se reface cota."
msgstr "A tradução das legendas está ligada, com %s, mas a quota gratuita acabou. Volta a funcionar quando a quota se renovar."

#: lib/python/Components/HdsConfigurareTraducere.py
#, python-format
msgid "Traducerea subtitrărilor e pornită, cu %s (fără probă)."
msgstr "A tradução das legendas está ligada, com %s (sem teste)."

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Server compatibil OpenAI"
msgstr "Servidor compatível com OpenAI"

#: lib/python/Components/HdsConfigurareTraducere.py
msgid "Serviciul ales nu are adresă de server."
msgstr "O serviço escolhido não tem endereço de servidor."

