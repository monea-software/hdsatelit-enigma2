msgstr "Traduzido automaticamente. INFO: o texto original."

#: lib/python/Screens/EventView.py lib/python/Screens/SecondInfoBar.py
msgid "Textul original, netradus. INFO: închide."
msgstr "Texto original, sem tradução. INFO: fechar."

msgid "Tradu automat din orice subtitrare disponibilă"
msgstr "Traduzir automaticamente a partir de qualquer legenda disponível"

msgid "Cu traducerea subtitrărilor pornită, „Tradu automat din orice subtitrare disponibilă” alege singură și o subtitrare în altă limbă, ca să fie tradusă."
msgstr "Com a tradução de legendas ligada, «Traduzir automaticamente a partir de qualquer legenda disponível» escolhe também sozinha uma legenda noutro idioma, para ser traduzida."

msgid "Traducerea subtitrărilor e pornită (în %s): dacă nu există subtitrare în limba aceasta, se alege singură una în altă limbă, întâi teletextul, apoi DVB citită ca text, și se traduce."
msgstr "A tradução de legendas está ligada (idioma de destino: %s): se não houver legenda neste idioma, é escolhida automaticamente uma noutro idioma, primeiro o teletexto, depois a DVB lida como texto, e é traduzida."

msgid "Traducerea subtitrărilor e pornită (în %s): se alege numai o subtitrare în limba aceasta, apoi preferințele de mai sus."
msgstr "A tradução de legendas está ligada (idioma de destino: %s): só é escolhida uma legenda neste idioma, depois as tuas preferências acima."

msgid "în limba traducerii"
msgstr "no idioma da tradução"

msgid "teletext tradus automat"
msgstr "teletexto traduzido automaticamente"

msgid "DVB citită ca text și tradusă automat"
msgstr "DVB lida como texto e traduzida automaticamente"

