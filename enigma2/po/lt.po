msgstr ""
"Televizoriaus rodomas pavadinimas HDMI įėjimų sąraše per CEC (LG SIMPLINK, "
"Samsung Anynet+). Tuščias: imtuvo modelis. Ne daugiau 14 raidžių, be "
"diakritinių ženklų; televizoriuje įvedamas skaičių mygtukais, kaip SMS."

msgid "Numele atributului „%s” nu e bun."
msgstr "Atributo pavadinimas „%s“ netinkamas."

msgid "Numele buchetului nou"
msgstr "Naujo rinkinio pavadinimas"

msgid ""
"Numele calculatorului sau adresa lui, de pildă 192.168.1.20. Merge și \\"
"\\NAS\\Filme sau nas:/volume1/filme: se despart singure."
msgstr ""
"Kompiuterio pavadinimas arba adresas, pvz., 192.168.1.20. Tinka ir \\"
"\\NAS\\Filme arba nas:/volume1/filme: jie atskiriami savaime."

msgid "Numele canalului"
msgstr "Kanalo pavadinimas"

msgid "Numele canalului (orice parte din nume)"
msgstr "Kanalo pavadinimas (bet kuri pavadinimo dalis)"

msgid "Numele canalului căutat"
msgstr "Ieškomo kanalo pavadinimas"

msgid "Numele contului VPN"
msgstr "VPN paskyros pavadinimas"

msgid ""
"Numele cu care apare în listă și în fișierul înregistrării. OK deschide "
"tastatura."
msgstr ""
"Pavadinimas, kuriuo rodomas sąraše ir įrašo faile. OK atidaro klaviatūrą."

msgid "Numele cu care apari pe forum și pe site."
msgstr "Vardas, kuriuo rodaisi forume ir svetainėje."

msgid ""
"Numele de utilizator al contului tău OpenSubtitles.com (nu adresa de e-"
"mail). Un cont gratuit dă 20 de descărcări pe zi."
msgstr ""
"Tavo OpenSubtitles.com paskyros naudotojo vardas (ne el. pašto adresas). "
"Nemokama paskyra suteikia 20 atsisiuntimų per dieną."

msgid "Numele de utilizator nu poate conține virgule sau rânduri noi."
msgstr "Naudotojo varde negali būti kablelių ar naujų eilučių."

msgid ""
"Numele de utilizator sau parola nu sunt bune, ori utilizatorul nu are voie "
"în acest dosar."
msgstr ""
"Naudotojo vardas arba slaptažodis neteisingi arba naudotojas neturi teisės "
"patekti į šį aplanką."

msgid "Numele dosarului nou"
msgstr "Naujo aplanko pavadinimas"

msgid "Numele e cel al programului care rulează."
msgstr "Pavadinimas yra veikiančios programos pavadinimas."

msgid "Numele e cel din cererea lui de parolă."
msgstr "Pavadinimas yra iš jo slaptažodžio užklausos."

msgid "Numele e cel din pachetul lui."
msgstr "Pavadinimas yra iš jo paketo."

msgid "Numele e cel din scriptul lui de pornire."
msgstr "Pavadinimas yra iš jo paleidimo scenarijaus."

msgid "Numele e cel trimis de serverul lui."
msgstr "Pavadinimas, siunčiamas jo serverio"

msgid "Numele e deja folosit. Alege altul."
msgstr "Vardas jau naudojamas. Pasirink kitą."

msgid ""
"Numele e gol sau are numai semne (punct, liniuță, spații). Unele pot fi "
"fluxuri care pornesc numai uneori: uită-te la frecvență și la imagine / "
"sunet."
msgstr ""
"Pavadinimas tuščias arba sudarytas tik iš ženklų (taško, brūkšnio, tarpų). "
"Kai kurie gali būti srautai, kurie transliuoja tik kartais: pažiūrėk į dažnį "
"ir vaizdą / garsą."

msgid "Numele e salvat."
msgstr "Vardas išsaugotas."

msgid "Numele e titlul paginii lui."
msgstr "Pavadinimas yra jo puslapio antraštė."

msgid "Numele filmului"
msgstr "Filmo pavadinimas"

msgid ""
"Numele fișierului nu e bun sau playerul nu cunoaște acest fel de fișier."
msgstr "Failo pavadinimas neteisingas arba grotuvas nežino tokio failo tipo."

msgid "Numele fișierului nu se poate citi"
msgstr "Failo pavadinimo negalima nuskaityti"

msgid ""
"Numele fișierului nu se poate citi pe receptor. Redenumește-l fără "
"diacritice."
msgstr ""
"Failo pavadinimo imtuve negalima nuskaityti. Pervadink jį be diakritinių "
"ženklų."

msgid "Numele fluxului"
msgstr "Srauto pavadinimas"

msgid "Numele fontului"
msgstr "Šrifto pavadinimas"

msgid "Numele fontului, de exemplu Roboto"
msgstr "Šrifto pavadinimas, pavyzdžiui, Roboto"

msgid "Numele marcajului"
msgstr "Žymeklio pavadinimas"

msgid "Numele modelului de pe server, de exemplu gemma3:4b sau qwen2.5:7b."
msgstr "Modelio pavadinimas serveryje, pavyzdžiui, gemma3:4b arba qwen2.5:7b."

msgid ""
"Numele modelului e prea lung sau are caractere nepermise. Nu s-a pornit "
"nimic."
msgstr ""
"Modelio pavadinimas per ilgas arba turi neleistinų simbolių. Nieko "
"nepaleista."

msgid "Numele modelului nu e bun."
msgstr "Modelio pavadinimas netinkamas."

msgid "Numele modulelor: %s"
msgstr "Modulių pavadinimai: %s"

msgid "Numele nou"
msgstr "Naujas vardas"

#, python-format
msgid "Numele nu este bun (cel mult %d semne, pe un singur rând)."
msgstr "Pavadinimas netinkamas (ne daugiau %d ženklų, vienoje eilutėje)."

msgid "Numele nu poate fi gol."
msgstr "Pavadinimas negali būti tuščias."

msgid "Numele nu se poate schimba încă de aici."
msgstr "Vardo kol kas negalima pakeisti iš čia."

msgid "Numele pachetului nu este valid. Nu se instalează."
msgstr "Paketo pavadinimas netinkamas. Neįdiegiama."

msgid "Numele pachetului nu este valid. Nu se șterge."
msgstr "Paketo pavadinimas netinkamas. Netrinama."

msgid "Numele paginii (dacă vrei)"
msgstr "Puslapio pavadinimas (jei nori)"

#, python-format
msgid "Numele pe televizor: %s, cerut de televizor la %s."
msgstr "Pavadinimas televizoriuje: %s, televizoriaus paprašytas %s."

#, python-format
msgid "Numele pe televizor: %s."
msgstr "Pavadinimas TV: %s."

msgid "Numele plăcii de sunet are numai litere, cifre și : , _ - ."
msgstr ""
"Garso plokštės pavadinime gali būti tik raidės, skaitmenys ir : , _ - ."

msgid ""
"Numele poate avea doar litere mici, cifre și semnele - _ . (cel mult 32)."
msgstr ""
"Pavadinime gali būti tik mažosios raidės, skaitmenys ir ženklai - _ . "
"(daugiausia 32)."

msgid "Numele postului de radio"
msgstr "Radijo stoties pavadinimas"

msgid "Numele public"
msgstr "Viešas vardas"

msgid "Numele public are 2-40 de semne: litere, cifre, spațiu, punct, liniuță."
msgstr ""
"Viešą vardą sudaro 2-40 ženklų: raidės, skaitmenys, tarpas, taškas, "
"brūkšnelis."

msgid "Numele public e deja folosit de alt tester. Alege altul."
msgstr "Viešą vardą jau naudoja kitas testuotojas. Pasirink kitą."

msgid "Numele receptorului"
msgstr "Imtuvo pavadinimas"

msgid "Numele receptorului pe televizor"
msgstr "Imtuvo pavadinimas televizoriuje"

msgid "Numele rețelei ascunse"
msgstr "Paslėpto tinklo pavadinimas"

msgid "Numele satelitului"
msgstr "Palydovo vardas"

msgid "Numele satelitului are un caracter care nu se poate scrie în listă."
msgstr "Palydovo pavadinime yra ženklas, kurio negalima įrašyti į sąrašą."

msgid "Numele satelitului e prea lung: cel mult %d de caractere."
msgstr "Palydovo pavadinimas per ilgas: ne daugiau kaip %d ženklų."

msgid "Numele sau parola nu sunt bune. VPN-ul nu mai încearcă singur."
msgstr ""
"Pavadinimas arba slaptažodis netinkami. VPN pats nebesistengia prisijungti."

msgid "Numele serverului NTP nu este valid."
msgstr "NTP serverio pavadinimas netinkamas."

msgid ""
"Numele serverului nu se găsește în rețea. Scrie adresa lui, de pildă "
"192.168.1.20."
msgstr ""
"Serverio pavadinimas nerastas tinkle. Įvesk jo adresą, pavyzdžiui "
"192.168.1.20."

msgid "Numele setării, cu tastele 0-9"
msgstr "Nustatymo pavadinimas, klavišais 0-9"

msgid ""
"Numele spune HD sau 4K, dar emițătorul îl anunță ca SD: filtrul „HD și 4K” "
"nu-l prinde. Filtrul „HD în nume, tip SD” din „Adaugă canale” le arată pe "
"toate, cu bife."
msgstr ""
"Pavadinime nurodyta HD arba 4K, bet transliuotojas skelbia kanalą kaip SD: "
"filtras „HD ir 4K“ jo nepagauna. Filtras „HD pavadinime, SD tipas“ skiltyje "
"„Pridėti kanalus“ rodo juos visus su žymėmis."

msgid "Numele sursei (litere mici, cifre și -)"
msgstr "Šaltinio vardas (mažosios raidės, skaitmenys ir -)"

msgid "Numele sursei nu poate fi gol."
msgstr "Šaltinio pavadinimas negali būti tuščias."

msgid "Numele sursei: litere mici, cifre și -"
msgstr "Šaltinio vardas: mažosios raidės, skaitmenys ir -"

msgid "Numele telecomenzii"
msgstr "Pultelio pavadinimas"

msgid "Numele telecomenzii nu poate fi gol."
msgstr "Pulto pavadinimas negali būti tuščias."

msgid "Numele tău pe forum"
msgstr "Tavo vardas forume"

msgid "Numele tău pe forum e acum „%s”."
msgstr "Tavo vardas forume dabar yra „%s“."

msgid "Numele și parola au fost șterse de pe receptor."
msgstr "Pavadinimas ir slaptažodis buvo ištrinti iš imtuvo."

msgid "Numele și parola contului"
msgstr "Paskyros pavadinimas ir slaptažodis"

msgid ""
"Numele și parola contului HMA. După salvare nu se mai arată nicăieri. Se "
"scriu mai ușor din telefon, în interfața web."
msgstr ""
"HMA paskyros vardas ir slaptažodis. Išsaugojus jie niekur neberodomi. "
"Lengviau juos įvesti telefonu, žiniatinklio sąsajoje."

msgid "Numele și parola de serviciu"
msgstr "Tarnybos vardas ir slaptažodis"

msgid "Numele și parola din fișier nu se folosesc: se scriu pe receptor."
msgstr "Pavadinimas ir slaptažodis iš failo nenaudojami: jie įvedami imtuve."

msgid "Numele și parola sunt salvate. Nu se mai arată nicăieri."
msgstr "Pavadinimas ir slaptažodis išsaugoti. Niekur neberodomi."

msgid "Numele, cu tastatura de pe ecran"
msgstr "Pavadinimas, ekrano klaviatūra"

msgid "Numele, cu tastele 0-9"
msgstr "Pavadinimas, mygtukais 0-9"

msgid ""
"Numerele DVB ale fluxului (pentru siglă): SID, TSID, ONID, namespace (hex)"
msgstr "Srauto DVB numeriai (logotipui): SID, TSID, ONID, namespace (hex)"

msgid "Număr de fișiere"
msgstr "Failų skaičius"

msgid "Numărate de la ora"
msgstr "Skaičiuojama nuo"

msgid "Numărul canalului"
msgstr "Kanalo numeris"

msgid "Numărul canalului din lista de canale."
msgstr "Kanalo numeris iš kanalų sąrašo."

#, python-format
msgid "Numărul copiilor păstrate trebuie să fie între 1 și %d."
msgstr "Saugomų kopijų skaičius turi būti nuo 1 iki %d."

msgid "Numărul de bare"
msgstr "Juostų skaičius"

msgid "Numărul de secunde nu este bun."
msgstr "Sekundžių skaičius neteisingas."

msgid "Numărul din lista de canale, cel la care duc cifrele telecomenzii."
msgstr "Kanalų sąrašo numeris, į kurį veda pultelio skaitmenys."

msgid ""
"Numărul mare nu înseamnă procesor ocupat: include firele driverelor care "
"așteaptă."
msgstr ""
"Didelis skaičius nereiškia užimto procesoriaus: jis apima laukiančias "
"tvarkyklių gijas."

msgid "Numărul operatorului"
msgstr "Operatoriaus numeris"

msgid "Numărul poziției (1-255)"
msgstr "Padėties numeris (1-255)"

#, python-format
msgid "Numărul procesului (PID): %s"
msgstr "Proceso numeris (PID): %s"

msgid "Numărul rețelei (ONID)"
msgstr "Tinklo numeris (ONID)"

msgid "Numărul transponderului (TSID)"
msgstr "Transponderio numeris (TSID)"

msgid "Numărul și numele"
msgstr "Nr. ir pavadinimas"

msgid "Numărătoarea opririlor"
msgstr "Sustojimų skaitiklis"

msgid ""
"O adresă http:// merge numai pentru un server din rețeaua de acasă (de "
"exemplu 192.168.1.50); pentru un server de pe internet scrie https://."
msgstr ""
"http:// adresas tinka tik serveriui namų tinkle (pavyzdžiui, 192.168.1.50); "
"interneto serveriui rašyk https://."

msgid ""
"O altă placă e deja configurată. Pe televizor, aceeași întrebare apare la OK."
msgstr ""
"Kita plokštė jau sukonfigūruota. Televizoriuje tas pats klausimas pasirodo "
"paspaudus OK."

msgid "O altă schimbare a rețelei încă lucrează. Așteaptă să se termine."
msgstr "Kitas tinklo keitimas dar vyksta. Palauk, kol jis baigsis."

msgid "O altă schimbare de LNB așteaptă confirmarea."
msgstr "Kitas LNB pakeitimas laukia patvirtinimo."

msgid "O altă valoare a receptorului nu se potrivește."
msgstr "Kita imtuvo reikšmė nesutampa."

msgid "O captură aleasă nu mai există. Alege din nou."
msgstr "Pasirinktos ekrano nuotraukos nebėra. Pasirink iš naujo."

msgid ""
"O cheie pleacă numai pe https:// sau spre un server din rețeaua de acasă. "
"Scrie adresa cu https://. Cheia nu a plecat nicăieri."
msgstr ""
"Raktas siunčiamas tik per https:// arba į namų tinklo serverį. Įrašyk adresą "
"su https://. Raktas niekur nebuvo išsiųstas."

msgid "O conectare Wi-Fi încă lucrează. Așteaptă să se termine sau oprește-o."
msgstr ""
"Wi-Fi prisijungimas dar vyksta. Palauk, kol baigsis, arba jį sustabdyk."

msgid "O copie așteaptă să fie pusă la loc la repornirea interfeței."
msgstr "Kopija laukia atkūrimo, kai sąsaja bus paleista iš naujo."

msgid "O copie se face deja. Așteaptă să se termine."
msgstr "Kopija jau kuriama. Palauk, kol baigsis."

msgid ""
"O copie se face singură înainte de fiecare salvare, aici și în interfața "
"web. Întoarcerea pune întâi lista de acum într-o copie nouă."
msgstr ""
"Kopija daroma automatiškai prieš kiekvieną įrašymą, čia ir žiniatinklio "
"sąsajoje. Grąžinant dabartinis sąrašas pirmiausia įdedamas į naują kopiją."

msgid "O cutie pentru toate rândurile"
msgstr "Vienas stačiakampis visoms eilutėms"

msgid ""
"O căutare e deja în curs pe receptor. Așteaptă să se termine sau oprește-o."
msgstr "Imtuve jau vyksta paieška. Palauk, kol ji baigsis, arba sustabdyk ją."

msgid "O căutare e deja în curs."
msgstr "Paieška jau vyksta."

msgid "O căutare sau o descărcare merge deja; așteaptă să se termine."
msgstr "Paieška arba atsisiuntimas jau vyksta; palauk, kol baigsis."

msgid ""
"O data pe zi, in fundal, receptorul ia de pe stb.hdsatelit.com frecventele "
"si numele posturilor. Butonul Actualizeaza lista merge oricand."
msgstr ""
"Kartą per dieną, fone, imtuvas atsisiunčia dažnius ir stočių pavadinimus iš "
"stb.hdsatelit.com. Mygtukas „Atnaujinti sąrašą“ veikia bet kada."

msgid "O dată pe minut"
msgstr "Kartą per minutę"

msgid "O dată pe săptămână"
msgstr "Kartą per savaitę"

msgid ""
"O dată pe zi, noaptea, numai felurile bifate, și imediat după o oprire "
"neașteptată a interfeței sau o actualizare care nu a reușit. Fără bifă "
"pleacă numai ce trimiți tu cu „Trimite acum”."
msgstr ""
"Kartą per dieną, naktį, tik pažymėti tipai, ir iškart po netikėto sąsajos "
"sustojimo arba nepavykusio atnaujinimo. Be žymės siunčiama tik tai, ką pats "
"siunti mygtuku „Siųsti dabar“."

msgid ""
"O dată pe zi, în fundal, receptorul ia de pe stb.hdsatelit.com frecvențele "
"și numele posturilor. Butonul „Actualizează lista” merge oricând. <span "
"id=\"ultimaZilnica\"></span>"
msgstr ""
"Kartą per dieną, fone, imtuvas iš stb.hdsatelit.com paima dažnius ir stočių "
"pavadinimus. Mygtukas „Atnaujinti sąrašą“ veikia bet kada. <span "
"id=\"ultimaZilnica\"></span>"

msgid "O eroare pe receptor."
msgstr "Klaida imtuve."

msgid "O greșeală, o idee sau o întrebare, direct echipei."
msgstr "Klaida, idėja ar klausimas, tiesiai komandai."

msgid "O lipești, iar receptorul recunoaște singur serviciul."
msgstr "Įklijuok ją, o imtuvas pats atpažins paslaugą."

msgid ""
"O listă de redare de pe disc nu se poate șterge din player, nici pe "
"televizor."
msgstr ""
"Grojaraštis diske negali būti ištrintas iš grotuvo, net per televizorių."

msgid "O margine e între 0 și 5 la sută din latura ei."
msgstr "Kraštas yra nuo 0 iki 5 procentų savo kraštinės."

msgid "O notă despre emisiune. OK deschide tastatura."
msgstr "Pastaba apie programą. OK atidaro klaviatūrą."

msgid "O pagină mai jos"
msgstr "Puslapiu žemyn"

msgid "O pagină mai sus"
msgstr "Puslapiu aukštyn"

msgid "O pagină în jos"
msgstr "Puslapiu žemyn"

msgid "O pagină în sus"
msgstr "Puslapiu aukštyn"

msgid ""
"O poză nu a putut fi urcată: trebuie să fie JPG sau PNG, de cel mult 4 MB."
msgstr ""
"Paveikslėlio įkelti nepavyko: jis turi būti JPG arba PNG, daugiausia 4 MB."

msgid "O poți instala din nou oricând, din aceeași sursă."
msgstr "Gali jį įdiegti iš naujo bet kada iš to paties šaltinio."

msgid "O probă DiSEqC e deja deschisă pe televizor. Închide-o întâi."
msgstr "Televizoriuje jau atidarytas DiSEqC testas. Pirmiausia jį uždaryk."

msgid "O reîmprospătare e deja în lucru."
msgstr "Atnaujinimas jau vyksta."

msgid "O reîncărcare e deja în curs."
msgstr "Įkėlimas iš naujo jau vyksta."

msgid ""
"O scanare DAB+ sau DVB-T2 e deschisă pe televizor. Așteaptă să se termine "
"sau oprește-o."
msgstr ""
"Televizoriuje atidaryta DAB+ ar DVB-T2 paieška. Palauk, kol ji baigsis, arba "
"sustabdyk ją."

msgid "O singură dată"
msgstr "Vieną kartą"

msgid ""
"O singură dată sau repetat: în fiecare zi, o dată pe săptămână, de luni până "
"vineri sau în zilele alese."
msgstr ""
"Kartą arba kartojama: kasdien, kas savaitę, I-V arba pasirinktomis dienomis."

msgid "O singură limbă: forumul traduce singur."
msgstr "Viena kalba: forumas verčia pats."

msgid ""
"O telecomandă USB (sau o tastatură) se bagă în receptor înainte; se vede "
"imediat."
msgstr ""
