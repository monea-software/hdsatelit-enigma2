msgstr "Toks pat ekranas yra televizoriuje, __DRUM_MENIU__."

msgid "Același ecran este pe televizor, în __DRUM_MENIU__."
msgstr "Toks pat ekranas yra televizoriuje, __DRUM_MENIU__."

msgid "Același forum e pe televizor: __DRUM_MENIU__, Forumul receptorului."
msgstr "Tas pats forumas yra televizoriuje: __DRUM_MENIU__, Imtuvo forumas."

msgid ""
"Același meniu ca la tasta MENU, cu aceleași intrări pentru nivelul ales pe "
"receptor. La fiecare intrare: pagina ei din interfața web, dacă are, pagina "
"de setări sau „Deschide pe televizor”."
msgstr ""
"Toks pat meniu kaip paspaudus mygtuką MENU, su tokiais pačiais įrašais "
"pasirinktam imtuvo lygiui. Prie kiekvieno įrašo: jo puslapis žiniatinklio "
"sąsajoje, jei yra, nustatymų puslapis arba „Atidaryti televizoriuje“."

msgid ""
"Același mesaj apare și în interfața web a receptorului, la pagina /paza-"
"model."
msgstr ""
"Tas pats pranešimas rodomas ir imtuvo žiniatinklio sąsajoje, puslapyje /paza-"
"model."

#, python-format
