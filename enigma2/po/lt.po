msgid "„%s”"
msgstr "„%s“"

#, python-format
msgid ""
"„%s” a fost scos din folosință. Fișierul se șterge la următoarea pornire."
msgstr "„%s“ išimtas iš naudojimo. Failas bus ištrintas per kitą paleidimą."

#, python-format
msgid "„%s” curățat: %d fișiere șterse, %s eliberați."
msgstr "„%s” išvalyta: ištrinta %d failų, atlaisvinta %s."

#, python-format
msgid "„%s” descărcat (%s), licență %s, folosibil în skin ca %s."
msgstr "„%s“ atsisiųstas (%s), licencija %s, galima naudoti skin kaip %s."

#, python-format
msgid "„%s” era deja oprită."
msgstr "„%s“ jau buvo sustabdytas."

#, python-format
msgid "„%s” era deja pornită."
msgstr "„%s“ jau buvo įjungtas."

msgid "„%s” este conectat, dar nu este ales pentru înregistrări."
msgstr "„%s” prijungtas, bet nepasirinktas įrašymams."

msgid "„%s” este conectat, dar receptorul nu îl poate citi."
msgstr "„%s” prijungtas, bet imtuvas negali jo nuskaityti."

#, python-format
msgid "„%s” este pus acum."
msgstr "„%s“ dabar naudojamas."

#, python-format
msgid ""
"„%s” merge acum. Ca s-o oprești, șterge-o din listă; ce s-a înregistrat până "
"acum rămâne."
msgstr ""
"„%s“ dabar vyksta. Norėdamas sustabdyti, pašalink jį iš sąrašo; kas jau "
"įrašyta, lieka."

#, python-format
msgid "„%s” nu merge acum. Reîncarcă pagina."
msgstr "„%s“ dabar nevyksta. Įkelk puslapį iš naujo."

msgid ""
"„%s” nu poate fi citit de receptor. Formatează-l pe un calculator ca FAT32 "
"(se șterge tot de pe el)."
msgstr ""
"„%s“ imtuvas negali nuskaityti. Suformatuok jį kompiuteryje kaip FAT32 (bus "
"ištrinta viskas, kas jame yra)."

#, python-format
msgid ""
"„%s” nu poate fi citit de receptor. Îl poți formata aici sau pe un "
"calculator, ca FAT32. Formatarea șterge tot de pe el."
msgstr ""
"„%s“ imtuvas negali nuskaityti. Gali jį formatuoti čia arba kompiuteryje, "
"kaip FAT32. Formatavimas ištrina viską iš jo."

#, python-format
msgid ""
"„%s” nu se găsește în depozitul liber google/fonts: licență neconfirmată, nu "
"se descarcă."
msgstr ""
"„%s“ nėra laisvajame google/fonts saugykloje: licencija nepatvirtinta, "
"neatsisiunčiama."

msgid "„%s” nu se poate folosi: %s."
msgstr "„%s” negalima naudoti: %s."

#, python-format
msgid "„%s” se alege cu 1 (da) sau 0 (nu)."
msgstr "„%s“ pasirenkamas 1 (taip) arba 0 (ne)."

msgid "„%s”, liber %s din %s"
msgstr "„%s“, laisva %s iš %s"

msgid "„%s”: aici se salvează acum"
msgstr "„%s”: čia dabar išsaugoma"

msgid "„%s”: aici se vor salva"
msgstr "„%s“: čia bus išsaugoma"

msgid ""
"„Adresă proprie” (alt serviciu, cu adresa lui) și toate celelalte setări "
"sunt pe pagina cu toate setările:"
msgstr ""
"„Savas adresas“ (kita paslauga, su savo adresu) ir visi kiti nustatymai yra "
"puslapyje su visais nustatymais:"

msgid ""
"„Adresă proprie” e pentru un server de traducere ales de tine, de exemplu un "
"LibreTranslate pornit pe un calculator din casă. Receptorul trimite fiecare "
"rând de subtitrare într-o cerere separată."
msgstr ""
"„Savo adresas“ skirtas tavo pasirinktam vertimo serveriui, pavyzdžiui, "
"LibreTranslate, paleistam namų kompiuteryje. Imtuvas kiekvieną subtitrų "
"eilutę siunčia atskira užklausa."

msgid "„Ca la calculator” revine la următoarea pornire a receptorului."
msgstr "„Kaip kompiuteryje“ grįš kitą kartą įjungus imtuvą."

msgid ""
"„Ca la calculator” revine numai după o repornire. Repornești receptorul acum?"
msgstr "„Kaip kompiuteryje“ grįš tik po perkrovimo. Ar perkrauti imtuvą dabar?"

msgid ""
"„Ca la calculator” se aplică la următoarea pornire; pe unele televizoare "
"imaginea iese spălăcită pe 60 Hz."
msgstr ""
"„Kaip kompiuteryje“ pritaikoma kitą kartą įjungus; kai kuriuose "
"televizoriuose vaizdas esant 60 Hz atrodo išblukęs."

msgid ""
"„Ca la calculator” se aplică numai după o repornire. Repornești receptorul "
"acum?"
msgstr ""
"„Kaip kompiuteryje“ pritaikoma tik po perkrovimo. Ar perkrauti imtuvą dabar?"

msgid ""
"„Enigma” și „Dreambox” sunt mărci ale Dream Property GmbH; celelalte nume de "
"produse aparțin deținătorilor lor."
msgstr ""
"„Enigma“ ir „Dreambox“ yra „Dream Property GmbH“ prekių ženklai; kiti "
"produktų pavadinimai priklauso jų savininkams."

msgid ""
"„Folosește pentru înregistrări” face pe disc dosarul movie, dacă lipsește. "
"Nu se șterge și nu se formatează nimic."
msgstr ""
"„Naudoti įrašymams“ sukuria diske movie aplanką, jei jo nėra. Niekas "
"neištrinama ir neformatuojama."

msgid "„Fără subtitrări niciodată” se alege cu 1 (da) sau 0 (nu)."
msgstr "„Niekada nerodyti subtitrų“ pasirenkama 1 (taip) arba 0 (ne)."

msgid ""
"„Redenumește” schimbă numele numai în acest buchet. „Redenumește peste tot” "
"îl schimbă în lista receptorului."
msgstr ""
"„Pervadinti“ keičia pavadinimą tik šiame kanalų rinkinyje. „Pervadinti "
"visur“ keičia jį imtuvo sąraše."

msgid "„Standby” pornește automat fără nicio înregistrare activă."
msgstr "„Budėjimo režimas” įsijungia automatiškai, kai nėra aktyvaus įrašymo."

msgid "„pornit” se alege cu 1 (da) sau 0 (nu)."
msgstr "„pornit“ pasirenkama 1 (taip) arba 0 (ne)."

msgid "−1 min"
msgstr "−1 min"

