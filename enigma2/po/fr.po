#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
msgid "Pornești intrarea fără parolă? Oricine din rețeaua ta de acasă va intra pe receptor."
msgstr "Activer l’accès sans mot de passe ? Tout ton réseau domestique entrera dans le récepteur."

#: lib/python/Plugins/Extensions/HdsWebControl/acces_ssh_web.py
