#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/accel</code>: accelerarea 2D pe placa video: dacă receptorul o are (<code>disponibila</code>), setarea pentru următoarea pornire (implicit pornită) și ce s-a hotărât la pornirea de acum"
msgstr "<code>GET /api/accel</code> : l'accélération 2D sur la carte vidéo : si le récepteur l'a (<code>disponibila</code>), le réglage pour le prochain démarrage (activée par défaut) et ce qui a été décidé au démarrage actuel"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-canal</code>: accesul canalului care rulează (criptat sau liber), sistemele, CAID-urile și ce decriptează modulul acum"
msgstr "<code>GET /api/acces-canal</code> : l'accès de la chaîne en cours (cryptée ou en clair), les systèmes, les CAID et ce que le module décrypte actuellement"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-conditionat</code>: modulele de acces condiționat pe feluri (câmpul <code>fel</code>: numele felului, așa cum îl are receptorul; întâi modulele obișnuite, apoi serverele de carduri), cel ales la pornirea receptorului, cele care rulează, procesul care lucrează și memoria lui, comanda în curs sau ultimul rezultat, dacă receptorul decriptează acum"
msgstr "<code>GET /api/acces-conditionat</code> : les modules d'accès conditionnel par types (champ <code>fel</code> : le nom du type, tel que le récepteur l'a ; d'abord les modules ordinaires, puis les serveurs de cartes), celui choisi au démarrage du récepteur, ceux qui tournent, le processus qui travaille et sa mémoire, la commande en cours ou le dernier résultat, si le récepteur décrypte en ce moment"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/acces-ssh</code>: intrarea pe receptor prin SSH: felul parolei de administrator (fără parola însăși), cheile SSH (tipul, amprenta, comentariul), „Fără parolă în rețeaua locală”, stările periculoase (<code>alarme</code>), lucrarea în curs și rezultatul ultimei comenzi"
msgstr "<code>GET /api/acces-ssh</code> : l'accès au récepteur par SSH : le type du mot de passe administrateur (sans le mot de passe lui-même), les clés SSH (le type, l'empreinte, le commentaire), « Sans mot de passe sur le réseau local », les états dangereux (<code>alarme</code>), la tâche en cours et le résultat de la dernière commande"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, <code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, <code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/actualizari-reporneste</code>: actualizările prin pachete de pe stb.hdsatelit.com (starea, căutarea, instalarea, verificarea zilnică, repornirea interfeței după instalare)"
msgstr "<code>GET /api/actualizari</code>, <code>POST /api/actualizari-cauta</code>, <code>POST /api/actualizari-instaleaza?actualizare=&lt;n&gt;</code>, <code>POST /api/actualizari-zilnic?zilnic=0|1</code>, <code>POST /api/actualizari-reporneste</code> : les mises à jour par paquets depuis stb.hdsatelit.com (l'état, la recherche, l'installation, la vérification quotidienne, le redémarrage de l'interface après l'installation)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;orase=1]</code>: afișajul din față: ce arată acum (măștile celor 4 cifre și textul), lista de rotire, mesajele scurte, așteptarea, setările, minutarul și cronometrul; cu <code>grupa</code> alegerile grupei cu desenul valorii de acum, cu <code>catalog=1</code> toate alegerile (căutarea), cu <code>orase=1</code> fusurile pentru ora din alt oraș"
msgstr "<code>GET /api/afisaj[?grupa=ceas|receptor|...][&amp;catalog=1][&amp;orase=1]</code> : l'afficheur de la face avant : ce qu'il montre maintenant (les masques des 4 chiffres et le texte), la liste de rotation, les messages courts, l'attente, les réglages, le minuteur et le chronomètre ; avec <code>grupa</code> les choix du groupe avec le dessin de la valeur actuelle, avec <code>catalog=1</code> tous les choix (la recherche), avec <code>orase=1</code> les fuseaux horaires pour l'heure d'une autre ville"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code>: tunerele, LNB-ul, semnalul canalului curent și unghiurile antenei spre fiecare satelit (numai citire)"
msgstr "<code>GET /api/antena?lat=&lt;grade&gt;&amp;lon=&lt;grade&gt;</code> : les tuners, le LNB, le signal de la chaîne actuelle et les angles de l'antenne vers chaque satellite (lecture seule)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/calitate-imagine</code>: calitatea imaginii: „Reglajele după canal”, profilul canalului de acum, cele 9 profiluri (SD, HD, 4K x SDR, HDR10, HLG) cu reglajele lor, ieșirea HDR (alegerile primite de televizor, ce e scris acum, întrebarea în curs) și textul brut al blocului de calitate"
msgstr "<code>GET /api/calitate-imagine</code> : la qualité de l'image : « Réglages par chaîne », le profil de la chaîne actuelle, les 9 profils (SD, HD, 4K x SDR, HDR10, HLG) avec leurs réglages, la sortie HDR (les choix reçus par le téléviseur, ce qui est écrit maintenant, la question en cours) et le texte brut du bloc de qualité"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-acum</code>: canalul de pe televizor"
msgstr "<code>GET /api/canale-acum</code> : la chaîne sur le téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-buchete?fila=tv|radio</code>: listele de ales și lista pe care stă televizorul"
msgstr "<code>GET /api/canale-buchete?fila=tv|radio</code> : les listes à choisir et la liste sur laquelle se trouve le téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-epg?refs=r1,r2</code>: emisiunea de acum și cea următoare, cel mult 50 de canale"
msgstr "<code>GET /api/canale-epg?refs=r1,r2</code> : l'émission en cours et la suivante, au plus 50 chaînes"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,v2&amp;de_la=&amp;cate=</code>: rândurile, pe pagini de cel mult 200, cu grupele de filtre și numerele lor"
msgstr "<code>GET /api/canale-lista?fila=&amp;buchet=&amp;text=&amp;&lt;grupă&gt;=v1,v2&amp;de_la=&amp;cate=</code> : les lignes, par pages d'au plus 200, avec les groupes de filtres et leurs numéros"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/canale-sigla?p=&lt;nume&gt;</code>: sigla canalului; la listele de canale, 503 când receptorul are prea multe cereri în lucru și 504 când nu termină în 10 s"
msgstr "<code>GET /api/canale-sigla?p=&lt;nume&gt;</code> : le logo de la chaîne ; pour les listes de chaînes, 503 quand le récepteur a trop de demandes en cours et 504 quand il ne termine pas en 10 s"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cauta-setari?q=&lt;text&gt;</code>: „Caută setări”: meniurile și setările care au textul în nume (fără diacritice), cu drumul din meniu, valoarea de acum și pagina web"
msgstr "<code>GET /api/cauta-setari?q=&lt;text&gt;</code> : « Rechercher des paramètres » : les menus et les paramètres dont le nom contient le texte (sans diacritiques), avec le chemin dans le menu, la valeur actuelle et la page web"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cautare-actualizeaza-stare</code>: cât a citit (transponderul, canalele) sau rezultatul"
msgstr "<code>GET /api/cautare-actualizeaza-stare</code> : combien il a lu (le transpondeur, les chaînes) ou le résultat"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code>: căutarea de canale, cu aceleași rânduri de filtre ca pe televizor și pistele știute ale fiecărui canal"
msgstr "<code>GET /api/cautare-canale?text=&lt;nume&gt;&amp;tip=..&amp;rez=..&amp;acces=..&amp;sistem=..&amp;cod=..&amp;poz=..&amp;are=ttx,subdvb,subttx,hbbtv&amp;lsunet=&lt;limbă&gt;&amp;lsub=&lt;limbă&gt;</code> : la recherche de chaînes, avec les mêmes lignes de filtres que sur le téléviseur et les pistes connues de chaque chaîne"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ceas</code>: ora receptorului, fusul orar, sursa orei (<code>auto</code>: Internet, apoi transponder; <code>ntp</code>; <code>dvb</code>), serverul NTP, alegerile lor și ultima sincronizare"
msgstr "<code>GET /api/ceas</code> : l'heure du récepteur, le fuseau horaire, la source de l'heure (<code>auto</code> : Internet, puis transpondeur ; <code>ntp</code> ; <code>dvb</code>), le serveur NTP, leurs choix et la dernière synchronisation"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/copie-setari[?cauta=1]</code>: copia setărilor: stickurile și discurile (<code>implicit</code> = stickul de actualizare), copiile găsite (data, versiunea imaginii, acest receptor sau altul), copia automată, ultimul rezultat; niciodată conținutul copiei"
msgstr "<code>GET /api/copie-setari[?cauta=1]</code> : la copie des paramètres : les clés USB et les disques (<code>implicit</code> = la clé de mise à jour), les copies trouvées (la date, la version de l'image, ce récepteur ou un autre), la copie automatique, le dernier résultat ; jamais le contenu de la copie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/dabt2?fel=dab|t2</code>: fereastra „Fluxuri și setări” a DAB+ / DVB-T2 din satelit: fluxurile cu poziția, numele, numărul de posturi și starea, setările, Despre, lucrul în curs și <code>repunere</code> (canalul de dinainte, pornit din nou după „Învață posturile”: starea și mesajul)"
msgstr "<code>GET /api/dabt2?fel=dab|t2</code> : la fenêtre « Flux et réglages » du DAB+ / DVB-T2 par satellite : les flux avec la position, le nom, le nombre de stations et l'état, les paramètres, À propos, la tâche en cours et <code>repunere</code> (la chaîne d'avant, relancée après « Apprendre les stations » : l'état et le message)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/descarcare-subtitrari</code> și <code>POST /api/descarcare-subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, <code>-verifica</code>, <code>-conturi</code>: descărcarea subtitrărilor (numele, parolele și cheile numai în corpul cererii); pe un canal TV sau la o înregistrare și <code>-film</code> (<code>fapta=identifica|alege|titlu|local</code>: filmul din ghid, identificat în Wikidata) și <code>-potrivire</code> (<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|opreste</code>: potrivirea subtitrării pe canal)"
msgstr "<code>GET /api/descarcare-subtitrari</code> et <code>POST /api/descarcare-subtitrari-cauta</code>, <code>-descarca</code>, <code>-aplica</code>, <code>-verifica</code>, <code>-conturi</code> : le téléchargement des sous-titres (les noms, les mots de passe et les clés uniquement dans le corps de la requête) ; sur une chaîne TV ou pour un enregistrement, et <code>-film</code> (<code>fapta=identifica|alege|titlu|local</code> : le film du guide, identifié dans Wikidata) et <code>-potrivire</code> (<code>fapta=urmatoarea|dinainte|plus|minus|reclama|acum|viteza|opreste</code> : l'ajustement des sous-titres sur la chaîne)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code>: mesajul de pe ecranul negru (de ce nu se vede imaginea) și analiza fluxului canalului"
msgstr "<code>GET /api/ecran-negru</code>, <code>GET /api/ecran-negru-flux</code> : le message de l'écran noir (pourquoi l'image ne s'affiche pas) et l'analyse du flux de la chaîne"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/egalizator</code>: egalizatorul posturilor de radio: pornit sau oprit, benzile, presetarea, modul de noapte, reglajele postului de acum și dacă merge la acest post; <code>POST /api/egalizator-seteaza</code>: schimbă și aplică pe loc"
msgstr "<code>GET /api/egalizator</code> : l'égaliseur des stations de radio : activé ou désactivé, les bandes, le préréglage, le mode nuit, les réglages de la station actuelle et s'il fonctionne sur cette station ; <code>POST /api/egalizator-seteaza</code> : change et applique tout de suite"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/filme</code>: filmul care merge (poziția, lungimea, starea, locul ținut minte, mesajul de refuz) și setările filmelor; <code>GET /api/filme-lista</code>: filmele din dosarul listei de filme, cu locul rămas"
msgstr "<code>GET /api/filme</code> : le film en cours (la position, la durée, l'état, l'endroit mémorisé, le message de refus) et les paramètres des films ; <code>GET /api/filme-lista</code> : les films du dossier de la liste de films, avec l'endroit de reprise"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/fonturi?cauta=&lt;text&gt;</code>: familiile libere de pe Google Fonts și fonturile deja descărcate"
msgstr "<code>GET /api/fonturi?cauta=&lt;text&gt;</code> : les familles libres de Google Fonts et les polices déjà téléchargées"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal-stare</code>: nivelul, calitatea, BER-ul și verdictul măsurării"
msgstr "<code>GET /api/gasire-semnal-stare</code> : le niveau, la qualité, le BER et le verdict de la mesure"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code>: transponderele unui satelit"
msgstr "<code>GET /api/gasire-semnal-transpondere?slot=N&amp;poz=P</code> : les transpondeurs d'un satellite"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/gasire-semnal</code>: tunerele, sateliții, transponderul de la care pornește măsurarea și starea ei"
msgstr "<code>GET /api/gasire-semnal</code> : les tuners, les satellites, le transpondeur de départ de la mesure et son état"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-emisiune?ref=&amp;id=</code>: ghidul unui canal (fără <code>ref</code>, canalul de pe televizor) și o emisiune cu descrierile"
msgstr "<code>GET /api/ghid?ref=&amp;de_la=&amp;cate=</code>, <code>GET /api/ghid-emisiune?ref=&amp;id=</code> : le guide d'une chaîne (sans <code>ref</code>, la chaîne du téléviseur) et une émission avec ses descriptions"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/import-surse?cauta=1</code>: copiile de canale și setări găsite pe stick-uri și pe receptor, starea căutării și a importului"
msgstr "<code>GET /api/import-surse?cauta=1</code> : les copies de chaînes et de paramètres trouvées sur les clés USB et sur le récepteur, l'état de la recherche et de l'importation"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|retea|hdmi</code>: ecranele „System Information”, cu aceleași texte ca pe televizor"
msgstr "<code>GET /api/informatii?pagina=despre|receptor|tunere|memorie|stocare|retea|hdmi</code> : les écrans « System Information », avec les mêmes textes que sur le téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/interfete-cam?reincarca=1</code>: modulele de acces condiționat instalate și interfețele lor web, cu numele date de fiecare modul (fără <code>reincarca</code> poate veni o căutare făcută cu câteva secunde înainte)"
msgstr "<code>GET /api/interfete-cam?reincarca=1</code> : les modules d'accès conditionnel installés et leurs interfaces web, avec les noms donnés par chaque module (sans <code>reincarca</code>, il peut venir une recherche faite quelques secondes avant)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/jurnal</code>: jurnalul de versiuni (ce s-a schimbat la fiecare actualizare)"
msgstr "<code>GET /api/jurnal</code> : le journal des versions (ce qui a changé à chaque mise à jour)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code>: programele din imagine cu licența fiecăruia și textul unei licențe"
msgstr "<code>GET /api/licente</code>, <code>GET /api/licente-text?id=..</code> : les programmes de l'image avec la licence de chacun et le texte d'une licence"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/limba-interfata</code>: limba meniurilor de acum și lista limbilor, cu numele de pe televizor"
msgstr "<code>GET /api/limba-interfata</code> : la langue actuelle des menus et la liste des langues, avec les noms comme sur le téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/limbi</code>: limba sunetului și a subtitrărilor: cele 7 setări cu alegerile lor, ce se ține minte pe canalul de acum și canalele cu alegeri de mână"
msgstr "<code>GET /api/limbi</code> : la langue du son et des sous-titres : les 7 paramètres avec leurs choix, ce qui est mémorisé sur la chaîne actuelle et les chaînes avec des choix faits à la main"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/liste-implicite</code>: listele de canale gata făcute și drumurile spre scanare și import"
msgstr "<code>GET /api/liste-implicite</code> : les listes de chaînes toutes faites et les chemins vers la recherche et l'importation"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/lnb-stare</code>: verificarea semnalului, întrebarea și secundele rămase"
msgstr "<code>GET /api/lnb-stare</code> : la vérification du signal, la question et les secondes restantes"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/lnb?slot=N</code>: LNB-urile tunerului, cu valorile, alegerile și „Probă de calcul” (numai citire)"
msgstr "<code>GET /api/lnb?slot=N</code> : les LNB du tuner, avec les valeurs, les choix et « Calcul d'essai » (lecture seule)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/locul[?tara=RO]</code>: locul antenei pentru motorul USALS, țările și orașele unei țări (tabelul din imagine)"
msgstr "<code>GET /api/locul[?tara=RO]</code> : l'emplacement de l'antenne pour le moteur USALS, les pays et les villes d'un pays (le tableau de l'image)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/meniu</code>: tot meniul receptorului (tasta MENU), cu aceleași intrări ca pe televizor pentru nivelul ales"
msgstr "<code>GET /api/meniu</code> : tout le menu du récepteur (la touche MENU), avec les mêmes entrées que sur le téléviseur pour le niveau choisi"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, <code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code>: modul sigur (opririle interfeței, alegerile de după ele) și fișierele lui ca text"
msgstr "<code>GET /api/mod-sigur</code>, <code>POST /api/mod-sigur-alege</code>, <code>GET /api/mod-sigur-brut?pagina=&lt;n&gt;</code> : le mode sûr (les arrêts de l'interface, les choix après eux) et ses fichiers sous forme de texte"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor-comenzi</code>: tunerele cu motor, sateliții și starea comenzilor"
msgstr "<code>GET /api/motor-comenzi</code> : les tuners avec moteur, les satellites et l'état des commandes"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor-comenzi?urma=N</code>: urma comenzilor trimise motorului (ultimele N, implicit 100, cel mult 500, cele mai noi întâi): ora, comanda, unghiul, cine a cerut-o (televizorul, ecranul sau pagina motorului, Găsire semnal, reacordarea), poziția crezută de receptor; numai citire, din <code>/home/root/logs/hds-motor.log</code>"
msgstr "<code>GET /api/motor-comenzi?urma=N</code> : la trace des commandes envoyées au moteur (les N dernières, 100 par défaut, au plus 500, les plus récentes d'abord) : l'heure, la commande, l'angle, qui l'a demandée (le téléviseur, l'écran ou la page du moteur, Recherche de signal, la nouvelle syntonisation), la position supposée par le récepteur ; lecture seule, depuis <code>/home/root/logs/hds-motor.log</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/motor</code>: starea rotirii antenei (de unde, pana unde, poziția estimată, cât mai are de mers)"
msgstr "<code>GET /api/motor</code> : l'état de la rotation de l'antenne (d'où, jusqu'où, la position estimée, combien il lui reste à parcourir)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;xp=&amp;yp=</code>: mouse-ul pe ecranul televizorului, ca în emulator: <code>xp</code>, <code>yp</code> = locul în procente din ecran (sau <code>x</code>, <code>y</code> în pixelii ecranului, 1920x1080); <code>clic</code> alege rândul de sub mouse, iar pe rândul ales sau cu <code>clicuri=2</code> dă OK; un buton colorat = tasta lui; <code>drag</code> (cu <code>x0p</code>, <code>y0p</code> = locul apăsării, <code>nou=1</code> la prima mișcare) și <code>dragend</code> = trasul pe bara de derulare; <code>rotita&amp;pasi=-12..12</code> = sus/jos (3 pași sau mai mulți = o pagină); <code>dreapta</code> = Meniu, <code>mijloc</code> = Ieșire. Răspunsul spune ce s-a făcut (<code>facut</code>: selectie, ok, buton, bara, derulare, tasta, nimic). Din browser, cu POST și antetul <code>X-HDS-CSRF</code>, ca <code>remotecontrol</code>"
msgstr "<code>GET /api/mouse?fel=clic|dublu|drag|dragend|rotita|dreapta|mijloc&amp;xp=&amp;yp=</code> : la souris sur l'écran du téléviseur, comme dans l'émulateur : <code>xp</code>, <code>yp</code> = l'endroit en pourcentage de l'écran (ou <code>x</code>, <code>y</code> en pixels de l'écran, 1920x1080) ; <code>clic</code> choisit la ligne sous la souris, et sur la ligne choisie ou avec <code>clicuri=2</code> il donne OK ; un bouton coloré = sa touche ; <code>drag</code> (avec <code>x0p</code>, <code>y0p</code> = l'endroit de l'appui, <code>nou=1</code> au premier mouvement) et <code>dragend</code> = le glissement sur la barre de défilement ; <code>rotita&amp;pasi=-12..12</code> = haut/bas (3 pas ou plus = une page) ; <code>dreapta</code> = Menu, <code>mijloc</code> = Quitter. La réponse dit ce qui a été fait (<code>facut</code> : selectie, ok, buton, bara, derulare, tasta, nimic). Depuis le navigateur, avec POST et l'en-tête <code>X-HDS-CSRF</code>, comme <code>remotecontrol</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/navigator</code>: navigatorul web de pe televizor (deschis sau nu, modul, desenul, felul câmpului ales, mărirea; fără adrese), setările lui și favoritele"
msgstr "<code>GET /api/navigator</code> : le navigateur web du téléviseur (ouvert ou non, le mode, le dessin, le type du champ choisi, le grossissement ; sans adresses), ses paramètres et les favoris"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/ocr-limbi</code>: limbile recunoașterii textului (în imagine, descărcate, de descărcat, cu mărimea și starea fiecăreia) și locul pentru modelele noi"
msgstr "<code>GET /api/ocr-limbi</code> : les langues de la reconnaissance de texte (dans l'image, téléchargées, à télécharger, avec la taille et l'état de chacune) et l'endroit pour les nouveaux modèles"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/pasi-decriptare</code>: pașii decriptării canalului de pe televizor (cererea către modulul de acces, răspunsurile și timpul lor, imaginea decriptată, mesajele modulului CI), numai cu setarea Arată pașii decriptării pornită"
msgstr "<code>GET /api/pasi-decriptare</code> : les étapes du décryptage de la chaîne du téléviseur (la demande au module d'accès, les réponses et leur durée, l'image décryptée, les messages du module CI), seulement avec le paramètre Afficher les étapes du décryptage activé"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/paza-model</code>: paza de model (receptorul pentru care e făcută imaginea și amprenta acestuia); <code>GET /api/actualizare-pachete</code>: pachetele de actualizare găsite și verdictul pazei pentru fiecare"
msgstr "<code>GET /api/paza-model</code> : la garde de modèle (le récepteur pour lequel l'image est faite et son empreinte) ; <code>GET /api/actualizare-pachete</code> : les paquets de mise à jour trouvés et le verdict de la garde pour chacun"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/paznic</code>: paznicul receptorului: starea, setările (<code>interfata</code>, <code>asteptare</code> în secunde), alegerile și ultimele rânduri din jurnalul lui"
msgstr "<code>GET /api/paznic</code> : le surveillant du récepteur : l'état, les paramètres (<code>interfata</code>, <code>asteptare</code> en secondes), les choix et les dernières lignes de son journal"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/portal</code>: starea HbbTV a canalului care rulează (da, nu are, încă nu se știe), cu mesajul arătat pe televizor la tasta PORTAL"
msgstr "<code>GET /api/portal</code> : l'état HbbTV de la chaîne en cours (oui, non, on ne sait pas encore), avec le message affiché sur le téléviseur à la touche PORTAL"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/procesor</code>: procesorul: modul de lucru, modurile care există pe receptor, frecvența setată și cea de acum, temperatura, tensiunea, procentul folosit și timpul pe fiecare treaptă"
msgstr "<code>GET /api/procesor</code> : le processeur : le mode de fonctionnement, les modes qui existent sur le récepteur, la fréquence réglée et l'actuelle, la température, la tension, le pourcentage utilisé et le temps passé sur chaque palier"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code>: postul de radio care merge, cu textele ecranului radio; barele și nivelul sunetului"
msgstr "<code>GET /api/radio</code>, <code>GET /api/radio-benzi</code> : la station de radio en cours, avec les textes de l'écran radio ; les barres et le niveau du son"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code>: apasă o tastă ca de pe telecomanda receptorului (coduri de tastă Linux, de exemplu 352 pentru OK); cu <code>lung=1</code>, apăsare lungă"
msgstr "<code>GET /api/remotecontrol?command=&lt;cod&gt;&amp;lung=1</code> : appuie sur une touche comme depuis la télécommande du récepteur (codes de touche Linux, par exemple 352 pour OK) ; avec <code>lung=1</code>, appui long"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare-stare</code>: starea căutării (procent, canale găsite, transpondere, timp rămas, rezultat)"
msgstr "<code>GET /api/scanare-stare</code> : l'état de la recherche (pourcentage, chaînes trouvées, transpondeurs, temps restant, résultat)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare-ultima</code>: rezultatul ultimei scanări de canale, ținut până la scanarea următoare: <code>inceput</code>, <code>sfarsit</code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, <code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, <code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, <code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, iar când se știu <code>tsid</code>, <code>onid</code>, <code>nid</code> și, la cablu, <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, <code>caid</code>, iar când operatorul trimite numerele canalelor <code>lcn</code> și <code>lcn_vizibil</code>): toate serviciile citite din SDT, vechi și noi, și <code>retele</code> (<code>nid</code>, <code>nume</code>, <code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, <code>privati</code>): rețelele din tabela NIT; câmpurile din tabela NIT (<code>nid</code>, <code>lcn</code>, <code>retele</code>) apar la căutarea în rețea și la scanarea pe cablu pe o singură frecvență; numai citire, lista de canale nu se schimbă; fără nicio scanare de la pornire, <code>result</code> false"
msgstr "<code>GET /api/scanare-ultima</code> : le résultat de la dernière recherche de chaînes, conservé jusqu'à la suivante : <code>inceput</code>, <code>sfarsit</code>, <code>stare</code> (in_curs, terminata, oprita), <code>fel</code>, <code>pozitii</code>, <code>doar_libere</code>, <code>eroare</code>, <code>transpondere</code> (<code>tp</code> ns:tsid:onid, <code>poz</code>, <code>f_khz</code>, <code>pol</code>, <code>sr</code>, <code>semnal</code>, et quand ils sont connus <code>tsid</code>, <code>onid</code>, <code>nid</code> et, sur le câble, <code>mod</code>), <code>servicii</code> (<code>cheie</code> sid:ns:tsid:onid, <code>tip</code>, <code>nume</code>, <code>furnizor</code>, <code>caid</code>, et quand l'opérateur envoie les numéros des chaînes <code>lcn</code> et <code>lcn_vizibil</code>) : tous les services lus dans la SDT, anciens et nouveaux, et <code>retele</code> (<code>nid</code>, <code>nume</code>, <code>pds</code>, <code>multiplexuri</code>, <code>lcn</code>, <code>privati</code>) : les réseaux de la table NIT ; les champs de la table NIT (<code>nid</code>, <code>lcn</code>, <code>retele</code>) apparaissent avec la recherche réseau et avec la recherche sur le câble sur une seule fréquence ; lecture seule, la liste de chaînes ne change pas ; sans aucune recherche depuis le démarrage, <code>result</code> faux"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/scanare</code>: secțiunile „Scanare” și „Orientarea și setarea antenei”, cu felurile de scanare, în ordinea din meniul receptorului; cu <code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</code>, câmpurile felului și ce s-ar căuta"
msgstr "<code>GET /api/scanare</code> : les sections « Recherche de chaînes » et « Orientation et réglage de l'antenne », avec les types de recherche, dans l'ordre du menu du récepteur ; avec <code>scaner=satelit|cablu|terestru&amp;fel=&lt;fel&gt;</code>, les champs du type et ce qui serait cherché"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;mode=all|video|osd&amp;download=1</code>: imaginea de pe ecran; <code>mode</code>: <code>all</code> cu afișajul OSD (implicit), <code>video</code> numai imaginea canalului, <code>osd</code> numai afișajul OSD; <code>download=1</code>: descărcare ca fișier, cu data și ora receptorului în nume"
msgstr "<code>GET /api/screenshot?format=jpg|png&amp;quality=N&amp;width=N&amp;mode=all|video|osd&amp;download=1</code> : l'image de l'écran ; <code>mode</code> : <code>all</code> avec l'affichage OSD (par défaut), <code>video</code> seulement l'image de la chaîne, <code>osd</code> seulement l'affichage OSD ; <code>download=1</code> : téléchargement comme fichier, avec la date et l'heure du récepteur dans le nom"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/setari-din-copie</code>: setările importate: câte așteaptă repornirea interfeței (<code>asteapta</code>), proba lor (<code>garda</code>), scoase după opriri neașteptate (<code>cazut</code>), textele stării"
msgstr "<code>GET /api/setari-din-copie</code> : les paramètres importés : combien attendent le redémarrage de l'interface (<code>asteapta</code>), leur essai (<code>garda</code>), retirés après des arrêts inattendus (<code>cazut</code>), les textes de l'état"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/setari</code>: ecranele de setări din meniu; cu <code>id=&lt;cheie&gt;</code>, rândurile lor (aceleași ca pe televizor, cu alegerile)"
msgstr "<code>GET /api/setari</code> : les écrans de paramètres du menu ; avec <code>id=&lt;cheie&gt;</code>, leurs lignes (les mêmes que sur le téléviseur, avec les choix)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/standby-tv</code>: ieșirea HDMI în standby (oprită sau pornită, oprirea din nou după aprinderea televizorului) și starea CEC"
msgstr "<code>GET /api/standby-tv</code> : la sortie HDMI en veille (coupée ou active, la coupure de nouveau après l'allumage du téléviseur) et l'état CEC"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/stare-retea</code>: legătura cu routerul și internetul (cablu sau Wi-Fi, treptele semnalului Wi-Fi, internetul merge, routerul nu are internet sau receptorul nu e conectat la router), cu desenul pictogramei și textul ei, ca pictograma din bara de pe televizor"
msgstr "<code>GET /api/stare-retea</code> : la liaison avec le routeur et internet (câble ou Wi-Fi, les niveaux du signal Wi-Fi, internet fonctionne, le routeur n'a pas internet ou le récepteur n'est pas connecté au routeur), avec le dessin de l'icône et son texte, comme l'icône de la barre du téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/statusinfo</code>: canalul curent, volumul, standby"
msgstr "<code>GET /api/statusinfo</code> : la chaîne actuelle, le volume, la veille"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/stocare</code>: locul înregistrărilor, spațiul liber și discurile conectate"
msgstr "<code>GET /api/stocare</code> : l'endroit des enregistrements, l'espace libre et les disques connectés"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-aspect</code>: aspectul subtitrărilor text (fontul, grosimea, mărimea și culoarea literelor, conturul, umbra, fundalul, înălțimea, distanța dintre rânduri) și mărirea subtitrărilor DVB, cu alegerile posibile (<code>alegeri</code>), stilurile gata făcute și valorile de la început"
msgstr "<code>GET /api/subtitrari-aspect</code> : l'aspect des sous-titres texte (la police, l'épaisseur, la taille et la couleur des lettres, le contour, l'ombre, le fond, la hauteur, l'espacement des lignes) et le grossissement des sous-titres DVB, avec les choix possibles (<code>alegeri</code>), les styles tout faits et les valeurs de départ"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-film</code>: filmul care merge, subtitrările lui, întârzierea, codarea și cadrele pe secundă"
msgstr "<code>GET /api/subtitrari-film</code> : le film en cours, ses sous-titres, le retard, l'encodage et les images par seconde"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/subtitrari-ocr</code>: contorul recunoașterii textului din subtitrările DVB (pagini citite ca text, rămase imagine și de ce, timpul mediu, ultimele pagini, viteza serviciului)"
msgstr "<code>GET /api/subtitrari-ocr</code> : le compteur de la reconnaissance de texte des sous-titres DVB (pages lues comme texte, restées en image et pourquoi, le temps moyen, les dernières pages, la vitesse du service)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/sunet</code>: ieșirea sunetului (Automat / Manual), AC3 și DTS downmix, pista AC3, ce primește televizorul (EDID), ce se trimite acum și de ce, ce arată driverul pe HDMI și optic"
msgstr "<code>GET /api/sunet</code> : la sortie du son (Automatique / Manuel), AC3 et DTS downmix, la piste AC3, ce que reçoit le téléviseur (EDID), ce qui est envoyé maintenant et pourquoi, ce que montre le pilote sur HDMI et optique"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/telecomenzi-export?format=json|csv</code>: codurile telecomenzii receptorului și ale celor asociate, pentru aplicații"
msgstr "<code>GET /api/telecomenzi-export?format=json|csv</code> : les codes de la télécommande du récepteur et de celles associées, pour les applications"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/telecomenzi</code>: telecomenzile asociate, tastele lor și captura paginii (cititorul, proba, asocierea)"
msgstr "<code>GET /api/telecomenzi</code> : les télécommandes associées, leurs touches et la capture de la page (le lecteur, le test, l'association)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext-copii</code> (cu <code>?canale=1</code> și canalele care au teletext): copiile de teletext salvate (canalul, data, paginile, mărimea), dosarul, spațiul folosit și cel ales, urmăritorul (caruselul canalului de acum, reîmprospătarea în lucru) și setările"
msgstr "<code>GET /api/teletext-copii</code> (avec <code>?canale=1</code> et les chaînes qui ont du télétexte) : les copies de télétexte enregistrées (la chaîne, la date, les pages, la taille), le dossier, l'espace utilisé et celui choisi, le suiveur (le carrousel de la chaîne actuelle, l'actualisation en cours) et les paramètres"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> (fără <code>ref</code>: canalul de acum): <code>date</code> = fișierul copiei (.ttx, comprimat), <code>html</code> = o singură pagină HTML cu toate paginile, care se citește fără receptor"
msgstr "<code>GET /api/teletext-descarca?ref=&lt;ref&gt;&amp;fel=html|date</code> (sans <code>ref</code> : la chaîne actuelle) : <code>date</code> = le fichier de la copie (.ttx, compressé), <code>html</code> = une seule page HTML avec toutes les pages, qui se lit sans récepteur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;ref&gt;</code>: o pagină de teletext, ca pe televizor la tasta TEXT: cele 25 de rânduri a câte 40 de celule (litera, culoarea, fundalul, mozaicul, atributele), textul paginii, subpaginile, paginile tastelor colorate, paginile vecine și pagina de pe televizor; fără <code>pagina</code>, pagina de pe televizor sau cea de pornire; <code>sub=-1</code> = cea mai nouă; <code>ascuns=1</code> arată ce e ascuns; cu <code>copie</code>, paginile din copia salvată a canalului, fără tuner (<code>sursa</code>: <code>direct</code> sau <code>copie</code>); <code>hd</code> = setarea Teletext neted, <code>optiuni</code> = conturul literelor, umbra literelor și formele în relief (<code>contur</code>, <code>umbra</code>, <code>relief</code>, ca pe televizor). Pagina lipsă: <code>gasita</code> fals și mesajul că se caută"
msgstr "<code>GET /api/teletext?pagina=N&amp;sub=S&amp;ascuns=0|1&amp;copie=&lt;ref&gt;</code> : une page de télétexte, comme sur le téléviseur à la touche TEXT : les 25 lignes de 40 cellules (la lettre, la couleur, le fond, la mosaïque, les attributs), le texte de la page, les sous-pages, les pages des touches de couleur, les pages voisines et la page du téléviseur ; sans <code>pagina</code>, la page du téléviseur ou celle de départ ; <code>sub=-1</code> = la plus récente ; <code>ascuns=1</code> montre ce qui est caché ; avec <code>copie</code>, les pages de la copie enregistrée de la chaîne, sans tuner (<code>sursa</code> : <code>direct</code> ou <code>copie</code>) ; <code>hd</code> = le paramètre Télétexte lissé, <code>optiuni</code> = le contour des lettres, l'ombre des lettres et les formes en relief (<code>contur</code>, <code>umbra</code>, <code>relief</code>, comme sur le téléviseur). Page absente : <code>gasita</code> faux et le message qu'on la cherche"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code>: jurnalul unei înregistrări, pe înțelesul oricui, cu mesajul tehnic; golirea lui"
msgstr "<code>GET /api/temporizatoare-jurnal?id=..</code>, <code>POST /api/temporizatoare-jurnal-goleste?id=..&amp;confirmat=1</code> : le journal d'un enregistrement, compréhensible par tous, avec le message technique ; son effacement"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/temporizatoare</code>: înregistrările programate (aceeași ordine, stare și detalii ca pe televizor), locul înregistrărilor și spațiul liber"
msgstr "<code>GET /api/temporizatoare</code> : les enregistrements programmés (le même ordre, état et détails que sur le téléviseur), l'endroit des enregistrements et l'espace libre"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/traducere-configurare</code>: configurarea pas cu pas a traducerii: ce e pus acum (<code>acum</code>: serviciul, dacă are cheie, pornită sau nu, ultima probă, <code>chei_din_nou</code>), lucrarea configurării (<code>configurare</code>: starea, pasul, proba, modelul și modelele, mesajul și ce să faci), căutarea serverelor din casă (<code>cautare</code>: progresul și serverele găsite), instrucțiunile și pagina cheii fiecărui serviciu, regiunile Azure; niciodată o cheie"
msgstr "<code>GET /api/traducere-configurare</code> : la configuration pas à pas de la traduction : ce qui est réglé maintenant (<code>acum</code> : le service, s'il a une clé, activé ou non, le dernier test, <code>chei_din_nou</code>), la tâche de configuration (<code>configurare</code> : l'état, l'étape, le test, le modèle et les modèles, le message et ce que tu dois faire), la recherche des serveurs de la maison (<code>cautare</code> : la progression et les serveurs trouvés), les instructions et la page de la clé de chaque service, les régions Azure ; jamais une clé"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/traducere-subtitrari</code>: traducerea automată a subtitrărilor text: valorile (<code>pornit</code>, <code>serviciu</code>, <code>limba</code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</code>, <code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</code>, <code>adresa_libre</code>, <code>adresa_openai</code>, <code>model_gemini</code>, <code>model_openai</code>, <code>model_groq</code>, <code>model_cloudflare</code>, <code>cont_cloudflare</code> și, pentru adresa proprie, <code>propriu_adresa</code>, <code>propriu_metoda</code>, <code>propriu_corp</code>, <code>propriu_tip_corp</code>, <code>propriu_antet</code>, <code>propriu_raspuns</code>, <code>propriu_cale</code>), alegerile posibile (<code>alegeri</code>), ce cere fiecare serviciu (<code>cere</code>), care serviciu are cheie (<code>chei</code>, niciodată cheia), dacă cheile trebuie puse din nou (<code>chei_din_nou</code>, textul notei, gol când nu e cazul), starea cheii serviciului ales, ca pe televizor (<code>cheie_fel</code> și <code>cheie_text</code>: pusă, pusă pentru alt server, lipsă), textele paginii în limba receptorului (<code>texte</code>), ce lipsește, confidențialitatea, instrucțiunile pas cu pas (cu <code>pagina_cheie</code>, adresa oficială pentru codul QR) și starea (contorul, proba, pauza după erori)"
msgstr "<code>GET /api/traducere-subtitrari</code> : la traduction automatique des sous-titres texte : les valeurs (<code>pornit</code>, <code>serviciu</code>, <code>limba</code>, <code>afisare</code>, <code>tarziu</code>, <code>citire</code>, <code>dvb</code>, <code>bara</code>, <code>epg</code>, <code>regiune</code>, <code>adresa_libre</code>, <code>adresa_openai</code>, <code>model_gemini</code>, <code>model_openai</code>, <code>model_groq</code>, <code>model_cloudflare</code>, <code>cont_cloudflare</code> et, pour l'adresse propre, <code>propriu_adresa</code>, <code>propriu_metoda</code>, <code>propriu_corp</code>, <code>propriu_tip_corp</code>, <code>propriu_antet</code>, <code>propriu_raspuns</code>, <code>propriu_cale</code>), les choix possibles (<code>alegeri</code>), ce que demande chaque service (<code>cere</code>), quel service a une clé (<code>chei</code>, jamais la clé), si les clés doivent être remises (<code>chei_din_nou</code>, le texte de la note, vide quand ce n'est pas le cas), l'état de la clé du service choisi, comme sur le téléviseur (<code>cheie_fel</code> et <code>cheie_text</code> : mise, mise pour un autre serveur, absente), les textes de la page dans la langue du récepteur (<code>texte</code>), ce qui manque, la confidentialité, les instructions pas à pas (avec <code>pagina_cheie</code>, l'adresse officielle pour le code QR) et l'état (le compteur, le test, la pause après les erreurs)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>: canalele de pe frecvența televizorului și din lista lui, fiecare cu merge acum sau motivul, codecul imaginii și felul sunetului; cu <code>wasm=1</code> (browserul are playerul MPEG-2) merg și canalele cu imagine MPEG-2; <code>ac3=1</code>: pagina redă sunetul AC-3, cu decodorul browserului sau cu decodorul wasm al paginii"
msgstr "<code>GET /api/tv-canale?hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code> : les chaînes de la fréquence du téléviseur et de sa liste, chacune avec « fonctionne maintenant » ou le motif, le codec de l'image et le type du son ; avec <code>wasm=1</code> (le navigateur a le lecteur MPEG-2), les chaînes avec image MPEG-2 fonctionnent aussi ; <code>ac3=1</code> : la page lit le son AC-3, avec le décodeur du navigateur ou avec le décodeur wasm de la page"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/tv-stare</code>: TV în browser: transmisiile de acum (canal, browser, de când, octeți), setările, memoria driverului video (câte canale noi se mai pot deschide până la repornire), transmisia acestui browser și motivul ultimei opriri"
msgstr "<code>GET /api/tv-stare</code> : TV dans le navigateur : les diffusions actuelles (chaîne, navigateur, depuis quand, octets), les paramètres, la mémoire du pilote vidéo (combien de nouvelles chaînes peuvent encore s'ouvrir jusqu'au redémarrage), la diffusion de ce navigateur et le motif du dernier arrêt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/video</code>: setările video ca în Setări &gt; Video: rezoluțiile, frecvențele fiecărei rezoluții (cu <code>auto</code> = automat după canal), culorile HDMI, <code>zapmode</code> (ce se vede la schimbarea canalului) și încercarea în curs"
msgstr "<code>GET /api/video</code> : les paramètres vidéo comme dans Paramètres &gt; Vidéo : les résolutions, les fréquences de chaque résolution (avec <code>auto</code> = automatique selon la chaîne), les couleurs HDMI, <code>zapmode</code> (ce qu'on voit au changement de chaîne) et l'essai en cours"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>GET /api/zap?sRef=&lt;referință&gt;</code>: schimbă canalul"
msgstr "<code>GET /api/zap?sRef=&lt;referință&gt;</code> : change de chaîne"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/accel-reporneste</code>: repornește interfața (enigma2)"
msgstr "<code>POST /api/accel-reporneste</code> : redémarre l'interface (enigma2)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/accel-seteaza?pornita=0|1</code>: pornește sau oprește accelerarea de la următoarea pornire a interfeței (refuzat pe un receptor fără accelerarea 2D)"
msgstr "<code>POST /api/accel-seteaza?pornita=0|1</code> : active ou désactive l'accélération au prochain démarrage de l'interface (refusé sur un récepteur sans accélération 2D)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</code> ca în <code>GET /api/acces-conditionat</code>): pornește comanda prin scriptul modulului, pe rând, una singură deodată (și cu televizorul); rezultatul vine prin <code>GET /api/acces-conditionat</code>"
msgstr "<code>POST /api/acces-conditionat-comanda?cerere=alege|porneste|opreste|reporneste&amp;fel=&lt;fel&gt;&amp;sufix=&lt;nume&gt;</code> (<code>fel</code> comme dans <code>GET /api/acces-conditionat</code>) : lance la commande via le script du module, à tour de rôle, une seule à la fois (et avec le téléviseur) ; le résultat vient par <code>GET /api/acces-conditionat</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-adauga</code> (corp: <code>cheie=</code>), <code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?amprenta=SHA256:..&amp;confirmat=1</code>: cheile publice lipite, cele din dosarul hdsatelit/ssh de pe stick, ștergerea unei chei"
msgstr "<code>POST /api/acces-ssh-adauga</code> (corps : <code>cheie=</code>), <code>POST /api/acces-ssh-stick</code>, <code>POST /api/acces-ssh-sterge?amprenta=SHA256:..&amp;confirmat=1</code> : les clés publiques collées, celles du dossier hdsatelit/ssh de la clé USB, la suppression d'une clé"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</code> cere și <code>confirmat=1</code>): „Fără parolă în rețeaua locală”. Parola, textul brut și toate schimbările merg numai dintr-un browser conectat cu codul de pe televizor (altfel 403 cu <code>trebuie_cod</code>), niciodată cu <code>?token=</code>; cât ecranul „Acces SSH” e deschis pe televizor, la fel <code>/api/remotecontrol</code> și <code>/api/screenshot</code>"
msgstr "<code>POST /api/acces-ssh-fara-parola?pornit=0|1</code> (<code>pornit=1</code> demande aussi <code>confirmat=1</code>) : « Sans mot de passe sur le réseau local ». Le mot de passe, le texte brut et tous les changements passent seulement depuis un navigateur connecté avec le code du téléviseur (sinon 403 avec <code>trebuie_cod</code>), jamais avec <code>?token=</code> ; tant que l'écran « Accès SSH » est ouvert sur le téléviseur, de même pour <code>/api/remotecontrol</code> et <code>/api/screenshot</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/acces-ssh-ascunde</code>: o parolă nouă; „Am notat parola” (textul parolei se șterge de pe receptor, parola rămâne)"
msgstr "<code>POST /api/acces-ssh-parola-noua?confirmat=1</code>, <code>POST /api/acces-ssh-ascunde</code> : un nouveau mot de passe ; « J'ai noté le mot de passe » (le texte du mot de passe est effacé du récepteur, le mot de passe reste)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/acces-ssh-parola</code>: textul parolei, cât timp nu a fost ascunsă; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code>: fișierele serverului SSH ca text (fără /etc/shadow)"
msgstr "<code>POST /api/acces-ssh-parola</code> : le texte du mot de passe, tant qu'il n'a pas été masqué ; <code>GET /api/acces-ssh-brut?pagina=&lt;n&gt;</code> : les fichiers du serveur SSH sous forme de texte (sans /etc/shadow)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code>: salvează și aplică pe loc (oricare dintre ele); <code>previzualizare=1&amp;lista=...</code> arată lista pe afișaj fără salvare (cel mult 2 minute fără o cerere nouă), <code>previzualizare=0</code> revine; <code>minutar=0|1..120</code> și <code>cronometru=porneste|opreste|zero</code> pornesc ceasurile afișajului pe loc; <code>functionare=ora|canal|stins</code> merge ca înainte"
msgstr "<code>POST /api/afisaj-seteaza?lista=ceas.ora:24@5,canal.nume:derulat&amp;evenimente=evenimente.volum:n&amp;asteptare=ora|ora_data|rec|stins&amp;viteza=200|300|450|600&amp;luminozitate=neschimbat|1..7&amp;luminozitate_noapte=la_fel|1..7&amp;noapte_de_la=18..23|0&amp;noapte_pana_la=5..9&amp;text=...&amp;oras=Asia/Tokyo</code> : enregistre et applique tout de suite (n'importe lequel d'entre eux) ; <code>previzualizare=1&amp;lista=...</code> montre la liste sur l'afficheur sans l'enregistrer (au plus 2 minutes sans nouvelle requête), <code>previzualizare=0</code> revient ; <code>minutar=0|1..120</code> et <code>cronometru=porneste|opreste|zero</code> lancent les horloges de l'afficheur tout de suite ; <code>functionare=ora|canal|stins</code> fonctionne comme avant"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</code>: salvează reglajele unui profil (multipli de 5); cu <code>incearca=1</code> se văd pe loc fără să se salveze, <code>renunta=1</code> pune înapoi ce e salvat; <code>POST /api/calitate-imagine-implicite?profil=&lt;profil&gt;|toate</code>; <code>POST /api/calitate-imagine-hdr?iesire=auto|hdr10|hlg|none</code> (canalul pornește din nou, întrebarea apare pe televizor); <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;&amp;pornit=0|1</code> (jumătate de ecran, 60 s)"
msgstr "<code>POST /api/calitate-imagine-seteaza?profil=hd_sdr&amp;claritate=0..100&amp;...&amp;pornit=0|1[&amp;incearca=1|&amp;renunta=1]</code> : enregistre les réglages d'un profil (multiples de 5) ; avec <code>incearca=1</code> on les voit tout de suite sans les enregistrer, <code>renunta=1</code> remet ce qui est enregistré ; <code>POST /api/calitate-imagine-implicite?profil=&lt;profil&gt;|toate</code> ; <code>POST /api/calitate-imagine-hdr?iesire=auto|hdr10|hlg|none</code> (la chaîne redémarre, la question apparaît sur le téléviseur) ; <code>POST /api/calitate-imagine-comparatie?reglaj=&lt;cheie&gt;&amp;pornit=0|1</code> (la moitié de l'écran, 60 s)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code>: pornește canalul prin lista de pe televizor"
msgstr "<code>POST /api/canale-porneste?fila=&amp;buchet=&amp;ref=</code> : lance la chaîne via la liste du téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code>: deschide pe televizor un rezultat al căutării, cu rândul găsit ales"
msgstr "<code>POST /api/cauta-setari-televizor?cheie=&lt;cheie&gt;</code> : ouvre sur le téléviseur un résultat de la recherche, avec la ligne trouvée choisie"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza-opreste</code>: oprește citirea și revine la canalul de dinainte"
msgstr "<code>POST /api/cautare-actualizeaza-opreste</code> : arrête la lecture et revient à la chaîne d'avant"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza-sari</code>: sare peste satelitul pe care e antena acum și trece la următorul (tasta GALBEN de pe televizor)"
msgstr "<code>POST /api/cautare-actualizeaza-sari</code> : saute le satellite sur lequel se trouve l'antenne maintenant et passe au suivant (la touche JAUNE du téléviseur)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code>: întrebarea (durata, motorul); cu <code>confirmat=1</code> pornește pe televizor citirea pistelor, transponder cu transponder"
msgstr "<code>POST /api/cautare-actualizeaza?fel=gasite|fara|toate</code> : la question (la durée, le moteur) ; avec <code>confirmat=1</code>, la lecture des pistes démarre sur le téléviseur, transpondeur par transpondeur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code>: citirea pistelor în timpul vizionării (oprită, numai canalul privit, tot transponderul), aceeași setare ca pe televizor"
msgstr "<code>POST /api/cautare-culegere?mod=oprita|canal|transponder</code> : la lecture des pistes pendant le visionnage (désactivée, seulement la chaîne regardée, tout le transpondeur), le même paramètre que sur le téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;&amp;fus=&lt;fus orar&gt;</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>/api/ceas</code>)"
msgstr "<code>POST /api/ceas-seteaza?sursa=auto|ntp|dvb&amp;server=&lt;server&gt;&amp;fus=&lt;fus orar&gt;</code> : change et enregistre n'importe lequel d'entre eux (les valeurs exactes sont dans <code>/api/ceas</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ceas-sincronizeaza</code>: o sincronizare a orei prin Internet, acum"
msgstr "<code>POST /api/ceas-sincronizeaza</code> : une synchronisation de l'heure par Internet, maintenant"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/copie-setari-pune?copie=&lt;id&gt;</code> (repornește interfața; copia se pune la loc înainte să pornească), <code>POST /api/copie-setari-sterge?copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"
msgstr "<code>POST /api/copie-setari-fa?mediu=&lt;id&gt;</code>, <code>POST /api/copie-setari-pune?copie=&lt;id&gt;</code> (redémarre l'interface ; la copie est remise en place avant son démarrage), <code>POST /api/copie-setari-sterge?copie=&lt;id&gt;</code>, <code>POST /api/copie-setari-automat?automat=oprita|zilnic&amp;pastrate=1-10</code>, <code>POST /api/copie-setari-anuleaza</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|invata|sterge&amp;flux=..</code>: actualizează lista, reface buchetele, învață posturile unui flux, șterge un flux adăugat de mână"
msgstr "<code>POST /api/dabt2-actiune?fel=dab|t2&amp;actiune=actualizeaza|buchete|invata|sterge&amp;flux=..</code> : met à jour la liste, refait les bouquets, apprend les stations d'un flux, supprime un flux ajouté à la main"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;emisfera=E|V&amp;frecventa=..&amp;...</code>: un flux adăugat de mână, cu aceleași câmpuri și limite ca „Adaugă manual”"
msgstr "<code>POST /api/dabt2-manual?fel=dab|t2&amp;nume=..&amp;grade=..&amp;emisfera=E|V&amp;frecventa=..&amp;...</code> : un flux ajouté à la main, avec les mêmes champs et limites que « Ajouter manuellement »"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-seteaza?cheie=tasta|dosar|latime|nedecodabile&amp;valoare=..</code>: setările ferestrei, aceleași ca pe televizor"
msgstr "<code>POST /api/dabt2-seteaza?cheie=tasta|dosar|latime|nedecodabile&amp;valoare=..</code> : les paramètres de la fenêtre, les mêmes que sur le téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/dabt2-televizor?fel=dab|t2</code>: deschide fereastra pe televizor"
msgstr "<code>POST /api/dabt2-televizor?fel=dab|t2</code> : ouvre la fenêtre sur le téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ecran-negru-fapta?fapta=&lt;id&gt;|ascunde</code>: fapta mesajului de acum, pe televizor, sau ascunderea lui"
msgstr "<code>POST /api/ecran-negru-fapta?fapta=&lt;id&gt;|ascunde</code> : l'action du message actuel, sur le téléviseur, ou son masquage"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ecran-sterge?sursa=galerie|propriu&amp;id=..</code>, <code>POST /api/ecran-la-loc</code>: șterge un ecran de pornire din galerie (nu cel din fabrică și nici cel pus) sau pune la loc ecranele șterse"
msgstr "<code>POST /api/ecran-sterge?sursa=galerie|propriu&amp;id=..</code>, <code>POST /api/ecran-la-loc</code> : supprime un écran de démarrage de la galerie (pas celui d'usine ni celui qui est mis) ou remet en place les écrans supprimés"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/filme-comanda?fa=pauza|redare|inainte|inapoi</code>, <code>?fa=salt&amp;secunde=-60</code>, <code>?fa=la&amp;secunde=N</code>, <code>POST /api/filme-seteaza?pornire=&amp;oprire=&amp;sfarsit=</code>, <code>POST /api/filme-porneste?cale=..&amp;de_la=loc|inceput</code>: aceleași comenzi ca pe telecomandă în player și în lista de filme"
msgstr "<code>POST /api/filme-comanda?fa=pauza|redare|inainte|inapoi</code>, <code>?fa=salt&amp;secunde=-60</code>, <code>?fa=la&amp;secunde=N</code>, <code>POST /api/filme-seteaza?pornire=&amp;oprire=&amp;sfarsit=</code>, <code>POST /api/filme-porneste?cale=..&amp;de_la=loc|inceput</code> : les mêmes commandes que sur la télécommande dans le lecteur et dans la liste de films"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/fonturi-descarca?familie=&lt;Familia&gt;&amp;mare=1</code>: descarcă, verifică și înregistrează un font"
msgstr "<code>POST /api/fonturi-descarca?familie=&lt;Familia&gt;&amp;mare=1</code> : télécharge, vérifie et enregistre une police"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/fonturi-sterge?alias=&lt;NumeInSkin&gt;</code>: șterge un font descărcat"
msgstr "<code>POST /api/fonturi-sterge?alias=&lt;NumeInSkin&gt;</code> : supprime une police téléchargée"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/gasire-semnal-porneste</code>, <code>-reacordeaza</code>, <code>-opreste</code>: pornește, acordează din nou sau oprește măsurarea"
msgstr "<code>POST /api/gasire-semnal-porneste</code>, <code>-reacordeaza</code>, <code>-opreste</code> : démarre, resyntonise ou arrête la mesure"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ghid-temporizator?ref=&amp;id=&amp;fel=inregistrare|comutare|scoate</code>: pune sau scoate înregistrarea unei emisiuni (409 la suprapunere)"
msgstr "<code>POST /api/ghid-temporizator?ref=&amp;id=&amp;fel=inregistrare|comutare|scoate</code> : met ou retire l'enregistrement d'une émission (409 en cas de chevauchement)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/import-alta-imagine?raspuns=da|nu|ascunde</code>: răspunsul la întrebarea de la prima pornire (canalele și setările din altă imagine, găsite pe stick sau disc); starea în <code>/api/import-surse</code> (<code>alta_imagine</code>)"
msgstr "<code>POST /api/import-alta-imagine?raspuns=da|nu|ascunde</code> : la réponse à la question du premier démarrage (les chaînes et les paramètres d'une autre image, trouvés sur clé USB ou disque) ; l'état dans <code>/api/import-surse</code> (<code>alta_imagine</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;temporizatoare=0&amp;generale=0</code>: pornește importul (întâi copia de siguranță)"
msgstr "<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;temporizatoare=0&amp;generale=0</code> : lance l'importation (d'abord la copie de sauvegarde)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: schimbă limba meniurilor și o salvează, ca OK în ecranul limbii de pe televizor"
msgstr "<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code> : change la langue des menus et l'enregistre, comme OK dans l'écran de la langue du téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>/api/limbi</code>; <code>tradu_orice</code> = „Tradu automat din orice subtitrare disponibilă”, contează cu traducerea subtitrărilor pornită) și le aplică pe canalul de acum"
msgstr "<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</code> : change et enregistre n'importe lequel d'entre eux (les valeurs exactes sont dans <code>/api/limbi</code> ; <code>tradu_orice</code> = « Traduire automatiquement depuis n'importe quel sous-titre disponible », compte quand la traduction des sous-titres est activée) et les applique sur la chaîne actuelle"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /api/limbi-uita-toate?confirmat=1</code>: uită alegerile de mână ale unui canal sau ale tuturor"
msgstr "<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /api/limbi-uita-toate?confirmat=1</code> : oublie les choix faits à la main d'une chaîne ou de toutes"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-aplica</code>: aplică planul văzut (<code>semn=</code>), verifică semnalul și așteaptă răspunsul 60 de secunde"
msgstr "<code>POST /api/lnb-aplica</code> : applique le plan vu (<code>semn=</code>), vérifie le signal et attend la réponse 60 secondes"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-plan</code>: ce s-ar schimba pentru câmpurile trimise (<code>l_&lt;lnb&gt;_&lt;câmp&gt;</code>), sau pentru „Ce era înainte” cu <code>fel=inainte</code>; nu scrie nimic"
msgstr "<code>POST /api/lnb-plan</code> : ce qui changerait pour les champs envoyés (<code>l_&lt;lnb&gt;_&lt;câmp&gt;</code>), ou pour « Ce qu'il y avait avant » avec <code>fel=inainte</code> ; n'écrit rien"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code>: răspunsul la „Păstrezi noile setări?”"
msgstr "<code>POST /api/lnb-raspuns?raspuns=pastrez|revin</code> : la réponse à « Garder les nouveaux réglages ? »"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</code>: locul antenei aflat după adresa de internet a receptorului, de serverul HD Satelit, numai la cerere și numai din browserul conectat; se scrie abia după confirmare, cu <code>POST /api/locul-seteaza</code> și <code>internet=&lt;semn&gt;</code>"
msgstr "<code>POST /api/locul-internet</code>, <code>GET /api/locul-internet-stare</code> : l'emplacement de l'antenne trouvé d'après l'adresse internet du récepteur, par le serveur HD Satelit, seulement sur demande et seulement depuis le navigateur connecté ; il n'est écrit qu'après confirmation, avec <code>POST /api/locul-seteaza</code> et <code>internet=&lt;semn&gt;</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/locul-seteaza</code>: locul antenei din tabel (<code>tara</code>, <code>oras</code>) sau scris (<code>lat</code>, <code>lon</code>, grade, nord și est pozitive)"
msgstr "<code>POST /api/locul-seteaza</code> : l'emplacement de l'antenne du tableau (<code>tara</code>, <code>oras</code>) ou écrit (<code>lat</code>, <code>lon</code>, degrés, nord et est positifs)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code>: deschide pe televizor ecranul unei intrări (nu oprirea sau repornirea)"
msgstr "<code>POST /api/meniu-televizor?id=&lt;entryID&gt;</code> : ouvre sur le téléviseur l'écran d'une entrée (pas l'arrêt ni le redémarrage)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code>: pas, mișcare fără oprire, poziții memorate, mergi la satelit, limite, oprire"
msgstr "<code>POST /api/motor-comanda?actiune=&lt;comanda&gt;</code> : pas, mouvement sans arrêt, positions mémorisées, aller au satellite, limites, arrêt"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-inchide</code>: navigatorul pe televizor"
msgstr "<code>POST /api/navigator-deschide?adresa=&lt;adresă&gt;</code>, <code>POST /api/navigator-cam?port=&lt;port&gt;</code>, <code>POST /api/navigator-inchide</code> : le navigateur sur le téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/navigator-text</code>: text trimis în câmpul ales pe televizor; numai din browserul asociat, cu textul în corpul cererii (cu <code>?token=</code> se refuză)"
msgstr "<code>POST /api/navigator-text</code> : texte envoyé dans le champ choisi sur le téléviseur ; seulement depuis le navigateur associé, avec le texte dans le corps de la requête (avec <code>?token=</code>, c'est refusé)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code>: descarcă modelul unei limbi (pe stick sau disc; în memoria internă numai cu intern=1)"
msgstr "<code>POST /api/ocr-limbi-descarca?model=slk[&amp;intern=1]</code> : télécharge le modèle d'une langue (sur clé USB ou disque ; dans la mémoire interne seulement avec intern=1)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-intreaba</code>: receptorul întreabă din nou pentru limbile cu \"Nu mai întreba\""
msgstr "<code>POST /api/ocr-limbi-intreaba</code> : le récepteur redemande pour les langues avec \"Ne plus demander\""

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-opreste?model=slk</code>: oprește descărcarea"
msgstr "<code>POST /api/ocr-limbi-opreste?model=slk</code> : arrête le téléchargement"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/ocr-limbi-sterge?model=slk</code>: șterge un model descărcat (sau îl scoate din listă când stickul lui nu e pus)"
msgstr "<code>POST /api/ocr-limbi-sterge?model=slk</code> : supprime un modèle téléchargé (ou le retire de la liste quand sa clé USB n'est pas branchée)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</code>: repornirea interfeței când nu mai răspunde și așteptarea dinaintea ei"
msgstr "<code>POST /api/paznic-seteaza?interfata=0|1&amp;asteptare=60|120|300</code> : le redémarrage de l'interface quand elle ne répond plus et l'attente avant celui-ci"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/procesor-seteaza?mod=automat|racoros|normal|performanta</code>: salvează modul și îl aplică pe loc"
msgstr "<code>POST /api/procesor-seteaza?mod=automat|racoros|normal|performanta</code> : enregistre le mode et l'applique tout de suite"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=..&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</code>: setările ecranului radio"
msgstr "<code>POST /api/radio-seteaza?ecran=0|1&amp;vizualizator=..&amp;culori=..&amp;bare=..&amp;cadre=..&amp;odihna=..&amp;epg=..&amp;bara_la_zap=0|1</code> : les paramètres de l'écran radio"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: vizualizarea sau culorile următoare (ca tastele galbenă și albastră pe ecranul radio)"
msgstr "<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code> : la visualisation ou les couleurs suivantes (comme les touches jaune et bleue sur l'écran radio)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-fluxuri</code>: alegerea de la sfârșitul scanării DAB+ / DVB-T2 de pe televizor (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"
msgstr "<code>POST /api/scanare-fluxuri</code> : le choix à la fin de la recherche DAB+ / DVB-T2 sur le téléviseur (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-opreste</code>: oprește căutarea sau închide rezultatul rămas pe televizor"
msgstr "<code>POST /api/scanare-opreste</code> : arrête la recherche ou ferme le résultat resté sur le téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;&amp;...</code>: pornește căutarea pe televizor (cu <code>confirmat=1</code> după o întrebare)"
msgstr "<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;&amp;...</code> : lance la recherche sur le téléviseur (avec <code>confirmat=1</code> après une question)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code>: deschide pe televizor ecranul unei intrări din cele două secțiuni"
msgstr "<code>POST /api/scanare-televizor?id=&lt;entryID&gt;</code> : ouvre sur le téléviseur l'écran d'une entrée parmi les deux sections"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/setari-din-copie-reporneste</code>: repornește interfața, ca setările importate să se unească"
msgstr "<code>POST /api/setari-din-copie-reporneste</code> : redémarre l'interface, pour que les paramètres importés soient pris en compte"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/setari-seteaza?id=&lt;cheie&gt;&amp;r&lt;N&gt;=&lt;valoare&gt;</code>: schimbă și salvează rândurile trimise (o valoare greșită nu schimbă nimic; la o alegere multiplă, ca vitezele de derulare, alegerile despărțite prin virgulă, de pildă <code>r20=2,8,16</code>; gol = nicio alegere)"
msgstr "<code>POST /api/setari-seteaza?id=&lt;cheie&gt;&amp;r&lt;N&gt;=&lt;valoare&gt;</code> : change et enregistre les lignes envoyées (une valeur erronée ne change rien ; pour un choix multiple, comme les vitesses de défilement, les choix séparés par des virgules, par exemple <code>r20=2,8,16</code> ; vide = aucun choix)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/stocare-foloseste?punct=/media/usb</code>: folosește discul pentru înregistrări (face dosarul movie, fără formatare)"
msgstr "<code>POST /api/stocare-foloseste?punct=/media/usb</code> : utilise le disque pour les enregistrements (crée le dossier movie, sans formatage)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-aspect-implicite</code>: toate înapoi la valorile de la început"
msgstr "<code>POST /api/subtitrari-aspect-implicite</code> : tout revient aux valeurs de départ"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-aspect-seteaza?stil_font=&lt;skin|ingust|tiresias_info|tiresias_pc|google:Alias&gt;&amp;grosime=&lt;automata|normala|ingrosata|foarte_ingrosata&gt;&amp;marime=&lt;60..200&gt;&amp;culoare=&lt;emisiune|%23rrggbb&gt;&amp;contur=&lt;fara|subtire|normal|gros|foarte_gros&gt;&amp;culoare_contur=&lt;%23rrggbb&gt;&amp;umbra=0|1&amp;culoare_umbra=&lt;%23rrggbb&gt;&amp;directie_umbra=&lt;sus|sus_dreapta|dreapta|jos_dreapta|jos|jos_stanga|stanga|sus_stanga&gt;&amp;distanta_umbra=&lt;50|100|150|200|300&gt;&amp;umbra_moale=&lt;tare|moale|foarte_moale&gt;&amp;fundal=&lt;niciunul|rand|cutie&gt;&amp;culoare_fundal=&lt;%23rrggbb&gt;&amp;opacitate_fundal=&lt;10..100&gt;&amp;jos=&lt;2..25&gt;&amp;spatiere=&lt;80|90|100|110|125|150&gt;&amp;marire_dvb=&lt;clara|ocr&gt;</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>alegeri</code>; o valoare greșită nu schimbă nimic); sau <code>stil=&lt;cheie&gt;</code>, un stil gata făcut"
msgstr "<code>POST /api/subtitrari-aspect-seteaza?stil_font=&lt;skin|ingust|tiresias_info|tiresias_pc|google:Alias&gt;&amp;grosime=&lt;automata|normala|ingrosata|foarte_ingrosata&gt;&amp;marime=&lt;60..200&gt;&amp;culoare=&lt;emisiune|%23rrggbb&gt;&amp;contur=&lt;fara|subtire|normal|gros|foarte_gros&gt;&amp;culoare_contur=&lt;%23rrggbb&gt;&amp;umbra=0|1&amp;culoare_umbra=&lt;%23rrggbb&gt;&amp;directie_umbra=&lt;sus|sus_dreapta|dreapta|jos_dreapta|jos|jos_stanga|stanga|sus_stanga&gt;&amp;distanta_umbra=&lt;50|100|150|200|300&gt;&amp;umbra_moale=&lt;tare|moale|foarte_moale&gt;&amp;fundal=&lt;niciunul|rand|cutie&gt;&amp;culoare_fundal=&lt;%23rrggbb&gt;&amp;opacitate_fundal=&lt;10..100&gt;&amp;jos=&lt;2..25&gt;&amp;spatiere=&lt;80|90|100|110|125|150&gt;&amp;marire_dvb=&lt;clara|ocr&gt;</code> : change et enregistre n'importe lequel d'entre eux (les valeurs exactes sont dans <code>alegeri</code> ; une valeur erronée ne change rien) ; ou <code>stil=&lt;cheie&gt;</code>, un style tout fait"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-film-alege?id=&lt;id&gt;|oprit</code>, <code>POST /api/subtitrari-film-intarziere?ms=N</code> (sau <code>pas=</code>), <code>POST /api/subtitrari-film-codare?cod=..</code>, <code>POST /api/subtitrari-film-fps?fps=..</code>: aceleași alegeri ca tasta SUB la un film din fișier"
msgstr "<code>POST /api/subtitrari-film-alege?id=&lt;id&gt;|oprit</code>, <code>POST /api/subtitrari-film-intarziere?ms=N</code> (ou <code>pas=</code>), <code>POST /api/subtitrari-film-codare?cod=..</code>, <code>POST /api/subtitrari-film-fps?fps=..</code> : les mêmes choix que la touche SUB pour un film depuis un fichier"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/subtitrari-ocr-zero</code>: contorul recunoașterii textului pus la zero"
msgstr "<code>POST /api/subtitrari-ocr-zero</code> : le compteur de la reconnaissance de texte remis à zéro"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/sunet-seteaza?iesire=&lt;auto|manual&gt;&amp;ac3=&lt;da|nu&gt;&amp;dts=&lt;da|nu&gt;&amp;pista=&lt;da|nu&gt;</code>: oricare dintre ele, salvate; ac3 / dts sunt setările pentru Manual"
msgstr "<code>POST /api/sunet-seteaza?iesire=&lt;auto|manual&gt;&amp;ac3=&lt;da|nu&gt;&amp;dts=&lt;da|nu&gt;&amp;pista=&lt;da|nu&gt;</code> : n'importe lequel d'entre eux, enregistrés ; ac3 / dts sont les paramètres pour Manuel"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-asociere?pas=inapoi|sari|gata|continua|anuleaza|proba|inchide&amp;pastreaza=0|1</code>: pașii asocierii unei telecomenzi noi"
msgstr "<code>POST /api/telecomenzi-asociere?pas=inapoi|sari|gata|continua|anuleaza|proba|inchide&amp;pastreaza=0|1</code> : les étapes de l'association d'une nouvelle télécommande"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|oprit</code>: pornește sau oprește captura paginii (cititorul și proba numai ascultă, cel mult 2 minute)"
msgstr "<code>POST /api/telecomenzi-captura?fel=cititor|proba|proba-noua|asociere|oprit</code> : lance ou arrête la capture de la page (le lecteur et le test écoutent seulement, au plus 2 minutes)"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/telecomenzi-schimba?actiune=activa|neasociate|redenumeste|sterge-tasta|sterge|sterge-tot&amp;id=..&amp;cod=..&amp;nume=..&amp;confirmat=1</code>: aceleași schimbări ca în lista de pe televizor"
msgstr "<code>POST /api/telecomenzi-schimba?actiune=activa|neasociate|redenumeste|sterge-tasta|sterge|sterge-tot&amp;id=..&amp;cod=..&amp;nume=..&amp;confirmat=1</code> : les mêmes changements que dans la liste du téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/teletext-salveaza</code>, <code>POST /api/teletext-sterge?ref=</code>, <code>POST /api/teletext-reimprospateaza?ref=</code> (receptorul trece pe canal, așteaptă o trecere completă a teletextului, face copia și se întoarce la canalul de dinainte; răspunde pe loc), <code>POST /api/teletext-setari?hd=0|1&amp;contur=0|1&amp;umbra=0|1&amp;relief=0|1&amp;copie_automata=0|1&amp;spatiu=5|10|20|50|100</code> (<code>hd</code> = Teletext neted): aceleași alegeri ca meniul teletextului de pe televizor"
msgstr "<code>POST /api/teletext-salveaza</code>, <code>POST /api/teletext-sterge?ref=</code>, <code>POST /api/teletext-reimprospateaza?ref=</code> (le récepteur passe sur la chaîne, attend un passage complet du télétexte, fait la copie et revient à la chaîne d'avant ; répond tout de suite), <code>POST /api/teletext-setari?hd=0|1&amp;contur=0|1&amp;umbra=0|1&amp;relief=0|1&amp;copie_automata=0|1&amp;spatiu=5|10|20|50|100</code> (<code>hd</code> = Télétexte lissé) : les mêmes choix que le menu télétexte du téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-adauga?ref=&lt;canal&gt;&amp;zi=AAAA-LL-ZZ&amp;inceput=HH:MM&amp;sfarsit=HH:MM&amp;nume=..&amp;doar_comuta=0|1</code>: pune o înregistrare (sau doar schimbarea canalului); la suprapunere nu pune nimic și spune cu ce se suprapune"
msgstr "<code>POST /api/temporizatoare-adauga?ref=&lt;canal&gt;&amp;zi=AAAA-LL-ZZ&amp;inceput=HH:MM&amp;sfarsit=HH:MM&amp;nume=..&amp;doar_comuta=0|1</code> : met un enregistrement (ou seulement le changement de chaîne) ; en cas de chevauchement il ne met rien et dit avec quoi il se chevauche"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-modifica?id=..&amp;zi=..&amp;inceput=..&amp;sfarsit=..&amp;repetare=o_data|zilnic|luni_vineri|zile&amp;zile=0,1,..&amp;dupa=nimic|asteptare|oprire|automat&amp;loc=..</code>: aceleași câmpuri ca fereastra de pe televizor, cu aceeași verificare a suprapunerii; <code>POST /api/temporizatoare-opreste?id=..&amp;alegere=stoponlycurrent|stopall|stoponlycoming</code>: una repetată care merge acum"
msgstr "<code>POST /api/temporizatoare-modifica?id=..&amp;zi=..&amp;inceput=..&amp;sfarsit=..&amp;repetare=o_data|zilnic|luni_vineri|zile&amp;zile=0,1,..&amp;dupa=nimic|asteptare|oprire|automat&amp;loc=..</code> : les mêmes champs que la fenêtre du téléviseur, avec la même vérification du chevauchement ; <code>POST /api/temporizatoare-opreste?id=..&amp;alegere=stoponlycurrent|stopall|stoponlycoming</code> : un enregistrement répété en cours"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, <code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, <code>POST /api/temporizatoare-curata?confirmat=1</code>: șterge una, o oprește sau o pornește din nou, șterge cele terminate"
msgstr "<code>POST /api/temporizatoare-sterge?id=..&amp;confirmat=1</code>, <code>POST /api/temporizatoare-opreste?id=..&amp;oprit=1|0</code>, <code>POST /api/temporizatoare-curata?confirmat=1</code> : supprime un enregistrement, l'arrête ou le relance, supprime ceux qui sont terminés"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-cauta</code>: caută în rețeaua de acasă serverele Ollama (11434) și LibreTranslate (5000); rezultatul vine în <code>cautare</code>"
msgstr "<code>POST /api/traducere-configurare-cauta</code> : cherche dans le réseau de la maison les serveurs Ollama (11434) et LibreTranslate (5000) ; le résultat vient dans <code>cautare</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-cheie</code>, corpul <code>cheie=&lt;cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code>: probează cheia pe loc și, dacă merge, o salvează și pornește traducerea; numai în corpul cererii, niciodată în adresă; rezultatul vine în <code>configurare</code> din <code>GET /api/traducere-configurare</code>"
msgstr "<code>POST /api/traducere-configurare-cheie</code>, corps <code>cheie=&lt;cheia&gt;&amp;serviciu=&lt;auto|gemini|azure|deepl|groq|cloudflare|google&gt;&amp;regiune=..&amp;cont=..&amp;fara_proba=0|1</code> : teste la clé tout de suite et, si ça marche, l'enregistre et démarre la traduction ; seulement dans le corps de la requête, jamais dans l'adresse ; le résultat vient dans <code>configurare</code> de <code>GET /api/traducere-configurare</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-model?model=..</code>: alt model pentru serviciul ales acum, cu probă"
msgstr "<code>POST /api/traducere-configurare-model?model=..</code> : un autre modèle pour le service choisi actuellement, avec test"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;&amp;adresa=..&amp;model=..</code>: folosește serverul din casă (adresa completată de receptor, modelul ales singur dacă lipsește) și îl probează"
msgstr "<code>POST /api/traducere-configurare-server?serviciu=&lt;libre|openai&gt;&amp;adresa=..&amp;model=..</code> : utilise le serveur de la maison (l'adresse remplie par le récepteur, le modèle choisi tout seul s'il manque) et le teste"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-cheie</code>, corpul <code>serviciu=&lt;cod&gt;&amp;cheie=&lt;cheia&gt;</code>: pune cheia unui serviciu (goală = o șterge); la <code>serviciu=propriu</code> cheia este valoarea antetului adresei proprii (de exemplu <code>Bearer</code> și cheia); numai în corpul cererii, niciodată în adresă; răspunsul spune doar care serviciu are cheie"
msgstr "<code>POST /api/traducere-subtitrari-cheie</code>, corps <code>serviciu=&lt;cod&gt;&amp;cheie=&lt;cheia&gt;</code> : met la clé d'un service (vide = la supprime) ; avec <code>serviciu=propriu</code> la clé est la valeur de l'en-tête de l'adresse propre (par exemple <code>Bearer</code> et la clé) ; seulement dans le corps de la requête, jamais dans l'adresse ; la réponse dit seulement quel service a une clé"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-proba</code>: probează traducerea cu serviciul ales; rezultatul vine în <code>stare.proba</code> din <code>GET /api/traducere-subtitrari</code>"
msgstr "<code>POST /api/traducere-subtitrari-proba</code> : teste la traduction avec le service choisi ; le résultat vient dans <code>stare.proba</code> de <code>GET /api/traducere-subtitrari</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=..&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;propriu_cale=..</code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în <code>alegeri</code>); o valoare greșită refuză tot. Adresa proprie: adresa e un șablon cu <code>{text}</code>, <code>{sursa}</code>, <code>{tinta}</code> (http:// numai pentru un server din rețeaua de acasă); adresa receptorului însuși (127.0.0.1, localhost, IP-ul lui) e refuzată, și la <code>adresa_libre</code> și <code>adresa_openai</code>; calea în JSON are chei și numere despărțite prin punct, <code>*</code> = toate elementele"
msgstr "<code>POST /api/traducere-subtitrari-seteaza?pornit=0|1&amp;serviciu=&lt;gemini|libre|openai|azure|deepl|groq|cloudflare|google|propriu&gt;&amp;limba=&lt;meniu|ro|en|de|...&gt;&amp;afisare=&lt;inlocuieste|sub&gt;&amp;tarziu=&lt;inlocuieste|sare&gt;&amp;citire=&lt;normal|lung|foarte_lung&gt;&amp;dvb=0|1&amp;bara=0|1&amp;epg=0|1&amp;regiune=..&amp;adresa_libre=..&amp;adresa_openai=..&amp;model_gemini=..&amp;model_openai=..&amp;model_groq=..&amp;model_cloudflare=..&amp;cont_cloudflare=..&amp;propriu_adresa=..&amp;propriu_metoda=GET|POST&amp;propriu_corp=..&amp;propriu_tip_corp=json|formular&amp;propriu_antet=..&amp;propriu_raspuns=json|text&amp;propriu_cale=..</code> : change et enregistre n'importe lequel d'entre eux (les valeurs exactes sont dans <code>alegeri</code>) ; une valeur erronée refuse tout. Adresse propre : l'adresse est un modèle avec <code>{text}</code>, <code>{sursa}</code>, <code>{tinta}</code> (http:// seulement pour un serveur du réseau de la maison) ; l'adresse du récepteur lui-même (127.0.0.1, localhost, son IP) est refusée, aussi pour <code>adresa_libre</code> et <code>adresa_openai</code> ; le chemin dans le JSON a des clés et des nombres séparés par un point, <code>*</code> = tous les éléments"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/traducere-subtitrari-zero</code>: contorul traducerii pus la zero"
msgstr "<code>POST /api/traducere-subtitrari-zero</code> : le compteur de la traduction remis à zéro"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;asteptare=10|20|60</code>; <code>GET /api/tv-flux</code>: fluxul TS al transmisiei acestui browser. Pornirea și fluxul merg numai din browserul conectat, cu antetul <code>X-HDS-CSRF</code>, niciodată cu <code>?token=</code>"
msgstr "<code>POST /api/tv-porneste?ref=&lt;referință&gt;&amp;hevc=0|1&amp;ac3=0|1&amp;wasm=0|1</code>, <code>POST /api/tv-opreste?id=</code>, <code>POST /api/tv-seteaza?permis=0|1&amp;standby=0|1&amp;sesiuni_max=1|2&amp;asteptare=10|20|60</code> ; <code>GET /api/tv-flux</code> : le flux TS de la diffusion de ce navigateur. Le démarrage et le flux ne marchent que depuis le navigateur connecté, avec l'en-tête <code>X-HDS-CSRF</code>, jamais avec <code>?token=</code>"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-confirma</code> și <code>POST /api/video-revino</code>: păstrează modul încercat sau revine la cel de dinainte"
msgstr "<code>POST /api/video-confirma</code> et <code>POST /api/video-revino</code> : garde le mode essayé ou revient à celui d'avant"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-reporneste</code>: repornește receptorul (culorile „Ca la calculator” se aplică numai după o repornire); cu o înregistrare în curs, întrebarea apare pe televizor"
msgstr "<code>POST /api/video-reporneste</code> : redémarre le récepteur (les couleurs « Comme un ordinateur » ne s'appliquent qu'après un redémarrage) ; avec un enregistrement en cours, la question apparaît sur le téléviseur"

#: lib/python/Plugins/Extensions/HdsWebControl/plugin.py
msgid "<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=..&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;ycbcr|rgb&gt;</code>: un mod nou se încearcă (aceeași întrebare pe televizor, 20 s, fără răspuns revine); zapmode se salvează direct; culori_hdmi=ycbcr se încearcă la fel (aceeași întrebare), rgb se salvează și se aplică după o repornire"
msgstr "<code>POST /api/video-seteaza?rezolutie=&lt;2160p|1080p|...&gt;&amp;frecventa=&lt;mod|auto&gt;&amp;colorspace=..&amp;colordepth=..&amp;hdrtype=..&amp;zapmode=&lt;mute|hold|mutetilllock|holdtilllock&gt;&amp;culori_hdmi=&lt;ycbcr|rgb&gt;</code> : un nouveau mode est essayé (la même question sur le téléviseur, 20 s, sans réponse il revient) ; zapmode s'enregistre directement ; culori_hdmi=ycbcr est essayé de la même façon (la même question), rgb s'enregistre et s'applique après un redémarrage"

