#: data/setup.xml lib/python/Components/Converter/HdsLang.py lib/python/Components/Converter/HdsLang_et.py lib/python/Components/Converter/HdsLang_tr.py lib/python/Screens/AudioSelection.py
msgid "DTS downmix"
msgstr "Downmix DTS"

#: data/setup.xml
msgid "Delay of the AC3 sound against the picture, on all channels. It is used from the next channel change."
msgstr "Retard du son AC3 par rapport à l'image, sur toutes les chaînes. Pris en compte au prochain changement de chaîne."

#: data/setup.xml
msgid "Delay of the stereo sound against the picture, on all channels. It is used from the next channel change."
msgstr "Retard du son stéréo par rapport à l'image, sur toutes les chaînes. Pris en compte au prochain changement de chaîne."

#: data/setup.xml
msgid "Yes: on channels with several sound tracks the first track that is not MPEG starts (usually AC3 or DD+). No: the first track of the channel starts, or the one chosen last time."
msgstr "Oui : sur les chaînes avec plusieurs pistes son, la première piste qui n'est pas MPEG démarre (en général AC3 ou DD+). Non : la première piste de la chaîne démarre, ou celle choisie la dernière fois."

#: data/setup.xml
msgid "Yes: the receiver turns AC3 sound into stereo. No: AC3 sound goes unchanged to the TV or sound system (5.1 sound), which must know AC3, otherwise there is no sound."
msgstr "Oui : le récepteur transforme le son AC3 en stéréo. Non : le son AC3 part tel quel vers le téléviseur ou le système audio (son 5.1), qui doit connaître l'AC3, sinon on n'entend rien."

#: data/setup.xml
msgid "Yes: the receiver turns DTS sound into stereo. No: DTS sound goes unchanged to the TV or sound system; if it does not know DTS, there is no sound. Many TVs do not know DTS."
msgstr "Oui : le récepteur transforme le son DTS en stéréo. Non : le son DTS part tel quel vers le téléviseur ou le système audio ; s'il ne connaît pas le DTS, on n'entend rien. Beaucoup de téléviseurs ne connaissent pas le DTS."

