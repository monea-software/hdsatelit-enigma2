#: data/menu.xml
#: data/setup.xml
msgid "Volum și întârziere"
msgstr "Volume et retard"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Pasul volumului"
msgstr "Pas du volume"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Cât crește sau scade volumul la o apăsare pe tastele de volum (volumul merge de la 0 la 100)."
msgstr "De combien le volume monte ou baisse à chaque appui sur les touches de volume (le volume va de 0 à 100)."

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Volumul ținut minte pe canal"
msgstr "Volume mémorisé par chaîne"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Da: fiecare canal pornește cu volumul la care l-ai lăsat. Un canal la care nu ai schimbat volumul îl păstrează pe cel de acum."
msgstr "Oui : chaque chaîne démarre au volume auquel tu l'as laissée. Une chaîne dont tu n'as pas changé le volume garde le volume actuel."

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Volum egal între canale"
msgstr "Volume égal entre les chaînes"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Placa de sunet apropie singură volumul: canalele și reclamele tari se aud mai încet, cele încete mai tare. Puternic micșorează și diferența dintre tare și încet (bun noaptea). Nu lucrează când sunetul pleacă neschimbat spre televizor."
msgstr "La puce audio égalise seule le volume : les chaînes et publicités fortes sonnent moins fort, les faibles plus fort. Fort réduit aussi l'écart entre fort et faible (utile la nuit). Ne fonctionne pas quand le son part inchangé vers le téléviseur."

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Întârzierea sunetului pe HDMI"
msgstr "Retard du son sur HDMI"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Când buzele se mișcă după sunet, întârzie sunetul spre televizor. Sunetul se poate numai întârzia, nu grăbi."
msgstr "Quand les lèvres bougent après le son, retarde le son vers le téléviseur. Le son peut seulement être retardé, pas avancé."

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "Întârzierea sunetului pe optic"
msgstr "Retard du son sur la sortie optique"

#: data/setup.xml
#: lib/python/Components/HdsSetariSunet.py
msgid "La fel, pentru bara de sunet sau amplificatorul legat la ieșirea optică a receptorului."
msgstr "Pareil, pour la barre de son ou l'amplificateur branché sur la sortie optique du récepteur."

#: lib/python/Components/HdsSetariSunet.py
msgid "Ușor"
msgstr "Léger"

#: lib/python/Components/HdsSetariSunet.py
msgid "Puternic"
msgstr "Fort"

#: lib/python/Components/HdsSetariSunet.py
msgid "Întârzierea pistei pe acest canal"
msgstr "Retard de la piste sur cette chaîne"

#: lib/python/Components/HdsSetariSunet.py
msgid "Se adună la întârzierea ieșirii, numai pentru pista de sunet de acum a canalului de acum. Se ține minte."
msgstr "S'ajoute au retard de la sortie, seulement pour la piste son actuelle de la chaîne actuelle. Il est mémorisé."

#: lib/python/Plugins/Extensions/HdsWebControl/setari_sunet_web.py
msgid "Setările sunetului nu sunt încă gata. Încearcă din nou peste câteva secunde."
msgstr "Les réglages du son ne sont pas encore prêts. Réessaie dans quelques secondes."

#: lib/python/Plugins/Extensions/HdsWebControl/setari_sunet_web.py
msgid "Nu merge acum un canal cu o pistă de sunet."
msgstr "Aucune chaîne avec une piste son n'est en cours."

#: lib/python/Components/HdsEgalizator.py
msgid "La canalele TV egalizatorul e oprit din setări. Sunetul merge prin placa de sunet."
msgstr "Sur les chaînes TV, l'égaliseur est désactivé dans les réglages. Le son passe par la puce audio."

#: lib/python/Components/HdsEgalizator.py
msgid "receptorul nu a dat ceasul imaginii"
msgstr "le récepteur n'a pas donné l'horloge de l'image"

#: lib/python/Components/HdsEgalizator.py
msgid "sunetul nu s-a putut potrivi cu imaginea"
msgstr "le son n'a pas pu être aligné sur l'image"

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Potrivirea cu imaginea se dă în milisecunde, din 10 în 10, între %d și %d."
msgstr "L'alignement sur l'image se donne en millisecondes, par pas de 10, entre %d et %d."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea nu e semnată de HD Satelit; nu se instalează."
msgstr "La mise à jour n'est pas signée par HD Satelit ; elle n'est pas installée."

#: lib/python/Components/HdsActualizari.py
msgid "Se descarcă și se verifică pachetele..."
msgstr "Téléchargement et vérification des paquets..."

#: lib/python/Components/HdsTransmisie.py
#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Canalul e criptat și receptorul nu-l poate decripta acum (fără card sau fără drepturi pentru el)."
msgstr "La chaîne est cryptée et le récepteur ne peut pas la décrypter maintenant (pas de carte ou pas de droits pour elle)."

#: lib/python/Components/HdsTransmisie.py
msgid "Tunerul e ocupat de o înregistrare pe altă frecvență."
msgstr "Le tuner est occupé par un enregistrement sur une autre fréquence."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Pe televizor nu merge acum niciun canal."
msgstr "Aucune chaîne n'est diffusée sur le téléviseur en ce moment."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Pe televizor merge acum ceva ce nu se poate transmite în browser."
msgstr "Le téléviseur diffuse en ce moment quelque chose qui ne peut pas être transmis au navigateur."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Canalul se decriptează încă. Deschide-l din nou peste câteva secunde."
msgstr "La chaîne est encore en cours de décryptage. Rouvre-la dans quelques secondes."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Se schimbă canalul..."
msgstr "Changement de chaîne..."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
#, python-format
msgid "Televizorul trece pe %s..."
msgstr "Le téléviseur passe sur %s..."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Antena se rotește..."
msgstr "L'antenne tourne..."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Se decriptează..."
msgstr "Décryptage..."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Browserul nu poate reda imaginea acestui canal. Încearcă din nou."
msgstr "Le navigateur ne peut pas lire l'image de cette chaîne. Réessaie."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Browserul nu poate reda imaginea acestui canal. Încearcă din nou sau deschide-l într-un player din casă cu playlistul de mai jos."
msgstr "Le navigateur ne peut pas lire l'image de cette chaîne. Réessaie ou ouvre-la dans un lecteur de la maison avec la playlist ci-dessous."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Browserul nu poate reda sunetul acestui canal. Încearcă din nou."
msgstr "Le navigateur ne peut pas lire le son de cette chaîne. Réessaie."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Browserul nu poate reda sunetul acestui canal. Încearcă din nou sau deschide-l într-un player din casă cu playlistul de mai jos."
msgstr "Le navigateur ne peut pas lire le son de cette chaîne. Réessaie ou ouvre-la dans un lecteur à la maison avec la liste de lecture ci-dessous."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Acest browser nu poate decoda imaginea HEVC (H.265) a acestui canal, de pildă 4K pe 10 biți. Încearcă alt browser sau un player din casă."
msgstr "Ce navigateur ne peut pas décoder l'image HEVC (H.265) de cette chaîne, par exemple en 4K sur 10 bits. Essaie un autre navigateur ou un lecteur à la maison."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Acest browser nu poate decoda imaginea HEVC (H.265) a acestui canal, de pildă 4K pe 10 biți. Deschide-l într-un player din casă cu playlistul de mai jos."
msgstr "Ce navigateur ne peut pas décoder l'image HEVC (H.265) de cette chaîne, par exemple en 4K sur 10 bits. Ouvre-la dans un lecteur à la maison avec la liste de lecture ci-dessous."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Pornește din nou"
msgstr "Relancer"

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Încearcă din nou"
msgstr "Réessayer"

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Televizorul nu a trecut pe acest canal."
msgstr "Le téléviseur n'est pas passé sur cette chaîne."

#: lib/python/Plugins/Extensions/HdsWebControl/tv_web.py
msgid "Receptorul e în standby."
msgstr "Le récepteur est en veille."


#: lib/python/Plugins/Extensions/HdsWebControl/vezi_live_web.py
msgid "Vezi live"
msgstr "Regarder en direct"

#: lib/python/Plugins/Extensions/HdsWebControl/vezi_live_web.py
#, python-format
msgid "Vezi live canalul %s"
msgstr "Regarder la chaîne %s en direct"

#: lib/python/Plugins/Extensions/HdsWebControl/vezi_live_web.py
#, python-format
msgid "Vezi live: %s"
msgstr "Regarder en direct : %s"

#: lib/python/Plugins/Extensions/HdsWebControl/vezi_live_web.py
msgid "Playerul nu s-a încărcat de pe receptor. Reîncarcă pagina."
msgstr "Le lecteur ne s'est pas chargé depuis le récepteur. Recharge la page."

#: lib/python/Plugins/Extensions/HdsWebControl/vezi_live_web.py
msgid "Exportă playlist (M3U)"
msgstr "Exporter la liste de lecture (M3U)"

#: lib/python/Plugins/Extensions/HdsWebControl/vezi_live_web.py
msgid "Se strânge lista..."
msgstr "Préparation de la liste..."

#: lib/python/Plugins/Extensions/HdsWebControl/vezi_live_web.py
#, python-format
msgid "Playlistul s-a descărcat (%s). Deschide-l într-un player din casă."
msgstr "La liste de lecture a été téléchargée (%s). Ouvre-la dans un lecteur de la maison."

#: lib/python/Plugins/Extensions/HdsWebControl/vezi_live_web.py
msgid "Playlistul nu s-a putut face."
msgstr "La liste de lecture n'a pas pu être créée."

#: lib/python/Plugins/Extensions/HdsWebControl/vezi_live_web.py
msgid "Lista nu are niciun canal."
msgstr "La liste ne contient aucune chaîne."

#: lib/python/Plugins/Extensions/HdsWebControl/cautare_web.py
msgid "Un aparat primește numai canale TV, iar printre canalele găsite sunt și posturi de radio. Alege TV la rândul Tip."
msgstr "Un appareil ne reçoit que des chaînes TV, et parmi les chaînes trouvées il y a aussi des stations de radio. Choisis TV dans la ligne Type."

#: lib/python/Plugins/Extensions/HdsWebControl/cautare_web.py
msgid "Canalele găsite acum, ca playlist pentru un player din casă"
msgstr "Les chaînes trouvées maintenant, en liste de lecture pour un lecteur de la maison"

#: lib/python/Plugins/Extensions/HdsWebControl/cautare_web.py
#, python-format
msgid "Playlistul are primele %s din %d găsite."
msgstr "La liste de lecture ne contient que %s sur les %d trouvées."

