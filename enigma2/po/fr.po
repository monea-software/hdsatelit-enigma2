#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Actualizează rapid"
msgstr "Mise à jour rapide"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Un singur clic caută actualizarea, o instalează dacă există și repornește interfața."
msgstr "Un seul clic cherche la mise à jour, l'installe s'il y en a une et redémarre l'interface."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Pornești actualizarea rapidă? Dacă există o actualizare, se instalează, apoi interfața se repornește singură."
msgstr "Lancer la mise à jour rapide ? S'il y a une mise à jour, elle s'installe, puis l'interface redémarre d'elle-même."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Caut actualizarea"
msgstr "Recherche de la mise à jour"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
#, python-format
msgid "Instalez versiunea %s"
msgstr "Installation de la version %s"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Instalez actualizarea"
msgstr "Installation de la mise à jour"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Repornesc interfața"
msgstr "Redémarrage de l'interface"

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Interfața repornește. Aștept să revină..."
msgstr "L'interface redémarre. Attente de son retour..."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
#, python-format
msgid "Actualizat la %s."
msgstr "Mis à jour vers %s."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
#, python-format
msgid "Interfața a repornit cu versiunea %s, nu cu %s."
msgstr "L'interface a redémarré avec la version %s, pas avec la %s."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Interfața nu a revenit în 4 minute. Verifică receptorul."
msgstr "L'interface n'est pas revenue en 4 minutes. Vérifie le récepteur."

#: lib/python/Plugins/Extensions/HdsWebControl/actualizari_web.py
msgid "Interfața nu s-a repornit. Apasă Repornește interfața."
msgstr "L'interface n'a pas redémarré. Appuie sur Redémarrer l'interface."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea rapidă este deja în lucru."
msgstr "La mise à jour rapide est déjà en cours."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Interfața se repornește acum."
msgstr "La mise à jour est installée. L'interface redémarre maintenant."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Interfața se repornește singură după înregistrare."
msgstr "La mise à jour est installée. L'interface redémarre d'elle-même après l'enregistrement."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Interfața se repornește singură după ce se termină lucrarea din fundal."
msgstr "La mise à jour est installée. L'interface redémarre d'elle-même quand la tâche en arrière-plan se termine."

#: lib/python/Components/HdsActualizari.py
msgid "Actualizarea s-a instalat. Pe televizor se așteaptă un răspuns la întrebarea de repornire."
msgstr "La mise à jour est installée. Le téléviseur attend une réponse à la question de redémarrage."

#: lib/python/Components/HdsActualizari.py
msgid "Repornirea a fost refuzată pe televizor. Actualizarea se folosește după ce repornești interfața."
msgstr "Le redémarrage a été refusé sur le téléviseur. La mise à jour sera utilisée quand tu redémarreras l'interface."


#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Tradu teletextul"
msgstr "Traduire le télétexte"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Teletextul tradus"
msgstr "Télétexte traduit"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Tradu HbbTV"
msgstr "Traduire HbbTV"

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Ce s-a tradus din teletext și HbbTV"
msgstr "Ce qui a été traduit du télétexte et de HbbTV"

#: lib/python/Screens/HdsTraducereSubtitrari.py
#, python-format
msgid "%s: texte traduse %d (%d semne trimise, din cota serviciului), cereri %d, deja în limba ta %d, sărite %d."
msgstr "%s : textes traduits %d (%d caractères envoyés, sur le quota du service), requêtes %d, déjà dans ta langue %d, ignorés %d."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Traduce paginile de teletext pe care le deschizi (tasta TEXT) în limba traducerii, cu aceleași servicii și chei. Pagina apare întâi în original, apoi tradusă. În teletext, AUDIO arată originalul paginii, iar MENU are aceleași alegeri. Consumă din cota serviciului, de aceea din fabrică e oprită; un text tradus o dată nu se mai cere."
msgstr "Traduit les pages de télétexte que tu ouvres (touche TEXT) dans la langue de traduction, avec les mêmes services et clés. La page apparaît d'abord dans l'original, puis traduite. Dans le télétexte, AUDIO montre l'original de la page et MENU propose les mêmes choix. Consomme le quota du service, c'est pourquoi c'est désactivé d'usine ; un texte traduit une fois n'est plus redemandé."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "În pagină: rândurile traduse iau locul celor originale, în cele 40 de coloane ale paginii, cu aceleași culori; ce nu încape se taie cu „…”. Într-un panou: pagina originală, mai mică, în stânga, și traducerea întreagă în dreapta."
msgstr "Dans la page : les lignes traduites prennent la place des lignes originales, dans les 40 colonnes de la page, avec les mêmes couleurs ; ce qui ne tient pas est coupé avec « … ». Dans un panneau : la page originale, plus petite, à gauche, et la traduction entière à droite."

#: lib/python/Screens/HdsTraducereSubtitrari.py
msgid "Traduce textele văzute din aplicațiile HbbTV (tasta ROȘIE), ca „Traduce pagina” din browsere: numai textele de pe ecran, nu adresele, codul sau câmpurile de scris. Pagina apare întâi în original. Consumă din cota serviciului, de aceea din fabrică e oprită. Aplicațiile deschise pe https rămân deocamdată în original."
msgstr "Traduit les textes visibles des applications HbbTV (touche ROUGE), comme « Traduire la page » dans les navigateurs : seulement les textes à l'écran, pas les adresses, le code ni les champs de saisie. La page apparaît d'abord dans l'original. Consomme le quota du service, c'est pourquoi c'est désactivé d'usine. Les applications ouvertes en https restent pour l'instant dans l'original."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "În pagină"
msgstr "Dans la page"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Într-un panou"
msgstr "Dans un panneau"

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cu „Tradu teletextul” pornită pleacă la același serviciu și textul paginilor de teletext pe care le deschizi."
msgstr "Avec « Traduire le télétexte » activé, le texte des pages de télétexte que tu ouvres part aussi vers le même service."

#: lib/python/Components/HdsTraducereSubtitrari.py
msgid "Cu „Tradu HbbTV” pornită pleacă la același serviciu și textele văzute ale aplicațiilor HbbTV pe care le deschizi."
msgstr "Avec « Traduire HbbTV » activé, les textes visibles des applications HbbTV que tu ouvres partent aussi vers le même service."

#: lib/python/Screens/HdsTeletext.py
msgid "AUDIO: traducerea"
msgstr "AUDIO : traduction"

#: lib/python/Screens/HdsTeletext.py
msgid "AUDIO: originalul"
msgstr "AUDIO : original"

#: lib/python/Screens/HdsTeletext.py
msgid "Pagina în original"
msgstr "Page dans l'original"

#: lib/python/Screens/HdsTeletext.py
msgid "Se traduce pagina…"
msgstr "Traduction de la page…"

#: lib/python/Screens/HdsTeletext.py
msgid "Pagina tradusă"
msgstr "Page traduite"

#: lib/python/Screens/HdsTeletext.py
msgid "Pagina e deja în limba ta"
msgstr "La page est déjà dans ta langue"

#: lib/python/Screens/HdsTeletext.py
msgid "Pagina nu are text de tradus"
msgstr "La page n'a pas de texte à traduire"

#: lib/python/Screens/HdsTeletext.py
