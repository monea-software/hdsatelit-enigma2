msgid "claritatea: consoanele, chitarele"
msgstr "clarté : consonnes, guitares"

#: lib/python/Screens/HdsEgalizator.py
msgid "strălucirea: talgerele, respirația vocii"
msgstr "brillance : cymbales, souffle de la voix"

#: lib/python/Screens/HdsEgalizator.py
msgid "aerul: cele mai înalte sunete"
msgstr "air : les sons les plus aigus"

#: data/menu.xml
msgid "Egalizator"
msgstr "Égaliseur"

#: lib/python/Screens/HdsEgalizator.py
msgid "Renunță"
msgstr "Annuler"

#: lib/python/Screens/HdsEgalizator.py
msgid "Păstrează"
msgstr "Garder"

#: lib/python/Screens/HdsEgalizator.py
msgid "Presetarea următoare"
msgstr "Préréglage suivant"

#: lib/python/Screens/HdsEgalizator.py
msgid "Pornit / Oprit"
msgstr "Activé / Désactivé"

#: lib/python/Screens/HdsEgalizator.py
msgid "Presetare"
msgstr "Préréglage"

#: lib/python/Screens/HdsEgalizator.py
msgid "Mod de noapte"
msgstr "Mode nuit"

#: lib/python/Screens/HdsEgalizator.py
msgid "Pentru acest post"
msgstr "Pour cette station"

#: lib/python/Screens/HdsEgalizator.py
msgid "Nivel"
msgstr "Niveau"

#: lib/python/Screens/HdsEgalizator.py
msgid "Fără post"
msgstr "Aucune station"

#: lib/python/Screens/HdsEgalizator.py
msgid "Nu merge niciun post acum, deci reglajele se păstrează pentru toate posturile."
msgstr "Aucune station n'est en cours, les réglages sont donc gardés pour toutes les stations."

#: lib/python/Screens/HdsEgalizator.py
msgid "Nivel: potrivești tăria sunetului cu egalizator față de sunetul obișnuit, între −12 și +12 dB."
msgstr "Niveau : ajuste la force du son avec égaliseur par rapport au son habituel, de −12 à +12 dB."

#: lib/python/Screens/HdsEgalizator.py
#, python-format
msgid "%s, %s. Sus și jos: cu 1 dB mai mult sau mai puțin, între −12 și +12 dB."
msgstr "%s, %s. Haut et bas : 1 dB de plus ou de moins, de −12 à +12 dB."

#: lib/python/Screens/HdsEgalizator.py
msgid "acest post"
msgstr "cette station"

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Păstrat. Se aude și pe televizor."
msgstr "Gardé. Cela s'entend aussi sur le téléviseur."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Volumul se alege cu auto, aici sau placa."
msgstr "Le volume se choisit avec auto, aici ou placa."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Numele plăcii de sunet are numai litere, cifre și : , _ - ."
msgstr "Le nom du périphérique audio ne contient que des lettres, des chiffres et : , _ - ."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Am pus înapoi reglajele păstrate."
msgstr "Les réglages gardés sont rétablis."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
msgid "Se aude acum. Apasă „Păstrează” ca să rămână."
msgstr "Cela s'entend maintenant. Appuie sur „Garder” pour le conserver."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Presetarea „%s” nu există."
msgstr "Le préréglage „%s” n'existe pas."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Benzile se dau ca %d numere între %d și %d, cu virgulă între ele."
msgstr "Les bandes se donnent sous forme de %d nombres entre %d et %d, séparés par des virgules."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "Nivelul se dă ca număr între %d și %d."
msgstr "Le niveau se donne sous forme d'un nombre entre %d et %d."

#: lib/python/Plugins/Extensions/HdsWebControl/egalizator_web.py
#, python-format
msgid "„%s” se alege cu 1 (da) sau 0 (nu)."
msgstr "„%s” se choisit avec 1 (oui) ou 0 (non)."

#: lib/python/Components/HdsEgalizator.py
msgid "Pauză. Sunetul revine cu egalizator când pornești din nou."
msgstr "Pause. Le son revient avec l'égaliseur quand tu reprends la lecture."

#: lib/python/Components/HdsEgalizator.py
msgid "La canalele TV egalizatorul nu merge încă: sunetul trebuie să rămână potrivit cu ce vezi pe ecran, deci merge prin placa de sunet. Egalizatorul lucrează la posturile de radio."
msgstr "Sur les chaînes TV, l'égaliseur ne fonctionne pas encore : le son doit rester calé sur ce que tu vois à l'écran, il passe donc par la puce audio. L'égaliseur fonctionne sur les stations de radio."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul nu poate porni: receptorul nu are decodorul MPEG audio."
msgstr "L'égaliseur ne peut pas démarrer : le récepteur n'a pas de décodeur audio MPEG."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul nu poate porni: lipsește decodarea sunetului în procesor (GStreamer)."
msgstr "L'égaliseur ne peut pas démarrer : le décodage du son dans le processeur manque (GStreamer)."

#: lib/python/Components/HdsEgalizator.py
msgid "Egalizatorul lipsește din programul acestui receptor. Setările se păstrează, dar nu se aud."
msgstr "L'égaliseur manque dans le logiciel de ce récepteur. Les réglages sont gardés, mais ne s'entendent pas."

#: lib/python/Components/HdsEgalizator.py
msgid "ieșirea plăcii de sunet pentru procesor e oprită"
msgstr "la sortie de la puce audio pour le processeur est coupée"

#: lib/python/Components/HdsEgalizator.py
msgid "receptorul nu are decodor AAC"
msgstr "le récepteur n'a pas de décodeur AAC"

#: lib/python/Components/HdsEgalizator.py
msgid "receptorul nu are decodorul MPEG audio"
msgstr "le récepteur n'a pas de décodeur audio MPEG"

#: lib/python/Components/HdsEgalizator.py
msgid "lipsește decodarea sunetului în procesor"
msgstr "le décodage du son dans le processeur manque"

#: lib/python/Components/HdsEgalizator.py
msgid "placa de sunet nu se poate folosi din procesor"
msgstr "la puce audio n'est pas utilisable depuis le processeur"

#: lib/python/Components/HdsEgalizator.py
msgid "felul acesta de AAC nu se poate decoda încă"
msgstr "ce type d'AAC ne peut pas encore être décodé"

#: lib/python/Components/HdsEgalizator.py
msgid "fișierul probei nu există"
msgstr "le fichier d'essai n'existe pas"

#: lib/python/Components/HdsEgalizator.py
msgid "fișierul probei nu s-a putut scrie"
msgstr "le fichier d'essai n'a pas pu être écrit"

#: lib/python/Components/HdsEgalizator.py
msgid "o eroare neașteptată"
msgstr "une erreur inattendue"

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Probă din fișier, cu egalizator: %s. Proba merge și cu egalizatorul oprit."
msgstr "Essai depuis un fichier, avec égaliseur : %s. L'essai fonctionne même avec l'égaliseur désactivé."

#: lib/python/Components/HdsEgalizator.py
msgid "decodat în procesor"
msgstr "décodé dans le processeur"

#: lib/python/Screens/HdsEgalizator.py
msgid "Păstrezi schimbările?"
msgstr "Garder les modifications ?"

#: lib/python/Screens/HdsEgalizator.py
msgid "Pornit, sunetul posturilor de radio trece prin procesor și se aude cu reglajele de mai jos."
msgstr "Activé, le son des stations de radio passe par le processeur et s'entend avec les réglages ci-dessous."

#: lib/python/Screens/HdsEgalizator.py
msgid "Presetarea pune singură toate benzile; apoi le poți potrivi una câte una. Barele din spate: cât de tare se aude acum fiecare bandă."
msgstr "Le préréglage règle toutes les bandes ; tu peux ensuite les ajuster une par une. Les barres derrière : la force actuelle de chaque bande."

#: lib/python/Screens/HdsEgalizator.py
msgid "Modul de noapte: sunetele tari devin mai încete, cele încete mai tari. Potrivit seara, când asculți încet."
msgstr "Mode nuit : les sons forts baissent, les sons faibles montent. Utile le soir, quand tu écoutes doucement."

#: lib/python/Screens/HdsEgalizator.py
#, python-format
msgid "Da: reglajele de aici se țin minte numai pentru %s. Nu: postul folosește reglajele obișnuite, ale tuturor posturilor, pe care le vezi aici."
msgstr "Oui : les réglages d'ici sont gardés uniquement pour %s. Non : la station utilise les réglages habituels de toutes les stations, visibles ici."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. OK: pornești sau oprești. EXIT: ieși."
msgstr "Gauche et droite : choisir. OK : activer ou désactiver. EXIT : quitter."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. Sus, jos sau OK: presetarea următoare. EXIT: ieși."
msgstr "Gauche et droite : choisir. Haut, bas ou OK : préréglage suivant. EXIT : quitter."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. OK: da sau nu. EXIT: ieși."
msgstr "Gauche et droite : choisir. OK : oui ou non. EXIT : quitter."

#: lib/python/Screens/HdsEgalizator.py
msgid "Stânga și dreapta: alegi. Sus și jos: schimbi. OK: păstrezi și închizi."
msgstr "Gauche et droite : choisir. Haut et bas : modifier. OK : garder et fermer."

#: lib/python/Components/HdsEgalizator.py
msgid "La acest post (AAC) egalizatorul nu e disponibil din motive de licențiere a brevetelor AAC."
msgstr "Sur cette station (AAC), l'égaliseur n'est pas disponible pour des raisons de licence des brevets AAC."

#: lib/python/Components/HdsEgalizator.py
#, python-format
msgid "Postul acesta are sunet %s. Egalizatorul lucrează la posturile cu sunet MPEG (MP2)."
msgstr "Cette station a un son %s. L'égaliseur fonctionne sur les stations en son MPEG (MP2)."

