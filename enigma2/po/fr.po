#: lib/python/Plugins/Extensions/HdsWebControl/locuri_retea_web.py
msgid "Filme, muzică și înregistrări de pe calculatorul cu Windows, NAS, FTP, WebDAV sau serverul media din casă"
msgstr "Films, musique et enregistrements depuis l'ordinateur Windows, le NAS, FTP, WebDAV ou le serveur média de la maison"

