msgstr "Radijski tekst (RDS)"

msgid "Textul se trimite numai dintr-un browser asociat."
msgstr "Tekst se šalje samo iz uparenog preglednika."

msgid "Textul se trimite numai prin POST, din pagina „Navigator web”."
msgstr "Tekst se šalje samo metodom POST, sa stranice „Web preglednik“."

msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor spre serverul de la adresa pe care o scrii. Dacă serverul e în casa "
"ta, nimic nu iese din casă."
msgstr ""
"Tekst titlova (samo tekst, bez slike i bez zvuka) odlazi s prijamnika prema "
"poslužitelju na adresi koju upišeš. Ako je poslužitelj u tvojoj kući, ništa "
"ne izlazi iz kuće."

#, python-format
msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor, prin internet, spre %s, care îl traduce. Cheia ta rămâne pe "
"receptor."
msgstr ""
"Tekst titlova (samo tekst, bez slike i bez zvuka) odlazi iz prijamnika, "
"preko interneta, do %s, koji ga prevodi. Tvoj ključ ostaje na prijamniku."

#, python-format
msgid ""
"Textul subtitrărilor (numai textul, fără imagine și fără sunet) pleacă din "
"receptor, prin internet, spre serverul de la adresa scrisă de tine (%s), "
"care îl traduce."
msgstr ""
"Tekst titlova (samo tekst, bez slike i bez zvuka) odlazi iz prijamnika, "
"preko interneta, do servera na adresi koju si upisao (%s), koji ga prevodi."

#, python-format
msgid ""
"Textul subtitrărilor merge la serverul din casa ta (%s). Nimic nu iese din "
"casă."
msgstr ""
"Tekst titlova ide na poslužitelj u tvojoj kući (%s). Ništa ne izlazi iz kuće."

msgid "Textul tradus"
msgstr "Prevedeni tekst"

