msgstr "Lozinka korisnika root, ista za SSH i SFTP"

msgid "Parola nouă"
msgstr "Nova lozinka"

msgid ""
"Parola nouă e pusă. Merge pentru FTP, SSH și SFTP; cea veche nu mai merge."
msgstr ""
"Nova lozinka je postavljena. Radi za FTP, SSH i SFTP; stara više ne radi."

msgid "Parola nouă nu s-a putut face. Parola de dinainte rămâne."
msgstr "Novu lozinku nije bilo moguće stvoriti. Prethodna lozinka ostaje."

msgid ""
"Parola nouă pentru aplicații e făcută. O vezi cu butonul Arată; scrie-o în "
"aplicațiile pe care le folosești din afara casei."
msgstr ""
"Nova lozinka za aplikacije je napravljena. Vidiš je gumbom Prikaži; upiši je "
"u aplikacije koje koristiš izvan kuće."

#, python-format
msgid ""
"Parola nouă pentru aplicații: %s. Scrie-o în aplicațiile pe care le "
"folosești din afara casei."
msgstr ""
"Nova lozinka za aplikacije: %s. Upiši je u aplikacije koje koristiš izvan "
"kuće."

msgid "Parola nouă: 4-64 de semne, fără spații și fără diacritice"
msgstr "Nova lozinka: 4-64 znaka, bez razmaka i bez dijakritičkih znakova"

#, python-format
msgid "Parola nu este bună (cel mult %d semne, pe un singur rând)."
msgstr "Lozinka nije ispravna (najviše %d znakova, u jednom retku)."

msgid ""
"Parola nu s-a putut face. Alege „Fă o parolă”. Până atunci se intră numai cu "
"o cheie."
msgstr ""
"Lozinka se nije mogla napraviti. Odaberi „Napravi lozinku“. Do tada se ulazi "
"samo ključem."

msgid "Parola nu s-a putut pune. Parola de dinainte rămâne."
msgstr "Lozinku nije bilo moguće postaviti. Prethodna lozinka ostaje."

msgid ""
"Parola nu se arată: o scrii doar când vrei s-o schimbi. Un câmp de parolă "
"gol o lasă cum e."
msgstr ""
"Lozinka se ne prikazuje: upisuješ je samo kad je želiš promijeniti. Prazno "
"polje lozinke ostavlja je kako jest."

msgid "Parola nu se mai arată. Dacă ai uitat-o, fă una nouă."
msgstr "Lozinka se više ne prikazuje. Ako je zaboraviš, napravi novu."

msgid ""
"Parola nu se vede aici. Alege „Schimbă parola” și pune una nouă: de atunci "
"se vede oricând."
msgstr ""
"Lozinka se ovdje ne vidi. Odaberi „Promijeni lozinku“ i postavi novu: od "
"tada je vidljiva u svakom trenutku."

msgid "Parola pentru aplicații e greșită."
msgstr "Lozinka za aplikacije je pogrešna."

msgid ""
"Parola poate avea numai litere fără diacritice, cifre și semne, fără spații."
msgstr ""
"Lozinka može sadržavati samo slova bez dijakritičkih znakova, znamenke i "
"znakove, bez razmaka."

