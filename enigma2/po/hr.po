msgstr "Na %s nisam pronašao nijedan %s tok."

#, python-format
msgid "Pe %s nu am găsit niciun post DAB+."
msgstr "Na %s nisam našao nijednu DAB+ postaju."

#, python-format
msgid "Pe %s nu am găsit niciun program DVB-T2."
msgstr "Na %s nisam našao nijedan DVB-T2 kanal."

