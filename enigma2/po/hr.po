msgstr ""
"Prednji zaslon prikazuje naizmjence vrijeme, kanal, signal i preko stotinu "
"drugih podataka."

msgid "Afișajul e al canalului de pe televizor, nu al acestui canal"
msgstr "Zaslon pripada kanalu na televizoru, a ne ovom kanalu"

msgid "Afișajul nu primește textul. Repornește receptorul."
msgstr "Zaslon ne prima tekst. Ponovno pokreni prijamnik."

msgid "Afișajul pornește după ce receptorul termină pornirea."
msgstr "Zaslon se uključuje nakon što prijamnik završi pokretanje."

msgid "Afișajul receptorului"
msgstr "Zaslon prijamnika"

msgid "Afișajul rămâne stins."
msgstr "Zaslon ostaje isključen."

msgid "Afișarea"
msgstr "Prikaz"

