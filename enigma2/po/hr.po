#, python-format
msgid "Afișajul arată acum: %s."
msgstr "Zaslon sada prikazuje: %s."

msgid "Afișajul arată din nou lista salvată."
msgstr "Zaslon ponovno prikazuje spremljeni popis."

msgid "Afișajul arată lista de pe pagină. Nu e salvată încă."
msgstr "Zaslon prikazuje popis sa stranice. Još nije spremljen."

msgid ""
"Afișajul din fața receptorului are 4 cifre. Alege ce arată când receptorul "
"este pornit și când este în așteptare."
msgstr ""
"Zaslon na prednjoj strani prijamnika ima 4 znamenke. Odaberi što prikazuje "
"kad je prijamnik uključen i kad je u stanju pripravnosti."

msgid ""
"Afișajul din fața receptorului are 4 cifre. Alegerile bifate trec pe rând, "
"fiecare cât ai ales; un text lung se derulează. Mesajele scurte trec în fața "
"listei câteva secunde. Aceleași alegeri sunt pe televizor, în %s."
msgstr ""
"Prednji zaslon prijamnika ima 4 znamenke. Označeni odabiri se izmjenjuju, "
"svaki onoliko koliko si odabrao; dugi tekst se pomiče. Kratke poruke idu "
"ispred popisa nekoliko sekundi. Isti odabiri su na televizoru, u %s."

msgid ""
"Afișajul din fața receptorului are 4 cifre. Ora se arată fără cele două "
"puncte: 2105 înseamnă 21:05. Numărul canalului este cel din lista de canale; "
"când canalul nu are număr în listă, se arată ora. Aceleași setări sunt pe "
"televizor, în %s."
msgstr ""
"Zaslon na prednjoj strani prijamnika ima 4 znamenke. Vrijeme se prikazuje "
"bez dvotočke: 2105 znači 21:05. Broj kanala je onaj s popisa kanala; kad "
"kanal nema broj na popisu, prikazuje se vrijeme. Iste postavke su na "
"televizoru, u %s."

msgid "Afișajul din față"
msgstr "Prednji zaslon"

msgid ""
"Afișajul din față arată pe rând ora, canalul, semnalul și peste o sută de "
