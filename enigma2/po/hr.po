msgid "„%s”"
msgstr "„%s“"

#, python-format
msgid ""
"„%s” a fost scos din folosință. Fișierul se șterge la următoarea pornire."
msgstr ""
"„%s” je izbačen iz upotrebe. Datoteka se briše pri sljedećem pokretanju."

#, python-format
msgid "„%s” curățat: %d fișiere șterse, %s eliberați."
msgstr "„%s” očišćeno: %d datoteka izbrisano, %s oslobođeno."

#, python-format
msgid "„%s” descărcat (%s), licență %s, folosibil în skin ca %s."
msgstr "„%s” preuzet (%s), licenca %s, u skinu upotrebljiv kao %s."

#, python-format
msgid "„%s” era deja oprită."
msgstr "„%s” je već bilo zaustavljeno."

#, python-format
msgid "„%s” era deja pornită."
msgstr "„%s” je već bilo pokrenuto."

msgid "„%s” este conectat, dar nu este ales pentru înregistrări."
msgstr "„%s“ je povezan, ali nije odabran za snimanja."

msgid "„%s” este conectat, dar receptorul nu îl poate citi."
msgstr "„%s“ je povezan, ali ga prijamnik ne može pročitati."

#, python-format
msgid "„%s” este pus acum."
msgstr "„%s” je sada postavljen."

#, python-format
msgid ""
"„%s” merge acum. Ca s-o oprești, șterge-o din listă; ce s-a înregistrat până "
"acum rămâne."
msgstr ""
"„%s” sada radi. Da bi ga zaustavio, izbriši ga s popisa; ono što je dosad "
"snimljeno ostaje."

#, python-format
msgid "„%s” nu merge acum. Reîncarcă pagina."
msgstr "„%s” sada ne radi. Ponovno učitaj stranicu."

msgid ""
"„%s” nu poate fi citit de receptor. Formatează-l pe un calculator ca FAT32 "
"(se șterge tot de pe el)."
msgstr ""
"Prijamnik ne može pročitati „%s”. Formatiraj ga na računalu kao FAT32 (time "
"se briše sve s njega)."

#, python-format
msgid ""
"„%s” nu poate fi citit de receptor. Îl poți formata aici sau pe un "
"calculator, ca FAT32. Formatarea șterge tot de pe el."
msgstr ""
"Prijamnik ne može pročitati „%s”. Možeš ga formatirati ovdje ili na "
"računalu, kao FAT32. Formatiranje briše sve s njega."

#, python-format
msgid ""
"„%s” nu se găsește în depozitul liber google/fonts: licență neconfirmată, nu "
"se descarcă."
msgstr ""
"„%s” nije u slobodnom repozitoriju google/fonts: licenca nije potvrđena, ne "
"preuzima se."

msgid "„%s” nu se poate folosi: %s."
msgstr "„%s“ ne može se koristiti: %s."

#, python-format
msgid "„%s” se alege cu 1 (da) sau 0 (nu)."
msgstr "„%s” se odabire s 1 (da) ili 0 (ne)."

msgid "„%s”, liber %s din %s"
msgstr "„%s”, slobodno %s od %s"

msgid "„%s”: aici se salvează acum"
msgstr "„%s“: ovdje se sada sprema"

msgid "„%s”: aici se vor salva"
msgstr "„%s”: ovdje će se spremati"

msgid ""
"„Adresă proprie” (alt serviciu, cu adresa lui) și toate celelalte setări "
"sunt pe pagina cu toate setările:"
msgstr ""
"„Vlastita adresa“ (druga usluga, s njezinom adresom) i sve ostale postavke "
"nalaze se na stranici sa svim postavkama:"

msgid ""
"„Adresă proprie” e pentru un server de traducere ales de tine, de exemplu un "
"LibreTranslate pornit pe un calculator din casă. Receptorul trimite fiecare "
"rând de subtitrare într-o cerere separată."
msgstr ""
"„Vlastita adresa” je za server za prijevod koji sam odabereš, na primjer "
"LibreTranslate pokrenut na računalu kod kuće. Prijamnik šalje svaki redak "
"titla u zasebnom zahtjevu."

msgid "„Ca la calculator” revine la următoarea pornire a receptorului."
msgstr "„Kao na računalu” vraća se pri sljedećem pokretanju prijamnika."

msgid ""
"„Ca la calculator” revine numai după o repornire. Repornești receptorul acum?"
msgstr ""
"„Kao na računalu” vraća se tek nakon restarta. Pokrećeš li sada ponovno "
"prijamnik?"

msgid ""
"„Ca la calculator” se aplică la următoarea pornire; pe unele televizoare "
"imaginea iese spălăcită pe 60 Hz."
msgstr ""
"„Kao na računalu” primjenjuje se pri sljedećem pokretanju; na nekim "
"televizorima slika na 60 Hz izgleda isprano."

msgid ""
"„Ca la calculator” se aplică numai după o repornire. Repornești receptorul "
"acum?"
msgstr ""
"„Kao na računalu” vrijedi tek nakon restarta. Pokrećeš li sada ponovno "
"prijamnik?"

msgid ""
"„Enigma” și „Dreambox” sunt mărci ale Dream Property GmbH; celelalte nume de "
"produse aparțin deținătorilor lor."
msgstr ""
"„Enigma“ i „Dreambox“ zaštitni su znakovi tvrtke Dream Property GmbH; ostala "
"imena proizvoda pripadaju njihovim vlasnicima."

msgid ""
"„Folosește pentru înregistrări” face pe disc dosarul movie, dacă lipsește. "
"Nu se șterge și nu se formatează nimic."
msgstr ""
"„Koristi za snimanja“ stvara na disku mapu movie, ako nedostaje. Ništa se ne "
"briše i ništa se ne formatira."

msgid "„Fără subtitrări niciodată” se alege cu 1 (da) sau 0 (nu)."
msgstr "„Nikada ne prikazuj titlove” odabire se s 1 (da) ili 0 (ne)."

msgid ""
"„Redenumește” schimbă numele numai în acest buchet. „Redenumește peste tot” "
"îl schimbă în lista receptorului."
msgstr ""
"„Preimenuj“ mijenja ime samo u ovom buketu. „Preimenuj svugdje“ mijenja ga "
"na popisu prijamnika."

msgid "„Standby” pornește automat fără nicio înregistrare activă."
msgstr "„Standby“ se automatski uključuje kada nema aktivnog snimanja."

msgid "„pornit” se alege cu 1 (da) sau 0 (nu)."
msgstr "„uključeno” se odabire s 1 (da) ili 0 (ne)."

