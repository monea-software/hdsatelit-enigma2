msgstr ""
"Dok je zaslon „SSH pristup“ otvoren na televizoru, daljinski upravljač i "
"snimka zaslona rade samo iz preglednika povezanog kodom s televizora."

msgid ""
"Cât ecranul „Parola receptorului” e deschis pe receptor, telecomanda și "
"captura de ecran merg numai dintr-un browser conectat cu codul de pe "
"televizor."
msgstr ""
"Dok je zaslon „Lozinka prijamnika“ otvoren na prijamniku, daljinski "
"upravljač i snimka zaslona rade samo iz preglednika spojenog kodom s "
"televizora."

msgid "Cât lucrează procesorul, în procente"
msgstr "Opterećenje procesora, u postocima"

msgid "Cât mai e din film"
msgstr "Koliko je još ostalo od filma"

msgid ""
