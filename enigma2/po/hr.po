msgid ""
"<code>GET /api/accel</code>: accelerarea 2D pe placa video: dacă receptorul "
"o are (<code>disponibila</code>), setarea pentru următoarea pornire "
"(implicit pornită) și ce s-a hotărât la pornirea de acum"
msgstr ""
"<code>GET /api/accel</code>: 2D ubrzanje na grafičkoj kartici: ima li ga "
"prijamnik (<code>disponibila</code>), postavka za sljedeće pokretanje (prema "
"zadanim postavkama uključeno) i što je odlučeno pri trenutnom pokretanju"

msgid ""
"<code>GET /api/acces-canal</code>: accesul canalului care rulează (criptat "
"sau liber), sistemele, CAID-urile și ce decriptează modulul acum"
msgstr ""
"<code>GET /api/acces-canal</code>: pristup kanalu koji radi (kodiran ili "
"slobodan), sustavi, CAID-ovi i što modul sada dekriptira"

msgid ""
"<code>GET /api/acces-conditionat</code>: modulele de acces condiționat pe "
"feluri (câmpul <code>fel</code>: numele felului, așa cum îl are receptorul; "
"întâi modulele obișnuite, apoi serverele de carduri), cel ales la pornirea "
"receptorului, cele care rulează, procesul care lucrează și memoria lui, "
"comanda în curs sau ultimul rezultat, dacă receptorul decriptează acum"
msgstr ""
"<code>GET /api/acces-conditionat</code>: moduli uvjetnog pristupa po vrstama "
"(polje <code>fel</code>: naziv vrste, onako kako ga ima prijamnik; najprije "
"uobičajeni moduli, zatim poslužitelji kartica), onaj odabran pri pokretanju "
"prijamnika, oni koji rade, proces koji radi i njegova memorija, naredba u "
"tijeku ili posljednji rezultat, dekriptira li prijamnik sada"

msgid ""
"<code>GET /api/acces-ssh</code>: intrarea pe receptor prin SSH: felul "
"parolei de administrator (fără parola însăși), cheile SSH (tipul, amprenta, "
"comentariul), „Fără parolă în rețeaua locală”, stările periculoase "
"(<code>alarme</code>), lucrarea în curs și rezultatul ultimei comenzi"
msgstr ""
"<code>GET /api/acces-ssh</code>: pristup prijamniku putem SSH-a: vrsta "
"administratorske lozinke (bez same lozinke), SSH ključevi (tip, otisak, "
"komentar), „Bez lozinke u lokalnoj mreži“, opasna stanja (<code>alarme</"
"code>), posao u tijeku i rezultat posljednje naredbe"

msgid ""
"<code>GET /api/acces-ssh</code>: parola receptorului (FTP, SSH și SFTP): "
"felul parolei lui root (fără parola însăși), dacă merge FTP (<code>ftp</"
"code>), cheile SSH (tipul, amprenta, comentariul), opțiunea Fără parolă în "
"rețeaua locală, stările periculoase (<code>alarme</code>), lucrarea în curs "
"și rezultatul ultimei comenzi"
msgstr ""
"<code>GET /api/acces-ssh</code>: lozinka prijamnika (FTP, SSH i SFTP): vrsta "
"root lozinke (bez same lozinke), radi li FTP (<code>ftp</code>), SSH "
"ključevi (vrsta, otisak, komentar), „Bez lozinke u lokalnoj mreži”, opasna "
"stanja (<code>alarme</code>), zadatak u tijeku i rezultat zadnje naredbe"

