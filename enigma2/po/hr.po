msgid "Stânga"
msgstr "Lijevo"

msgid ""
"Stânga / Dreapta trec dintr-o coloană în alta. În sursă, OK pe un canal îl "
"adaugă la sfârșitul buchetului din dreapta (pe un satelit sau furnizor, OK "
"îl deschide). Cifrele scriu numele canalului ca la SMS; TEXT deschide "
"tastatura de pe ecran. Albastru: filtrele (HD, FTA, limba sunetului, "
"subtitrări...)."
msgstr ""
"Lijevo / Desno prebacuju između stupaca. U izvoru OK na kanalu dodaje ga na "
"kraj buketa s desne strane (na satelitu ili davatelju OK ga otvara). "
"Znamenke pišu naziv kanala kao u SMS-u; TEXT otvara tipkovnicu na zaslonu. "
"Plavo: filtri (HD, FTA, jezik zvuka, titlovi...)."

msgid "Stânga și Dreapta aleg tema"
msgstr "Lijevo i Desno odabiru temu"

msgid "Stânga și Dreapta schimbă fila"
msgstr "Lijevo i Desno mijenjaju karticu"

msgid "Stânga și Dreapta schimbă grupa. Jos intri la ecrane."
msgstr "Lijevo i Desno mijenjaju grupu. Dolje ulaziš u zaslone."

#, python-format
msgid ""
"Stânga și Dreapta schimbă mărimea cu câte %(pas)s. Proba de deasupra se "
"schimbă pe loc. Verde salvează: noua mărime se vede în ecranele pe care le "
"deschizi după aceea. Galben pune înapoi mărimea din fabrică, %(implicit)s."
msgstr ""
"Lijevo i Desno mijenjaju veličinu u koracima od %(pas)s. Prikaz iznad "
"mijenja se odmah. Zeleno sprema: novu veličinu vidjet ćeš na zaslonima koje "
"otvoriš nakon toga. Žuto vraća tvorničku veličinu, %(implicit)s."

msgid "Stânga și dreapta schimbă alegerea. OK salvează, EXIT renunță."
msgstr "Lijevo i desno mijenjaju izbor. OK sprema, EXIT odustaje."

msgid ""
"Stânga și dreapta schimbă câte un minut; cu cifrele se scrie ora direct."
msgstr ""
"Lijevo i desno mijenjaju po jednu minutu; brojkama se vrijeme upisuje "
"izravno."

msgid ""
"Stânga și dreapta schimbă valoarea, OK deschide lista. Fraza de jos arată "
"subtitrările text așa cum vor fi."
msgstr ""
"Lijevo i desno mijenjaju vrijednost, OK otvara popis. Rečenica dolje "
"prikazuje tekstualne titlove onako kako će izgledati."

msgid "Stânga și dreapta: alegi. OK: da sau nu. EXIT: ieși."
msgstr "Lijevo i desno: odabireš. OK: da ili ne. EXIT: izlaziš."

msgid "Stânga și dreapta: alegi. OK: pornești sau oprești. EXIT: ieși."
msgstr ""
"Lijevo i desno: odabireš. OK: uključuješ ili isključuješ. EXIT: izlaziš."

msgid "Stânga și dreapta: alegi. Sus și jos: schimbi. OK: păstrezi și închizi."
msgstr ""
"Lijevo i desno: odabireš. Gore i dolje: mijenjaš. OK: zadržavaš i zatvaraš."

msgid ""
"Stânga și dreapta: alegi. Sus, jos sau OK: presetarea următoare. EXIT: ieși."
msgstr ""
"Lijevo i desno: odabireš. Gore, dolje ili OK: sljedeća predpostavka. EXIT: "
"izlaziš."

msgid ""
"Stânga/Dreapta alegi sau treci în cealaltă coloană · OK pornești sau oprești"
msgstr ""
"Lijevo/Desno biraš ili prelaziš u drugi stupac · OK uključuje ili isključuje"

msgid "Stânga/Dreapta alegi · OK pornești sau oprești · Jos mai departe"
msgstr "Lijevo/Desno biraš · OK uključuje ili isključuje · Dolje dalje"

msgid "Stânga/Dreapta: alt fișier · Sus/Jos: derulare · OK sau EXIT: înapoi"
msgstr "Lijevo/Desno: drugi zapis · Gore/Dolje: pomak · OK/EXIT: natrag"

msgid ""
"Stânga/Dreapta: alt fișier · Sus/Jos: derulare · OK: pe scurt · EXIT: înapoi"
msgstr ""
"Lijevo/Desno: druga datoteka · Gore/Dolje: pomicanje · OK: ukratko · EXIT: "
"natrag"

msgid ""
"Stânga/Dreapta: un pas   Sus/Jos: mărimea pasului   4/6: mișcare fără "
"oprire   OK: oprire   EXIT: ieșire"
msgstr ""
"Lijevo/Desno: jedan korak   Gore/Dolje: veličina koraka   4/6: neprekidno "
"kretanje   OK: zaustavi   EXIT: izlaz"

msgid ""
"Sub fiecare canal: câte rețele sunt chiar pe el. Înălțimea barei arată cât e "
"de încărcat, cu rețelele de pe canalele vecine (un canal se suprapune cu "
"câte 4 de fiecare parte) și cu cât de tare e semnalul lor. Rețeaua ta nu "
"intră în socoteală."
msgstr ""
"Ispod svakog kanala: koliko je mreža izravno na njemu. Visina trake pokazuje "
"koliko je opterećen, s mrežama na susjednim kanalima (kanal se preklapa s po "
"4 sa svake strane) i koliko je jak njihov signal. Tvoja se mreža ne računa."

