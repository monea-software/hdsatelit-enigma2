msgid "Ce am găsit și ce am făcut"
msgstr "Što smo pronašli i što smo učinili"

msgid "Mulțumim că ne-ai lăsat să te ajutăm."
msgstr "Hvala što smo ti mogli pomoći."

msgid "Ultimele concluzii"
msgstr "Posljednji zaključci"

msgid "concluziile echipei (ce am găsit și ce am făcut), arătate pe receptor până apeși OK"
msgstr "zaključci tima (što smo pronašli i što smo učinili), prikazani na prijamniku dok ne pritisneš OK"

msgid "Accept <a href=\"#\" id=\"termeni\">termenii și condițiile</a>"
msgstr "Prihvaćam <a href=\"#\" id=\"termeni\">uvjete korištenja</a>"

msgid "Accept termenii și condițiile"
msgstr "Prihvaćam uvjete korištenja"

msgid "Cu rândul bifat, Start confirmă că ești de acord cu aceste condiții și că ai cel puțin 16 ani sau acordul unui părinte."
msgstr "S označenim retkom, Pokreni potvrđuje da se slažeš s ovim uvjetima i da imaš najmanje 16 godina ili pristanak roditelja."

msgid "Echipa HD Satelit vede prin internet starea receptorului tău, ca să te ajute, fără să schimbe nimic. O oprești oricând."
msgstr "Tim HD Satelit putem interneta vidi stanje tvog prijamnika kako bi ti pomogao, bez ikakvih promjena. Možeš je zaustaviti u svakom trenutku."

msgid "Fără bifă, asistența nu pornește."
msgstr "Bez kvačice pomoć se ne pokreće."

msgid "Nu pot deschide Asistența de la distanță pe receptor acum."
msgstr "Ne mogu sada otvoriti udaljenu pomoć na prijamniku."

msgid "OK pe rândul de sus: termenii și condițiile."
msgstr "OK na retku iznad: uvjeti korištenja."

msgid "Pe receptor s-a deschis Asistența de la distanță: apasă Start acolo."
msgstr "Na prijamniku se otvorila udaljena pomoć: tamo pritisni Pokreni."

msgid "Start"
msgstr "Pokreni"

msgid "Start o pornește pentru 2 ore. O oprești oricând, de pe receptor sau din pagina web. Cât e pornită, echipa poate intra oricând, dar face numai citirile și probele din lista fixă, fără să schimbe nimic."
msgstr "Pokreni je uključuje na 2 sata. Možeš je zaustaviti u svakom trenutku, na prijamniku ili na web stranici. Dok je uključena, tim se može spojiti u svakom trenutku, ali obavlja samo očitanja i provjere s fiksnog popisa, bez ikakvih promjena."

msgid "Termenii și condițiile"
msgstr "Uvjeti korištenja"

msgid "cerere trimisă, aștept echipa"
msgstr "zahtjev poslan, čekam tim"
