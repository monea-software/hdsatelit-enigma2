msgid ""
"Browserele intrate fără cod din rețeaua locală, și această pagină dacă ai "
"intrat fără cod, trebuie să încarce din nou pagina după schimbare."
msgstr ""
"Preglednici koji su ušli bez koda iz lokalne mreže, i ova stranica ako si "
"ušao bez koda, moraju ponovno učitati stranicu nakon promjene."

msgid ""
"Browserul a pornit imaginea fără sunet. Apasă ca să pornească și sunetul."
msgstr ""
"Preglednik je pokrenuo sliku bez zvuka. Pritisni za uključivanje i zvuka."

msgid ""
"Browserul acesta nu redă singur fluxuri DASH (.mpd). Deschide adresa de mai "
"jos într-un player care le redă, de pildă VLC (Media, Deschide flux din "
"rețea)."
msgstr ""
"Ovaj preglednik sam ne reproducira DASH streamove (.mpd). Otvori adresu u "
"nastavku u playeru koji ih reproducira, na primjer VLC (Media, Otvori mrežni "
"stream)."

msgid ""
"Browserul acesta nu redă singur fluxuri HLS (.m3u8). Deschide adresa de mai "
"jos într-un player care le redă, de pildă VLC (Media, Deschide flux din "
"rețea)."
msgstr ""
"Ovaj preglednik sam ne reproducira HLS streamove (.m3u8). Otvori adresu u "
"nastavku u playeru koji ih reproducira, na primjer VLC (Media, Otvori mrežni "
"stream)."

msgid "Browserul intră numai cu un cod de șase cifre arătat pe televizor."
msgstr ""
"Preglednik ulazi samo sa šesteroznamenkastim kodom prikazanim na televizoru."

msgid ""
"Browserul nu a putut deschide imaginea (n-a primit date pe care să le "
"înțeleagă)."
msgstr ""
"Preglednik nije mogao otvoriti sliku (nije dobio podatke koje bi razumio)."

msgid "Browserul nu cunoaște formatul imaginii sau al sunetului."
msgstr "Preglednik ne poznaje format slike ili zvuka."

msgid "Browserul nu mai e conectat la receptor."
msgstr "Preglednik više nije povezan s prijamnikom."

msgid ""
"Browserul nu poate reda imaginea acestui canal. Încearcă din nou sau "
"deschide-l într-un player din casă cu playlistul de mai jos."
msgstr ""
"Preglednik ne može reproducirati sliku ovog kanala. Pokušaj ponovno ili ga "
"otvori u playeru u kući s playlistom ispod."

msgid "Browserul nu poate reda imaginea acestui canal. Încearcă din nou."
msgstr "Preglednik ne može reproducirati sliku ovog kanala. Pokušaj ponovno."

msgid ""
"Browserul nu poate reda sunetul acestui canal. Încearcă din nou sau deschide-"
"l într-un player din casă cu playlistul de mai jos."
msgstr ""
"Preglednik ne može reproducirati zvuk ovog kanala. Pokušaj ponovno ili ga "
"otvori u playeru u kući s playlistom ispod."

msgid "Browserul nu poate reda sunetul acestui canal. Încearcă din nou."
msgstr "Preglednik ne može reproducirati zvuk ovog kanala. Pokušaj ponovno."

msgid ""
"Browserul tău e legat la receptor prin această placă. Adresa o va da "
"routerul și poate fi alta decât acum: o vezi pe televizor, la informațiile "
"despre rețea, sau în lista routerului."
msgstr ""
"Tvoj preglednik povezan je s prijamnikom preko ovog adaptera. Adresu će dati "
"usmjerivač i može biti drugačija nego sada: vidiš je na televizoru, u "
"informacijama o mreži, ili na popisu usmjerivača."

msgid ""
"Browserul tău e legat la receptor prin această placă. Când placa se oprește, "
"pagina nu mai răspunde până o pornești din nou de pe televizor."
msgstr ""
"Tvoj preglednik povezan je s prijamnikom preko ovog adaptera. Kad se adapter "
"isključi, stranica više ne odgovara dok ga ponovno ne uključiš s televizora."

#, python-format
msgid ""
"Browserul tău e legat la receptor prin această placă. După aplicare, pagina "
"va fi la %s."
msgstr ""
"Tvoj preglednik povezan je s prijamnikom preko ovog adaptera. Nakon "
"primjene, stranica će biti na %s."

msgid ""
"Browserul tău e legat la receptor prin ea: pagina nu va mai răspunde de aici."
msgstr ""
"Tvoj preglednik povezan je s prijamnikom preko njega: stranica više neće "
"odgovarati odavde."

