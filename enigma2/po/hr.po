msgstr ""
"<code>POST /api/import?sursa=&lt;id&gt;&amp;canale=1&amp;tunere=1&amp;"
"temporizatoare=0&amp;generale=0</code>: pokreće uvoz (najprije sigurnosna "
"kopija)"

msgid ""
"<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: schimbă limba "
"meniurilor și o salvează, ca OK în ecranul limbii de pe televizor"
msgstr ""
"<code>POST /api/limba-interfata-seteaza?limba=ro_RO</code>: mijenja jezik "
"izbornika i sprema ga, kao OK na ekranu za jezik na televizoru"

msgid ""
"<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;"
"fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</"
"code>: schimbă și salvează oricare dintre ele (valorile exacte sunt în "
"<code>/api/limbi</code>; <code>tradu_orice</code> = „Tradu automat din orice "
"subtitrare disponibilă”, contează cu traducerea subtitrărilor pornită) și le "
"aplică pe canalul de acum"
msgstr ""
"<code>POST /api/limbi-seteaza?audio1=..&amp;audio2=..&amp;audio3=..&amp;"
"fara_subtitrari=0|1&amp;sub1=..&amp;sub2=..&amp;sub3=..&amp;tradu_orice=0|1</"
"code>: mijenja i sprema bilo koji od njih (točne vrijednosti su u <code>/api/"
"limbi</code>; <code>tradu_orice</code> = „Automatski prevodi s bilo kojeg "
"dostupnog titla”, važno je s uključenim prevođenjem titlova) i primjenjuje "
"ih na trenutnom kanalu"

msgid ""
"<code>POST /api/limbi-uita?cheie=&lt;cheia canalului&gt;</code>, <code>POST /"
