msgid ""
"Parola acestui loc nu este salvată pe receptor. Scrie-o din nou la Editează."
msgstr ""
"Lozinka ovog mjesta nije spremljena na prijamniku. Upiši je ponovno pod "
"Uredi."

msgid "Parola are prea multe semne: cel mult %d."
msgstr "Lozinka ima previše znakova: najviše %d."

msgid "Parola are prea puține semne: cel puțin %d."
msgstr "Lozinka ima premalo znakova: najmanje %d."

msgid "Parola contului VPN (după salvare nu se mai arată)"
msgstr "Lozinka VPN računa (nakon spremanja više se ne prikazuje)"

