msgstr ""
"Prijevod se pojavljuje umjesto originala ili ispod njega, s izgledom iz "
"„Izgled titlova”."

msgid "Traducerea automată"
msgstr "Automatski prijevod"

msgid ""
"Traducerea automată a subtitrărilor în limba ta: teletext, DVB și fișiere."
msgstr ""
"Automatsko prevođenje titlova na tvoj jezik: teletekst, DVB i datoteke."

msgid "Traducerea care întârzie"
msgstr "Zakašnjeli prijevod"

msgid "Traducerea e pornită; pe televizor a apărut confirmarea."
msgstr "Prijevod je uključen; na televizoru se pojavila potvrda."

msgid "Traducerea nu are un serviciu gata: Meniu, Traducerea subtitrărilor"
msgstr "Prijevod nema spremnu uslugu: Izbornik, Prijevod titlova"

msgid ""
