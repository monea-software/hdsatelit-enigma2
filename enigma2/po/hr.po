msgstr "Lozinka prijamnika"

msgid "Parola rețelei"
msgstr "Lozinka mreže"

msgid ""
"Parola rămâne pusă, dar nu se mai arată aici și nici în interfața web. Dacă "
"o uiți, faci una nouă."
msgstr ""
"Lozinka ostaje postavljena, ali se više ne prikazuje ovdje ni u web sučelju. "
"Ako je zaboraviš, napravi novu."

msgid "Parola salvată: da."
msgstr "Spremljena lozinka: da."

msgid "Parola salvată: nu."
msgstr "Spremljena lozinka: ne."

msgid ""
"Parola se vede numai dintr-un browser conectat cu codul de pe televizor."
msgstr "Lozinka se vidi samo iz preglednika povezanog kodom s televizora."

msgid "Parola și cheia se văd numai dintr-un browser."
msgstr "Lozinka i ključ vide se samo iz preglednika."

msgid ""
"Parola și cheile se văd și se schimbă numai dintr-un browser conectat cu "
"codul de pe televizor."
msgstr ""
"Lozinka i ključevi vide se i mijenjaju samo iz preglednika povezanog kodom s "
"televizora."

msgid ""
"Parola și cheile se văd și se schimbă numai dintr-un browser conectat cu "
"codul de pe televizor. Așa, cine e doar în rețeaua ta de acasă nu le poate "
"afla."
msgstr ""
"Lozinka i ključevi vide se i mijenjaju samo iz preglednika povezanog kodom s "
"televizora. Tako ih onaj tko je samo u tvojoj kućnoj mreži ne može saznati."

msgid ""
"Parolele și cheile numai se scriu sau se șterg aici; nu se mai arată. Un "
"câmp lăsat gol nu schimbă nimic. Folosește pentru OpenSubtitles o parolă pe "
"care nu o mai folosești în altă parte. Numele de utilizator, nu adresa de e-"
"mail."
msgstr ""
"Lozinke i ključevi ovdje se samo upisuju ili brišu; više se ne prikazuju. "
"Polje ostavljeno prazno ništa ne mijenja. Za OpenSubtitles koristi lozinku "
"koju ne koristiš nigdje drugdje. Korisničko ime, ne adresa e-pošte."

#, python-format
msgid ""
"Parolă greșită de %d ori de la %s (%s): am oprit cererile ei pentru %d "
