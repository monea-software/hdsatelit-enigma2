msgstr "Ime izvora: mala slova, znamenke i -"

msgid "Numele telecomenzii"
msgstr "Naziv daljinskog upravljača"

msgid "Numele telecomenzii nu poate fi gol."
msgstr "Naziv daljinskog upravljača ne može biti prazan."

msgid "Numele tău pe forum"
msgstr "Forum prijamnika"

msgid "Numele tău pe forum e acum „%s”."
msgstr "Tvoje ime na forumu sada je „%s“."

msgid "Numele și parola au fost șterse de pe receptor."
msgstr "Ime i lozinka izbrisani su s prijamnika."

msgid "Numele și parola contului"
msgstr "Ime i lozinka računa"

msgid ""
"Numele și parola contului HMA. După salvare nu se mai arată nicăieri. Se "
"scriu mai ușor din telefon, în interfața web."
msgstr ""
"Ime i lozinka HMA računa. Nakon spremanja više se nigdje ne prikazuju. Lakše "
"ih je upisati s telefona, u web sučelju."

msgid "Numele și parola de serviciu"
msgstr "Servisno ime i lozinka"

msgid "Numele și parola din fișier nu se folosesc: se scriu pe receptor."
msgstr "Ime i lozinka iz datoteke ne koriste se: upisuju se na prijamniku."

msgid "Numele și parola sunt salvate. Nu se mai arată nicăieri."
msgstr "Ime i lozinka su spremljeni. Više se nigdje ne prikazuju."

msgid "Numele, cu tastatura de pe ecran"
msgstr "Dodaj sve u buket"

msgid "Numele, cu tastele 0-9"
msgstr "Naziv, tipkama 0-9"

msgid ""
"Numerele DVB ale fluxului (pentru siglă): SID, TSID, ONID, namespace (hex)"
msgstr "DVB brojevi streama (za logotip): SID, TSID, ONID, namespace (hex)"

msgid "Număr de fișiere"
msgstr "Broj datoteka"

msgid "Numărate de la ora"
msgstr "Brojano od"

msgid "Numărul canalului"
msgstr "Broj kanala"

msgid "Numărul canalului din lista de canale."
msgstr "Broj kanala s popisa kanala."

#, python-format
msgid "Numărul copiilor păstrate trebuie să fie între 1 și %d."
msgstr "Broj čuvanih kopija mora biti između 1 i %d."

msgid "Numărul de bare"
msgstr "Broj traka"

msgid "Numărul de secunde nu este bun."
msgstr "Broj sekundi nije ispravan."

msgid "Numărul din lista de canale, cel la care duc cifrele telecomenzii."
msgstr "Broj s popisa kanala, onaj do kojeg vode brojke daljinskog."

msgid ""
"Numărul mare nu înseamnă procesor ocupat: include firele driverelor care "
"așteaptă."
msgstr ""
"Velik broj ne znači zauzet procesor: uključuje niti upravljačkih programa "
"koje čekaju."

msgid "Numărul operatorului"
msgstr "Broj operatora"

msgid "Numărul poziției (1-255)"
msgstr "Broj pozicije (1-255)"

#, python-format
msgid "Numărul procesului (PID): %s"
msgstr "Broj procesa (PID): %s"

msgid "Numărul rețelei (ONID)"
msgstr "Broj mreže (ONID)"

msgid "Numărul transponderului (TSID)"
msgstr "Broj transpondera (TSID)"

msgid "Numărul și numele"
msgstr "Broj i naziv"

msgid "Numărătoarea opririlor"
msgstr "Brojač zaustavljanja"

msgid ""
"O adresă http:// merge numai pentru un server din rețeaua de acasă (de "
"exemplu 192.168.1.50); pentru un server de pe internet scrie https://."
msgstr ""
"Adresa http:// radi samo za poslužitelj u kućnoj mreži (na primjer "
"192.168.1.50); za poslužitelj na internetu upiši https://."

msgid ""
"O altă placă e deja configurată. Pe televizor, aceeași întrebare apare la OK."
msgstr ""
"Druga mrežna kartica je već konfigurirana. Na televizoru se isto pitanje "
"pojavljuje na OK."

msgid "O altă schimbare a rețelei încă lucrează. Așteaptă să se termine."
msgstr "Još traje druga promjena mreže. Pričekaj da završi."

msgid "O altă schimbare de LNB așteaptă confirmarea."
msgstr "Druga promjena LNB-a čeka potvrdu."

msgid "O altă valoare a receptorului nu se potrivește."
msgstr "Druga vrijednost prijamnika se ne podudara."

msgid "O captură aleasă nu mai există. Alege din nou."
msgstr "Odabrana snimka više ne postoji. Odaberi ponovno."

msgid ""
"O cheie pleacă numai pe https:// sau spre un server din rețeaua de acasă. "
"Scrie adresa cu https://. Cheia nu a plecat nicăieri."
msgstr ""
"Ključ se šalje samo preko https:// ili na server u kućnoj mreži. Napiši "
"adresu s https://. Ključ nije nigdje poslan."

msgid "O conectare Wi-Fi încă lucrează. Așteaptă să se termine sau oprește-o."
msgstr ""
"Povezivanje s Wi-Fi mrežom još je u tijeku. Pričekaj da završi ili ga "
"zaustavi."

msgid "O copie așteaptă să fie pusă la loc la repornirea interfeței."
msgstr "Kopija čeka da bude vraćena pri ponovnom pokretanju sučelja."

msgid "O copie se face deja. Așteaptă să se termine."
msgstr "Kopija se već stvara. Pričekaj da završi."

msgid ""
"O copie se face singură înainte de fiecare salvare, aici și în interfața "
"web. Întoarcerea pune întâi lista de acum într-o copie nouă."
msgstr ""
"Kopija se sama radi prije svakog spremanja, ovdje i u web sučelju. Vraćanje "
"prvo sprema trenutačni popis u novu kopiju."

msgid "O cutie pentru toate rândurile"
msgstr "Jedna kutija za sve retke"

msgid ""
"O căutare e deja în curs pe receptor. Așteaptă să se termine sau oprește-o."
msgstr ""
"Pretraživanje je već u tijeku na prijamniku. Pričekaj da završi ili ga "
"zaustavi."

msgid "O căutare e deja în curs."
msgstr "Pretraživanje već traje."

msgid "O căutare sau o descărcare merge deja; așteaptă să se termine."
msgstr "Pretraživanje ili preuzimanje već radi; pričekaj da završi."

msgid ""
"O data pe zi, in fundal, receptorul ia de pe stb.hdsatelit.com frecventele "
"si numele posturilor. Butonul Actualizeaza lista merge oricand."
msgstr ""
"Jednom dnevno, u pozadini, prijamnik preuzima sa stb.hdsatelit.com "
"frekvencije i nazive postaja. Gumb Ažuriraj popis radi u bilo koje vrijeme."

msgid "O dată pe minut"
msgstr "Jednom u minuti"

msgid "O dată pe săptămână"
msgstr "Jednom tjedno"

msgid ""
"O dată pe zi, noaptea, numai felurile bifate, și imediat după o oprire "
"neașteptată a interfeței sau o actualizare care nu a reușit. Fără bifă "
"pleacă numai ce trimiți tu cu „Trimite acum”."
msgstr ""
"Jednom dnevno, noću, samo označene vrste, i odmah nakon neočekivanog "
"zaustavljanja sučelja ili neuspjelog ažuriranja. Bez oznake šalje se samo "
"ono što sam pošalješ pomoću „Pošalji sada“."

msgid ""
"O dată pe zi, în fundal, receptorul ia de pe stb.hdsatelit.com frecvențele "
"și numele posturilor. Butonul „Actualizează lista” merge oricând. <span "
"id=\"ultimaZilnica\"></span>"
msgstr ""
"Jednom dnevno, u pozadini, prijamnik preuzima sa stb.hdsatelit.com "
"frekvencije i imena postaja. Gumb „Ažuriraj popis” radi u bilo kojem "
"trenutku. <span id=\"ultimaZilnica\"></span>"

msgid "O eroare pe receptor."
msgstr "Greška na prijamniku."

msgid "O greșeală, o idee sau o întrebare, direct echipei."
msgstr "Greška, ideja ili pitanje, izravno timu."

msgid "O lipești, iar receptorul recunoaște singur serviciul."
msgstr "Zalijepiš je, a prijamnik sam prepoznaje uslugu."

msgid ""
"O listă de redare de pe disc nu se poate șterge din player, nici pe "
"televizor."
msgstr ""
"Popis za reprodukciju s diska ne može se izbrisati iz playera, čak ni na "
"televizoru."

msgid "O margine e între 0 și 5 la sută din latura ei."
msgstr "Margina je između 0 i 5 posto svoje strane."

msgid "O notă despre emisiune. OK deschide tastatura."
msgstr "Bilješka o emisiji. OK otvara tipkovnicu."

msgid "O pagină mai jos"
msgstr "Stranicu dolje"

msgid "O pagină mai sus"
msgstr "Stranicu gore"

msgid "O pagină în jos"
msgstr "Stranicu dolje"

msgid "O pagină în sus"
msgstr "Stranicu gore"

msgid ""
"O poză nu a putut fi urcată: trebuie să fie JPG sau PNG, de cel mult 4 MB."
msgstr "Slika se nije mogla učitati: mora biti JPG ili PNG, najviše 4 MB."

msgid "O poți instala din nou oricând, din aceeași sursă."
msgstr "Možeš ga ponovno instalirati bilo kada, iz istog izvora."

msgid "O probă DiSEqC e deja deschisă pe televizor. Închide-o întâi."
msgstr "DiSEqC test već je otvoren na televizoru. Prvo ga zatvori."

msgid "O reîmprospătare e deja în lucru."
msgstr "Osvježavanje je već u tijeku."

msgid "O reîncărcare e deja în curs."
msgstr "Ponovno učitavanje već traje."

msgid ""
"O scanare DAB+ sau DVB-T2 e deschisă pe televizor. Așteaptă să se termine "
"sau oprește-o."
msgstr ""
"Na televizoru je otvoreno skeniranje DAB+ ili DVB-T2. Pričekaj da završi ili "
"ga zaustavi."

msgid "O singură dată"
msgstr "Jednom"

msgid ""
"O singură dată sau repetat: în fiecare zi, o dată pe săptămână, de luni până "
"vineri sau în zilele alese."
msgstr ""
"Jednom ili ponavljano: svaki dan, jednom tjedno, od ponedjeljka do petka ili "
"u odabranim danima."

msgid "O singură limbă: forumul traduce singur."
msgstr "Jedan jezik: forum sam prevodi."

msgid ""
"O telecomandă USB (sau o tastatură) se bagă în receptor înainte; se vede "
"imediat."
msgstr ""
"USB daljinski upravljač (ili tipkovnicu) najprije priključi u prijamnik; "
"odmah se prepoznaje."

msgid ""
"O telecomandă cu infraroșu, alta decât a receptorului, nu se poate asocia "
"încă."
msgstr ""
"Infracrveni daljinski upravljač, različit od onog prijamnika, još se ne može "
"upariti."

msgid "O valoare a transponderului nu e bună: %s."
msgstr "Neka vrijednost transpondera nije ispravna: %s."

msgid "O înregistrare e în curs."
msgstr "Snimanje je u tijeku."

msgid "O înregistrare e în curs: se oprește la revenire."
msgstr "Snimanje je u tijeku: zaustavlja se pri povratku."

msgid ""
"O înregistrare folosește acum antena. Comenzile pornesc după ce se termină."
msgstr "Snimanje sada koristi antenu. Naredbe kreću kad završi."

msgid ""
"O înregistrare folosește acum tunerul. Locul se schimbă după ce se termină."
msgstr "Snimanje sada koristi tuner. Lokacija se mijenja nakon što završi."

msgid "O înregistrare programată nu poate porni: nu am unde să înregistrez."
msgstr "Planirano snimanje ne može započeti: nemam gdje snimati."

#, python-format
msgid "O înregistrare scrie acum pe acest disc: %s."
msgstr "Snimanje se sada upisuje na ovaj disk: %s."

msgid "O înregistrare începe în curând. Pornește scanarea detaliată după ea."
msgstr "Snimanje uskoro počinje. Pokreni detaljno pretraživanje nakon njega."

#, python-format
msgid "O înregistrare începe în mai puțin de %d minute."
msgstr "Snimanje počinje za manje od %d minuta."

msgid "O înregistrare începe în mai puțin de 6 minute."
msgstr "Snimanje počinje za manje od 6 minuta."

msgid "OK"
msgstr "OK"

msgid "OK = da, EXIT = nu"
msgstr "OK = da, EXIT = ne"

msgid "OK actualizează · Roșu șterge"
msgstr "OK ažurira · Crvena briše"

msgid "OK adaugă"
msgstr "OK dodaje"

msgid ""
"OK adaugă canalul în buchetul din dreapta · cifrele scriu numele · HELP "
"ajutor"
msgstr "Referenca"

msgid "OK add to playlist, MENU options, CH+ / CH- switch list"
msgstr "OK dodaj na popis, MENU opcije, CH+ / CH- promijeni popis"

msgid "OK alege"
msgstr "OK odabire"

msgid "OK alege capturile, Verde le pune în mesaj."
msgstr "OK odabire snimke, ZELENO ih stavlja u poruku."

msgid "OK alege feedul pachetelor arătate."
msgstr "OK odabire feed prikazanih paketa."

msgid "OK alege feedul sau felul pachetelor arătate."
msgstr "OK odabire feed ili vrstu prikazanih paketa."

msgid ""
"OK alege latura: toate, sus, dreapta, jos sau stânga. Săgeata spre margine "
"duce latura aleasă spre marginea ecranului, săgeata opusă o aduce spre "
"mijloc. La toate laturile, Sus și Dreapta măresc cadrul, Jos și Stânga îl "
"micșorează. Potrivește cadrul până se vede întreg pe televizor."
msgstr ""
"OK odabire stranu: sve, gore, desno, dolje ili lijevo. Strelica prema rubu "
"pomiče odabranu stranu prema rubu zaslona, suprotna strelica vraća je prema "
"sredini. Kod svih strana, Gore i Desno povećavaju okvir, Dolje i Lijevo ga "
"smanjuju. Namjesti okvir dok ga ne vidiš cijelog na televizoru."

msgid ""
"OK alege orașul. Ora lui apare când „Ora din alt oraș” e în lista de rotire."
msgstr ""
"OK odabire grad. Njegovo vrijeme se prikazuje kada je „Vrijeme u drugom "
"gradu” u popisu rotacije."

msgid "OK alege valoarea."
msgstr "OK odabire vrijednost."

msgid "OK alege valoarea. Luminozitatea se aplică după salvare."
msgstr "OK odabire vrijednost. Svjetlina se primjenjuje nakon spremanja."

msgid "OK alege valoarea. Se aplică după salvare."
msgstr "OK odabire vrijednost. Primjenjuje se nakon spremanja."

msgid "OK alege · Roșu arată tot"
msgstr "OK odabire · Crvena prikazuje sve"

msgid ""
"OK alegi canalele ale căror piste se citesc acum · Stânga înapoi la nume"
msgstr "OK biraš kanale čiji se zapisi sada čitaju · Lijevo natrag na naziv"

msgid "OK arată canalele"
msgstr "OK prikazuje kanale"

msgid "OK arată de ce"
msgstr "OK prikazuje zašto"

msgid "OK arată de ce · Verde instalează înlocuitorul"
msgstr "OK prikazuje zašto · Zelena instalira zamjenu"

msgid ""
"OK arată fișierele de setări ale serverelor SSH și FTP, așa cum sunt pe "
"receptor."
msgstr ""
"OK prikazuje datoteke postavki SSH i FTP poslužitelja, onako kako su na "
"prijamniku."

msgid ""
"OK arată fișierele de setări ale serverului SSH, așa cum sunt pe receptor."
msgstr ""
"OK prikazuje datoteke postavki SSH poslužitelja onako kako su na prijamniku."

msgid "OK ascunde canalele"
msgstr "OK skriva kanale"

msgid "OK bifează sau debifează"
msgstr "OK označuje ili poništava"

msgid "OK bifează sau debifează · pe titlul grupei: toată grupa"
msgstr "OK označuje ili poništava · na naslovu grupe: cijelu grupu"

msgid ""
"OK bifează și trece mai jos · tastele colorate lucrează pe rândurile bifate"
msgstr "Slika i zvuk"

msgid "OK caută"
msgstr "OK traži"

msgid ""
"OK caută singur serverul din casă (LibreTranslate sau Ollama) și îl "
"probează. Adresa se poate scrie și de mână, mai jos."
msgstr ""
"OK sam traži server u kući (LibreTranslate ili Ollama) i isprobava ga. "
"Adresu možeš upisati i ručno, ispod."

msgid "OK caută în rețea"
msgstr "OK traži u mreži"

msgid "OK deschide"
msgstr "OK otvara"

msgid ""
"OK deschide adresele puse de mână, listele predefinite și pornirea DVB-I."
msgstr ""
"OK otvara ručno dodane adrese, unaprijed postavljene popise i uključivanje "
"DVB-I."

msgid ""
"OK deschide buchetul · Stânga / Dreapta: coloana · < anulează · > refă · "
"HELP ajutor"
msgstr "Odaberi cijelu skupinu"

msgid ""
"OK deschide lista limbilor: cele din imagine, cele descărcate și cele care "
"se pot descărca, cu mărimea fiecăreia."
msgstr ""
"OK otvara popis jezika: oni u slici sustava, preuzeti i oni koji se mogu "
"preuzeti, s veličinom svakog."

msgid "OK deschide meniul, cu „Locul înregistrărilor”."
msgstr "OK otvara izbornik s „Mjesto snimanja”."

msgid ""
"OK deschide pașii pentru serviciul ales: contul, cheia gratuită, cota și ce "
"se întâmplă la depășire."
msgstr ""
"OK otvara korake za odabranu uslugu: račun, besplatni ključ, kvotu i što se "
"događa pri prekoračenju."

msgid "OK deschide sau închide toți sateliții"
msgstr "OK otvara ili zatvara sve satelite"

msgid "OK deschide tastatura."
msgstr "OK otvara tipkovnicu."

msgid ""
"OK deschide tastatura. ID-ul contului are 32 de litere și cifre: în panoul "
"Cloudflare, la „Account ID”."
msgstr ""
"OK otvara tipkovnicu. ID računa ima 32 slova i brojke: u Cloudflare panelu, "
"pod „Account ID“."

msgid ""
"OK deschide tastatura. Textul apare când „Textul tău” e în lista de rotire."
msgstr ""
"OK otvara tipkovnicu. Tekst se prikazuje kada je „Tvoj tekst” u popisu "
"rotacije."

msgid ""
"OK deschide · Stânga / Dreapta: coloana · cifrele scriu numele · HELP ajutor"
msgstr "OK otvara · Lijevo / Desno: stupac · znamenke pišu naziv · HELP pomoć"

msgid "OK deschide · cifrele: poziția · < anulează · > refă · HELP ajutor"
msgstr "Sažmi skupinu"

msgid "OK full screen, INFO details, EXIT back to the list"
msgstr "OK preko cijelog zaslona, INFO detalji, EXIT natrag na popis"

msgid ""
"OK ia rândul ca să-l muți · cifrele: poziția · < anulează · > refă · HELP "
"ajutor"
msgstr ""
"OK uzima red za premještanje · znamenke: položaj · < poništi · > ponovi · "
"HELP pomoć"

msgid "OK instalează"
msgstr "OK instalira"

msgid "OK instalează fișierul"
msgstr "OK instalira datoteku"

msgid "OK le deschide"
msgstr "OK ih otvara"

msgid "OK o arată acum pe afișaj, o dată."
msgstr "OK ga sada jednom prikazuje na zaslonu."

msgid "OK oprește VPN-ul. Internetul merge apoi direct, prin rețeaua ta."
msgstr "OK zaustavlja VPN. Internet zatim ide izravno, kroz tvoju mrežu."

msgid ""
"OK oprește. Oricine din rețeaua ta de acasă intră acum pe receptor fără "
"parolă."
msgstr ""
"OK isključuje. Svatko iz tvoje kućne mreže sada ulazi na prijamnik bez "
"lozinke."

msgid "OK pe o pagină: deschide-o sau scoate-o din favorite."
msgstr "OK na stranici: otvori je ili ukloni iz favorita."

msgid ""
"OK pe un rând deschide tastatura. Parola nu se arată: o scrii numai când "
"vrei s-o schimbi; un rând gol o lasă cum e."
msgstr ""
"OK na retku otvara tipkovnicu. Lozinka se ne prikazuje: upisuješ je samo kad "
"je želiš promijeniti; prazan redak ostavlja je kakva jest."

msgid "OK pornește VPN-ul cu serverul ales."
msgstr "OK pokreće VPN s odabranim serverom."

msgid "OK pornește canalul · Stânga/Dreapta: pagina · Sus la filtre"
msgstr "OK uključuje kanal · Lijevo/Desno: stranica · Gore na filtre"

msgid ""
"OK pornește sau oprește, pe loc. Se vede când e în lista de rotire (grupa "
"„Ora și data”)."
msgstr ""
"OK odmah pokreće ili zaustavlja. Vidi se kada je u popisu rotacije (grupa "
"„Vrijeme i datum”)."

msgid "OK probează"
msgstr "OK testira"

msgid "OK pune contorul la zero."
msgstr "OK poništava brojač."

#, python-format
msgid "OK pune ecranul „%s”. Se vede la următoarea pornire."
msgstr "OK postavlja zaslon „%s”. Vidjet ćeš ga pri sljedećem pokretanju."

msgid "OK salvează alegerile și închide ecranul."
msgstr "OK sprema izbore i zatvara zaslon."

msgid "OK sau Albastru descarcă lista"
msgstr "OK ili Plava preuzima popis"

msgid "OK sau EXIT închide fereastra și anulează codul."
msgstr "OK ili EXIT zatvara prozor i poništava kod."

msgid "OK sau EXIT închide fereastra."
msgstr "OK ili EXIT zatvara prozor."

msgid "OK sau EXIT: înapoi"
msgstr "OK ili EXIT: natrag"

msgid "OK sau EXIT: închide"
msgstr "OK ili EXIT: zatvori"

msgid "OK sau Ieșire închide."
msgstr "OK ili Izlaz zatvara."

msgid "OK sau TEXT: scrie"
msgstr "OK ili TEXT: piši"

msgid "OK sau VERDE: copia se face acum pe locul ales la „Locul copiei”."
msgstr ""
"OK ili ZELENO: kopija se sada stvara na mjestu odabranom u „Mjesto kopije”."

#, python-format
msgid "OK scoate sau pune lista. Furnizor: %s."
msgstr "OK uklanja ili dodaje popis. Davatelj: %s."

msgid ""
"OK trimite o frază de probă serviciului ales. Răspunsul apare aici, iar "
"originalul și traducerea se văd jos, ca subtitrările."
msgstr ""
"OK šalje probnu rečenicu odabranoj usluzi. Odgovor se pojavljuje ovdje, a "
"original i prijevod vide se dolje, kao titlovi."

msgid ""
"OK încearcă din nou toate canalele, din casa ta. Cele oprite pentru țara ta "
"se pot vedea cu VPN-ul receptorului pornit."
msgstr ""
"OK ponovno isprobava sve kanale, iz tvog doma. One blokirane za tvoju zemlju "
"možeš gledati s uključenim VPN-om prijamnika."

msgid ""
"OK șterge cheia. Calculatorul cu această cheie intră apoi numai cu parola."
msgstr "OK briše ključ. Računalo s tim ključem zatim ulazi samo s lozinkom."

msgid "OK — schimba valorile cu OK/stanga/dreapta, cauta cu Verde."
msgstr "OK - mijenjaj vrijednosti s OK/lijevo/desno, traži Zelenom."

