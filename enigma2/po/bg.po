msgstr "Не е свързано"

#, python-format
msgid "Găsite: %d. Deja prezente sau repetate: %d. De adăugat: %d. Rânduri necitibile: %d."
msgstr "Намерени: %d. Вече налични или повторени: %d. За добавяне: %d. Нечетими редове: %d."

