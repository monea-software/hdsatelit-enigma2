msgstr "Възстановява настройките от %s, записани след 10 минути работа без срив, след което рестартира интерфейса. Текущите настройки се запазват в копие."

#, python-format
msgid "o oprire neașteptată"
msgid_plural "%d opriri neașteptate"
msgstr[0] "%d неочаквано спиране"
msgstr[1] "%d неочаквани спирания"

msgid "Placa 2D lucra în acel moment."
msgstr "2D графиката работеше в този момент."

msgid "Ecranul"
msgstr "Екран"

msgid "Eroarea"
msgstr "Грешка"

msgid "cădere în programul receptorului"
msgstr "срив в програмата на приемника"

msgid "În codul nativ, fără eroare Python; registrele sunt în textul brut."
msgstr "В нативния код, без Python грешка; регистрите са в суровия текст."

msgid "Locul"
msgstr "Местоположение"

msgid "Extensia"
msgstr "Разширение"

msgid "Ultimele rânduri din jurnal, dinaintea erorii, sunt în textul brut."
msgstr "Последните редове от дневника преди грешката са в суровия текст."

msgid "pornește la repornirea interfeței"
msgstr "стартира при рестартиране на интерфейса"

msgid "Extensii oprite"
msgstr "Спрени разширения"

msgid "niciuna (nu se poate afla care sunt ale imaginii)"
msgstr "няма (не може да се определи кои принадлежат към имиджа)"

#, python-format
msgid "făcută pe %s"
msgstr "направено на %s"

msgid "Puse înapoi singure"
msgstr "Възстановени автоматично"

#, python-format
msgid "După o oprire neașteptată și în modul sigur."
msgid_plural "După %d opriri neașteptate și în modul sigur."
msgstr[0] "След %d неочаквано спиране и в безопасен режим."
msgstr[1] "След %d неочаквани спирания и в безопасен режим."

msgid "pornește normal, cu toate extensiile"
msgstr "стартира нормално, с всички разширения"

msgid "Fișierul nu există: nicio oprire neașteptată scrisă."
msgstr "Файлът не съществува: няма записани неочаквани спирания."

msgid "Goală: nicio oprire numărată de la ultima pornire a receptorului."
msgstr "Празно: няма отчетени спирания от последното стартиране на приемника."

msgid "oprit și în modul sigur, setările de dinainte se pun înapoi singure"
msgstr "спрян и в безопасен режим, предишните настройки се възстановяват автоматично"

msgid "pornit în modul sigur"
msgstr "стартиран в безопасен режим"

msgid "cod"
msgstr "код"

msgid "Ultima extensie din jurnal"
msgstr "Последно разширение в журнала"

msgid "A scris în jurnal chiar înainte de cădere."
msgstr "Записано в журнала точно преди срива."

msgid "nu s-a putut (copia lipsea)"
msgstr "неуспешно (липсваше копие)"

msgid "nu s-a putut (memoria plină?)"
msgstr "неуспешно (паметта е пълна?)"

msgid "se pun înapoi singure setările de dinainte"
msgstr "предишните настройки се възстановяват автоматично"

#, python-format
msgid "o extensie"
msgid_plural "%d extensii"
msgstr[0] "%d разширение"
msgstr[1] "%d разширения"

msgid "Fiecare rând: secunde de la pornirea receptorului și codul opririi."
msgstr "Всеки ред: секунди от стартирането на приемника и кода на спирането."

msgid "Săgețile aleg, OK confirmă. EXIT: rămâi în modul sigur; ecranul se deschide din nou din Meniu > Informații despre sistem > Mod sigur."
msgstr "Стрелките избират, OK потвърждава. EXIT: останете в безопасен режим; екранът се отваря отново от Меню > Информация за системата > Безопасен режим."

msgid "Aceleași alegeri sunt și în interfața web, la pagina /mod-sigur."
msgstr "Същите опции има и в уеб интерфейса, на страницата /mod-sigur."

msgid "Ce s-a întâmplat"
msgstr "Какво се случи"

msgid "Text brut"
msgstr "Суров текст"

msgid "Stânga/Dreapta: alt fișier · Sus/Jos: derulare · OK: pe scurt · EXIT: înapoi"
msgstr "Наляво/Надясно: друг файл · Нагоре/Надолу: превъртане · OK: накратко · EXIT: назад"

msgid "Sus/Jos: derulare · OK sau ALBASTRU: textul brut · EXIT: înapoi"
msgstr "Нагоре/Надолу: превъртане · OK или СИН: суров текст · EXIT: назад"

#, python-format
msgid "Aceleași alegeri sunt și în interfața web: %s"
msgstr "Същите опции има и в уеб интерфейса: %s"

msgid "Interfața se repornește."
msgstr "Интерфейсът се рестартира."

msgid "Nu există niciun fișier de arătat."
msgstr "Няма файлове за показване."

msgid "Se citesc fișierele..."
msgstr "Четене на файловете..."

#, python-format
msgid "Fișierul: %s"
msgstr "Файл: %s"

msgid "Receptorul merge normal."
msgstr "Приемникът работи нормално."

#, python-format
msgid "Modul sigur pornește singur după %d opriri neașteptate ale interfeței în 10 minute: atunci pornesc numai extensiile venite cu imaginea, iar aici și pe televizor poți alege cum continui."
msgstr "Безопасният режим се стартира сам след %d неочаквани спирания на интерфейса за 10 минути: тогава се стартират само разширенията, включени в имиджа, а тук и на телевизора можете да изберете как да продължите."

msgid "Alegere necunoscută."
msgstr "Неизвестен избор."

msgid "Receptorul nu este în modul sigur."
msgstr "Приемникът не е в безопасен режим."

msgid "Interfața se repornește. Pagina se reîncarcă singură în câteva secunde."
msgstr "Интерфейсът се рестартира. Страницата ще се презареди сама след няколко секунди."

msgid "Ce poți face"
msgstr "Какво можете да направите"

msgid "Fișierele așa cum sunt pe receptor, fără rândurile cu parole sau cu cheia interfeței web."
msgstr "Файловете такива, каквито са на приемника, без редовете с пароли или с ключа на уеб интерфейса."

msgid "Pe televizor, același mesaj apare singur la pornire, în modul sigur, și din Meniu > Informații despre sistem > Mod sigur."
msgstr "На телевизора същото съобщение се появява само при стартиране в безопасен режим, както и от Меню > Информация за системата > Безопасен режим."

msgid "Alegerea se aplică la următoarea repornire a interfeței."
msgstr "Изборът се прилага при следващото рестартиране на интерфейса."

msgid "Pe televizor se cere o confirmare: o înregistrare e în curs sau începe curând. Alegerea se face numai dacă răspunzi Da acolo."
msgstr "На телевизора се изисква потвърждение: запис е в ход или започва скоро. Изборът се прави само ако отговорите с Да там."

msgid "Receptorul a răspuns neașteptat."
msgstr "Приемникът отговори неочаквано."

msgid "Se aplică alegerea..."
msgstr "Прилагане на избора..."

msgid "Mod sigur: fontul nu e încărcat acum."
msgstr "Безопасен режим: шрифтът не е зареден в момента."

msgid "Fontul nu e încărcat acum."
msgstr "Шрифтът не е зареден в момента."

msgid "Acces SSH"
msgstr "SSH достъп"

msgid "Cheia e stricată (textul de după tip nu e o cheie întreagă)."
msgstr "Ключът е повреден (текстът след типа не е цял ключ)."

msgid "Numai cu cheie"
msgstr "Само с ключ"

msgid "Fără parolă în rețeaua locală: oprit."
msgstr "Без парола в локалната мрежа: изключено."

#, python-format
msgid "Chei adăugate: %d. Erau deja: %d. Refuzate: %d."
msgstr "Добавени ключове: %d. Вече налични: %d. Отказани: %d."

msgid "Cheia a fost ștearsă. Calculatorul cu această cheie intră de acum numai cu parola."
msgstr "Ключът беше изтрит. Компютърът с този ключ отсега нататък влиза само с парола."

msgid "Oprit: pe receptor se intră numai cu parola sau cu o cheie."
msgstr "Изключено: достъпът до приемника е възможен само с парола или ключ."

msgid "Se lucrează..."
msgstr "Изпълнение..."

msgid "Nu am putut citi parola lui root."
msgstr "Неуспешно четене на root паролата."

msgid "Lipsește programul care face parola (hds-ssh-parola). Se intră numai cu o cheie."
msgstr "Липсва програмата, която създава паролата (hds-ssh-parola). Влизането става само с ключ."

msgid "Receptorul face parola, durează câteva secunde. Până atunci se intră numai cu o cheie."
msgstr "Приемникът създава паролата, това отнема няколко секунди. Дотогава влизането става само с ключ."

msgid "Pusă, nu se mai arată"
msgstr "Зададено, вече не се показва"

msgid "Fără parolă"
msgstr "Без парола"

msgid "Necunoscută"
msgstr "Неизвестно"

msgid "Se face..."
msgstr "Създава се..."

#, python-format
msgid "Te conectezi de pe calculator cu: ssh root@%s"
msgstr "Свържете се от компютър с: ssh root@%s"

msgid "Fără parolă în rețeaua locală: pornit. Oricine din rețeaua ta de acasă intră pe receptor fără parolă."
msgstr "Без парола в локалната мрежа: вкл. Всеки във вашата домашна мрежа може да влезе в приемника без парола."

msgid "Rândul e prea lung pentru o cheie publică."
msgstr "Редът е твърде дълъг за публичен ключ."

msgid "Rândul e gol."
msgstr "Редът е празен."

msgid "Nu e o cheie publică SSH. Cheia începe cu ssh-ed25519, ssh-rsa sau ecdsa-sha2-."
msgstr "Това не е публичен SSH ключ. Ключът започва с ssh-ed25519, ssh-rsa или ecdsa-sha2-."

msgid "Nu ai dat nicio cheie."
msgstr "Не сте въвели ключ."

msgid "Textul e prea lung pentru câteva chei publice."
msgstr "Текстът е твърде дълъг за няколко публични ключа."

msgid "Ai dat o cheie privată. Pune cheia publică (fișierul .pub). Cheia privată rămâne numai la tine."
msgstr "Въвели сте частен ключ. Въведете публичния ключ (файла .pub). Частният ключ остава само при вас."

msgid "Cheia nu mai era pe receptor."
msgstr "Ключът вече не беше на приемника."

msgid "Pe stick nu am găsit dosarul hdsatelit/ssh cu chei. Pune în el fișierul authorized_keys sau cheile tale .pub."
msgstr "Папката hdsatelit/ssh с ключове не беше намерена на USB флашката. Поставете в нея файла authorized_keys или вашите .pub ключове."

msgid "Pe stick e o cheie privată. Lasă pe stick numai cheile publice (.pub). Cheia privată rămâne numai la tine."
msgstr "На USB флашката има частен ключ. Оставете на нея само публични ключове (.pub). Частният ключ остава само при вас."

msgid "Lipsește programul care face parola (hds-ssh-parola)."
msgstr "Липсва програмата, която създава паролата (hds-ssh-parola)."

msgid "Am făcut o parolă nouă. Cea veche nu mai merge."
msgstr "Създадена е нова парола. Старата вече не работи."

msgid "Parola nouă nu s-a putut face. Parola de dinainte rămâne."
msgstr "Новата парола не можа да бъде създадена. Предишната парола остава."

msgid "Nu am putut ascunde parola."
msgstr "Паролата не можа да бъде скрита."

msgid "Setarea nu s-a putut salva."
msgstr "Настройката не можа да бъде запазена."

msgid "Pornit: din rețeaua ta de acasă se intră pe receptor fără parolă."
msgstr "Вкл.: от вашата домашна мрежа достъпът до приемника е без парола."

msgid "Notează parola, apoi alege „Am notat parola”: după aceea nu se mai arată."
msgstr "Запишете паролата, след това изберете „Записах паролата“: след това тя вече не се показва."

msgid "Pornirea serverului SSH"
msgstr "Стартиране на SSH сървъра"

msgid "Verificarea parolei (PAM)"
msgstr "Проверка на паролата (PAM)"

msgid "Regula „Fără parolă în rețeaua locală”"
msgstr "Правилото „Без парола в локалната мрежа“"

msgid "Cheile SSH"
msgstr "SSH ключове"

msgid "Jurnalul parolei"
msgstr "Журнал на паролата"

msgid "(fișierul nu există)"
msgstr "(файлът не съществува)"

msgid "Tipul scris în fața cheii nu se potrivește cu cheia."
msgstr "Типът, написан преди ключа, не съответства на ключа."

msgid "Cheile DSA nu mai sunt primite: sunt prea slabe. Fă o cheie Ed25519."
msgstr "DSA ключовете вече не се приемат: те са твърде слаби. Създайте Ed25519 ключ."

msgid "Rândul are opțiuni în fața cheii. Pune numai cheia publică, așa cum e în fișierul .pub."
msgstr "Редът съдържа опции преди ключа. Въведете само публичния ключ, както е във файла .pub."

msgid "Programul parolei nu a terminat la timp."
msgstr "Програмата за паролата не завърши навреме."

msgid "Se face o parolă nouă..."
msgstr "Създаване на нова парола..."

msgid "Se ascunde parola..."
msgstr "Скриване на паролата..."

msgid "Se adaugă cheile..."
msgstr "Добавяне на ключове..."

msgid "Se citesc cheile de pe stick..."
msgstr "Четене на ключове от USB флашката..."

msgid "Se șterge cheia..."
msgstr "Изтриване на ключа..."

msgid "Se salvează setarea..."
msgstr "Запазване на настройката..."

#, python-format
msgid "De pe stick, fișiere citite: %d."
msgstr "Прочетени файлове от USB флашката: %d."

msgid "Blocul cheii SSH2 nu e întreg."
msgstr "Блокът на SSH2 ключа е непълен."

#, python-format
msgid "Receptorul are deja %d de chei, cât primește cel mult."
msgstr "Приемникът вече има %d ключа, което е максимумът."

msgid "Chei SSH pe receptor: niciuna."
msgstr "SSH ключове на приемника: няма."

msgid "Adaugă cheile de pe stick"
msgstr "Добавяне на ключове от USB флашка"

msgid "Pune pe stick dosarul hdsatelit/ssh cu fișierul authorized_keys sau cu cheile tale .pub, apoi apasă OK."
msgstr "Поставете папката hdsatelit/ssh с файла authorized_keys или вашите .pub ключове на USB флашката, след това натиснете OK."

#, python-format
msgid "Chei SSH pe receptor: %d. Calculatoarele cu aceste chei intră fără parolă."
msgstr "SSH ключове на приемника: %d. Компютрите с тези ключове влизат без парола."

msgid "Am notat parola, ascunde-o"
msgstr "Записах паролата, скрий я"

msgid "Parola rămâne pusă, dar nu se mai arată aici și nici în interfața web. Dacă o uiți, faci una nouă."
msgstr "Паролата остава зададена, но вече не се показва тук или в уеб интерфейса. Ако я забравите, създайте нова."

msgid "Fă o parolă nouă"
msgstr "Създаване на нова парола"

msgid "Receptorul face o parolă la întâmplare și o arată aici. Cea veche nu mai merge."
msgstr "Приемникът създава произволна парола и я показва тук. Старата вече не работи."

msgid "Fă o parolă"
msgstr "Създаване на парола"

msgid "Receptorul face o parolă la întâmplare și o arată aici."
msgstr "Приемникът създава случайна парола и я показва тук."

msgid "Fără parolă în rețeaua locală: pornit"
msgstr "Без парола в локалната мрежа: Вкл."

msgid "OK oprește. Oricine din rețeaua ta de acasă intră acum pe receptor fără parolă."
msgstr "OK я изключва. Всеки във вашата домашна мрежа сега влиза в приемника без парола."

msgid "Fără parolă în rețeaua locală: oprit"
msgstr "Без парола в локалната мрежа: Изкл."

msgid "Rămâne oprit dacă nu ai un motiv anume. Pornit, oricine din rețeaua ta de acasă intră pe receptor fără parolă."
msgstr "Дръжте я изключена, освен ако нямате конкретна причина. Когато е включена, всеки във вашата домашна мрежа влиза в приемника без парола."

msgid "Așteaptă să se termine ce ai pornit înainte."
msgstr "Изчакайте предишното действие да завърши."

#, python-format
msgid "Șterge cheia: %s"
msgstr "Изтрий ключа: %s"

msgid "OK șterge cheia. Calculatorul cu această cheie intră apoi numai cu parola."
msgstr "OK изтрива ключа. Компютърът с този ключ след това влиза само с парола."

msgid "Faci o parolă nouă? Cea de acum nu mai merge."
msgstr "Създаване на нова парола? Сегашната вече няма да работи."

msgid "Așteaptă să se termine ce ai pornit înainte (pe televizor sau aici)."
msgstr "Изчакайте предишното действие да завърши (на телевизора или тук)."

msgid "Confirmă parola nouă: cea de acum nu mai merge după aceea."
msgstr "Потвърдете новата парола: сегашната вече няма да работи след това."

msgid "Lipsește amprenta cheii."
msgstr "Липсва отпечатък на ключа."

msgid "Confirmă ștergerea cheii."
msgstr "Потвърдете изтриването на ключа."

msgid "Alege pornit sau oprit."
msgstr "Изберете включено или изключено."

msgid "Confirmă: oricine din rețeaua ta de acasă va intra pe receptor fără parolă."
msgstr "Потвърдете: всеки във вашата домашна мрежа ще влиза в приемника без парола."

msgid "Parola nu se mai arată. Dacă ai uitat-o, fă una nouă."
msgstr "Паролата вече не се показва. Ако сте я забравили, създайте нова."

msgid "Parola și cheile se văd și se schimbă numai dintr-un browser conectat cu codul de pe televizor."
msgstr "Паролата и ключовете могат да се видят и променят само от браузър, свързан с кода от телевизора."

msgid "(cu opțiuni)"
msgstr "(с опции)"

#, python-format
msgid "Aceleași lucruri sunt pe televizor, în %s."
msgstr "Същото има и на телевизора, в %s."

msgid "Adaugă cheia"
msgstr "Добави ключ"

msgid "Adresa receptorului în rețea nu e cunoscută."
msgstr "Мрежовият адрес на приемника не е известен."

msgid "Ai lipit o cheie privată. Nu a plecat din pagină. Pune cheia publică (fișierul .pub); cheia privată rămâne numai la tine."
msgstr "Поставили сте частен ключ. Той не е напуснал страницата. Поставете публичния ключ (файла .pub); частният ключ остава само при вас."

msgid "Ai notat parola? După aceea nu se mai arată nici aici, nici pe televizor."
msgstr "Записахте ли паролата? След това тя не се показва нито тук, нито на телевизора."

msgid "Ai notat parola? După aceea nu se mai arată nici aici, nici în interfața web."
msgstr "Записахте ли паролата? След това тя не се показва нито тук, нито в уеб интерфейса."

msgid "Arată codul pe televizor"
msgstr "Покажи кода на телевизора"

msgid "Atenție: root nu are parolă și oricine din rețea intră pe receptor."
msgstr "Внимание: root няма парола и всеки в мрежата влиза в приемника."

msgid "Atenție: serverul SSH e pornit cu -B și primește conturi fără parolă."
msgstr "Внимание: SSH сървърът работи с -B и приема акаунти без парола."

msgid "Atenție: „Fără parolă în rețeaua locală” e pornit. Oricine din rețeaua ta de acasă intră pe receptor."
msgstr "Внимание: „Без парола в локалната мрежа“ е включено. Всеки във вашата домашна мрежа влиза в приемника."

#, python-format
msgid "Cheia RSA are %d de biți. Receptorul primește numai chei RSA de cel puțin %d de biți."
msgstr "RSA ключът има %d бита. Приемникът приема само RSA ключове с поне %d бита."

msgid "Codul are 6 cifre."
msgstr "Кодът има 6 цифри."

msgid "Codul de pe televizor"
msgstr "Код от телевизора"

msgid "Codul e pe televizor."
msgstr "Кодът е на телевизора."

msgid "Codul nu a mers."
msgstr "Кодът не проработи."

msgid "Codul nu s-a putut cere."
msgstr "Кодът не можа да бъде заявен."

msgid "Conectat."
msgstr "Свързан."

msgid "Conectează"
msgstr "Свържи"

msgid "Conectează browserul cu codul"
msgstr "Свържете браузъра с кода"

msgid "Contul root nu are parolă, deci nu se intră cu parolă, numai cu o cheie. Alege „Fă o parolă”."
msgstr "Акаунтът root няма парола, така че влизането работи само с ключ. Изберете „Създаване на парола“."

msgid "Contul root nu are parolă. Alege „Fă o parolă”."
msgstr "Акаунтът root няма парола. Изберете „Създаване на парола“."

msgid "Contul root nu are parolă: se intră numai cu o cheie. Dacă vrei și parolă, alege „Fă o parolă”."
