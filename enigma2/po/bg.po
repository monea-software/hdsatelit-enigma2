msgstr "Метод (шифър)"

msgid "Cheia comună (PSK)"
msgstr "Споделен ключ (PSK)"

msgid "Grupul (dacă serverul îl cere)"
msgstr "Група (ако сървърът я изисква)"

msgid "Datele de acces"
msgstr "Данни за достъп"

msgid "După salvare nu se mai arată nicăieri, nici aici, nici pe televizor."
msgstr "След запазване те не се показват никъде повече, нито тук, нито на телевизора."

msgid "Certificatul serverului"
msgstr "Сертификат на сървъра"

msgid "Serverul are un certificat pe care receptorul nu îl cunoaște. Ai încredere în el numai dacă serverul e al tău sau al firmei tale."
msgstr "Сървърът има сертификат, който приемникът не разпознава. Доверявайте му се само ако сървърът е ваш или на вашата фирма."

msgid "Am încredere"
msgstr "Доверявам се"

msgid "Alege fișierele, lipește textul sau scrie datele."
msgstr "Изберете файловете, поставете текста или въведете данните."

msgid "Pune-l pe stick în dosarul hdsatelit/vpn."
msgstr "Поставете го на USB флашка в папката hdsatelit/vpn."

msgid "Ai încredere în certificatul serverului? Alege Da numai dacă serverul e al tău sau al firmei tale."
msgstr "Доверявате ли се на сертификата на сървъра? Изберете „Да“ само ако сървърът е ваш или на вашата фирма."

msgid "Cisco AnyConnect, ocserv"
msgstr "Cisco AnyConnect, ocserv"

msgid "GlobalProtect (Palo Alto)"
msgstr "GlobalProtect (Palo Alto)"

msgid "Pulse Secure (Ivanti)"
msgstr "Pulse Secure (Ivanti)"

msgid "Juniper Network Connect"
msgstr "Juniper Network Connect"

msgid "Array Networks"
msgstr "Array Networks"

msgid "Fortinet"
msgstr "Fortinet"

msgid "Registrele DVB-I nu răspund acum. Verifică internetul receptorului și apasă din nou OK."
msgstr "Регистрите DVB-I не отговарят в момента. Проверете интернет връзката на приемника и натиснете OK отново."

msgid "După furnizor"
msgstr "По доставчик"

msgid "OK sau VERDE: pornește asistența. INFO: termenii și condițiile."
msgstr "OK или ЗЕЛЕН: стартира помощта. INFO: общи условия."

