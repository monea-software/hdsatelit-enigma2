msgid "Televizorul nu răspunde la CEC. Pornește SIMPLINK (sau CEC) din setările televizorului."
msgstr "Телевизорът не отговаря на CEC. Включете SIMPLINK (или CEC) в настройките на телевизора."

msgid "stinge televizorul"
msgstr "изключване на телевизора"

msgid "receptorul nu mai e pe ecran"
msgstr "приемникът вече не е на екрана"

msgid "aprinde televizorul"
msgstr "включване на телевизора"

msgid "trece pe intrarea receptorului"
msgstr "превключване на входа на приемника"

msgid "anunță receptorul"
msgstr "обявяване на приемника"

