msgstr "Меню на списъка с канали"

msgid "OK: uită volumele tuturor canalelor. Întârzierile pistelor rămân."
msgstr "OK: изтрива запаметените нива на звука за всички канали. Забавянията на аудио пистите остават."

msgid "Oprește traducerea teletextului"
msgstr "Спри превода на телетекста"

msgid "Pornește canalul"
msgstr "Включи канала"

