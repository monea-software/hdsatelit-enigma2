msgstr "Липсва за %s: %s."

msgid "Serviciu necunoscut."
msgstr "Непознат канал."

msgid "Cheia a fost ștearsă."
msgstr "Ключът беше изтрит."

msgid "Cheia are caractere care nu pot fi într-o cheie (sau e prea lungă). Nu s-a schimbat nimic."
msgstr "Ключът съдържа знаци, които не са позволени (или е твърде дълъг). Нищо не беше променено."

msgid "Cheia e salvată pe receptor."
msgstr "Ключът е запазен на приемника."

msgid "Cheia nu s-a putut salva pe receptor."
msgstr "Ключът не можа да бъде запазен на приемника."

#, python-format
msgid "%s nu a răspuns la timp."
msgstr "%s не отговори навреме."

#, python-format
msgid "Răspunsul de la %s s-a întrerupt."
msgstr "Отговорът от %s беше прекъснат."

#, python-format
msgid "%s a refuzat cheia (cheie greșită, ștearsă sau fără drept pentru traducere)."
msgstr "%s отхвърли ключа (грешен или изтрит ключ, или липса на права за превод)."

#, python-format
msgid "%s spune că s-a terminat cota gratuită sau că sunt prea multe cereri."
msgstr "%s съобщава, че безплатната квота е изчерпана или има твърде много заявки."

#, python-format
msgid "%s nu traduce în limba aleasă."
msgstr "%s не превежда на избрания език."

#, python-format
