msgstr "Системата е във формат, който може да бъде записан (%s)."

#, python-format
msgid "Fișierele stau pe stick (%s)."
msgstr "Файловете са на флашката (%s)."

#, python-format
msgid "Nucleul se va scrie în memoria internă, în locul %s."
msgstr "Ядрото ще бъде записано във вътрешната памет, на място %s."

#, python-format
msgid "Sistemul se va scrie în memoria internă, în locul %s."
msgstr "Системата ще бъде записана във вътрешната памет, на място %s."

msgid "Nu a găsit nucleul sistemului în acest software."
msgstr "Ядрото на системата не е намерено в този софтуер."

msgid "Nu a găsit sistemul în acest software."
msgstr "Системата не е намерена в този софтуер."

msgid "Nu a găsit locul nucleului în memoria internă."
msgstr "Мястото за ядрото във вътрешната памет не е намерено."

msgid "Nu a găsit locul sistemului în memoria internă."
msgstr "Мястото за системата във вътрешната памет не е намерено."

msgid "Nu recunoaște formatul sistemului."
msgstr "Форматът на системата не е разпознат."

msgid "Nucleul este prea mare pentru locul lui din memoria internă."
msgstr "Ядрото е твърде голямо за мястото си във вътрешната памет."

msgid "Sistemul este prea mare pentru locul lui din memoria internă."
msgstr "Системата е твърде голяма за мястото си във вътрешната памет."

msgid "Nu a găsit nicio eroare."
msgstr "Не са намерени грешки."

#, python-format
msgid "A găsit o eroare și s-a oprit (codul %d)."
msgstr "Намерена е грешка и работата е спряна (код %d)."

