msgid "Vezi live canalul %s"
msgstr "Гледай канал %s на живо"

#, python-format
msgid "Vezi live: %s"
msgstr "Гледай на живо: %s"

msgid "Playerul nu s-a încărcat de pe receptor. Reîncarcă pagina."
msgstr "Плейърът не се зареди от приемника. Презаредете страницата."

msgid "Exportă playlist (M3U)"
msgstr "Експортиране на плейлист (M3U)"

msgid "Se strânge lista..."
msgstr "Събиране на списъка..."

#, python-format
msgid "Playlistul s-a descărcat (%s). Deschide-l într-un player din casă."
msgstr "Плейлистът беше изтеглен (%s). Отворете го в плейър у дома."

msgid "Playlistul nu s-a putut face."
msgstr "Плейлистът не можа да бъде създаден."

msgid "Lista nu are niciun canal."
msgstr "Списъкът няма нито един канал."

msgid "Un aparat primește numai canale TV, iar printre canalele găsite sunt și posturi de radio. Alege TV la rândul Tip."
msgstr "Едно устройство получава само ТВ канали, а сред намерените канали има и радиостанции. Изберете ТВ в реда Тип."

msgid "Canalele găsite acum, ca playlist pentru un player din casă"
msgstr "Намерените сега канали като плейлист за плейър у дома"

#, python-format
msgid "Playlistul are primele %s din %d găsite."
msgstr "Плейлистът има първите %s от %d намерени."

