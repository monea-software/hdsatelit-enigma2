msgid "Locul %s a fost salvat."
msgstr "Мястото %s беше запазено."

msgid "parolă salvată"
msgstr "паролата е запазена"

msgid "fără parolă salvată"
msgstr "няма запазена парола"

msgid "Folosește pentru înregistrări (verifică scrierea și viteza)"
msgstr "Използване за записи (проверка на запис и скорост)"

