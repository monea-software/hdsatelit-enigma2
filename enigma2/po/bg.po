msgid "ATSC 1.0 (SUA, Canada, Mexic, Coreea)"
msgstr "ATSC 1.0 (САЩ, Канада, Мексико, Корея)"

msgid ""
"ATSC 1.0: Standard american. SUA, Canada, Mexic, Coreea de Sud.\n"
"Banda: 6 MHz. Modulație 8VSB (terestru) sau 64QAM (cablu)."
msgstr ""
"ATSC 1.0: Американски стандарт. САЩ, Канада, Мексико, Южна Корея.\n"
"Честотна лента: 6 MHz. Модулация 8VSB (ефирна) или 64QAM (кабелна)."

msgid "ATSC 3.0 (SUA — next gen)"
msgstr "ATSC 3.0 (САЩ — следващо поколение)"

msgid ""
"ATSC 3.0: Next-gen american (NextGen TV). SUA din 2020+.\n"
"IP-based, Ultra HD, HDR, audio imersiv."
msgstr ""
"ATSC 3.0: Американски стандарт от следващо поколение (NextGen TV). САЩ от 2020+ г.\n"
"Базиран на IP, Ultra HD, HDR, потапящ звук."

msgid "ATSC: gestionat de BDA pe PC. Folosește aplicația ATSC dedicată."
msgstr "ATSC: управлява се от BDA на компютър. Използвайте специализираното приложение за ATSC."

