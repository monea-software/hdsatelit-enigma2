msgstr "Bluetooth дистанционно управление"

msgid "Tip decodor (opțional)"
msgstr "Тип декодер (опционално)"

msgid "WireGuard nu a primit încă o confirmare de la server. Legătura se verifică atunci când trece trafic prin VPN."
msgstr "WireGuard все още не е получил потвърждение от сървъра. Връзката се проверява, когато през VPN преминава трафик."

msgid "X-User-Agent (opțional)"
msgstr "X-User-Agent (опционално)"

msgid "X-User-Agent și tipul decodorului: goale păstrează valorile salvate."
msgstr "X-User-Agent и тип на декодера: оставете празни, за да запазите записаните стойности."

msgid "asociată"
msgstr "сдвоено"

msgid "nouă"
msgstr "ново"

msgid "legătură Bluetooth activă"
msgstr "активна Bluetooth връзка"

