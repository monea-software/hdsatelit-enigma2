#, python-format
msgid "Poziția %d a fost memorată în motor. Limitele sunt pornite."
msgstr "Позиция %d беше запаметена в мотора. Границите са включени."

msgid "Limita de est a fost pusă aici. Limitele sunt pornite."
msgstr "Източната граница беше зададена тук. Границите са включени."

msgid "Limita de vest a fost pusă aici. Limitele sunt pornite."
msgstr "Западната граница беше зададена тук. Границите са включени."

msgid "satelitul programului"
msgstr "сателитът на канала"

msgid "Limitele nu au fost oprite: receptorul nu a putut ține minte asta pe disc."
msgstr "Границите не бяха изключени: приемникът не успя да запомни това на диска."

msgid "Pornește o înregistrare. Motorul s-a oprit și programul a revenit."
msgstr "Започва запис. Моторът спря и каналът се върна."

#, python-format
msgid "Tunerul nu a acceptat comanda (cod %d). Am trimis oprirea."
msgstr "Тунерът не прие командата (код %d). Изпратена е команда за спиране."

#, python-format
msgid "În setările tunerului, poziția %d e folosită pentru %s."
msgstr "В настройките на тунера позиция %d се използва за %s."

msgid "Un alt tuner legat de antenă a început să lucreze. Motorul s-a oprit."
msgstr "Друг тунер, свързан към антената, започна работа. Моторът спря."

msgid "Receptorul nu are niciun tuner de satelit, deci motorul nu se poate comanda de aici."
msgstr "Приемникът няма сателитен тунер, затова моторът не може да се управлява оттук."

msgid "Niciun tuner nu e setat cu motor. Motorul se alege în Setări tuner (DiSEqC 1.2 sau USALS)."
msgstr "Нито един тунер не е настроен с мотор. Моторът се избира в Настройки на тунера (DiSEqC 1.2 или USALS)."

msgid "lățime de bandă pe care imaginea nu o știe (numai 8, 7, 6 MHz și Auto)"
msgstr "честотна лента, която имиджът не разпознава (само 8, 7, 6 MHz и Auto)"

msgid "modulație pe care imaginea nu o știe încă (256QAM e numai la DVB-T2)"
msgstr "модулация, която имиджът още не разпознава (256QAM е само при DVB-T2)"

#, python-format
msgid "%d valori din listă pe care imaginea nu le știe au trecut pe Auto."
msgstr "%d стойности от списъка, които имиджът не разпознава, бяха превключени на Auto."

#, python-format
msgid "Sateliții bifați au %d transpondere în lista receptorului, dar niciunul cu parametri pe care tunerul îi primește (%s)."
msgstr "Маркираните сателити имат %d транспондера в списъка на приемника, но нито един с параметри, които тунерът приема (%s)."

msgid "sistem pe care imaginea nu îl știe"
msgstr "система, която имиджът не разпознава"

msgid "modulație pe care imaginea nu o știe încă"
msgstr "модулация, която имиджът още не разпознава"

#, python-format
msgid "rata de simbol %d kSymb/s nu e primită de tuner (%d-%d kSymb/s)"
msgstr "символната скорост %d kSymb/s не се приема от тунера (%d-%d kSymb/s)"

msgid "DVB-S2X se caută ca DVB-S2."
msgstr "DVB-S2X се търси като DVB-S2."

msgid "Factorul de rotunjire ales nu e primit de tuner, s-a folosit 0,35."
msgstr "Избраният roll-off фактор не се поддържа от тунера, използва се 0,35."

#, python-format
msgid "%d MHz nu e în lista receptorului pentru acest satelit, se caută cu valorile introduse."
msgstr "%d MHz не е в списъка на приемника за този сателит, търси се с въведените стойности."

#, python-format
msgid "Sistemul, FEC-ul și modulația sunt luate din lista receptorului: %s."
msgstr "Системата, FEC и модулацията са взети от списъка на приемника: %s."

msgid "Sateliții aleși nu au în lista receptorului niciun transponder pe care tunerul să-l primească."
msgstr "Избраните сателити нямат в списъка на приемника нито един транспондер, който тунерът да приема."

#, python-format
msgid "Căutare pe %d sateliți: %d transpondere din lista receptorului, plus cele anunțate în semnal."
msgstr "Търсене на %d сателита: %d транспондера от списъка на приемника, плюс тези, обявени в сигнала."

#, python-format
