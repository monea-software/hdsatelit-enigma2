msgstr "Тунерът с мотор се използва от някой друг (мрежово предаване или разширение)."

msgid "Limitele au rămas oprite la ultima folosire; le-am pornit."
msgstr "Границите останаха изключени при последната употреба; включих ги."

#, python-format
msgid "Tunerul nu a putut fi pregătit pe %s."
msgstr "Тунерът не можа да бъде подготвен на %s."

#, python-format
msgid "Receptorul așteaptă semnal pe %s ca să știe că antena a ajuns."
msgstr "Приемникът чака сигнал на %s, за да разбере, че антената е пристигнала."

#, python-format
