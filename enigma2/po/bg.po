msgstr "Фабрични настройки (по каталог)"

#, python-format
msgid "Folosește %s: aplicația cere acest browser."
msgstr "Използване на %s: приложението изисква този браузър."

msgid "Folosește HD Satelit Browser: redarea protejată cere Widevine."
msgstr "Използване на HD Satelit Browser: защитеното възпроизвеждане изисква Widevine."

msgid "Folosește identitatea implicită"
msgstr "Използване на идентичност по подразбиране"

