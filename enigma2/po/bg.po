msgstr "Изберете го сега в Местоположение за записи (ще го намерите в списъка, като диск)."

msgid "Film"
msgstr "Филм"

msgid "Muzică"
msgstr "Музика"

msgid "Adresa serverului media"
msgstr "Адрес на медийния сървър"

msgid "Serverul (nume sau adresă)"
msgstr "Сървър (име или адрес)"

