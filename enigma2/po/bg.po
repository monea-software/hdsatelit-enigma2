msgstr "Порт (0: стандартен)"

msgid "Montat și după repornire"
msgstr "Монтирано и след рестартиране"

msgid "Numai citire"
msgstr "Само за четене"

msgid "Primește un certificat făcut acasă"
msgstr "Приемане на самоподписан сертификат"

