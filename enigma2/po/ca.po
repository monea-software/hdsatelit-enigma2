msgstr "OK cerca a la xarxa"

msgid "OK deschide"
msgstr "OK obre"

msgid ""
"OK deschide adresele puse de mână, listele predefinite și pornirea DVB-I."
msgstr ""
"OK obre les adreces afegides manualment, les llistes predefinides i "
"l'activació de DVB-I."

msgid ""
"OK deschide buchetul · Stânga / Dreapta: coloana · < anulează · > refă · "
"HELP ajutor"
msgstr ""
"OK obre el grup de canals · Esquerra / Dreta: columna · < desfés · > refés · "
"HELP ajuda"

msgid ""
"OK deschide lista limbilor: cele din imagine, cele descărcate și cele care "
"se pot descărca, cu mărimea fiecăreia."
msgstr ""
"OK obre la llista d'idiomes: els de la imatge, els descarregats i els que es "
"poden descarregar, amb la mida de cadascun."

msgid "OK deschide meniul, cu „Locul înregistrărilor”."
msgstr "OK obre el menú, amb «Ubicació dels enregistraments»."

msgid ""
"OK deschide pașii pentru serviciul ales: contul, cheia gratuită, cota și ce "
"se întâmplă la depășire."
msgstr ""
"OK obre els passos per al servei triat: el compte, la clau gratuïta, la "
"quota i què passa quan la superes."

msgid "OK deschide sau închide toți sateliții"
msgstr "OK obre o tanca tots els satèl·lits"

msgid "OK deschide tastatura."
msgstr "OK obre el teclat."

msgid ""
"OK deschide tastatura. ID-ul contului are 32 de litere și cifre: în panoul "
"Cloudflare, la „Account ID”."
msgstr ""
"OK obre el teclat. L'ID del compte té 32 lletres i xifres: al panell de "
"Cloudflare, a «Account ID»."

msgid ""
"OK deschide tastatura. Textul apare când „Textul tău” e în lista de rotire."
msgstr ""
"OK obre el teclat. El text apareix quan «El teu text» és a la llista de "
"rotació."

msgid ""
"OK deschide · Stânga / Dreapta: coloana · cifrele scriu numele · HELP ajutor"
msgstr ""
"OK obre · Esquerra / Dreta: columna · les xifres escriuen el nom · HELP ajuda"

msgid "OK deschide · cifrele: poziția · < anulează · > refă · HELP ajutor"
msgstr "OK obre · xifres: posició · < desfés · > refés · HELP ajuda"

msgid "OK full screen, INFO details, EXIT back to the list"
msgstr "OK pantalla completa, INFO detalls, EXIT torna a la llista"

msgid ""
"OK ia rândul ca să-l muți · cifrele: poziția · < anulează · > refă · HELP "
"ajutor"
msgstr ""
"OK agafa la fila per moure-la · xifres: posició · < desfés · > refés · HELP "
"ajuda"

msgid "OK instalează"
msgstr "OK instal·la"

msgid "OK instalează fișierul"
msgstr "OK instal·la el fitxer"

msgid "OK le deschide"
msgstr "OK les obre"

msgid "OK o arată acum pe afișaj, o dată."
msgstr "OK la mostra ara a la pantalla, una vegada."

msgid "OK oprește VPN-ul. Internetul merge apoi direct, prin rețeaua ta."
msgstr "OK atura la VPN. Després internet va directe, per la teva xarxa."

msgid ""
"OK oprește. Oricine din rețeaua ta de acasă intră acum pe receptor fără "
"parolă."
msgstr ""
"OK ho desactiva. Qualsevol persona de la teva xarxa domèstica ara pot entrar "
"al receptor sense contrasenya."

msgid "OK pe o pagină: deschide-o sau scoate-o din favorite."
msgstr "OK en una pàgina: obre-la o treu-la dels preferits."

msgid "OK pe rândul de sus: termenii și condițiile."
msgstr "OK a la fila de dalt: els termes i condicions."

msgid ""
"OK pe un rând deschide tastatura. Parola nu se arată: o scrii numai când "
"vrei s-o schimbi; un rând gol o lasă cum e."
msgstr ""
"OK en una fila obre el teclat. La contrasenya no es mostra: l'escrius només "
"quan la vols canviar; una fila buida la deixa com està."

msgid "OK pornește VPN-ul cu serverul ales."
msgstr "OK inicia la VPN amb el servidor triat."

msgid "OK pornește canalul · Stânga/Dreapta: pagina · Sus la filtre"
msgstr "OK inicia el canal · Esquerra/Dreta: pàgina · Amunt als filtres"

msgid ""
"OK pornește sau oprește, pe loc. Se vede când e în lista de rotire (grupa "
"„Ora și data”)."
msgstr ""
"OK inicia o atura de seguida. Es veu quan és a la llista de rotació (grup "
"«Hora i data»)."

msgid "OK probează"
msgstr "OK ho prova"

msgid "OK pune contorul la zero."
msgstr "OK posa el comptador a zero."

#, python-format
msgid "OK pune ecranul „%s”. Se vede la următoarea pornire."
msgstr "OK posa la pantalla «%s». Es veurà a la propera arrencada."

msgid "OK salvează alegerile și închide ecranul."
msgstr "OK desa les opcions i tanca la pantalla."

msgid "OK sau Albastru descarcă lista"
msgstr "OK o Blau descarrega la llista"

msgid "OK sau EXIT închide fereastra și anulează codul."
msgstr "OK o EXIT tanca la finestra i anul·la el codi."

msgid "OK sau EXIT închide fereastra."
msgstr "OK o EXIT tanca la finestra."

msgid "OK sau EXIT: înapoi"
msgstr "OK o EXIT: enrere"

msgid "OK sau EXIT: închide"
msgstr "OK o EXIT: tanca"

msgid "OK sau Ieșire închide."
msgstr "OK o Surt tanca."

msgid "OK sau TEXT: scrie"
msgstr "OK o TEXT: escriu"

msgid "OK sau VERDE: copia se face acum pe locul ales la „Locul copiei”."
msgstr "OK o VERD: la còpia es fa ara al lloc triat a «Lloc de la còpia»."

#, python-format
msgid "OK scoate sau pune lista. Furnizor: %s."
msgstr "OK treu o posa la llista. Proveïdor: %s."

msgid ""
"OK trimite o frază de probă serviciului ales. Răspunsul apare aici, iar "
"originalul și traducerea se văd jos, ca subtitrările."
msgstr ""
"OK envia una frase de prova al servei triat. La resposta apareix aquí, i "
"l'original i la traducció es mostren a baix, com els subtítols."

msgid ""
"OK încearcă din nou toate canalele, din casa ta. Cele oprite pentru țara ta "
"se pot vedea cu VPN-ul receptorului pornit."
msgstr ""
"OK prova de nou tots els canals des de casa teva. Els bloquejats per al teu "
"país es poden veure amb la VPN del receptor activada."

msgid ""
"OK șterge cheia. Calculatorul cu această cheie intră apoi numai cu parola."
msgstr ""
"OK suprimeix la clau. L'ordinador amb aquesta clau després només hi entra "
"amb la contrasenya."

msgid "OK — schimba valorile cu OK/stanga/dreapta, cauta cu Verde."
msgstr "OK - canvia els valors amb OK/esquerra/dreta, cerca amb Verd."

msgid "OK: alege · STÂNGA/DREAPTA: schimbă"
msgstr "OK: tria · ESQUERRA/DRETA: canvia"

msgid "OK: alegi modelul din listă (sau îl scrii). Cel din fabrică: %s."
msgstr "OK: tries el model de la llista (o l'escrius). El de fàbrica: %s."

msgid "OK: alegi poza de pe stick."
msgstr "OK: tries la imatge de la memòria USB."

msgid ""
"OK: alegi regiunea din listă. O găsești în portal, la resursa Translator: "
"Overview › Location. Global pentru o resursă Global."
msgstr ""
"OK: tries la regió de la llista. La trobes al portal, al recurs Translator: "
"Overview › Location. Global per a un recurs Global."

msgid "OK: ce faci cu copia. GALBEN: pune la loc. ALBASTRU: șterge."
msgstr "OK: què fer amb la còpia. GROC: restaurar. BLAU: eliminar."

msgid "OK: cod QR"
msgstr "OK: codi QR"

msgid "OK: copia nu se mai pune la loc."
msgstr "OK: la còpia ja no es restaura."

msgid "OK: descarci, oprești sau ștergi modelul    EXIT: închide"
msgstr "OK: descarregues, atures o suprimeixes el model    EXIT: tanca"

msgid ""
"OK: intri în dosar sau pornești filmul.\n"
"INAPOI: dosarul de mai sus.\n"
"Subtitrările de lângă film se iau singure; tasta SUB le arată pe toate și "
"caută pe internet."
msgstr ""
"OK: entres a la carpeta o inicies la pel·lícula.\n"
"ENRERE: la carpeta superior.\n"
"Els subtítols del costat de la pel·lícula es carreguen sols; la tecla SUB "
"els mostra tots i cerca a internet."

msgid "OK: lista paginilor favorite."
msgstr "OK: la llista de pàgines preferides."

msgid "OK: lista posturilor.   OK ținut apăsat: opțiunile."
msgstr "OK: llista de canals.   OK mantingut premut: opcions."

#, python-format
msgid "OK: lista serverelor (%d). Fără servere, importă întâi fișierele."
msgstr ""
"OK: llista de servidors (%d). Sense servidors, importa primer els fitxers."

msgid "OK: mută, durata sau scoate."
msgstr "OK: mou, canvia la durada o elimina."

msgid "OK: mută, durata, eticheta sau scoate."
msgstr "OK: mou, durada, etiqueta o treu."

msgid "OK: mărește poza."
msgstr "OK: amplia la imatge."

msgid "OK: mărește poza. Stânga și Dreapta: celelalte poze."
msgstr "OK: amplia la imatge. Esquerra i Dreta: les altres imatges."

msgid "OK: pagina web a aparatului, în navigator."
msgstr "OK: la pàgina web del dispositiu, al navegador."

#, python-format
msgid "OK: pui ecranul „%s” sau îl ștergi din galerie."
msgstr "OK: poses la pantalla «%s» o la suprimeixes de la galeria."

#, python-format
msgid "OK: pui sau ștergi poza ta „%s”."
msgstr "OK: poses o suprimeixes la teva imatge «%s»."

msgid "OK: salvează. EXIT: renunță."
msgstr "OK: desa. EXIT: cancel·la."

msgid "OK: scrie mesajul cu tastatura de pe ecran."
msgstr "OK: escriu el missatge amb el teclat en pantalla."

msgid "OK: scrie titlul."
msgstr "OK: escriu el títol."

msgid ""
"OK: scrii o cheie nouă sau o ștergi. Cheia se păstrează pe receptor, "
"criptată, și nu se mai arată niciodată. Albastru: cum îți faci cheia "
"gratuită."
msgstr ""
"OK: escrius una clau nova o l'esborres. La clau es guarda al receptor, "
"xifrada, i no es torna a mostrar mai. Blau: com obtenir la teva clau "
"gratuïta."

msgid "OK: tastatura"
msgstr "OK: teclat"

msgid "OK: textul licenței    Stânga/Dreapta: pagina    EXIT: închide"
msgstr "OK: text de la llicència    Esquerra/Dreta: pàgina    EXIT: tanca"

msgid ""
"OK: un cod QR pentru telefon. Pe telefon îți faci cheia și o lipești; "
"receptorul o probează pe loc."
msgstr ""
"OK: un codi QR per al telèfon. Al telèfon et crees la clau i l'enganxes; el "
"receptor la prova de seguida."

msgid "OK: îl adaugi"
msgstr "OK: l'afegeixes"

msgid "OK: întoarce lista la copia aleasă"
msgstr "OK: torna la llista a la còpia triada"

msgid ""
"OK: șterge cookie-urile și datele salvate de aplicațiile HbbTV ale canalelor "
"(de exemplu alegerea din fereastra de consimțământ)."
msgstr ""
"OK: elimina les cookies i les dades desades per les aplicacions HbbTV dels "
"canals (per exemple, la tria a la finestra de consentiment)."

msgid ""
"OK: șterge istoricul, cookie-urile, datele site-urilor și mărirea ținută "
"minte."
msgstr ""
"OK: esborra l'historial, les galetes, les dades dels llocs i la mida "
"recordada."

#, python-format
msgid ""
"ON ID %d, iar în lista satelitului e %d. Antena poate fi pe alt satelit."
msgstr ""
