msgstr ""
"T'avisarem quan ens connectem. Mentrestant pots fer servir el receptor."

#, python-format
msgid "Te conectezi de pe calculator cu: ssh root@%s"
msgstr "Et connectes des de l'ordinador amb: ssh root@%s"

#, python-format
msgid "Te conectezi la rețeaua Wi-Fi %s?"
msgstr "Et connectes a la xarxa Wi-Fi %s?"

msgid "Te întreb dacă pot schimba canalul."
msgstr "Et pregunto si puc canviar el canal."

msgid "Te întreb din nou pentru toate limbile."
msgstr "Et torno a preguntar per a tots els idiomes."

msgid "Telecomanda TV (System Audio Control)"
msgstr "Comandament del televisor (System Audio Control)"

#, python-format
msgid "Telecomanda aceasta e deja asociată ca „%s”. O refaci buton cu buton."
msgstr ""
"Aquest comandament ja està associat com a «%s». El refàs botó per botó."

