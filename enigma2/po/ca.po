msgstr "Al disc ja existeix %s i no és un fitxer normal. El swap no s'activa."

#, python-format
msgid "Pe disc nu e destul loc: trebuie %s, sunt liberi %s."
msgstr "No hi ha prou espai al disc: calen %s, hi ha %s lliures."

msgid ""
"Pe disc nu e niciun sistem de fișiere pe care receptorul îl poate verifica "
"(ext2, ext3, ext4 sau FAT)."
msgstr ""
"El disc no té cap sistema de fitxers que el receptor pugui comprovar (ext2, "
"ext3, ext4 o FAT)."

msgid "Pe discurile conectate nu se poate înregistra."
msgstr "Als discos connectats no s'hi pot enregistrar."

msgid "Pe ecran până la repornire"
msgstr "A la pantalla fins a reiniciar"

msgid "Pe ecran, cu săgețile. EXIT te întoarce aici."
msgstr "A la pantalla, amb les fletxes. EXIT et torna aquí."

msgid ""
"Pe ecran: atinge = alege, atinge rândul ales = OK, glisează = derulează, "
"ține apăsat = Meniu."
msgstr ""
"A la pantalla: toca = tria, toca la fila seleccionada = OK, llisca = "
