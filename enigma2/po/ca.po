msgstr "Pista d'àudio de la imatge al navegador"

msgid "Pista audio aleasă."
msgstr "Pista d'àudio triada."

msgid "Pista audio nu e un număr."
msgstr "La pista d'àudio no és un número."

msgid "Pista audio nu există (poate s-a schimbat canalul)."
msgstr "La pista d'àudio no existeix (potser ha canviat el canal)."

