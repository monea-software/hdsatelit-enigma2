msgstr "Otsing või allalaadimine juba käib; oota selle lõppemist."

msgid ""
"O data pe zi, in fundal, receptorul ia de pe stb.hdsatelit.com frecventele "
"si numele posturilor. Butonul Actualizeaza lista merge oricand."
msgstr ""
"Kord päevas, taustal, laadib vastuvõtja saidilt stb.hdsatelit.com sagedused "
"ja jaamade nimed. Nupp „Uuenda nimekiri” töötab igal ajal."

msgid "O dată pe minut"
msgstr "Kord minutis"

msgid "O dată pe săptămână"
msgstr "Kord nädalas"

msgid ""
"O dată pe zi, noaptea, numai felurile bifate, și imediat după o oprire "
"neașteptată a interfeței sau o actualizare care nu a reușit. Fără bifă "
"pleacă numai ce trimiți tu cu „Trimite acum”."
msgstr ""
"Kord päevas, öösel, ainult märgitud liigid, ja kohe pärast liidese ootamatut "
"seiskumist või ebaõnnestunud uuendust. Ilma märketa saadetakse ainult see, "
"mille saadad „Saada kohe” abil."

msgid ""
"O dată pe zi, în fundal, receptorul ia de pe stb.hdsatelit.com frecvențele "
"și numele posturilor. Butonul „Actualizează lista” merge oricând. <span "
"id=\"ultimaZilnica\"></span>"
msgstr ""
"Kord päevas, taustal, laadib vastuvõtja saidilt stb.hdsatelit.com alla "
"jaamade sagedused ja nimed. Nupp „Uuenda loendit” töötab igal ajal. <span "
"id=\"ultimaZilnica\"></span>"

msgid "O eroare pe receptor."
msgstr "Viga vastuvõtjal."

msgid "O greșeală, o idee sau o întrebare, direct echipei."
msgstr "Viga, idee või küsimus otse meeskonnale."

msgid "O lipești, iar receptorul recunoaște singur serviciul."
msgstr "Sa kleebid selle ja vastuvõtja tunneb teenuse ise ära."

msgid ""
"O listă de redare de pe disc nu se poate șterge din player, nici pe "
"televizor."
msgstr ""
"Kettal olevat esitusloendit ei saa pleierist kustutada, isegi mitte teleris."

msgid "O margine e între 0 și 5 la sută din latura ei."
msgstr "Serv on vahemikus 0 kuni 5 protsenti oma küljest."

msgid "O notă despre emisiune. OK deschide tastatura."
msgstr "Märkus saate kohta. OK avab klaviatuuri."

msgid "O pagină mai jos"
msgstr "Lehekülg alla"

msgid "O pagină mai sus"
msgstr "Lehekülg üles"

msgid "O pagină în jos"
msgstr "Üks lehekülg alla"

msgid "O pagină în sus"
msgstr "Üks lehekülg üles"

msgid ""
"O poză nu a putut fi urcată: trebuie să fie JPG sau PNG, de cel mult 4 MB."
msgstr ""
"Üht pilti ei õnnestunud üles laadida: see peab olema JPG või PNG, kõige "
"rohkem 4 MB."

msgid "O poți instala din nou oricând, din aceeași sursă."
msgstr "Saad selle igal ajal uuesti paigaldada samast allikast."

msgid "O probă DiSEqC e deja deschisă pe televizor. Închide-o întâi."
msgstr "Teleris on juba DiSEqC-test avatud. Sulge see kõigepealt."

msgid "O reîmprospătare e deja în lucru."
msgstr "Värskendamine on juba käimas."

msgid "O reîncărcare e deja în curs."
msgstr "Uuestilaadimine on juba käimas."

msgid ""
"O scanare DAB+ sau DVB-T2 e deschisă pe televizor. Așteaptă să se termine "
"sau oprește-o."
msgstr ""
"Teleris on avatud DAB+ või DVB-T2 otsing. Oota selle lõppemist või peata see."

msgid "O singură dată"
msgstr "Üks kord"

msgid ""
"O singură dată sau repetat: în fiecare zi, o dată pe săptămână, de luni până "
"vineri sau în zilele alese."
msgstr ""
"Üks kord või korduvalt: iga päev, kord nädalas, esmaspäevast reedeni või "
"valitud päevadel."

msgid "O singură limbă: forumul traduce singur."
msgstr "Ainult üks keel: foorum tõlgib ise."

msgid ""
"O telecomandă USB (sau o tastatură) se bagă în receptor înainte; se vede "
"imediat."
msgstr ""
"Ühenda USB-pult (või klaviatuur) enne vastuvõtjasse; see tuvastatakse kohe."

msgid ""
"O telecomandă cu infraroșu, alta decât a receptorului, nu se poate asocia "
"încă."
msgstr "Vastuvõtja omast erinevat infrapunapulti ei saa veel siduda."

msgid "O valoare a transponderului nu e bună: %s."
msgstr "Üks transponderi väärtus ei ole õige: %s."

msgid "O înregistrare e în curs."
msgstr "Salvestamine on pooleli."

msgid "O înregistrare e în curs: se oprește la revenire."
msgstr "Salvestus on käimas: see peatub taaskäivitamisel."

msgid ""
"O înregistrare folosește acum antena. Comenzile pornesc după ce se termină."
msgstr ""
"Antenni kasutab praegu salvestamine. Käsud hakkavad tööle pärast selle lõppu."

msgid ""
"O înregistrare folosește acum tunerul. Locul se schimbă după ce se termină."
msgstr "Salvestis kasutab praegu tuunerit. Asukoht muutub pärast selle lõppu."

msgid "O înregistrare programată nu poate porni: nu am unde să înregistrez."
msgstr "Planeeritud salvestus ei saa käivituda: pole kuhugi salvestada."

#, python-format
msgid "O înregistrare scrie acum pe acest disc: %s."
msgstr "Sellele kettale kirjutab praegu salvestis: %s."

msgid "O înregistrare începe în curând. Pornește scanarea detaliată după ea."
msgstr "Varsti algab salvestus. Käivita üksikasjalik otsing pärast seda."

#, python-format
msgid "O înregistrare începe în mai puțin de %d minute."
msgstr "Salvestis algab vähem kui %d minuti pärast."

msgid "O înregistrare începe în mai puțin de 6 minute."
msgstr "Salvestamine algab vähem kui 6 minuti pärast."

msgid "OK"
msgstr "OK"

msgid "OK = da, EXIT = nu"
msgstr "OK = jah, EXIT = ei"

msgid "OK actualizează · Roșu șterge"
msgstr "OK uuendab · Punane kustutab"

msgid "OK adaugă"
msgstr "OK lisab"

msgid ""
"OK adaugă canalul în buchetul din dreapta · cifrele scriu numele · HELP "
"ajutor"
msgstr ""
"OK lisab kanali parempoolsesse kanalipaketti · numbrid kirjutavad nime · "
"HELP abi"

msgid "OK add to playlist, MENU options, CH+ / CH- switch list"
msgstr "OK lisa esitusloendisse, MENU valikud, CH+ / CH- vaheta loendit"

msgid "OK alege"
msgstr "OK valib"

msgid "OK alege capturile, Verde le pune în mesaj."
msgstr "OK valib ekraanipildid, ROHELINE lisab need sõnumisse."

msgid "OK alege feedul pachetelor arătate."
msgstr "OK valib näidatavate pakettide feedi."

msgid "OK alege feedul sau felul pachetelor arătate."
msgstr "OK valib näidatavate pakettide feedi või liigi."

msgid ""
"OK alege latura: toate, sus, dreapta, jos sau stânga. Săgeata spre margine "
"duce latura aleasă spre marginea ecranului, săgeata opusă o aduce spre "
"mijloc. La toate laturile, Sus și Dreapta măresc cadrul, Jos și Stânga îl "
"micșorează. Potrivește cadrul până se vede întreg pe televizor."
msgstr ""
"OK valib külje: kõik, üleval, paremal, all või vasakul. Serva poole suunatud "
"nool viib valitud külje ekraani servani, vastassuunaline nool toob selle "
"keskosa poole. Kõigi külgede puhul suurendavad Üles ja Parem raami, Alla ja "
"Vasak vähendavad seda. Kohanda raami, kuni näed seda teleris tervenisti."

msgid ""
"OK alege orașul. Ora lui apare când „Ora din alt oraș” e în lista de rotire."
msgstr ""
"OK valib linna. Selle aeg kuvatakse, kui „Aeg teises linnas” on vaheldumise "
"loendis."

msgid "OK alege valoarea."
msgstr "OK valib väärtuse."

msgid "OK alege valoarea. Luminozitatea se aplică după salvare."
msgstr "OK valib väärtuse. Heledus rakendub pärast salvestamist."

msgid "OK alege valoarea. Se aplică după salvare."
msgstr "OK valib väärtuse. Rakendub pärast salvestamist."

msgid "OK alege · Roșu arată tot"
msgstr "OK valib · Punane näitab kõike"

msgid ""
"OK alegi canalele ale căror piste se citesc acum · Stânga înapoi la nume"
msgstr ""
"OK valib kanalid, mille rajad praegu loetakse · Vasakule tagasi nime juurde"

msgid "OK arată canalele"
msgstr "OK näitab kanaleid"

msgid "OK arată de ce"
msgstr "OK näitab põhjust"

msgid "OK arată de ce · Verde instalează înlocuitorul"
msgstr "OK näitab põhjust · Roheline installib asendaja"

msgid ""
"OK arată fișierele de setări ale serverelor SSH și FTP, așa cum sunt pe "
"receptor."
msgstr ""
"OK näitab SSH- ja FTP-serverite seadistusfaile nii, nagu need vastuvõtjas on."

msgid ""
"OK arată fișierele de setări ale serverului SSH, așa cum sunt pe receptor."
msgstr ""
"OK kuvab SSH-serveri seadistusfaile sellisena, nagu need vastuvõtjas on."

msgid "OK ascunde canalele"
msgstr "OK peidab kanalid"

msgid "OK bifează sau debifează"
msgstr "OK märgib või eemaldab märke"

msgid "OK bifează sau debifează · pe titlul grupei: toată grupa"
msgstr "OK märgib või eemaldab märke · grupi pealkirjal: kogu grupp"

msgid ""
"OK bifează și trece mai jos · tastele colorate lucrează pe rândurile bifate"
msgstr ""
"OK märgib ja liigub allapoole · värvilised nupud töötavad märgitud ridadel"

msgid "OK caută"
msgstr "OK otsib"

msgid ""
"OK caută singur serverul din casă (LibreTranslate sau Ollama) și îl "
"probează. Adresa se poate scrie și de mână, mai jos."
msgstr ""
"OK otsib ise koduse serveri (LibreTranslate või Ollama) ja testib seda. "
"Aadressi saab ka käsitsi sisestada, allpool."

msgid "OK caută în rețea"
msgstr "OK otsib võrgust"

msgid "OK deschide"
msgstr "OK avab"

msgid ""
"OK deschide adresele puse de mână, listele predefinite și pornirea DVB-I."
msgstr ""
"OK avab käsitsi lisatud aadressid, eelseadistatud loendid ja DVB-I "
"sisselülitamise."

msgid ""
"OK deschide buchetul · Stânga / Dreapta: coloana · < anulează · > refă · "
"HELP ajutor"
msgstr ""
"OK avab kanalipaketi · Vasak / Parem: veerg · < võta tagasi · > tee uuesti · "
"HELP abi"

msgid ""
"OK deschide lista limbilor: cele din imagine, cele descărcate și cele care "
"se pot descărca, cu mărimea fiecăreia."
msgstr ""
"OK avab keelte loendi: image'is olevad, allalaaditud ja allalaaditavad, "
"igaühe suurusega."

msgid "OK deschide meniul, cu „Locul înregistrărilor”."
msgstr "OK avab menüü, kus on „Salvestiste asukoht”."

msgid ""
"OK deschide pașii pentru serviciul ales: contul, cheia gratuită, cota și ce "
"se întâmplă la depășire."
msgstr ""
"OK avab valitud teenuse sammud: konto, tasuta võti, kvoot ja mis juhtub "
"selle ületamisel."

msgid "OK deschide sau închide toți sateliții"
msgstr "OK avab või sulgeb kõik satelliidid"

msgid "OK deschide tastatura."
msgstr "OK avab klaviatuuri."

msgid ""
"OK deschide tastatura. ID-ul contului are 32 de litere și cifre: în panoul "
"Cloudflare, la „Account ID”."
msgstr ""
"OK avab klaviatuuri. Konto ID-l on 32 tähte ja numbrit: Cloudflare'i "
"paneelis, jaotises „Account ID\"."

msgid ""
"OK deschide tastatura. Textul apare când „Textul tău” e în lista de rotire."
msgstr ""
"OK avab klaviatuuri. Tekst kuvatakse, kui „Sinu tekst” on vaheldumise "
"loendis."

msgid ""
"OK deschide · Stânga / Dreapta: coloana · cifrele scriu numele · HELP ajutor"
msgstr "OK avab · Vasak / Parem: veerg · numbrid kirjutavad nime · HELP abi"

msgid "OK deschide · cifrele: poziția · < anulează · > refă · HELP ajutor"
msgstr "OK avab · numbrid: asukoht · < võta tagasi · > tee uuesti · HELP abi"

msgid "OK full screen, INFO details, EXIT back to the list"
msgstr "OK täisekraan, INFO üksikasjad, EXIT tagasi loendisse"

msgid ""
"OK ia rândul ca să-l muți · cifrele: poziția · < anulează · > refă · HELP "
"ajutor"
msgstr ""
"OK võtab rea liigutamiseks · numbrid: asukoht · < võta tagasi · > tee uuesti "
"· HELP abi"

msgid "OK instalează"
msgstr "OK paigaldab"

msgid "OK instalează fișierul"
msgstr "OK paigaldab faili"

msgid "OK le deschide"
msgstr "OK avab need"

msgid "OK o arată acum pe afișaj, o dată."
msgstr "OK näitab seda nüüd ekraanil ühe korra."

msgid "OK oprește VPN-ul. Internetul merge apoi direct, prin rețeaua ta."
msgstr "OK peatab VPN-i. Internet läheb seejärel otse, sinu võrgu kaudu."

msgid ""
"OK oprește. Oricine din rețeaua ta de acasă intră acum pe receptor fără "
"parolă."
msgstr ""
"OK lülitab välja. Kõik su koduvõrgus pääsevad nüüd vastuvõtjale ilma "
"paroolita."

msgid "OK pe o pagină: deschide-o sau scoate-o din favorite."
msgstr "OK lehel: ava see või eemalda lemmikutest."

msgid "OK pe rândul de sus: termenii și condițiile."
msgstr "OK ülemisel real: tingimused."

msgid ""
"OK pe un rând deschide tastatura. Parola nu se arată: o scrii numai când "
"vrei s-o schimbi; un rând gol o lasă cum e."
msgstr ""
"OK real avab klaviatuuri. Parooli ei kuvata: sisestad selle ainult siis, kui "
"soovid seda muuta; tühi rida jätab selle muutmata."

msgid "OK pornește VPN-ul cu serverul ales."
msgstr "OK käivitab VPN-i valitud serveriga."

msgid "OK pornește canalul · Stânga/Dreapta: pagina · Sus la filtre"
msgstr "OK käivitab kanali · Vasak/Parem: leht · Üles filtritesse"

msgid ""
"OK pornește sau oprește, pe loc. Se vede când e în lista de rotire (grupa "
"„Ora și data”)."
msgstr ""
"OK käivitab või peatab kohe. Kuvatakse, kui on vaheldusloendis (rühm "
"„Kellaaeg ja kuupäev”)."

msgid "OK probează"
msgstr "OK proovib"

msgid "OK pune contorul la zero."
msgstr "OK nullib loenduri."

#, python-format
msgid "OK pune ecranul „%s”. Se vede la următoarea pornire."
msgstr "OK määrab ekraani „%s”. See kuvatakse järgmisel käivitamisel."

msgid "OK salvează alegerile și închide ecranul."
msgstr "OK salvestab valikud ja sulgeb ekraani."

msgid "OK sau Albastru descarcă lista"
msgstr "OK või Sinine laeb loendi alla"

msgid "OK sau EXIT închide fereastra și anulează codul."
msgstr "OK või EXIT sulgeb akna ja tühistab koodi."

msgid "OK sau EXIT închide fereastra."
msgstr "OK või EXIT sulgeb akna."

msgid "OK sau EXIT: înapoi"
msgstr "OK või EXIT: tagasi"

msgid "OK sau EXIT: închide"
msgstr "OK või EXIT: sule"

msgid "OK sau Ieșire închide."
msgstr "OK või EXIT sulgeb."

msgid "OK sau TEXT: scrie"
msgstr "OK või TEXT: kirjuta"

msgid "OK sau VERDE: copia se face acum pe locul ales la „Locul copiei”."
msgstr ""
"OK või ROHELINE: koopia tehakse nüüd kohas, mis on valitud „Koopia asukoht” "
"all."

#, python-format
msgid "OK scoate sau pune lista. Furnizor: %s."
msgstr "OK eemaldab või lisab loendi. Pakkuja: %s."

msgid ""
"OK trimite o frază de probă serviciului ales. Răspunsul apare aici, iar "
"originalul și traducerea se văd jos, ca subtitrările."
msgstr ""
"OK saadab valitud teenusele proovilause. Vastus ilmub siia ning originaal ja "
"tõlge on näha all, nagu subtiitrid."

msgid ""
"OK încearcă din nou toate canalele, din casa ta. Cele oprite pentru țara ta "
"se pot vedea cu VPN-ul receptorului pornit."
msgstr ""
"OK proovib kõiki kanaleid uuesti sinu kodust. Sinu riigis blokeerituid saab "
"vaadata vastuvõtja VPN-i sisselülitamisega."

msgid ""
"OK șterge cheia. Calculatorul cu această cheie intră apoi numai cu parola."
msgstr ""
"OK kustutab võtme. Selle võtmega arvuti pääseb seejärel sisse ainult "
"parooliga."

msgid "OK — schimba valorile cu OK/stanga/dreapta, cauta cu Verde."
msgstr "OK - muuda väärtusi klahvidega OK/vasak/parem, otsi rohelise klahviga."

msgid "OK: alege · STÂNGA/DREAPTA: schimbă"
msgstr "OK: vali · VASAKULE/PAREMALE: muuda"

msgid "OK: alegi modelul din listă (sau îl scrii). Cel din fabrică: %s."
msgstr "OK: valid mudeli nimekirjast (või kirjutad selle). Vaikimisi: %s."

msgid "OK: alegi poza de pe stick."
msgstr "OK: vali USB-mälupulgalt pilt."

msgid ""
"OK: alegi regiunea din listă. O găsești în portal, la resursa Translator: "
"Overview › Location. Global pentru o resursă Global."
msgstr ""
"OK: valid piirkonna loendist. Leiad selle portaalist, Translator-ressursist: "
"Overview › Location. Global-ressursi korral Global."

msgid "OK: ce faci cu copia. GALBEN: pune la loc. ALBASTRU: șterge."
msgstr "OK: mida koopiaga teha. KOLLANE: taasta. SININE: kustuta."

msgid "OK: cod QR"
msgstr "OK: QR-kood"

msgid "OK: copia nu se mai pune la loc."
msgstr "OK: koopiat enam ei taastata."

msgid "OK: descarci, oprești sau ștergi modelul    EXIT: închide"
msgstr "OK: laadid alla, peatad või kustutad mudeli    EXIT: sulge"

msgid ""
"OK: intri în dosar sau pornești filmul.\n"
"INAPOI: dosarul de mai sus.\n"
"Subtitrările de lângă film se iau singure; tasta SUB le arată pe toate și "
"caută pe internet."
msgstr ""
"OK: avad kausta või käivitad filmi.\n"
"TAGASI: ülemine kaust.\n"
"Filmi kõrval olevad subtiitrid võetakse automaatselt; SUB-nupp näitab neid "
"kõiki ja otsib internetist."

msgid "OK: lista paginilor favorite."
msgstr "OK: lemmiklehtede loend."

msgid "OK: lista posturilor.   OK ținut apăsat: opțiunile."
msgstr "OK: kanaliloend.   OK all hoides: valikud."

#, python-format
msgid "OK: lista serverelor (%d). Fără servere, importă întâi fișierele."
msgstr ""
"OK: serverite loend (%d). Kui servereid pole, impordi kõigepealt failid."

msgid "OK: mută, durata sau scoate."
msgstr "OK: liiguta, kestus või eemalda."

msgid "OK: mută, durata, eticheta sau scoate."
msgstr "OK: liiguta, kestus, silt või eemalda."

msgid "OK: mărește poza."
msgstr "OK: suurenda pilti."

msgid "OK: mărește poza. Stânga și Dreapta: celelalte poze."
msgstr "OK: suurenda pilti. VASAK ja PAREM: teised pildid."

msgid "OK: pagina web a aparatului, în navigator."
msgstr "OK: seadme veebileht brauseris."

#, python-format
msgid "OK: pui ecranul „%s” sau îl ștergi din galerie."
msgstr "OK: määrad ekraani „%s” või kustutad selle galeriist."

#, python-format
msgid "OK: pui sau ștergi poza ta „%s”."
msgstr "OK: määrad või kustutad oma pildi „%s”."

msgid "OK: salvează. EXIT: renunță."
msgstr "OK: salvesta. EXIT: loobu."

msgid "OK: scrie mesajul cu tastatura de pe ecran."
msgstr "OK: kirjuta sõnum ekraaniklaviatuuriga."

msgid "OK: scrie titlul."
msgstr "OK: sisesta pealkiri."

msgid ""
"OK: scrii o cheie nouă sau o ștergi. Cheia se păstrează pe receptor, "
"criptată, și nu se mai arată niciodată. Albastru: cum îți faci cheia "
"gratuită."
msgstr ""
"OK: sisestad uue võtme või kustutad selle. Võtit hoitakse vastuvõtjas "
"krüpteeritult ja seda ei kuvata enam kunagi. Sinine: kuidas saad tasuta "
"võtme."

msgid "OK: tastatura"
msgstr "OK: klaviatuur"

msgid "OK: textul licenței    Stânga/Dreapta: pagina    EXIT: închide"
msgstr "OK: litsentsitekst    Vasak/Parem: leht    EXIT: sulge"

msgid ""
"OK: un cod QR pentru telefon. Pe telefon îți faci cheia și o lipești; "
"receptorul o probează pe loc."
msgstr ""
"OK: QR-kood telefonile. Telefonis teed endale võtme ja kleebid selle; "
"vastuvõtja testib seda kohe."

msgid "OK: îl adaugi"
msgstr "OK: lisad selle"

msgid "OK: întoarce lista la copia aleasă"
msgstr "OK: vii loend tagasi valitud koopiale"

msgid ""
"OK: șterge cookie-urile și datele salvate de aplicațiile HbbTV ale canalelor "
"(de exemplu alegerea din fereastra de consimțământ)."
msgstr ""
"OK: kustutab kanalite HbbTV-rakenduste salvestatud küpsised ja andmed "
"(näiteks nõusolekuaknas tehtud valiku)."

msgid ""
"OK: șterge istoricul, cookie-urile, datele site-urilor și mărirea ținută "
"minte."
msgstr "OK: kustutab ajaloo, küpsised, saidiandmed ja meeldejäetud suurenduse."

#, python-format
msgid ""
"ON ID %d, iar în lista satelitului e %d. Antena poate fi pe alt satelit."
msgstr ""
"ON ID %d, aga satelliidi loendis on %d. Antenn võib olla teisel satelliidil."

msgid "ON ID:"
msgstr "ON ID:"

msgid "ON sau OFF"
msgstr "ON või OFF"

msgid "ONID"
msgstr "ONID"

msgid "OSD Preferences"
msgstr "OSD eelistused"

msgid "OSD Settings"
msgstr "OSD seaded"

