msgstr ""
"Vastuvõtja lülitub täielikult välja ja lülitatakse uuesti sisse puldi "
"toitenupuga. Teleris: __DRUM_OPRIRE__."

msgid "Receptorul se oprește."
msgstr "Vastuvõtja lülitub välja."

msgid "Receptorul se pornește din nou din butonul de pornire al telecomenzii."
msgstr "Vastuvõtja lülitatakse uuesti sisse puldi toitenupust."

msgid ""
"Receptorul se repornește. Pagina se reîncarcă singură când răspunde din nou."
msgstr ""
"Vastuvõtja taaskäivitub. Leht laadib end ise uuesti, kui see uuesti vastab."

#, python-format
msgid ""
"Receptorul se răcește (%d °C). Procesorul revine la viteza obișnuită după %s."
msgstr "Vastuvõtja jahtub (%d °C). Protsessor naaseb tavakiirusele %s pärast."

#, python-format
msgid "Receptorul se răcește. Procesorul revine la viteza obișnuită după %s."
msgstr "Vastuvõtja jahtub. Protsessor naaseb tavakiirusele %s pärast."

#, python-format
msgid ""
"Receptorul transmite deja spre %s. Oprește acea transmisie din pagina TV în "
