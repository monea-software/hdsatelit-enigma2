msgstr "Häälestus: %s"

msgid ""
"Acordarea a eșuat.\n"
"Verifică semnalul pe cablu/satelit."
msgstr ""
"Häälestus ebaõnnestus.\n"
"Kontrolli signaali kaablis/satelliidil."

msgid "Acordează din nou"
msgstr "Häälesta uuesti"

msgid "Acordul"
msgstr "Nõusolek"

msgid "Action on long powerbutton press"
msgstr "Toitenupu pika vajutuse toiming"

msgid "Action on short powerbutton press"
msgstr "Toitenupu lühikese vajutuse toiming"

