#, python-format
msgid "Pe mediul ales nu e destul loc (trebuie cam %d MB)."
msgstr "Valitud andmekandjal pole piisavalt ruumi (vaja umbes %d MB)."

msgid ""
"Pe pagina deschisă alege proiectul tău (cu facturarea pornită) și pornește "
"„Cloud Translation API”, dacă nu e pornit."
msgstr ""
"Avatud lehel vali oma projekt (arveldamine sisse lülitatud) ja lülita sisse "
"„Cloud Translation API”, kui see pole sisse lülitatud."

msgid ""
"Pe pagina deschisă intră cu contul tău Google; prima dată accepți termenii."
msgstr ""
"Avatud lehel logi sisse oma Google'i kontoga; esimesel korral nõustu "
"tingimustega."

msgid "Pe pagina deschisă intră cu emailul sau cu contul tău Google."
msgstr "Avatud lehel logi sisse e-posti või oma Google'i kontoga."

msgid ""
"Pe pagina deschisă intră în contul Cloudflare (sau fă unul gratuit): se "
"deschide pagina „Workers AI”. Apasă „Use REST API”."
msgstr ""
"Avatud lehel logi sisse Cloudflare'i kontosse (või loo tasuta konto): avaneb "
"leht „Workers AI\". Vajuta „Use REST API\"."

msgid ""
"Pe pagina deschisă intră în contul DeepL API. Dacă nu ai unul, fă-l gratuit, "
"cu planul „Developer” (1.000.000 de caractere, o singură dată)."
msgstr ""
"Avatud lehel logi sisse DeepL API kontosse. Kui sul seda pole, loo see "
"tasuta, „Developer\" paketiga (1 000 000 tähemärki, ainult üks kord)."

msgid ""
"Pe pagina deschisă intră în contul DeepL API. Dacă nu ai unul, fă-l gratuit: "
"planul gratuit nu cere card."
msgstr ""
"Avatud lehel logi sisse DeepL API kontole. Kui sul seda pole, tee tasuta: "
"tasuta plaan ei küsi kaarti."

msgid ""
"Pe pagina deschisă: „Resource group”, „Create new”; „Region” Global; un "
"nume; „Pricing tier” Free F0; apoi „Review + create” și „Create”."
msgstr ""
"Avatud lehel: „Resource group”, „Create new”; „Region” Global; nimi; "
"„Pricing tier” Free F0; seejärel „Review + create” ja „Create”."

msgid "Pe placa de sunet"
msgstr "Helikiibil"

msgid "Pe poziția nouă sunt deja aceleași transpondere."
msgstr "Uuel asukohal on juba samad transponderid."

msgid ""
"Pe pozițiile antenei tale nu e niciun operator de acest fel care să se poată "
"căuta acum."
msgstr ""
"Sinu antenni asenditel pole ühtegi sellist pakkujat, keda saaks praegu "
"otsida."

