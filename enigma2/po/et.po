msgstr ""
"<code>POST /api/radio-urmatoarea?ce=vizualizator|culori</code>: järgmine "
"visualiseering või värvid (nagu kollane ja sinine nupp raadioekraanil)"

msgid ""
"<code>POST /api/scanare-fluxuri</code>: alegerea de la sfârșitul scanării "
"DAB+ / DVB-T2 de pe televizor (<code>actiune=asculta&amp;post=N</code>, "
"<code>inapoi</code>, <code>din_nou</code>, <code>porneste</code>)"
msgstr ""
"<code>POST /api/scanare-fluxuri</code>: valik DAB+ / DVB-T2 otsingu lõpus "
"teleris (<code>actiune=asculta&amp;post=N</code>, <code>inapoi</code>, "
"<code>din_nou</code>, <code>porneste</code>)"

msgid ""
"<code>POST /api/scanare-opreste</code>: oprește căutarea sau închide "
"rezultatul rămas pe televizor"
msgstr ""
"<code>POST /api/scanare-opreste</code>: peatab otsingu või sulgeb telerisse "
"jäänud tulemuse"

msgid ""
"<code>POST /api/scanare-porneste?scaner=&lt;scaner&gt;&amp;fel=&lt;fel&gt;"
"&amp;...</code>: pornește căutarea pe televizor (cu <code>confirmat=1</code> "
