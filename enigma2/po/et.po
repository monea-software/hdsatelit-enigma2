msgstr "Toiming:"

msgid "Activ"
msgstr "Sees"

msgid "Activ/Inactiv"
msgstr "Aktiivne/Inaktiivne"

msgid "Activare control parental"
msgstr "Luba lapsevanemakontroll"

msgid "Activare temporizator"
msgstr "Luba taimer"

msgid ""
"Activarea face în rădăcina discului ales fișierul <span id=\"fisier\"></"
"span> de <span id=\"marime\"></span> MB și îl pornește ca memorie virtuală. "
"Swap-ul nu repornește singur după o repornire a receptorului."
msgstr ""
"Lubamine loob valitud ketta juurkataloogi faili <span id=\"fisier\"></span> "
"suurusega <span id=\"marime\"></span> MB ja käivitab selle virtuaalmäluna. "
