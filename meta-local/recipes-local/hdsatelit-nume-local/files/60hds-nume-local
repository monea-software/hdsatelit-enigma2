# udhcpc: la o adresa noua (bound, renew) serviciul hdsatelit.local e trezit sa publice numele cu ea (pornit, daca nu
# merge). La pierderea adresei (deconfig) nu se opreste nimic (0.2.0, 11.11.2026): serviciul vede singur, in cateva
# secunde, ca adresa a disparut, retrage numele si asteapta adresa noua. Oprit aici, paznicul (hds-watchdog) l-ar
# crede cazut la fiecare pierdere a adresei si l-ar porni din nou.
case "$1" in
bound|renew)
	/etc/init.d/hds-nume-local start > /dev/null 2>&1 &
	;;
esac
exit 0
