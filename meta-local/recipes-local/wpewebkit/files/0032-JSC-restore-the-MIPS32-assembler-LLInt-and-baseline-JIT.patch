+            /*
+                li  immTemp, imm
+                li  addrTemp, address
+                sb  src, 0(addrTemp)
+            */
+            TrustedImm32 imm8(static_cast<int8_t>(imm.m_value));
+            move(imm8, immTempRegister);
+            move(TrustedImmPtr(address), addrTempRegister);
+            m_assembler.sb(immTempRegister, addrTempRegister, 0);
