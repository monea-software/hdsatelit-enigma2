+GstClockTime MediaPlayerPrivateGStreamer::hdsBoardSinkSegmentTime() const
+{
+    // The sink whose decoder time is used (GStreamerQuirkHdsDvb::decoderPosition): the sound sink first, then the video one.
+    for (auto* sink : { m_audioSink.get(), m_videoSink.get() }) {
+        if (!sink || !GST_IS_BASE_SINK(sink))
+            continue;
+        if (!gstElementFactoryEquals(sink, "dvbaudiosink"_s) && !gstElementFactoryEquals(sink, "dvbvideosink"_s))
+            continue;
+        gint64 position = -1;
+        g_signal_emit_by_name(sink, "get-decoder-time", &position);
+        if (position < 0)
+            continue;
+        GST_OBJECT_LOCK(sink);
+        GstClockTime time = GST_BASE_SINK_CAST(sink)->segment.format == GST_FORMAT_TIME ? GST_BASE_SINK_CAST(sink)->segment.time : GST_CLOCK_TIME_NONE;
+        GST_OBJECT_UNLOCK(sink);
+        return time;
+    }
+    return GST_CLOCK_TIME_NONE;
+}
+
+void MediaPlayerPrivateGStreamer::hdsMarkSeek(float rate)
+{
+    m_hdsSeekFloorActive = false;
+    auto& quirksManager = GStreamerQuirksManager::singleton();
+    if (!quirksManager.isEnabled() || rate < 0)
+        return;
+    auto position = quirksManager.decoderPosition(m_audioSink.get(), m_videoSink.get());
+    if (!position)
+        return;
+    if (isMediaSource() && GST_CLOCK_TIME_IS_VALID(*position)) {
+        if (auto base = hdsBoardSinkSegmentTime(); GST_CLOCK_TIME_IS_VALID(base))
+            position = *position + base;
+    }
+    m_hdsStaleDecoderPosition = *position;
+    m_hdsSeekFloorActive = true;
+}
+
 GstClockTime MediaPlayerPrivateGStreamer::gstreamerPositionFromSinks() const
 {
     auto& quirksManager = GStreamerQuirksManager::singleton();
     if (quirksManager.isEnabled()) {
         if (auto decoderPosition = quirksManager.decoderPosition(m_audioSink.get(), m_videoSink.get())) {
+            // Media Source Extensions: the board sink keeps its time from the segment start (dvbmediasink: decoder time =
+            // PTS - (segment start - segment position), and WebKitMediaSrc sends segments with position 0), so after a
+            // seek the decoder counts from 0 again. The stream time is that count plus the segment time.
+            if (isMediaSource() && GST_CLOCK_TIME_IS_VALID(*decoderPosition)) {
+                if (auto base = hdsBoardSinkSegmentTime(); GST_CLOCK_TIME_IS_VALID(base))
+                    decoderPosition = *decoderPosition + base;
+            }
             // Before its first picture a decoder may give a position far beyond the media.
             if (GST_CLOCK_TIME_IS_VALID(*decoderPosition) && m_cachedDuration.isValid() && m_cachedDuration.isFinite()
                 && MediaTime(*decoderPosition, GST_SECOND) > m_cachedDuration + MediaTime(5, 1))
                 return GST_CLOCK_TIME_NONE;
+            if (m_hdsSeekFloorActive && m_seekTarget.time.isValid()) {
+                // After a seek: the time of the old picture (unchanged since the seek) or a time before the target (the
+                // key frame before it) is not the position yet. Pages such as Shaka Player take a position that goes
+                // back for a stall, seek again, and the film stops.
+                auto target = toGstClockTime(m_seekTarget.time);
+                bool stale = GST_CLOCK_TIME_IS_VALID(*decoderPosition) && GST_CLOCK_TIME_IS_VALID(m_hdsStaleDecoderPosition)
+                    && GST_CLOCK_DIFF(*decoderPosition, m_hdsStaleDecoderPosition) < static_cast<GstClockTimeDiff>(200 * GST_MSECOND)
+                    && GST_CLOCK_DIFF(m_hdsStaleDecoderPosition, *decoderPosition) < static_cast<GstClockTimeDiff>(200 * GST_MSECOND);
+                if (!GST_CLOCK_TIME_IS_VALID(*decoderPosition) || stale || *decoderPosition + 500 * GST_MSECOND < target)
+                    return target;
+                m_hdsSeekFloorActive = false;
+            }
             return *decoderPosition;
         }
     }
