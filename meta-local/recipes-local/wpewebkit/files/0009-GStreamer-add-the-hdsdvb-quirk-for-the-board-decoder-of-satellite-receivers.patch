@@ -623,6 +623,7 @@
         flag = GST_SEEK_FLAG_FLUSH;
     }
     auto seekFlags = static_cast<GstSeekFlags>(flag | GST_SEEK_FLAG_ACCURATE);
+    seekFlags = GStreamerQuirksManager::singleton().playbackSeekFlags(seekFlags);
 
     // Seeking towards the end is not well supported in oggdemux, sometimes it receives EOS
     // while trying to retrieve a chain and thus disables seeking in push mode.
@@ -682,6 +683,16 @@
     }
 
     auto result = gst_element_send_event(m_pipeline.get(), event.leakRef());
+    if (result && GStreamerQuirksManager::singleton().completesSeekWithoutPreroll()) {
+        // No ASYNC_DONE follows the flush on these sinks, and no state change either: the seek is complete once the
+        // flush went through the pipeline.
+        RunLoop::mainSingleton().dispatchAfter(100_ms, [weakThis = ThreadSafeWeakPtr { *this }, time = target.time] {
+            RefPtr self = weakThis.get();
+            if (!self || !self->m_isSeeking || self->m_isSeekPending || self->m_seekTarget.time != time)
+                return;
+            self->finishSeek();
+        });
+    }
     if (isSegment || !isSeamlessSeekingEnabled() || !result)
         return result;
 
@@ -1686,6 +1697,17 @@
 
