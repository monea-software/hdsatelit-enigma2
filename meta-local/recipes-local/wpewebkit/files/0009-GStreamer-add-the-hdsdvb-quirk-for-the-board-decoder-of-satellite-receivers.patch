+
+#include "config.h"
+#include "GStreamerHdsDvbDecoder.h"
+
+#if USE(GSTREAMER)
+
+#include "GStreamerCommon.h"
+#include <errno.h>
+#include <poll.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <wtf/MonotonicTime.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/text/MakeString.h>
+
+namespace WebCore {
+
+GST_DEBUG_CATEGORY_STATIC(webkit_hdsdvb_decoder_debug);
+#define GST_CAT_DEFAULT webkit_hdsdvb_decoder_debug
+
+// The receiver answers once it stopped the channel and changed the rights of the devices, which takes well under a
+// second; the wait blocks the thread that builds the pipeline, so it stays short.
+static constexpr Seconds answerTimeout = 5_s;
+static constexpr size_t answerMaximumLength = 64;
+
+HdsDvbDecoder& HdsDvbDecoder::singleton()
+{
+    static NeverDestroyed<HdsDvbDecoder> decoder;
+    return decoder;
+}
+
+HdsDvbDecoder::HdsDvbDecoder()
+{
+    GST_DEBUG_CATEGORY_INIT(webkit_hdsdvb_decoder_debug, "webkithdsdvbdecoder", 0, "WebKit receiver decoder loan");
+
+    const char* path = g_getenv("HDS_DECODOR");
+    if (path && *path == '/' && strlen(path) < sizeof(sockaddr_un::sun_path))
+        m_socketPath = path;
+    GST_DEBUG("Decoder loan socket: %s", m_socketPath.isNull() ? "none" : m_socketPath.data());
+}
+
+bool HdsDvbDecoder::isLent()
+{
+    Locker locker { m_lock };
+    return m_socket >= 0;
+}
+
+void HdsDvbDecoder::closeLocked()
+{
+    if (m_socket >= 0)
+        close(m_socket);
+    m_socket = -1;
+    m_sentRectangle = std::nullopt;
+}
+
+bool HdsDvbDecoder::sendLocked(const char* line)
+{
+    if (m_socket < 0)
+        return false;
+
+    size_t length = strlen(line);
+    size_t written = 0;
+    while (written < length) {
+        ssize_t result = send(m_socket, line + written, length - written, MSG_NOSIGNAL);
+        if (result < 0 && errno == EINTR)
+            continue;
+        if (result <= 0) {
+            GST_WARNING("The connection to the receiver is lost: %s", g_strerror(errno));
+            closeLocked();
+            return false;
+        }
+        written += result;
+    }
+    return true;
+}
+
+bool HdsDvbDecoder::borrowLocked()
+{
+    if (m_socket >= 0)
+        return true;
+    if (m_socketPath.isNull())
+        return false;
+
+    int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (fd < 0) {
+        GST_WARNING("socket(): %s", g_strerror(errno));
+        return false;
+    }
+
+    struct sockaddr_un address;
+    memset(&address, 0, sizeof(address));
+    address.sun_family = AF_UNIX;
+    memcpy(address.sun_path, m_socketPath.data(), m_socketPath.length());
+    if (connect(fd, reinterpret_cast<struct sockaddr*>(&address), sizeof(address)) < 0) {
+        GST_WARNING("The receiver does not lend its decoder (connect: %s)", g_strerror(errno));
+        close(fd);
+        return false;
+    }
+
+    m_socket = fd;
+    if (!sendLocked("cere\n"))
+        return false;
+
+    char answer[answerMaximumLength];
+    size_t length = 0;
+    bool lineComplete = false;
+    auto deadline = MonotonicTime::now() + answerTimeout;
+    while (length < answerMaximumLength - 1) {
+        auto remaining = deadline - MonotonicTime::now();
+        if (remaining <= 0_s)
+            break;
+        struct pollfd descriptor = { fd, POLLIN, 0 };
+        int ready = poll(&descriptor, 1, static_cast<int>(remaining.milliseconds()) + 1);
+        if (ready < 0 && errno == EINTR)
+            continue;
+        if (ready <= 0)
+            break;
+        ssize_t result = read(fd, answer + length, 1);
+        if (result < 0 && errno == EINTR)
+            continue;
+        if (result <= 0)
+            break;
+        if (answer[length] == '\n') {
+            lineComplete = true;
+            break;
+        }
+        length++;
+    }
+    answer[length] = '\0';
+
+    if (!lineComplete || strcmp(answer, "ok")) {
+        GST_WARNING("The receiver does not lend its decoder: %s", lineComplete ? answer : "no answer");
+        closeLocked();
+        return false;
+    }
+
+    GST_INFO("The receiver lent its decoder");
+    sendRectangleLocked();
+    return true;
+}
+
+void HdsDvbDecoder::giveBackLocked()
+{
+    if (m_socket < 0)
+        return;
+    sendLocked("gata\n");
+    closeLocked();
+    GST_INFO("Decoder given back to the receiver");
+}
+
+GstElement* HdsDvbDecoder::createSink(ASCIILiteral factoryName)
+{
+    Locker locker { m_lock };
+    if (!borrowLocked())
+        return nullptr;
+
+    GstElement* sink = makeGStreamerElement(factoryName);
+    if (!sink) {
+        GST_WARNING("No %s element", factoryName.characters());
+        if (!m_sinkCount)
+            giveBackLocked();
+        return nullptr;
+    }
+
+    m_sinkCount++;
+    g_object_weak_ref(G_OBJECT(sink), sinkFinalized, this);
+    GST_DEBUG("%s created, %u board sinks", factoryName.characters(), m_sinkCount);
+    return sink;
+}
+
+void HdsDvbDecoder::sinkFinalized(gpointer data, GObject*)
+{
+    auto& decoder = *static_cast<HdsDvbDecoder*>(data);
+    Locker locker { decoder.m_lock };
+    if (!decoder.m_sinkCount)
+        return;
+    if (!--decoder.m_sinkCount)
+        decoder.giveBackLocked();
+}
+
+void HdsDvbDecoder::sendRectangleLocked()
+{
+    if (m_socket < 0 || !m_rectangle || m_sentRectangle == m_rectangle)
+        return;
+
+    auto line = makeString("fereastra "_s, m_rectangle->x(), ' ', m_rectangle->y(), ' ', m_rectangle->width(), ' ', m_rectangle->height(), '\n');
+    if (sendLocked(line.utf8().data()))
+        m_sentRectangle = m_rectangle;
+}
+
+void HdsDvbDecoder::setVideoRectangle(const IntRect& rectangle)
+{
+    Locker locker { m_lock };
+    m_rectangle = rectangle;
+    sendRectangleLocked();
+}
+
+#undef GST_CAT_DEFAULT
+
+} // namespace WebCore
+
+#endif // USE(GSTREAMER)
