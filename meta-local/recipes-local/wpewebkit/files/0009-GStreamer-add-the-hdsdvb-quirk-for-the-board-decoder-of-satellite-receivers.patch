+std::optional<GstClockTime> GStreamerQuirksManager::decoderPosition(GstElement* audioSink, GstElement* videoSink) const
+{
+    for (const auto& quirk : m_quirks) {
+        if (auto position = quirk->decoderPosition(audioSink, videoSink))
+            return position;
+    }
+    return std::nullopt;
