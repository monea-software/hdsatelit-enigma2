 {
+    auto& quirksManager = GStreamerQuirksManager::singleton();
+    if (quirksManager.isEnabled()) {
+        if (auto decoderPosition = quirksManager.decoderPosition(m_audioSink.get(), m_videoSink.get())) {
+            // Before its first picture a decoder may give a position far beyond the media.
