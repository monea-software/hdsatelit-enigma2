+#include "config.h"
+#include "GStreamerQuirkHdsDvb.h"
+
+#if USE(GSTREAMER)
+
+#include "GStreamerCommon.h"
+#include "GStreamerHdsDvbDecoder.h"
+#include <array>
+#include <mutex>
+#include <wtf/text/StringView.h>
+
+namespace WebCore {
+
+GST_DEBUG_CATEGORY_STATIC(webkit_hdsdvb_quirks_debug);
+#define GST_CAT_DEFAULT webkit_hdsdvb_quirks_debug
+
+GStreamerQuirkHdsDvb::GStreamerQuirkHdsDvb()
+{
+    GST_DEBUG_CATEGORY_INIT(webkit_hdsdvb_quirks_debug, "webkitquirkshdsdvb", 0, "WebKit receiver board quirks");
+}
+
+static bool isBoardSink(GstElement* element)
+{
+    return element && (gstElementFactoryEquals(element, "dvbvideosink"_s) || gstElementFactoryEquals(element, "dvbaudiosink"_s));
+}
+
+bool GStreamerQuirkHdsDvb::isPlatformSupported() const
+{
+    if (!HdsDvbDecoder::singleton().isConfigured()) {
+        GST_DEBUG("HDS_DECODOR is not set, the receiver decoder cannot be borrowed");
+        return false;
+    }
+
+    GRefPtr videoSinkFactory = adoptGRef(gst_element_factory_find("dvbvideosink"));
+    GRefPtr audioSinkFactory = adoptGRef(gst_element_factory_find("dvbaudiosink"));
+    if (!videoSinkFactory || !audioSinkFactory)
+        return false;
+
+    static std::once_flag rankFlag;
+    std::call_once(rankFlag, [] {
+        // Streams that would be decoded on the processor (the board takes compressed video only, and four processor
+        // cores do not decode HD video), and the codecs whose way to the board decoder was not measured on the
+        // receiver (HEVC, VP9, AV1): neither the codec registry nor decodebin may choose these elements.
+        static const std::array<ASCIILiteral, 19> disabledElements {
+            "h265parse"_s,
+            "vp9parse"_s,
+            "av1parse"_s,
+            "theoraparse"_s,
+            "vp8dec"_s,
+            "vp9dec"_s,
+            "theoradec"_s,
+            "av1dec"_s,
+            "dav1ddec"_s,
+            "openh264dec"_s,
+            "libde265dec"_s,
+            "mpeg2dec"_s,
+            "avdec_h264"_s,
+            "avdec_h265"_s,
+            "avdec_vp8"_s,
+            "avdec_vp9"_s,
+            "avdec_av1"_s,
+            "avdec_mpeg2video"_s,
+            "avdec_mpeg4"_s,
+        };
+        for (const auto& name : disabledElements) {
+            if (GRefPtr factory = adoptGRef(gst_element_factory_find(name.characters()))) {
+                gst_plugin_feature_set_rank(GST_PLUGIN_FEATURE_CAST(factory.get()), GST_RANK_NONE);
+                GST_DEBUG("%s kept out", name.characters());
+            }
+        }
+    });
+
+    GST_INFO("Receiver board quirk enabled");
+    return true;
+}
+
+GstElement* GStreamerQuirkHdsDvb::createAudioSink()
+{
+    if (auto* sink = HdsDvbDecoder::singleton().createSink("dvbaudiosink"_s))
+        return sink;
+
+    // Without the loan the board is not touched (the channel plays on it): the sound goes nowhere, and the video sink,
+    // which can reach the player, reports the error.
+    GstElement* sink = makeGStreamerElement("fakesink"_s);
+    if (sink)
+        g_object_set(sink, "sync", TRUE, nullptr);
+    return sink;
+}
+
+std::optional<bool> GStreamerQuirkHdsDvb::isHardwareAccelerated(GstElementFactory* factory)
+{
+    auto view = StringView::fromLatin1(GST_OBJECT_NAME(factory));
+    if (view.startsWith("dvb"_s))
+        return true;
+
+    // These parsers stand for the decoders in the codec registry: what they parse goes to the board decoder.
+    if (view == "h264parse"_s || view == "mpegvideoparse"_s || view == "mpeg4videoparse"_s)
+        return true;
+
+    return std::nullopt;
+}
+
+std::optional<GstClockTime> GStreamerQuirkHdsDvb::decoderPosition(GstElement* audioSink, GstElement* videoSink) const
+{
+    // The board sinks answer position queries with what was written to the driver (a whole short clip after a second)
+    // instead of what is shown. The decoder tells its presentation time through the get-decoder-time action signal;
+    // the sound decoder first, as the receiver player does, then the video decoder.
+    bool hasBoardSink = false;
+    for (auto* sink : { audioSink, videoSink }) {
+        if (!isBoardSink(sink))
+            continue;
+        hasBoardSink = true;
+        gint64 position = -1;
+        g_signal_emit_by_name(sink, "get-decoder-time", &position);
+        if (position >= 0 && GST_CLOCK_TIME_IS_VALID(static_cast<GstClockTime>(position)))
+            return static_cast<GstClockTime>(position);
+    }
+
+    if (!hasBoardSink)
+        return std::nullopt;
+    return GST_CLOCK_TIME_NONE;
+}
+
+GstSeekFlags GStreamerQuirkHdsDvb::playbackSeekFlags(GstSeekFlags flags) const
+{
+    // After an accurate seek the demuxer starts at the key frame before the target, in a segment that starts at the
+    // target; the base sink drops the buffers before the segment, the key frame among them, and the board decoder,
+    // left without it, shows nothing until the next key frame. Seek to the key frame instead, as the receiver
+    // player does.
+    unsigned result = flags & ~GST_SEEK_FLAG_ACCURATE;
+    result |= GST_SEEK_FLAG_KEY_UNIT | GST_SEEK_FLAG_SNAP_BEFORE;
+    return static_cast<GstSeekFlags>(result);
+}
