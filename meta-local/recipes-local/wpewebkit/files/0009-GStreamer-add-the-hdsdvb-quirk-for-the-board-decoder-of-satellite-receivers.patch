+// Satellite receivers whose board decodes the compressed streams written to /dev/dvb/adapter0/video0 and audio0 by
+// dvbvideosink and dvbaudiosink (dvbmediasink). Nothing is decoded on the processor: playbin stops at the compressed
+// caps the sinks accept, the parsers stand for the decoders in the codec registry, and the decoders that would decode
+// video on the processor are kept out. The sinks are made only while the receiver lends its decoder (HdsDvbDecoder).
+// Selected with WEBKIT_GST_QUIRKS=hdsdvb, together with WEBKIT_GST_HOLE_PUNCH_QUIRK=hdsdvb.
+class GStreamerQuirkHdsDvb final : public GStreamerQuirk {
+public:
+    GStreamerQuirkHdsDvb();
+    const ASCIILiteral identifier() const final { return "HdsDvb"_s; }
+    bool isPlatformSupported() const final;
+
+    GstElement* createAudioSink() final;
+    std::optional<bool> isHardwareAccelerated(GstElementFactory*) final;
+    std::optional<GstElementFactoryListType> audioVideoDecoderFactoryListType() const final { return GST_ELEMENT_FACTORY_TYPE_PARSER; }
+    unsigned getAdditionalPlaybinFlags() const final { return getGstPlayFlag("text") | getGstPlayFlag("native-video") | getGstPlayFlag("native-audio"); }
+
+    std::optional<GstClockTime> decoderPosition(GstElement* audioSink, GstElement* videoSink) const final;
+    GstSeekFlags playbackSeekFlags(GstSeekFlags) const final;
+    bool completesSeekWithoutPreroll() const final { return true; }
+};
