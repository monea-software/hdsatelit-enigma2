+#pragma once
+
+#if USE(GSTREAMER)
+
+#include "IntRect.h"
+#include <gst/gst.h>
+#include <optional>
+#include <wtf/Forward.h>
+#include <wtf/Lock.h>
+#include <wtf/Noncopyable.h>
+#include <wtf/text/ASCIILiteral.h>
+#include <wtf/text/CString.h>
+
+namespace WebCore {
+
+// The video and audio decoders of a satellite receiver board (/dev/dvb/adapter0/video0 and audio0) belong to the
+// receiver software, which plays the TV channel on them. The web process may use them only while the receiver lends
+// them. The loan goes over the UNIX socket named by the HDS_DECODOR environment variable, one text line per message:
+//   web process -> receiver: "cere" (borrow the decoder), "fereastra X Y WIDTH HEIGHT" (where the video is, in CSS
+//                            pixels of the page), "gata" (the decoder is given back);
+//   receiver -> web process: "ok" once the channel is stopped and the two devices may be opened, or "nu REASON".
+// The loan lasts as long as the connection. It is given back when the last board sink made here is finalized, which
+// happens after the sink closed its device (state NULL). The receiver alone moves the video plane, so the position of
+// the video travels on the same connection.
+class HdsDvbDecoder {
+    WTF_MAKE_NONCOPYABLE(HdsDvbDecoder);
+    friend NeverDestroyed<HdsDvbDecoder>;
+public:
+    static HdsDvbDecoder& singleton();
+
+    // HDS_DECODOR is set: the board sinks may be used, through the loan.
+    bool isConfigured() const { return !m_socketPath.isNull(); }
+    // The decoder is lent to this process right now.
+    bool isLent();
+
+    // A board sink ("dvbvideosink" or "dvbaudiosink") once the decoder is lent, otherwise nullptr.
+    GstElement* createSink(ASCIILiteral factoryName);
+    void setVideoRectangle(const IntRect&);
+
+private:
+    HdsDvbDecoder();
+
+    bool borrowLocked();
+    void giveBackLocked();
+    bool sendLocked(const char*);
+    void sendRectangleLocked();
+    void closeLocked();
+    static void sinkFinalized(gpointer, GObject*);
+
+    CString m_socketPath;
+    Lock m_lock;
+    int m_socket { -1 };
+    unsigned m_sinkCount { 0 };
+    std::optional<IntRect> m_rectangle;
+    std::optional<IntRect> m_sentRectangle;
+};
+
+} // namespace WebCore
+
+#endif // USE(GSTREAMER)
