+namespace WebCore {
+
+// The video of a satellite receiver board is a plane under the graphics: dvbvideosink writes the compressed stream to
+// the board decoder, the page is cleared (alpha 0) where the video is, and the receiver places the video plane there.
+// The web page is painted without compositing on these receivers, so the hole is made when the video element paints.
+class GStreamerHolePunchQuirkHdsDvb final : public GStreamerHolePunchQuirk {
+public:
+    const ASCIILiteral identifier() const final { return "HdsDvbHolePunch"_s; }
+
+    GstElement* createHolePunchVideoSink(bool, const MediaPlayer*) final;
+    bool setHolePunchVideoRectangle(GstElement*, const IntRect&) final;
+    bool requiresClockSynchronization() const final { return false; }
+    std::optional<bool> paintsVideoHole() const final;
+};
+
+} // namespace WebCore
