+#include "MediaPlayerPrivateGStreamer.h"
+#include <wtf/glib/GUniquePtr.h>
+
+namespace WebCore {
+
+GstElement* GStreamerHolePunchQuirkHdsDvb::createHolePunchVideoSink(bool, const MediaPlayer* player)
+{
+    if (auto* sink = HdsDvbDecoder::singleton().createSink("dvbvideosink"_s))
+        return sink;
+
+    // The receiver did not lend its decoder (no application on screen, the decoder memory is missing, the receiver
+    // software does not answer). dvbvideosink would play to nothing when it cannot open its device, without an error:
+    // the page gets a decoding error instead, and the board is not touched.
+    if (player) {
+        auto* playerPrivate = static_cast<const MediaPlayerPrivateGStreamer*>(player->playerPrivate());
+        if (playerPrivate && playerPrivate->pipeline()) {
+            GstElement* pipeline = playerPrivate->pipeline();
+            GUniquePtr<GError> error(g_error_new_literal(GST_STREAM_ERROR, GST_STREAM_ERROR_DECODE, "The receiver decoder is not available"));
+            gst_element_post_message(pipeline, gst_message_new_error(GST_OBJECT_CAST(pipeline), error.get(), "hdsdvb: decoder loan refused"));
+        }
+    }
+    return makeGStreamerElement("fakesink"_s);
+}
+
+bool GStreamerHolePunchQuirkHdsDvb::setHolePunchVideoRectangle(GstElement*, const IntRect& rect)
+{
+    HdsDvbDecoder::singleton().setVideoRectangle(rect);
+    return true;
+}
+
+std::optional<bool> GStreamerHolePunchQuirkHdsDvb::paintsVideoHole() const
+{
+    // The hole only while the board shows the video of this process; otherwise the area keeps the page content.
+    return HdsDvbDecoder::singleton().isLent();
+}
+
+} // namespace WebCore
+
+#endif // USE(GSTREAMER)
