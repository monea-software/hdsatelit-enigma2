#!/bin/sh

[ "x$IFACE" = "xlo" ] && exit 0
[ "x$IFACE" = "x--all" ] && exit 0
# IPv6 oprit din fabrica: fara semnul /etc/hds-ipv6-pornit clientul DHCPv6 nu porneste (si /usr/bin/odhcp6c are poarta)
[ -e /etc/hds-ipv6-pornit ] || exit 0
grep -Eq '^iface  *'${IFACE}'  *inet6  *' /etc/network/interfaces && exit 0

odhcp6c -s /usr/sbin/odhcp6c-update -Nnone -d -p /var/run/odhcp6c.${IFACE}.pid ${IFACE}
exit 0

