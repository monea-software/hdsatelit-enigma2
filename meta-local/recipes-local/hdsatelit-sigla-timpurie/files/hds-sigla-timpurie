# One frame after the H8 drivers, before the network and GUI. No flash access.
case "$1" in start|stop|refresh|'') ;; *) exit 0 ;; esac
r=${HDS_SIGLA_RADACINA:-}
paznic=${HDS_SIGLA_PAZNIC:-/usr/libexec/hds-sigla-paznic.py}
if [ "$1" = stop ]; then
    [ -f "$paznic" ] || exit 1
    exec python3 "$paznic" stop "$r" '' '' '' ''
fi
model=$(cat "$r/proc/stb/info/model" 2>/dev/null)
chip=$(cat "$r/proc/stb/info/chipset" 2>/dev/null)
case "$model:$chip" in h8:hi3716mv430|h8se:hi3798mv200) ;; *) exit 0 ;; esac
sigla="$r/usr/share/backdrop.mvi"
player="$r/usr/bin/showiframe"
[ -s "$sigla" ] && [ -x "$player" ] || exit 0
[ -f "$paznic" ] || exit 0

# Use only the saved, supported TV modes; do not force a new default.
mode=$(head -n 1 "$r/etc/videomode" 2>/dev/null)
choices=$(cat "$r/proc/stb/video/videomode_choices" 2>/dev/null | tr '\n' ' ')
case " $choices " in *" $mode "*) ;; *) mode= ;; esac
case "$mode" in
    576i50|576p50|720p50|720p60|1080i50|1080i60|1080p24|1080p25|1080p30|1080p50|1080p60|2160p24|2160p25|2160p30|2160p50|2160p60)
        node="$r/proc/stb/video/videomode"
        if [ -w "$node" ] && [ "$(cat "$node" 2>/dev/null)" != "$mode" ]; then
            printf '%s\n' "$mode" > "$node"
        fi ;;
esac

bind="$r/sys/class/vtconsole/vtcon1/bind"
old=$(cat "$bind" 2>/dev/null)
if ! python3 "$paznic" "${1:-start}" "$r" "$player" "$sigla" "$bind" "$old"; then
    case "$old" in 0|1) [ ! -w "$bind" ] || printf '%s\n' "$old" > "$bind" ;; esac
fi
exit 0
