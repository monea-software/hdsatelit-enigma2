+/* HD Satelit: interfata subtitrarilor din enigma2-ul nostru (ca servicemp3.cpp): tuplul unei piste este
+   (type, pid, page_number, magazine_number, language_code), adica (2, numarul, felul, 0, limba). */
+static PyObject *hds_tuplu_pista(const SubtitleTrack &t)
+{
+	ePyObject tuple = PyTuple_New(5);
+	PyTuple_SET_ITEM(tuple, 0, PyLong_FromLong(t.type));
+	PyTuple_SET_ITEM(tuple, 1, PyLong_FromLong(t.pid));
+	PyTuple_SET_ITEM(tuple, 2, PyLong_FromLong(t.page_number));
+	PyTuple_SET_ITEM(tuple, 3, PyLong_FromLong(t.magazine_number));
+	PyTuple_SET_ITEM(tuple, 4, PyUnicode_FromString(t.language_code.c_str()));
+	return tuple;
+}
+
+PyObject *eServiceApp::getSubtitleList()
+{
+	ePyObject l = PyList_New(0);
+	std::vector<SubtitleTrack> piste;
+	if (getSubtitleTrackList(piste) < 0)
+		return l;
+	for (std::vector<SubtitleTrack>::const_iterator it = piste.begin(); it != piste.end(); ++it)
+	{
+		ePyObject tuple = hds_tuplu_pista(*it);
+		PyList_Append(l, tuple);
+		Py_DECREF(tuple);
+	}
+	return l;
+}
+
+PyObject *eServiceApp::getCachedSubtitle()
+{
+	SubtitleTrack t;
+	if (getCachedSubtitleTrack(t) == 0)
+		return hds_tuplu_pista(t);
+	Py_RETURN_NONE;
+}
+
+RESULT eServiceApp::enableSubtitles(eWidget *parent, ePyObject tuple)
+{
+	if (!parent || !PyTuple_Check(tuple) || PyTuple_Size(tuple) < 4)
+	{
+		eWarning("eServiceApp::enableSubtitles - needs (type, pid, page, magazine[, language])");
+		return -1;
+	}
+	SubtitleTrack t;
+	t.type = PyLong_AsLong(PyTuple_GET_ITEM(tuple, 0));
+	t.pid = PyLong_AsLong(PyTuple_GET_ITEM(tuple, 1));
+	t.page_number = PyLong_AsLong(PyTuple_GET_ITEM(tuple, 2));
+	t.magazine_number = PyLong_AsLong(PyTuple_GET_ITEM(tuple, 3));
+	if (PyTuple_Size(tuple) > 4 && PyUnicode_Check(PyTuple_GET_ITEM(tuple, 4)))
+	{
+		const char *limba = PyUnicode_AsUTF8(PyTuple_GET_ITEM(tuple, 4));
+		if (limba)
+			t.language_code = limba;
+	}
+	if (PyErr_Occurred())
+	{
+		PyErr_Print();
+		return -1;
+	}
+	disableSubtitlesTrack();
+	eSubtitleWidget *w = new eSubtitleWidget(parent);
+	w->resize(parent->size());
+	if (enableSubtitlesTrack(w, t) < 0)
+	{
+		delete w;
+		return -1;
+	}
+	return 0;
+}
+
+RESULT eServiceApp::disableSubtitles(eWidget *parent)
+{
+	(void)parent;
+	return disableSubtitlesTrack();
+}
+
+PyObject *eServiceApp::getBufferCharge()
+{
+	ePyObject tuple = PyTuple_New(5);
+	for (int i = 0; i < 5; i++)
+		PyTuple_SET_ITEM(tuple, i, PyLong_FromLong(0));
+	return tuple;
+}
