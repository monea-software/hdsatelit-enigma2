+/* Copyright (C) 2026 moneasoftware.com (Monea Eduard) & hdsatelit.com (HD Satelit)
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * ServiceApp pe enigma2-ul HD Satelit. Enigma2-ul nostru are interfata veche a subtitrarilor (iSubtitleOutput cu
+ * enableSubtitles(eWidget *parent, ePyObject tuple), PyObject *getSubtitleList(), ca servicemp3.cpp al nostru) si nu
+ * are struct SubtitleTrack si iSubtitleUser, pe care ServiceApp le foloseste inauntru. Aici e pista, ca in enigma2-ul
+ * nou; fereastra subtitrarilor e eSubtitleWidget al nostru (setPage(ePangoSubtitlePage)), facuta in serviceapp.cpp
+ * din parintele dat de Python.
+ */
+#ifndef __hds_compat_h
+#define __hds_compat_h
+
+#include <string>
+#include <tuple>
+#include <cstdlib>
+#include <lib/gui/esubtitle.h>
+#include <lib/base/nconfig.h>
+
+struct SubtitleTrack
+{
+	int type;
+	int pid;
+	int page_number;
+	int magazine_number;
+	std::string language_code;
+	SubtitleTrack(): type(0), pid(0), page_number(0), magazine_number(0) {}
+	bool operator<(const SubtitleTrack &o) const
+	{
+		return std::tie(type, pid, page_number, magazine_number, language_code) <
+			std::tie(o.type, o.pid, o.page_number, o.magazine_number, o.language_code);
+	}
+};
+
+/* eConfigManager (enigma2-ul nou) nu exista la noi: aceeasi citire prin ePythonConfigQuery; o setare care lipseste
+   (la noi nu sunt config.subtitles.pango_subtitles_delay / _fps) intoarce valoarea data */
+class eConfigManager
+{
+public:
+	static int getConfigIntValue(const char *key, int implicit = 0)
+	{
+		std::string v;
+		if (ePythonConfigQuery::getConfigValue(key, v) < 0 || v.empty())
+			return implicit;
+		return atoi(v.c_str());
+	}
+};
+
+#endif
