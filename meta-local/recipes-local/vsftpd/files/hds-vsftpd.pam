#%PAM-1.0
# FTP (vsftpd) cu parola receptorului, aceeasi ca la SSH si SFTP: parola lui root din /etc/shadow (common-auth). vsftpd
# asculta numai pe IPv4 (/etc/vsftpd.conf) si da adresa clientului in PAM_RHOST cu cifre, a.b.c.d.
# 1. numai din reteaua de acasa: /etc/security/hds-ssh-retele-locale.conf (fix, din pachetul hdsatelit-ssh) spune
#    „reusit” numai pentru adresele din retelele locale; orice alt rezultat, si o eroare de citire, opreste logarea pe
#    loc (requisite), fara verificarea parolei;
# 2. conturile de sistem din /etc/vsftpd.ftpusers nu intra prin FTP;
# 3. „Fără parolă în rețeaua locală” (Setări > Rețea & Conexiuni > Parola receptorului): acelasi comutator ca in
#    /etc/pam.d/dropbear, /etc/security/hds-ssh-retea-locala.conf (il scrie ecranul). Numai „refuzat” (regula „-”, optiunea
#    pornita) duce la pam_permit; orice alt rezultat, si fisier lipsa, gol sau stricat, sare la verificarea parolei.

auth     requisite                       pam_access.so accessfile=/etc/security/hds-ssh-retele-locale.conf nodefgroup
auth     required                        pam_listfile.so item=user sense=deny file=/etc/vsftpd.ftpusers onerr=succeed
auth     [perm_denied=ignore default=1]  pam_access.so accessfile=/etc/security/hds-ssh-retea-locala.conf nodefgroup
auth     [success=done default=ignore]   pam_permit.so
auth     include  common-auth
account  include  common-account
session  include  common-session
