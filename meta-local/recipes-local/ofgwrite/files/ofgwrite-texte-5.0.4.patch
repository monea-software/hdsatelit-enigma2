diff --git a/i18n.c b/i18n.c
index 8664280..04172ce 100644
--- a/i18n.c
+++ b/i18n.c
@@ -1,77 +1,199 @@
 #include "i18n.h"
 
-#include <stdio.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdlib.h>
 #include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
 
-#define SETTINGS "/etc/enigma2/settings"
-#define BOXINFO "/usr/lib/enigma.info"
+/* Optional display data only. All storage is static; errors mean English. */
+#define TEXT_FILE "/tmp/.ofgwrite-texte"
+#define TEXT_ENV "OFGWRITE_TEXTS"
+#define TEXT_LIMIT 32768
+#define ENTRY_LIMIT 128
+#define KEY_LIMIT 255
+#define VALUE_LIMIT 768
 
-static int chosen = -1;  /* Index in i18n_languages, -1 for English. */
+static char data[TEXT_LIMIT + 1];
+static struct { const char *english; const char *translated; } entries[ENTRY_LIMIT];
+static size_t entry_count;
+static int ready, right_to_left, initialized;
 
-/* The value of key in a file of key=value lines, without quotes; 0 when missing. */
-static int file_value(const char *path, const char *key, char *value, size_t size)
+/* A Unicode scalar, or zero bytes for an invalid/truncated sequence. */
+static size_t utf8_scalar(const unsigned char *p, size_t left, uint32_t *scalar)
 {
-	char line[256];
-	size_t length = strlen(key);
-	int found = 0;
-	FILE *file = fopen(path, "r");
-	if (!file)
+	size_t n;
+	uint32_t value;
+	if (!left)
 		return 0;
-	while (fgets(line, sizeof(line), file))
-		if (!strncmp(line, key, length) && line[length] == '=') {
-			char *start = line + length + 1;
-			start += strspn(start, "'\"");
-			start[strcspn(start, "'\"\r\n")] = '\0';
-			snprintf(value, size, "%s", start);
-			found = value[0] != '\0';
-		}
-	fclose(file);
-	return found;
+	if (p[0] < 0x80) { *scalar = p[0]; return 1; }
+	if (p[0] >= 0xc2 && p[0] <= 0xdf) { n = 2; value = p[0] & 0x1f; }
+	else if (p[0] >= 0xe0 && p[0] <= 0xef) { n = 3; value = p[0] & 0x0f; }
+	else if (p[0] >= 0xf0 && p[0] <= 0xf4) { n = 4; value = p[0] & 0x07; }
+	else return 0;
+	if (n > left)
+		return 0;
+	for (size_t i = 1; i < n; ++i) {
+		if ((p[i] & 0xc0) != 0x80) return 0;
+		value = (value << 6) | (p[i] & 0x3f);
+	}
+	if ((n == 3 && value < 0x800) || (n == 4 && value < 0x10000) ||
+		(value >= 0xd800 && value <= 0xdfff) || value > 0x10ffff)
+		return 0;
+	*scalar = value;
+	return n;
+}
+
+static int valid_text(const char *text)
+{
+	size_t left = strlen(text);
+	const unsigned char *p = (const unsigned char *)text;
+	while (left) {
+		uint32_t scalar;
+		size_t n = utf8_scalar(p, left, &scalar);
+		if (!n || scalar < 0x20 || (scalar >= 0x7f && scalar <= 0x9f)) return 0;
+		p += n;
+		left -= n;
+	}
+	return 1;
+}
+
+/* Only exact %d, %s and %% tokens, in the original order. No widths, stars,
+ * positional arguments, length modifiers, %n or other conversions from data. */
+static int same_formats(const char *english, const char *translated)
+{
+	for (;;) {
+		english = strchr(english, '%');
+		translated = strchr(translated, '%');
+		if (!english || !translated) return !english && !translated;
+		if (!(english[1] == 'd' || english[1] == 's' || english[1] == '%') ||
+			english[1] != translated[1]) return 0;
+		english += 2;
+		translated += 2;
+	}
+}
+
+/* The upstream catalog is a key whitelist, never a fallback language. */
+static const char *known_key(const char *text)
+{
+	static const char credit[] = "ofgwrite - written by Betacentauri";
+	if (!strcmp(text, credit)) return credit;
+	for (int i = 0; i < translation_count; ++i)
+		if (!strcmp(text, translations[i].text)) return translations[i].text;
+	return NULL;
+}
+
+static int parse(size_t length)
+{
+	char *line = data, *end = data + length, *newline;
+	if (!length || memchr(data, '\0', length)) return 0;
+	data[length] = '\0';
+	newline = strchr(line, '\n');
+	if (!newline) return 0;
+	*newline = '\0';
+	if (!strcmp(line, "OFGWRITE-TEXTS-1\tltr")) right_to_left = 0;
+	else if (!strcmp(line, "OFGWRITE-TEXTS-1\trtl")) right_to_left = 1;
+	else return 0;
+	line = newline + 1;
+	while (line < end) {
+		newline = strchr(line, '\n');
+		if (!newline) return 0;
+		*newline = '\0';
+		if (!strcmp(line, "OFGWRITE-END")) return newline + 1 == end;
+		char *tab = strchr(line, '\t');
+		if (!tab || strchr(tab + 1, '\t') || entry_count == ENTRY_LIMIT) return 0;
+		*tab++ = '\0';
+		if (!*line || !*tab || strlen(line) > KEY_LIMIT || strlen(tab) > VALUE_LIMIT ||
+			!valid_text(line) || !valid_text(tab) || !same_formats(line, tab)) return 0;
+		const char *key = known_key(line);
+		if (!key) return 0;
+		for (size_t i = 0; i < entry_count; ++i)
+			if (entries[i].english == key) return 0;
+		entries[entry_count].english = key;
+		entries[entry_count++].translated = tab;
+		line = newline + 1;
+	}
+	return 0;  /* No partial catalog when the file is truncated. */
 }
 
-/* Like Enigma2: config.osd.language, else config.misc.locale, else the default of the brand. */
-static void enigma2_language(char *locale, size_t size)
+/* Direct invocation: regular file only, no FIFO/symlink, no retry loop.
+ * The caller runs once before its own UI stop and before pivot_root. */
+static size_t read_file(void)
 {
-	char brand[64] = "";
-	if (file_value(SETTINGS, "config.osd.language", locale, size) ||
-		file_value(SETTINGS, "config.misc.locale", locale, size))
-		return;
-	file_value(BOXINFO, "displaybrand", brand, sizeof(brand));
-	if (!strcmp(brand, "Atto.TV"))
-		snprintf(locale, size, "pt_BR");
-	else if (!strcmp(brand, "Zgemma"))
-		snprintf(locale, size, "en_US");
-	else if (!strcmp(brand, "Beyonwiz"))
-		snprintf(locale, size, "en_AU");
-	else
-		snprintf(locale, size, "de_DE");
+	struct stat st;
+	size_t used = 0;
+	int fd = open(TEXT_FILE, O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0) return 0;
+	if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_uid != geteuid() ||
+		st.st_size <= 0 || st.st_size > TEXT_LIMIT) {
+		close(fd);
+		return 0;
+	}
+	while (used < sizeof(data)) {
+		ssize_t n = read(fd, data + used, sizeof(data) - used);
+		if (n < 0) { used = 0; break; }
+		if (!n) break;
+		used += (size_t)n;
+	}
+	close(fd);
+	return used == (size_t)st.st_size && used <= TEXT_LIMIT ? used : 0;
 }
 
 void i18n_init(const char *language)
 {
-	char locale[32];
-	if (language && *language)
-		snprintf(locale, sizeof(locale), "%s", language);
-	else
-		enigma2_language(locale, sizeof(locale));
-	chosen = -1;
-	for (int i = 0; i < 3; ++i)
-		if (!strncmp(locale, i18n_languages[i], 2))
-			chosen = i;
+	const char *snapshot;
+	size_t length;
+	(void)language;  /* Retained API; direction is part of the snapshot. */
+	if (initialized) return;
+	initialized = 1;
+	snapshot = getenv(TEXT_ENV);
+	if (snapshot) {
+		/* Enigma2 reads BEFORE init 4. Empty means English and forbids a
+		 * later disk read, even if a stale translation file remains. */
+		length = strnlen(snapshot, TEXT_LIMIT + 1);
+		if (length > TEXT_LIMIT) return;
+		memcpy(data, snapshot, length);
+	} else length = read_file();
+	ready = parse(length);
+	if (!ready) { entry_count = 0; right_to_left = 0; }
 }
 
 const char *tr(const char *text)
 {
-	if (chosen < 0 || !text)
-		return text;
-	for (int i = 0; i < translation_count; ++i)
-		if (!strcmp(translations[i].text, text))
-			return translations[i].translated[chosen] && *translations[i].translated[chosen] ?
-				translations[i].translated[chosen] : text;
+	if (ready && text)
+		for (size_t i = 0; i < entry_count; ++i)
+			if (!strcmp(entries[i].english, text)) return entries[i].translated;
 	return text;
 }
 
 int i18n_rtl(void)
 {
-	return chosen >= 0 && !strcmp(i18n_languages[chosen], "ar");
+	return ready && entry_count && right_to_left;
+}
+
+/* LVGL copies each label immediately. Valid UTF-8 also for snprintf outputs
+ * cut mid-character; malformed bytes/controls become '?'. No allocation. */
+const char *i18n_display_text(const char *text)
+{
+	static char clean[1024];
+	size_t used = 0, left = text ? strnlen(text, sizeof(clean) - 1) : 0;
+	const unsigned char *p = (const unsigned char *)text;
+	while (left && used < sizeof(clean) - 1) {
+		uint32_t scalar;
+		size_t n = utf8_scalar(p, left, &scalar);
+		if (!n || scalar < 0x20 || (scalar >= 0x7f && scalar <= 0x9f)) {
+			clean[used++] = '?';
+			p++;
+			left--;
+		} else {
+			if (n > sizeof(clean) - 1 - used) break;
+			memcpy(clean + used, p, n);
+			used += n;
+			p += n;
+			left -= n;
+		}
+	}
+	clean[used] = '\0';
+	return clean;
 }
