# HD Satelit: regulile garzii de model pentru Novaler Multibox 4K PRO (masina multiboxpro, MACHINEBUILD novaler4kpro),
# NECONFIRMAT (MNP, 12.11.2026, imaginea alfa).
# confirmat=nu pune garda din enigma2.sh in treapta a doua: hotarasc cipul, tipul placii si locul nucleului si al
# sistemului; placa (hw), tabela partitiilor si marimea nucleului sunt numai avertismente, aratate de interfata.
# Masina multiboxpro e stratul producatorului meta-maxytec (OE-Alliance 6.0): nucleul linux-maxytec 4.4.35 (defconfig
# multiboxpro), driverele maxytec-dvb-modules-multiboxpro 20221213 (patru module monolitice multiboxpro_1..4.ko, cu sirurile
# ascunse, ca la Zgemma H9), fara libreader si fara hihalt. DOVEDITE din fisiere:
#   partitions, kernel_part, rootfs_part, kernel_kib: bootargs-8gb.bin si update_bootargs_multiboxpro.bin al producatorului
#            (multiboxpro-bootargs-20221130.zip, sha256 4317a5d3 = cel din maxytec-bootargs-multiboxpro.bb):
#            blkdevparts=mmcblk0:1M(fastboot),1M(bootargs),18M(recovery),2M(bootoptions),2M(deviceinfo),4M(baseparam),
#            4M(pqparam),4M(logo),40M(fastplay),20M(boot),20M(trustedcore),4M(misc),1024M(system),204M(vendor),306M(e2tv),
#            202M(cache),50M(dtbo),8M(securestore),16M(linuxkernel1),16M(linuxkernel2),16M(linuxkernel3),16M(linuxkernel4),
#            -(userdata); STARTUP_LINUX_1 din maxytec-fastboot8gb_image.bbclass: root=/dev/mmcblk0p23 rootsubdir=linuxrootfs1
#            kernel=/dev/mmcblk0p19. ATENTIE: multiboxpro.conf si maxytec-hisil-3798mv200.inc spun MTD_ROOTFS = mmcblk0p20
#            (in tabela e linuxkernel2): valoare ramasa gresit in OE-Alliance, nefolosita la pornire; reteta imaginii o
#            suprascrie cu mmcblk0p23 (MTD_ROOTFS:multiboxpro), ca verificarea ei sa se potriveasca cu /proc/cmdline.
# NEDOVEDITE (de confirmat din fisa testerului INAINTE de publicare, vezi STADIU-MNP.md): chip= si boxtype=. Modulele au
# sirurile ascunse (numai HI_DRV_MODULE_Register, hi_i2c), nucleul nu are noduri /proc/stb. Valorile de mai jos sunt cele
# asteptate dupa familie (cip Hi3798MV200 ca la SF8008 si H9; tipul placii = numele masinii sau MACHINEBUILD), nu masurate:
# o valoare gresita opreste interfata cu ecranul „imagine pentru alt receptor”. boxtype= e lista, disjuncta de a lui
# Multibox 4K SE (multiboxse), ca imaginea PRO sa nu treaca pe un SE si invers.
# hw=- : antetul fabricii din deviceinfo (p5) nu e cunoscut pentru Multibox (nu se compara).
# Reteta imaginii (hdsatelit-image.bb) citeste fisierul cand MACHINEBUILD=novaler4kpro.
format=1
distro=hdsatelit
model=Novaler Multibox 4K PRO
machine=multiboxpro
machinebuild=novaler4kpro
chip=Hi3798MV200
boxtype=multiboxpro,novaler4kpro
hw=-
partitions=fastboot:1M,bootargs:1M,recovery:18M,bootoptions:2M,deviceinfo:2M,baseparam:4M,pqparam:4M,logo:4M,fastplay:40M,boot:20M,trustedcore:20M,misc:4M,system:1024M,vendor:204M,e2tv:306M,cache:202M,dtbo:50M,securestore:8M,linuxkernel1:16M,linuxkernel2:16M,linuxkernel3:16M,linuxkernel4:16M,userdata
kernel_name=linuxkernel1
rootfs_name=userdata
kernel_part=mmcblk0p19
kernel_kib=16384
rootfs_part=mmcblk0p23
confirmat=nu
