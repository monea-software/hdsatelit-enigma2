# HD Satelit: regulile garzii de model pentru Amiko Viper 4K V30 (masina u57), NECONFIRMAT
# confirmat=nu pune garda din enigma2.sh in treapta a doua: hotarasc cipul, tipul placii si locul nucleului si al
# sistemului; placa (hw), tabela partitiilor si marimea nucleului sunt numai avertismente, aratate de interfata.
# Valorile hw, partitions si kernel_kib sunt cele de la V20 (imaginile publice au acelasi nucleu si aceleasi drivere);
# se inlocuiesc cu cele din fisa unui receptor V30 adevarat, iar dupa confirmare randul confirmat=nu se scoate.
# Reteta imaginii (hdsatelit-image.bb) citeste fisierul cand MACHINEBUILD=viper4kv30 (imaginea 0.6.0 pentru testeri).
# upd_path: dosarul in care Maintenance Mode cauta imaginea pe stick; enigma2.sh il scrie in /proc/stb/info/upd_path
# inainte de showiframe (tabelul fix din showiframe nu are viper4kv30: fara el eticheta ar ramane cu UPD_PATH gol, iar
# loaderul ar cauta in dinobot/u57/). /amiko/u57, ca toate imaginile publice pentru V30 (dosarul imaginii amiko/u57,
# scris de ele la pornire in acelasi nod; lotul imagine-060-v30, cercetare-echipe/RAPORT-ECHIPE.md 0 si 2.5): un V30 venit
# de pe ele are deja eticheta /amiko/u57, deci showiframe nu rescrie p6, iar arhiva lor merge inapoi fara redenumiri.
# emmc_min_kib= (memoria interna, discul intreg mmcblk0 din /proc/partitions, in KiB; reteta il primeste, garda il
# hotaraste de la 0.6.1) NU se pune inca: 8 GB la V30 e spus de utilizatori pe forumuri, dar fisa de presa spune 4 GB si
# nimeni nu l-a masurat pentru noi (lotul imagine-060-v30, caz-v20-pe-v30.md). Se pune emmc_min_kib=5242880 numai dupa
# fisa unui tester V30 cu marimea masurata (V20 are 3837952 KiB). Fara el, imaginea V30 pe un V20 merge (acelasi nucleu
# si aceleasi drivere), deci nu e un caz periculos.
format=1
distro=hdsatelit
model=Amiko Viper 4K V30
machine=u57
machinebuild=viper4kv30
chip=Hi3798MV200
boxtype=u57
hw=U5SLIM
partitions=boot:1M,bootargs:1M,baseparam:4M,pqparam:4M,logo:4M,deviceinfo:4M,loader:32M,trustedcore:8M,kernel:32M,rootfs
kernel_part=mmcblk0p9
kernel_kib=32768
rootfs_part=mmcblk0p10
upd_path=/amiko/u57
confirmat=nu
