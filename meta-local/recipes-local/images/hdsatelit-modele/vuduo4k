# HD Satelit: regulile garzii de model pentru Vu+ Duo 4K (masina vuduo4k), NECONFIRMAT
# confirmat=nu pune garda din enigma2.sh in treapta a doua: hotarasc cipul, tipul placii si locul nucleului si al
# sistemului; marimea nucleului e numai avertisment, aratat de interfata.
# familie=broadcom (06.11.2026): receptor Broadcom, fara /proc/msp/sys, fara blkdevparts in /proc/cmdline si fara
# partitia deviceinfo. Garda citeste atunci cipul din /proc/stb/info/chipset, tipul placii din /proc/stb/info/vumodel
# (cand nu exista /proc/stb/info/boxtype, ca getBoxProc din Tools/StbHardware.py al altor imagini), sistemul din root= al
# lui /proc/cmdline si nucleul din kernel_part= de mai jos (partitia trebuie sa existe in /proc/partitions, de acolo si
# marimea). hw= si partitions= sunt "-": pe aceasta familie nu se citesc si nu se compara.
# chip= si boxtype= din tabelul proc_rw_info al driverului (dvb-bcm7278.ko din
# vuplus-dvb-proxy-vuduo4k-4.1.45-20250706.r1): chipset=7278 (SOC_FAMILY din vuduo4k.conf spune bcm7376, dar driverul si
# fisa producatorului spun BCM7278), vumodel=duo4k.
# kernel_part=mmcblk0p6, rootfs_part=mmcblk0p9 din vuduo4k.conf; root=/dev/mmcblk0p9 fortat in defconfig.
# kernel_kib: nemasurat (0, de completat din fisa unui tester). Pe stick: dosarul vuplus/duo4k.
format=1
distro=hdsatelit
model=Vu+ Duo 4K
machine=vuduo4k
machinebuild=vuduo4k
chip=7278
boxtype=duo4k
hw=-
partitions=-
kernel_part=mmcblk0p6
kernel_kib=0
rootfs_part=mmcblk0p9
confirmat=nu
familie=broadcom
