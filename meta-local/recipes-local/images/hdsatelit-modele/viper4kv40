# HD Satelit: regulile garzii de model pentru Amiko Viper 4K V40 (masina u571), NECONFIRMAT
# confirmat=nu pune garda din enigma2.sh in treapta a doua: hotarasc cipul, tipul placii si locul nucleului si al
# sistemului; placa (hw), tabela partitiilor si marimea nucleului sunt numai avertismente, aratate de interfata.
# Tipul placii e o lista: driverul imaginilor publice pentru V40 spune tot u57 (dedus din sirurile driverului,
# nemasurat pe aparat), deci se primesc amandoua pana arata fisa unui receptor V40 adevarat ce spune.
# Valorile hw, partitions si kernel_kib sunt cele de la V20 (acelasi nucleu, acelasi SDK); se inlocuiesc cu cele din
# fisa, iar dupa confirmare randul confirmat=nu se scoate. Constructia de azi nu citeste inca acest fisier.
format=1
distro=hdsatelit
model=Amiko Viper 4K V40
machine=u571
machinebuild=viper4kv40
chip=Hi3798MV200
boxtype=u57,u571
hw=U5SLIM
partitions=boot:1M,bootargs:1M,baseparam:4M,pqparam:4M,logo:4M,deviceinfo:4M,loader:32M,trustedcore:8M,kernel:32M,rootfs
kernel_part=mmcblk0p9
kernel_kib=32768
rootfs_part=mmcblk0p10
upd_path=/amiko/viper4kv40
confirmat=nu
