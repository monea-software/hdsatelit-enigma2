# HD Satelit: regulile garzii de model pentru Amiko Viper 4K V20 (masina u57), CONFIRMAT pe receptorul nostru
# Reteta imaginii (hdsatelit-image.bb) citeste fisierul cu numele MACHINEBUILD si scrie din el /etc/hdsatelit-model si
# marcajul pachetului (e2/update/hdsatelit-model). Randurile cu # nu intra in imagine; ordinea cheilor e cea din imagine.
# Amprenta citita pe receptor: cipul (CHIP_VERSION din /proc/msp/sys), placa (HW= din antetul partitiei deviceinfo),
# tabela partitiilor data de bootloader (numele si marimile pana la nucleu; marimea sistemului depinde de eMMC, deci nu
# se cere), marimea partitiei nucleului si tipul placii din driver. Fara spatii in lista partitiilor (garda din
# enigma2.sh o citeste cu awk).
# Fara confirmat=nu: treapta intai a garzii (toate cheile hotarasc).
# Dosarul de recuperare: scris de enigma2.sh in /proc/stb/info/upd_path inainte de showiframe. Pe 0.7.0 e obligatoriu:
# tabelul lui showiframe citeste numele fara terminator, dupa nume urmeaza gunoi de pe stiva, deci potrivirea cade si
# eticheta din deviceinfo se rescrie cu UPD_PATH gol la fiecare pornire (consola receptorului de proba, 03.11.2026).
format=1
distro=hdsatelit
model=Amiko Viper 4K V20
machine=u57
machinebuild=viper4kv20
chip=Hi3798MV200
boxtype=u57
hw=U5SLIM
partitions=boot:1M,bootargs:1M,baseparam:4M,pqparam:4M,logo:4M,deviceinfo:4M,loader:32M,trustedcore:8M,kernel:32M,rootfs
kernel_part=mmcblk0p9
kernel_kib=32768
rootfs_part=mmcblk0p10
upd_path=/amiko/viper4kv20
