#
# Porneste inaintea lui dropbear (S09, dropbear e S10):
# - pune drepturile pe care dropbear le cere pentru cheile lui root (/home/root/.ssh 0700, authorized_keys 0600, ale lui
#   root); cu drepturi mai largi dropbear refuza cheile si intrarea ar merge numai cu parola;
# - la prima pornire cheama `hds-ssh-parola prima` in fundal: `openssl rand` asteapta generatorul nucleului, care dupa
#   un flash (fara samanta salvata) se poate initializa dupa cateva secunde, iar enigma2 porneste abia dupa rc3.
#   Pana la parola, root intra numai cu o cheie (in imagine parola e `*`);
# - tot numai la prima pornire dupa flash, `hds-ssh-stick prima` in fundal: cheile publice din dosarul hdsatelit/ssh de
#   pe stickul de flash (acolo urca-pe-stick-016.sh pune cheia calculatorului) intra in authorized_keys, o singura data
#   (semnul /etc/hdsatelit-ssh/stick-citit); dupa aceea cheile noi intra numai din ecranul Acces SSH sau din web.
# - Telnet (portul 23, ca la celelalte imagini): `busybox inetd /etc/hds-telnet-inetd.conf`, cu programul de logare
#   hds-telnet-poarta: din casa root intra direct cat parola omului nu e bifata la Telnet si SSH, altfel cu parola; din
#   afara casei legatura se inchide. `hds-ssh telnet` il porneste numai pe el (la instalarea pachetului din feed);
# - o singura data dupa actualizarea pachetului (semnul /etc/hdsatelit-ssh/regula-implicita): regula „Fara parola in
#   reteaua locala” ramasa exact cea veche din pachet (oprita, nealeasa de om) devine cea noua, pornita; o regula aleasa
#   de om ramane cum a lasat-o.
# - o singura data dupa actualizarea la r4 (semnul /etc/hdsatelit-ssh/regula-ftp): FTP primeste regula lui
#   (hds-ftp-retea-locala.conf); cine ceruse parola si in casa (regula SSH fara "-") si nu a ales inca nimic in ecranul
#   nou (fara /etc/hdsatelit-ssh/parola-locala.json) o pastreaza si la FTP, ca inainte (acelasi text ca
#   Components/HdsParolaLocala.textRegula, ca ecranul sa o recunoasca).
# Parola nu trece niciodata prin acest script.

PAROLA=/usr/sbin/hds-ssh-parola
STICK=/usr/sbin/hds-ssh-stick
SSH=/home/root/.ssh
REGULA=/etc/security/hds-ssh-retea-locala.conf
REGULA_NOUA=/usr/share/hdsatelit-ssh/hds-ssh-retea-locala.conf
SEMN_REGULA=/etc/hdsatelit-ssh/regula-implicita
REGULA_FTP=/etc/security/hds-ftp-retea-locala.conf
SEMN_FTP=/etc/hdsatelit-ssh/regula-ftp
ALEGERE=/etc/hdsatelit-ssh/parola-locala.json
INETD_CONF=/etc/hds-telnet-inetd.conf
INETD_PID=/var/run/hds-telnet-inetd.pid

# regula din pachetele de pana la r2, oprita; numai aceasta, octet cu octet, se inlocuieste
regula_veche() {
	printf '%s\n' "# „Fără parolă în rețeaua locală” (Setări > Rețea & Conexiuni > Acces SSH): OPRITĂ." \
		"# Fisierul il scrie ecranul „Acces SSH” (Components/HdsAccesSsh.py); pam_access il citeste la fiecare logare prin" \
		"# dropbear (/etc/pam.d/dropbear). Numai o regula „-” care se potriveste lasa root sa intre fara parola; regula de mai jos" \
		"# se potriveste cu oricine si trimite la verificarea parolei." \
		"+ : ALL : ALL"
}

regula_implicita() {
	[ -f "$SEMN_REGULA" ] && return 0
	if [ -f "$REGULA_NOUA" ] && regula_veche | cmp -s - "$REGULA"; then
		cp -f "$REGULA_NOUA" "$REGULA.nou" && chmod 644 "$REGULA.nou" && mv -f "$REGULA.nou" "$REGULA"
	fi
	mkdir -p /etc/hdsatelit-ssh && : > "$SEMN_REGULA"
}

regula_ftp() {
	[ -f "$SEMN_FTP" ] && return 0
	if [ -f "$REGULA" ] && [ ! -f "$ALEGERE" ] && ! grep -q '^-' "$REGULA"; then
		printf '%s\n' "# FTP: cu parola omului si in reteaua de acasa (Setari > Retea > Parola receptorului)." \
			"+ : ALL : ALL" > "$REGULA_FTP.nou" && chmod 644 "$REGULA_FTP.nou" && mv -f "$REGULA_FTP.nou" "$REGULA_FTP"
	fi
	mkdir -p /etc/hdsatelit-ssh && : > "$SEMN_FTP"
}

telnet_porneste() {
	[ -f "$INETD_CONF" ] && [ -x /usr/sbin/hds-telnet-poarta ] || return 0
	if [ -f "$INETD_PID" ] && kill -0 "$(cat "$INETD_PID" 2>/dev/null)" 2>/dev/null; then
		return 0
	fi
	# in prim-plan (-f), pus in fundal de noi: pidul e chiar al lui, fara asteptare la pornirea receptorului
	busybox inetd -f "$INETD_CONF" < /dev/null > /dev/null 2>&1 &
	echo $! > "$INETD_PID"
}

case "$1" in
telnet)
	telnet_porneste
	;;
start|"")
	regula_implicita
	regula_ftp
	telnet_porneste
	if [ -d "$SSH" ]; then
		chown root:root "$SSH" 2>/dev/null
		chmod 700 "$SSH"
		if [ -f "$SSH/authorized_keys" ]; then
			chown root:root "$SSH/authorized_keys" 2>/dev/null
			chmod 600 "$SSH/authorized_keys"
		fi
	fi
	# zavorul lui hds-ssh-parola fara flock (un dosar) ramas dupa o cadere de curent; la pornire nu-l tine nimeni
	rmdir /etc/hdsatelit-ssh/.zavor.d 2>/dev/null
	# prima pornire dupa flash: /etc e nou, deci nici parola, nici semnul stickului
	if [ -x "$STICK" ] && [ ! -f /etc/hdsatelit-ssh/facuta ] && [ ! -f /etc/hdsatelit-ssh/stick-citit ]; then
		nice -n 10 "$STICK" prima < /dev/null > /dev/null 2>&1 &
	fi
	if [ -x "$PAROLA" ] && [ ! -f /etc/hdsatelit-ssh/facuta ]; then
		HDS_SSH_LA_PORNIRE=1 nice -n 10 "$PAROLA" prima < /dev/null > /dev/null 2>&1 &
	fi
	;;
stop|restart|force-reload|status)
	;;
*)
	echo "folosire: $0 start" >&2
	exit 1
	;;
esac
exit 0
