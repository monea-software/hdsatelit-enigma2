### BEGIN INIT INFO
# Provides:          hds-jurnal
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     S
# Default-Stop:      0 6
# Short-Description: pastreaza jurnalul sistemului de dinainte de o oprire necurata
### END INIT INFO
#
# Jurnalul sistemului e in /home/root/logs/messages (syslogd pornit din rc5, S20syslog). Dupa o pana de curent, o
# repornire dura sau o cadere a nucleului, jurnalul de dinainte se pierdea repede prin rotire. Scriptul acesta:
#   start (rcS, S38: dupa montarea radacinii in scriere, inainte de syslogd): daca lipseste semnul opririi curate si
#     exista jurnal, copiaza messages.0 si messages (in ordinea timpului) in messages.cadere; copia de dinainte trece
#     in messages.cadere.1 (deci se pastreaza ultimele doua opriri necurate). Apoi sterge semnul.
#   stop (rc0 si rc6, S39: dupa oprirea lui syslogd la K20 si inainte de demontare la S40): scrie semnul opririi
#     curate. O oprire fara rc0/rc6 (pana de curent, sysrq, ceasul hardware, caderea nucleului) il lasa lipsa.
# La prima pornire dupa scrierea imaginii nu exista nici semn, nici jurnal: nu se copiaza nimic.
#   Tot la start, primul lucru: pe o pornire in dubiu (interfata acestei imagini n-a pornit inca niciodata pe receptor,
#     adica lipseste /etc/hds-interfata-pornita, sau lipsesc driverele: /dev/fb0, /dev/dvb/adapter0) porneste in fundal
#     urmarirea pornirii (/usr/bin/hds-rezerva.sh urmareste, tools/hds-rezerva.sh.in din enigma2): pasul pornirii pe
#     afisajul din fata si pe televizor, pana apare interfata, si diagnosticul cand nu apare. Pe orice alta pornire
#     numai cateva teste de fisier, nimic pornit. HDS_REZERVA_SEMN, HDS_REZERVA_SINE: numai pentru probele de pe PC.
#   Tot la start, la fiecare pornire: urmarirea pasilor pornirii si raportul unei porniri ratate (/usr/bin/hds-raport.sh
#     urmareste, tools/hds-raport.sh.in din enigma2), in fundal, cand scriptul exista (o imagine fara el: nimic).
#     HDS_RAPORT_SINE: numai pentru probele de pe PC.
#   Tot la start, dupa o oprire necurata (aceeasi conditie ca la copie): un rand in hds-caderi.log, "pornire dupa
#     oprire brusca", cu ce se stie fara ghicit (rand_oprire_brusca, mai jos). Asistenta 430032 (15.11.2026): doua
#     reporniri dupa instalari din panoul unui plugin strain n-au lasat nimic in hds-caderi.log, deci nu se vedea ca
#     receptorul s-a oprit brusc si nici ce facea atunci.
#   Tot atunci (r5, 0.7.8, asistenta 751207: 5 reporniri dure intr-o ora pe GigaBlue UHD Trio 4K): ora ultimului semn de
#     viata (ultimul rand al interfetei, UTC, si al jurnalului sistemului, ora locala) in SEMN_BRUSC, in RAM. La prima
#     ora sigura (NTP, HTTPS, doua multiplexuri) Components/HdsCeas.py scrie in hds-caderi.log cat a stat receptorul fara
#     nucleu pornit (pana la pornirea nucleului = ora sigura minus uptime) si sterge semnul: o repornire a placii revine
#     in 1-2 minute, o pauza mai lunga e curentul, butonul sau o pornire oprita inainte de nucleu. Aici nu se poate
#     socoti: dupa reset ceasul pornirii e ora salvata. HDS_JURNAL_SEMN_BRUSC: numai pentru probele de pe PC.

D=${HDS_JURNAL_DOSAR:-/home/root/logs}
SEMN=$D/.oprire-curata
CADERE=$D/messages.cadere
CADERI=$D/hds-caderi.log
SEMN_PORNIRE=$D/.pornire-jurnal
BOOT_ID=${HDS_JURNAL_BOOT_ID:-/proc/sys/kernel/random/boot_id}
INTERFATA_SEMN=${HDS_REZERVA_SEMN:-/etc/hds-interfata-pornita}
SEMN_BRUSC=${HDS_JURNAL_SEMN_BRUSC:-/var/run/hds-oprire-brusca}

# Randurile scoase din jurnale: fara caractere de control (si fara culorile nucleului, "[1;32m"), fara utilizator si
# parola din adrese (://nume:parola@), cel mult 160 de semne pe rand.
curata() {
	sed -e 's/\[[0-9;]*m//g' -e 's#://[^/@ ]*@#://#g' | cut -c1-160
}

# Un rand in hds-caderi.log la pornirea dupa o oprire necurata, cu ce lasa jurnalele, fara ghicit:
#   - ultimul rand din messages (cu ora jurnalului sistemului; dupa un reset coada poate fi goala, deci ultimul rand cu
#     ora din ultimii 64 KiB);
#   - ultimul rand al interfetei si ultima comanda opkg/Console pornita de ea ([Console] executing, [Ipkg] executing)
#     din hds-interfata.log: dupa un reset coada fisierului poate avea bucati vechi, deci randul cu ora cea mai mare
#     din ultimii 256 KiB;
#   - ultima lucrare din Extensii (hds-extensii.log, "---- ..."), cu codul ei sau "neterminata" cand dupa ea nu e
#     "---- cod".
# Cauza resetului nu se pune: nucleul placilor noastre nu o da (SF8008 si V20, nucleul 4.4.35: watchdog0 al lui
# sp805-wdt fara bootstatus, fara pstore; vazut pe receptor 15.11.2026). Ora randului e cea salvata la oprire
# (S01fake-hwclock), ca in antetul lui messages.cadere; ceasul din retea vine dupa. Totul tine cateva citiri de cozi.
rand_oprire_brusca() {
	m=$(tail -c 65536 "$D/messages" 2>/dev/null | tr -d '\000-\010\013-\037\177' |
		awk '/^[A-Z][a-z][a-z] [ 0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9] / { r = $0 } END { print r }' | curata)
	f=$D/hds-interfata.log
	[ -s "$f" ] || f=$D/hds-interfata.log.1
	i=""
	c=""
	if [ -s "$f" ]; then
		i=$(tail -c 262144 "$f" 2>/dev/null | tr -d '\000-\010\013-\037\177' |
			awk '/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z / {
				t = substr($0, 1, 20)
				if (t >= ti) { ti = t; ri = $0 }
				if ($0 ~ /\[(Console|Ipkg)\] executing/ && t >= tc) { tc = t; rc = $0 }
			} END { print ri; print rc }' | curata)
		c=$(printf '%s\n' "$i" | sed -n 2p)
		i=$(printf '%s\n' "$i" | sed -n 1p)
	fi
	e=$(tail -c 65536 "$D/hds-extensii.log" 2>/dev/null | tr -d '\000-\010\013-\037\177' |
		awk '$3 == "----" && $1 ~ /^[0-9][0-9][0-9][0-9]-/ {
			if ($4 == "cod") { if (r != "" && cod == "") cod = $5 }
			else { r = substr($0, 1, 160); cod = "" }
		} END { if (r != "") print r (cod == "" ? " (neterminata)" : " (cod " cod ")") }' | curata)
	r="$(date '+%Y-%m-%d %H:%M:%S') pornire dupa oprire brusca (oprirea de dinainte n-a fost curata: curentul, o repornire dura sau nucleul; ora salvata, poate fi inca nepotrivita; boot=$boot; jurnalul sistemului de dinainte in messages.cadere)"
	[ -n "$m" ] && r="$r; ultimul rand din messages: $m"
	[ -n "$i" ] && r="$r; ultimul rand al interfetei: $i"
	[ -n "$c" ] && r="$r; ultima comanda opkg/Console: $c"
	[ -n "$e" ] && r="$r; ultima lucrare din Extensii: $e"
	echo "$r" >> "$CADERI"
	# semnul pentru HdsCeas: numai orele, numai cand au forma asteptata
	ti=$(printf '%s\n' "$i" | cut -c1-20)
	tm=$(printf '%s\n' "$m" | cut -c1-15)
	case "$ti" in
	[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) ;;
	*) ti="" ;;
	esac
	case "$tm" in
	[A-Z][a-z][a-z]" "[" "0-9][0-9]" "[0-9][0-9]:[0-9][0-9]:[0-9][0-9]) ;;
	*) tm="" ;;
	esac
	if [ -n "$ti" ] || [ -n "$tm" ]; then
		printf 'interfata=%s\nmessages=%s\n' "$ti" "$tm" > "$SEMN_BRUSC"
	fi
}

case "$1" in
start)
	# Un start repetat in acelasi nucleu nu inseamna o oprire brusca.
	boot=$(cat "$BOOT_ID" 2>/dev/null)
	if [ -n "$boot" ]; then
		# Lacat numai in RAM: dispare si dupa o oprire brusca.
		zavor=${HDS_JURNAL_ZAVOR:-/var/run/hds-jurnal-start}
		mkdir "$zavor" 2>/dev/null || exit 0
		trap 'rmdir "$zavor" 2>/dev/null' EXIT
	fi
	vechi=$(cat "$SEMN_PORNIRE" 2>/dev/null)
	if [ -n "$boot" ] && [ "$boot" = "$vechi" ]; then
		# Un restart rearmeaza detectarea urmatoarei opriri necurate.
		rm -f "$SEMN"
		exit 0
	fi
	prima=0
	[ -n "$boot" ] && [ ! -e "$SEMN_PORNIRE" ] && [ ! -e "$INTERFATA_SEMN" ] && prima=1
	mkdir -p "$D"
	if [ -n "$boot" ]; then
		printf '%s\n' "$boot" > "$SEMN_PORNIRE.nou" && mv -f "$SEMN_PORNIRE.nou" "$SEMN_PORNIRE"
	fi
	if [ -x "${HDS_RAPORT_SINE:-/usr/bin/hds-raport.sh}" ]; then
		"${HDS_RAPORT_SINE:-/usr/bin/hds-raport.sh}" urmareste < /dev/null > /dev/null 2>&1 &
	fi
	if [ -f /etc/hdsatelit-model ] && [ -x "${HDS_REZERVA_SINE:-/usr/bin/hds-rezerva.sh}" ]; then
		if [ ! -f "${HDS_REZERVA_SEMN:-/etc/hds-interfata-pornita}" ] || [ ! -e /dev/fb0 ] || [ ! -e /dev/dvb/adapter0 ]; then
			"${HDS_REZERVA_SINE:-/usr/bin/hds-rezerva.sh}" urmareste < /dev/null > /dev/null 2>&1 &
		fi
	fi
	if [ -e "$SEMN" ]; then
		rm -f "$SEMN"
		exit 0
	fi
	if [ "$prima" = 0 ] && { [ -s "$D/messages" ] || [ -s "$D/messages.0" ]; }; then
		[ -f "$CADERE" ] && mv -f "$CADERE" "$CADERE.1"
		{
			echo "== copia jurnalului de dinainte de o oprire necurata (semnul opririi curate lipsea)"
			echo "== facuta la pornire, ora receptorului $(date '+%Y-%m-%d %H:%M:%S') (poate fi ora salvata, inca nepotrivita)"
			for f in messages.0 messages; do
				[ -s "$D/$f" ] || continue
				echo "== $f"
				cat "$D/$f"
			done
		} > "$CADERE.nou" 2> /dev/null && mv -f "$CADERE.nou" "$CADERE"
		rm -f "$CADERE.nou"
		rand_oprire_brusca 2> /dev/null
		if [ -x /sbin/hds-mountall ]; then
			# Pe modelele cu media in fundal, salvam numai discul jurnalului.
			sync -f "$D"
		else
			sync
		fi
	fi
	;;
stop)
	mkdir -p "$D"
	: > "$SEMN"
	sync
	;;
*)
	echo "folosire: $0 {start|stop}" >&2
	exit 1
	;;
esac
exit 0
