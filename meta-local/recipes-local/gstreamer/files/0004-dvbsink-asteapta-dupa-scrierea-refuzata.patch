+							refuzat = TRUE;
 							break;
 						default:
 							GST_OBJECT_UNLOCK(self);
@@ -923,6 +927,8 @@ static int video_write(GstBaseSink *sink, GstDVBVideoSink *self, GstBuffer *buff
 					}
 					if (retval < 0) break;
 				}
+				else if (wr == 0 && queueend > queuestart)
+					refuzat = TRUE;
 				else if (wr >= queueend - queuestart)
 				{
 					queue_pop(&self->queue);
@@ -934,6 +940,8 @@ static int video_write(GstBaseSink *sink, GstDVBVideoSink *self, GstBuffer *buff
 					GST_TRACE_OBJECT (self, "written %d queue bytes... update offset", wr);
 				}
 				GST_OBJECT_UNLOCK(self);
+				if (refuzat)
+					dvbsink_refuz_asteapta(self->unlockfd[0], &self->hds_refuzuri, &self->hds_ultimul_refuz);
 				continue;
 			}
 			GST_OBJECT_UNLOCK(self);
@@ -943,7 +951,9 @@ static int video_write(GstBaseSink *sink, GstDVBVideoSink *self, GstBuffer *buff
 				switch (errno)
 				{
 					case EINTR:
+						continue;
 					case EAGAIN:
+						dvbsink_refuz_asteapta(self->unlockfd[0], &self->hds_refuzuri, &self->hds_ultimul_refuz);
 						continue;
 					default:
 						retval = -3;
@@ -951,6 +961,8 @@ static int video_write(GstBaseSink *sink, GstDVBVideoSink *self, GstBuffer *buff
 				}
 				if (retval < 0) break;
 			}
+			if (wr == 0 && len > written)
+				dvbsink_refuz_asteapta(self->unlockfd[0], &self->hds_refuzuri, &self->hds_ultimul_refuz);
 			written += wr;
 		}
 	} while (written < len);
