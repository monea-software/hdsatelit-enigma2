index 2df521d..602f82c 100644
--- a/gstdvbaudiosink.h
+++ b/gstdvbaudiosink.h
@@ -125,6 +125,8 @@ struct _GstDVBAudioSink
 
 	int fd;
 	int unlockfd[2];
+	guint hds_refuzuri; /* IPR7: refuzurile driverului din seria de acum */
+	gint64 hds_ultimul_refuz; /* IPR7: ceasul monoton al ultimului refuz */
 
 	int skip;
 	t_audio_type bypass;
