 			GstBuffer *queuebuffer;
@@ -914,7 +915,10 @@ static int video_write(GstBaseSink *sink, GstDVBVideoSink *self, GstBuffer *buff
 					switch (errno)
 					{
 						case EINTR:
+							break;
